{
  "version": 6,
  "cmakeMinimumRequired": {"major": 3, "minor": 28, "patch": 3},
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "toolchainFile": "${sourceDir}/toolchain/clang-18.cmake",
      "cacheVariables": {"CMAKE_EXPORT_COMPILE_COMMANDS": "ON"}
    },
    {
      "name": "debug",
      "inherits": "base",
      "binaryDir": "${sourceDir}/build/debug",
      "cacheVariables": {"CMAKE_BUILD_TYPE": "Debug"}
    },
    {
      "name": "asan",
      "inherits": "base",
      "binaryDir": "${sourceDir}/build/asan",
      "cacheVariables": {"CMAKE_BUILD_TYPE": "Debug", "NEOCORTEX_SANITIZER": "address-undefined"}
    },
    {
      "name": "tsan",
      "inherits": "base",
      "binaryDir": "${sourceDir}/build/tsan",
      "cacheVariables": {"CMAKE_BUILD_TYPE": "Debug", "NEOCORTEX_SANITIZER": "thread"}
    },
    {
      "name": "tidy",
      "inherits": "base",
      "binaryDir": "${sourceDir}/build/tidy",
      "cacheVariables": {"CMAKE_BUILD_TYPE": "Debug", "NEOCORTEX_CLANG_TIDY": "ON"}
    },
    {
      "name": "fuzz",
      "inherits": "base",
      "binaryDir": "${sourceDir}/build/fuzz",
      "cacheVariables": {"CMAKE_BUILD_TYPE": "Debug", "NEOCORTEX_FUZZING": "ON"}
    },
    {
      "name": "release",
      "inherits": "base",
      "binaryDir": "${sourceDir}/build/release",
      "cacheVariables": {"CMAKE_BUILD_TYPE": "Release", "NEOCORTEX_STATIC": "ON"}
    },
    {
      "name": "arm64-release",
      "generator": "Ninja",
      "toolchainFile": "${sourceDir}/toolchain/aarch64-linux-gnu.cmake",
      "binaryDir": "${sourceDir}/build/arm64-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "NEOCORTEX_STATIC": "ON"
      }
    }
  ],
  "buildPresets": [
    {"name": "debug", "configurePreset": "debug"},
    {"name": "asan", "configurePreset": "asan"},
    {"name": "tsan", "configurePreset": "tsan"},
    {"name": "tidy", "configurePreset": "tidy"},
    {"name": "fuzz", "configurePreset": "fuzz"},
    {"name": "release", "configurePreset": "release"},
    {"name": "arm64-release", "configurePreset": "arm64-release"}
  ],
  "testPresets": [
    {"name": "debug", "configurePreset": "debug", "output": {"outputOnFailure": true}},
    {"name": "asan", "configurePreset": "asan", "output": {"outputOnFailure": true}},
    {"name": "tsan", "configurePreset": "tsan", "output": {"outputOnFailure": true}}
  ]
}
