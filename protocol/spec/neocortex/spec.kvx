# spec.kvx — NEOCORTEX: the C++ rewrite of cortex as a deterministic evidence engine.
# SINGLE SOURCE for this feature's requirements + design + tasks. Rendered to
# requirements.md / design.md / tasks.md by protocol/spec/specgen. Do not edit the
# generated markdown; edit this file and regenerate.
#
# THIS FEATURE CARRIES TWO EXTRA AUTHORITATIVE DOCUMENTS beyond the normal set:
#   schematics.md   — the detailed component diagrams; the structural ground truth.
#   agent.lock.kvx  — the build-conduct lock; every implementing agent reads it
#                     FIRST and treats any drift from it as task failure.
#
# Format: Matrix .kvx (see tachyon/internal/config/kvx.go). One key = value per
# line; string values double-quoted; lists are ["a","b"]; # starts a comment.
# Schema:
#   [req.<n>]   title, story, ac_1..ac_n
#   [design]    overview, include="design.body.md"
#   [task.<id>] title, status, wave, reqs, requires

[meta]
feature      = "neocortex"
title        = "NEOCORTEX — a C++23 deterministic single-writer evidence engine replacing cortex"
status       = "active"
spec_version = "0.1.0"
intro        = "Neocortex replaces the Go cortex module with a C++23 engine (cortexd) built as a TigerBeetle-shaped deterministic single-writer state machine over ONE append-only evidence event log per actor. The log is the only ground truth and the only non-rebuildable state: user messages, delivered assistant output, tool calls and results, provider frames, effects, approvals, assertions, intents and open loops all enter as typed events; guidance, doubt and steering have no representable event kind. Everything else — the belief store, entity index, exact SIMD vector lane, BM25, temporal ladder, intent frame and work ledger — is a derived projection rebuildable from the log by replay. Tamper evidence survives as a BLAKE3 MMR with signed checkpoint roots; per-user sealing survives as record AEAD below the hash boundary with the vault KEK to UK to DEK hierarchy and crypto-deletion. Recall becomes deterministic-first: a resident tier, a guaranteed exact-match entity lane, exact brute-force SIMD vector search with recall equal to one, BM25, and recursive temporal descent, composed by one Activate API under a strict non-trimmable tier order. The engine's prime invariant is INV-1 thread continuity: after any crash, respawn, overflow or compaction, the next activation for a conversation deterministically contains the faithful conversation projection, the reconciled work ledger, and the intent frame with the current objective and every open loop. cortexd is a per-user process reached over a Unix domain socket with a versioned FlatBuffers protocol; a Go client package implements the existing resurrection loop interfaces so neo swaps substrates without loop changes. Mechanism lives in C++, policy in Go: cortexd never calls a model or the network. The hello-world sessionjournal design is absorbed — its typed event taxonomy and exact provider-byte sidecar are promoted into the log — so Matrix ships one event-sourcing system, not two. Migration is an export: a Go tool walks the existing Pebble store and replays it through the import gate; old and new run side by side behind the memory seam until the regression corpus is green and the owner approves cutover."

[design]
overview = "See design.body.md for the architectural stance (deterministic state machine, mechanism/policy split), the evidence log format, the projection substrate, the belief store and write gate, the index plane and the exact-scan decision, INV-1 and its machine-checked continuity property, the activation composer, the cortexd process and protocol, the robustness regime, and the migration plan. See schematics.md for the authoritative component diagrams and agent.lock.kvx for the build-conduct lock."
include  = "design.body.md"

[delivery]
implementation_posture = "Waves 1-6 are done; Task 7.1 is in progress. The owner approved a hard Neo cutover on 2026-08-04: Neo has one memory substrate, Neocortex, and no source, build, configuration, runtime, or fallback path may reach centra/core/cortex."
verification_posture = "Simulation, sanitizer, fuzz and property evidence is implementation evidence. Live qualification means the real cortexd process serving the real neo daemon on real conversations with the regression corpus green. Structural qualification additionally proves centra/core/cortex is absent from Neo's module graph and reachable source. Neither is a substitute for the other; task completion gates name which is required."

[owner_decisions]
dependency_changes_2026_08_03 = "OWNER YES: dependencies may be added, upgraded, replaced, or removed when needed to implement all Neocortex waves. Every change remains vendored, version-pinned, digest-pinned, justified against the architecture, and subject to every other agent.lock.kvx constraint. This authorization does not approve event-taxonomy drift, cutover, old-cortex deletion, destructive migration, or production actions."
belief_gate_admission_2026_08_04 = "OWNER YES: sanction pre-commit policy admission for assertion, consolidation, and retract socket batches while retaining actual belief mutation exclusively in APPLY. Policy rejections at APPLY are deterministic skips so legacy or imported logs cannot make replay unbootable. Admission uses the same deterministic gate semantics against the current projection snapshot plus earlier events in the batch and performs no durable mutation."
neo_execution_surface_2026_08_04 = "OWNER YES: qualification failures caused by Cortex-v1 compensation code are corrected as one Neo execution-surface change: native local tools shadow overlapping legacy coding schemas; Build admission selects or creates a project in one operation; prediction mismatch applies only to genuinely uncertain network/search probes; shell output is structured and retrievable; multi-file mutation is atomic; coding state is a typed durable checkpoint; model-authored recovery narration is private and public progress consists only of deterministic runtime milestones. Evidence-backed Cortex-v1 compensations may be removed, but this does not authorize cutover, production restart, deployment, or old-cortex deletion."
neo_neocortex_only_cutover_2026_08_04 = "OWNER YES: Neo SHALL have no Cortex-v1 awareness or reachability. Remove centra/core/cortex from Neo source, tests, module graph, configuration, CLI, construction, proxy, and fallback paths. Neocortex is Neo's sole memory engine; loss of Cortex-v1 memories is accepted. An unavailable Neocortex surfaces an honest typed failure and SHALL never fall back. Cortex v1 may remain temporarily outside Neo only when unreachable from Neo. This authorizes the Neo cutover and supersedes the earlier migration-preservation and side-by-side requirements; it does not authorize production restart, deployment, or deletion of unrelated consumers' data."

[protocol]
step_0_lock      = "Read protocol/spec/neocortex/agent.lock.kvx IN FULL before any other file, every session. It is the build-conduct contract: any implementation that drifts from it, from spec.kvx, or from schematics.md is a FAILED task — stop and surface, never silently adapt."
step_1_context   = "Run cortex recall once when available; read any truncated output in full before reasoning. Then read protocol/spec/neocortex/spec.kvx, schematics.md, design.body.md, and the latest neocortex handoff. Before editing a seam, read the owning file in full. Use CodeGraph first when the repository is indexed."
step_2_select    = "Pick the ONE next eligible pending task in the lowest wave whose requires are done. Set it in_progress before implementation. At most ONE task may be in_progress."
step_3_build     = "Implement only the selected task against its referenced acceptance criteria and the schematics.md structure for that component. The schematic is authoritative for module boundaries, data flow, and naming; a needed deviation is an owner decision, not an agent improvisation."
step_4_test      = "Use real code paths and real processes; never add stub, mock, fake, or placeholder implementations. Engine tests run the real state machine under the deterministic simulation harness; client tests run the real cortexd binary over a real socket. Run the affected build, sanitizer, fuzz-smoke, property, and specgen gates before completion."
step_5_close_out = "Only after genuine verification, mark the task done, regenerate specifications, and record a concise HANDOFF neocortex outcome with exact green checks, remaining work, and next eligible task."
step_6_guard     = "Before destructive, irreversible, production, credential, or external-write actions, run the available guard and stop for explicit owner approval where required. No git commit or push on the dev box."
handoff_convention = "Prefix the durable outcome with HANDOFF neocortex and include tasks completed, current spec status, exact verification, next eligible task, and honest partials."

[quality_bar]
one_ground_truth   = "The event log is the only non-rebuildable state. Any task that persists non-derived state outside the log, or derived state that cannot be rebuilt by replay, is drift."
determinism        = "The engine core never reads the clock, entropy, or the filesystem except through injected interfaces. The deterministic simulation harness must stay green at every wave; a change that breaks replay convergence is drift."
structural_honesty = "Cognition/evidence separation is enforced by the type system, not convention: guidance, doubt, steering, and rejected answers have no event kind and cannot enter the log. Delivered means a delivered_msg event exists; nothing else counts."
continuity         = "INV-1 is the prime invariant. The intent frame is never trimmed from an activation; open loops close only by explicit typed events; successors are briefed by projections, never by narrative summaries."
mechanism_policy   = "cortexd is mechanism only: no model calls, no network egress, no semantic extraction. Consolidation extraction, embeddings, and story enrichment stay in Go and arrive as events through the gate."
bounded_deps       = "Exactly the dependency set pinned in agent.lock.kvx, vendored and digest-pinned. Adding, upgrading, or swapping a dependency requires explicit owner YES recorded in the spec."
no_fakes           = "All qualification uses the real engine, real files, real crashes (kill -9 in simulation and on process), real socket clients. A green check driven by a fake is not completion."
non_goals          = "No distributed replication in v1 (the log makes it possible later; it is not built now). No ANN index structures. No general-purpose query language. No cross-actor shared memory. No embedded scripting. No exposure of cortexd beyond the local socket."

# ============================== REQUIREMENTS ==============================

[req.1]
title = "The evidence log: one append-only, sealed, tamper-evident ground truth"
story = "As the Matrix memory substrate, I want every fact about what happened to enter one typed append-only log, so that nothing Neo experienced can be lost, forged, or double-recorded."
ac_1 = "THE engine SHALL persist one append-only event log per actor as fixed-format frames (length, crc32c, lsn, kind, wall timestamp, actor, conversation, sealed FlatBuffers payload) in bounded segment files, with group-commit durability barriers."
ac_2 = "THE event kind taxonomy SHALL be exactly the set frozen in agent.lock.kvx (conversation, work, intent, memory, and control kinds, including exact provider-byte frames absorbed from sessionjournal). Guidance, doubt, steering, and rejected answers SHALL have no representable kind."
ac_3 = "ON boot, THE engine SHALL verify the log tail by checksum, truncate at most one torn frame at the physical tail, and refuse to start on any interior corruption, reporting the exact lsn."
ac_4 = "A BLAKE3 merkle mountain range over frame hashes SHALL provide tamper evidence with O(log n) range proofs; checkpoint roots SHALL be ed25519-signed and verifiable offline, preserving the MEMORY VERIFIED property."
ac_5 = "EVERY frame payload SHALL be sealed with XChaCha20-Poly1305 record AEAD below the hash boundary under the vault KEK to UK to DEK hierarchy, with associated data binding actor, lsn, and kind; key destruction SHALL render the actor's log unreadable (crypto-deletion)."
ac_6 = "WRITE-AHEAD ordering SHALL hold for work: a tool_call event SHALL be durable before the tool executes, and only a delivered_msg event SHALL represent user-visible assistant output."

[req.2]
title = "Deterministic single-writer state machine with rebuildable projections"
story = "As the engine, I want all mutable state to be a pure function of the log prefix, so that rebuild is always correct, testing is exhaustive, and replication is possible later."
ac_1 = "ONE writer thread SHALL apply events in lsn order; the core SHALL obtain time, entropy, and I/O exclusively through injected interfaces so that identical logs produce byte-identical projections."
ac_2 = "ALL projections (belief store, entity index, vector lane, BM25, temporal ladder, intent frame, work ledger, conversation heads) SHALL live in per-actor LMDB environments keyed with their applied-lsn checkpoint, and deleting any or all projections followed by replay SHALL reproduce them byte-identically."
ac_3 = "READERS SHALL serve queries from consistent snapshots without blocking the writer, via epoch-pinned read transactions."
ac_4 = "A deterministic simulation harness SHALL drive the engine with simulated clock, I/O faults (torn writes, short reads, reordered or lying fsync), and process kill at arbitrary lsns, asserting replay convergence and recovery invariants; it SHALL run in CI at every wave."
ac_5 = "THE engine SHALL enforce a static memory budget: large allocations at startup, per-request arena allocators reset per operation, and a hard bound on peak resident memory per actor."

[req.3]
title = "Belief store behind one write gate with mandatory provenance"
story = "As Neo's durable memory, I want beliefs to exist only as gated projections of evidence, so that duplicates, poisoning, and evidence-free convictions are structurally impossible."
ac_1 = "BELIEFS (typed facts, preferences, constraints, goals, identity records) SHALL be created and revised exclusively by the apply-time write gate from assertion and consolidation events; no API SHALL write a belief directly."
ac_2 = "EVERY belief SHALL carry provenance lsn ranges into the log; the schema SHALL make a provenance-free belief unrepresentable."
ac_3 = "THE gate SHALL perform canonical-identity typed upsert with supersession chains and bi-temporal validity (as_of queries over both valid time and transaction time)."
ac_4 = "WHEN an incoming belief contradicts a live head with a different canonical identity, THE gate SHALL record a typed conflict edge that the activation composer is obligated to surface whenever either side surfaces."
ac_5 = "A negative-existence assertion (a claim that a thing is gone, defunct, or nonexistent) SHALL be rejected by the gate unless its provenance includes corroborating tool_result evidence."
ac_6 = "EXPLICIT remembers (MCP remember verbs, memory_mutate, preference feedback, profile writes) SHALL enter as assertion events through the same gate; user-directed retraction SHALL be a typed retract event honored by projections and recall."

[req.4]
title = "Deterministic-first index plane"
story = "As recall, I want existence to be guaranteed and relevance to be enriched, so that a stored identifier can never fail to surface (the Moltbook class dies structurally)."
ac_1 = "AN entity index SHALL deterministically extract operational identifiers (domains, URLs, paths, hex and structured ids, proper names) from every applied event and belief into an exact-match table; WHEN an identifier or its entity appears in an activation query or turn text, its records SHALL surface with guaranteed recall."
ac_2 = "THE vector lane SHALL be exact brute-force SIMD scan over quantized (int8, with binary prefilter) mmap-resident vectors — recall equal to one, deterministically; no approximate-nearest-neighbor structure SHALL be built."
ac_3 = "EMBEDDINGS SHALL arrive from clients as embedding events bound to a target lsn or belief; records without embeddings SHALL remain fully reachable through the entity and lexical lanes; vector state SHALL rebuild from the log alone."
ac_4 = "A BM25 lexical index over roaring bitmaps SHALL cover messages and beliefs; ranked fusion across semantic and lexical lanes SHALL use reciprocal rank fusion with a deterministic tiebreak."
ac_5 = "A temporal ladder projection SHALL maintain wall-clock windowed rollups over the log with recursive descent handles, so coarse-to-exact time navigation (the RLM pattern) survives the rewrite."

[req.5]
title = "INV-1: thread continuity is never lost"
story = "As Neo, I can never lose track of the current conversation, the work done in the active thread, and what I need to do next — across any crash, respawn, overflow, or compaction."
ac_1 = "THE activation for a conversation SHALL always contain: a faithful projection of every exchanged turn (coarsened but never dropped), the work ledger with every effect's reconciled status, and the intent frame (current objective plus every open loop). All three SHALL be composed deterministically, never probabilistically."
ac_2 = "INTENT SHALL be write-ahead: intent_set events SHALL be durable before dependent work dispatches; loop_opened events SHALL create obligations that appear in every subsequent activation until a loop_closed event with a typed reason (done, abandoned with cause, handed_off, superseded) exists. Nothing SHALL close silently."
ac_3 = "THE work ledger SHALL distinguish dispatched, committed, returned, and outcome-unknown effects from the log alone; boot after a crash SHALL mark in-flight effects for reconciliation before the thread continues."
ac_4 = "SUCCESSOR briefing SHALL be evidence replay: the respawn path SHALL consume the window projection, work ledger, and intent frame, and SHALL NOT consume any predecessor-written narrative summary as authority."
ac_5 = "THE activation budget SHALL trim in the fixed order: enrichment lanes first, mid-conversation coarsening second, and SHALL never trim the resident tier, the intent frame, or the work ledger tail; an intent frame alone exceeding budget SHALL surface as an engine invariant violation, not a trim."
ac_6 = "THE simulation harness SHALL kill the engine at every lsn of a scripted multi-turn multi-tool conversation, boot a successor, and assert ac_1 through ac_4 hold on the very next composed activation; this property SHALL run in CI."

[req.6]
title = "One activation composer"
story = "As the agent loop, I want one composed, budgeted context bundle per iteration, so that five uncoordinated retrieval systems collapse into a single deterministic contract."
ac_1 = "ONE Activate operation (conversation, query, budget) SHALL replace the legacy Activate, Retrieve, LexicalConversation, episodic, and conversational-recaller lanes, composing in strict tier order: resident (identity, hard constraints, active goals), intent frame, work ledger tail, conversation projection, entity-lane hits, conflict-obligated beliefs, fused semantic plus lexical enrichment, and temporal descent handles."
ac_2 = "THE composer SHALL be a pure read: identical log prefix, query, and budget SHALL yield a byte-identical bundle, pinned by golden vectors."
ac_3 = "BUDGETING SHALL use a caller-supplied token model (a counting callback or table), not a bytes-per-token heuristic; each tier SHALL report its spend and what was trimmed."
ac_4 = "THE bundle SHALL be structured (typed sections with URIs and provenance), leaving rendering to the client; every surfaced item SHALL be attributable back to log lsns or belief ids."
ac_5 = "SURFACED-memory attestation (used or ignored signals) SHALL return as events so salience learning remains possible as a projection concern, not an engine hot-path concern."

[req.7]
title = "cortexd process, local protocol, and the Go client seam"
story = "As the Matrix runtime, I want one brain process per user reached over a local socket, so that every consumer shares one consistent memory and a cortex crash never kills the agent."
ac_1 = "CORTEXD SHALL run as one process per user, serving a Unix domain socket with a versioned, FlatBuffers-framed request/response and subscription protocol; it SHALL make no outbound network connections and SHALL never invoke a model."
ac_2 = "PER-connection capability tokens SHALL scope each client to an actor namespace; neo, the executor daemon's cortex routes, and MCP tooling SHALL all be clients of the same process rather than co-owners of store files."
ac_3 = "A Go client package SHALL implement the existing resurrection loop interfaces (ActivationSource, TurnRecorder, EvidenceJournal, Consolidator sink, CheckpointStore) over the protocol, so the runtime loop swaps substrates without loop code changes."
ac_4 = "A cortexd crash SHALL never take down the agent process: the client SHALL degrade gracefully (bounded queue then honest failure), the supervisor SHALL restart cortexd, and reconnection SHALL resume with no lost acknowledged writes and no duplicate application of unacknowledged writes (idempotent append keyed by client sequence)."
ac_5 = "TURN checkpoints (the turnstate role) SHALL be servable from checkpoint events and a latest-checkpoint projection, so mid-turn cursor recovery and thread continuity are one mechanism."
ac_6 = "AN admin surface (same socket, separate capability) SHALL expose health, per-operation latency histograms, log/projection stats, verification status, and a manual rebuild trigger."

[req.8]
title = "Robustness regime: toolchain, safety discipline, and adversarial CI"
story = "As the owner, I want the engine held to a database-kernel bar, so that memory safety and crash correctness are proven properties, not C++ hopes."
ac_1 = "THE engine SHALL build as C++23 with the exact pinned toolchain, flags, and hardened standard library recorded in agent.lock.kvx; the core SHALL compile with exceptions disabled and use typed std::expected errors on all fallible paths."
ac_2 = "OWNERSHIP discipline SHALL hold: no raw owning pointers or naked new/delete, arena allocation per request, bounded queues everywhere, and clang-tidy enforcement of the ruleset in CI at zero warnings."
ac_3 = "CI SHALL run address, undefined-behavior, and thread sanitizer matrices over the full test suite, libFuzzer targets over every decoder (frame parser, FlatBuffers verification, protocol framing, query input), and property-based tests for upsert idempotency, replay convergence, MMR consistency, and AEAD round-trips."
ac_4 = "THE dependency set SHALL be exactly the vendored, digest-pinned list in agent.lock.kvx; the build SHALL be reproducible and cross-compiled for amd64 and arm64 with a static runtime."
ac_5 = "EVERY untrusted input boundary (socket frames, imported events, on-disk state) SHALL be verified before trust; a malformed input SHALL produce a typed rejection, never undefined behavior, proven by fuzz corpora kept in-tree."

[req.9]
title = "Hard Neo cutover, absorption, and structural Cortex-v1 exclusion"
story = "As the owner, I want Neo to know only Neocortex, so Cortex-v1 cannot influence, fail, or silently recover any Neo turn."
ac_1 = "NO Neo source file, test, module dependency, build target, configuration key, command-line flag, or runtime construction path SHALL import, name as a selectable substrate, open, query, write, proxy, or fall back to centra/core/cortex. A structural CI gate SHALL prove the exclusion."
ac_2 = "NEOCORTEX SHALL be Neo's sole memory engine with no substrate selector. Startup SHALL require a valid Neocortex client configuration; an unavailable or unhealthy cortexd SHALL produce an honest typed failure and SHALL never route to Cortex v1."
ac_3 = "THE hello-world sessionjournal lane SHALL be absorbed: its event kinds and exact provider-byte sidecar are promoted into the log taxonomy, and no second event-sourcing system SHALL remain on the cutover path."
ac_4 = "EXTERNAL consumers (executor daemon cortex routes, bridge, MCP tooling) SHALL be re-pointed to cortexd clients; the MCL compile-cache seed SHALL derive from the neocortex checkpoint root by an owner-approved rule."
ac_5 = "CORTEX v1 MAY remain temporarily for unrelated consumers, but it SHALL be outside Neo's source and module graph and unreachable from the Neo process. Deletion or migration of unrelated consumers remains separately owner-gated."

# ================================ TASKS ==================================

[tasks]
heading = "Implementation Plan: NEOCORTEX — scaffold the engine and its adversarial CI, prove the log and the deterministic core, gate beliefs behind evidence, build the deterministic-first index plane, make INV-1 machine-checked, expose cortexd and the Go seam, then migrate and cut over under owner gates"

[task.1]
section = "W1 — Engine skeleton, toolchain lock, log, and tamper evidence"
title   = "Repository scaffold, frame codec, segment log, MMR"
status  = "done"

[task.1.1]
title  = "neocortex module scaffold with locked toolchain and adversarial CI"
status = "done"
wave   = 1
do_1   = "Create the core/neocortex/ module exactly per schematics.md section 2: CMake build with the pinned toolchain and flags from agent.lock.kvx, vendored digest-pinned dependencies, hardened libc++, -fno-exceptions core, clang-tidy ruleset, and cross-compilation for amd64/arm64."
do_2   = "Stand up CI jobs: build matrix, ASan/UBSan/TSan suites, libFuzzer smoke targets, clang-tidy zero-warning gate, and a reproducible-build check."
do_3   = "Prove the scaffold with a real end-to-end walking skeleton: open an actor directory, append one raw frame, read it back, verify checksum — under ASan and the fuzzer harness."
reqs   = ["8.1", "8.2", "8.4"]

[task.1.2]
title  = "Segment log: frame codec, group commit, torn-tail recovery"
status = "done"
wave   = 1
do_1   = "Implement the frame format and segment files from schematics.md section 3: length/crc32c/lsn/kind/timestamp/actor/conversation header, sealed payload slot, bounded segments, io_uring write path with a portable pwrite fallback, group-commit durability barriers."
do_2   = "Implement boot verification: tail checksum walk, single torn-frame truncation at the physical tail, fail-closed interior-corruption refusal with exact lsn reporting."
do_3   = "Test with real files and injected faults: torn writes, short reads, crash between frames; fuzz the frame parser; property-test append/read round-trips."
reqs   = ["1.1", "1.3", "8.5"]
requires = ["1.1"]

[task.1.3]
title  = "BLAKE3 MMR, signed checkpoints, and range verification"
status = "done"
wave   = 1
do_1   = "Implement the merkle mountain range over frame hashes with O(log n) append and range proofs, ed25519-signed checkpoint roots, and an offline verifier CLI."
do_2   = "Bind verification into boot and the admin surface so the MEMORY VERIFIED root line survives the rewrite."
do_3   = "Property-test MMR consistency across appends, restarts, and simulated corruption; prove a forged frame or reordered range fails verification."
reqs   = ["1.4"]
requires = ["1.2"]

[task.2]
section = "W2 — Deterministic core, projections substrate, and sealing"
title   = "State machine, DST harness, LMDB projections, vault AEAD"
status  = "done"

[task.2.1]
title  = "Deterministic single-writer core and the simulation harness"
status = "done"
wave   = 2
do_1   = "Implement the single-writer apply loop with injected clock/entropy/IO interfaces per schematics.md section 5; no core path may touch wall time, randomness, or the filesystem directly."
do_2   = "Build the deterministic simulation harness: simulated disk with torn-write/short-read/fsync-lie fault models, simulated clock, scripted event workloads, and kill-at-any-lsn process death."
do_3   = "Prove replay convergence: identical logs yield byte-identical projection state across thousands of randomized fault schedules in CI."
reqs   = ["2.1", "2.4"]
requires = ["1.2"]

[task.2.2]
title  = "LMDB projection substrate and the rebuild law"
status = "done"
wave   = 2
do_1   = "Stand up per-actor LMDB environments with per-projection applied-lsn checkpoints, epoch-pinned read snapshots, and the writer/reader thread model from schematics.md section 5."
do_2   = "Implement the rebuild law as an operation: drop any or all projections, replay from the log, converge byte-identically; wire it to the admin rebuild trigger."
do_3   = "Property-test rebuild equivalence under the simulation harness, including mid-rebuild crash and resume."
reqs   = ["2.2", "2.3", "7.6"]
requires = ["2.1"]

[task.2.3]
title  = "Vault sealing below the hash boundary and crypto-deletion"
status = "done"
wave   = 2
do_1   = "Implement XChaCha20-Poly1305 record AEAD for frame payloads under the KEK to UK to DEK hierarchy with associated data binding actor/lsn/kind; hashes commit to plaintext so MMR verification is unchanged by sealing."
do_2   = "Implement key destruction as crypto-deletion with a verifiable receipt: post-destruction reads fail closed with a typed error."
do_3   = "Test round-trips, wrong-user rejection, tamper rejection, legacy-plaintext refusal, and AEAD property tests; fuzz the unseal path."
reqs   = ["1.5"]
requires = ["1.2"]

[task.3]
section = "W3 — Event schema, belief store, and the write gate"
title   = "Frozen taxonomy, typed upserts, contradiction and poisoning defenses"
status  = "done"

[task.3.1]
title  = "FlatBuffers event schema and the frozen kind taxonomy"
status = "done"
wave   = 3
do_1   = "Author the FlatBuffers schema for every event kind frozen in agent.lock.kvx, including exact provider-byte frames and the intent kinds; encode the write-ahead ordering rules (tool_call before execution, delivered_msg as the only delivery representation) into the apply-time validators."
do_2   = "Implement schema evolution rules (additive-only, verifier-before-trust) and reject unknown or forbidden kinds at both the socket and import boundaries."
do_3   = "Fuzz the schema verifier; property-test that no representable event encodes guidance/steering; golden-vector the canonical encodings."
reqs   = ["1.2", "1.6", "8.5"]
requires = ["2.1"]

[task.3.2]
title  = "Belief store projection: typed upserts, supersession, bi-temporality"
status = "done"
wave   = 3
do_1   = "Implement the belief store per schematics.md section 6: canonical-identity typed upsert, supersession chains, bi-temporal heads with as_of reads, and schema-mandatory provenance lsn ranges."
do_2   = "Implement retraction (typed retract events) and tombstone semantics honored by every projection and read path."
do_3   = "Property-test upsert idempotency, supersession ordering under replay, as_of correctness, and the unrepresentability of a provenance-free belief."
reqs   = ["3.2", "3.3", "3.6"]
requires = ["3.1", "2.2"]

[task.3.3]
title  = "The write gate: contradiction edges and anti-poisoning rules"
status = "done"
wave   = 3
do_1   = "Implement apply-time gate semantics: same-identity assertions supersede; cross-identity contradictions record typed conflict edges; the composer contract marks conflicted beliefs as obligated surfacing."
do_2   = "Enforce the negative-existence rule: reject gone/defunct/nonexistent assertions lacking corroborating tool_result provenance, with a typed rejection the client can surface."
do_3   = "Test with real assertion streams reproducing the Moltbook poisoning and duplicate-fact incidents; prove both classes are structurally rejected or reconciled."
reqs   = ["3.1", "3.4", "3.5"]
requires = ["3.2"]

[task.4]
section = "W4 — Deterministic-first index plane"
title   = "Entity lane, exact SIMD vectors, BM25, temporal ladder"
status  = "done"

[task.4.1]
title  = "Entity index with guaranteed recall"
status = "done"
wave   = 4
do_1   = "Implement deterministic identifier extraction (domains, URLs, paths, hex and structured ids, proper names) at apply time into an exact-match entity table over roaring bitmaps, per schematics.md section 7."
do_2   = "Implement the query side: identifier and entity detection over activation queries and turn text with guaranteed surfacing of matching records."
do_3   = "Property-test extraction determinism and the recall guarantee: any stored identifier queried verbatim or by entity always surfaces; replay rebuilds the index byte-identically."
reqs   = ["4.1"]
requires = ["3.1", "2.2"]

[task.4.2]
title  = "Exact SIMD vector lane and BM25 lexical lane"
status = "done"
wave   = 4
do_1   = "Implement the flat vector store (int8 quantization, binary prefilter, mmap-resident) with a highway-based SIMD exact scan; embeddings enter as embedding events so the lane rebuilds from the log alone."
do_2   = "Implement the BM25 inverted index over roaring bitmaps for messages and beliefs, and reciprocal rank fusion with a deterministic tiebreak across the two lanes."
do_3   = "Benchmark scan latency against the activation budget on realistic per-actor corpus sizes; property-test exactness against a scalar reference implementation; prove records without embeddings stay reachable via entity and lexical lanes."
reqs   = ["4.2", "4.3", "4.4"]
requires = ["3.1", "2.2"]

[task.4.3]
title  = "Temporal ladder projection and recursive descent"
status = "done"
wave   = 4
do_1   = "Implement wall-clock windowed rollup records over the log with coarse-to-fine descent handles, rebuilt deterministically from event timestamps and lsns."
do_2   = "Expose descent as a read operation (list windows, open window, resolve members) preserving the RLM navigation pattern."
do_3   = "Property-test ladder idempotency and self-healing rebuild of missing or stale tiers."
reqs   = ["4.5"]
requires = ["2.2", "3.1"]

[task.5]
section = "W5 — Continuity and the composer"
title   = "Intent frame, work ledger, one Activate, INV-1 proven at every lsn"
status  = "done"

[task.5.1]
title  = "Intent frame and work ledger projections"
status = "done"
wave   = 5
do_1   = "Implement the intent frame projection over intent_set/loop_opened/loop_closed with typed closure reasons and the write-ahead discipline; open loops persist in every activation until explicitly closed."
do_2   = "Implement the work ledger projection: dispatched/committed/returned/outcome-unknown effect states derived from write-ahead tool_call and tool_result events, with boot-time in-flight marking for reconciliation."
do_3   = "Test crash-at-uncertain-points scenarios in the simulation harness: in-flight effects surface as needing reconciliation, never as silently done or silently lost."
reqs   = ["5.2", "5.3", "1.6"]
requires = ["3.1", "2.2"]

[task.5.2]
title  = "The activation composer"
status = "done"
wave   = 5
do_1   = "Implement Activate per schematics.md section 8: strict tier order (resident, intent frame, work ledger tail, conversation projection, entity hits, conflict-obligated beliefs, fused enrichment, descent handles), caller-supplied token model, per-tier spend and trim reporting, structured bundle with URIs and provenance."
do_2   = "Enforce the trim law: enrichment first, mid-conversation coarsening second, resident/intent/ledger-tail never; an oversized intent frame is a typed invariant violation."
do_3   = "Pin determinism with golden vectors (identical prefix, query, budget yield a byte-identical bundle) and wire surfaced-attestation return events."
reqs   = ["6.1", "6.2", "6.3", "6.4", "6.5", "5.5"]
requires = ["5.1", "4.1", "4.2", "4.3"]

[task.5.3]
title  = "INV-1 machine-checked at every lsn"
status = "done"
wave   = 5
do_1   = "Script a representative multi-turn, multi-tool, multi-loop conversation workload in the simulation harness, including overflow pressure and compaction."
do_2   = "Kill the engine at every lsn, boot a successor, compose the next activation, and assert all INV-1 clauses: faithful conversation, reconciled ledger, complete intent frame, evidence-only briefing."
do_3   = "Run the property in CI as a hard gate; any clause failure at any lsn fails the build."
reqs   = ["5.1", "5.4", "5.6", "2.4"]
requires = ["5.2"]

[task.6]
section = "W6 — cortexd and the Matrix seam"
title   = "Process, protocol, Go client, crash isolation"
status  = "done"

[task.6.1]
title  = "cortexd process and the local protocol"
status = "done"
wave   = 6
do_1   = "Implement cortexd: Unix domain socket server with versioned FlatBuffers framing, request/response and subscription streams, per-connection capability tokens scoping actor namespaces, and idempotent append keyed by client sequence."
do_2   = "Implement the admin capability: health, latency histograms, log/projection stats, verification status, manual rebuild; no outbound network, no model calls, enforced structurally (no client library for either linked into the engine)."
do_3   = "Fuzz the protocol framing; test capability isolation between actors; soak-test with concurrent clients under the sanitizer matrix."
reqs   = ["7.1", "7.2", "7.6", "8.5"]
requires = ["5.2"]

[task.6.2]
title  = "Go client implementing the resurrection loop seam"
status = "done"
wave   = 6
do_1   = "Create the Go client module implementing ActivationSource, TurnRecorder, EvidenceJournal, Consolidator sink, and CheckpointStore over the protocol, including checkpoint events and the latest-checkpoint projection replacing the turnstate role."
do_2   = "Implement crash isolation: bounded queue then honest typed failure while cortexd is down, supervisor restart wiring, reconnect with no lost acknowledged writes and no duplicate unacknowledged application."
do_3   = "Test against the real cortexd binary over a real socket: the full resurrection loop interface contract, kill -9 of cortexd mid-turn with recovery, and a real neo runtime loop smoke on the new substrate behind the flag."
reqs   = ["7.3", "7.4", "7.5"]
requires = ["6.1"]

[task.7]
section = "W7 — Migration, absorption, and gated cutover"
title   = "Neo hard cutover, absorption, consumer re-point"
status  = "in_progress"

[task.7.1]
title  = "Remove Cortex v1 from Neo completely"
status = "done"
wave   = 7
do_1   = "Remove centra/core/cortex from every Neo source file, test, module requirement, configuration field, CLI flag, constructor, runtime branch, and proxy path. Remove the substrate selector and all silent fallback behavior."
do_2   = "Make Neo's memory contracts and implementations Neocortex-native. Startup requires the real cortexd socket and scoped token; loss or unavailability returns an honest typed Neocortex error without touching Cortex v1."
do_3   = "Add a structural CI gate proving the Neo source tree and complete module graph cannot reach centra/core/cortex. Exercise the real Neo daemon against the real cortexd process, including unavailable-cortexd behavior."
reqs   = ["9.1", "9.2", "7.3", "7.4"]
requires = ["6.2"]

[task.7.2]
title  = "Neocortex-only Neo qualification"
status = "in_progress"
wave   = 7
do_1   = "Run the fixed-incident regression corpus, the INV-1 property, and the Moltbook/duplicate/poisoning reproductions with Neo built and run only against Neocortex."
do_2   = "Run real conversations on a dev daemon against cortexd, including process loss/restart, and prove no Neo process or build artifact opens a Cortex-v1 store."
do_3   = "Record exact green checks and any divergences; a behavioral divergence is a stop, not a footnote."
reqs   = ["9.1", "9.2", "9.3"]
requires = ["7.1"]

[task.7.3]
title  = "Consumer re-point and the owner cutover gate"
status = "pending"
wave   = 7
do_1   = "Re-point external consumers to cortexd clients: executor daemon cortex routes, bridge, MCP tooling; derive the MCL compile-cache seed from the neocortex checkpoint root under an owner-approved rule."
do_2   = "Assemble the consumer re-point evidence package: qualification results, INV-1 CI status, performance envelope, and an honest Neocortex failure/recovery plan with no Cortex-v1 fallback."
do_3   = "Keep unrelated-consumer migration, production restart/deployment, and deletion of Cortex-v1 data as explicit owner gates."
reqs   = ["9.4", "9.5"]
requires = ["7.2"]
