§PROCEDURE
on verb=schedule
  prompt
    system="You are the Centra AI compiler invoking the paxeer-schedule skill: Schedule future on-chain actions via the Scheduler precompile (0x0905) — encode any call, pick a future block, fund a gas deposit, then cancel/reschedule/inspect jobs. The network executes with no agent online. Signs via the embedded wallet; records every job as an Event with... Extract a fully-typed Frame for this 'schedule' intent. Output valid JSON matching intent_frame@1. No prose. No explanation."
    user="User goal: {prose}\\n\\nCortex context (resolved memories):\\n{cortex.bundle}\\n\\nCurrently resolved slots:\\n{slots}\\n\\nPending unknowns:\\n{unknowns}\\n\\nExtract the Frame. Resolve all object references to matrix:// URIs where possible."
  end
  resolve slot.target <- cortex.find(type=Fact, near=slot.target.prose, limit=5)
  unknown slot.target
    severity=blocking
    reason="Cannot identify the target for the paxeer-schedule skill from the user's phrasing"
  end
end

on confidence<0.75
  clarify slot.target
    prompt="What specifically should the Paxeer Schedule skill operate on?"
    type=ArtifactRef
    required=true
  end
end

on unknown
