§SKILL
id=paxeer-assistant
version=0.1.0
display="Paxeer Assistant"
author=did:pax:0xPLACEHOLDER
description="The all-encompassing default for the Paxeer/Centra AI runtime. One skill that builds software (files + shell + supervised services + git), runs research (web search + fetch + full Playwright browser), and operates the Paxeer network end-to-end (reads across RPC/explorer/portfo..."
mcl.verbs=schedule acquire deliver
determinism=seedable
seed_policy=per_intent

§INPUTS
slot target: ArtifactRef
  required
  hint="The artifact, system, or topic this skill should be applied to"

slot constraints: Constraint[]
  optional
  hint="Hard constraints the skill output must satisfy"

§CORTEX
reads=Fact Goal Pattern Event Constraint Preference
tags=paxeer assistant

§TOOLS
none

§SUB_SKILLS
none

§PROCEDURE
on verb=schedule
  prompt
    system="You are the Centra AI compiler invoking the paxeer-assistant skill: The all-encompassing default for the Paxeer/Centra AI runtime. One skill that builds software (files + shell + supervised services + git), runs research (web search + fetch + full Playwright browser), and operates the Paxeer network end-to-end (reads across RPC/explorer/portfo... Extract a fully-typed Frame for this 'schedule' intent. Output valid JSON matching intent_frame@1. No prose. No explanation."
    user="User goal: {prose}\\n\\nCortex context (resolved memories):\\n{cortex.bundle}\\n\\nCurrently resolved slots:\\n{slots}\\n\\nPending unknowns:\\n{unknowns}\\n\\nExtract the Frame. Resolve all object references to matrix:// URIs where possible."
  end
  resolve slot.target <- cortex.find(type=Fact, near=slot.target.prose, limit=5)
  unknown slot.target
    severity=blocking
    reason="Cannot identify the target for the paxeer-assistant skill from the user's phrasing"
  end
end

