  prompt
    system="You are the Centra AI compiler invoking the paxeer-assistant skill: The all-encompassing default for the Paxeer/Centra AI runtime. One skill that builds software (files + shell + supervised services + git), runs research (web search + fetch + full Playwright browser), and operates the Paxeer network end-to-end (reads across RPC/explorer/portfo... Extract a fully-typed Frame for this 'acquire' intent. Output valid JSON matching intent_frame@1. No prose. No explanation."
    user="User goal: {prose}\\n\\nCortex context (resolved memories):\\n{cortex.bundle}\\n\\nCurrently resolved slots:\\n{slots}\\n\\nPending unknowns:\\n{unknowns}\\n\\nExtract the Frame. Resolve all object references to matrix:// URIs where possible."
  end
  resolve slot.target <- cortex.find(type=Fact, near=slot.target.prose, limit=5)
  unknown slot.target
    severity=blocking
    reason="Cannot identify the target for the paxeer-assistant skill from the user's phrasing"
  end
end

on verb=deliver
  prompt
    system="You are the Centra AI compiler invoking the paxeer-assistant skill: The all-encompassing default for the Paxeer/Centra AI runtime. One skill that builds software (files + shell + supervised services + git), runs research (web search + fetch + full Playwright browser), and operates the Paxeer network end-to-end (reads across RPC/explorer/portfo... Extract a fully-typed Frame for this 'deliver' intent. Output valid JSON matching intent_frame@1. No prose. No explanation."
    user="User goal: {prose}\\n\\nCortex context (resolved memories):\\n{cortex.bundle}\\n\\nCurrently resolved slots:\\n{slots}\\n\\nPending unknowns:\\n{unknowns}\\n\\nExtract the Frame. Resolve all object references to matrix:// URIs where possible."
  end
  resolve slot.target <- cortex.find(type=Fact, near=slot.target.prose, limit=5)
  unknown slot.target
    severity=blocking
    reason="Cannot identify the target for the paxeer-assistant skill from the user's phrasing"
  end
end

on confidence<0.75
  clarify slot.target
    prompt="What specifically should the Paxeer Assistant skill operate on?"
    type=ArtifactRef
    required=true
  end
end

on unknown
  clarify slot.target
    prompt="I could not find a matching reference in your memories. Can you describe the target more specifically?"
    type=ArtifactRef
    required=true
  end
end

§OUTPUTS
