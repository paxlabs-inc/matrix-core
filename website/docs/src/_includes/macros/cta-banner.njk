{% macro ctaBanner(heading, description, button_text, button_url) %}
<section class="section section-bleed bg-muted/30 border-y border-border">
  <div class="container-site text-center">
    <h2 class="text-2xl md:text-3xl lg:text-4xl font-semibold tracking-tight mb-4" data-animate="fade-up">{{ heading }}</h2>
    {% if description %}
      <p class="text-lg text-muted-foreground max-w-xl mx-auto mb-8" data-animate="fade-up">{{ description }}</p>
    {% endif %}
    <div data-animate="fade-up">
      <a href="{{ button_url }}" class="btn-cta text-base px-8 py-3">{{ button_text }}</a>
    </div>
  </div>
</section>
{% endmacro %}
