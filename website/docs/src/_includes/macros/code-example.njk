{% macro codeExample(title, code, language, description) %}
<section class="section">
  <div class="container-site">
    <div class="max-w-3xl mx-auto">
      {% if title %}
        <h2 class="text-2xl md:text-3xl font-semibold tracking-tight text-center mb-4" data-animate="fade-up">{{ title }}</h2>
      {% endif %}
      {% if description %}
        <p class="text-muted-foreground text-center mb-8 max-w-xl mx-auto" data-animate="fade-up">{{ description }}</p>
      {% endif %}
      
      <div class="relative rounded-lg overflow-hidden border border-border" data-animate="fade-up">
        {# Terminal header #}
        <div class="flex items-center gap-2 px-4 py-3 bg-muted/50 border-b border-border">
          <div class="flex gap-1.5">
            <span class="w-3 h-3 rounded-full bg-red-500/70"></span>
            <span class="w-3 h-3 rounded-full bg-yellow-500/70"></span>
            <span class="w-3 h-3 rounded-full bg-green-500/70"></span>
          </div>
          {% if language %}
            <span class="ml-2 text-xs text-muted-foreground font-mono">{{ language }}</span>
          {% endif %}
        </div>
        
        {# Code block #}
        <pre class="!rounded-none !border-0 !m-0"><code class="language-{{ language or 'bash' }}" data-typewriter data-lines="{{ code }}">{{ code }}</code></pre>
      </div>
    </div>
  </div>
</section>
{% endmacro %}
