{
  "name": "matrix-marketing-website",
  "version": "1.0.0",
  "description": "Matrix Agent Operating Framework - Marketing Website",
  "type": "module",
  "scripts": {
    "dev": "npx @11ty/eleventy --serve --watch & npx @tailwindcss/cli -i ./src/css/styles.css -o ./_site/css/styles.css --watch",
    "build:css": "npx @tailwindcss/cli -i ./src/css/styles.css -o ./_site/css/styles.css --minify",
    "build:11ty": "npx @11ty/eleventy",
    "build": "npm run build:css && npm run build:11ty",
    "test": "vitest --run"
  },
  "keywords": [
    "matrix",
    "marketing",
    "eleventy",
    "tailwindcss",
    "static-site"
  ],
  "author": "PaxLabs Inc.",
  "license": "MIT",
  "dependencies": {
    "@11ty/eleventy": "^3.0.0",
    "@11ty/eleventy-img": "^6.0.4",
    "@11ty/eleventy-plugin-rss": "^2.0.0",
    "@grimlink/eleventy-plugin-lucide-icons": "^1.0.0",
    "@tailwindcss/cli": "^4.0.0",
    "markdown-it": "^14.0.0",
    "nunjucks": "^3.2.0",
    "sharp": "^0.33.0",
    "tailwindcss": "^4.0.0"
  },
  "devDependencies": {
    "fast-check": "^3.0.0",
    "html-validate": "^8.0.0",
    "jsdom": "^29.1.1",
    "vitest": "^2.0.0"
  }
}
