FROM debian:bookworm-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates chromium xvfb fonts-liberation \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --system --home-dir /var/lib/keith --create-home --shell /usr/sbin/nologin keith

COPY bin/ /opt/keith/bin/
COPY share/ /opt/keith/share/

ENV KEITH_DATA_ROOT=/var/lib/keith \
    KEITH_RUNTIME_ROOT=/run/keith \
    KEITH_CHROMIUM=/usr/bin/chromium \
    KEITH_XVFB=/usr/bin/Xvfb

RUN install -d -o keith -g keith -m 0750 /var/lib/keith /run/keith /var/log/keith

USER keith
VOLUME ["/var/lib/keith", "/var/backups/keith"]
ENTRYPOINT ["/opt/keith/bin/agentd"]
CMD ["--data-root", "/var/lib/keith", "--socket", "/run/keith/agentd.sock"]
