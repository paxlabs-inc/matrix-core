[Unit]
Description=Keith self-hosted agent daemon
After=local-fs.target
Wants=network-online.target

[Service]
Type=simple
User=keith
Group=keith
EnvironmentFile=-/etc/keith/keith.env
RuntimeDirectory=keith
RuntimeDirectoryMode=0750
StateDirectory=keith
StateDirectoryMode=0750
LogsDirectory=keith
LogsDirectoryMode=0750
ExecStart=/opt/keith/bin/agentd --data-root /var/lib/keith --socket /run/keith/agentd.sock
Restart=on-failure
RestartSec=2s
TimeoutStopSec=120s
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/keith /run/keith /var/log/keith
UMask=0027

[Install]
WantedBy=multi-user.target
