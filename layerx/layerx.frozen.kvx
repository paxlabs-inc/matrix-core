# layerx.frozen.kvx — FROZEN architecture spec for LayerX (agent-native settlement fabric).
#
# LayerX is Matrix's, agent-native MONEY + ACCOUNTING layer: ONE always-on
# sequencer that gives every agent an instant-settling, gasless balance denominated in a
# fully-reserved USD unit (USDX), backs that balance with on-chain escrow on Paxeer, issues
# immutable Merkle-provable receipts for every transfer, and net-settles the whole fleet's
# activity to Paxeer mainnet (chain 125) on a tiered schedule. An agent's DID IS its account;
# agents transact through a flexible agentic API instead of plain JSON-RPC.
#
# It is the SETTLEMENT FABRIC, not a product: Deus (service marketplace), gateway LLM
# metering, and owner-set agent budgets are all APPLICATIONS that re-platform onto LayerX.
#
# Format: sectioned KV per the Matrix .kvx convention (see tachyon/internal/config/kvx.go).
#   [section] / [section.sub]   key = "string"   num = 80   list = ["a","b"]   ${ENV}
# String-typed values are ALWAYS double-quoted (Matrix .mtx lexer convention).
#
# STATUS: FROZEN. Design locked with Andrew on 2026-06-15. Changes require a new version.

[meta]
name        = "LayerX"
codename    = "layerx"
kind        = "centralized-agent-native-settlement-fabric"
version     = "1.0.0"
status      = "frozen"
frozen_at   = "2026-06-15"
authors     = ["Andrew", "cursor-agent"]
unit        = "USDX — a fully-reserved USD-denominated agent balance, 1:1 backed by USDL"
relation    = "the money+accounting substrate for the agent fleet; Deus / gateway-metering / agent-budgets are applications ON it; coexists with router, gateway, deus, uwac, tachyon, chronos, browser"
supersedes  = "generalizes the Deus pairwise voucher channels (internal/channels) into a single operator ledger with batched fleet settlement"

[repo]
form        = "new top-level module, mirroring deus / tachyon / chronos / uwac shape"
path        = "/root/matrix/layerx"
module      = "github.com/paxlabs-inc/layerx"
binary      = "layerxd (cmd/layerxd), installed to ./bin like deusd/chronosd/uwacd"
makefile    = "add layerx to root Makefile MODULES + install target"
contracts   = "Solidity settlement/escrow contracts authored + deployed via Tachyon (proven on chain 125); live under layerx/contracts mirroring deus/contracts (Foundry)"
dev_box_git = "the USER drives all commits/submodule wiring; the agent never commits/pushes on the dev box"
bakes_into  = "the MCP proxy tools/layerx baked into the daemon image (deploy/daemon/Dockerfile COPY tools/layerx) like tachyon/chronos; layerxd itself ships to the payments infra box (see [deploy])"

# ================================ MISSION ==================================

[mission]
goal       = "give every agent a native financial environment: hold USD-valued balance, pay any other agent instantly and gaslessly, prove every transfer cryptographically, and have it all net-settle to Paxeer automatically"
why        = "agents transacting on raw L1 JSON-RPC is hostile — per-tx gas, block latency, secp256k1 key handling, and no native notion of an agent identity or an agent receipt; LayerX makes value movement feel native to an agent the way memory and tools already are"
positioning= "the agent-native settlement layer: instant off-chain execution, USD-denominated, escrow-backed, Merkle-receipted, batch-settled to Paxeer"
not_a      = "a new consensus chain (no validators, no mempool, no new token of governance), a custodian of agent keys, or a marketplace — it is settlement INFRASTRUCTURE that many products ride on"

# ============================== PRINCIPLES =================================

[principles]
centralized          = "ONE always-on layerxd sequencer serves the whole fleet; agents are clients, not sequencers — NO per-daemon sequencer (the per-user daemons scale-to-zero on Fly; a sequencer in a suspended VM cannot keep liveness or ordering)"
fabric_not_product   = "LayerX is the substrate; Deus marketplace, gateway metering, and agent budgets are applications that settle ON it — its utility is NOT limited to any one of them"
fully_reserved       = "USDX is 1:1 backed by USDL held in the on-chain vault; USDX supply == USDL in vault at all times; no fractional reserve, no algorithmic peg, no oracle to trust"
escrow_backed        = "off-chain spendable balance is bounded by on-chain escrow; the sequencer can ORDER and BATCH but can never create value or let an agent spend beyond its escrowed reserve"
key_isolation        = "the sequencer holds the fleet's USDL in a CONTRACT vault and one operator key for batch submission only; it NEVER holds an agent signing key — agent DIDs sign their own transfers (same posture as Tachyon multi-tenant token-forwarding)"
provable             = "every transfer is a Merkle leaf with a signed inclusion receipt; batch roots anchor on Paxeer; an agent can verify its receipts independently and detect equivocation"
censorship_escape    = "a single sequencer is a liveness/censorship SPOF by design — the L1 contract MUST expose a unilateral force-withdraw bounded by the agent's last sequencer-co-signed balance, so a dark or withholding sequencer can never trap funds"
did_is_account       = "an agent's verified DID IS its LayerX account; balances, transfers, and receipts are keyed by DID; payout resolves DID -> its mapped Paxeer EVM address"
agentic_api          = "agents transact via a flexible signed-intent / MCP tool API (pay/balance/receipt/deposit/withdraw), not eth_* JSON-RPC"
honest_settlement    = "a settlement that did not land on Paxeer is retried then surfaced; LayerX never reports a settlement or a receipt it cannot prove"

# ============================ ARCHITECTURE =================================

[architecture]
shape        = "Go sequencer (layerxd) + Postgres durable ledger + a Merkle accumulator + a settlement worker + on-chain Paxeer contracts (vault/escrow/settlement-anchor) + a thin MCP stdio proxy (tools/layerx/layerx.mjs) the per-user daemons speak to"
core_insight = "two of the three hard pieces already exist in-repo: (1) the verifiable execution trace — the cortex journal MMR/SMT + D11 replay byte-identity invariant (cortex/journal) is the receipt/anchor primitive; (2) the settlement rail — Deus EIP-712 vouchers + SettlementAnchor + atomic on-chain reserve (deus/internal/{channels,receipts,chain}). LayerX = a single-operator GENERALIZATION of the Deus voucher ledger + a deposit-swap vault + a batched fleet settlement"
agent_view   = "to the agent, LayerX is a handful of MCP tools over a USD balance that just works; all ordering, Merkle, escrow, and settlement plumbing lives behind them"

[architecture.layers]
layer_1 = "vault: on-chain deposit/escrow contract on Paxeer — swaps deposits to USDL, holds reserve, enforces escrow bounds + force-withdraw (see [contracts])"
layer_2 = "ledger: Postgres DID-keyed balance + ordered transfer log — the off-chain source of truth (see [data_model])"
layer_3 = "accumulator: per-batch Merkle MMR over accepted transfers; signed inclusion receipts (see [receipts])"
layer_4 = "settle: a worker that nets the window, submits the batch to the Paxeer settlement-anchor, and anchors the batch root (see [settlement])"
layer_5 = "api + auth: HTTP surface for the MCP proxy, two-layer authenticated by transport bearer + ed25519 agent-DID (see [api], [auth])"

# ============================== TOPOLOGY ===================================

[topology]
runs_on      = "the Deus/payments infra box (the financial control plane), alongside deusd — LayerX is the payments plane and co-locates with it, NOT in the ephemeral per-user Fly daemons"
form_on_box  = "a service layerxd (mirroring the deusd deploy pattern on that box: docker/systemd per [deploy])"
postgres     = "its own layerx database (or schema) with the ledger + batches tables + forward-only migrations, same runner discipline as deus store.Migrate"
listen       = "box-local (configurable LAYERX_PORT), fronted by a public nginx route so Fly daemons can reach it (mirrors the gateway /gw/ and chronos /chronos/ routes)"
chain        = "Paxeer mainnet, EVM chain 125 (Cosmos hyperpax_125-1, instant CometBFT finality, no reorgs); native coin PAX (18 decimals, base denom ahpx); native stable USDL"

[topology.direction_inbound]
what = "agent (Fly daemon) -> layerxd: deposit/withdraw/pay/balance/receipt"
path = "the daemon's tools/layerx/layerx.mjs dials MATRIX_LAYERX_URL over a public nginx route (e.g. https://matrix.paxeer.app/layerx/ -> box-local layerxd), exactly like the chronos /chronos/ and gateway /gw/ routes Fly machines already use"

[topology.direction_chain_in]
what = "Paxeer -> layerxd: observe Deposit events from the vault contract to credit off-chain USDX"
path = "layerxd watches the vault contract via the Deus chain client pattern (deus/internal/chain/client.go); a Deposit(addr, usdl_in, usdx_minted, did_claim) event credits the claiming DID's off-chain balance"

[topology.direction_chain_out]
what = "layerxd -> Paxeer: submit the batched net settlement + anchor the batch root"
path = "the settlement worker submits one tx per window to the settlement-anchor contract (operator key), reusing the Deus chain Payer pattern (deus/internal/chain/payer.go); the contract pays net deltas to mapped EVM addresses + records the batch root"

# =============================== AUTH =====================================
# Two-layer, mirroring Chronos/UWAC: a shared transport bearer proves "a legitimate
# Matrix daemon", and an ed25519 agent-DID handshake proves WHICH agent, so balances
# are DID-scoped and payout resolves from the DID alone.

[auth.transport]
what = "proves the caller is a legitimate Matrix daemon"
how  = "shared bearer MATRIX_LAYERX_TOKEN injected by the router into every machine (exactly like MATRIX_CHRONOS_TOKEN / MATRIX_TACHYON_TOKEN)"
not  = "a shared token alone cannot scope to an account — per-account scoping comes from the principal auth below"

[auth.principal]
what     = "proves WHICH agent owns the balance, so transfers are authorized + payout routes correctly"
how      = "ed25519 agent-DID challenge/verify against layerxd, reusing the daemon executor.key (the same handshake tools/paxeer/lib/agentauth.mjs + tools/tachyon/tachyon.mjs + tools/chronos use); layerxd owns both sides"
keystone = "the agent DID label IS the Supabase user UUID (did:matrix:<MATRIX_USER_ID>:<keyfp>) — the UWAC/Chronos keystone; verify DID signature -> extract account identity"
token    = "verify mints a short-lived HMAC token (keyed by LAYERX_AGENT_AUTH_SECRET) carrying {did, exp}, mirroring deus/internal/server/devauth.go + chronos"
key_fmt  = "64-hex ed25519 SEED on disk at ${MATRIX_DATA_DIR|/data}/.matrix/executor.key; DID = did:matrix:<label>:<hex(pubkey)[:16]> (matches executor/cmd/mcl-execute/identity.go)"
signing  = "every value-moving intent (pay/withdraw) is signed by the agent DID; the signature is the authorization the sequencer ledgers and the settlement contract can later verify — the sequencer cannot move an agent's balance without a DID signature"

# =============================== USDX =====================================
# The unit. Fully reserved, USD-denominated, 1:1 backed by USDL. The DEX swap at
# deposit IS the price oracle AND the reserve mechanism in one atomic step.

[usdx]
definition   = "the LayerX balance unit: a USD-denominated, fully-reserved claim, 1:1 backed by USDL held in the vault"
reserve      = "USDL (Paxeer-native stablecoin, the highest-volume stable in the ecosystem) — the single canonical reserve asset"
invariant    = "total USDX in circulation == USDL held in the vault contract (auditable on-chain at any block)"
no_oracle    = "no external price oracle and no FX risk to the operator: PAX/USDC/USDT deposits are SWAPPED to USDL at deposit time on the Paxeer DEX, so the realized swap output IS the mint amount and the vault is always 100% USDL"
peg_basis    = "USDX robustness == USDL robustness — a deliberate alignment with the native ecosystem stable, the explicit trust assumption of the unit"

[usdx.deposit]
usdl_in      = "deposit USDL -> mint USDX 1:1 (no swap)"
other_in     = "deposit USDC/USDT/PAX -> the vault atomically swaps the deposit to USDL on the Paxeer DEX -> mint USDX equal to the USDL actually received"
example      = "deposit 1 USDC -> ~1 USDX; deposit 1 PAX (≈ $7.17) -> ≈ 7.17 USDX (the DEX swap return is the mint amount)"
slippage     = "every swap carries a min_out guard; a thin-liquidity moment reverts the deposit rather than silently haircutting the mint (deep pools — ~$200M PAX, ~$98M combined USDC/USDT/USDL — make this a rare-edge guard, not a hot path)"
credit       = "layerxd credits the depositing DID's off-chain USDX balance on observing the on-chain Deposit event (confirmed-finality; Paxeer has instant finality + no reorgs)"

[usdx.withdraw]
default      = "burn N USDX -> release N USDL to the agent's mapped Paxeer EVM address"
swap_out     = "optionally swap the released USDL to PAX (or another stable) at the then-current DEX rate — the agent's FX choice, never the operator's risk"
path         = "a withdraw is a DID-signed intent; it debits the off-chain balance and is included in the next settlement (force-settle if material — see [settlement])"

[usdx.account]
identity     = "balances are keyed by agent DID; the DID IS the account"
mapping      = "payout resolves DID -> a Paxeer EVM (secp256k1) address: the DID's embedded wallet (connect.paxportwallet.com / /v1/agent/send), since DIDs are ed25519 and Paxeer L1 is EVM"
binding      = "the deposit carries a DID claim binding the depositor's EVM address to the DID; layerxd records the DID<->EVM mapping so settlement nets to the correct address; an agent may register/update its payout address via a DID-signed call"

# ============================== ESCROW =====================================

[escrow]
principle    = "off-chain spendable USDX is bounded by on-chain reserve held in the vault; the sequencer can never let an agent spend beyond its escrowed balance"
model        = "a deposit IS the escrow — minted USDX is fully collateralized by the USDL it locked; the off-chain ledger can only move balances that were on-chain-funded, mirroring the Deus atomic conditional-reserve (deus/internal/channels/channels.go reserve: conditional UPDATE + RowsAffected)"
exposure     = "between settlements, a payee holds the sequencer's signed promise; because every payer's balance is escrow-bounded and the sequencer cannot forge balances, the worst case is bounded by escrowed reserve, never unbacked credit"
no_credit    = "v1 has NO unbacked operator credit — an agent must deposit before it can spend (avoids the sequencer becoming a trusted balance issuer)"

# ============================= SETTLEMENT ==================================
# TIERED, not flat. Flat 12h is wrong for material value. Batch the high-frequency
# low-value flow; force-settle the rest.

[settlement]
model        = "tiered: net-batch micropayments on a 12h window; force-settle material transfers/withdrawals on demand or by auto-promotion above a value threshold"
why_tiered   = "12h batching only pays off for high-frequency low-value flow (amortizing one L1 tx across thousands of transfers drives per-tx gas -> ~0); for material value you do not want 12h of exposure even with escrow"
net_settle   = "the worker computes per-DID net deltas over the window, submits ONE batch tx to the settlement-anchor contract, and anchors the batch Merkle root; on-chain it pays/nets to mapped EVM addresses"
gasless      = "agents pay NO gas on micropayments — the operator funds the single batch tx (operator-subsidized, recoverable via a thin spread or carried as growth cost); 'gasless to the agent', not literally free"

[settlement.tiers]
micropayment = "transfer value below LAYERX_MICRO_THRESHOLD (e.g. 1 USDX): net-batched, gasless, instant off-chain; settles on the 12h window"
material     = "transfer/withdraw at or above the threshold: auto-promoted to force-settle (immediate L1 anchor); the initiating agent bears that one settlement's gas"
force_settle = "any agent can request immediate settlement of its position regardless of value (explicit cash-out / move-now)"

[settlement.window]
period       = "12h micropayment net-settlement window (configurable LAYERX_WINDOW)"
boundary     = "a window closes -> compute nets -> build the batch + Merkle root -> submit + anchor -> open the next window; receipts issued in the window reference the window/batch they will settle in"
at_least_once= "a settlement is recorded only AFTER the Paxeer tx confirms; a crash mid-settle re-derives the open window from the durable ledger and re-submits (idempotent batch id)"

# ============================== RECEIPTS ===================================
# Reuse the cortex Merkle machinery: domain-separated SHA-256 leaves in an MMR,
# signed inclusion proofs, batch roots anchored on Paxeer.

[receipts]
principle    = "every accepted transfer is a Merkle leaf in the current batch's MMR; the sequencer returns a signed inclusion receipt; the batch root anchors on Paxeer so the receipt becomes independently verifiable"
leaf         = "domain-separated SHA-256 over the canonical CBOR transfer record (same discipline as cortex/journal LeafHash: sha256(domain || canonical_bytes)); deterministic + tamper-evident"
domain       = "layerx.settlement.receipt.v1 (version-prefixed so a format change forces a clean re-anchor)"
record       = "{seq, batch_id, from_did, to_did, amount_usdx, ts, prev_root} — the transfer's canonical leaf preimage"
shape        = "{seq, batch_id, leaf_hash, inclusion_path, batch_root, sequencer_sig}"
verify       = "the agent verifies (a) the sequencer signature over the receipt and (b) leaf -> inclusion_path -> batch_root; after settlement it verifies batch_root was anchored on Paxeer by the settlement-anchor contract"
anti_equiv   = "publishing batch roots on Paxeer + signed receipts means the sequencer cannot equivocate (sign two conflicting histories) without detectable cryptographic proof"
reuse        = "the MMR + canonical-CBOR + domain-separated-leaf primitives already exist in cortex/journal; LayerX uses the same construction for settlement receipts (NOT the cortex store itself — separate accumulator)"

# ============================== LEDGER =====================================

[ledger]
source_of_truth = "the Postgres ledger is authoritative for off-chain balances between settlements; the vault contract is authoritative for reserve + final settled state"
balance         = "per-DID USDX balance + escrow bound; a pay debits sender, credits recipient, appends an ordered transfer record, and emits a receipt — all in one DB tx"
ordering        = "the sequencer assigns a strict monotonic seq per accepted transfer (the 'sequencing' role); ordering is single-operator (no consensus) by design"
atomicity       = "transfer accept = (check escrow bound) + (debit/credit) + (append log) + (stage Merkle leaf) in one batch, mirroring the Deus single-tx voucher discipline (channels/voucher.go: do NOT split co-sign + insert across Execs)"

# ============================= CONTRACTS ===================================
# On Paxeer (chain 125), authored + deployed via Tachyon. Generalize the Deus
# PaymentChannel/SettlementAnchor from pairwise channels to an operator vault.

[contracts]
deploy_via   = "Tachyon (compile/test/simulate/deploy proven on chain 125, MatrixToken precedent); Foundry under layerx/contracts"
vault        = "Vault: accepts deposits (USDL direct, or PAX/USDC/USDT swapped to USDL via the Paxeer DEX router with min_out), holds the USDL reserve, mints accounting against a DID claim, releases USDL on settled withdrawals; total reserve == circulating USDX"
anchor       = "SettlementAnchor: accepts a batch {root, net_delta_list} signed by the operator key, pays/nets USDL to mapped EVM addresses, records the batch root immutably (generalizes deus SettlementAnchor.anchor)"
escape_hatch = "force-withdraw: an agent can unilaterally exit with its last sequencer-co-signed balance after a timeout if the sequencer is dark/withholding — bounds the centralization risk; the contract verifies the co-signed balance proof (EIP-712, like deus vouchers)"
custody      = "the Vault holds the funds; the operator key can ONLY trigger payouts the contract validates against signed balances/roots — the sequencer cannot drain the vault"
chain_safety = "Paxeer is EVM secp256k1; the operator key is an EVM key for batch submission only; agent ed25519 DIDs never touch L1 directly — the contract pays their mapped EVM address"

# ============================= DATA MODEL ==================================

[data_model]
note   = "Postgres; forward-only migrations; mirrors the deus/chronos store discipline"
tables = ["accounts", "transfers", "batches", "deposits", "withdrawals"]

[data_model.accounts]
did            = "agent DID (primary key) — the account identity"
evm_address    = "mapped Paxeer EVM payout address (DID's embedded wallet)"
balance_usdx   = "current off-chain USDX balance (numeric, USD-cent or finer precision)"
escrow_usdx    = "escrowed reserve bound (== net deposits - settled withdrawals)"
created_at     = "timestamptz"
updated_at     = "timestamptz"

[data_model.transfers]
seq            = "strict monotonic sequencer-assigned ordering key (the receipt seq)"
batch_id       = "the settlement batch this transfer belongs to"
from_did       = "payer DID"
to_did         = "payee DID"
amount_usdx    = "transfer amount"
tier           = "micropayment | material"
leaf_hash      = "the Merkle leaf (sha256 domain-separated over the canonical record)"
sig            = "the payer DID signature authorizing the transfer"
ts             = "timestamptz"

[data_model.batches]
batch_id       = "uuid / monotonic id"
root           = "the batch Merkle root"
window_start   = "timestamptz"
window_end     = "timestamptz"
status         = "open | sealing | submitted | anchored | failed"
anchor_tx      = "the Paxeer settlement-anchor tx hash (once submitted)"
net_deltas     = "the per-DID net settlement applied on-chain (audit denormalization)"
last_error     = "honest failure surfacing on submit failure"

# ================================ API ======================================

[api]
healthz                = "GET /healthz -> {status, version} (+ db + chain-client ping)"
agent_auth_challenge   = "POST /v1/agent/auth/challenge {did} -> {message, nonce}"
agent_auth_verify      = "POST /v1/agent/auth/verify {did, public_key, nonce, signature} -> {token}"
balance                = "GET /v1/balance (agent token) -> {did, balance_usdx, escrow_usdx, evm_address}"
deposit_address        = "GET /v1/deposit (agent token) -> the vault address + the DID-claim payload to include in the on-chain deposit"
withdraw               = "POST /v1/withdraw (agent token, DID-signed) {amount_usdx, swap_out?} -> {withdrawal_id, settlement_tier}"
pay                    = "POST /v1/pay (agent token, DID-signed) {to_did, amount_usdx} -> {seq, batch_id, receipt}"
receipt                = "GET /v1/receipt/{seq} (agent token) -> the signed inclusion receipt (+ batch_root + anchor_tx once settled)"
settle                 = "POST /v1/settle (agent token) -> force-settle the caller's current position now"
internal_note          = "all /v1 value endpoints require BOTH the transport bearer AND a valid agent token; account scoping + authorization come from the token DID + the per-intent DID signature, never a request field"

# ============================= TOOL SURFACE ================================
# MCP stdio proxy mirrors tools/tachyon + tools/chronos: initialize/tools/list
# answered LOCALLY from layerx-tools.json (so an unreachable layerxd never bricks
# daemon boot), tools/call forwarded to MATRIX_LAYERX_URL. The proxy mints the
# agent-DID token (reusing executor.key) for every call and signs value intents.

[tools]
proxy        = "tools/layerx/layerx.mjs (stdio), registry tools/layerx/layerx-tools.json, baked into the daemon image"
selftest     = "node tools/layerx/layerx.mjs --selftest = offline drift guard; the advertised set MUST equal the agents/*.json declared set or Manager.verifyTools makes daemon boot fatal"
wiring       = "add a layerx server entry to agents/default.json AND agents/neo.json; add the tool URIs to skills/paxeer-assistant §TOOLS so the freeform hero path can transact"
available_to = "BOTH Neo and the MCL pipeline (ordinary MCP server)"
money_note   = "pay/withdraw move escrow-backed USDX (NOT a user wallet signature) — per the Neo escalation rule, operator-funded value at the agent's OWN escrowed balance can stay Natural; moving the USER's on-chain funds (the deposit FROM the user wallet) still escalates to MCL"

[tools.set]
layerx_balance  = "the caller's USDX balance + escrow bound + payout address"
layerx_deposit  = "get the vault deposit address + DID-claim payload (the on-chain deposit FROM the funding wallet escalates to MCL/wallet signature)"
layerx_pay      = "pay another agent by DID: {to_did, amount_usdx} -> signed receipt"
layerx_receipt  = "fetch the signed inclusion receipt for a transfer seq (+ anchor proof once settled)"
layerx_withdraw = "burn USDX -> release USDL (optionally swap-out) to the mapped EVM address"
layerx_settle   = "force-settle the caller's position now"
naming_note     = "keep layerx-tools.json <-> agents/*.json in strict bijection"

# =============================== CONFIG ====================================

[config]
LAYERX_PORT               = "box-local listen port"
LAYERX_POSTGRES_URI       = "the layerx ledger DB; required"
LAYERX_TOKEN              = "shared transport bearer the MCP proxy must present (= MATRIX_LAYERX_TOKEN on the daemon side)"
LAYERX_AGENT_AUTH_SECRET  = "HMAC secret keying agent-auth nonces + tokens (mirrors DEUS_DEVELOPER_AUTH_SECRET / chronos)"
LAYERX_CHAIN_RPC          = "Paxeer EVM RPC for the chain client (vault event watch + settlement submit)"
LAYERX_ANCHOR_HISTORY_URL = "optional Blockscout-compatible indexed history origin for recovering original anchor tx hashes pruned from the chain RPC"
LAYERX_VAULT_ADDR         = "deployed Vault contract address on chain 125"
LAYERX_ANCHOR_ADDR        = "deployed SettlementAnchor contract address on chain 125"
LAYERX_DEX_ROUTER         = "Paxeer DEX router address used for the atomic deposit swap-to-USDL"
LAYERX_USDL_ADDR          = "USDL token address (the canonical reserve asset)"
LAYERX_OPERATOR_KEY       = "EVM key for batch settlement submission ONLY (holds no agent funds beyond the vault contract); sourced as a secret, never in memory/spec"
LAYERX_WINDOW             = "micropayment net-settlement window (default 12h)"
LAYERX_MICRO_THRESHOLD    = "value below which a transfer is treated as a batched micropayment (default 1 USDX)"
LAYERX_PERPS_MODE         = "global perps mode: OFF|SHADOW|CANARY|ACTIVE|REDUCE_ONLY|PAUSED; default OFF"
LAYERX_PERPS_MARKET_MODES = "comma-separated explicit SYMBOL=MODE overrides; omitted symbols are OFF"
LAYERX_PERPS_MODE_LIFECYCLE = "boot-loaded deployment configuration; runtime mutation is unavailable until durable mode events land with the perps ledger"
LAYERX_DEV                = "relaxes required-secret checks for local skeleton boot (mirrors DEUS_DEV)"

[config.router_side]
MATRIX_LAYERX_URL   = "router MachineEnv: injected into every daemon -> the layerx.mjs proxy dials it (default the public nginx /layerx/ route)"
MATRIX_LAYERX_TOKEN = "router MachineEnv: the transport bearer the proxy presents (= LAYERX_TOKEN)"

# =============================== DEPLOY ====================================

[deploy]
target   = "the Deus/payments infra box, mirroring the deusd deploy pattern (it is the financial control plane and co-locates with Deus)"
artifacts= "deploy/layerx: install/compose, env example, migration apply, README — mirroring deploy/chronos + deploy/deus"
nginx    = "add a public /layerx/ location to deploy/box/nginx/matrix.paxeer.app.conf (strip /layerx/ -> box-local layerxd), mirroring the /gw/ + /chronos/ routes, so Fly daemons can reach it"
contracts= "Vault + SettlementAnchor compiled/tested via Tachyon, deployed to chain 125; addresses pinned into layerxd config — REQUIRES Andrew YES (mainnet deploy + funds)"
db       = "layerxd auto-migrates its tables at boot (forward-only SQL, same runner as deus store.Migrate)"
drives   = "the USER deploys; the agent stages artifacts only and does NOT touch prod (Andrew drives prod redeploys + all on-chain/mainnet actions)"

# ============================= RELATION ====================================

[relation]
to_deus    = "Deus (service marketplace + discovery) becomes ONE application that SETTLES on LayerX: its EIP-712 vouchers + settlement windows generalize into the LayerX operator ledger; a marketplace purchase is just a layerx_pay between two DIDs"
to_gateway = "the gateway's per-token LLM credit_ledger can re-platform onto LayerX so metering settles in native USDX instead of a side ledger"
to_budgets = "owner-set agent spend caps / wallet leashes / PoliciesPanel become native LayerX escrow allowances on a DID — a budget is a bounded USDX reserve"
to_neo     = "Neo transacts via the layerx MCP tools; paying another agent from the agent's OWN escrowed USDX stays Natural; funding the escrow FROM the user wallet escalates to MCL (Neo key-isolation rule holds)"
to_mcl     = "ordinary MCP server, so the rigorous compile->plan->execute pipeline can transact too; LayerX is agent-agnostic"
to_tachyon = "Tachyon authors/deploys the LayerX Solidity contracts to chain 125 (compile/test/simulate/deploy)"
to_chronos = "recurring/streaming payments schedule via Chronos: a Chronos alarm fires -> the agent issues a layerx_pay; deferred money escalates correctly at fire time"
to_chain   = "Paxeer (chain 125) is the L1 of record: deposits, settlement, anchored batch roots, and force-withdraws all live there; LayerX adds NO new consensus or token"

# ============================== INVARIANTS =================================

[invariants]
i1  = "USDX is fully reserved — circulating USDX == USDL held in the vault at every block; no fractional reserve, no algorithmic peg"
i2  = "the sequencer holds NO agent signing key; agent DIDs sign their own transfers; the operator key submits batches only and cannot drain the vault"
i3  = "off-chain spend is escrow-bounded — an agent cannot spend beyond its on-chain-funded reserve; v1 issues no unbacked credit"
i4  = "every transfer has a domain-separated Merkle leaf + signed inclusion receipt; batch roots anchor on Paxeer; receipts are independently verifiable"
i5  = "the sequencer cannot equivocate undetected (signed receipts + on-chain anchored roots) and cannot trap funds (L1 force-withdraw escape hatch bounded by last co-signed balance)"
i6  = "the DID IS the account; payout resolves DID -> mapped EVM address; balances/receipts are DID-scoped from the verified token, never a request field"
i7  = "settlement is tiered — micropayments net-batch on the window (gasless to the agent); material value force-settles; a settlement is recorded only after the Paxeer tx confirms"
i8  = "no per-daemon sequencer — ONE always-on layerxd; the ephemeral scale-to-zero daemons are clients only"
i9  = "honest settlement + receipts — never report a settlement or receipt that cannot be cryptographically proven; surface failures"
i10 = "tool registry <-> manifest stay in strict bijection (layerx-tools.json == agents/*.json) or daemon boot is fatal"

# ============================ DEFERRED / NEXT ==============================

[deferred]
implementation = "this is a FROZEN design spec — no code yet; scaffolding is a future session"
open_decisions = ["exact USDX precision (USD-cent vs 1e6/1e18 fixed-point) + rounding policy on deposit-swap mint", "force-withdraw timeout duration + the co-signed-balance proof format (reuse Deus EIP-712 voucher shape)", "operator gas-subsidy recovery (thin spread vs free) + who funds the operator key", "whether the gateway credit_ledger migrates onto LayerX in v1 or later", "single layerx DB vs a schema in the shared matrix DB on the payments box"]
next_steps     = ["scaffold the layerx Go module (cmd/layerxd + internal config/store/ledger/accumulator/settle/chain/auth/server, mirroring deus/chronos)", "ledger + batches migrations + store queries (balance, pay-atomic, claim-window, net-deltas)", "Merkle accumulator + signed receipt (reuse cortex/journal leaf/MMR construction)", "Vault + SettlementAnchor + force-withdraw Solidity (Foundry under layerx/contracts) authored + tested via Tachyon", "chain client: vault Deposit event watch (credit) + batch settlement submit (deus chain client/payer pattern)", "agent-DID challenge/verify + HMAC token (mirror deus devauth.go + chronos)", "settlement worker (12h window net + force-settle + anchor + retry ladder)", "tools/layerx/layerx.mjs + layerx-tools.json (balance/deposit/pay/receipt/withdraw/settle) + --selftest; wire agents/default.json + neo.json + paxeer-assistant TOOLS", "router MachineEnv MATRIX_LAYERX_URL/TOKEN injection", "deploy/layerx (install + nginx /layerx/ route + README) staged for the payments box; contracts deployed to chain 125 on Andrew YES", "per-module build/vet/test green + layerx.mjs --selftest + manifest bijection"]
