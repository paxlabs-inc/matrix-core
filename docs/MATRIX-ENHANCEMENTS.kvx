[item.P4-2]
title        = "Attestation transparency log: on-chain anchor of cortex OverallRoot"
phase        = "P4"
source       = "Doc #8 (this is the deferred v1.1 piece; cortex Merkle is REAL today)"
effort        = "large"
impact        = "high (verifiable memory provenance) — but deferred"
