# MATRIX-ENHANCEMENTS.kvx — EXECUTABLE implementation work-order for the
# competitor-analysis enhancement roadmap (Hermes/OpenClaw vs Matrix).
#
# Derived from: knowledge/analysis/agent-arch-comparison_* (Neo, source-grounded)
# + the consolidated/deduplicated roadmap (cursor-agent, 2026-06-23).
#
# Format: sectioned KV per the Matrix .kvx convention (tachyon/internal/config/kvx.go).
#   [section] / [section.sub]   key = "string"   num = 80   list = ["a","b"]
#   Strings are ALWAYS double-quoted. One value per line. # starts a comment
#   (ignored inside quotes). Section names case-sensitive; later dup keys win.
#
# THIS FILE IS A CONTRACT, NOT A SUGGESTION. Any agent executing an item MUST
# obey [mandate], [quality_bar], and [protocol.*] with ZERO interpretation
# drift. If the spec is ambiguous for your item, STOP and ask the human — do
# NOT improvise. Read [mandate] in full before touching any code.

[meta]
name        = "Matrix Enhancements — Implementation Work Order"
codename    = "matrix-enhancements"
kind        = "executable-implementation-spec"
version     = "1.0.0"
status      = "active"
created_at  = "2026-06-23"
authors     = ["cursor-agent", "Neo (analysis)"]
workspace   = "/root/matrix"
scope       = "25 work items across 4 phases spanning neo/ executor/ cortex/ MCL/ chronos/ deus/ deploy/ apps/"
language     = "Go (modules: cortex MCL bridge executor neo chronos deus gateway router); TS/Vue (client forge); Capacitor (apps/mobile)"
read_order   = "[mandate] -> [quality_bar] -> [protocol.workflow] -> [phases] -> your [item.*]"

# =========================================================================
# MANDATE — binding, non-negotiable. Violating ANY of these REJECTS the work,
# regardless of whether the feature 'works'.
# =========================================================================

[mandate]
m1_test_everything   = "EVERY new, changed, fixed, or added unit of behavior ships WITH a test that fails before the change and passes after. No test => not done. No exceptions."
m2_pre_post_logging  = "EVERY item is bracketed by a PRE-CHANGE ledger entry (before the first edit) and a POST-CHANGE ledger entry (after verification passes). See [protocol.logging]. No ledger pair => REJECTED."
m3_zero_drift        = "Implement EXACTLY what the item change field specifies — no more, no less. Do not refactor adjacent code, rename symbols, reformat files, or improve things out of scope. Scope creep is drift."
m4_highest_quality   = "Production-grade only: no TODOs, stubs, placeholders, happy-path-only code, dead code, or commented-out blocks. Handle every error and edge. See [quality_bar]."
m5_speed_efficiency  = "The hot path must not regress. No added allocation in per-turn / per-tool-call loops without ledger justification. Prefer O(1)/O(log n); benchmark anything on the request hot path. See [protocol.speed]."
m6_recon_before_edit = "Before editing, RE-CONFIRM every file/line/symbol anchor (anchors drift). See [protocol.recon]. Line numbers are HINTS; the symbol is the truth."
m7_no_commit         = "NEVER git commit, push, tag, or branch unless Andrew explicitly asks in THIS session. Leave changes in the working tree. (Standing hard constraint.)"
m8_no_weaken_tests   = "NEVER delete, skip, weaken, or comment out an existing test to make a build pass. If an existing test legitimately must change, log the reason and get human sign-off."
m9_invariants_hold   = "All load-bearing invariants survive: cortex replay (§13.4 byte-identical OverallRoot), Neo key-isolation (i1), no-false-success (i6), verbatim high-entropy tokens (i3). If your change could touch one, prove it in the ledger with the named verify command."
m10_one_item_one_unit= "One item = one reviewable, independently-revertible unit. Do not bundle items. Finish, verify, and log an item before starting the next."

[quality_bar]
errors        = "Every error handled or returned with %w + context; never ignored, never logged-and-continued where the value is needed."
concurrency   = "All shared state guarded (mutex/channel/atomic). `go test -race` on every touched package; a data race is a hard fail."
naming        = "Match the package's existing naming + style exactly. New exported symbols carry house-style doc comments (see neo/internal/agent/*.go)."
comments      = "Do NOT add/remove comments outside your change. New comments explain WHY, not WHAT, only where non-obvious. No comment churn."
allocation    = "No per-turn/per-call heap churn: reuse buffers, prealloc with known cap, avoid fmt.Sprintf in hot loops (use strings.Builder — the buildSystem pattern)."
determinism   = "Anything feeding cortex_snapshot_hash or the replay journal stays byte-deterministic (canonical CBOR, sorted iteration). Derived/sidecar state NEVER enters OverallRoot or the journal."
boundaries    = "Chain coupling only in tools/ (D4); Neo holds no signing key (i1); cortex holds no key material (D4)."
public_api     = "Do not change an exported signature consumed by another module without updating ALL call sites in the same item and logging it."
config         = "New tunables are config keys with env overrides + a sane default, mirroring the existing neo pattern (e.g. NEO_AMBIENT_RETRIEVAL_TOP_K). No hardcoded operator-facing magic numbers."
docs_sync      = "If an item changes behavior described in a *.frozen.kvx spec, update that spec's [changelog] in the SAME item."

# =========================================================================
# PROTOCOL — the exact, drift-free execution discipline.
# =========================================================================

[protocol.workflow]
step_1_claim   = "Pick ONE item whose depends_on are all DONE. Write its PRE ledger entry (status IN_PROGRESS)."
step_2_recon   = "Run [protocol.recon]: confirm every anchor. Line numbers are hints; the symbol is authoritative."
step_3_baseline= "Run the item verify cmd + global build to confirm a GREEN baseline before touching anything. Red baseline => STOP + report."
step_4_test_red= "Write the named tests FIRST. Run them; confirm they FAIL for the right reason (red)."
step_5_impl    = "Implement EXACTLY the change. Touch ONLY the files listed. No scope creep (m3)."
step_6_test_grn= "New tests green; full package test + `go test -race` + `go vet` green for every touched package."
step_7_verify  = "Run the item verify cmd + global suite. Confirm EACH acceptance criterion objectively (measure, do not assume)."
step_8_invariant="If m9 applies, run the named invariant command and record the result."
step_9_log     = "Write the POST ledger entry with verbatim commands + results."
step_10_done   = "Mark DONE only when every acceptance criterion + test + global suite are green. Return to step_1."
on_blocked     = "If blocked (ambiguity, red baseline, invariant at risk, anchor missing): STOP, write a BLOCKED entry stating exactly what+why, surface to the human. Never guess."

[protocol.recon]
how_1 = "grep/code-search for the SYMBOL named in the item, not the line number."
how_2 = "Confirm the problem still matches reality (e.g. poll still 1500ms, store still uncapped). If reality changed, STOP — the item may be done/moot; re-scope with the human."
how_3 = "If anchor_status=recon_required you MUST quote the exact current symbol+line in the PRE entry before editing. If anchor_status=verified, still confirm the symbol exists; re-quote if moved."

[protocol.testing]
unit      = "Table-driven Go tests matching existing style (neo/internal/agent/agent_test.go, cortex/**/*_test.go)."
behavior  = "Test observable behavior + boundaries (empty/nil/max/concurrent/error), not just happy path. Each named test states the case it must cover."
race      = "`go test -race ./<pkg>/...` for every touched package. Mandatory."
no_network= "Hermetic: no live network/chain/LLM. Use existing mocks (mcp.NewMockServer, fake embedder, fake Approver)."
regression= "Every BUG FIX adds a regression test reproducing the bug (red) then proving the fix (green)."
ts_tests  = "Frontend/Capacitor items use the repo's existing runner (vitest/playwright as present); add a component/e2e test for new UI behavior."

[protocol.logging]
where      = "Append-only ledger: knowledge/analysis/ENHANCEMENTS-LEDGER.md (create on first use). NEVER rewrite/delete prior entries."
pre_header = "### PRE <item_id> <utc>"
post_header= "### POST <item_id> <utc>"
pre_fields = "item_id, utc, agent_id, status=IN_PROGRESS, recon(exact current file:line+symbol confirmed), baseline_cmd+result(GREEN), planned_files, planned_tests."
post_fields= "item_id, utc, status=DONE|BLOCKED, files_touched(exact), tests_added(exact Test func names), cmds_run(verbatim)+results, acceptance_check(each criterion->PASS/FAIL with measured value), invariant_check(if m9), notes(any deviation+why)."
rule       = "No code edit before its PRE entry exists. No item DONE before its POST entry exists. The ledger is the single source of truth for progress + parallel-agent coordination."

[protocol.zero_drift]
d1 = "Build ONLY what the item says. If you think something else needs doing, log it as a PROPOSED follow-up item — do not build it."
d2 = "No reformatting/import-reorder/gofmt of unrelated regions. Edits are minimal + surgical (prefer the edit tool over full-file rewrites)."
d3 = "Do not change defaults, thresholds, or closed vocab (D7 verbs, ObjKind, 9 memory types) unless the item explicitly says so."
d4 = "Do not add dependencies. If a new dep seems required, STOP and ask."
d5 = "If two items appear to overlap, they were already deduplicated; treat the stated boundary as exact — do not merge or split."

[protocol.speed]
hot_paths   = "Per-turn system-block assembly (neo loop), per-tool-call dispatch (executor mcp), and cortex Find/Context are latency-critical."
rules       = "No new sync I/O on the hot path; push durable writes to existing async/background lanes. No new per-turn full-file rewrites. TTL-cache idempotent reads only where the item says so."
bench       = "Hot-path changes ship a Go benchmark + before/after ns/op + allocs/op in the POST entry. >5% regression without justification is a fail."
prompt_cache= "Preserve longest-stable-prefix cacheability: never insert turn-varying bytes ahead of the append-only transcript (see P1-2)."

[verification.commands]
build_all        = "for m in cortex MCL bridge executor neo chronos deus gateway router; do (cd /root/matrix/$m 2>/dev/null && go build ./...); done"
test_pkg         = "go test ./<touched-package>/..."
race             = "go test -race ./<touched-package>/..."
vet              = "go vet ./<touched-package>/..."
replay_invariant = "the cortex replay-invariant CI job (drop derived indexes -> replay journal -> roots match); run for any cortex-touching item (m9)"
note             = "Each Go module has its own go.mod; run inside the right module dir. Frontend items use the package.json scripts in client/ forge/ apps/mobile/."

[anchor_legend]
verified       = "File/symbol opened + confirmed during the analysis that produced this spec (line numbers accurate at 2026-06-23). STILL run [protocol.recon]."
recon_required = "Anchor cited from prior analysis/memory, NOT re-opened here. You MUST locate + quote the exact current symbol+line in the PRE entry before editing."

[phases]
order      = ["P1", "P2", "P3", "P4"]
p1         = "Quick wins: low effort, high impact, anchors verified. Ship first."
p2         = "Medium effort: security hardening, skill loop, ergonomics, concurrency."
p3         = "Larger/structural: gateway, self-correction, streaming, hooks, search, visualizer, new memory type."
p4         = "Future/deferred: marketplace, on-chain anchor, speculative preload, nodes, self-update, mobile (partly in flight)."
gate       = "A phase is COMPLETE only when every non-deferred item has a DONE POST entry (all acceptance PASS) and the global build+test+race+vet suite is green."
parallelism= "Items with disjoint files + satisfied depends_on MAY run in parallel agents. Items sharing a file are serialized. Claim in the ledger before editing."

# =========================================================================
# PHASE 1 — QUICK WINS
# =========================================================================

[item.P1-1]
title        = "SSE delegation: replace the core_execute->daemon poller with an event subscription"
phase        = "P1"
source       = "Doc #2"
effort       = "low"
impact       = "high (latency + cost on every escalated/gated turn)"
anchor_status= "verified"
problem      = "delegate client polls the MCL daemon on a default 1500ms ticker (poll defaults to 1500*time.Millisecond when o.PollInterval==0; ticker in the wait loop). Up to 1.5s latency per state transition + wasted cycles."
files        = ["neo/internal/delegate/client.go"]
symbols      = ["the PollInterval default branch (poll = 1500 * time.Millisecond)", "the wait-loop ticker time.NewTicker(c.pollEvery)", "the per-tick daemon state read"]
change       = "Subscribe to the daemon's existing GET /events SSE stream (already proxied with FlushInterval=-1 in neo/internal/server/server.go) for the delegated intent_id; drive gate/progress/terminal transitions from events. KEEP the poller as an explicit fallback on stream drop/error (bounded reconnect, then poll). Do not change the public Options/Approver surface."
tests        = ["TestDelegate_DrivenBySSEEvents", "TestDelegate_FallsBackToPollOnStreamError", "TestDelegate_NoDuplicateApproval"]
verify       = "go test -race ./neo/internal/delegate/..."
acceptance   = "Median gate-to-action latency <100ms via SSE (was up to 1500ms); zero duplicate approvals under event+poll overlap; fallback reaches terminal state when SSE unavailable."
done_when    = "all tests green; race clean; fallback covered; POST entry filed."
rollback     = "revert client.go; the poller alone is prior behavior."
depends_on   = []

[item.P1-2]
title        = "Prompt-cache stability: stable system prefix + trailing dynamic memory tail"
phase        = "P1"
source       = "Neo #7"
effort       = "low-medium"
impact       = "high (free-tier LLM unit economics on every multi-turn conversation)"
anchor_status= "verified"
problem      = "buildSystem (prompt.go) concatenates stable charter+groundTruth THEN turn-varying memory; the caller appends [context: N%] and prepends the whole system message BEFORE the append-only transcript a.working (agent.go). The mutating system prefix busts the provider longest-stable-prefix cache for the entire window every turn."
files        = ["neo/internal/agent/prompt.go", "neo/internal/agent/agent.go", "neo/neo.frozen.kvx"]
symbols      = ["func (a *Agent) buildSystem(...)", "func (a *Agent) systemPrompt()", "the window assembly: system := baseSystem + [context%]; window := append([]llm.Message{llm.SystemMessage(system)}, a.working...)"]
change       = "Split into (1) byte-stable SystemMessage = systemPrompt()+groundTruth ONLY (identical across a session) and (2) the turn-varying block (pinned/triggered/summary/recalled/retrieved/procedural) + [context: N%] moved into ONE trailing message AFTER a.working. Window order: [stable system] + [transcript] + [dynamic tail]. Preserve exact rendered content + ordering of the dynamic block (only POSITION moves). Update neo.frozen.kvx [control.loop] step_2 + [changelog]."
tests        = ["TestBuildSystem_PrefixByteStableAcrossTurns", "TestWindow_DynamicTailAfterTranscript", "TestBuildSystem_DynamicContentUnchanged (golden)"]
verify       = "go test -race ./neo/internal/agent/..."
acceptance   = "Stable prefix byte-identical turn-over-turn; dynamic content unchanged (golden match); message order verified; BenchmarkBuildWindow no alloc regression >5%."
done_when    = "tests green; bench logged; neo.frozen.kvx changelog updated same item; POST entry filed."
rollback     = "revert prompt.go + agent.go to single-system-message assembly."
depends_on   = []

[item.P1-3]
title        = "Compaction durability: synchronous pre-compaction consolidation of evicted turns"
phase        = "P1"
source       = "Doc #3 + Neo #8 (merged)"
effort       = "low"
impact       = "medium-high (prevents durable memory loss at the compaction boundary)"
anchor_status= "verified"
problem      = "Consolidator.Consolidate (agent.go) runs async/best-effort + drops on full queue. compact() summarizes the window; if the async sweep lags, the last turns are lost from cortex when the summary replaces them."
files        = ["neo/internal/agent/agent.go", "neo/internal/writeback/"]
symbols      = ["func (a *Agent) compact(ctx, reason string)", "Consolidator interface { Consolidate(transcript string) }", "func (a *Agent) consolidateWorking()"]
change       = "Before compact() replaces working history, run a SYNCHRONOUS consolidation pass over the about-to-be-evicted turns (direct call path, not the droppable async queue) so durable facts/events/patterns reach cortex first. Add a synchronous Consolidator method/option; keep async for steady-state. Do not block beyond the existing compaction stall."
tests        = ["TestCompact_FlushesEvictedTurnsSynchronously", "TestCompact_SyncFlushIndependentOfAsyncQueue", "TestCompact_VerbatimTokensSurviveToCortex"]
verify       = "go test -race ./neo/internal/agent/... ./neo/internal/writeback/..."
acceptance   = "Every turn removed by compaction is consolidated (sync) before removal; async path unchanged; i3 verbatim holds; no hot-path regression beyond existing compaction stall."
done_when    = "tests green; race clean; POST entry filed."
rollback     = "revert compact() + the writeback sync method."
depends_on   = []

[item.P1-4]
title        = "Heartbeat with HEARTBEAT_OK suppression (Chronos-driven proactive turn)"
phase        = "P1"
source       = "Neo #3"
effort       = "low"
impact       = "medium (autonomous monitoring without notification spam)"
anchor_status= "recon_required"
problem      = "No heartbeat in Neo/MCL. Chronos already gives durable recurring alarms with wake_message+payload+conversation_id, so infra exists; the convention + suppression do not."
files        = ["chronos/", "neo/internal/agent/agent.go", "neo/neo.frozen.kvx"]
symbols      = ["Chronos recurring-alarm fire path (cron mode, wake_message delivery)", "the Neo turn entry handling a wake_message", "the turn output/termination path deciding whether to surface a reply"]
change       = "Heartbeat convention: a Chronos recurring alarm whose wake_message tells Neo to review active goals/constraints and reply with the sentinel HEARTBEAT_OK when nothing needs attention. Neo recognizes HEARTBEAT_OK and SUPPRESSES the turn (no output/surface). Anything else delivered normally. Optional heartbeat checklist in pinned context. Config: interval (default 0=off) + env. Add neo.frozen.kvx [heartbeat] + changelog."
tests        = ["TestHeartbeat_OKSuppressesOutput", "TestHeartbeat_NonOKDelivers", "TestHeartbeat_DisabledByDefault"]
verify       = "go test -race ./neo/... ./chronos/..."
acceptance   = "HEARTBEAT_OK never delivered; non-OK content delivered; disabled by default; no wakeups when disabled."
done_when    = "tests green; neo.frozen.kvx [heartbeat]+changelog added; POST entry filed."
rollback     = "revert sentinel handling + remove [heartbeat] config/section."
depends_on   = []

[item.P1-5]
title        = "Conversation ring buffer: cap retained turns + kill the O(n) full-file rewrite"
phase        = "P1"
source       = "Doc #1 (rescoped: per-user daemon, not multi-tenant locks)"
effort       = "low-medium"
impact       = "medium (write cost + unbounded growth on long threads)"
anchor_status= "verified"
problem      = "conversation.Store.Append (store.go) is 'retained for the life of the thread — no cap' and rewrites the ENTIRE record via os.WriteFile(tmp)+rename every turn (O(n) bytes/append). Unbounded memory + quadratic write cost. The daemon is per-user so the single sync.Mutex is fine — do NOT shard it."
files        = ["neo/internal/conversation/store.go"]
symbols      = ["func (s *Store) Append(convID string, turn Turn)", "type Record struct", "loadLocked / pathLocked", "Recent / Get (readers that must keep working)"]
change       = "Add a retained-turn cap (config+env, sane default) AND switch per-turn persistence from full-record rewrite to append-only (e.g. JSONL append per turn; reserve the rename-based atomic write for compaction/rollup). Turns beyond the cap roll to durable storage (cortex Event/archive), NOT dropped — still retrievable by Recent/Get/recall. Keep the single mutex. Preserve crash-atomic semantics."
tests        = ["TestStore_AppendIsNotFullRewrite", "TestStore_RetainedCapEnforced", "TestStore_CrashSafetyAtomic", "TestStore_ConcurrentAppendReadSafe"]
verify       = "go test -race ./neo/internal/conversation/..."
acceptance   = "Per-append write cost O(1) in turn size; retained hot set bounded; no turn lost (full history retrievable); crash-atomic; race clean."
done_when    = "tests green; readers unaffected; POST entry filed."
rollback     = "revert store.go to full-rewrite Append."
depends_on   = []

# =========================================================================
# PHASE 2 — MEDIUM EFFORT
# =========================================================================

[item.P2-1]
title        = "Spend-policy hardening: circuit breaker + per-recipient cap + rolling time-window budget"
phase        = "P2"
source       = "Doc #7"
effort       = "medium"
impact       = "high (highest security value; protects user funds)"
anchor_status= "recon_required"
problem      = "PaxeerSpendPolicy (executor/cmd/mcl-execute/paxeer_spend_policy.go) enforces only a per-call cap (1 PAX) + aggregate cap (5 PAX). No circuit breaker, no per-recipient cap, no rolling time-window budget — a looping/compromised intent can repeatedly approach the caps."
files        = ["executor/cmd/mcl-execute/paxeer_spend_policy.go"]
symbols      = ["the PaxeerSpendPolicy type + its check/evaluate method", "the per-call (1 PAX) and aggregate (5 PAX) cap constants"]
change       = "Extend the policy: (a) circuit breaker — after N cap-violations within M minutes, trip + reject until a cooldown elapses; (b) per-recipient caps — track spend per destination address with its own ceiling; (c) rolling time-window budget — cap total spend per sliding window. All thresholds = config keys + env, conservative defaults. Policy state is runtime/sidecar (NEVER journaled, NEVER in OverallRoot). Fail CLOSED on any trip."
tests        = ["TestSpend_PerRecipientCapEnforced", "TestSpend_CircuitBreakerTripsAfterNViolations", "TestSpend_BreakerCooldownRecovers", "TestSpend_RollingWindowBudgetRejectsOverspend", "TestSpend_StateNotJournaled"]
verify       = "go test -race ./executor/cmd/mcl-execute/..."
acceptance   = "Breaker trips + rejects after the configured count; recovers after cooldown; per-recipient + window budgets enforced; defaults conservative; fails closed; state provably sidecar (not journaled)."
done_when    = "all tests green; sidecar_posture proven by test; POST entry filed."
rollback     = "revert paxeer_spend_policy.go to the two-cap policy."
depends_on   = []

[item.P2-2]
title        = "Skill-writing / synthesis loop: agent-authored skills from proven patterns"
phase        = "P2"
source       = "Doc #6 + Neo #2 (merged)"
effort       = "medium"
impact       = "high (self-improvement flywheel)"
anchor_status= "recon_required"
problem      = "Matrix has 88+ pre-authored SKILL.mtx + a consolidator that distills procedural Patterns, but no loop where the agent CONSCIOUSLY writes a reusable skill after a proven task, and no names-only skill index in Neo's prompt. The PatternSpec schema already exists (neo.frozen.kvx [procedural.pattern_schema])."
files        = ["neo/internal/writeback/", "neo/internal/tools/", "neo/internal/agent/prompt.go", "neo/neo.frozen.kvx"]
symbols      = ["the consolidator pattern-distillation path (procedural lifecycle DISTILL/REINFORCE)", "the cortex Pattern memory type + PatternData", "the Neo tool registry (to add write_skill)", "the buildSystem skill-index injection point"]
change       = "(1) Add a write_skill tool to persist a reusable recipe as a cortex Pattern (validated against PatternSpec). (2) Extend the consolidator: when a successful tool-sequence repeats past the existing confidence/N-success guard, auto-PROPOSE a candidate skill. (3) Inject a names-only skill INDEX into the STABLE system prefix (token-bounded), readable on demand via memory_recall. Respect [procedural.guards]. Update neo.frozen.kvx [procedural]+changelog. Do NOT bake skills into the image (that is P2-3)."
tests        = ["TestWriteSkill_PersistsValidPattern", "TestConsolidator_ProposesSkillAfterNSuccesses", "TestPrompt_SkillIndexInjectedNamesOnly", "TestSkillLoop_NoOverfitSingleSuccess"]
verify       = "go test -race ./neo/... && (cd /root/matrix/cortex && go test ./memory/...)"
acceptance   = "Agent can author a valid skill; consolidator proposes only past the success guard; skill index is names-only + lives in the cacheable prefix (consistent with P1-2); guards enforced."
done_when    = "tests green; neo.frozen.kvx updated; POST entry filed."
rollback     = "remove write_skill + consolidator proposal path + index injection."
depends_on   = ["P1-2"]

[item.P2-3]
title        = "Skill hot-reload (dev): fsnotify watch + re-parse; image stays read-only in prod"
phase        = "P2"
source       = "Doc #11"
effort        = "medium"
impact        = "medium (dev velocity on skill iteration)"
anchor_status = "verified"
problem      = "Skills are baked read-only into the image (deploy/daemon/Dockerfile COPY skills/ -> /opt/matrix/skills/, part of image identity). Iterating a skill needs a rebuild. No hot-reload even in dev."
files        = ["executor/", "neo/internal/tools/", "deploy/daemon/Dockerfile"]
symbols      = ["the skill loader/resolver that reads SKILL.mtx from the skills dir", "the daemon/agent startup that loads the skill corpus"]
change       = "Add OPT-IN dev hot-reload: when a dev flag/env is set, watch the skills dir with fsnotify + re-parse changed SKILL.mtx into the live registry. Production (image) path UNCHANGED — baked, read-only, no watcher. CI still validates skills at build. No new dependency beyond fsnotify (if not vendored, STOP + ask)."
tests        = ["TestSkillReload_DevReparsesOnChange", "TestSkillReload_OffByDefault", "TestSkillReload_InvalidSkillRejectedNotCrash"]
verify       = "go test -race ./executor/... ./neo/internal/tools/..."
acceptance   = "Dev edits reload without restart; prod path byte-identical to today; invalid edits never crash; off by default."
done_when    = "tests green; prod Dockerfile path unchanged; POST entry filed."
rollback     = "remove the watcher + dev flag."
depends_on   = []

[item.P2-4]
title        = "Local sandbox preset: one-command hermetic dev run (temp cortex, mock RPC, hash embedder)"
phase        = "P2"
source       = "Doc #12"
effort        = "medium"
impact        = "medium (contributor onboarding + hermetic local runs)"
anchor_status = "recon_required"
problem      = "No one-command hermetic preset for local runs, though the config layering supports overrides."
files        = ["neo/internal/config/", "executor/cmd/mcl-execute/", "cortex/"]
symbols      = ["the config loader + its layering/override mechanism", "the embedder selection (Hash stub vs Fireworks)", "the chain RPC client selection"]
change       = "Add a named preset (a `dev sandbox` flag or kvx profile) wiring temp/in-memory cortex, the existing Hash embedder stub, a mock/no-op chain RPC, and metering disabled — by composing EXISTING override points only. No new runtime paths beyond preset wiring. Document the launch command."
tests        = ["TestSandboxPreset_UsesStubEmbedder", "TestSandboxPreset_UsesTempCortex", "TestSandboxPreset_NoLiveChainCalls", "TestSandboxPreset_DefaultProfileUnaffected"]
verify       = "go test -race ./neo/internal/config/... ./executor/cmd/mcl-execute/..."
acceptance   = "One command brings up a hermetic local agent with zero external deps; the default profile is unchanged; tests prove stub selection."
done_when    = "tests green; launch command documented in POST entry; POST entry filed."
rollback     = "remove the preset wiring."
depends_on   = []

[item.P2-5]
title        = "MCP result cache (TTL) + parallel dispatch of independent tool calls"
phase        = "P2"
source       = "Doc #9 (rescoped: pooling ALREADY EXISTS in mcp.Manager Q16)"
effort        = "medium"
impact        = "medium (latency + cost on tool-heavy turns)"
anchor_status = "verified"
problem      = "mcp.Manager (executor/mcp/manager.go) is ALREADY a persistent per-agent server pool (Q16) — pooling is DONE; do NOT rebuild it. Gaps: (a) no result cache for idempotent read tools (e.g. web_search), (b) independent tool calls in a turn dispatch serially."
files        = ["executor/mcp/", "neo/internal/agent/agent.go"]
symbols      = ["mcp.Manager (existing pool — leave its lifecycle alone)", "the ToolsCall/dispatch path", "the Neo agent loop tool-call execution site"]
change       = "(a) OPT-IN TTL result cache keyed by (tool, canonical-args) for tools explicitly marked idempotent/read-only (start with web_search); short default TTL (e.g. 5m), config+env. NEVER cache side-effecting or money tools. (b) Dispatch INDEPENDENT tool calls in a turn concurrently (bounded), preserving result ordering + per-tool observer events. Determinism + i6 preserved."
tests        = ["TestMCPCache_HitWithinTTL", "TestMCPCache_MissAfterExpiry", "TestMCPCache_NeverCachesSideEffecting", "TestDispatch_IndependentCallsRunConcurrently", "TestDispatch_OrderingAndObserverPreserved", "TestDispatch_ConcurrentRaceClean"]
verify       = "go test -race ./executor/mcp/... ./neo/internal/agent/..."
acceptance   = "Idempotent reads hit cache within TTL; side-effecting never cached; independent calls parallelize with preserved ordering+events; -race clean; pool lifecycle untouched."
done_when    = "tests green; bench on the dispatch path logged; POST entry filed."
rollback     = "disable cache (default off) + revert to serial dispatch."
depends_on   = []

[item.P2-6]
title        = "Lane-based concurrency: per-session command queue with collect + followup modes"
phase        = "P2"
source       = "Neo #4"
effort        = "medium"
impact        = "medium (multi-message UX while the agent works)"
anchor_status = "recon_required"
problem      = "Neo serves one run at a time per session with no queueing/steering when a user sends multiple messages mid-run. No equivalent of OpenClaw's lane queue."
files        = ["neo/internal/server/", "neo/internal/agent/agent.go"]
symbols      = ["the server session layer dispatching a run (session.go start/drive)", "the per-run broker/run registry"]
change       = "Add a per-session command queue with strict serial execution per session + TWO modes to start: collect (coalesce queued inbound into one followup turn) and followup (wait for the active run, then new turn). Do NOT implement steer/nextTurn yet (out of scope; log as follow-up). Use a generation/sequence counter to discard stale superseded results. Do not touch the sub-agent swarm."
tests        = ["TestQueue_SerialPerSession", "TestQueue_CollectCoalesces", "TestQueue_FollowupAfterActiveRun", "TestQueue_StaleResultDiscarded", "TestQueue_RaceClean"]
verify       = "go test -race ./neo/internal/server/... ./neo/internal/agent/..."
acceptance   = "No two runs overlap per session; collect coalesces mid-run messages; followup starts after the active run; superseded late results dropped; race clean."
done_when    = "tests green; steer/nextTurn logged as follow-up; POST entry filed."
rollback     = "remove the queue; restore direct dispatch."
depends_on   = []

[item.P2-7]
title        = "Adaptive step budget for Neo (dynamic from turn complexity)"
phase        = "P2"
source       = "Doc #14 (rescoped: Neo StepBudget only; MCL walker has no step budget)"
effort        = "low-medium"
impact        = "low-medium (avoids premature cutoff on hard turns / waste on easy ones)"
anchor_status = "recon_required"
problem      = "Neo's per-turn StepBudget is a fixed config constant (neo config; default 50, see neo.frozen.kvx [loop_discipline.termination] step_budget=50). It does not adapt to turn complexity. (Note: the MCL PlanTree walker has no step budget — do NOT conflate the two.)"
files        = ["neo/internal/config/config.go", "neo/internal/agent/agent.go", "neo/neo.frozen.kvx"]
symbols      = ["the StepBudget config field (default 50)", "the agent loop bound `for step := 0; step < a.cfg.StepBudget; step++`"]
change       = "Make the effective step budget adaptive within a configured [min,max] band derived from observable signals (e.g. tool-call breadth so far, no-progress stalls), keeping the fixed value as the default ceiling. Conservative: never below the current floor for simple turns; never above max. Keep no_progress_stall + on_budget_exhausted behavior (no false success) intact. Config keys for min/max/+env. Update neo.frozen.kvx changelog."
tests        = ["TestStepBudget_ScalesUpForComplexTurn", "TestStepBudget_StaysLowForSimpleTurn", "TestStepBudget_NeverExceedsMax", "TestStepBudget_NoProgressStillTerminates"]
verify       = "go test -race ./neo/internal/agent/... ./neo/internal/config/..."
acceptance   = "Budget adapts within [min,max]; never exceeds max; no-progress termination + honest-partial behavior unchanged; default behavior matches today when adaptation disabled."
done_when    = "tests green; neo.frozen.kvx changelog updated; POST entry filed."
rollback     = "revert to the fixed StepBudget."
depends_on   = []

[item.P2-8]
title        = "Embedding provider fallback chain (reliability)"
phase        = "P2"
source       = "Neo #10"
effort        = "medium"
impact        = "medium (resilience: embedding outages degrade retrieval, not crash it)"
anchor_status = "recon_required"
problem      = "Cortex/Neo embedding goes through a single provider (Fireworks-style client). A provider outage degrades or breaks retrieval with no fallback. A Hash stub embedder already exists for tests."
files        = ["cortex/", "neo/internal/memory/"]
symbols      = ["the Embedder interface", "the live Fireworks embedder client", "the Hash stub embedder"]
change       = "Add an EmbedderChain wrapper implementing Embedder that tries an ordered list of providers and falls through on error/timeout, with the local Hash stub as the terminal fallback (degraded but non-fatal). MUST NOT change embedding DETERMINISM guarantees that feed any hashed/journaled state — embeddings are sidecar/derived (vec/, not in OverallRoot), so a fallback changing vectors must not alter replay roots (prove it). Config: ordered provider list + per-provider timeout + env."
tests        = ["TestEmbedderChain_FallsThroughOnError", "TestEmbedderChain_TerminalHashFallback", "TestEmbedderChain_PrimarySuccessNoFallback", "TestEmbedderChain_DoesNotAffectReplayRoot"]
verify       = "go test -race ./cortex/... ./neo/internal/memory/..."
acceptance   = "Primary used when healthy; falls through on error/timeout; Hash stub terminal; retrieval degrades gracefully (never crashes); replay OverallRoot unaffected by which embedder ran (m9)."
done_when    = "tests green; replay-invariant green; POST entry filed."
rollback     = "wire the single provider directly again."
depends_on   = []

