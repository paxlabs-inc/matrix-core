[item.P3-1]
title        = "Multi-channel messaging gateway (PlatformAdapter registry)"
phase        = "P3"
source       = "Neo #1"
effort        = "large"
impact        = "high (adoption — Neo ranks this #1)"
anchor_status = "recon_required"
problem      = "Neo speaks the POST /chat + GET /events contract and a Telegram client exists, but there is no general PlatformAdapter abstraction to add Discord/Slack/WhatsApp without bespoke wiring."
files        = ["neo/internal/server/", "neo/internal/channels/"]
symbols      = ["the existing Telegram client/bridge", "the server /chat + /events contract (engine.go header: existing web and Telegram clients work unchanged)"]
change       = "Define a PlatformAdapter interface (inbound normalize -> Neo turn; outbound render <- Neo events/surfaces) + a registry. Refactor the EXISTING Telegram path into the first adapter (no behavior change), then add ONE new adapter (Discord) as the reference second impl. A failing adapter never affects others or the core loop. Per-adapter auth/config. Do not change the core agent loop."
tests        = ["TestAdapter_TelegramParityAfterRefactor", "TestAdapter_DiscordInboundNormalize", "TestAdapter_OutboundRender", "TestAdapter_FailureIsolatedFromCore", "TestRegistry_RegisterResolve"]
verify       = "go test -race ./neo/internal/server/... ./neo/internal/channels/..."
acceptance   = "Telegram behavior byte-identical after refactor (golden); Discord adapter sends/receives; an adapter panic/err never takes down the core or other adapters; adapters are config-gated."
done_when    = "tests green; Telegram golden parity proven; POST entry filed."
rollback     = "revert to the inline Telegram path."
depends_on   = []

[item.P3-2]
title        = "Neo-initiated self-correction (propose intent.correct)"
phase        = "P3"
source       = "Doc #15 (rescoped: walk-level auto-continue ALREADY EXISTS)"
effort        = "medium-large"
impact        = "medium (closes the loop on detected mistakes)"
anchor_status = "verified"
problem      = "The MCL walker already auto-continues on non-material steps and the materiality classifier already gates re-accept (executor/runtime/walker.go; executor/materiality/classify.go). The gap is that Neo cannot itself PROPOSE a correction (intent.correct) when it detects its own prior step was wrong — correction is currently externally/structurally driven, not agent-initiated."
files        = ["neo/internal/agent/agent.go", "executor/cmd/mcl-execute/"]
symbols      = ["the MCL message kind intent.correct (D8 typed patch -> RFC6902)", "the walker continue/re-accept seam", "the materiality classifier (8 rules)"]
change       = "Let Neo emit a typed correction proposal when its self-critique (the existing finish-time critique) detects a wrong prior step, routed through core_execute so materiality classification + the approval gate decide re-accept vs continue (material -> re-accept, non-material -> continue). Neo never bypasses the classifier. No false success (i6): a correction is proposed, not silently asserted as fixed."
tests        = ["TestSelfCorrect_ProposesIntentCorrectOnDetectedError", "TestSelfCorrect_MaterialTriggersReAccept", "TestSelfCorrect_NonMaterialContinues", "TestSelfCorrect_NoFalseSuccess"]
verify       = "go test -race ./neo/internal/agent/... ./executor/..."
acceptance   = "Neo proposes a correction on a detected self-error; materiality routing unchanged (material->re-accept, non-material->continue); classifier never bypassed; i6 holds."
done_when    = "tests green; materiality routing proven; POST entry filed."
rollback     = "remove the agent-initiated correction path (structural continue remains)."
depends_on   = []

[item.P3-3]
title        = "Streaming compilation: incremental plan-node events from synthesize"
phase        = "P3"
source       = "Doc #10"
effort        = "medium"
impact        = "medium (perceived latency; live plan view)"
anchor_status = "verified"
problem      = "The MCL compile->synthesize pipeline is synchronous; the narrator/Construct subscribe to events but plan synthesis emits no incremental node events, so the user waits for the whole plan before seeing structure (daemon_pipeline.go synthesize path)."
files        = ["executor/cmd/mcl-execute/daemon_pipeline.go", "MCL/ir/"]
symbols      = ["the synthesize step that builds the PlanTree", "the existing SSE event broker the narrator subscribes to"]
change       = "Emit incremental plan-node events as the PlanTree is synthesized (node added / resolved), reusing the EXISTING event broker + envelope (do not invent a new transport). Determinism of the final IR + cortex_snapshot_hash (D11) is unchanged — streaming is observability only, never alters the compiled artifact. Events are best-effort side-channel (i_cass style: publish only, sign nothing)."
tests        = ["TestStreamCompile_EmitsNodeEventsInOrder", "TestStreamCompile_FinalIRByteIdentical", "TestStreamCompile_EventsAreSideChannelOnly"]
verify       = "go test -race ./executor/cmd/mcl-execute/... ./MCL/..."
acceptance   = "Plan-node events stream during synthesis; the final Intent IR + snapshot hash are byte-identical to non-streaming (D11); events never alter the artifact."
done_when    = "tests green; D11 determinism proven; POST entry filed."
rollback     = "stop emitting node events (final IR path unchanged)."
depends_on   = []

[item.P3-4]
title        = "Plugin lifecycle hooks (Hook interface)"
phase        = "P3"
source       = "Neo #6"
effort        = "medium"
impact        = "medium (ecosystem extensibility)"
anchor_status = "recon_required"
problem      = "Neo has a per-tool ToolObserver but no general lifecycle hook surface (BeforeTurn / AfterToolCall / BeforeCompaction / AfterTurn) for plugins to observe/augment without forking the loop."
files        = ["neo/internal/agent/agent.go", "neo/internal/hooks/"]
symbols      = ["the ToolObserver interface (existing per-tool surface)", "the agent loop turn boundaries + compaction call site"]
change       = "Define a Hook interface with BeforeTurn/AfterToolCall/BeforeCompaction/AfterTurn; register a slice of hooks; invoke at the exact loop seams. Hooks are OBSERVE/augment-only — they cannot move money, cannot bypass i1/i6, and a hook error is isolated (logged, never fails the turn). Keep ToolObserver working (the new AfterToolCall must not duplicate its events)."
tests        = ["TestHooks_FireAtCorrectSeams", "TestHooks_ErrorIsolated", "TestHooks_CannotEscalateMoney", "TestHooks_ToolObserverStillWorks"]
verify       = "go test -race ./neo/internal/agent/... ./neo/internal/hooks/..."
acceptance   = "Hooks fire at the right seams in order; a hook error never fails the turn; hooks cannot cross the money/signature boundary; ToolObserver behavior intact."
done_when    = "tests green; isolation + boundary proven; POST entry filed."
rollback     = "remove the hooks package + invocation seams."
depends_on   = []

[item.P3-5]
title        = "Episodic search speed: keyword index (FTS5/BLEVE) alongside HNSW"
phase        = "P3"
source       = "Neo #9"
effort        = "medium"
impact        = "medium (fast exact-term recall complementing semantic search)"
anchor_status = "recon_required"
problem      = "Cross-conversation recall relies on vector (HNSW) similarity; there is no fast keyword/exact-term index, so exact-term lookups (an address, an error string, a flag name) are weaker than a keyword index would give."
files        = ["cortex/", "neo/internal/recall/"]
symbols      = ["the cortex Find path (typed -> graph -> vector)", "the recall lane (recallTurns / Relevant)"]
change       = "Add a keyword index (BLEVE or SQLite FTS5 — pick the one already vendored; if neither, STOP + ask) as a DERIVED sidecar over memory/turn text, queried in parallel with vector recall and merged by salience. Index is sidecar/derived: NEVER in OverallRoot, dropped + rebuilt on replay like other indexes (§13.4). Keyword + vector results deduped + salience-ranked."
tests        = ["TestKeywordIndex_ExactTermHit", "TestKeywordIndex_MergedWithVector", "TestKeywordIndex_IsDerivedDroppedOnReplay", "TestKeywordIndex_RebuildMatches"]
verify       = "go test -race ./cortex/... ./neo/internal/recall/..."
acceptance   = "Exact-term queries return precise hits; merged ranking sane; index is provably derived (drop+rebuild, replay roots unchanged, m9); no dep added without sign-off."
done_when    = "tests green; replay-invariant green; POST entry filed."
rollback     = "remove the keyword index; vector recall remains."
depends_on   = []

[item.P3-6]
title        = "Plan visualizer: mclc visualize -> Mermaid from the PlanTree DAG"
phase        = "P3"
source       = "Doc #13"
effort        = "low-medium"
impact        = "low-medium (debuggability of compiled plans)"
anchor_status = "verified"
