# =========================================================================
# CLOSING
# =========================================================================

[done_definition]
item_done   = "Every acceptance criterion measured PASS + every named test green + global build/test/race/vet green + (if m9) the named invariant green + a POST ledger entry filed."
phase_done  = "Every non-deferred item in the phase is item_done and the phase gate (global suite green) passes."
roadmap_done= "P1+P2+P3 all phase_done; P4 items either done or explicitly deferred-with-decision in the ledger."

[final_invariants]
f1 = "No item shipped without a failing-then-passing test (m1)."
f2 = "No item shipped without a PRE + POST ledger pair (m2)."
f3 = "No commit/push without explicit Andrew request (m7)."
f4 = "cortex replay invariant byte-identical after every cortex-touching item (m9, §13.4)."
f5 = "Neo holds no key; money crosses only via core_execute (i1) — untouched by every item here."
f6 = "No false success: honest partials only (i6)."
f7 = "Zero interpretation drift: built exactly to spec; out-of-scope ideas logged, not built (m3, [protocol.zero_drift])."
# END MATRIX-ENHANCEMENTS.kvx v1.0.0
