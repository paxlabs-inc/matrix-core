files        = ["MCL/ir/plan.go", "MCL/cmd/mclc/"]
symbols      = ["the PlanTree type + its node/edge accessors (plan.go)", "the mclc CLI command registry"]
change       = "Add an `mclc visualize` subcommand that walks the PlanTree and emits Mermaid (and/or DOT) text to stdout. Pure read-only projection — it compiles/loads an IR and renders; it NEVER mutates IR, cortex, or emits side effects. Deterministic output (sorted node iteration) for stable diffs."
tests        = ["TestVisualize_RendersAllNodesAndEdges", "TestVisualize_DeterministicOutput", "TestVisualize_ReadOnlyNoSideEffects"]
verify       = "go test -race ./MCL/..."
acceptance   = "Command renders the full DAG to valid Mermaid; output deterministic; zero side effects; empty/single-node plans handled."
