[item.P4-3]
title        = "Speculative memory preloading (predictive prefetch via salience EMA)"
phase        = "P4"
source       = "Doc #5"
effort        = "medium-large"
impact        = "low-medium (latency on retrieval-heavy turns)"
anchor_status = "recon_required"
problem      = "The pager page-faults memory on demand. There is no predictive prefetch using the salience EMA / access patterns to warm likely-next memories, so each fault pays full latency."
files        = ["neo/internal/memory/", "cortex/salience/"]
symbols      = ["the Pager (Pinned/Procedural/TriggeredGuidance fault paths)", "the salience EMA model"]
change       = "Add an OPT-IN predictive prefetch: warm a small bounded set of likely-next memories based on salience + recent access co-occurrence, into an in-memory cache. Pure performance optimization — it changes NOTHING about what the model is allowed to see (the pinned/fault contracts are unchanged) and touches no durable/journaled state. Default off; bounded cache; measured."
tests        = ["TestPrefetch_WarmsLikelyNext", "TestPrefetch_BoundedCache", "TestPrefetch_DoesNotChangeVisibleContext", "TestPrefetch_OffByDefault"]
verify       = "go test -race ./neo/internal/memory/... ./cortex/salience/..."
acceptance   = "Prefetch reduces fault latency on retrieval-heavy turns (bench); visible context identical to non-prefetch; bounded; off by default; no durable-state change."
done_when    = "tests green; latency bench logged; POST entry filed."
rollback     = "disable prefetch (on-demand fault remains)."
depends_on   = []

