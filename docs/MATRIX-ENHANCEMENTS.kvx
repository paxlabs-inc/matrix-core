[item.P3-7]
title        = "Multi-modal Artifact memory (10th cortex type)"
phase        = "P3"
source       = "Doc #4"
effort        = "large"
impact        = "medium (durable memory of generated media/files)"
anchor_status = "recon_required"
problem      = "Cortex has a CLOSED 9-type taxonomy (Identity..Pattern; 1-byte enum). Generated images/video/files have no first-class durable memory type — adding one is a schema migration, not a code change (D7-style closed vocab)."
files        = ["cortex/memory/types.go", "cortex/snapshot/", "cortex/replay/"]
symbols      = ["the memory Type enum (0x01..0x09) + per-type *Data structs", "the canonical CBOR encode/decode", "the replay rebuild phases"]
change       = "Add a 10th type Artifact (0x0A) with an ArtifactData struct (kind/mime, content-ref/URI, hash, provenance) encoded as canonical CBOR. This is a SCHEMA MIGRATION: bump SchemaVersion, ensure encode/decode determinism, and prove the replay invariant still holds (drop derived -> replay -> byte-identical OverallRoot). Do NOT store blobs in cortex — store a content-addressed reference; the blob lives in object storage. Coordinate with Andrew before merging (schema change)."
tests        = ["TestArtifact_EncodeDecodeCanonical", "TestArtifact_WriteReadRoundtrip", "TestArtifact_ReplayByteIdenticalRoot", "TestArtifact_SchemaVersionBumped", "TestArtifact_NoBlobInCortex"]
verify       = "go test -race ./cortex/... && run the replay-invariant CI job"
acceptance   = "Artifact type stores + retrieves via content-ref; CBOR canonical + deterministic; replay invariant holds byte-identical (m9); no blob bytes in cortex; schema version bumped."
done_when    = "tests green; replay-invariant green; Andrew sign-off recorded in ledger; POST entry filed."
rollback     = "revert the type addition + schema bump (no on-disk Artifact records may exist yet)."
depends_on   = []

