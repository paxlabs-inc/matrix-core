  digest=b3:c628f3ae17313573f164eeacf4893ea2f744c8f0ebb8fdd122fb5b82f2c2640b file=chronos/internal/automatrix/automatrix.go range=58:90 lang=go exported=true byte_range=2767:3884
  sig=func BuildAlarm(spec Spec, now time.Time) (types.Alarm, error)
  doc=BuildAlarm assembles a Chronos AUTOMATRIX alarm (a cron recurring alarm with\nthe canonical AUTOMATRIX wake_message). The alarm is active and ready to be\nstored via store.CreateAlarm. The caller must set OwnerDID + UserID before\npersisting (the server does this from the authenticated principal).
EDGES
  ^defines=github.com/paxlabs-inc/chronos/internal/automatrix/automatrix.go

NODE id=github.com/paxlabs-inc/chronos/internal/automatrix.DefaultCronExpr kind=const
  digest=b3:ebac09ce1a64e2184cdba95cbbf1babf29145e17065184a1613f724bc1d2a168 file=chronos/internal/automatrix/automatrix.go range=34:38 lang=go exported=true byte_range=1739:2031
  sig=untyped string
  doc=DefaultCronExpr is the default recurring interval for an AUTOMATRIX alarm\nwhen none is specified. @every 45m is the base idle-wake cadence; Neo\nreschedules each subsequent fire with randomized jitter so wakes feel random\nrather than clockwork.
EDGES
  ^defines=github.com/paxlabs-inc/chronos/internal/automatrix/automatrix.go

