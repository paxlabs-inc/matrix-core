NODE id=github.com/paxlabs-inc/chronos/internal/automatrix.WakeMessage kind=const
  digest=b3:43da8fa551f8180913738471761e06f9984e0d12b3b952e149192ce3a70ae34c file=chronos/internal/automatrix/automatrix.go range=24:32 lang=go exported=true byte_range=957:1737
  sig=untyped string
  doc=WakeMessage is the canonical wake_message a Chronos AUTOMATRIX alarm\ndelivers. It instructs the agent to review its pending non-financial\nopportunities, complete one if worthwhile, and notify the user — or reply\nwith the AUTOMATRIX_IDLE sentinel when nothing is worth doing right now.\n\nThis MUST stay in sync with the agent-side AutomatrixWakeMessage\n(neo/internal/agent/automatrix.go) — they share the AUTOMATRIX marker that\nthe agent uses to detect an AUTOMATRIX wake.
EDGES
  ^defines=github.com/paxlabs-inc/chronos/internal/automatrix/automatrix.go

