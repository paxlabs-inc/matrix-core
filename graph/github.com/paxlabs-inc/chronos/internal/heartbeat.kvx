  digest=b3:3a81ad69036a20afab0d80ecfe05583dad46871ba637336e008de4712d18af00 file=chronos/internal/heartbeat/heartbeat.go range=54:86 lang=go exported=true byte_range=2319:3432
  sig=func BuildAlarm(spec Spec, now time.Time) (types.Alarm, error)
  doc=BuildAlarm assembles a Chronos heartbeat alarm (a cron recurring alarm with\nthe canonical heartbeat wake_message). The alarm is active and ready to be\nstored via store.CreateAlarm. The caller must set OwnerDID + UserID before\npersisting (the server does this from the authenticated principal).
EDGES
