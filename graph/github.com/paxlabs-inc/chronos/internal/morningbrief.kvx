  digest=b3:efcf4e655ff688d20c98d819b1c20a5039d807af6b76e5e3cee3ef65ccf83b46 file=chronos/internal/morningbrief/morningbrief.go range=107:139 lang=go exported=true byte_range=3987:5129
  sig=func BuildAlarm(spec Spec, now time.Time) (types.Alarm, error)
  doc=BuildAlarm assembles a Chronos MORNING_BRIEF alarm (a cron recurring alarm at\nthe user's local delivery time on the selected days, carrying the canonical\nMORNING_BRIEF wake_message). The caller sets OwnerDID + UserID before\npersisting (the server does this from the authenticated principal).
EDGES
  ^defines=github.com/paxlabs-inc/chronos/internal/morningbrief/morningbrief.go

NODE id=github.com/paxlabs-inc/chronos/internal/morningbrief.CronExpr kind=func
  digest=b3:88ed8e0c866d8d0c58eb51d5a7143ee21060342fd133470d848beb4572ea8e80 file=chronos/internal/morningbrief/morningbrief.go range=59:75 lang=go exported=true byte_range=2554:3349
  sig=func CronExpr(deliveryTime string, days []time.Weekday) (string, error)
  doc=CronExpr renders the standard 5-field cron expression ("M H * * DOW") for a\nlocal delivery time and weekday set. An empty/whole day set yields "*" for\nthe day-of-week field (every day). Weekdays follow cron's Sunday=0..Saturday=6.
EDGES
  ^defines=github.com/paxlabs-inc/chronos/internal/morningbrief/morningbrief.go

