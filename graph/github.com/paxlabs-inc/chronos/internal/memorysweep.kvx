NODE id=github.com/paxlabs-inc/chronos/internal/memorysweep.DefaultCronExpr kind=const
  digest=b3:0c5ead9324d2e49b691dfcced63a8d071334324b67dfecc20158ebb49ced2dae file=chronos/internal/memorysweep/memorysweep.go range=43:48 lang=go exported=true byte_range=2279:2675
  sig=untyped string
  doc=DefaultCronExpr is the default recurring interval for a continuous-memory\nsweep alarm when none is specified. @every 1h matches the finest ladder\nresolution (TierHour, matrix/cortex/rollup.go) so closed hour windows are\npicked up promptly; Cascade's own idempotence makes a tighter or looser\ncadence safe too (bounded work per sweep either way).
EDGES
  ^defines=github.com/paxlabs-inc/chronos/internal/memorysweep/memorysweep.go

