  digest=b3:05ef519f14d7ee931ed327638ce0b4f4d9e6dee0fa5fd3a7d8248cdbc85ba55a file=chronos/internal/memorysweep/memorysweep.go range=69:102 lang=go exported=true byte_range=3477:4607
  sig=func BuildAlarm(spec Spec, now time.Time) (types.Alarm, error)
  doc=BuildAlarm assembles a Chronos continuous-memory-sweep alarm (a cron\nrecurring alarm with the canonical sweep wake_message). The alarm is\nactive and ready to be stored via store.CreateAlarm. The caller must set\nOwnerDID + UserID before persisting (the server does this from the\nauthenticated principal).
EDGES
