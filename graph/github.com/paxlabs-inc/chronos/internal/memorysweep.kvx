NODE id=github.com/paxlabs-inc/chronos/internal/memorysweep.WakeMessage kind=const
  digest=b3:5c46789186582696eebd98de8fbf6b2be727059e4c316de80db8f49cdc3ace0e file=chronos/internal/memorysweep/memorysweep.go range=36:41 lang=go exported=true byte_range=1735:2277
  sig=untyped string
  doc=WakeMessage is the canonical wake_message a Chronos continuous-memory-sweep\nalarm delivers. It carries the CONTINUOUS_MEMORY_SWEEP marker so the\nreceiver can distinguish it from a conversational wake (heartbeat /\nAUTOMATRIX) and from a normal user message, and route it directly to\ncortex.Cortex.SweepNow without invoking the model.
