NODE id=github.com/paxlabs-inc/chronos/internal/config.kvxDoc kind=type
  digest=b3:da83d63052083333971a5606397b9ee95c1d2c1bc93b4be181dfca29a8072890 file=chronos/internal/config/kvx.go range=12:29 lang=go exported=false byte_range=82:754
  sig=type kvxDoc struct {\n	sections	map[string]map[string]string\n	order		[]string\n}
  doc=kvxDoc is a parsed chronos.config.kvx file: a sectioned key/value document.\n\nFormat (zero-dep, deterministic), shared with tachyon/uwac's config loaders:\n\n	# comment\n	[section]\n	key = "string"            # double-quoted strings (per Matrix .mtx convention)\n	num = 9096                # bare ints / bools\n	list = ["a", "b"]         # bracketed, comma-separated, quoted items\n	[section.sub]\n	ref = "${ENV_VAR}"        # ${ENV} interpolated from the process environment\n\nValues are stored as raw tokens; typed accessors parse on demand. Later\nduplicate keys win.
EDGES
  contains=github.com/paxlabs-inc/chronos/internal/config.kvxDoc#order,github.com/paxlabs-inc/chronos/internal/config.kvxDoc#sections,github.com/paxlabs-inc/chronos/internal/config.kvxDoc.str,github.com/paxlabs-inc/chronos/internal/config.kvxDoc.uint64Or
  ^defines=github.com/paxlabs-inc/chronos/internal/config/kvx.go

