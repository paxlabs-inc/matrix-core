NODE id=github.com/paxlabs-inc/layerx/internal/store.Store.SealBatch kind=method
  digest=b3:8dd2a4b5826538a394454b020c63726098581a26ea1c7c86c157da6c70a407f0 file=layerx/internal/store/batches.go range=9:36 lang=go exported=true byte_range=53:1231
  sig=func (s *Store) SealBatch(ctx context.Context, rootHex string, seqs []int64, windowStart, windowEnd time.Time) (string, error)
  doc=SealBatch creates a sealed batch over the given transfer seqs (committing the\nMerkle root) and assigns those transfers to it, in one DB transaction. The\nsettlement worker then submits + anchors the batch on Paxeer.
EDGES
  ^contains=github.com/paxlabs-inc/layerx/internal/store.Store
  ^defines=github.com/paxlabs-inc/layerx/internal/store/batches.go

NODE id=github.com/paxlabs-inc/layerx/internal/store.Store.SealWithdrawals kind=method
  digest=b3:de772bd201ce274256fdb16ac9e70163287003b257b64638de3c644a240bdb60 file=layerx/internal/store/withdrawals.go range=84:118 lang=go exported=true byte_range=2919:4275
  sig=func (s *Store) SealWithdrawals(ctx context.Context, payoutRoot string, items []SealedWithdrawal) error
  doc=SealWithdrawals transitions the given withdrawals queued -> submitted and\nstamps the deterministic payout_root over them, in one transaction. Once\nsealed the set is frozen: recovery re-derives the SAME root from these rows,\nso a retried on-chain submit maps to the same idempotent batch id and never\ndouble-pays. Only rows still 'queued' are moved (a concurrent settle cannot\ndouble-seal).
EDGES
  ^contains=github.com/paxlabs-inc/layerx/internal/store.Store
  ^defines=github.com/paxlabs-inc/layerx/internal/store/withdrawals.go

