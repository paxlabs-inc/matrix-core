  sig=func (p *PaxeerSettler) OperatorAddress() common.Address
  doc=OperatorAddress returns the EVM address that signs settlement txs (safe to log).
EDGES
  ^contains=github.com/paxlabs-inc/layerx/internal/chain.PaxeerSettler
  ^defines=github.com/paxlabs-inc/layerx/internal/chain/settler.go

