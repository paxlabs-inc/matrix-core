NODE id=github.com/paxlabs-inc/layerx/internal/chain.PaxeerSettler kind=type
  digest=b3:9ddb0426b1d67ca777d794b5ea54619964d5a490b06d6522715cf4acf2e8e686 file=layerx/internal/chain/settler.go range=24:40 lang=go exported=true byte_range=684:1441
  sig=type PaxeerSettler struct {\n	client		*Client\n	operator	*Operator\n	bind		*bindings\n	vault		common.Address\n	anchor		common.Address\n	chainID		*big.Int\n}
  doc=PaxeerSettler is the real, on-chain implementation of Settler. It holds the\nPaxeer client, the operator key, and the parsed contract bindings needed to\nsubmit an operator-signed LayerXVault.settle batch (which records the root on\nthe SettlementAnchor) on chain 125.\n\nIt builds the operator-signed settle calldata, sends the EIP-1559 tx, waits\nfor CometBFT finality (Paxeer has no reorgs), and returns the real tx hash.\nIt is idempotent on the batch root: a retried submit of an already-settled\nbatch does not double-anchor — it recovers and returns the original anchor tx.
EDGES
  contains=github.com/paxlabs-inc/layerx/internal/chain.PaxeerSettler#anchor,github.com/paxlabs-inc/layerx/internal/chain.PaxeerSettler#bind,github.com/paxlabs-inc/layerx/internal/chain.PaxeerSettler#chainID,github.com/paxlabs-inc/layerx/internal/chain.PaxeerSettler#client,github.com/paxlabs-inc/layerx/internal/chain.PaxeerSettler#operator,github.com/paxlabs-inc/layerx/internal/chain.PaxeerSettler#vault,github.com/paxlabs-inc/layerx/internal/chain.PaxeerSettler.AnchorBatch,github.com/paxlabs-inc/layerx/internal/chain.PaxeerSettler.OperatorAddress,github.com/paxlabs-inc/layerx/internal/chain.PaxeerSettler.alreadySettled,github.com/paxlabs-inc/layerx/internal/chain.PaxeerSettler.buildBatch,github.com/paxlabs-inc/layerx/internal/chain.PaxeerSettler.findAnchorTx,github.com/paxlabs-inc/layerx/internal/chain.PaxeerSettler.transactor
