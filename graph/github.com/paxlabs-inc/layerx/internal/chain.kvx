NODE id=github.com/paxlabs-inc/layerx/internal/chain.PaxeerSettler.buildBatch kind=method
  digest=b3:0dec289b91828d131b5e6f4a8a9696f4bb1fcf288c833ed3e3e8e0f7c772e7fa file=layerx/internal/chain/settler.go range=133:160 lang=go exported=false byte_range=4875:5794
  sig=func (p *PaxeerSettler) buildBatch(rootHex string, windowEnd time.Time, deltas []NetDelta) (Batch, error)
  doc=buildBatch assembles the on-chain Batch for a sealed window: it decodes the\n(non-zero) root, derives the deterministic batchId, and turns the positive\nnet deltas into payouts (recipient = mapped EVM address). It is a pure\nfunction (no I/O), so the batchId determinism + payout building are unit\ntestable without a chain.
EDGES
  ^contains=github.com/paxlabs-inc/layerx/internal/chain.PaxeerSettler
  ^defines=github.com/paxlabs-inc/layerx/internal/chain/settler.go

NODE id=github.com/paxlabs-inc/layerx/internal/chain.PaxeerSettler.findAnchorTx kind=method
  digest=b3:c6a13fdc9b45bf0cccc32a8243e6b61b5672e7d7ed667f3f1317c80988b105f0 file=layerx/internal/chain/settler.go range=234:254 lang=go exported=false byte_range=8075:8988
  sig=func (p *PaxeerSettler) findAnchorTx(ctx context.Context, batchID [32]byte) (string, error)
  doc=findAnchorTx recovers the original anchor tx hash for an already-settled batch\nby filtering the SettlementAnchored event (batchId is its first indexed\ntopic). Used on the idempotent path so receipts still expose a real anchor tx.
EDGES
  ^contains=github.com/paxlabs-inc/layerx/internal/chain.PaxeerSettler
  ^defines=github.com/paxlabs-inc/layerx/internal/chain/settler.go

