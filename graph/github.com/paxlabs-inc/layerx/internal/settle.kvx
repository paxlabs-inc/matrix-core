NODE id=github.com/paxlabs-inc/layerx/internal/settle.Worker.SettleNow kind=method
  digest=b3:fc4f27b3a124753c55e4f632fb727f7410573e48fde35a80f3f3f10492ee09c1 file=layerx/internal/settle/settle.go range=115:174 lang=go exported=true byte_range=4001:6306
  sig=func (w *Worker) SettleNow(ctx context.Context) (string, error)
  doc=SettleNow performs one settlement pass over all currently-unsettled transfers:\nbuild root -> seal batch -> anchor on Paxeer -> mark anchored. Returns the\nbatch id (empty when there was nothing to settle). Safe to call concurrently;\npasses are serialized.
EDGES
