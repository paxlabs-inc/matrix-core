NODE id=github.com/paxlabs-inc/layerx/internal/settle.Worker.RecoverPending kind=method
  digest=b3:4e95177cf51e0a789967737d8f4cfa6677f9a807ce8963bf1d080b5d0a5b7f30 file=layerx/internal/settle/settle.go range=230:264 lang=go exported=true byte_range=8078:9517
  sig=func (w *Worker) RecoverPending(ctx context.Context) error
  doc=RecoverPending re-submits batches that were sealed but never confirmed\nanchored (e.g. a crash between seal and confirm). AnchorBatch is idempotent on\nthe root, so a batch already settled on-chain is reconciled (its real anchor\ntx recovered) rather than double-anchored — honoring at-least-once. Safe to\ncall once at startup; serialized against live settlement passes.
EDGES
  ^contains=github.com/paxlabs-inc/layerx/internal/settle.Worker
  ^defines=github.com/paxlabs-inc/layerx/internal/settle/settle.go

NODE id=github.com/paxlabs-inc/layerx/internal/settle.Worker.RecoverPendingWithdrawals kind=method
  digest=b3:127462bfe18f07f705173b0ec308abbe6156c141ba3dc74f18ae331896ffb314 file=layerx/internal/settle/settle.go range=374:427 lang=go exported=true byte_range=14057:16260
  sig=func (w *Worker) RecoverPendingWithdrawals(ctx context.Context) error
  doc=RecoverPendingWithdrawals re-submits withdrawal payouts that were sealed\n(queued -> submitted) but never confirmed settled (e.g. a crash between seal\nand confirm). It groups the submitted rows by their frozen payout root,\nre-derives the SAME root from the frozen recipients/amounts (a mismatch is a\ndata-integrity bug and is skipped rather than paid), and re-anchors —\nidempotent on the root, so an already-settled payout is reconciled (its real\ntx recovered) rather than double-paid. Safe to call once at startup.
EDGES
  ^contains=github.com/paxlabs-inc/layerx/internal/settle.Worker
  ^defines=github.com/paxlabs-inc/layerx/internal/settle/settle.go

