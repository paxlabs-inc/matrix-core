  digest=b3:9d25c0b81bd87ba189f4af791622a58bee4387e2f8f193e144f86b14d9cdc3c8 file=layerx/internal/server/server.go range=207:234 lang=go exported=false byte_range=7109:8024
  sig=func (s *Server) rateLimitMiddleware(next http.Handler) http.Handler
  doc=rateLimitMiddleware applies the per-client token-bucket limiter for the\nrequest's class (read / write / auth). /healthz and / are exempt so liveness\nprobes are never throttled. A denial returns 429 + Retry-After and the stable\nrate_limited code.
