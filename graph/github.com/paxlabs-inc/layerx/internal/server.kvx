  digest=b3:596e56fb8aa56e13358910f050918d9935c80ca2e707e4f2e44728cfcea79b5a file=layerx/internal/server/server.go range=638:669 lang=go exported=false byte_range=22982:24563
  sig=func (s *Server) writeCaller(w http.ResponseWriter, r *http.Request, fromDID, pubHex, nonce, sigHex, preimage string) (string, bool)
  doc=writeCaller authorizes a value write and returns the caller DID. It accepts\nEITHER the X-LayerX-Agent principal token (convenience) OR a DID-signed intent\n(the signature IS the authorization, invariant i6): from_did + public_key +\nnonce + signature over preimage. The nonce must be a live single-use challenge\nnonce bound to from_did, giving replay protection; it is consumed only after\nthe signature verifies so a bad signature never burns a legitimate nonce.
EDGES
  ^contains=github.com/paxlabs-inc/layerx/internal/server.Server
  ^defines=github.com/paxlabs-inc/layerx/internal/server/server.go

