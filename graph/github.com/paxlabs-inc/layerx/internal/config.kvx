NODE id=github.com/paxlabs-inc/layerx/internal/config.kvxDoc kind=type
  digest=b3:ea8f0336bf421e22f9a44c5df7dba091db50266aa6c6370f7195df498a61b356 file=layerx/internal/config/kvx.go range=12:30 lang=go exported=false byte_range=82:764
  sig=type kvxDoc struct {\n	sections	map[string]map[string]string\n	order		[]string\n}
  doc=kvxDoc is a parsed layerx.config.kvx file: a sectioned key/value document.\n\nFormat (zero-dep, deterministic), shared with chronos/tachyon/uwac's config\nloaders:\n\n	# comment\n	[section]\n	key = "string"            # double-quoted strings (per Matrix .mtx convention)\n	num = 9098                # bare ints / bools\n	list = ["a", "b"]         # bracketed, comma-separated, quoted items\n	[section.sub]\n	ref = "${ENV_VAR}"        # ${ENV} interpolated from the process environment\n\nValues are stored as raw tokens; typed accessors parse on demand. Later\nduplicate keys win.
EDGES
  contains=github.com/paxlabs-inc/layerx/internal/config.kvxDoc#order,github.com/paxlabs-inc/layerx/internal/config.kvxDoc#sections,github.com/paxlabs-inc/layerx/internal/config.kvxDoc.str,github.com/paxlabs-inc/layerx/internal/config.kvxDoc.uint64Or
  ^defines=github.com/paxlabs-inc/layerx/internal/config/kvx.go

