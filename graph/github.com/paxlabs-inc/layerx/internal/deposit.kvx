NODE id=github.com/paxlabs-inc/layerx/internal/deposit.Worker.credit kind=method
  digest=b3:f71c11a26bf4e742c9fdceed0ee4abb74fd5f436ece3d23a6d6b24eefc28e527 file=layerx/internal/deposit/deposit.go range=151:179 lang=go exported=false byte_range=4800:6212
  sig=func (w *Worker) credit(ctx context.Context, ev chain.DepositEvent) error
  doc=credit resolves the DID claim and credits the deposit exactly once. An\nunresolved claim (the agent never called GET /v1/deposit) is logged and\nskipped — it cannot be attributed to a DID, and re-scanning is avoided by the\nadvancing cursor; a zero/over-range mint is also skipped defensively.
EDGES
  ^contains=github.com/paxlabs-inc/layerx/internal/deposit.Worker
  ^defines=github.com/paxlabs-inc/layerx/internal/deposit/deposit.go

NODE id=github.com/paxlabs-inc/layerx/internal/deposit.Worker.reconcile kind=method
  digest=b3:a1d8a7d0e79ae03026f871db6c51305a2870fbac250376cbb7c69861340bd763 file=layerx/internal/deposit/deposit.go range=181:206 lang=go exported=false byte_range=6214:7245
  sig=func (w *Worker) reconcile(ctx context.Context)
  doc=reconcile reads the on-chain reserve and the off-chain circulating supply and\nlogs any drift (invariant i1). It is diagnostic only — transient drift is\nexpected while a deposit is mid-confirmation — so it never fails the loop.
EDGES
