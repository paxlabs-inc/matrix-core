NODE id=github.com/paxlabs-inc/layerx/pkg/types.MicroPerUSDX kind=const
  digest=b3:3eaf7f14ce6870ca655e93ba5c2ad903355b70cf02abe01cc021954653ba77eb file=layerx/pkg/types/types.go range=63:67 lang=go exported=true byte_range=2020:2336
  sig=int64
  doc=MicroPerUSDX is the fixed-point scale: balances are stored as int64 counts of\nmicro-USDX (1 USDX = 1_000_000 micro-USDX). Integer math avoids float drift in\nthe ledger (the exact precision is a [deferred] decision in the frozen spec;\nmicro is the v1 scaffold choice).
EDGES
  ^defines=github.com/paxlabs-inc/layerx/pkg/types/types.go

