NODE id=github.com/paxlabs-inc/tachyon-tools/internal/engine.defaultEVMVersion kind=const
  digest=b3:127c22cdec47937b0260c010664cc1ae484a747466524d51cd7b64967f34036a file=tachyon/internal/engine/workdir.go range=18:27 lang=go exported=false byte_range=334:1066
  sig=untyped string
  doc=defaultEVMVersion is the solc/EVM target used for uploaded-source compiles\nwhen the caller does not pin one. Deliberately conservative: Paxeer mainnet\n(chain 125) and many other EVM chains are PRE-Cancun, so solc 0.8.27's\ndefault ("cancun") emits the MCOPY opcode (0x5E) — string/dynamic-memory\ncalls like name()/symbol() then revert on-chain with "invalid opcode: opcode\n0x5e not defined". "shanghai" still emits PUSH0 (which Paxeer supports) but\nno Cancun-only opcodes, so it deploys and runs everywhere modern. Callers can\noverride per-chain via CompileRequest/TestRequest.EVMVersion (e.g. "cancun"\nfor a chain that supports it, or "paris" for a PUSH0-less node).
EDGES
  ^defines=github.com/paxlabs-inc/tachyon-tools/internal/engine/workdir.go

NODE id=github.com/paxlabs-inc/tachyon-tools/internal/engine.foundryTomlFor kind=func
  digest=b3:05981f37dc4cea3983f0ea2743f2bdbd7e1e5eba1c5ddb801867a2fee5796b86 file=tachyon/internal/engine/workdir.go range=29:47 lang=go exported=false byte_range=1068:1726
  sig=func foundryTomlFor(evmVersion string) string
  doc=foundryTomlFor renders the uploaded-source foundry.toml written when the\ncaller did not provide their own. Contracts live under src/, tests under\ntest/; the box's dependency tree is linked in as lib/ (see\nprepareSourceWorkdir). The EVM version is pinned (caller override falls back\nto defaultEVMVersion) so artifacts target an opcode set the deploy chain runs.
EDGES
  ^defines=github.com/paxlabs-inc/tachyon-tools/internal/engine/workdir.go

NODE id=github.com/paxlabs-inc/tachyon-tools/internal/engine.maxSourceBytes kind=const
  digest=b3:85cf6f5d0661e093fc0c738385b367b1aec19b10a16160b4fa22e26fb4665df1 file=tachyon/internal/engine/workdir.go range=14:16 lang=go exported=false byte_range=154:323
  sig=untyped int
  doc=maxSourceBytes bounds one uploaded source file (defensive against runaway\npayloads). Solidity files comfortably fit well under this.
EDGES
  ^defines=github.com/paxlabs-inc/tachyon-tools/internal/engine/workdir.go

