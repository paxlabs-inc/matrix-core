  sig=func (e *Engine) resolveABI(req types.CallRequest) ([]byte, *types.Error)
  doc=resolveABI returns the ABI JSON to encode against: an inline ABI if provided,\notherwise the ABI of the named contract artifact from the registry.
EDGES
