NODE id=github.com/paxlabs-inc/tachyon-tools/internal/config.kvxDoc kind=type
  digest=b3:a8dd58badb773f8658d322e841965100a90f70230d82fb445b390aadb48097d0 file=tachyon/internal/config/kvx.go range=12:29 lang=go exported=false byte_range=82:763
  sig=type kvxDoc struct {\n	sections	map[string]map[string]string\n	order		[]string\n}
  doc=kvxDoc is a parsed tachyon.config.kvx file: a sectioned key/value document.\n\nFormat (zero-dep, deterministic):\n\n	# comment\n	[section]\n	key = "string"            # double-quoted strings (per Matrix .mtx convention)\n	num = 31337               # bare ints / bools\n	list = ["0xabc", "0xdef"] # bracketed, comma-separated, quoted items\n	[section.sub]\n	ref = "${ENV_VAR}"        # ${ENV} interpolated from the process environment\n\nValues are stored as raw tokens; typed accessors parse on demand. Section\nnames are case-sensitive; keys are trimmed. Later duplicate keys win.
EDGES
  contains=github.com/paxlabs-inc/tachyon-tools/internal/config.kvxDoc#order,github.com/paxlabs-inc/tachyon-tools/internal/config.kvxDoc#sections,github.com/paxlabs-inc/tachyon-tools/internal/config.kvxDoc.has,github.com/paxlabs-inc/tachyon-tools/internal/config.kvxDoc.list,github.com/paxlabs-inc/tachyon-tools/internal/config.kvxDoc.sectionsWithPrefix,github.com/paxlabs-inc/tachyon-tools/internal/config.kvxDoc.str,github.com/paxlabs-inc/tachyon-tools/internal/config.kvxDoc.uint64Or
  ^defines=github.com/paxlabs-inc/tachyon-tools/internal/config/kvx.go

