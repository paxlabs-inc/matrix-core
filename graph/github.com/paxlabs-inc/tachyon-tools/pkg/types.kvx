NODE id=github.com/paxlabs-inc/tachyon-tools/pkg/types.CompileRequest kind=type
  digest=b3:f93f0f28d6f5d09846cd2ead229194773cf3b89d5a3fddcf9882e37f87f1956e file=tachyon/pkg/types/compile.go range=5:28 lang=go exported=true byte_range=39:1460
  sig=type CompileRequest struct {\n	ProjectRoot	string			`json:"project_root,omitempty"`\n	ProjectID	string			`json:"project_id,omitempty"`\n	Sources		map[string]string	`json:"sources,omitempty"`\n	Targets		[]string		`json:"targets,omitempty"`\n	Optimize	*bool			`json:"optimize,omitempty"`\n	ViaIR		*bool			`json:"via_ir,omitempty"`\n	// EVMVersion pins the solc/EVM target for an uploaded-source compile\n	// (e.g. "shanghai", "paris", "cancun"). Empty uses the engine's\n	// conservative default (shanghai) so artifacts don't emit Cancun-only\n	// opcodes (MCOPY) that pre-Cancun chains like Paxeer 125 reject. Ignored\n	// when the caller uploads their own foundry.toml.\n	EVMVersion	string	`json:"evm_version,omitempty"`\n}
  doc=CompileRequest builds Solidity contracts via forge.\n\nSources, when non-empty, makes the request self-contained: the engine\nmaterializes the map (workdir-relative path -> file content) into an\nephemeral Foundry project, links the box's baked dependency tree\n(forge-std + the @openzeppelin/contracts/ corpus), runs forge there, and\nderives a deterministic ProjectID from the source set. This is how a SHARED\ntachyond compiles a caller's own contracts without those files ever living\non the box. Convention: contracts under src/, tests under test/; OZ\n(@openzeppelin/contracts/...) and forge-std/... resolve automatically.
EDGES
  contains=github.com/paxlabs-inc/tachyon-tools/pkg/types.CompileRequest#EVMVersion,github.com/paxlabs-inc/tachyon-tools/pkg/types.CompileRequest#Optimize,github.com/paxlabs-inc/tachyon-tools/pkg/types.CompileRequest#ProjectID,github.com/paxlabs-inc/tachyon-tools/pkg/types.CompileRequest#ProjectRoot,github.com/paxlabs-inc/tachyon-tools/pkg/types.CompileRequest#Sources,github.com/paxlabs-inc/tachyon-tools/pkg/types.CompileRequest#Targets,github.com/paxlabs-inc/tachyon-tools/pkg/types.CompileRequest#ViaIR
  ^defines=github.com/paxlabs-inc/tachyon-tools/pkg/types/compile.go

NODE id=github.com/paxlabs-inc/tachyon-tools/pkg/types.CompileRequest#EVMVersion kind=field
  digest=b3:a69790e1764fcd4eaecfc0553c5e4164822af1fe4e3fc90ffda04998f5ec0ca8 file=tachyon/pkg/types/compile.go range=22:27 lang=go exported=true byte_range=1074:1458
  sig=string
  doc=EVMVersion pins the solc/EVM target for an uploaded-source compile\n(e.g. "shanghai", "paris", "cancun"). Empty uses the engine's\nconservative default (shanghai) so artifacts don't emit Cancun-only\nopcodes (MCOPY) that pre-Cancun chains like Paxeer 125 reject. Ignored\nwhen the caller uploads their own foundry.toml.
EDGES
  ^contains=github.com/paxlabs-inc/tachyon-tools/pkg/types.CompileRequest

