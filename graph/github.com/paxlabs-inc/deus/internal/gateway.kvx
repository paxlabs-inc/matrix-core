NODE id=github.com/paxlabs-inc/deus/internal/gateway.hostedRequestDigest kind=func
  digest=b3:4b8f6d7a77b9924a3c19e9c0d723e082357229ac0e667bddd33db1aff9a9d6ee file=deus/internal/gateway/gateway.go range=464:479 lang=go exported=false byte_range=15885:16470
  sig=func hostedRequestDigest(invocationID, serviceID, callerDID, argsHash string) string
  doc=hostedRequestDigest binds the fields the gateway knows before execution into\na stable digest the runner can co-sign. It is keccak256 over canonical JSON\n(same hashing as receipt payloads) and does not include the result hash,\nwhich is unknown until the runner returns.
EDGES
  ^defines=github.com/paxlabs-inc/deus/internal/gateway/gateway.go

NODE id=github.com/paxlabs-inc/deus/internal/gateway.isAppwriteExecutionsURL kind=func
