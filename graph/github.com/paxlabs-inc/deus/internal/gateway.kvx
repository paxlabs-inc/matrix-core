  sig=func isAppwriteExecutionsURL(execURL string) bool
  doc=isAppwriteExecutionsURL reports whether execURL is an Appwrite synchronous\nexecutions endpoint (".../functions/{id}/executions"). Dev/runner endpoints\nuse {url}/invoke instead and are routed through CallHosted.
EDGES
  ^defines=github.com/paxlabs-inc/deus/internal/gateway/hosted.go

