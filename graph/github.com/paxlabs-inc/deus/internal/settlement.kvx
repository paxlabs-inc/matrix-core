NODE id=github.com/paxlabs-inc/deus/internal/settlement.Settler.RunWindow kind=method
  digest=b3:aaa27397ebd996ef250a350ce39c392a2dbbbaffd09acf67e56e01b0cb20d99c file=deus/internal/settlement/settler.go range=41:188 lang=go exported=true byte_range=764:5521
  sig=func (s *Settler) RunWindow(ctx context.Context, developerID, payoutAddr string) (WindowResult, error)
  doc=RunWindow settles a developer's net-rail invocations, bounded by each funding\nchannel's highest caller-co-signed voucher (docs/08 §8.3, audit F2). For every\nchannel it includes invocations oldest-first only while the running spend\nstays within the voucher cumulative minus what the escrow already redeemed;\nun-co-signed overflow stays unsettled until the caller signs a higher voucher.\nDeus therefore never pays out more than the caller cryptographically admitted.
EDGES
  ^contains=github.com/paxlabs-inc/deus/internal/settlement.Settler
  ^defines=github.com/paxlabs-inc/deus/internal/settlement/settler.go

