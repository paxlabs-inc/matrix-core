  digest=b3:1982b231df1d494c06853fbcc63ca49006b1dbe5f9fc7de27ec0f2faee6ed0e3 file=deus/internal/wallet/client.go range=66:80 lang=go exported=true byte_range=1873:2530
  sig=func (c *HTTPClient) AuthorizeSpend(ctx context.Context, bearer, amountWei, serviceID string) error
  doc=AuthorizeSpend is a pre-flight hook. Custody policy (per-call cap, total cap,\nallowlist, frozen/read-only) is enforced atomically by the wallet at Send time\n— the wallet returns 403 which Send maps to *PolicyDenied — so there is no\nseparate authorize call to make and no silent bypass: enforcement lives on the\nmoney-moving path itself (docs/08 §8.4, docs/10 §10.3; audit F8).
EDGES
  ^contains=github.com/paxlabs-inc/deus/internal/wallet.HTTPClient
  ^defines=github.com/paxlabs-inc/deus/internal/wallet/client.go

