NODE id=matrix/cody/internal/orchestrator.PlanFromModel kind=func
  digest=b3:36bcaad9fecbc0a487eeeb41b5aff836f59ddffcd8b92ebc8a556cce693afe1b file=cody/internal/orchestrator/planner.go range=60:81 lang=go exported=true byte_range=3484:4427
  sig=func PlanFromModel(ctx context.Context, client *llm.Client, request, grounding, modePolicy string) (*Plan, error)
  doc=PlanFromModel asks the model to author the waved task list for a request,\ngrounded in the workspace summary, and validates the result. The engine\nowns everything else — the model only proposes the decomposition. This is\nthe single-candidate path; PlanFromModelDivergent is the decision-phase path\nthe engine uses (N divergent candidates judged).
EDGES
  ^defines=matrix/cody/internal/orchestrator/planner.go

NODE id=matrix/cody/internal/orchestrator.PlanFromModelDivergent kind=func
  digest=b3:2036f1b3e79fd6ead51f4810b598873e77c7bc215f4ccba3febd06c8b5cf294e file=cody/internal/orchestrator/planner.go range=83:127 lang=go exported=true byte_range=4429:6136
  sig=func PlanFromModelDivergent(ctx context.Context, hot, cold *llm.Client, request, grounding, modePolicy string, candidates int) (*Plan, error)
  doc=PlanFromModelDivergent authors the plan the decision way: generate\n`candidates` divergent plans HOT, keep the ones that parse and validate, and\npick the best-fitting one COLD (req 10.2 — plan-shape authoring runs at\ndecision temperature with N divergent candidates judged; workers stay cold).\nhot is the decision-temperature client; cold is the adjudication client. It\nfalls back cleanly to the single-candidate contract when candidates <= 1.
EDGES
  ^defines=matrix/cody/internal/orchestrator/planner.go

NODE id=matrix/cody/internal/orchestrator.PlanHasUITask kind=func
  digest=b3:403972f34ffaadbbd7d9630b1f52aede42d964299c471d83e8b3ecc455a8af65 file=cody/internal/orchestrator/orchestrator.go range=607:616 lang=go exported=true byte_range=22808:23093
