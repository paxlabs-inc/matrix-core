  ^defines=matrix/cody/internal/orchestrator/planner.go

NODE id=matrix/cody/internal/orchestrator.adoptSystem kind=const
  digest=b3:41fafc357e0a206763bf360d81a406edd7da2c426b70f4b0a1d600afa3d877c2 file=cody/internal/orchestrator/planner.go range=129:157 lang=go exported=false byte_range=6138:9019
  sig=untyped string
  doc=adoptSystem casts the model as the planning half of Cody prime ADOPTING an\nexisting specification document as the plan — not decomposing a prose request\nfrom scratch. The document is the source of truth: its requirements map onto\ntask acceptance criteria and its own structure (sections/phases/waves) drives\nthe decomposition where present (req 11.1). The JSON contract is identical to\nthe from-scratch planner so the engine owns the loop unchanged.
EDGES
  ^defines=matrix/cody/internal/orchestrator/planner.go

