NODE id=matrix/cody/internal/orchestrator.WorkerFunc kind=type
  digest=b3:10456899c1e224f6c0d0a144c485e4174bdfa5ca54f821adb073de554e8b4de5 file=cody/internal/orchestrator/orchestrator.go range=35:39 lang=go exported=true byte_range=1331:1707
  sig=type WorkerFunc func(ctx context.Context, sheet *contract.TaskSheet, grounding string) (*contract.TurnInReport, error)
  doc=WorkerFunc dispatches ONE fresh-context worker for one sheet and returns\nits turn-in report. The worker's transcript lives and dies inside the call\n— only the report crosses this seam, which is what keeps the orchestrator\nlean by construction.
