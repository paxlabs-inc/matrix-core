  ^defines=matrix/cody/internal/orchestrator/orchestrator.go

NODE id=matrix/cody/internal/orchestrator.WriteSpecFiles kind=func
  digest=b3:d3467478f23cd43d5060cbec822a3baa7445c5616ecb60ec0b08f8bf5cb0f0bd file=cody/internal/orchestrator/specfiles.go range=14:30 lang=go exported=true byte_range=252:1113
  sig=func WriteSpecFiles(root string, p *Plan) error
  doc=WriteSpecFiles renders the plan as durable in-workspace spec files —\nrequirements.md (the goals and acceptance criteria in EARS shape) and\ntasks.md (the waved checklist with live statuses) under .cody/spec/. This\nis Architect mode's persistence: the spec survives the session and a\nresumed orchestrator (or the user) reads the same durable plan the engine\nexecutes. The files live under .cody, so writing them never violates the\norchestrator's never-writes-code invariant over the user's tree.
EDGES
  ^defines=matrix/cody/internal/orchestrator/specfiles.go

NODE id=matrix/cody/internal/orchestrator.adoptCriteria kind=const
  digest=b3:7ace4eaf7189ef2a02cf7ca1600194162b3375b125dfdb1ff23f35a4548f788a file=cody/internal/orchestrator/planner.go range=159:160 lang=go exported=false byte_range=9021:9412
  sig=untyped string
  doc=adoptCriteria is what the judge weighs candidate adoptions against.
