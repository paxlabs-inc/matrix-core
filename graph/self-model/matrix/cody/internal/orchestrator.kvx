NODE id=matrix/cody/internal/orchestrator.Orchestrator.foldSteers kind=method
  digest=b3:5a93b81b7191492708a00ee28f19211840fb57c4ecaf917820784e4a0a5dc2a2 file=cody/internal/orchestrator/orchestrator.go range=438:454 lang=go exported=false byte_range=16349:16948
  sig=func (o *Orchestrator) foldSteers()
  doc=foldSteers refreshes the folded human direction from the provider and emits\none steer.folded event per newly-arrived direction. Idempotent: only\ndirection beyond what was already folded is emitted, so a respawned\norchestrator re-reading the full list never double-emits within one run.
EDGES
  ^contains=matrix/cody/internal/orchestrator.Orchestrator
  ^defines=matrix/cody/internal/orchestrator/orchestrator.go

NODE id=matrix/cody/internal/orchestrator.Orchestrator.reconstructWindow kind=method
  digest=b3:0b088326b6b60b641ffd3457406c0881a27b0d652bd53dd6e137d183771e10b0 file=cody/internal/orchestrator/orchestrator.go range=408:436 lang=go exported=false byte_range=15263:16347
  sig=func (o *Orchestrator) reconstructWindow() error
  doc=reconstructWindow rebuilds the lean context after a restart: for every task\ncheckpointed done in cortex, the persisted sheet digest and the latest\nturn-in report digest are replayed into the window in checkpoint order — so\na resumed orchestrator holds exactly what a never-interrupted one would\n(plan + sheets + reports), and no worker transcript is ever reconstructable\nbecause none was ever persisted.
EDGES
  ^contains=matrix/cody/internal/orchestrator.Orchestrator
