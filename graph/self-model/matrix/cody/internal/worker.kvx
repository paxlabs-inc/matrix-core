  digest=b3:92a6a5850b2d2dffdea442cc89e1ecc0aa8b5df50e77fee056cc190d5cde74b5 file=cody/internal/worker/cassandra.go range=41:45 lang=go exported=false byte_range=2049:2374
  sig=untyped string
  doc=auditEventMod is the single Cassandra 2.0 audit event: one silent\nmodification of a prior assistant message. It rides the worker's optional\nAudit side-channel (wired by codyd to the run's event stream) as a pure\nobservability signal — it is a no-op when no observer is set.
EDGES
  ^defines=matrix/cody/internal/worker/cassandra.go

NODE id=matrix/cody/internal/worker.autoBackgroundAfter kind=var
  digest=b3:c8e4b9d3152dcfe542d23c4a25dc572f4bb377666945b1244f1781fc0a741eb8 file=cody/internal/worker/jobs.go range=17:22 lang=go exported=false byte_range=273:666
  sig=time.Duration
  doc=autoBackgroundAfter is how long an exec command may block a step before it\nis promoted to a background job: the step returns immediately with the job\nid and the output so far, and the command keeps running (npm install,\nbuilds, test suites) instead of eating the step against the exec timeout.\nA package var so tests can compress time.
EDGES
  ^defines=matrix/cody/internal/worker/jobs.go

