  digest=b3:28bc495876c48043469d9b6067fed19a4d34861a2a30bef118782dacb8fb8183 file=cody/internal/worker/diagnostics.go range=59:81 lang=go exported=false byte_range=1688:2421
  sig=func runDiag(dir, bin string, args ...string) string
  doc=runDiag executes one checker and returns its combined output ONLY when it\nfailed (non-zero exit). A missing binary or a clean pass returns "".\ngofmt -e -l is special-cased: it exits 0 even on syntax errors, reporting\nthem on stderr, so any stderr output counts as a failure there.
EDGES
  ^defines=matrix/cody/internal/worker/diagnostics.go

NODE id=matrix/cody/internal/worker.screenshotInstruction kind=func
  digest=b3:f720f2ac8e400c985166e560366910e38f9d958ebb4ba439074e0d3573c0658e file=cody/internal/worker/worker.go range=844:854 lang=go exported=false byte_range=27345:28320
  sig=func screenshotInstruction(s *contract.TaskSheet) string
  doc=screenshotInstruction renders the UI-evidence instruction to match the\nenvironment's REAL capability (req 4.1): when a screenshot can be captured\nthe gate demands one; when it cannot, the worker is explicitly told not to\nimprovise one — a fabricated or repo-committed image is not evidence, and\nthe gate will not ask for what the environment cannot produce (req 4.3).
EDGES
  ^defines=matrix/cody/internal/worker/worker.go

