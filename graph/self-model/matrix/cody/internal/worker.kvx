NODE id=matrix/cody/internal/worker.Worker.cassandraClassify kind=method
  digest=b3:f70f876eef907bd9e9a1a41c7368a542491f6d1ee78ee712b758fdbd3603583f file=cody/internal/worker/cassandra.go range=217:257 lang=go exported=false byte_range=8903:10528
  sig=func (w *Worker) cassandraClassify(sig cassandraSignals) (modTrigger, modSide)
  doc=cassandraClassify maps the drift to (trigger, side), selecting the side that\npushes the run toward the productive middle (two-sided damping, never\none-sided doubt-spam). A strong loop is always doubt (step back, try a\ndifferent approach); milder cyclic repetition splits by tool KIND — cyclic\nreads/checks are thrashing (assurance: commit and move on), cyclic mutations\nare oscillation (assurance: stop flip-flopping), and anything else cyclic is\ndoubt. On a bare-message step the relevant drift is about finishing\nprematurely. Returns ("", "") when the run is healthy.
EDGES
  ^contains=matrix/cody/internal/worker.Worker
  ^defines=matrix/cody/internal/worker/cassandra.go

NODE id=matrix/cody/internal/worker.Worker.cassandraEdit kind=method
  digest=b3:7e4702ce8e5f8058cb57b24fdb077e088051334d053760ae4d7f24adae8db8c1 file=cody/internal/worker/cassandra.go range=173:215 lang=go exported=false byte_range=6968:8901
  sig=func (w *Worker) cassandraEdit(target int, mod string, trig modTrigger, side modSide, step int) bool
  doc=cassandraEdit folds a first-person metacognitive line into the Content of\nthe assistant-role message at index target, IN PLACE. Guardrail 1\n(content-only) is enforced structurally: it asserts RoleAssistant and\nmutates ONLY .Content — never ToolCalls / Role / Name, and never a tool /\nuser / system message. The fold is additive (the original text is preserved\nand the mod is layered AFTER it as the worker's next thought), so guardrail\n2 (metacognition-only, never a rewrite of facts) holds by construction. The\ndual-record + audit event (guardrail 3) are written BEFORE the mutation.\nReturns false (no-op) if the target is out of range or is not an assistant\nmessage.
EDGES
  ^contains=matrix/cody/internal/worker.Worker
  ^defines=matrix/cody/internal/worker/cassandra.go

NODE id=matrix/cody/internal/worker.Worker.cassandraStep kind=method
  digest=b3:c885106c25d3d5bcd3dd381b50c9c8c4526bfc9163e1d3e9d0379ad318c752fd file=cody/internal/worker/cassandra.go range=143:171 lang=go exported=false byte_range=5879:6966
  sig=func (w *Worker) cassandraStep(sig cassandraSignals) bool
  doc=cassandraStep is the per-step controller entry point. It is a no-op before\nmin_step, when the per-run mod budget is spent, when the per-trigger\ncooldown is active, or when no drift trigger fires (the healthy case → the\nwindow is byte-identical to the controller disabled). On a fire it edits the\njust-appended assistant message's Content in place, records the dual-record,\nand emits the cassandra.mod audit event. Returns whether it modified the\nwindow.
EDGES
  ^contains=matrix/cody/internal/worker.Worker
  ^defines=matrix/cody/internal/worker/cassandra.go

NODE id=matrix/cody/internal/worker.Worker.diagnose kind=method
  digest=b3:4d35e8fca85b0355614f1948aa0742f1408d44ce44557045e670a4d104f99900 file=cody/internal/worker/diagnostics.go range=24:57 lang=go exported=false byte_range=527:1686
  sig=func (w *Worker) diagnose(rel string) string
  doc=diagnose runs a cheap per-language syntax check on a just-written file and\nreturns a diagnostics note to append to the fs_write/fs_edit tool result —\nso the model learns "you broke the file" in the same step, without waiting\nfor a full verify_run. Best-effort: a missing checker or an unknown\nextension returns "". It never replaces verification.
EDGES
  ^contains=matrix/cody/internal/worker.Worker
  ^defines=matrix/cody/internal/worker/diagnostics.go

