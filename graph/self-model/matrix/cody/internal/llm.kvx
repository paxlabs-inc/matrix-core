  digest=b3:f6fa1c7f681a811dac4d29c8807d683d61e464d6abacd6811eb891327c39bccb file=cody/internal/llm/stream_idle.go range=20:20 lang=go exported=false byte_range=737:754
  sig=*time.Timer
