NODE id=matrix/cody/internal/llm.deltaFlushChars kind=const
  digest=b3:8649e64540b0001b2a7eeb781e6edaaef160f61c10dfe3688ac7027244743199 file=cody/internal/llm/client.go range=321:326 lang=go exported=false byte_range=12204:12594
  sig=untyped int
  doc=deltaFlushChars is the coalescing threshold for live streaming: incremental\nfragments are buffered until at least this many new visible/reasoning chars\nhave accumulated, then flushed via onDelta. Small enough for a smooth\n"typing" cadence, large enough to keep the SSE event volume sane (one event\nper ~handful of tokens rather than one per token).
EDGES
  ^defines=matrix/cody/internal/llm/client.go

NODE id=matrix/cody/internal/llm.enableThinkingArgs kind=func
  digest=b3:5d84c28a242a5015ab3559ea6e373782c62d97c29268f8c306738655190c9a0a file=cody/internal/llm/client.go range=623:634 lang=go exported=false byte_range=21791:22421
  sig=func enableThinkingArgs(model string) map[string]any
  doc=enableThinkingArgs returns the chat_template_args that turn reasoning ON for\nBaseten-served models where it is OPT-IN: Kimi (moonshotai/*) emits its\nchain-of-thought as visible `content` unless enable_thinking makes the\nserver split it into the separate reasoning_content channel. Grok (grok-*)\nuses xAI's native `reasoning_effort` field instead (see reasoningEffort).\nReturns nil for models that reason by default (never sent).
EDGES
  ^defines=matrix/cody/internal/llm/client.go

NODE id=matrix/cody/internal/llm.envKey kind=func
