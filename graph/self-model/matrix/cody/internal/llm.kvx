NODE id=matrix/cody/internal/llm.StripGuidance kind=func
  digest=b3:c080433d6503ccd1e9091cce73db9344f385a5830a11441fa91e0241c7dd4256 file=cody/internal/llm/message.go range=170:199 lang=go exported=true byte_range=6519:7700
  sig=func StripGuidance(s string) string
  doc=StripGuidance removes any guidance-channel envelope (and stray lone tags) from\na string before it reaches a user-facing surface (reasoning/thinking deltas,\nthe assistant transcript). It is a defense-in-depth backstop for req.1.3: the\nmodel is instructed never to echo <system_guidance>, but if it does, internal\nsteering must not stream to the user. Complete <system_guidance>…</system_guidance>\nblocks are dropped; an unterminated open tag drops everything from the tag\nonward; bare tags are removed. The surrounding (legitimate) text is otherwise\npreserved verbatim — no trimming — so streamed fragments keep their spacing.
EDGES
  ^defines=matrix/cody/internal/llm/message.go

