NODE id=matrix/cody/internal/llm.idleTimeoutReader.Read kind=method
  digest=b3:c29c70cf36311fdea28c6196bce47f9320a980246ae144a46be5fb31c380fc22 file=cody/internal/llm/stream_idle.go range=34:42 lang=go exported=true byte_range=1139:1507
  sig=func (ir *idleTimeoutReader) Read(p []byte) (int, error)
  doc=Read arms the watchdog for the duration of the underlying Read and disarms it\nas soon as the Read returns (data or error), so the deadline governs silence\non the wire, never the caller's processing time between reads.
EDGES
  ^contains=matrix/cody/internal/llm.idleTimeoutReader
  ^defines=matrix/cody/internal/llm/stream_idle.go

NODE id=matrix/cody/internal/llm.idleTimeoutReader.stop kind=method
  digest=b3:322f4b6230972c20e38a9ad0eabf15a09f7adb47c1ae31d51c9044f6fc282111 file=cody/internal/llm/stream_idle.go range=44:45 lang=go exported=false byte_range=1509:1637
  sig=func (ir *idleTimeoutReader) stop()
  doc=stop disarms the watchdog; call it once the stream is fully consumed.
EDGES
  ^contains=matrix/cody/internal/llm.idleTimeoutReader
  ^defines=matrix/cody/internal/llm/stream_idle.go

NODE id=matrix/cody/internal/llm.jsonArgs kind=func
  digest=b3:f9f37fa574b414448b0ad5c13883ab873e1d1acab8333e369756d75a469534f4 file=cody/internal/llm/client.go range=1021:1046 lang=go exported=false byte_range=36187:36799
  sig=func jsonArgs(s string) string
  doc=jsonArgs normalizes an improvised tool-call argument blob to a JSON object\nstring: it returns the first balanced {...} span if present, else "{}". This\nkeeps dispatch robust when a model emits prose or partial JSON around the args.
EDGES
  ^defines=matrix/cody/internal/llm/client.go

