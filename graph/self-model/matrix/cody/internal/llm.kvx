NODE id=matrix/cody/internal/llm.holdbackPartial kind=func
  digest=b3:a4a901b23d3665c90f4b5e5120ef9c4087a2bbfd4cad6dad3585ce700617e7a1 file=cody/internal/llm/client.go range=482:502 lang=go exported=false byte_range=17429:18143
  sig=func holdbackPartial(s string) string
  doc=holdbackPartial withholds a trailing fragment that could be the start of a\ncontrol marker (<think>, <thinking>, or the Kimi tool-call section/call\ntokens) so a half-arrived marker is never streamed as visible text. A normal\n'<' in prose (e.g. "a < b") is left intact — only a tail that is a genuine\nprefix of a known marker is held back, to be resolved once more bytes arrive.
EDGES
  ^defines=matrix/cody/internal/llm/client.go

NODE id=matrix/cody/internal/llm.idleTimeoutReader kind=type
  digest=b3:cc330f9cbc80fc001f2c6022288a1f5319f20ba923d32f11d9edbb9e2da1a30e file=cody/internal/llm/stream_idle.go range=11:21 lang=go exported=false byte_range=208:756
  sig=type idleTimeoutReader struct {\n	r	io.Reader\n	idle	time.Duration\n	timer	*time.Timer\n}
  doc=idleTimeoutReader wraps a streaming response body and fires onIdle if a\nsingle Read makes no progress within idle. It is the stream-aware\nreplacement for a blunt http.Client.Timeout: a long but healthy generation\nstreams tokens continuously and never trips, while a provider that stalls\nmid-stream (or never produces a first token) is cancelled promptly. onIdle is\nexpected to cancel the request context, which unblocks the in-flight Read.
EDGES
  contains=matrix/cody/internal/llm.idleTimeoutReader#idle,matrix/cody/internal/llm.idleTimeoutReader#r,matrix/cody/internal/llm.idleTimeoutReader#timer,matrix/cody/internal/llm.idleTimeoutReader.Read,matrix/cody/internal/llm.idleTimeoutReader.stop
  ^defines=matrix/cody/internal/llm/stream_idle.go

