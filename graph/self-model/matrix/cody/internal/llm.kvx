NODE id=matrix/cody/internal/llm.wireMessage kind=type
  digest=b3:415bb4d8fef4a83904bbc17dcc058a7ed55a6e4f58a549ff82f3fc7c4c8ae643 file=cody/internal/llm/client.go range=670:685 lang=go exported=false byte_range=23963:24886
  sig=type wireMessage struct {\n	Role			string		`json:"role"`\n	Content			string		`json:"content"`\n	ToolCalls		[]ToolCall	`json:"tool_calls,omitempty"`\n	ToolCallID		string		`json:"tool_call_id,omitempty"`\n	Name			string		`json:"name,omitempty"`\n	ReasoningContent	string		`json:"reasoning_content,omitempty"`\n}
  doc=wireMessage is the request-side message shape. It deliberately omits the\nreasoning channel so prior assistant reasoning is never echoed back.\nContent is NEVER omitempty: an assistant turn that carries only tool calls\nand a tool result whose output is empty both have Content == "", and a\nstrict provider deserializer (xAI) rejects the WHOLE request with a\nnon-retryable 422 ("missing field `content`") when the key is absent —\nwhich kills the worker attempt mid-task. An explicit "content":"" is\naccepted by every OpenAI-compatible provider.
EDGES
  contains=matrix/cody/internal/llm.wireMessage#Content,matrix/cody/internal/llm.wireMessage#Name,matrix/cody/internal/llm.wireMessage#ReasoningContent,matrix/cody/internal/llm.wireMessage#Role,matrix/cody/internal/llm.wireMessage#ToolCallID,matrix/cody/internal/llm.wireMessage#ToolCalls
