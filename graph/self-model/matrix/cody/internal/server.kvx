NODE id=matrix/cody/internal/server.Engine.Submit kind=method
  digest=b3:85ed8a5ae32ed7808b1a84eb46931be0c5bcc961cc08e2b8fec417acb37630c2 file=cody/internal/server/engine.go range=340:416 lang=go exported=true byte_range=10924:14130
  sig=func (e *Engine) Submit(convID, message, modeName, projectID, spec, specSource string) (string, bool, error)
  doc=Submit dispatches (or attaches to) the conversation's plan run in the named\nproject (empty = the default /workspace project). Mode is the project's mode;\nfor the default project a per-message mode override is honored for\nretro-compat. When spec is non-empty the planner adopts it as the plan\n(req 11); specSource records its origin for the plan.adopted event. Returns\nthe run id and whether it was freshly dispatched.
EDGES
  ^contains=matrix/cody/internal/server.Engine
  ^defines=matrix/cody/internal/server/engine.go

NODE id=matrix/cody/internal/server.Engine.activity kind=method
  digest=b3:945c4cdb3d18dacf8d83bbecd0ecd3c82a1c440832870a84fd98fb6f68391d77 file=cody/internal/server/engine.go range=1087:1100 lang=go exported=false byte_range=37469:38123
  sig=func (e *Engine) activity(r *run, phase, detail string)
  doc=activity publishes a milestone run.activity event: the current phase, a\nplain-language label, an optional detail (e.g. the task being built), and\nelapsed time since the run began. It is a pure side-channel — no loop, gate,\nor plan-determinism effect — and (once whitelisted in trace.go) persists so\nthe client rebuilds the last-known phase on reopen.
EDGES
  ^contains=matrix/cody/internal/server.Engine
  ^defines=matrix/cody/internal/server/engine.go

