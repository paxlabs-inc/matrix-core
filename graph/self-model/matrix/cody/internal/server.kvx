NODE id=matrix/cody/internal/server.EngineOptions kind=type
  digest=b3:ea3f7c25316b4cee20b9cd7a6019642cc64771f6db60fabb5cb2362bb12cdeeb file=cody/internal/server/engine.go range=43:107 lang=go exported=true byte_range=1335:4198
  sig=type EngineOptions struct {\n	// WorkspaceRoot is the user's code root (/workspace in the environment).\n	WorkspaceRoot	string\n	// DataDir holds codyd durable state (plans, traces) — /data/cody.\n	DataDir	string\n	// MediaDir overrides where uploads live; empty derives <volume>/media from\n	// DataDir (the same /data/media plane Neo uses on a shared volume).\n	MediaDir	string\n	// Cortex is the per-user cortex instance (progress checkpoints).\n	Cortex	*cortex.Cortex\n	// GatewayURL + ActorDID meter every LLM call on the cody slot.\n	GatewayURL	string\n	ActorDID	string\n	// DefaultMode when a request names none (engineer).\n	DefaultMode	mode.Mode\n	// Model overrides (empty = the mode's defaults).\n	OrchestratorModel	string\n	WorkerModel		string\n	// RulesDir / SkillsDir surface the standards library; empty disables.\n	RulesDir	string\n	SkillsDir	string\n	// ScaffoldDir points at the scaffolder suite (scaffold-<stack>.sh) workers\n	// run for greenfield project structure; empty disables the prompt section.\n	ScaffoldDir	string\n	// TitleModel, when set, generates the conversation title with a small\n	// bounded LLM call (async, fallback = first message line). Empty disables.\n	TitleModel	string\n	// Worker ExtraTools bridges (req 13.1): the shared browser (for screenshot\n	// evidence), fetch, and web search. Each is boot-safe when unset.\n	BrowserURL	string\n	BrowserToken	string\n	SearxngURL	string\n	SearxngToken	string\n	// MaxAttempts bounds per-task re-dispatch (default 3).\n	MaxAttempts	int\n	// MaxRespawns bounds orchestrator respawns per run (default 2).\n	MaxRespawns	int\n	// VerifyTimeout bounds one verification command.\n	VerifyTimeout	time.Duration\n	// CassandraDisabled turns the worker-loop silent-voice controller off\n	// (Cassandra 2.0); the structural gate still holds. The knobs mirror the\n	// controller defaults (min_step 2, max 3 mods/run, loop_threshold derived,\n	// cooldown 2) and 0 keeps each default.\n	CassandraDisabled	bool\n	CassandraMinStep	int\n	CassandraMaxMods	int\n	CassandraLoopThreshold	int\n	CassandraCooldown	int\n	// Preview wiring (req 7): a configured Railway sandbox client plus the\n	// router-facing coordinates turn "plan completed" into an on-demand preview.\n	// When Sandbox is nil (or the coordinates are empty) previews are disabled\n	// and the client shows "no preview yet". PreviewUserID is the supabase user\n	// id the router /preview proxy keys on; it MUST match the JWT subject.\n	Sandbox			sandbox.Client\n	PreviewUserID		string\n	RouterInternalURL	string\n	RouterPreviewToken	string\n	PreviewPublicBase	string\n	PreviewTTL		time.Duration\n	// PreviewImage overrides the sandbox base image (default: a Node runtime).\n	PreviewImage	string\n	// Logf receives diagnostics; nil discards.\n	Logf	func(format string, args ...interface{})\n}
  doc=EngineOptions configures codyd's engine.
EDGES
  contains=matrix/cody/internal/server.EngineOptions#ActorDID,matrix/cody/internal/server.EngineOptions#BrowserToken,matrix/cody/internal/server.EngineOptions#BrowserURL,matrix/cody/internal/server.EngineOptions#CassandraCooldown,matrix/cody/internal/server.EngineOptions#CassandraDisabled,matrix/cody/internal/server.EngineOptions#CassandraLoopThreshold,matrix/cody/internal/server.EngineOptions#CassandraMaxMods,matrix/cody/internal/server.EngineOptions#CassandraMinStep,matrix/cody/internal/server.EngineOptions#Cortex,matrix/cody/internal/server.EngineOptions#DataDir,matrix/cody/internal/server.EngineOptions#DefaultMode,matrix/cody/internal/server.EngineOptions#GatewayURL,matrix/cody/internal/server.EngineOptions#Logf,matrix/cody/internal/server.EngineOptions#MaxAttempts,matrix/cody/internal/server.EngineOptions#MaxRespawns,matrix/cody/internal/server.EngineOptions#MediaDir,matrix/cody/internal/server.EngineOptions#OrchestratorModel,matrix/cody/internal/server.EngineOptions#PreviewImage,matrix/cody/internal/server.EngineOptions#PreviewPublicBase,matrix/cody/internal/server.EngineOptions#PreviewTTL,matrix/cody/internal/server.EngineOptions#PreviewUserID,matrix/cody/internal/server.EngineOptions#RouterInternalURL,matrix/cody/internal/server.EngineOptions#RouterPreviewToken,matrix/cody/internal/server.EngineOptions#RulesDir,matrix/cody/internal/server.EngineOptions#Sandbox,matrix/cody/internal/server.EngineOptions#ScaffoldDir,matrix/cody/internal/server.EngineOptions#SearxngToken,matrix/cody/internal/server.EngineOptions#SearxngURL,matrix/cody/internal/server.EngineOptions#SkillsDir,matrix/cody/internal/server.EngineOptions#TitleModel,matrix/cody/internal/server.EngineOptions#VerifyTimeout,matrix/cody/internal/server.EngineOptions#WorkerModel,matrix/cody/internal/server.EngineOptions#WorkspaceRoot
