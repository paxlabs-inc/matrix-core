NODE id=matrix/cody/internal/server.Engine.awaitDirective kind=method
  digest=b3:6dd13024755404f28bb0f2c40da45c50c814f9d501dbb7b3426b5352d761eacc file=cody/internal/server/inbox.go range=157:182 lang=go exported=false byte_range=4952:6003
  sig=func (e *Engine) awaitDirective(ctx context.Context, r *run, q *question, say string) (directive, bool)
  doc=awaitDirective is the shared needs_input pause: it records the open question\ndurably, flips the run + ledger to needs_input, emits the run.needs_input\nevent, and blocks on the run's answer channel until an answer arrives or the\nrun is cancelled. The SDR/DLR decision gates ride the SAME channel with a\n"decision" question kind — the human checkpoint is one mechanism, not two.\nReturns (answer, true) on resolution, (_, false) on cancel.
EDGES
  ^contains=matrix/cody/internal/server.Engine
  ^defines=matrix/cody/internal/server/inbox.go

