NODE id=matrix/cody/internal/server.Server.handleWorkspacePreview kind=method
  digest=b3:455b3e5f9e5f315853fccb13cabc4873ca8bf79b2f7b8d9f764acc1b5acf9cd1 file=cody/internal/server/workspace.go range=97:131 lang=go exported=false byte_range=2789:4255
  sig=func (s *Server) handleWorkspacePreview(w http.ResponseWriter, r *http.Request)
  doc=handleWorkspacePreview is the single-action re-preview (req 7.3): POST it to\n(re)provision the project's on-demand sandbox preview. It returns 202 and the\nlifecycle unfolds on preview.pending/ready/failed events; the client renders\nthose. A run need not be active — the user can ask for a preview of the\ncurrent project state at any time.
EDGES
  ^contains=matrix/cody/internal/server.Server
  ^defines=matrix/cody/internal/server/workspace.go

NODE id=matrix/cody/internal/server.Server.handleWorkspaceRestore kind=method
  digest=b3:a2d7a59360052136b2d3b844e040b3912d0432d792b3155e1b837037ba62c244 file=cody/internal/server/workspace.go range=194:235 lang=go exported=false byte_range=6354:8054
  sig=func (s *Server) handleWorkspaceRestore(w http.ResponseWriter, r *http.Request)
  doc=handleWorkspaceRestore rolls the workspace back to a snapshot (POST). It\nREFUSES while a worker is alive on the project (req 14.1): a restore mid-run\nwould pull the ground out from under a live worker. The snapshot.restored\nevent is best-effort emitted on the addressed conversation's run.
EDGES
  ^contains=matrix/cody/internal/server.Server
  ^defines=matrix/cody/internal/server/workspace.go

