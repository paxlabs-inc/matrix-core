NODE id=matrix/cody/internal/decide.Generate kind=func
  digest=b3:1780a19e66e69b9874ad94b2cc1a4df5a67a42eb6319809de4da572a73418e61 file=cody/internal/decide/decide.go range=35:68 lang=go exported=true byte_range=1127:2234
  sig=func Generate(ctx context.Context, hot *llm.Client, system, user string, n int) ([]Candidate, error)
  doc=Generate calls the HOT client n times with the same system+user prompt;\ndivergence comes from the decision temperature the client is built at. It\nreturns the candidates in call order. n < 1 is treated as 1. An empty\n(whitespace-only) candidate is dropped — a blank generation is not an option.
EDGES
  ^defines=matrix/cody/internal/decide/decide.go

NODE id=matrix/cody/internal/decide.Judge kind=func
  digest=b3:d0e89d93824dc599744fe82aaa2e260999e5e3d6e80c311d28de0a24b0f712bb file=cody/internal/decide/decide.go range=80:119 lang=go exported=true byte_range=3072:4870
  sig=func Judge(ctx context.Context, cold *llm.Client, brief, criteria string, cands []Candidate) (Decision, error)
  doc=Judge asks the COLD client to pick the best candidate for the brief against\nthe criteria. With zero candidates it errors; with one it short-circuits to\nthat candidate (nothing to adjudicate). A judge response that cannot be\nparsed, or an out-of-range pick, fails SAFE to candidate 0 with an honest\nrationale — the decision phase must never wedge on an adjudicator hiccup (the\nproven Cassandra fail-open posture), while still having really run.
EDGES
  ^defines=matrix/cody/internal/decide/decide.go

NODE id=matrix/cody/internal/decide.ScreenDesignAntiDefault kind=func
  digest=b3:ba40537984a4afe75c1e643963d7fc5b9b7f0b61a69c21d46b339f3c43fe675e file=cody/internal/decide/design.go range=246:282 lang=go exported=true byte_range=10411:11802
  sig=func ScreenDesignAntiDefault(ctx context.Context, cold *llm.Client, rec *DesignRecord) string
  doc=ScreenDesignAntiDefault runs the anti-AI-default lens over a chosen record. It\nreturns "" when the record passes, or a concrete rejection reason. A judge\ntransport error fails OPEN (empty) — the human still resolves the record, so a\nhiccup never wedges the phase, but an explicit reject verdict is honored (the\nproven Cassandra posture).
EDGES
  ^defines=matrix/cody/internal/decide/design.go

NODE id=matrix/cody/internal/decide.ScreenDesignBanned kind=func
  digest=b3:197ad4ecf2de099c270f42dda55693ba57ab01089034261094370e4e7480a48c file=cody/internal/decide/design.go range=218:234 lang=go exported=true byte_range=8741:9361
  sig=func ScreenDesignBanned(rec *DesignRecord) string
  doc=ScreenDesignBanned runs the deterministic banned-defaults screen over a\nrecord. It returns "" when the record passes, or a concrete rejection listing\nevery banned tell it leans on.
EDGES
  ^defines=matrix/cody/internal/decide/design.go

