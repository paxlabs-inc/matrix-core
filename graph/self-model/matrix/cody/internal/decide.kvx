NODE id=matrix/cody/internal/decide.StackRecord.Validate kind=method
  digest=b3:952f06f0e508f0359124242a5be9f1a324ef31465a0eede744843cfdcdcf33b1 file=cody/internal/decide/stack.go range=60:79 lang=go exported=true byte_range=2004:2744
  sig=func (r *StackRecord) Validate() error
  doc=Validate rejects a record that could not have been a real decision: fewer\nthan two divergent candidates is not a choice, and a deviation without stated\nrationale violates doctrine (req 8.5).
