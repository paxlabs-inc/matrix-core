NODE id=matrix/cody/internal/decide.designSystem kind=func
  digest=b3:2735d150fae41c529c4d66dc6466d51a5cd95d9833bfceeec94a81b7bd8c5350 file=cody/internal/decide/design.go range=84:116 lang=go exported=false byte_range=3134:4997
  sig=func designSystem(doctrine string) string
  doc=designSystem casts the model as the design-language author. The banned-tells\nlist is stated up front so the generation itself resists the generic AI look;\nthe design-quality doctrine is injected so the record can cite it.
EDGES
  ^defines=matrix/cody/internal/decide/design.go

NODE id=matrix/cody/internal/decide.firstJSONObject kind=func
  digest=b3:7534f65c0a5bbfc75616a6117fefd80b72ea818987e05e07c1c970f3cd2a181a file=cody/internal/decide/decide.go range=135:167 lang=go exported=false byte_range=5229:5921
  sig=func firstJSONObject(s string) string
  doc=firstJSONObject returns the first balanced {...} span in s, string- and\nescape-aware, or "". (Mirrors the planner's tolerant extractor so a judge\nthat wraps its JSON in prose or fences is still read.)
EDGES
  ^defines=matrix/cody/internal/decide/decide.go

NODE id=matrix/cody/internal/decide.hasEmoji kind=func
  digest=b3:9b5c8d0066c4022ebbba174f1f806b33f94fb6e57bd46885faef5aabc2afb981 file=cody/internal/decide/design.go range=297:315 lang=go exported=false byte_range=12224:12903
  sig=func hasEmoji(s string) bool
  doc=hasEmoji reports whether s carries a pictographic emoji rune — the "emoji as\nUI chrome" tell. Covers the common emoji blocks (Misc Symbols, Dingbats,\nSupplemental Symbols, and the SMP pictograph planes) plus a couple of\nfrequently-abused standalone marks.
EDGES
  ^defines=matrix/cody/internal/decide/design.go

NODE id=matrix/cody/internal/decide.judgeSystem kind=const
  digest=b3:dc104194b9c99aec51bcef4af95c1907381f01a393595ae2edb325d0b9bb3b57 file=cody/internal/decide/decide.go range=70:78 lang=go exported=false byte_range=2236:3070
  sig=untyped string
  doc=judgeSystem casts the model as the decision adjudicator. The anti-default\nlens is explicit: a pick that would be identical regardless of the brief is\nthe failure mode this whole phase exists to prevent.
EDGES
  ^defines=matrix/cody/internal/decide/decide.go

