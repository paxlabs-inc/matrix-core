NODE id=matrix/cortex.Cortex.enforceRead kind=method
  digest=b3:7572b07d4055cab009937fbd1f1e718adadea09929dd07d3cba396290ccbc2fa file=cortex/scope_enforce.go range=79:95 lang=go exported=false byte_range=3280:3927
  sig=func (c *Cortex) enforceRead(s *scope.Scope, h *memory.Head) error
  doc=enforceRead is called per-candidate in read paths (Find / Context /\nResolveScoped). nil scope means actor-direct access — no constraint.\n\nOn scope.Allows(h)==false: journals a KindScopeViolation entry\n(best-effort; the read still returns the error so the caller\nsees the violation regardless of journal write success), and\nreturns scope.ErrViolation.
EDGES
  ^contains=matrix/cortex.Cortex
  ^defines=matrix/cortex/scope_enforce.go

NODE id=matrix/cortex.Cortex.enforceWrite kind=method
  digest=b3:75d01417a92384207ef8ddf095bfcc639e9fbaa3369ee731a4442747394dc0ab file=cortex/scope_enforce.go range=97:118 lang=go exported=false byte_range=3929:4666
  sig=func (c *Cortex) enforceWrite(s *scope.Scope, h *memory.Head) error
  doc=enforceWrite is called per-target in write paths (UpdateHead and any\nfuture scoped writes). Requires scope.Writable=true (Q7) AND\nscope.Allows on the current Head. Both failure modes journal a\nKindScopeViolation with the appropriate Reason code.
EDGES
  ^contains=matrix/cortex.Cortex
  ^defines=matrix/cortex/scope_enforce.go

