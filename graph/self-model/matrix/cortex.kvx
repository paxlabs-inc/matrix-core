  ^defines=matrix/cortex/lexical.go

NODE id=matrix/cortex.Cortex.RecallDescend kind=method
  digest=b3:16440d470b8e45d08cbe538ef8cc5efd8d3bd1ae90fd94da28403150196867df file=cortex/recall.go range=140:251 lang=go exported=true byte_range=6226:9456
  sig=func (c *Cortex) RecallDescend(query string, opts RecallOpts) (*RecallResult, error)
  doc=RecallDescend runs the recursive-recall descent described in the file\nheader (req.8.1–8.4). query is an optional narrowing phrase matched\ncase-insensitively against each leaf memory's rendered forms; empty means\n"every reachable leaf under the bounds".\n\nIt is a pure read: no journal append, no SMT write.
EDGES
  ^contains=matrix/cortex.Cortex
  ^defines=matrix/cortex/recall.go

NODE id=matrix/cortex.Cortex.RecentEpisodes kind=method
  digest=b3:9cd0f1b594f51b35cc352470f1ce24fef90e40f8ba9f7da15c78a821ff513b3b file=cortex/recent.go range=72:197 lang=go exported=true byte_range=3477:7328
  sig=func (c *Cortex) RecentEpisodes(n int, now time.Time) ([]Episode, error)
  doc=RecentEpisodes returns up to n recent episodes across all memory types,\nranked by the salience recency substrate at `now` (req.6.1), served purely\nfrom the materialized hour rollups in the default 24h horizon (req.6.2).\n\nRanking is Salience DESC, then memory ID ASC (idLess) as a stable, total\ntiebreak. Tombstoned members are skipped; a member whose head can no longer\nbe resolved (ErrNotFound) is skipped rather than erroring.
EDGES
  ^contains=matrix/cortex.Cortex
  ^defines=matrix/cortex/recent.go

NODE id=matrix/cortex.Cortex.RemoveEdge kind=method
  digest=b3:fda555392c4625ddecd1e4c60f2185ec4f86a27256f806baaa0b3ef6a90ddbf4 file=cortex/edges.go range=140:221 lang=go exported=true byte_range=4362:6727
  sig=func (c *Cortex) RemoveEdge(src memory.ID, t memory.EdgeType, dst memory.ID, reason, by string) error
  doc=RemoveEdge soft-deletes the edge at (src, t, dst). Both directional\nrecords are rewritten with Tombstoned=true; the keys remain in the\nstore so traversal callers that opt in via EdgeExpr.IncludeTombstoned\ncan audit historical adjacency.\n\nIdempotency rule: missing edge → nil (no journal); already-tombstoned\nedge → nil (no journal). This matches the Tombstone(memory) contract\nin cortex.go.
EDGES
  ^contains=matrix/cortex.Cortex
  ^defines=matrix/cortex/edges.go

NODE id=matrix/cortex.Cortex.RepairRollup kind=method
  digest=b3:95aa2cda6a1be309acdcc63e0e9e2095f7b689c85cdeaab83d0d655222f3b6fe file=cortex/repair.go range=38:62 lang=go exported=true byte_range=1750:2797
  sig=func (c *Cortex) RepairRollup(w Window, now int64) (*RollupRecord, error)
  doc=RepairRollup returns the RollupRecord for the closed window w, performing\na lazy read-repair (idempotent rebuild) when the persisted record is\nmissing or, for a coarse tier, stale relative to its current finer-tier\nchildren. Returns memory.ErrNotFound when w has no rollup and none can yet\nbe built (e.g. a coarse window whose finer-tier children have not been\nbuilt, or an hour window with no in-window journal entries).
EDGES
  ^contains=matrix/cortex.Cortex
  ^defines=matrix/cortex/repair.go

