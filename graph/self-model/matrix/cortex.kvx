NODE id=matrix/cortex.Cortex.repairCoarseRollup kind=method
  digest=b3:9527479d205a807fcf3230cb43576f2a40a45ada32f50c8c74e5a87500d8a37f file=cortex/repair.go range=83:104 lang=go exported=false byte_range=3584:4600
  sig=func (c *Cortex) repairCoarseRollup(w Window, finer RollupTier) (*RollupRecord, error)
  doc=repairCoarseRollup rebuilds the coarse-tier (day/epoch) rollup at w by\naggregating the CURRENT finer-tier rollups whose window Start falls inside\nw, via the exact same buildCoarseRollup Cascade uses (compute-compare-skip:\nunchanged children -> no write; missing or stale -> write). Returns\nmemory.ErrNotFound when w has no finer-tier children built yet.
