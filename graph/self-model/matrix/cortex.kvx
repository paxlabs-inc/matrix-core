  ^defines=matrix/cortex/activate.go

NODE id=matrix/cortex.EmbedderOptions kind=type
  digest=b3:c47393cc02801cf3e2c5205ae04d894c79db3634336d66d3642c64d70a29a9be file=cortex/embedder.go range=61:90 lang=go exported=true byte_range=2156:3506
  sig=type EmbedderOptions struct {\n	// Embedder is required. Phase 5 ships embed.NewHashEmbedder() as the\n	// default deterministic stub; production swaps in an HTTP-backed\n	// nomic-embed-text-v1.5 client.\n	Embedder	embed.Embedder\n\n	// IndexPath is the on-disk location of the HNSW graph file. If empty,\n	// the index is held in memory only (useful for tests). When non-empty\n	// and the file exists, the index is loaded; otherwise an empty index\n	// is constructed and any existing vec/meta entries are replayed into\n	// it before the worker takes new entries.\n	IndexPath	string\n\n	// HNSWParams overrides the default HNSW construction parameters. Zero\n	// values fall back to the spec §19 defaults (M=16, efC=200, efS=64).\n	// Dim is derived from Embedder.Dim().\n	HNSWParams	vector.Params\n\n	// TickInterval is how often the worker re-checks the journal head as\n	// a safety net against missed notifications. Defaults to 5 seconds.\n	// Tests can override to a small value (e.g. 50 ms) so DrainEmbedder\n	// completes quickly even without explicit notifications.\n	TickInterval	time.Duration\n\n	// Logf, if non-nil, receives one-line error / progress messages from\n	// the worker. Defaults to a no-op so library users don't get stderr\n	// spam; tests usually wire t.Logf.\n	Logf	func(format string, args ...any)\n}
  doc=EmbedderOptions configures StartEmbedder.
EDGES
  contains=matrix/cortex.EmbedderOptions#Embedder,matrix/cortex.EmbedderOptions#HNSWParams,matrix/cortex.EmbedderOptions#IndexPath,matrix/cortex.EmbedderOptions#Logf,matrix/cortex.EmbedderOptions#TickInterval
  ^defines=matrix/cortex/embedder.go

NODE id=matrix/cortex.EmbedderOptions#Embedder kind=field
  digest=b3:3920019a1e684f22f748e737ba5cc6c1b4af52f7a9e380df42e69b4f542586be file=cortex/embedder.go range=63:66 lang=go exported=true byte_range=2232:2427
  sig=embed.Embedder
  doc=Embedder is required. Phase 5 ships embed.NewHashEmbedder() as the\ndefault deterministic stub; production swaps in an HTTP-backed\nnomic-embed-text-v1.5 client.
EDGES
  ^contains=matrix/cortex.EmbedderOptions

NODE id=matrix/cortex.EmbedderOptions#HNSWParams kind=field
  digest=b3:ebf8b453cc91ac0f37d083e212426d9c0893b9a0d9c443aa95b3e40224fdec81 file=cortex/embedder.go range=75:78 lang=go exported=true byte_range=2779:2987
  sig=vector.Params
  doc=HNSWParams overrides the default HNSW construction parameters. Zero\nvalues fall back to the spec §19 defaults (M=16, efC=200, efS=64).\nDim is derived from Embedder.Dim().
