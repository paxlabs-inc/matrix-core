NODE id=matrix/cortex.Cortex.LoadRollupEnriched kind=method
  digest=b3:409d503abd0cd6e51d2b564cf0313fe453d43487fd232f737a7d5dd478ea485b file=cortex/rollup_enrich.go range=246:277 lang=go exported=true byte_range=9481:10736
