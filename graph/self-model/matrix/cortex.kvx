  sig=int64
  doc=DefaultRecentLookbackNanos is the default T1 horizon: the last 24h of hour\nrollups. RecentEpisodes surfaces members from hour rollups whose window\noverlaps [now-DefaultRecentLookbackNanos, now].
EDGES
  ^defines=matrix/cortex/recent.go

NODE id=matrix/cortex.DefaultRollupEventCountFloor kind=const
  digest=b3:a12e42ba30e9c229791a32606691a311f1697c8f61265929abe8da98ad09652e file=cortex/rollup.go range=137:140 lang=go exported=true byte_range=5566:5835
  sig=untyped int
  doc=DefaultRollupEventCountFloor is the minimum in-window journal entry count\n(KindRollup entries excluded) below which BuildRollup writes NOTHING and\nreturns ("", nil). Keeps sparse windows from producing degenerate records.
EDGES
  ^defines=matrix/cortex/rollup.go

NODE id=matrix/cortex.DefaultTimelineLookbackNanos kind=const
  digest=b3:48cc3ae627f5520e00d80e93404e9e3d9b583e0d705a8a1fbd364248b2a08630 file=cortex/activate.go range=97:104 lang=go exported=true byte_range=4673:5174
  sig=int64
  doc=DefaultTimelineLookbackNanos bounds the T0 Timeline tier to the last\nN nanoseconds of epoch rollups. Anchored to salience.HalfLifeNanos\n(90 days) — the same constant this whole system already uses to\ndefine "the recent past" via the recency substrate, so the Timeline\nhorizon and the recency decay this feature ranks everything else by\nare the same 90-day notion of "the general past", not an arbitrary\nsecond number.
EDGES
  ^defines=matrix/cortex/activate.go

