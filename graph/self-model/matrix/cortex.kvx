NODE id=matrix/cortex.Cortex.findIdxTagKey kind=method
  digest=b3:84bcdf325d4af5967ce9ca8bcf763007e4fdb113eeda1211c8ad2cd6893e2076 file=cortex/update_head.go range=403:426 lang=go exported=false byte_range=13700:14416
  sig=func (c *Cortex) findIdxTagKey(t memory.Tag, mid memory.ID) ([]byte, error)
  doc=findIdxTagKey scans idx/tag/<hash(t)>/* for the key whose id-suffix\nmatches mid. Returns nil (no error) if no key found — the prior\nHead's tags MAY include a tag whose idx entry was already\nhard-deleted by an earlier UpdateHead, so missing-on-delete is not\nfatal.
