  digest=b3:f4b14d0cfdf1a32545067af14f38455539f417b21b7d6aaf730bcf50c022fa19 file=cortex/update_head.go range=375:401 lang=go exported=false byte_range=12876:13698
  sig=func diffFrames(prev, next []memory.FrameRef) (added, removed []memory.FrameRef)
  doc=diffFrames returns (added, removed) over FrameRef equality. Two\nFrameRefs are equal iff (Verb, ObjKind, ObjRef) all match — this\nmatches the canonical CBOR equality on Head.Frames.
EDGES
  ^defines=matrix/cortex/update_head.go

NODE id=matrix/cortex.diffTags kind=func
  digest=b3:4c62ef7a01b289b550ba1c45b204db38b33802ed450c18abd385b5acf9f6254c file=cortex/update_head.go range=349:373 lang=go exported=false byte_range=12157:12874
  sig=func diffTags(prev, next []memory.Tag) (added, removed []memory.Tag)
  doc=diffTags returns (added, removed): tags in `next` but not in `prev`,\nand tags in `prev` but not in `next`. Order in the input slices is\npreserved in the output (preserves caller intent for the rare case\nof duplicates).
EDGES
  ^defines=matrix/cortex/update_head.go

