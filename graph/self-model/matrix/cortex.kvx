NODE id=matrix/cortex.New kind=func
  digest=b3:c0220f5b248a3293d9c534df41001fa7039d10208384367b41b9a93ed3c6f974 file=cortex/cortex.go range=100:118 lang=go exported=true byte_range=3853:4481
  sig=func New(s *store.Store, opts ...Option) *Cortex
  doc=New wraps an open store.Store as a Cortex. Constructs the snapshot\nState and installs its MMRHook on s so every journal entry — whether\nemitted by Cortex.Write, the async embedder, the late-binding Find\naudit, or the cortex-shell smoke commands — appends an MMR leaf in\nthe same atomic batch as the j/<seq> write.
EDGES
  ^defines=matrix/cortex/cortex.go

NODE id=matrix/cortex.Option kind=type
  digest=b3:1233a386da5241a1f54823edb2e406a2b7be5f628d62d2a1352c1db7fed089a8 file=cortex/cortex.go range=90:92 lang=go exported=true byte_range=3380:3534
  sig=type Option func(*Cortex)
  doc=Option configures a Cortex on construction. Reserved for clock and ID\ninjection in tests; production callers pass nothing.
EDGES
  ^defines=matrix/cortex/cortex.go

NODE id=matrix/cortex.ParseSessionURI kind=func
  digest=b3:9fe93f74d63a386441e6587cbe49ac9a29aefa9fe9ed9f14ba0fbfce82e0773d file=cortex/session.go range=217:244 lang=go exported=true byte_range=8503:9558
  sig=func ParseSessionURI(uri memory.URI) (conv string, seq uint64, ok bool)
  doc=ParseSessionURI parses a canonical session message URI\n(matrix://cortex/session/<conv>/<seq>) back into its (conv, seq)\ncomponents. ok is false for any string that is not a well-formed session\nmessage URI — including the /toolresult spill form (which carries a third\npath segment) and any URI whose conversation id would contain a '/'. It is\nthe inverse of BuildSessionURI and the seam the agent uses to track the\nper-turn session seq range from AppendMessage's returned URI.
EDGES
  ^defines=matrix/cortex/session.go

NODE id=matrix/cortex.ParseTier kind=func
  digest=b3:4177370b8e6cf305ec311f8b565d333b44248e2b364e01217dbbc1e16535836b file=cortex/context.go range=92:104 lang=go exported=true byte_range=3630:3989
  sig=func ParseTier(name string) (Tier, bool)
  doc=ParseTier returns the Tier for name (lower-case research/03 §2.4\nspelling). The CLI uses this to translate -include-tier flags.
EDGES
  ^defines=matrix/cortex/context.go

NODE id=matrix/cortex.ParseURI kind=func
  digest=b3:d2a4595a45c1a08142fddcde9f6346ae9ba422605125ee3f836d047a5ae3ef6c file=cortex/cortex.go range=1019:1064 lang=go exported=true byte_range=33982:35590
  sig=func ParseURI(uri memory.URI) (memory.Type, memory.ID, uint64, error)
  doc=ParseURI splits a canonical cortex URI. Format:\n\n	matrix://cortex/<Type>/<crockford-ulid>#<version>\n\nReturns ErrBadURI on any deviation. #latest is rejected; pre-resolution\n(D13) is the compiler's job.
EDGES
  ^defines=matrix/cortex/cortex.go

NODE id=matrix/cortex.RateLimits kind=type
  digest=b3:a9c04b83c3c81cfe07441bcef5aab20571e7b56130affcf15811cbb79564b61f file=cortex/ratelimit.go range=97:120 lang=go exported=true byte_range=4770:5741
  sig=type RateLimits struct {\n	// ScopeViolation caps the per-(GrantedTo, GrantedBy) rate at which\n	// cortex.logScopeViolation writes KindScopeViolation journal\n	// entries. Excess violations still return scope.ErrViolation to\n	// the caller; only the journal write (and its MMR cascade) is\n	// suppressed.\n	ScopeViolation		rate.Limit\n	ScopeViolationBurst	int\n\n	// Attest caps the per-(actor, intent_id) rate at which cortex.Attest\n	// is allowed to proceed. Excess calls return ErrAttestRateLimited\n	// without journaling anything or mutating salience.\n	Attest		rate.Limit\n	AttestBurst	int\n}
  doc=RateLimits configures the Phase 14 token buckets. Zero-value is\ninvalid — always populate via DefaultRateLimits() or\nUnlimitedRateLimits().\n\nScopeViolation / Attest are rate.Limit (events per second). Use\nrate.Inf to disable (tests only).\n\n*Burst is the token-bucket capacity. Bursts above this are dropped.\nRefill is continuous at the rate.Limit.
EDGES
  contains=matrix/cortex.RateLimits#Attest,matrix/cortex.RateLimits#AttestBurst,matrix/cortex.RateLimits#ScopeViolation,matrix/cortex.RateLimits#ScopeViolationBurst
  ^defines=matrix/cortex/ratelimit.go

