NODE id=matrix/cortex.rateLimiter.allowAttest kind=method
  digest=b3:fbc8412717d260512874ee6b26917e1e5af20403a0fc7adf35255311124bde89 file=cortex/ratelimit.go range=239:253 lang=go exported=false byte_range=9942:10508
  sig=func (r *rateLimiter) allowAttest(actor, intentID string, now time.Time) bool
  doc=allowAttest returns true iff the (actor, intentID) bucket has a\ntoken to spend at `now`. False means cortex.Attest must return\nErrAttestRateLimited without any side effects (no journal entries,\nno salience writes, no weight updates).
EDGES
  ^contains=matrix/cortex.rateLimiter
  ^defines=matrix/cortex/ratelimit.go

NODE id=matrix/cortex.rateLimiter.allowScopeViolation kind=method
  digest=b3:87d3ef6e05d3efe51c093c8b91ac1e88789a7102d103ec748924f3a7edb1b6ae file=cortex/ratelimit.go range=220:237 lang=go exported=false byte_range=9228:9940
  sig=func (r *rateLimiter) allowScopeViolation(grantedTo, grantedBy string, now time.Time) bool
  doc=allowScopeViolation returns true iff the (grantedTo, grantedBy) bucket\nhas a token to spend at `now`. False means the journal write should\nbe suppressed; the caller still returns scope.ErrViolation to its\nown caller.\n\nLazy bucket creation: first call for a key constructs the limiter at\nthe currently-configured rate.
EDGES
  ^contains=matrix/cortex.rateLimiter
  ^defines=matrix/cortex/ratelimit.go

NODE id=matrix/cortex.rateLimiter.setLimits kind=method
  digest=b3:02923afd3393350ed302a5570a37c2ca1472ab8466266ab77d70e9c2fba1986a file=cortex/ratelimit.go range=208:218 lang=go exported=false byte_range=8736:9226
  sig=func (r *rateLimiter) setLimits(rl RateLimits)
  doc=setLimits installs a new RateLimits and clears existing per-key\nbuckets so the next call recreates them at the new rate. Safe to\ncall concurrently with allow* — bucket lookups race lock-free? No,\nall access is mu-guarded; setLimits acquires mu the same as allow*.
EDGES
  ^contains=matrix/cortex.rateLimiter
  ^defines=matrix/cortex/ratelimit.go

NODE id=matrix/cortex.rateLimiter.snapshotForTests kind=method
  digest=b3:1a117de595be9bf02fe31125a90ba804f81c9f45bc998c3d8e05fc1d4e83d748 file=cortex/ratelimit.go range=255:262 lang=go exported=false byte_range=10510:10836
  sig=func (r *rateLimiter) snapshotForTests() (scopeBuckets, attestBuckets int)
  doc=snapshotForTests returns the current count of live buckets per\nsurface. Used by tests to assert that buckets are being created\n(and not leaked) across calls.
EDGES
  ^contains=matrix/cortex.rateLimiter
  ^defines=matrix/cortex/ratelimit.go

