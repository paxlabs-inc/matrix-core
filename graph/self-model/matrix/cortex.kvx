NODE id=matrix/cortex.versionValidAt kind=func
  digest=b3:dd7fd76415c297dc8636c452f6d33c2e02b286e34335a3646aa9ea3f266e6f85 file=cortex/recall.go range=415:423 lang=go exported=false byte_range=14459:14906
  sig=func versionValidAt(v *memory.Version, asOf time.Time) bool
  doc=versionValidAt reports whether v's bi-temporal valid interval + expiry\ncontain asOf. Mirrors query.withinValidity exactly (half-open\n[ValidFrom, ValidUntil); ValidFrom defaults to CreatedAt; ExpiresAt honored\nwith at/after-close semantics) so recall descent and cortex.Find agree on\n"what was true then" (req.8.3).
EDGES
  ^defines=matrix/cortex/recall.go

NODE id=matrix/cortex.windowClosed kind=func
  digest=b3:6a7cdf195d0259246e721de431a36cece8888ccd8b77e9651bbe0c15691840ba file=cortex/cascade.go range=85:88 lang=go exported=false byte_range=3966:4241
  sig=func windowClosed(w Window, now int64) bool
  doc=windowClosed reports whether w is closed as of now: a window is closed once\nits End boundary is at or before now, so its contents are final and safe to\nroll. Cascade never rolls a still-open window.
EDGES
  ^defines=matrix/cortex/cascade.go

NODE id=matrix/cortex.writeCheckpointMirror kind=func
  digest=b3:b2936d55d61dff11590aeaecfe5d2953ff0ef7c803d30be6393833dd7c23fc41 file=cortex/compact.go range=506:527 lang=go exported=false byte_range=19477:20386
  sig=func writeCheckpointMirror(path string, r *CheckpointRecord) error
  doc=writeCheckpointMirror writes a pretty-printed JSON encoding of r to\npath, creating parent directories as needed. JSON (not CBOR) is used\nbecause Andrew lock A5 framing is "for human or dev debugging = file\npath"; pretty JSON is the most readable serialization.\n\nThe file write uses 0o600 (owner read/write) because checkpoints may\ncontain references / short forms with user-private content; matches\nthe per-actor isolation principle (research/04 §1 "single Pebble DB\nper actor").
EDGES
  ^defines=matrix/cortex/compact.go

NODE id=matrix/cortex.writeMetaUint64 kind=func
  digest=b3:cbecd8763feb47b2e7d74912e0b9b1c5cef4262a916519b0966363ca3a2b2af7 file=cortex/embedder.go range=738:750 lang=go exported=false byte_range=23752:24412
  sig=func writeMetaUint64(s *store.Store, key []byte, v uint64) error
  doc=writeMetaUint64 writes v to meta/<key>. NOT wrapped in a journaled\nbatch — meta keys used here (embed_cursor, embed_vertex_next) are\nderived state, recomputable from the journal. Writing them outside the\nbatch keeps the embedder's progress note independent of any specific\ncommit.
EDGES
  ^defines=matrix/cortex/embedder.go

