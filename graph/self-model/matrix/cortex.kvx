NODE id=matrix/cortex.Cortex.buildCoarseRollup kind=method
  digest=b3:048ea682ce6b5b69723fb377e9402a24e0a5f44cc99510a4d2b7a13003d4106b file=cortex/cascade.go range=220:370 lang=go exported=false byte_range=9339:14480
  sig=func (c *Cortex) buildCoarseRollup(w Window, children []RollupRecord) (memory.URI, error)
  doc=buildCoarseRollup constructs and (idempotently) persists a coarse-tier\nRollupRecord that aggregates the given finer-resolution child rollups, in the\nderived lane (roll/ record + KindRollup journal entry, NO SMT write) — the\nSAME posture as BuildRollup. Members reference the child rollups by URI with\nRef.Kind == RefKindRollup (req.3.3).\n\nDeterminism: aggregation is a pure sum/max over the children; member ranking\nand ShortForm order the children by Salience DESC then window Start ASC — a\ntotal, stable order. No wall-now enters the stored record.\n\nIdempotence: the record is built and encoded in memory first; if an existing\nrecord at roll/<tier><start> is byte-identical, the write (and its journal\nappend) is skipped. Missing OR stale -> write. Returns the rollup URI.
EDGES
  ^contains=matrix/cortex.Cortex
  ^defines=matrix/cortex/cascade.go

NODE id=matrix/cortex.Cortex.cachedTierPinned kind=method
  digest=b3:f2dab64bd64bc52593f0d00afdde76715f4293e2a5c0699f52db946ca5fb1cba file=cortex/activate.go range=155:177 lang=go exported=false byte_range=7374:8086
  sig=func (c *Cortex) cachedTierPinned() ([]memory.ID, error)
  doc=cachedTierPinned returns the Pinned-tier candidate ID list, served from\nthe in-memory per-turn cache (cortex.go's pinnedCache* fields) when the\njournal head hasn't advanced since it was last computed, or freshly\nscanned (and cached) otherwise. See cortex.go's field doc for the full\ninvalidation rationale (req.7.2, audit NE-7).
EDGES
  ^contains=matrix/cortex.Cortex
  ^defines=matrix/cortex/activate.go

NODE id=matrix/cortex.Cortex.cascadeCoarse kind=method
  digest=b3:26d784dd3fb64f0eeb5fa4907bc9b0c2a28ba685cce2eac2f83c9edc7fe18ad4 file=cortex/cascade.go range=172:210 lang=go exported=false byte_range=7427:9037
  sig=func (c *Cortex) cascadeCoarse(finer, coarse RollupTier, now int64, bucketOf func(int64) Window) error
  doc=cascadeCoarse aggregates every finer-tier rollup into its parent coarse-tier\nwindow (bucketOf maps a child window start to its parent Window), building a\ncoarse RollupRecord for each closed parent window. Only closed parent windows\nare built. Writes are idempotent via buildCoarseRollup's compute-compare-skip.
EDGES
  ^contains=matrix/cortex.Cortex
  ^defines=matrix/cortex/cascade.go

NODE id=matrix/cortex.Cortex.cascadeHours kind=method
  digest=b3:ba237ad6a6d94ed20eadc2e8a3f6e5e31c608c66ca6b274d5b780b53605c0f24 file=cortex/cascade.go range=123:170 lang=go exported=false byte_range=5455:7425
  sig=func (c *Cortex) cascadeHours(now int64) error
  doc=cascadeHours ensures an hour rollup exists for every closed hour window that\ncarries journal entries. It collects the distinct hour-window starts that\nhave at least one non-KindRollup entry in a SINGLE journal scan, then builds\neach closed window that has no rollup yet (build-only-if-missing → zero\njournal appends when re-run over unchanged state).
EDGES
  ^contains=matrix/cortex.Cortex
  ^defines=matrix/cortex/cascade.go

