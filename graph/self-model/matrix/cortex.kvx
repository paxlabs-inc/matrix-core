NODE id=matrix/cortex.metaEmbedCursor kind=var
  digest=b3:c4f850d57390dc42ca207d1bba538b2a3247ef602e8f70e047def379b99d087e file=cortex/embedder.go range=111:120 lang=go exported=false byte_range=3990:4569
  sig=[]byte
  doc=meta keys used by the embedder. These are not journaled — they're\nderived state that can be recomputed by walking the journal forward\nfrom seq=0. Persisted only for fast restart.\n\nmetaEmbedModel records the Embedder.Model() string of the last\ncompleted pass. On StartEmbedder with a different model, the worker\nrewinds the cursor to 0 so it re-walks the journal and re-embeds every\nmemory under the new model (Q3 α-locked lazy-migrate policy, sess#19).
EDGES
  ^defines=matrix/cortex/embedder.go

