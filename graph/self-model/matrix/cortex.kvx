NODE id=matrix/cortex.Cortex.tierPinned kind=method
  digest=b3:64c51154b533659dc059c70633194c5b5ea71ae28a5505434fe0a52ef49caa4d file=cortex/context.go range=488:576 lang=go exported=false byte_range=18789:21046
