NODE id=matrix/cortex.EmbedderOptions#IndexPath kind=field
  digest=b3:8b95bfc92bf685d403ed3fc8b0074cfc4a07aa64845c745b67207b9422d9ae99 file=cortex/embedder.go range=68:73 lang=go exported=true byte_range=2430:2776
  sig=string
  doc=IndexPath is the on-disk location of the HNSW graph file. If empty,\nthe index is held in memory only (useful for tests). When non-empty\nand the file exists, the index is loaded; otherwise an empty index\nis constructed and any existing vec/meta entries are replayed into\nit before the worker takes new entries.
EDGES
  ^contains=matrix/cortex.EmbedderOptions

NODE id=matrix/cortex.EmbedderOptions#Logf kind=field
  digest=b3:976746aa5f0a0181be72276816297aecc1d542a2a5711aaf00076608a58a6859 file=cortex/embedder.go range=86:89 lang=go exported=true byte_range=3289:3504
  sig=func(format string, args ...any)
  doc=Logf, if non-nil, receives one-line error / progress messages from\nthe worker. Defaults to a no-op so library users don't get stderr\nspam; tests usually wire t.Logf.
EDGES
  ^contains=matrix/cortex.EmbedderOptions

NODE id=matrix/cortex.EmbedderOptions#TickInterval kind=field
  digest=b3:bd8dba09f7fb2ad43dd566cdd56e4e4d123397d9268fc6600f229f288936f78c file=cortex/embedder.go range=80:84 lang=go exported=true byte_range=2990:3286
