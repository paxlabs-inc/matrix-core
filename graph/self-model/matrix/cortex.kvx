NODE id=matrix/cortex.buildCoarseShortForm kind=func
  digest=b3:44bfd7a47fb64e10d3a363eaa2fd59f50861ab9d6e321b8f2f93bb20b126ff60 file=cortex/cascade.go range=372:420 lang=go exported=false byte_range=14482:16285
  sig=func buildCoarseShortForm(w Window, childCount int, entryCount uint32, kindTally, outcomeTally map[string]uint32, ranked []RollupRecord, members []Ref) string
  doc=buildCoarseShortForm renders the deterministic extractive summary for a\ncoarse rollup over its child rollups. Tallies render with alphabetically\nsorted keys and the child window range + top child refs are already in the\ndeterministic ranked order, so the output is byte-stable for the same inputs\n(req.4.2).\n\nFormat:\n\n	[<tier> <startRFC3339>..<endRFC3339>] rolled C children (N entries) spanning <childStartRFC3339>..<childEndRFC3339>; kinds: ..; outcomes: ..; children: <uri1>, <uri2>
EDGES
  ^defines=matrix/cortex/cascade.go

NODE id=matrix/cortex.buildReachableURIs kind=func
  digest=b3:bf0ec91f8cab87c2d2b437caa72aab95cab55d6f357366a996e3559c18a820c0 file=cortex/context.go range=920:940 lang=go exported=false byte_range=31718:32327
  sig=func buildReachableURIs(loaded map[memory.ID]*memory.Memory, trimmed []memory.ID) []memory.URI
  doc=buildReachableURIs converts the trimmed-but-loaded IDs into canonical\nmatrix://cortex/... URIs, capped at MaxReachableURIs to keep response\nsize bounded.
EDGES
  ^defines=matrix/cortex/context.go

NODE id=matrix/cortex.buildRollupShortForm kind=func
  digest=b3:fd539ad122dc2c751c3405b077863f257bedc564e45b309cb799e79d43b9e593 file=cortex/rollup.go range=434:461 lang=go exported=false byte_range=15324:16380
  sig=func buildRollupShortForm(w Window, entryCount uint32, kindTally, outcomeTally map[string]uint32, members []Ref) string
  doc=buildRollupShortForm renders the deterministic extractive summary. Every\ntally is rendered with alphabetically-sorted keys and the member URIs are\nalready in the deterministic (score DESC, id ASC) order, so the output is\nbyte-stable for the same inputs (req.4.2).\n\nFormat:\n\n	[<tier> <startRFC3339>..<endRFC3339>] N entries; kinds: k1=..,k2=..; outcomes: o1=..; top: <uri1>, <uri2>\n\nWhen a tally is empty it renders "(none)".
EDGES
  ^defines=matrix/cortex/rollup.go

NODE id=matrix/cortex.buildStorySoFarShortForm kind=func
  digest=b3:f5419054837f52ed9493e4afc5914cb5fcfa76b3d09f2d9b148bf51a8ce0967a file=cortex/story.go range=229:247 lang=go exported=false byte_range=8606:9539
  sig=func buildStorySoFarShortForm(conv string, upToSeq uint64, count uint32, roleTally map[string]uint32, lastUser, lastAssistant string) string
  doc=buildStorySoFarShortForm renders the deterministic extractive summary.\nRole tallies render with alphabetically sorted keys (renderTally,\nrollup.go) and the last-user/last-assistant excerpts are a fixed-prefix\nslice, so the output is byte-stable for the same transcript content\n(mirrors rollup.go's buildRollupShortForm determinism discipline).
EDGES
  ^defines=matrix/cortex/story.go

NODE id=matrix/cortex.citationsDelta kind=func
  digest=b3:32f1e63d23c35fd05227beda2fc520d09037e2609dafd1e28122bc23fb8bf8dc file=cortex/attest.go range=461:479 lang=go exported=false byte_range=18480:19103
  sig=func citationsDelta(outcome AttestOutcome, reason string) int
  doc=citationsDelta returns the §8.3 salience.Citations delta for the given\n(outcome, reason) pair.\n\n	(success, *)                                          -> +1\n	(failure, factual_error)                              -> -1\n	(failure, wrong_assumption)                           -> -1\n	(failure, any other reason or empty)                  ->  0
EDGES
  ^defines=matrix/cortex/attest.go

