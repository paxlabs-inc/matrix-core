NODE id=matrix/cortex.descentState.descend kind=method
  digest=b3:e6ce3515750f8a8ae142d187dddcd7a089c6a7d853d73d28beec7223f8365aaa file=cortex/recall.go range=271:332 lang=go exported=false byte_range=9976:11920
  sig=func (s *descentState) descend(rec *RollupRecord, depth int) ([]RecallHit, error)
  doc=descend resolves rec's member Refs at the given ladder depth. RefKindRollup\nmembers recurse one level deeper (bounded by maxDepth); RefKindMemory\nmembers are leaves — resolved, as_of-filtered, type-filtered, sub-query\nmatched, and salience-scored. Returns the leaf hits reached under rec.
EDGES
  ^contains=matrix/cortex.descentState
  ^defines=matrix/cortex/recall.go

NODE id=matrix/cortex.descentState.leaf kind=method
  digest=b3:e89dfd81ab2909d3d1597b5685614c4ada14864d5cc85e919522e334afe3ab5a file=cortex/recall.go range=334:403 lang=go exported=false byte_range=11922:14255
  sig=func (s *descentState) leaf(uri memory.URI, depth int) (RecallHit, bool, error)
  doc=leaf resolves a RefKindMemory member into a RecallHit, applying the\ntype filter, the bi-temporal as_of validity filter (req.8.3), and the\noptional sub-query substring match, and charging the per-descent token\nbudget. Returns ok=false when the member is filtered out or already seen.
EDGES
  ^contains=matrix/cortex.descentState
  ^defines=matrix/cortex/recall.go

