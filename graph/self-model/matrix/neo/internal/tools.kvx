  ^defines=matrix/neo/internal/tools/personalization.go

NODE id=matrix/neo/internal/tools.PersonalizationSchema kind=func
  digest=b3:1fa0be16ed7e99f9247b703961bf0fda053f868de2bc02073ed197176b3a666c file=neo/internal/tools/personalization.go range=34:101 lang=go exported=true byte_range=1457:4566
  sig=func PersonalizationSchema() llm.Tool
  doc=PersonalizationSchema advertises the save tool. It is NOT part of any of the\nManager's schema sets — only an interview agent appends it (req 13.3: profile\nmutations originate solely from confirmed interview output, explicit Settings\nedits, or explicit recommendation feedback).
EDGES
  ^defines=matrix/neo/internal/tools/personalization.go

NODE id=matrix/neo/internal/tools.PreviewFunc kind=type
  digest=b3:d19427d368ac5f986223da9fefa36223a4faeede9d36f52f0245c0db6c631be1 file=neo/internal/tools/tools.go range=196:203 lang=go exported=true byte_range=9353:9900
  sig=type PreviewFunc func(ctx context.Context) (string, error)
  doc=PreviewFunc launches the workbench preview for the calling run's active\nproject (the engine resolves the conversation's project tag to its workspace\nsubtree and provisions the on-demand sandbox). It returns a short\nmodel-facing status line; the lifecycle itself unfolds on the durable\npreview.pending/ready/failed events the client renders. Injected by the\nengine wiring (see internal/server); nil until wired, in which case the\npreview tool is not advertised at all.
EDGES
  ^defines=matrix/neo/internal/tools/tools.go

NODE id=matrix/neo/internal/tools.PreviewTool kind=const
  digest=b3:10708e927dfd839a98f051bb57759d32fef02479d6fc2557df5df277ce377a2a file=neo/internal/tools/tools.go range=102:107 lang=go exported=true byte_range=4915:5338
  sig=untyped string
  doc=PreviewTool is the synthetic function Neo exposes for an explicitly requested\ndevelopment sandbox. Successfully compiled frontends are delivered through\nPaxeer Cloud instead. Like todo it is NOT a real MCP server, so it never enters\nthe manifest tool-bijection check; it is advertised only when a preview\nlauncher is wired (sandbox previews configured on this daemon).
EDGES
  ^defines=matrix/neo/internal/tools/tools.go

NODE id=matrix/neo/internal/tools.RecallFunc kind=type
  digest=b3:b49819ed35d3b35671b65e511a6b2943730176c846791a0c8a8f2a9f890716cc file=neo/internal/tools/tools.go range=230:236 lang=go exported=true byte_range=11181:11706
  sig=type RecallFunc func(ctx context.Context, query string, types []string, k int, asOf *time.Time) (string, error)
  doc=RecallFunc searches the durable memory store and returns a rendered,\nuser-presentable digest. It is the PRIMARY reasoning-time retrieval verb\n(v3 #1): the model calls it iteratively with a narrowing query, an optional\ntype filter, a result cap, and an optional bi-temporal as-of instant\n(nil = now). Injected from the pager; nil until wired, in which case\nmemory_recall is not advertised at all.
EDGES
  ^defines=matrix/neo/internal/tools/tools.go

