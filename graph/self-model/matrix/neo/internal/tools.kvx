NODE id=matrix/neo/internal/tools.briefToolBaseNames kind=var
  digest=b3:3bc90bed95b359ba13e7c9fb5ad3b5340f66df7f10c0b5475c9c652aeed2bc5b file=neo/internal/tools/brief.go range=12:16 lang=go exported=false byte_range=189:539
  sig=[]string
  doc=briefToolBaseNames are the read-only information tools a morning-brief run may\nuse (ORACLE req 15.1): recent-news search, general web search, and read-only\nfetch. A tool's advertised function name is "<alias>__<name>", so membership\nis tested on the trailing base name.
EDGES
  ^defines=matrix/neo/internal/tools/brief.go

