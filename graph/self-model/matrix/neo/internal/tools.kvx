  ^defines=matrix/neo/internal/tools/tools.go

NODE id=matrix/neo/internal/tools.Manager.CaptureViewport kind=method
  digest=b3:68355c6718853e1b8a9f90c67a784cafbfa0914ba4b2ec627921bbb2a30282b0 file=neo/internal/tools/tools.go range=1308:1340 lang=go exported=true byte_range=50049:51394
  sig=func (m *Manager) CaptureViewport(ctx context.Context, sourceFunc string) string
  doc=CaptureViewport fires a viewport JPEG screenshot on the SAME browser MCP\nsession that ran sourceFunc, persists it out-of-band, and returns the /media\nURL — the deterministic, model-invisible auto-capture behind the browsing\nfilmstrip (BROWSER-FILMSTRIP req.3). It reuses the browser server the source\ncall already used (derived from the "<alias>__" prefix), so the screenshot is\nof the page the source action just produced. Returns "" when no media sink is\nwired, the browser has no screenshot tool, or capture fails — best-effort:\na screenshot failure never blocks the navigation or the turn (req.3 ac_4).
EDGES
  ^contains=matrix/neo/internal/tools.Manager
  ^defines=matrix/neo/internal/tools/tools.go

