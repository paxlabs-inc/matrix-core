  digest=b3:c2619247640b8abc564f975eef3f5a8e59506c982c2e997e229293ec29ed6c1f file=neo/internal/tools/tools.go range=351:370 lang=go exported=true byte_range=16445:17196
  sig=func (m *Manager) CallDirect(\n	ctx context.Context,\n	funcName string,\n	args map[string]interface{},\n) (DirectResult, error)
  doc=CallDirect runs a named tool through the manager's normal registry,\nvalidation, side-effect classification, and MCP transport. Product surfaces\nuse this only when the human has already selected an explicit operation; it\nis not a bypass around escalated tools.
EDGES
