NODE id=matrix/neo/internal/tools.IsBriefTool kind=func
  digest=b3:f77d69084bd8a6fc75fb1d22dbebc2fb00ccd49c49bc5e23af29cc10e2bc4e2a file=neo/internal/tools/brief.go range=18:36 lang=go exported=true byte_range=537:1097
  sig=func IsBriefTool(fn string) bool
  doc=IsBriefTool reports whether an advertised function name is one of the brief's\npositive-allowlist read-only information tools (matched on the base name after\nthe "<alias>__" prefix), OR the synthetic memory_recall tool. It is the\npredicate the brief surface is built from and asserted against.
EDGES
  ^defines=matrix/neo/internal/tools/brief.go

NODE id=matrix/neo/internal/tools.IsDesktopTool kind=func
  digest=b3:55f8f275663cf7d2564e6065702bf45ac59e4629c158ef768dee43ba135ece53 file=neo/internal/tools/automatrix.go range=61:67 lang=go exported=true byte_range=2618:2979
  sig=func IsDesktopTool(name string) bool
  doc=IsDesktopTool reports whether a function name belongs to the disposable-\ndesktop lane: the bytebotd actuation bridge (desktop__…) or the grounding\nsynthetics (desktop_look / desktop_a11y).
EDGES
  ^defines=matrix/neo/internal/tools/automatrix.go

NODE id=matrix/neo/internal/tools.IsValueTransferTool kind=func
  digest=b3:98a85c1499f20dfc171bc11aba1d5d7bd21fcbc9d5060c27f35eafd23041965a file=neo/internal/tools/automatrix.go range=45:59 lang=go exported=true byte_range=1965:2616
  sig=func IsValueTransferTool(name string) bool
  doc=IsValueTransferTool reports whether an advertised function name is a\nvalue-moving / signing tool that must never appear on an autonomous surface:\nthe synthetic core_execute money/chain delegate, any name matching\nValueTransferPatterns (send/transfer/swap/…), or any disposable-desktop lane\ntool (DOJO — a desktop can spend and log in). It is the predicate the\nAutomatrix guard asserts the advertised surface against.
EDGES
  ^defines=matrix/neo/internal/tools/automatrix.go

