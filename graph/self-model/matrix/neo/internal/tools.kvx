  digest=b3:4f4d97ecad49cb468cacb4ac58cfb0789c36db385c316f782f92b20802eb833f file=neo/internal/tools/personalization.go range=25:28 lang=go exported=true byte_range=896:1199
  sig=type PersonalizationSaveFunc func(ctx context.Context, profileJSON []byte) (string, error)
  doc=PersonalizationSaveFunc persists the confirmed profile JSON (the tool's\narguments minus the confirmation flag) as the single versioned record and\nreturns its URI. Wired by the engine onto the real pager.
