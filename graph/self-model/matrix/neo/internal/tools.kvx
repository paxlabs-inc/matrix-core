  ^defines=matrix/neo/internal/tools/tools.go

NODE id=matrix/neo/internal/tools.TodoTool kind=const
  digest=b3:34c622a634cc2944662e5feefc39301cc91559510f8b1f8efd781360c2b1605b file=neo/internal/tools/tools.go range=94:100 lang=go exported=true byte_range=4419:4913
  sig=untyped string
  doc=TodoTool is the synthetic function Neo exposes to maintain a short, ordered\ntask plan with per-item status, surfaced to the user as a live checklist that\nticks off in real time (neo-smoothness req.3). Like core_execute it is NOT a\nreal MCP server, so it never enters the manifest tool-bijection check; it is\nadvertised only to the top-level agent (a sub-agent reports through its\ndigest, not the user's checklist) and only when a todo emitter is wired.
EDGES
  ^defines=matrix/neo/internal/tools/tools.go

NODE id=matrix/neo/internal/tools.ValueTransferPatterns kind=var
  digest=b3:8a3549fe0f42fff06061cedcfacc2298ac01252d03d824cfd50a20f8f4614c81 file=neo/internal/tools/automatrix.go range=28:36 lang=go exported=true byte_range=1061:1575
  sig=[]string
  doc=ValueTransferPatterns are case-insensitive substrings of a tool's name that\nmark it as moving/committing funds or signing. The interactive Neo surface\nno longer escalates these (MCL is folded into Neo; every tool is directly\ncallable there), but AUTONOMOUS surfaces still structurally exclude them —\nthis list exists solely for that guard.
EDGES
  ^defines=matrix/neo/internal/tools/automatrix.go

NODE id=matrix/neo/internal/tools.WriteSkillFunc kind=type
  digest=b3:a174e63729a92c1645dafffc029dfb83038e39f3d303934c1c6d1744e88353ae file=neo/internal/tools/tools.go range=270:276 lang=go exported=true byte_range=13494:14044
  sig=type WriteSkillFunc func(ctx context.Context, spec memory.PatternSpec) (string, error)
  doc=WriteSkillFunc persists a reusable recipe as a Neocortex Pattern (P2-2). It\nreceives a validated PatternSpec (non-empty identity) and returns the Neocortex\nURI of the written/reinforced pattern. Injected from the pager (which calls\nReinforcePattern); nil until wired, in which case write_skill is not\nadvertised at all. The coverage starts low and is reinforced on each repeat\nsuccess, so a single authoring does not overfit (procedural.guards).
EDGES
  ^defines=matrix/neo/internal/tools/tools.go

NODE id=matrix/neo/internal/tools.WriteSkillTool kind=const
  digest=b3:9fbf11afbe8e74d856c28a1cde18c2736210123df0d9be49adaceea93f7d6353 file=neo/internal/tools/tools.go range=72:82 lang=go exported=true byte_range=3137:3924
  sig=untyped string
  doc=WriteSkillTool is the synthetic function Neo exposes for the agent to\nCONSCIOUSLY persist a reusable recipe as a Neocortex Pattern (P2-2: the\nskill-writing / synthesis loop). After a proven task, the agent authors a\nstructured PatternSpec (name, trigger, preconditions, steps, gotchas,\nsuccess_criteria) and this tool validates it and writes it to the durable\nprocedural store. The spec is validated against PatternSpec (non-empty\nidentity) before the write; coverage starts low and is reinforced on each\nrepeat success, so a single authoring does not overfit (procedural.guards).\nReadable on demand via memory_recall. Like memory_recall it is NOT a real\nMCP server, so it never enters the manifest tool-bijection check.
EDGES
  ^defines=matrix/neo/internal/tools/tools.go

