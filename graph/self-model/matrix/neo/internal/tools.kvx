  digest=b3:ca9a61bef20175c21d30ef6421a23169e8037d67f2983682c7af758637f37df2 file=neo/internal/tools/tools.go range=734:745 lang=go exported=false byte_range=30121:30598
  sig=func normalizeTodoStatus(s string) TodoStatus
  doc=normalizeTodoStatus maps the loose status strings models emit onto the three\ncanonical statuses, defaulting to pending for anything unrecognized.
