  digest=b3:e08d9087eea6a1aeda8f63a43f279d8ce78b9b8b1c7151af947b448ff7a97d52 file=neo/internal/tools/tools.go range=747:763 lang=go exported=false byte_range=30600:31150
  sig=func summarizeTodo(items []TodoItem) string
  doc=summarizeTodo renders a short, plain-language acknowledgment of the recorded\nlist for the model's tool result (the user sees the rich live checklist; this\nis the in-transcript echo).
