NODE id=matrix/neo/internal/tools.ConstructRenderTool kind=const
  digest=b3:300e50bbb1fd7ebbb0920301e8bfc0d3b1260b0e69f64d76c0e292b65186585f file=neo/internal/tools/tools.go range=63:70 lang=go exported=true byte_range=2520:3135
  sig=untyped string
  doc=ConstructRenderTool is the synthetic function Neo exposes to deliberately\nrender a Construct surface onto the user's screen — the agent-authored ACTIVE\ntier of the Construct projection engine. Neo IS the projector: it chooses one\nof the 8 frozen primitives and fills it, and the handler validates that\nchoice against the frozen schema before emitting (invariant i2 — the agent\nfills a trusted primitive, never emits arbitrary UI). Like core_execute it is\nNOT a real MCP server, so it never enters the manifest tool-bijection check.
EDGES
  ^defines=matrix/neo/internal/tools/tools.go

NODE id=matrix/neo/internal/tools.CoreExecuteTool kind=const
  digest=b3:10096d8bad268defc90fe848d76a4d67378d5b6fc39681b85cd41c79811070bf file=neo/internal/tools/tools.go range=38:40 lang=go exported=true byte_range=1087:1251
  sig=untyped string
  doc=CoreExecuteTool is the synthetic function Neo exposes for delegating\nrigorous / money-moving tasks to the MCL pipeline.
