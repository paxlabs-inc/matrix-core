NODE id=matrix/neo/internal/tools.MediaPersistFunc kind=type
  digest=b3:8b05ce5cee168076139d0a368405a728257cdc88c4e42e41835f730435727987 file=neo/internal/tools/tools.go range=160:169 lang=go exported=true byte_range=7560:8297
  sig=type MediaPersistFunc func(mimeType, base64Data string) (url string, err error)
  doc=MediaPersistFunc writes a tool-produced image (base64 payload + MIME) to the\nserved media plane and returns its /media/<id> URL. It is the seam that keeps\na screenshot's bytes OUT of the model transcript (BROWSER-FILMSTRIP req.2):\nthe URL travels out-of-band to the surfacing layer while the model-facing\ntool result stays a terse placeholder. Injected by the engine wiring (see\ninternal/server); nil until wired, in which case image bytes are simply\nsummarized to a placeholder as before (no persistence, no filmstrip). It is\nbest-effort by contract: an error is swallowed by the caller and never fails\nthe tool call or the turn.
EDGES
  ^defines=matrix/neo/internal/tools/tools.go

NODE id=matrix/neo/internal/tools.MemoryMutateTool kind=const
  digest=b3:5c5b7d65f96b90d7591293622e4c76461347aa8af8f60cd9c26d927dea36601c file=neo/internal/tools/tools.go range=49:52 lang=go exported=true byte_range=1691:1933
  sig=untyped string
  doc=MemoryMutateTool is the bounded typed write surface for user-directed\nmemory create, update, supersede, and delete operations. It replaces shell\nor curl discovery of internal memory endpoints.
EDGES
  ^defines=matrix/neo/internal/tools/tools.go

