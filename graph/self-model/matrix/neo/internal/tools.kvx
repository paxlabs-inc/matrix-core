NODE id=matrix/neo/internal/tools.Manager.AutomatrixSchemas kind=method
  digest=b3:d24eb42082e06f869a0fdd2a854d323e41be8e83212de834e2daf8ae1a8c07f0 file=neo/internal/tools/automatrix.go range=12:25 lang=go exported=true byte_range=231:1052
  sig=func (m *Manager) AutomatrixSchemas() []llm.Tool
  doc=AutomatrixSchemas is the tool surface advertised to an autonomous Automatrix\nrun. It IS the sub-agent restricted surface (the existing RestrictTools\nmechanism, SubagentSchemas): every Natural tool, but NOT the synthetic\ncore_execute money/chain delegate, memory_recall, or spawn_subagents.\n\nThis is the load-bearing structural non-financial guarantee (req.3.2): an\nAutomatrix run physically cannot reach the signing path because the money\ntool is simply absent from the advertised schema set — regardless of model\nintent or a mis-classified opportunity. Layers 1–2 (classification at\ncapture, eligible-only selection) decide WHAT runs; this layer decides what\nthe run CAN do, and money is not in the set.
EDGES
  ^contains=matrix/neo/internal/tools.Manager
  ^defines=matrix/neo/internal/tools/automatrix.go

NODE id=matrix/neo/internal/tools.Manager.BriefSchemas kind=method
  digest=b3:5f2cac81bba167854436c354321ab9a3375d7836af1b0f6aaf7a47d1707a7b39 file=neo/internal/tools/brief.go range=38:59 lang=go exported=true byte_range=1103:1997
  sig=func (m *Manager) BriefSchemas() []llm.Tool
  doc=BriefSchemas is the tool surface advertised to a morning-brief run — a POSITIVE\nallowlist tighter than the Automatrix restricted surface (req 15.1): ONLY the\nread-only information tools (web_news / web_search / fetch) plus memory_recall\nwhen wired. Financial, signing, filesystem, deployment, and\narbitrary-execution tools (including core_execute, spawn_subagents,\nconstruct_render, write_skill, preview, todo) are structurally ABSENT — they\nare simply never added to the set, regardless of model intent. Deterministic\norder.
EDGES
  ^contains=matrix/neo/internal/tools.Manager
  ^defines=matrix/neo/internal/tools/brief.go

NODE id=matrix/neo/internal/tools.Manager.CaptureViewport kind=method
  digest=b3:68355c6718853e1b8a9f90c67a784cafbfa0914ba4b2ec627921bbb2a30282b0 file=neo/internal/tools/tools.go range=527:559 lang=go exported=true byte_range=22671:24016
  sig=func (m *Manager) CaptureViewport(ctx context.Context, sourceFunc string) string
  doc=CaptureViewport fires a viewport JPEG screenshot on the SAME browser MCP\nsession that ran sourceFunc, persists it out-of-band, and returns the /media\nURL — the deterministic, model-invisible auto-capture behind the browsing\nfilmstrip (BROWSER-FILMSTRIP req.3). It reuses the browser server the source\ncall already used (derived from the "<alias>__" prefix), so the screenshot is\nof the page the source action just produced. Returns "" when no media sink is\nwired, the browser has no screenshot tool, or capture fails — best-effort:\na screenshot failure never blocks the navigation or the turn (req.3 ac_4).
EDGES
  ^contains=matrix/neo/internal/tools.Manager
  ^defines=matrix/neo/internal/tools/tools.go

NODE id=matrix/neo/internal/tools.Manager.Close kind=method
  digest=b3:d8690a051a88460ea638103ad799de4aa2d49518e770226b651ef51c1385a565 file=neo/internal/tools/tools.go range=1052:1058 lang=go exported=true byte_range=44251:44388
  sig=func (m *Manager) Close() error
  doc=Close stops every MCP server.
EDGES
  ^contains=matrix/neo/internal/tools.Manager
  ^defines=matrix/neo/internal/tools/tools.go

NODE id=matrix/neo/internal/tools.Manager.Dispatch kind=method
  digest=b3:c7281f37e49e176019567a46e7ea9959c6f5624f3f3bec2b224531beede2f2c1 file=neo/internal/tools/tools.go range=419:430 lang=go exported=true byte_range=17349:18030
  sig=func (m *Manager) Dispatch(ctx context.Context, funcName string, args map[string]interface{}) (string, bool, error)
  doc=Dispatch executes a tool call by function name.\n\nReturns (content, isError, err): err is a transport/invocation failure that\nfeeds the recovery ladder (retry/adapt); isError=true with err==nil is an\nin-band failure the model should see and adapt to; both empty err means the\ntool ran. Unknown names and escalate-guard rejections come back as\n(message, true, nil) so the model reads and corrects rather than the harness\nretrying a doomed call.
EDGES
  ^contains=matrix/neo/internal/tools.Manager
  ^defines=matrix/neo/internal/tools/tools.go

NODE id=matrix/neo/internal/tools.Manager.DispatchMedia kind=method
