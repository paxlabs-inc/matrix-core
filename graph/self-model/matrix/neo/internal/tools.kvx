NODE id=matrix/neo/internal/tools.IsValueTransferTool kind=func
  digest=b3:98a85c1499f20dfc171bc11aba1d5d7bd21fcbc9d5060c27f35eafd23041965a file=neo/internal/tools/automatrix.go range=45:59 lang=go exported=true byte_range=1969:2620
  sig=func IsValueTransferTool(name string) bool
  doc=IsValueTransferTool reports whether an advertised function name is a\nvalue-moving / signing tool that must never appear on an autonomous surface:\nthe synthetic core_execute money/chain delegate, any name matching\nValueTransferPatterns (send/transfer/swap/…), or any disposable-desktop lane\ntool (DOJO — a desktop can spend and log in). It is the predicate the\nAutomatrix guard asserts the advertised surface against.
EDGES
  ^defines=matrix/neo/internal/tools/automatrix.go

