NODE id=matrix/neo/internal/tools.Manager.dispatchAsk kind=method
  digest=b3:07ab54f68f245b2fec176318b929d77d8e3e743e59bff961dc82ddae3438f500 file=neo/internal/tools/tools.go range=915:931 lang=go exported=false byte_range=37395:38322
  sig=func (m *Manager) dispatchAsk(ctx context.Context, s *schema.Surface) (string, bool, error)
  doc=dispatchAsk emits an Ask surface and parks the tool call until the human\nanswers (or the run is cancelled / the ask expires). The human's typed\nresponse returns to the model as the tool result — an INPUT it reads and\nacts on, exactly like a user message. When no back-channel responder is\nwired (dev/CLI), the ask is still SHOWN, but the model is told it cannot\nblock and should proceed.
EDGES
  ^contains=matrix/neo/internal/tools.Manager
  ^defines=matrix/neo/internal/tools/tools.go

NODE id=matrix/neo/internal/tools.Manager.dispatchConstructRender kind=method
  digest=b3:4f5b9a2428fb7ee5fbfb1cbdcaadeaea5590698fc91eaa38cdc9218854244e14 file=neo/internal/tools/tools.go range=891:913 lang=go exported=false byte_range=36271:37393
  sig=func (m *Manager) dispatchConstructRender(ctx context.Context, args map[string]interface{}) (string, bool, error)
  doc=dispatchConstructRender is the ACTIVE-tier handler: it maps the model's\nconstruct_render arguments onto a validated Construct surface and emits it.\nA validation error is returned in-band (isError=true, err=nil) so the model\nreads it and corrects the call rather than the harness retrying.
EDGES
  ^contains=matrix/neo/internal/tools.Manager
  ^defines=matrix/neo/internal/tools/tools.go

