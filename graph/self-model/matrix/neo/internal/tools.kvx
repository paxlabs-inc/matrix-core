  ^defines=matrix/neo/internal/tools/tools.go

NODE id=matrix/neo/internal/tools.todoSchema kind=func
  digest=b3:2af6f4221446a8a00547dadd356427ce34f47789bbf1975e19766574173d949e file=neo/internal/tools/tools.go range=1065:1098 lang=go exported=false byte_range=46638:48446
  sig=func todoSchema() llm.Tool
  doc=todoSchema advertises the live task-list tool (neo-smoothness req.3). The\nmodel lays out an ordered, multi-step plan and keeps it updated as it works;\nthe user sees it as a checklist that ticks off in real time.
EDGES
  ^defines=matrix/neo/internal/tools/tools.go

