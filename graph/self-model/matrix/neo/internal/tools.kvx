NODE id=matrix/neo/internal/tools.PreviewFunc kind=type
  digest=b3:d19427d368ac5f986223da9fefa36223a4faeede9d36f52f0245c0db6c631be1 file=neo/internal/tools/tools.go range=139:146 lang=go exported=true byte_range=7081:7628
  sig=type PreviewFunc func(ctx context.Context) (string, error)
  doc=PreviewFunc launches the workbench preview for the calling run's active\nproject (the engine resolves the conversation's project tag to its workspace\nsubtree and provisions the on-demand sandbox). It returns a short\nmodel-facing status line; the lifecycle itself unfolds on the durable\npreview.pending/ready/failed events the client renders. Injected by the\nengine wiring (see internal/server); nil until wired, in which case the\npreview tool is not advertised at all.
EDGES
  ^defines=matrix/neo/internal/tools/tools.go

NODE id=matrix/neo/internal/tools.PreviewTool kind=const
  digest=b3:1432f8db108012244f523a8817a8459aec43797bd7edad1649191398f9abbd86 file=neo/internal/tools/tools.go range=90:96 lang=go exported=true byte_range=4468:4977
  sig=untyped string
  doc=PreviewTool is the synthetic function Neo exposes to launch the workbench\npreview: it provisions the active project's on-demand sandbox and the result\nsurfaces to the user in the workbench Preview pane via the durable preview.*\nevents (NEO-WORKBENCH req 7). Like todo it is NOT a real MCP server, so it\nnever enters the manifest tool-bijection check; it is advertised only when a\npreview launcher is wired (sandbox previews configured on this daemon).
EDGES
  ^defines=matrix/neo/internal/tools/tools.go

NODE id=matrix/neo/internal/tools.RecallFunc kind=type
  digest=b3:b49819ed35d3b35671b65e511a6b2943730176c846791a0c8a8f2a9f890716cc file=neo/internal/tools/tools.go range=148:154 lang=go exported=true byte_range=7630:8155
  sig=type RecallFunc func(ctx context.Context, query string, types []string, k int, asOf *time.Time) (string, error)
  doc=RecallFunc searches the durable memory store and returns a rendered,\nuser-presentable digest. It is the PRIMARY reasoning-time retrieval verb\n(v3 #1): the model calls it iteratively with a narrowing query, an optional\ntype filter, a result cap, and an optional bi-temporal as-of instant\n(nil = now). Injected from the pager; nil until wired, in which case\nmemory_recall is not advertised at all.
EDGES
  ^defines=matrix/neo/internal/tools/tools.go

NODE id=matrix/neo/internal/tools.SavePersonalizationTool kind=const
  digest=b3:4f2398eaf7fa4f5c80f2fc97e973b2d5b17cf3e2a718da721507c3ea44b52300 file=neo/internal/tools/personalization.go range=21:23 lang=go exported=true byte_range=695:898
  sig=untyped string
  doc=SavePersonalizationTool is the synthetic function an interview agent calls\nAFTER the user confirms the plain-language profile summary.
