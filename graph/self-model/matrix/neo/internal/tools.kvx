  digest=b3:67be080280b55c2014e6e9a13505f2955e135abe8cc6549a268f38d2ad150234 file=neo/internal/tools/tools.go range=114:117 lang=go exported=true byte_range=6027:6274
  sig=type TodoStatus string
  doc=TodoStatus is the lifecycle status of one task-list item. Exactly one item\nmay be TodoInProgress at a time (enforced by dispatchTodo); an item is moved\nto TodoDone the moment it is finished (not batched at the end).
