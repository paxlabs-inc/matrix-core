  ^contains=matrix/neo/internal/tools.Manager
  ^defines=matrix/neo/internal/tools/personalization.go

NODE id=matrix/neo/internal/tools.Manager.dispatchPreview kind=method
  digest=b3:f39e6d0d04128e7c8c61fab7d00934f7eede4c9b3595527c0b85b993a454bb2e file=neo/internal/tools/tools.go range=1080:1096 lang=go exported=false byte_range=43899:44646
  sig=func (m *Manager) dispatchPreview(ctx context.Context) (string, bool, error)
  doc=dispatchPreview launches the active project's sandbox preview. The launcher\nis asynchronous by contract: it kicks provisioning and returns immediately;\nreadiness (or failure) reaches the user through the preview.* events the\nworkbench renders — the model should not poll or wait for the URL.
EDGES
  ^contains=matrix/neo/internal/tools.Manager
  ^defines=matrix/neo/internal/tools/tools.go

