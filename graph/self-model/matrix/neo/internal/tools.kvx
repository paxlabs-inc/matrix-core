  ^defines=matrix/neo/internal/tools/tools.go

NODE id=matrix/neo/internal/tools.parseSubagentSpecs kind=func
  digest=b3:fb7007a8faa0b8840ff974973815591b5842f8d1cfb0f0eced1d3511e6e38ddc file=neo/internal/tools/tools.go range=578:607 lang=go exported=false byte_range=24012:24823
  sig=func parseSubagentSpecs(args map[string]interface{}) []SubagentSpec
  doc=parseSubagentSpecs reads the model's spawn_subagents arguments into specs,\ntolerating the loose JSON shapes models emit (objects vs. maps, missing\nfields). An entry with no task is dropped.
EDGES
  ^defines=matrix/neo/internal/tools/tools.go

NODE id=matrix/neo/internal/tools.parseTodoItems kind=func
  digest=b3:bdc4e33aa035e5bca9f791509f52bf40850de6eb50d6a4a96221689dd93e6797 file=neo/internal/tools/tools.go range=698:732 lang=go exported=false byte_range=29039:30119
  sig=func parseTodoItems(args map[string]interface{}) []TodoItem
  doc=parseTodoItems reads the model's todo arguments into an ordered item list,\ntolerating the loose JSON shapes models emit (text under text/title/content/\nstep, status synonyms). An entry with no text is dropped. Order is preserved.
EDGES
  ^defines=matrix/neo/internal/tools/tools.go

NODE id=matrix/neo/internal/tools.previewSchema kind=func
  digest=b3:138936c279b06b4db67ab7b3fc4dab4ecf5a28142b7742b6b47584089a878e22 file=neo/internal/tools/tools.go range=1100:1113 lang=go exported=false byte_range=48448:49464
  sig=func previewSchema() llm.Tool
  doc=previewSchema advertises the workbench preview launcher (NEO-WORKBENCH\nreq 7): fire-and-forget — provisioning is asynchronous and the user watches\nthe Preview pane, so the model calls it once when the project is runnable\nand moves on.
EDGES
  ^defines=matrix/neo/internal/tools/tools.go

