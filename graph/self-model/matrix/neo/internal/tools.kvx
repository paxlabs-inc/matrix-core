NODE id=matrix/neo/internal/tools.DesktopA11yFunc kind=type
  digest=b3:0f12d91df104a244b652c3e1a93ded6dc147f3bda49e63b82e3f96ebe5cf319d file=neo/internal/tools/tools.go range=170:174 lang=go exported=true byte_range=8763:9112
  sig=type DesktopA11yFunc func(ctx context.Context) (string, error)
  doc=DesktopA11yFunc dumps the disposable desktop's AT-SPI accessibility tree\n(DOJO req 3.3): the deterministic MIDDLE rung — roles, labels, and\nscreen-pixel coordinates with no vision model involved. Injected by the\nengine wiring; nil until a desktop session manager is wired.
EDGES
  ^defines=matrix/neo/internal/tools/tools.go

NODE id=matrix/neo/internal/tools.DesktopA11yTool kind=const
  digest=b3:fc1520d4f624c3966e058a9f34364e874368c3c88774f02238bd3cbba0bee33a file=neo/internal/tools/tools.go range=99:107 lang=go exported=true byte_range=4989:5517
  sig=untyped string
  doc=DesktopLookTool / DesktopA11yTool are the disposable-desktop grounding\nsynthetics (DOJO req 3). They are Neo-owned (they call the omni vision client\nand the AT-SPI exec through the dojo session manager), so they never enter\nthe desktop bridge's tool-bijection check; each is advertised only when the\ndesktop session manager is wired on this daemon. Like the bridge lane they\nare excluded from every autonomous surface (IsDesktopTool).
EDGES
  ^defines=matrix/neo/internal/tools/tools.go

NODE id=matrix/neo/internal/tools.DesktopLanePrefix kind=const
  digest=b3:f3b2feb8ffd0e745e4d85033c656a7658d0e179218c4599bc4f049ae76d18ccd file=neo/internal/tools/automatrix.go range=38:43 lang=go exported=true byte_range=1581:1967
  sig=untyped string
  doc=DesktopLanePrefix marks the disposable-desktop actuation lane. A desktop that\ncan log into sites and click Buy is a money/reputation surface (DOJO\nguard_surface); like the wallet lane it must never appear on an autonomous\n(Automatrix / sub-agent) surface — the desktop is human-shared, driven only\nby the top-level user-facing agent.
EDGES
  ^defines=matrix/neo/internal/tools/automatrix.go

NODE id=matrix/neo/internal/tools.DesktopLookFunc kind=type
  digest=b3:b88331f5f7f560aaf8928d1fbd2b39e33da43c2fcd120e830ba41d62aed3e13e file=neo/internal/tools/tools.go range=162:168 lang=go exported=true byte_range=8212:8761
  sig=type DesktopLookFunc func(ctx context.Context, target string) (string, error)
  doc=DesktopLookFunc grounds the disposable desktop with the stateless MiMo v2.5\nomni vision call (DOJO req 3.2): it captures the desktop, invokes omni with a\nfixed grounding prompt and the given target, and returns structured text\n(interactive elements + a best click point, coordinates already rescaled to\nscreen pixels). It is the LAST rung of the driving ladder. Injected by the\nengine wiring; nil until a desktop session manager + omni client are wired.
EDGES
  ^defines=matrix/neo/internal/tools/tools.go

