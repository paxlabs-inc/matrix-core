NODE id=matrix/neo/internal/tools.DefaultEscalatePatterns kind=var
  digest=b3:a137dadeaff95c9148c744bf4cb4c7c073eb1324d8d1297e5f426461783cf07b file=neo/internal/tools/surface.go range=30:37 lang=go exported=true byte_range=894:1434
  sig=[]string
  doc=DefaultEscalatePatterns is empty: with MCL folded into Neo, the interactive\nagent carries the full tool surface directly — every manifest tool is\nNatural and directly callable; nothing is walled behind core_execute.\nSpend policy is enforced network-side on the embedded wallet\n(PaxeerSpendPolicy / PAXEER_MAX_SPEND_WEI), not by withholding tools.\nThe autonomous (Automatrix/sub-agent) surface keeps its own explicit\nmoney-tool guard — see ValueTransferPatterns in automatrix.go.
EDGES
  ^defines=matrix/neo/internal/tools/surface.go

NODE id=matrix/neo/internal/tools.DelegateFunc kind=type
  digest=b3:f9377606bd5ce5777ef32ea9053363159939de9e9ba4759d284e78afa94ebeae file=neo/internal/tools/tools.go range=127:130 lang=go exported=true byte_range=6154:6461
