NODE id=matrix/neo/internal/tools.Manager.ReloadDynamicMCP kind=method
  digest=b3:59e576ae91a77e6a5d82e9d3641104fd69bd7fcd17bd0a4ffbfbb6ed80a8a199 file=neo/internal/tools/tools.go range=556:684 lang=go exported=true byte_range=22903:27451
  sig=func (m *Manager) ReloadDynamicMCP(ctx context.Context, servers []DynamicMCPServer) error
  doc=ReloadDynamicMCP builds a complete replacement pool before publishing it.\nA failed spawn or manifest mismatch leaves the current pool untouched. The\nserver calls this only while its global run registry is empty, so a model\nturn observes one immutable inventory from schema snapshot through dispatch.
