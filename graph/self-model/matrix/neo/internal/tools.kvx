NODE id=matrix/neo/internal/tools.Manager.Dispatch kind=method
  digest=b3:c7281f37e49e176019567a46e7ea9959c6f5624f3f3bec2b224531beede2f2c1 file=neo/internal/tools/tools.go range=900:911 lang=go exported=true byte_range=34297:34978
  sig=func (m *Manager) Dispatch(ctx context.Context, funcName string, args map[string]interface{}) (string, bool, error)
  doc=Dispatch executes a tool call by function name.\n\nReturns (content, isError, err): err is a transport/invocation failure that\nfeeds the recovery ladder (retry/adapt); isError=true with err==nil is an\nin-band failure the model should see and adapt to; both empty err means the\ntool ran. Unknown names and escalate-guard rejections come back as\n(message, true, nil) so the model reads and corrects rather than the harness\nretrying a doomed call.
EDGES
  ^contains=matrix/neo/internal/tools.Manager
  ^defines=matrix/neo/internal/tools/tools.go

NODE id=matrix/neo/internal/tools.Manager.DispatchMedia kind=method
  digest=b3:b8ed3890b32f8160d04b39e3f9f17d9f0eed85f74733da9582b3a74ab6ec0a49 file=neo/internal/tools/tools.go range=913:922 lang=go exported=true byte_range=34980:35677
  sig=func (m *Manager) DispatchMedia(ctx context.Context, funcName string, args map[string]interface{}) (content, shotURL string, isErr bool, err error)
  doc=DispatchMedia is Dispatch plus the out-of-band screenshot URL: when the tool\nreturned an image content block (e.g. browser_take_screenshot), its bytes are\npersisted to the media plane and the /media URL is returned SEPARATELY from\nthe model-facing content string — which stays a terse placeholder so the\nscreenshot never pollutes the transcript (BROWSER-FILMSTRIP req.2). shotURL is\n"" when the tool produced no image or no media sink is wired.
EDGES
  ^contains=matrix/neo/internal/tools.Manager
  ^defines=matrix/neo/internal/tools/tools.go

