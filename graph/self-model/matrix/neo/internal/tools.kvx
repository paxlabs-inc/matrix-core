  digest=b3:10096d8bad268defc90fe848d76a4d67378d5b6fc39681b85cd41c79811070bf file=neo/internal/tools/tools.go range=37:39 lang=go exported=true byte_range=1149:1313
  sig=untyped string
  doc=CoreExecuteTool is the synthetic function Neo exposes for delegating\nrigorous / money-moving tasks to the MCL pipeline.
