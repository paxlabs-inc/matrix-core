NODE id=matrix/neo/internal/tools.Manager.dispatchPersonalizationSave kind=method
  digest=b3:4eb2d82016745db5fb9ab17511d6ed188affd6116c8d31b9814be213291562bb file=neo/internal/tools/personalization.go range=103:133 lang=go exported=false byte_range=4572:5996
  sig=func (m *Manager) dispatchPersonalizationSave(ctx context.Context, args map[string]interface{}) (string, bool, error)
  doc=dispatchPersonalizationSave enforces the confirmation gate (req 12.3) and\npersists the confirmed profile through the wired writer. Refusals are\nreturned in-band (isError=true, err=nil) so the model reads the steer —\npresent the summary, get the explicit confirmation — rather than the harness\nretrying a doomed call.
EDGES
  ^contains=matrix/neo/internal/tools.Manager
  ^defines=matrix/neo/internal/tools/personalization.go

NODE id=matrix/neo/internal/tools.Manager.dispatchPreview kind=method
  digest=b3:f39e6d0d04128e7c8c61fab7d00934f7eede4c9b3595527c0b85b993a454bb2e file=neo/internal/tools/tools.go range=782:798 lang=go exported=false byte_range=31976:32723
  sig=func (m *Manager) dispatchPreview(ctx context.Context) (string, bool, error)
  doc=dispatchPreview launches the active project's sandbox preview. The launcher\nis asynchronous by contract: it kicks provisioning and returns immediately;\nreadiness (or failure) reaches the user through the preview.* events the\nworkbench renders — the model should not poll or wait for the URL.
EDGES
  ^contains=matrix/neo/internal/tools.Manager
  ^defines=matrix/neo/internal/tools/tools.go

NODE id=matrix/neo/internal/tools.Manager.dispatchSpawnSubagents kind=method
  digest=b3:6b8af04a51eb50e6c7fe114a3742b6350537ce2f96607f46ecdc76cc9cc175c1 file=neo/internal/tools/tools.go range=557:576 lang=go exported=false byte_range=23071:24010
  sig=func (m *Manager) dispatchSpawnSubagents(ctx context.Context, args map[string]interface{}) (string, bool, error)
