  digest=b3:4ecbe8dfdf01c5440e47afd3748193a38a5a0247824ac8ac1aab2316687e7a92 file=neo/internal/server/media_filmstrip.go range=56:74 lang=go exported=false byte_range=2156:2722
  sig=func extForMIME(m string) string
  doc=extForMIME maps an image MIME type to a served file extension. Screenshots are\nviewport JPEG by default (req.7.1), so an unknown/blank type falls back to\n.jpg rather than an opaque .bin the GET /media route couldn't type.
EDGES
  ^defines=matrix/neo/internal/server/media_filmstrip.go

NODE id=matrix/neo/internal/server.extForUpload kind=func
  digest=b3:9f325b3f819fd4db306463bc51e3b4e575d18675fd851b704c8a9201531a4a3b file=neo/internal/server/media.go range=98:126 lang=go exported=false byte_range=3334:4204
  sig=func extForUpload(filename, contentType string) string
  doc=extForUpload picks a safe extension from the uploaded filename, falling back\nto the declared content type, then to ".bin". Media extensions keep their\nexact form (the tools key off them); any other sane extension passes through\nso documents (.pdf, .csv, .zip, source files, …) keep their identity.
EDGES
  ^defines=matrix/neo/internal/server/media.go

