  digest=b3:09587ed9c292d62668c9089bdef131a2677842d4edc7eb1d77605c6ccabc0875 file=neo/internal/server/media.go range=43:56 lang=go exported=true byte_range=1623:2188
  sig=func MediaDir(override, cortexRoot string) string
  doc=MediaDir resolves the directory Neo serves media from / writes uploads to.\nAn explicit override wins; otherwise it derives from the Neocortex root's\nparent (the machine volume), matching how conversation.Dir derives\n/data/conversations — so generated media lands on /data/media and survives\nreload / suspend / redeploy.
