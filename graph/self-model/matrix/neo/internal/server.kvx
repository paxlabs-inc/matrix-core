NODE id=matrix/neo/internal/server.sseReporter.Delta kind=method
  digest=b3:c54f081c0d27db143714c861ca3566bed34afa9ae3477418c0d9b58369596a4f file=neo/internal/server/session.go range=1269:1294 lang=go exported=true byte_range=51829:52853
  sig=func (r *sseReporter) Delta(turn int, channel, text string)
  doc=Delta streams an incremental fragment of the CURRENT turn as it generates —\nthe live "typing" channel. channel is "content" (the visible answer being\ntyped) or "reasoning" (the live thinking). turn is the agent-loop step index\nso the client can reset its per-channel buffer when a new turn begins. It is\nNEVER persisted (the durable thread is written from Say); the authoritative\nfinal text always follows as a chat.assistant turn that the client commits.
EDGES
  ^contains=matrix/neo/internal/server.sseReporter
  ^defines=matrix/neo/internal/server/session.go

NODE id=matrix/neo/internal/server.sseReporter.Notice kind=method
  digest=b3:c7b5f375bb430ac0ed4e70fb95b8bff26a17404a912300b4c4b744cfa1780ab6 file=neo/internal/server/session.go range=1239:1246 lang=go exported=true byte_range=51029:51220
