NODE id=matrix/neo/internal/server.automatrixGovernor.Reschedule kind=method
  digest=b3:520ff2560c1d207d4856bb32f5e57766af21aef08a277b7bc5576420f124515a file=neo/internal/server/automatrix_governor.go range=143:152 lang=go exported=true byte_range=6303:6928
  sig=func (g *automatrixGovernor) Reschedule(context.Context, time.Time) error
  doc=Reschedule is the per-fire jittered next-fire hook (req 4.3). The recurring\nChronos cron alarm is the durable timing backbone and fires on its base\ncadence regardless; updating a specific next-fire instant requires a Chronos\nalarm-mutation capability the current MCP surface does not expose, so this is\na deliberate no-op here — the jitter/skip DECISION still runs in the engine\n(it just does not yet rewrite the DB's next-fire). Honest partial, tracked\nfor a follow-up once Chronos exposes an alarm-update tool.
EDGES
  ^contains=matrix/neo/internal/server.automatrixGovernor
  ^defines=matrix/neo/internal/server/automatrix_governor.go

NODE id=matrix/neo/internal/server.automatrixGovernor.SetEnabled kind=method
  digest=b3:2ed8dee80813e5d218c2d873c9c531d2987d8ec1b1f5747c4e2a23aabf2aab3e file=neo/internal/server/automatrix_governor.go range=154:188 lang=go exported=true byte_range=6930:8335
  sig=func (g *automatrixGovernor) SetEnabled(ctx context.Context, enabled bool) error
  doc=SetEnabled is the control-surface toggle (task 6.1, req 7.5): enabling creates\nexactly ONE recurring AUTOMATRIX alarm (idempotent — a second enable is a\nno-op while one already exists), disabling cancels it. The opt-in flag is\npersisted so the change takes effect on the next wake without a process\nrestart.
EDGES
  ^contains=matrix/neo/internal/server.automatrixGovernor
  ^defines=matrix/neo/internal/server/automatrix_governor.go

