  digest=b3:e14a96d50ddcade0b0b0f164cf044a93dfe14fb2f51a32b5952f7fcf78fa791b file=neo/internal/server/session.go range=951:951 lang=go exported=true byte_range=40339:40370
  sig=delegate.FailureClass
