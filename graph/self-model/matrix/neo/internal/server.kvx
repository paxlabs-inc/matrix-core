NODE id=matrix/neo/internal/server.commandQueue.Start kind=method
  digest=b3:99f637139f456f0c4a15abca76df82a795d20d94faf344cd0046b34a01f5e8ff file=neo/internal/server/queue.go range=78:92 lang=go exported=true byte_range=2738:3069
  sig=func (q *commandQueue) Start(ctx context.Context)
  doc=Start launches the single pump goroutine that serializes turns. Safe to call\nonce; subsequent calls are no-ops.
EDGES
  ^contains=matrix/neo/internal/server.commandQueue
  ^defines=matrix/neo/internal/server/queue.go

NODE id=matrix/neo/internal/server.commandQueue.Stop kind=method
  digest=b3:f78e835e1fa9577ee8959b8238c43d9b3939fa3f1f679bc7538bdcbb3be0c2d2 file=neo/internal/server/queue.go range=110:122 lang=go exported=true byte_range=3641:4060
  sig=func (q *commandQueue) Stop()
  doc=Stop supersedes the active turn: bumps the generation counter past it and\ncancels its context. When the active turn's executor returns, its result is\ndiscarded as stale (onResult is NOT called). No-op when no turn is active.
EDGES
  ^contains=matrix/neo/internal/server.commandQueue
  ^defines=matrix/neo/internal/server/queue.go

NODE id=matrix/neo/internal/server.commandQueue.drainLocked kind=method
  digest=b3:85901e7df10a257be940b7b0c14df6f5a938c25083878c94541d142f939443fb file=neo/internal/server/queue.go range=196:212 lang=go exported=false byte_range=5724:6150
  sig=func (q *commandQueue) drainLocked() string
  doc=drainLocked drains pending messages according to the queue mode. Caller must\nhold q.mu.
EDGES
  ^contains=matrix/neo/internal/server.commandQueue
  ^defines=matrix/neo/internal/server/queue.go

NODE id=matrix/neo/internal/server.commandQueue.pump kind=method
  digest=b3:a756e34819269d9888f72246a32a66b9fecc649c4c3aa1129a41498de9cfa39c file=neo/internal/server/queue.go range=150:194 lang=go exported=false byte_range=4743:5722
  sig=func (q *commandQueue) pump()
  doc=pump is the single goroutine that serializes turns. It drains pending\nmessages according to the queue mode, dispatches one at a time, and delivers\nresults only for non-stale generations.
EDGES
  ^contains=matrix/neo/internal/server.commandQueue
  ^defines=matrix/neo/internal/server/queue.go

NODE id=matrix/neo/internal/server.conciseAutomatrixResult kind=func
  digest=b3:caa5f4724f414dee0a8f70f7e27cbc84237f1f7386bc46a093c83b8579c3ee94 file=neo/internal/server/automatrix_run.go range=210:229 lang=go exported=false byte_range=9994:10697
  sig=func conciseAutomatrixResult(s string) string
  doc=conciseAutomatrixResult condenses the run's produced answer into a short,\nresult-not-protocol summary for the completion record + ping: it takes the\nfirst paragraph, collapses whitespace, and caps the length. No protocol jargon\nis introduced — the source is the agent's own user-facing answer.
EDGES
  ^defines=matrix/neo/internal/server/automatrix_run.go

NODE id=matrix/neo/internal/server.conversationDetail kind=type
  digest=b3:3f02e0507c6a3ae9adedb82b914e309b4deb7ad7202315fa4fe260911456279e file=neo/internal/server/server.go range=758:767 lang=go exported=false byte_range=37875:38386
  sig=type conversationDetail struct {\n	*conversation.Record\n	LiveRun	string	`json:"live_run"`\n}
  doc=conversationDetail is the GET /conversations/<id> wire envelope. The\nembedded *conversation.Record promotes the existing record fields\n(conversation_id, title, turns, updated) verbatim so older clients\ndeserialise identically; LiveRun is a sibling addition older clients ignore\nsafely. LiveRun is the in-flight intent_id for the conversation, or "" once\nthe run has settled (the durable resume signal).
EDGES
  contains=matrix/neo/internal/server.conversationDetail#LiveRun
  ^defines=matrix/neo/internal/server/server.go

