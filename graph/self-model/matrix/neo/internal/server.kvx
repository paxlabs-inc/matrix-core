  ^defines=matrix/neo/internal/server/automatrix_wake.go

NODE id=matrix/neo/internal/server.Engine.ResumeInProgressAutomatrix kind=method
  digest=b3:1074b0de2a5c28c17ab28ae8e6846d335f494758141398f0e906dd752d1a2a81 file=neo/internal/server/automatrix_run.go range=263:283 lang=go exported=true byte_range=12270:13127
  sig=func (e *Engine) ResumeInProgressAutomatrix() int
  doc=ResumeInProgressAutomatrix re-dispatches every opportunity left IN_PROGRESS in\nNeocortex — proactive runs that were in flight when the daemon was restarted or\nsuspended (the Task Durability Rule, req 5.1). Each resumes on the RESTRICTED\nsurface through the same dispatch path (InProgressOpportunities only returns\neligible-autonomous items, so a restart can never resume work on the money\nsurface). Called once at boot, after the normal task reaper. Best-effort;\nreturns the count resumed.
EDGES
  ^contains=matrix/neo/internal/server.Engine
  ^defines=matrix/neo/internal/server/automatrix_run.go

NODE id=matrix/neo/internal/server.Engine.ResumeInProgressBriefs kind=method
  digest=b3:bbb712cd48bed62085fae36f22b238bb7ed670c508b39ed2a324438fe62c5c4f file=neo/internal/server/brief_run.go range=253:272 lang=go exported=true byte_range=11303:12284
  sig=func (e *Engine) ResumeInProgressBriefs() int
  doc=ResumeInProgressBriefs re-dispatches every brief left running in the durable\nledger — briefs that were mid-compose when the daemon was restarted or\nsuspended (the Task Durability Rule, req 15.2). Each resumes on the RESTRICTED\nbrief surface through the same dispatch path (RunningKind returns ONLY\nKindBrief tasks, so a restart can never resume a brief on the money surface,\nand the normal reaper's Running() already excludes them). Called once at boot,\nafter the normal task reaper. Best-effort; returns the count resumed.
EDGES
  ^contains=matrix/neo/internal/server.Engine
  ^defines=matrix/neo/internal/server/brief_run.go

NODE id=matrix/neo/internal/server.Engine.ResumeOrphanedTasks kind=method
  digest=b3:aa6c0ddc2cd4a498a021d8ecda91d080765a4bf8e205785d7192072896ac0f09 file=neo/internal/server/engine.go range=554:584 lang=go exported=true byte_range=27665:28887
  sig=func (e *Engine) ResumeOrphanedTasks() int
  doc=ResumeOrphanedTasks re-dispatches every task left "running" in the durable\nledger — tasks orphaned when the daemon was restarted or Fly-suspended\nmid-work. Each resumes on its own conversation with the catch-up prime, so\nthe Task Durability Rule holds across a process death: a dropped task is\npicked back up and driven to completion rather than silently lost. Called\nonce at boot (cmd/neo serve). Best-effort + idempotent — a task that actually\nfinished is no longer "running" and is skipped, and the ledger's CAS-on-run-id\nkeeps a stale record from clobbering a live one. Returns the count resumed.
EDGES
  ^contains=matrix/neo/internal/server.Engine
  ^defines=matrix/neo/internal/server/engine.go

NODE id=matrix/neo/internal/server.Engine.RunAutomatrixOpportunity kind=method
  digest=b3:0c962fa8bb821d84f4b9d8a4e6acda086848ebbc240c4ef68d8e6717222a7242 file=neo/internal/server/automatrix_run.go range=53:84 lang=go exported=true byte_range=2442:4066
  sig=func (e *Engine) RunAutomatrixOpportunity(ctx context.Context, opp memory.OpportunitySpec) error
  doc=RunAutomatrixOpportunity is the AutomatrixRunner (wired via\nSetAutomatrixRunner). It performs the in-flight status hand-off synchronously\n(so a failure to even mark the opportunity in_progress is reported back to\nthe wake handler, which then does NOT advance the per-day counter) and then\ndispatches the supervised restricted-surface run on a background goroutine.\nA nil return means the proactive task was cleanly started.
EDGES
  ^contains=matrix/neo/internal/server.Engine
  ^defines=matrix/neo/internal/server/automatrix_run.go

NODE id=matrix/neo/internal/server.Engine.RunMorningBrief kind=method
  digest=b3:64e6b15d5d12eef5bedda36d3aa427c37744a78a56c1ae2b63d35b03353323eb file=neo/internal/server/brief_run.go range=44:54 lang=go exported=true byte_range=1915:2434
  sig=func (e *Engine) RunMorningBrief(_ context.Context, convID, localDate string) error
  doc=RunMorningBrief is the production BriefRunner. It records the brief durably in\nthe task ledger (Kind=brief, so the normal boot reaper never resumes it on the\nmoney surface) and dispatches the supervised run on a background goroutine.
EDGES
  ^contains=matrix/neo/internal/server.Engine
  ^defines=matrix/neo/internal/server/brief_run.go

