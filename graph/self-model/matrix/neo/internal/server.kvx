NODE id=matrix/neo/internal/server.Server.handleMemoryDeleteAll kind=method
  digest=b3:98f4efc0eb0e9e94886ca523a79d901e8f96f03ed854e29b810d9cc63aa3d640 file=neo/internal/server/privacy_routes.go range=89:107 lang=go exported=false byte_range=4026:5148
  sig=func (s *Server) handleMemoryDeleteAll(w http.ResponseWriter, r *http.Request)
  doc=handleMemoryDeleteAll serves DELETE /memory/delete-all. Complete erasure\nacross primary storage, MinIO versions, caches/indexes, training stores, and\na deletion receipt depends on ORACLE's cryptographic-erasure pipeline\n(spec/oracle task 4.1), which is not yet implemented (req 8.4). We refuse\nfail-closed rather than tombstone-all — a partial delete that leaves\nrecoverable copies would be a false completion of a deletion promise.
EDGES
  ^contains=matrix/neo/internal/server.Server
  ^defines=matrix/neo/internal/server/privacy_routes.go

