NODE id=matrix/neo/internal/server.swarmBackoff kind=func
  digest=b3:b37525655b417b9e61f7595b5703d6c490d0fca6c3f1d10f675c13a4fe70891a file=neo/internal/server/swarm.go range=243:258 lang=go exported=false byte_range=8607:9039
