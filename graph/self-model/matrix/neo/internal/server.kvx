NODE id=matrix/neo/internal/server.deathEntry.durableSummary kind=method
  digest=b3:534f6b24445399d65178cc67ccc31bb850613d7ed5833f3075ca61c16a22df65 file=neo/internal/server/session.go range=974:983 lang=go exported=false byte_range=41151:41676
  sig=func (e deathEntry) durableSummary() string
  doc=durableSummary renders the entry as the durable Neocortex death-journal line: the\nunchanged prefix from last session (objective, attempt, class, digest) plus\nthe agent's rich loop-state suffix (self-model task 2.2), so the record\ncarries the actual failure MODE, not just a sentence.
EDGES
  ^contains=matrix/neo/internal/server.deathEntry
  ^defines=matrix/neo/internal/server/session.go

NODE id=matrix/neo/internal/server.decideAutomatrixWake kind=func
  digest=b3:19216686268f4f801b593caccc2bce43e797245d19340991ab052a934a7ac1ba file=neo/internal/server/automatrix_wake.go range=151:180 lang=go exported=false byte_range=7739:9251
  sig=func decideAutomatrixWake(in automatrixWakeInput, rng *rand.Rand) automatrixDecision
  doc=decideAutomatrixWake is the PURE wake-decision policy. It consumes rng in a\nfixed order (jitter then skip) so any reschedule path is deterministic for a\nseeded rng regardless of which branch is taken. Order of checks matters:\nopt-out wins over everything (cancel, never run); a busy session defers; the\nper-day cap defers; a probabilistic skip defers; otherwise pick the top\neligible-pending opportunity, or resolve to idle when the queue is empty.
EDGES
  ^defines=matrix/neo/internal/server/automatrix_wake.go

