  ^contains=matrix/neo/internal/server.session
  ^defines=matrix/neo/internal/server/session.go

NODE id=matrix/neo/internal/server.session.maybeConsolidateDeaths kind=method
  digest=b3:10988ab8ea78815dc034c34e69b985087ff1f65039b6a106623caf9e2003d411 file=neo/internal/server/session.go range=756:775 lang=go exported=false byte_range=32409:33275
  sig=func (s *session) maybeConsolidateDeaths(ctx context.Context)
  doc=maybeConsolidateDeaths runs the self-authoring consolidation pass (self-model\ntask 3.2) on a bounded cadence: every cfg.DeathConsolidateEvery recorded loop\ndeaths, the agent reads its death journal and writes/reinforces durable\nhow-I-fail failure-pattern memories, then the counter resets. It runs NEVER\nevery turn (req.5.2) and is a pure observability + reasoning side-channel\n(req.5.4). Best-effort: a store error is swallowed so it can never block the\nrespawn (Task-Durability preserved). cfg.DeathConsolidateEvery <= 0 disables\nthe pass.
EDGES
  ^contains=matrix/neo/internal/server.session
  ^defines=matrix/neo/internal/server/session.go

NODE id=matrix/neo/internal/server.session.pendingAsk kind=method
  digest=b3:f6e74cf8604e03a576cb7817e5fb8d54019cb6c44ff2d0e200c95d4cf080bea2 file=neo/internal/server/session.go range=1063:1073 lang=go exported=false byte_range=44546:44881
  sig=func (s *session) pendingAsk(askID string) (*primitives.Ask, bool)
  doc=pendingAsk returns the Ask a waiter is parked on, so the receiver can\nvalidate a posted response against its contract before delivering it.
EDGES
  ^contains=matrix/neo/internal/server.session
  ^defines=matrix/neo/internal/server/session.go

NODE id=matrix/neo/internal/server.session.rebuildAgent kind=method
  digest=b3:022eb8f884512d106e10b7bd51d0247b44fe4a4880edddad6b58b737e658581e file=neo/internal/server/session.go range=171:273 lang=go exported=false byte_range=5963:11155
  sig=func (s *session) rebuildAgent()
  doc=rebuildAgent mints a FRESH agent for this conversation over a clean context\nwindow and seeds it from durable history. It runs when the session is first\nminted AND on every task-supervisor respawn: a hard failure, a stall, or a\nwedged transcript never carries into the next attempt, because the new agent\nstarts from durable TEXT history (no prior tool_calls to re-poison a strict\nprovider) plus the resume prime and the work already on the volume.
EDGES
  ^contains=matrix/neo/internal/server.session
  ^defines=matrix/neo/internal/server/session.go

NODE id=matrix/neo/internal/server.session.recordLoopDeath kind=method
  digest=b3:ffb808f30bd295362e87b2726e06f6de83835bdca64f5eae947235d7783c32d8 file=neo/internal/server/session.go range=730:754 lang=go exported=false byte_range=31147:32407
  sig=func (s *session) recordLoopDeath(ctx context.Context, objective string, attempt int, err error, failClass delegate.FailureClass)
  doc=recordLoopDeath persists a structured death-journal entry to cortex when a\nsupervised attempt died and forced a respawn — the DURABLE read path of the\ndeath journal (the immediate path is the successor's resume prime). It is\nbuilt from the shared deathEntry so it describes the SAME death the successor's\nprime folds in (req.4.3). Best-effort: a nil pager, a clean exit, or a write\nerror never blocks the respawn.
EDGES
  ^contains=matrix/neo/internal/server.session
  ^defines=matrix/neo/internal/server/session.go

