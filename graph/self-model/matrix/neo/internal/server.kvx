  ^defines=matrix/neo/internal/server/projects.go

NODE id=matrix/neo/internal/server.Engine.recordTrace kind=method
  digest=b3:ae8ce90b4b0e8532cfab4bcaac59319be255a4dc99004fe2909ab4f0a9860cef file=neo/internal/server/engine.go range=757:784 lang=go exported=false byte_range=32222:33318
  sig=func (e *Engine) recordTrace(id string, ev Event)
  doc=recordTrace is the broker tap (F3): it persists the workspace-relevant slice\nof the live event stream to the durable sidecar trace store so "Neo's\nComputer" can be rebuilt when a thread is reopened — after the run settles,\nscrolls past the 512-event broker buffer, or the topic is reclaimed. It runs\non every publish, so it stays cheap: a map lookup, then a NON-BLOCKING\nenqueue (trace.Record drops rather than blocks). It never signs, never writes\ncortex, never touches plan/walk (pure sidecar — m9/i_trace).
EDGES
  ^contains=matrix/neo/internal/server.Engine
  ^defines=matrix/neo/internal/server/engine.go

NODE id=matrix/neo/internal/server.Engine.registerRun kind=method
  digest=b3:8a16e463dda22f89af3e75dfd633e8a3f8333be274a04c5da9eddb535c70fdb4 file=neo/internal/server/engine.go range=656:662 lang=go exported=false byte_range=28533:28749
  sig=func (e *Engine) registerRun(r *run)
  doc=registerRun / lookupRun / unregisterRun index active runs so the gate-answer\nroute can find the waiting approver by run id.
EDGES
  ^contains=matrix/neo/internal/server.Engine
  ^defines=matrix/neo/internal/server/engine.go

NODE id=matrix/neo/internal/server.Engine.reqProjectRoot kind=method
  digest=b3:9fda01eef3dfc515cef63389f5f34db8c17df4983b527c1474aa7473358cb9b6 file=neo/internal/server/workspace.go range=144:156 lang=go exported=false byte_range=4718:5152
  sig=func (e *Engine) reqProjectRoot(r *http.Request) (string, error)
  doc=reqProjectRoot resolves ?project= to the project root and requires it to be\nan existing directory (writes create files, never projects).
EDGES
  ^contains=matrix/neo/internal/server.Engine
  ^defines=matrix/neo/internal/server/workspace.go

NODE id=matrix/neo/internal/server.Engine.resolveProjectRecord kind=method
  digest=b3:d26afcda7b200e24604369c1e420841b9372dd01fd18d087c025e1d1cd0a970d file=neo/internal/server/projects.go range=159:182 lang=go exported=false byte_range=4190:4929
  sig=func (e *Engine) resolveProjectRecord(id string) (project, error)
  doc=resolveProjectRecord resolves a project id; empty / "default" synthesizes\nthe bare workspace-root project.
EDGES
  ^contains=matrix/neo/internal/server.Engine
  ^defines=matrix/neo/internal/server/projects.go

NODE id=matrix/neo/internal/server.Engine.respondAsk kind=method
  digest=b3:6c2188394c60a10d47534faaa544abcebfb806c8ba0e92e0003e4f9a63a89ac3 file=neo/internal/server/engine.go range=477:534 lang=go exported=false byte_range=21849:24279
  sig=func (e *Engine) respondAsk(ctx context.Context, s *schema.Surface) (*primitives.AskResponse, error)
  doc=respondAsk is the ACTIVE-tier Construct back-channel (invariant i5): it shows\nan Ask surface, PARKS the agent's construct_render tool call on a per-ask\nwaiter keyed by the surface id, and returns the human's typed response once\nit is posted to /intents/{id}/asks/{ask_id}/answer. It mirrors approverFor\n(the in-walk gate) exactly — register the waiter FIRST so a fast answer can't\nrace the park, then emit; on answer, patch the Ask surface to its settled\nstate so the rendered control resolves. Pure side-channel: it publishes\ntranscript events and returns the answer as a tool result (an agent INPUT);\nit never signs, writes cortex, or touches the plan/walk.
EDGES
  ^contains=matrix/neo/internal/server.Engine
  ^defines=matrix/neo/internal/server/engine.go

NODE id=matrix/neo/internal/server.Engine.runOneSubagent kind=method
  digest=b3:36a2c6135517b49134743067d880b4f0c6d086617eb8a06cb79f39258950a6c3 file=neo/internal/server/swarm.go range=145:231 lang=go exported=false byte_range=4974:7980
  sig=func (e *Engine) runOneSubagent(ctx context.Context, r *run, swarmID string, index int, spec tools.SubagentSpec, selfModel string) subResult
  doc=runOneSubagent builds and runs a single headless sub-agent to completion,\nstreaming its workspace activity onto the parent stream tagged with its\nindex, and returns its distilled report. A hard failure with no usable output\nis retried with a fresh window (bounded by subagentMaxAttempts) so a\ntransient provider error doesn't kill the sub-agent outright.
EDGES
  ^contains=matrix/neo/internal/server.Engine
  ^defines=matrix/neo/internal/server/swarm.go

NODE id=matrix/neo/internal/server.Engine.runSwarm kind=method
  digest=b3:3222ebde754a43475d958ef49befcf5e0f55d37c1909ef3efbe6e98f5abe7f22 file=neo/internal/server/swarm.go range=55:143 lang=go exported=false byte_range=1709:4972
  sig=func (e *Engine) runSwarm(ctx context.Context, specs []tools.SubagentSpec) (string, error)
  doc=runSwarm is the SwarmFunc wired into the tool manager. It fans a set of\ntask-scoped sub-agents out to run CONCURRENTLY — each its own headless agent\nloop over a fresh, isolated context window with the restricted (full Natural,\nno money, no recursion) tool surface — streams their progress onto the parent\nconversation's event stream as a live Agent Swarm, and returns an aggregated,\nmodel-readable digest of their findings. Heavy tool work stays in the\nsub-agents' windows; only the distilled results return to the parent's.
EDGES
  ^contains=matrix/neo/internal/server.Engine
  ^defines=matrix/neo/internal/server/swarm.go

NODE id=matrix/neo/internal/server.Engine.settleApprovedOpportunity kind=method
  digest=b3:f65911dc4102d84d13338c34e697d78152d4a5c862eaa76d305ba160c06ed712 file=neo/internal/server/automatrix_routes.go range=310:337 lang=go exported=false byte_range=13064:14427
  sig=func (e *Engine) settleApprovedOpportunity(opp memory.OpportunitySpec, convID string, status task.Status)
  doc=settleApprovedOpportunity records the terminal outcome of an approved\n(user-initiated, gated) opportunity run — the sibling of\nsettleAutomatrixOpportunity for the approve path. A genuine completion marks\nthe opportunity done and writes the durable completion record + ping (the\nDone inbox); an interrupted run returns it to pending untouched (the user\nstopped it on purpose — no attempts penalty); any other terminal re-pends it\nwith attempts++ (bounded, dismissed at the ceiling).
EDGES
  ^contains=matrix/neo/internal/server.Engine
  ^defines=matrix/neo/internal/server/automatrix_routes.go

NODE id=matrix/neo/internal/server.Engine.settleAutomatrixOpportunity kind=method
  digest=b3:18195563ffa8e9344ce38888e07a48f610f3fee73b92aaa4d93dd73388b2347f file=neo/internal/server/automatrix_run.go range=125:151 lang=go exported=false byte_range=5786:7312
  sig=func (e *Engine) settleAutomatrixOpportunity(ctx context.Context, opp memory.OpportunitySpec, convID string, status task.Status, resultSummary string)
  doc=settleAutomatrixOpportunity records the run's terminal outcome on the\nopportunity (req 5.5). A genuine completion-gate pass marks it done AND\nannounces the result out of band (task 5.3); any other terminal (an honest\npartial at the ceiling, a deterministic blocker) leaves it re-pended with\nattempts++ (bounded; dismissed at the ceiling) for a later wake to retry —\nand surfaces NOTHING to the user (req 5.5/8.3: a non-completed task is never\nannounced). convID is the conversation the run executed in (origin thread, or\na synthetic one); resultSummary is the agent's captured final answer.
EDGES
  ^contains=matrix/neo/internal/server.Engine
  ^defines=matrix/neo/internal/server/automatrix_run.go

NODE id=matrix/neo/internal/server.Engine.startMediaGC kind=method
  digest=b3:4960756ae3d07fb8fcdc936c1ea680800c4499c24b53f4ef2d2fca6f8a7ad3ef file=neo/internal/server/media_filmstrip.go range=76:92 lang=go exported=false byte_range=2724:3282
  sig=func (e *Engine) startMediaGC()
  doc=startMediaGC bounds media growth on the volume (req.7.2): a boot sweep plus a\nperiodic ticker delete media files older than the retention window (parallel\nto the trace retain cap). A no-op when no media dir is configured or retention\nis disabled (0), keeping the process byte-identical to the pre-feature image.
EDGES
  ^contains=matrix/neo/internal/server.Engine
  ^defines=matrix/neo/internal/server/media_filmstrip.go

NODE id=matrix/neo/internal/server.Engine.subagentSelfModelBrief kind=method
  digest=b3:9ac387477520a5db22aef392f4bbd6d3afe4d0c3affc3b93b3e84108ea3f3095 file=neo/internal/server/swarm.go range=296:337 lang=go exported=false byte_range=10370:11715
  sig=func (e *Engine) subagentSelfModelBrief(ctx context.Context) string
  doc=subagentSelfModelBrief renders the shared self-model each sub-agent inherits\nat spawn (self-model task 4.3, req.9.1): the structural self-summary (how the\nagent is built) plus the most salient how-I-fail patterns (what to avoid). It\nis resolved once per swarm from the shared cortex pager. Returns "" when no\npager is wired or the self-model is empty (a fresh install before the\nself-graph is loaded) — the sub-agent then runs on its persona + bounds alone,\nnever blocked on the self-model.
EDGES
  ^contains=matrix/neo/internal/server.Engine
  ^defines=matrix/neo/internal/server/swarm.go

NODE id=matrix/neo/internal/server.Engine.surfaceSubagentStep kind=method
  digest=b3:693908ae6fafeb2f7623e7fc7d1bd3b1dfe72a2b09488c1271cf95b9a97e84d3 file=neo/internal/server/swarm.go range=260:274 lang=go exported=false byte_range=9041:9632
  sig=func (e *Engine) surfaceSubagentStep(r *run, swarmID string, index int, name string, ev agent.ToolEvent)
  doc=surfaceSubagentStep mirrors surfaceTool for a sub-agent: the same animated\nworkspace step (terminal / browser / editor / …), tagged with the swarm +\nagent index so the client routes it into that sub-agent's own window.
EDGES
  ^contains=matrix/neo/internal/server.Engine
  ^defines=matrix/neo/internal/server/swarm.go

NODE id=matrix/neo/internal/server.Engine.surfaceTool kind=method
  digest=b3:041f9e15451f88a27919c82a74e9aa29e56c27d5e7874689fb41b89708d10cf8 file=neo/internal/server/engine.go range=850:936 lang=go exported=false byte_range=36122:39716
  sig=func (e *Engine) surfaceTool(r *run, ev agent.ToolEvent)
  doc=surfaceTool turns a tool call into the live "Neo Workspace" — a single\n`tool.step` event the client renders as an ANIMATED VIEWPORT of the action\nitself: a terminal when Neo runs a command, a browser window when it\nbrowses, an editor when it reads/writes files. The same step id is updated\nfrom running→done across the start/end pair, so the viewport fills in place\nrather than appending a new card. Web-search results and generated media ALSO\nkeep their dedicated rich events (cards / media grid) on completion.
EDGES
  ^contains=matrix/neo/internal/server.Engine
  ^defines=matrix/neo/internal/server/engine.go

NODE id=matrix/neo/internal/server.Engine.sweepMedia kind=method
  digest=b3:86be59b2e88b2ce49487eee3f7dd6de5cd6a05b9024c478977a26ebb9fb32143 file=neo/internal/server/media_filmstrip.go range=94:119 lang=go exported=false byte_range=3284:3982
  sig=func (e *Engine) sweepMedia()
  doc=sweepMedia removes served media files whose mtime is older than the retention\nwindow. Best-effort per file: a stat/remove error on one file never aborts the\nsweep. Directories are skipped (the media dir is flat).
EDGES
  ^contains=matrix/neo/internal/server.Engine
  ^defines=matrix/neo/internal/server/media_filmstrip.go

NODE id=matrix/neo/internal/server.Engine.unregisterRun kind=method
  digest=b3:79f462312d69958673343433dc8d6212c4ad193de83f455dd6de3b64139d3a89 file=neo/internal/server/engine.go range=691:700 lang=go exported=false byte_range=29645:29877
  sig=func (e *Engine) unregisterRun(id string)
