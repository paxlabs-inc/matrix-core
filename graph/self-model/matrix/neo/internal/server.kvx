  sig=func (e *Engine) MaybeHandleImprovementWake(ctx context.Context, message string) bool
EDGES
  ^contains=matrix/neo/internal/server.Engine
  ^defines=matrix/neo/internal/server/improvement.go

NODE id=matrix/neo/internal/server.Engine.MaybeHandleMorningBriefWake kind=method
  digest=b3:b60a15472f132138e8f3c926ec4fe2d8231d4836175a86f818a451c07dfc56df file=neo/internal/server/brief_wake.go range=57:69 lang=go exported=true byte_range=2712:3356
  sig=func (e *Engine) MaybeHandleMorningBriefWake(ctx context.Context, convID, message string) bool
  doc=MaybeHandleMorningBriefWake intercepts a Chronos MORNING_BRIEF wake delivered\nover POST /chat. It returns true iff the message is a MORNING_BRIEF wake (so\nthe caller must NOT dispatch it as a normal user turn): the wake produces no\nlive conversational run of its own — the brief is composed out of band by the\nrunner and delivered durably (task 5.4). A non-wake message returns false and\nis left for the normal /chat path.
EDGES
  ^contains=matrix/neo/internal/server.Engine
  ^defines=matrix/neo/internal/server/brief_wake.go

NODE id=matrix/neo/internal/server.Engine.ReconcileAutomatrix kind=method
