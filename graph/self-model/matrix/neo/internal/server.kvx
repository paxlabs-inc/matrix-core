NODE id=matrix/neo/internal/server.buildBriefCron kind=func
  digest=b3:18bd77cd8e277270d482cf0c4ddca838126d73ff21c9d52bbb6e39c765bf7023 file=neo/internal/server/brief_governor.go range=191:208 lang=go exported=false byte_range=7143:7988
  sig=func buildBriefCron(deliveryTime string, days []int) (string, error)
  doc=buildBriefCron renders the standard 5-field cron ("M H * * DOW") for a local\ndelivery time (HH:MM) and weekday set (0=Sun..6=Sat; empty/full = every day).\nMirrors chronos/internal/morningbrief.CronExpr so the neo-side alarm request\nand the chronos-side convention agree byte-for-byte.
EDGES
  ^defines=matrix/neo/internal/server/brief_governor.go

NODE id=matrix/neo/internal/server.buildBriefObjective kind=func
  digest=b3:2f6ced63fa103ecb1d84222ff418412ed8835a1eddb8da2c680b9f4a703a4ae2 file=neo/internal/server/brief_run.go range=199:227 lang=go exported=false byte_range=8572:10610
  sig=func buildBriefObjective(st briefSettingsState, profile string, noRepeatRecs, noRepeatURLs []string) string
  doc=buildBriefObjective composes the run's working objective — the instruction the\nrestricted brief agent executes. It is result-not-protocol (plain task framing\nwith no Chronos/alarm/marker jargon) and encodes the invariants task 5.4 owns\n(autonomous run, user away, ONE self-contained written brief, FRESH in-run\nretrieval, no questions back) plus the task 5.5 layers: the confirmed\npersonalization profile and the content policy with the durable no-repeat set.
EDGES
  ^defines=matrix/neo/internal/server/brief_run.go

