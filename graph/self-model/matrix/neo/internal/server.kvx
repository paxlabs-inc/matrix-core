NODE id=matrix/neo/internal/server.Engine.warmBody kind=method
  digest=b3:7659f1c76c9e889af5c0f0d2d13c33e46d890ad957f3f59d2e01a766c6df6215 file=neo/internal/server/engine.go range=777:789 lang=go exported=false byte_range=34635:35240
  sig=func (e *Engine) warmBody(ctx context.Context)
  doc=warmBody performs the actual substrate warm synchronously: one relevance\nretrieval that loads the embedding model + opens the HNSW index. The result\nis discarded — the point is the side effect of spinning up the cold path.\nSplit out from Warm so tests can exercise it deterministically without the\nonce/goroutine wrapper. Best-effort: any error is swallowed (a failed warm\njust means the first real recall pays what it would have anyway).
EDGES
  ^contains=matrix/neo/internal/server.Engine
  ^defines=matrix/neo/internal/server/engine.go

NODE id=matrix/neo/internal/server.EngineOptions kind=type
  digest=b3:d17d633150473d4cbb67d5572f2e842bcbb355d57282f151c4ea42743c5a73cd file=neo/internal/server/engine.go range=248:293 lang=go exported=true byte_range=11626:15371
  sig=type EngineOptions struct {\n	Config			config.Config\n	Main			*llm.Client\n	Cheap			*llm.Client\n	SubMain			*llm.Client	// main-capability model, thinking OFF, for background sub-agents (nil falls back to Main)\n	Tools			*tools.Manager\n	Pager			*memory.Pager\n	Runtime			*agent.ResurrectionRuntime\n	Consolidator		agent.Consolidator\n	ConversationDir		string	// durable conversation store dir ("" disables persistence)\n	TaskDir			string	// durable task-ledger dir ("" disables; reaper needs it to resume after restart)\n	RunDir			string\n	Journal			*sessionjournal.Store\n	TraceDir		string	// durable workspace-trace dir ("" disables; the reopen-survives-reload store, F3)\n	AutomatrixDir		string	// durable Automatrix completion-inbox dir ("" disables; the in-app surprise-results store)\n	AutomatrixSettingsDir	string	// durable Automatrix opt-in settings dir ("" = in-memory only; wiring the production governor)\n	BriefSettingsDir	string	// durable morning-brief schedule sidecar dir ("" = in-memory only; wiring the production brief governor)\n	BriefHistoryDir		string	// durable morning-brief recommendation-history dir ("" disables; the no-repeat + feedback store)\n	CapabilityDir		string	// durable private Capability Hub dir ("" disables the optional subsystem)\n	CapabilityLibraryDir	string	// trusted read-only Centra AI skill corpus used by library imports\n	ImprovementDir		string	// sealed verified-improvement observations and proposals (empty disables)\n	MCPControlDir		string	// encrypted, versioned MCP configuration and OAuth control plane\n	ChannelGatewayDir	string	// durable normalized channel identities, idempotency, and delivery receipts\n	CloudChannelDir		string	// encrypted Slack and Discord connection state ("" disables cloud adapters)\n	TelegramSettingsDir	string	// encrypted per-user Telegram bot/channel state ("" disables the integration)\n	MachineMailSettingsDir	string	// encrypted per-user MachineMail API key ("" disables the integration)\n	MediaDir		string	// machine-volume media dir ("" disables image/video/audio I/O)\n	BuildDir		string	// sealed durable asynchronous coding Build jobs ("" disables Build)\n	NovitaAPIKey		string\n	VoiceASRURL		string\n	VoiceASRKey		string\n	VoiceControllerURL	string\n	WorkspaceDir		string			// VM workspace root for the coding workbench ("" disables /workspace and /projects)\n	Sandbox			sandbox.Client		// Railway sandbox client for previews (nil disables /workspace/preview)\n	PreviewCfg		preview.Config		// preview controller config (user id, router door, TTL, image, cap)\n	DojoRailway		dojo.RailwayClient	// live-schema Railway sandbox client for dojo desktops (nil disables the dojo lane)\n	DojoCfg			dojo.Config		// dojo session manager config (pinned image, idle/lifetime caps)\n	Omni			*llm.Client		// stateless MiMo v2.5 omni vision client for desktop_look grounding (nil disables desktop_look)\n	DojoBridgeToken		string			// shared secret gating the loopback /dojo/computer-use proxy the desktop bridge posts to ("" disables the proxy)\n	BackendURL		string\n	BackendToken		string\n	ProfilePath		string\n	Vault			*vault.Session	// fail-closed encryption session for data-at-rest ("" nil = plaintext dev/CLI)\n}
  doc=EngineOptions configures NewEngine. Main + Tools are required; the rest are\noptional (a nil pager/consolidator degrades gracefully).
EDGES
  contains=matrix/neo/internal/server.EngineOptions#AutomatrixDir,matrix/neo/internal/server.EngineOptions#AutomatrixSettingsDir,matrix/neo/internal/server.EngineOptions#BackendToken,matrix/neo/internal/server.EngineOptions#BackendURL,matrix/neo/internal/server.EngineOptions#BriefHistoryDir,matrix/neo/internal/server.EngineOptions#BriefSettingsDir,matrix/neo/internal/server.EngineOptions#BuildDir,matrix/neo/internal/server.EngineOptions#CapabilityDir,matrix/neo/internal/server.EngineOptions#CapabilityLibraryDir,matrix/neo/internal/server.EngineOptions#ChannelGatewayDir,matrix/neo/internal/server.EngineOptions#Cheap,matrix/neo/internal/server.EngineOptions#CloudChannelDir,matrix/neo/internal/server.EngineOptions#Config,matrix/neo/internal/server.EngineOptions#Consolidator,matrix/neo/internal/server.EngineOptions#ConversationDir,matrix/neo/internal/server.EngineOptions#DojoBridgeToken,matrix/neo/internal/server.EngineOptions#DojoCfg,matrix/neo/internal/server.EngineOptions#DojoRailway,matrix/neo/internal/server.EngineOptions#ImprovementDir,matrix/neo/internal/server.EngineOptions#Journal,matrix/neo/internal/server.EngineOptions#MCPControlDir,matrix/neo/internal/server.EngineOptions#MachineMailSettingsDir,matrix/neo/internal/server.EngineOptions#Main,matrix/neo/internal/server.EngineOptions#MediaDir,matrix/neo/internal/server.EngineOptions#NovitaAPIKey,matrix/neo/internal/server.EngineOptions#Omni,matrix/neo/internal/server.EngineOptions#Pager,matrix/neo/internal/server.EngineOptions#PreviewCfg,matrix/neo/internal/server.EngineOptions#ProfilePath,matrix/neo/internal/server.EngineOptions#RunDir,matrix/neo/internal/server.EngineOptions#Runtime,matrix/neo/internal/server.EngineOptions#Sandbox,matrix/neo/internal/server.EngineOptions#SubMain,matrix/neo/internal/server.EngineOptions#TaskDir,matrix/neo/internal/server.EngineOptions#TelegramSettingsDir,matrix/neo/internal/server.EngineOptions#Tools,matrix/neo/internal/server.EngineOptions#TraceDir,matrix/neo/internal/server.E