NODE id=matrix/neo/internal/server.Engine.sealMediaBytes kind=method
  digest=b3:efde1def3faa7c298380545497175e3e9b3e839d2aea643cc67b21137b922f24 file=neo/internal/server/media_vault.go range=56:71 lang=go exported=false byte_range=1853:2359
  sig=func (e *Engine) sealMediaBytes(name string, data []byte, dst io.Writer) error
  doc=sealMediaBytes seals a whole in-memory media payload (screenshot persist)\nas a chunked stream so GET /media serves it without buffering.
