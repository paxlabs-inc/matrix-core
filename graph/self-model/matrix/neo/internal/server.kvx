NODE id=matrix/neo/internal/server.profileRefreshTTL kind=const
  digest=b3:31b033a726a60c5d207365117126da0e50383c303e21cee20e6c4f5b1b8275f6 file=neo/internal/server/engine.go range=1526:1531 lang=go exported=false byte_range=62882:63300
  sig=time.Duration
  doc=profileRefreshTTL bounds how long a fetched profile is reused before a\nsession rebuild re-fetches it. Short enough that a Settings edit (req 8.2)\nreflects on the next conversation/respawn; long enough that a burst of\nrespawns doesn't hammer the daemon. A failed fetch also stamps the clock,\nso an unreachable daemon backs off instead of retrying every rebuild.
EDGES
  ^defines=matrix/neo/internal/server/engine.go

