NODE id=matrix/neo/internal/server.session.interruptActive kind=method
  digest=b3:b750f8a9e0076051dbd3b105d8931b2cfd7a06440f8af4e222411887301c7524 file=neo/internal/server/session.go range=1347:1358 lang=go exported=false byte_range=57665:57934
  sig=func (s *session) interruptActive() string
  doc=interruptActive stops the latest dispatched turn (if any). Returns its id, or\n"" when nothing was in flight.
EDGES
  ^contains=matrix/neo/internal/server.session
  ^defines=matrix/neo/internal/server/session.go

NODE id=matrix/neo/internal/server.session.pendingAsk kind=method
  digest=b3:f6e74cf8604e03a576cb7817e5fb8d54019cb6c44ff2d0e200c95d4cf080bea2 file=neo/internal/server/session.go range=1474:1484 lang=go exported=false byte_range=61105:61440
  sig=func (s *session) pendingAsk(askID string) (*primitives.Ask, bool)
  doc=pendingAsk returns the Ask a waiter is parked on, so the receiver can\nvalidate a posted response against its contract before delivering it.
EDGES
  ^contains=matrix/neo/internal/server.session
  ^defines=matrix/neo/internal/server/session.go

NODE id=matrix/neo/internal/server.session.progressMessage kind=method
  digest=b3:95503cfc1889dd4a78f9928199fc3209f52d13566d6c1f2b1571ea38a1d77452 file=neo/internal/server/session.go range=1052:1069 lang=go exported=false byte_range=44884:45895
  sig=func (s *session) progressMessage(r *run) string
  doc=progressMessage builds a SUBSTANTIVE still-working update (item 6b): instead of\na contentless "hit a snag, taking another run", it tells the user where things\nactually stand — the agent's honest best-effort digest so far, clipped — then\nthat it is continuing from there. When that digest IS the message already on\nscreen it references it rather than re-pasting (the double-render), and when\nthere is nothing concrete yet it falls back to a plain, honest line. This is\nhow a peer reports progress: what's done, and what's next.
EDGES
  ^contains=matrix/neo/internal/server.session
  ^defines=matrix/neo/internal/server/session.go

NODE id=matrix/neo/internal/server.session.rebuildAgent kind=method
  digest=b3:e40a28b6461fc31e1a2367f8f4104d35604aa1b4f18ae5e0919950eeaa072a00 file=neo/internal/server/session.go range=188:337 lang=go exported=false byte_range=6727:14213
  sig=func (s *session) rebuildAgent()
  doc=rebuildAgent mints a FRESH agent for this conversation over a clean context\nwindow and seeds it from durable history. It runs when the session is first\nminted AND on every task-supervisor respawn: a hard failure, a stall, or a\nwedged transcript never carries into the next attempt, because the new agent\nstarts from the exact session journal when enabled, with the text-only\nconversation store retained as a degraded fallback.
EDGES
  ^contains=matrix/neo/internal/server.session
  ^defines=matrix/neo/internal/server/session.go

NODE id=matrix/neo/internal/server.session.recordLoopDeath kind=method
  digest=b3:a561c2c8cba135c10877e608ad2183e2f094b9eb1584665fbc34328ca1112173 file=neo/internal/server/session.go range=985:1008 lang=go exported=false byte_range=41678:42924
  sig=func (s *session) recordLoopDeath(ctx context.Context, intentID, objective string, attempt int, err error, failClass delegate.FailureClass)
  doc=recordLoopDeath persists a structured death-journal entry to Neocortex when a\nsupervised attempt died and forced a respawn — the DURABLE read path of the\ndeath journal (the immediate path is the successor's resume prime). It is\nbuilt from the shared deathEntry so it describes the SAME death the successor's\nprime folds in (req.4.3). Best-effort: a nil pager, a clean exit, or a write\nerror never blocks the respawn.
EDGES
  ^contains=matrix/neo/internal/server.session
  ^defines=matrix/neo/internal/server/session.go

