  digest=b3:37fc73e42fa4fda915dbb07f47046925ff86ffea31985c455778c0a59f47d3ac file=neo/internal/server/media.go range=179:239 lang=go exported=false byte_range=6009:8204
  sig=func (s *Server) handleUpload(w http.ResponseWriter, r *http.Request)
  doc=handleUpload stores a user-uploaded media input (POST /upload, multipart with\na "file" field) on the machine volume and returns its /media reference. The\nclient embeds that reference in the next chat message so the model can pass\nit to edit_image / generate_video / transcribe_audio.
