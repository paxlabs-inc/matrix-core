  digest=b3:23f1c4ef2b75185765c73a4729111e8175285021bf5db34898f0a215fece5d8b file=neo/internal/server/server.go range=188:220 lang=go exported=false byte_range=8757:10178
  sig=func (s *Server) handleDiagSelfModel(w http.ResponseWriter, r *http.Request)
  doc=handleDiagSelfModel serves GET /diag/self-model: the current resident\nself-summary and the active failure-pattern memories (self-model req.13.1). It\nis read-only and side-effect free (req.13.2) — it resolves the shared\nself-model through the pager's read path and never signs, mutates the model,\nor touches plan/walk.
