NODE id=matrix/neo/internal/server.subagentMaxAttempts kind=const
  digest=b3:a5f9f07680eeba944009c909ae97c242a7293cd5a218c6e2bf852963e7f8445a file=neo/internal/server/swarm.go range=23:29 lang=go exported=false byte_range=536:985
  sig=untyped int
  doc=subagentMaxAttempts is how many times a sub-agent's whole task is attempted\nbefore giving up: one initial run plus bounded recovery retries. A sub-agent\nwhose loop hard-fails (a model/transport error that survives the in-loop\nretry ladder) used to die on the spot with an empty report; instead it gets a\nfresh window and another go, so a transient provider hiccup no longer wastes\nthe whole sub-agent.
EDGES
  ^defines=matrix/neo/internal/server/swarm.go

NODE id=matrix/neo/internal/server.subagentMaxInheritedPatterns kind=const
  digest=b3:922be55dbc1a4ddae653f8f41dfce29b3a09f03380f2f040ef61764e06965ddb file=neo/internal/server/swarm.go range=291:294 lang=go exported=false byte_range=10099:10368
  sig=untyped int
  doc=subagentMaxInheritedPatterns caps how many how-I-fail patterns a sub-agent\ninherits, so the alignment context stays compact against the sub-agent's\nsmaller window while still carrying the recurring failure modes to avoid.
EDGES
  ^defines=matrix/neo/internal/server/swarm.go

NODE id=matrix/neo/internal/server.subagentTurnTimeout kind=const
  digest=b3:e22991142254e3a3434841028871e2eb5d652b94ff20e87ba40e318231275ada file=neo/internal/server/swarm.go range=19:21 lang=go exported=false byte_range=334:534
  sig=time.Duration
  doc=subagentTurnTimeout bounds a single sub-agent's whole run, independent of the\nparent turn's budget, so one stuck sub-agent can't hold the swarm open.
EDGES
  ^defines=matrix/neo/internal/server/swarm.go

NODE id=matrix/neo/internal/server.superviseAction kind=type
  digest=b3:a09075ab7f7434cafa9da46634be64167f3b452476d2a3a74538a5306e6dc2b5 file=neo/internal/server/session.go range=600:601 lang=go exported=false byte_range=24925:25027
