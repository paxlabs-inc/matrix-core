NODE id=matrix/neo/internal/server.Engine.publishMemory kind=method
  digest=b3:9e9d5d09223bc1ccbb908643671ab300ed88b785513bbe0a85ddd30be9f90190 file=neo/internal/server/engine.go range=619:640 lang=go exported=false byte_range=27226:28217
