NODE id=matrix/neo/internal/server.Engine.recordTrace kind=method
  digest=b3:36fd3e8901b5efe2bff9e0c5d3661ccd524b4380ce4df94857a43508eebb1846 file=neo/internal/server/engine.go range=1181:1208 lang=go exported=false byte_range=49950:51049
  sig=func (e *Engine) recordTrace(id string, ev Event)
  doc=recordTrace is the broker tap (F3): it persists the workspace-relevant slice\nof the live event stream to the durable sidecar trace store so "Neo's\nComputer" can be rebuilt when a thread is reopened — after the run settles,\nscrolls past the 512-event broker buffer, or the topic is reclaimed. It runs\non every publish, so it stays cheap: a map lookup, then a NON-BLOCKING\nenqueue (trace.Record drops rather than blocks). It never signs, never writes\nNeocortex, never touches plan/walk (pure sidecar — m9/i_trace).
EDGES
  ^contains=matrix/neo/internal/server.Engine
  ^defines=matrix/neo/internal/server/engine.go

