NODE id=matrix/neo/internal/server.session#inboxMu kind=field
  digest=b3:c7506b7bf15cdec8ed89d9439cb6a00fbd72c3f06661621a5260f9538a5ccc60 file=neo/internal/server/session.go range=76:81 lang=go exported=false byte_range=2917:3308
  sig=sync.Mutex
  doc=inbox holds user messages received WHILE a turn is in flight (F5):\nmid-task messages the user sent without interrupting. The live agent\ndrains it at each tool-call boundary (agent.Options.Inbox -> drainInput),\nso a mid-task message is delivered on the agent's next step instead of\ncancelling the run. Guarded by inboxMu (a distinct, briefly-held lock).
