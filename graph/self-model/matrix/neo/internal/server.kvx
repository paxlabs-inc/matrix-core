NODE id=matrix/neo/internal/server.dropRunNarration kind=func
  digest=b3:ee119bcdfaee35f2a57d70379bc4f345a6a8ba372b975a09379797f654d763cb file=neo/internal/server/session.go range=339:355 lang=go exported=false byte_range=14215:14817
  sig=func dropRunNarration(turns []conversation.Turn, r *run) []conversation.Turn
  doc=dropRunNarration filters a respawn seed: assistant turns persisted by the\nrun r itself are removed (they are this task's own in-flight narration, not\nprior-thread history), while every user turn and every turn from earlier\nruns is kept. A nil run (first mint, no task in flight) filters nothing.
EDGES
  ^defines=matrix/neo/internal/server/session.go

