  sig=type broker struct {\n	mu	sync.Mutex\n	topics	map[string]*topicState\n	// tap, when set, receives every published event AFTER it is buffered and\n	// fanned out. It is the seam the engine uses to persist the durable\n	// workspace trace (F3). It MUST be non-blocking (a queue enqueue), so it is\n	// invoked outside the topic lock and never stalls the publish hot path.\n	tap	func(id string, ev Event)\n}
  doc=broker keeps one topic per run id (the conversation turn's intent_id).
EDGES
  contains=matrix/neo/internal/server.broker#mu,matrix/neo/internal/server.broker#tap,matrix/neo/internal/server.broker#topics,matrix/neo/internal/server.broker.closeRun,matrix/neo/internal/server.broker.drop,matrix/neo/internal/server.broker.ensure,matrix/neo/internal/server.broker.has,matrix/neo/internal/server.broker.publish,matrix/neo/internal/server.broker.publishTerminal,matrix/neo/internal/server.broker.setTap,matrix/neo/internal/server.broker.subscribe,matrix/neo/internal/server.broker.topic
  ^defines=matrix/neo/internal/server/sse.go

NODE id=matrix/neo/internal/server.broker#mu kind=field
  digest=b3:104dc836435d5ef8442f9bfbde658e9de40c6f0a6a782ec8db1f57575a3b03f9 file=neo/internal/server/sse.go range=33:33 lang=go exported=false byte_range=1153:1170
