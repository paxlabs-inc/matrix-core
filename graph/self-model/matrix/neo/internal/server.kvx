NODE id=matrix/neo/internal/server.WorkspaceRoot kind=func
  digest=b3:c37401eddafc70ce934c9c973b1c931c6adb9a494c60b1c32390ee3fa35d2aad file=neo/internal/server/workspace.go range=65:81 lang=go exported=true byte_range=2090:2878
  sig=func WorkspaceRoot(override string) string
  doc=WorkspaceRoot resolves the VM workspace root: an explicit override wins,\nelse the persisted /workspace (= /data/workspace in prod, matching the fs\nand exec tools' default), else "" (workbench surface disabled). The result\nis always symlink-resolved: prod's /workspace is a symlink to\n/data/workspace, and filepath.WalkDir does not follow a symlink root — an\nunresolved root makes every tree listing come back empty.
EDGES
  ^defines=matrix/neo/internal/server/workspace.go

