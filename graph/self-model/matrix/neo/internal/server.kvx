NODE id=matrix/neo/internal/server.resolveWorkspacePath kind=func
  digest=b3:a790b1adf19259e47a06b888cb9287be6e2af05fd8137b55849811cd1bde034e file=neo/internal/server/workspace.go range=85:105 lang=go exported=false byte_range=2782:3556
  sig=func resolveWorkspacePath(root, path string) (string, error)
  doc=resolveWorkspacePath is the ONE path seam every workspace handler routes\nthrough (the cody edit.Rel posture): it joins a workspace-relative OR\nabsolute path against root and refuses anything that resolves outside it,\nso `../`, absolute out-of-root, and symlink-free traversal games never\nreach the filesystem beyond the project root.
EDGES
  ^defines=matrix/neo/internal/server/workspace.go

NODE id=matrix/neo/internal/server.resumePrime kind=func
  digest=b3:26e757195173a718c728bd676b28a77388b17aac59278e59a6d88d701e64d119 file=neo/internal/server/session.go range=649:669 lang=go exported=false byte_range=27172:28708
  sig=func resumePrime(objective string, attempt int, prev error) string
  doc=resumePrime is the catch-up instruction for a respawned / resumed agent: the\nobjective is unchanged, prior work may already be on the volume, build on it,\nand keep going until it is genuinely done. When the predecessor died with a\nwhere-it-got-stuck digest (prev != nil), that is folded in so the successor is\nborn knowing how the last attempt failed and is told not to repeat it — the\nimmediate death-journal read path. After a few stuck attempts it also nudges\ndecomposition / delegation.
EDGES
  ^defines=matrix/neo/internal/server/session.go

NODE id=matrix/neo/internal/server.routeFact kind=type
  digest=b3:0a9057a4b5420c5ddd8ae6d5bc5a42514f052ce5cebbaa7b122314868f3f16b7 file=neo/internal/server/server.go range=54:64 lang=go exported=false byte_range=1758:2262
  sig=type routeFact struct {\n	pattern		string\n	semantic	string\n	handler		http.HandlerFunc\n}
  doc=routeFact is one Neo-owned route: the mux pattern, its handler, and a\none-line EXTERNAL semantic. The table drives BOTH mux registration\n(Handler) and the derived capability surface (SurfaceFacts), so the\nself-model's "what can reach me" facts cannot drift from what the process\nactually serves (epistemic-core req.2.1/2.2). semantic "" keeps a route out\nof the external surface (internal plumbing).
EDGES
  contains=matrix/neo/internal/server.routeFact#handler,matrix/neo/internal/server.routeFact#pattern,matrix/neo/internal/server.routeFact#semantic
  ^defines=matrix/neo/internal/server/server.go

