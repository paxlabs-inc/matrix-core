NODE id=matrix/neo/internal/server.Server.handleDojoBoot kind=method
  digest=b3:e4f6840b52fab5741d7cff6075d70f1d15ad215baf0ac805c9cb6b2983854509 file=neo/internal/server/dojo.go range=284:320 lang=go exported=false byte_range=10149:11809
  sig=func (s *Server) handleDojoBoot(w http.ResponseWriter, r *http.Request)
  doc=handleDojoBoot serves POST /dojo/boot {conversation_id}: the USER turns the\ndisposable desktop on — the power button, fully independent of the agent\n(req 4.2: the human's control of the shared computer includes its power).\nReattaches the live session when one exists; otherwise registers a fresh one\nand boots it in the background while the panel renders the turning-on state.
EDGES
  ^contains=matrix/neo/internal/server.Server
  ^defines=matrix/neo/internal/server/dojo.go

NODE id=matrix/neo/internal/server.Server.handleDojoComputerUse kind=method
  digest=b3:186368b7e96b1e0260d2e1cd1d37eca76945566d4b753dcadf5a7b5367311471 file=neo/internal/server/dojo.go range=470:538 lang=go exported=false byte_range=17863:21231
  sig=func (s *Server) handleDojoComputerUse(w http.ResponseWriter, r *http.Request)
  doc=handleDojoComputerUse is the loopback proxy the desktop bridge posts to\n(MATRIX_DOJO_URL/computer-use). It resolves the user's live disposable-desktop\nsession and rides the exec-curl carrier into the appliance's localhost:9990,\nrelaying the bytebotd response verbatim. It is gated on the shared bridge\ntoken so only the co-located bridge — never external router-forwarded\ntraffic — can drive the desktop (DOJO guard_surface).
EDGES
  ^contains=matrix/neo/internal/server.Server
  ^defines=matrix/neo/internal/server/dojo.go

NODE id=matrix/neo/internal/server.Server.handleDojoFrame kind=method
  digest=b3:479fc50e201f21d33027c7c6aabbd5dd89d690a76eaa47350c0b23f0b1b55af3 file=neo/internal/server/dojo.go range=239:282 lang=go exported=false byte_range=8355:10147
  sig=func (s *Server) handleDojoFrame(w http.ResponseWriter, r *http.Request)
  doc=handleDojoFrame serves GET /dojo/frame?conversation={id}: one live-view\nframe of the conversation's desktop, JPEG-encoded for the wire. This is the\nwave-3 live-view transport: the client polls it while the panel is visible —\nplain request/response over the existing exec-curl carrier, no held stream\nto keepalive (the 2026-07-11 browser-heartbeat failure class cannot occur).\nFrames are passive: they never bump the session's idle clock.
EDGES
  ^contains=matrix/neo/internal/server.Server
  ^defines=matrix/neo/internal/server/dojo.go

NODE id=matrix/neo/internal/server.Server.handleDojoHandback kind=method
  digest=b3:835dbd66eaa7d0930e783bc0fa3f75471191daa95d93af3cc9b629310cb743a8 file=neo/internal/server/dojo.go range=364:371 lang=go exported=false byte_range=13624:14012
  sig=func (s *Server) handleDojoHandback(w http.ResponseWriter, r *http.Request)
  doc=handleDojoHandback serves POST /dojo/handback {conversation_id}: the human\nreturns the controls (req 4.3). The manager arms the re-observation gate so\nthe agent looks before it acts.
EDGES
  ^contains=matrix/neo/internal/server.Server
  ^defines=matrix/neo/internal/server/dojo.go

NODE id=matrix/neo/internal/server.Server.handleDojoInput kind=method
  digest=b3:74429a8ae50d26749ec6795c25e12e66fabee3731ad27aed1f6f6ab1451ee213 file=neo/internal/server/dojo.go range=407:449 lang=go exported=false byte_range=15430:17283
  sig=func (s *Server) handleDojoInput(w http.ResponseWriter, r *http.Request)
  doc=handleDojoInput serves POST /dojo/input {conversation_id, request}: one\nhuman input action passed through to the desktop WHILE the control lease is\nheld — refused in every other state, so the passthrough exists only under an\nexplicit takeover.
EDGES
  ^contains=matrix/neo/internal/server.Server
  ^defines=matrix/neo/internal/server/dojo.go

