  digest=b3:409ea68224287159035a85cb2a02313f9f5ba92e5ff835efbfa9d05bab6fd0d1 file=neo/internal/server/automatrix_run.go range=248:261 lang=go exported=false byte_range=11278:12266
  sig=func buildAutomatrixObjective(opp memory.OpportunitySpec) string
