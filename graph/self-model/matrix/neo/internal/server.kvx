  digest=b3:685528bc2c962eb3fc71873ddd48c6dff0f974d1c3a891dbe7f586ddf5229494 file=neo/internal/server/improvement.go range=184:221 lang=go exported=false byte_range=5578:6776
  sig=func (e *Engine) runImprovementObservation(key string)
