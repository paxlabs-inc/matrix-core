NODE id=matrix/neo/internal/server.Engine.decideMorningBriefWake kind=method
  digest=b3:ee6bd4c576e9a76410cfaea6ecbe5ff4cd037c8826941c41c84ed6bacff14118 file=neo/internal/server/brief_wake.go range=92:124 lang=go exported=false byte_range=4194:5391
  sig=func (e *Engine) decideMorningBriefWake(now time.Time) briefWakeOutcome
  doc=decideMorningBriefWake is the PURE fail-closed wake gate over the live\nschedule (re-read this wake) and the current time. It performs NO dispatch and\nNO network — it only classifies the wake, so a disabled/paused/off-day/\nalready-delivered/busy wake provably never reaches the runner (req 15.3).
EDGES
  ^contains=matrix/neo/internal/server.Engine
  ^defines=matrix/neo/internal/server/brief_wake.go

NODE id=matrix/neo/internal/server.Engine.deliverBrief kind=method
  digest=b3:e25c9f06d4e1019fee9c5896b51e8eee032d3b04943e2296116b3e949166f368 file=neo/internal/server/brief_run.go range=106:158 lang=go exported=false byte_range=4447:7153
  sig=func (e *Engine) deliverBrief(convID, runID, localDate, briefText string)
  doc=deliverBrief persists a genuinely-composed brief out of band and only then\nnotifies (req 15.2: durable conversation turn + inbox record BEFORE any live\nnotification). The delivery ORDER is load-bearing: the durable surfaces are\nthe canonical record (they survive no-client and a failed external send); the\nlast-delivered date is marked after they are written (so a crash before\npersistence retries rather than silently skipping the day); the out-of-app\nping fires last, best-effort. All copy is result-not-protocol.
EDGES
  ^contains=matrix/neo/internal/server.Engine
  ^defines=matrix/neo/internal/server/brief_run.go

NODE id=matrix/neo/internal/server.Engine.desktopA11y kind=method
  digest=b3:2a02f0cacef1d34a1b81f306a54a84230b348ad695feeb1bd481c5ff5ca859b4 file=neo/internal/server/dojo.go range=187:208 lang=go exported=false byte_range=6542:7311
  sig=func (e *Engine) desktopA11y(ctx context.Context) (string, error)
  doc=desktopA11y is the tools.DesktopA11yFunc seam (DOJO req 3.3): the\ndeterministic middle rung — an AT-SPI accessibility-tree dump of the live\ndesktop, rendered as text with screen-pixel coordinates and no vision model.
EDGES
  ^contains=matrix/neo/internal/server.Engine
  ^defines=matrix/neo/internal/server/dojo.go

NODE id=matrix/neo/internal/server.Engine.desktopLook kind=method
  digest=b3:5141b9576c2810054dff3db906339fcd4e460811c2ac24218d5de77fe6fc03d6 file=neo/internal/server/dojo.go range=120:185 lang=go exported=false byte_range=4059:6540
  sig=func (e *Engine) desktopLook(ctx context.Context, target string) (string, error)
  doc=desktopLook is the tools.DesktopLookFunc seam (DOJO req 3.2): it captures the\nlive desktop through bytebotd, invokes the stateless MiMo v2.5 omni vision\nclient with the frozen single-pass grounding prompt, and returns structured\ntext — interactive elements + a best click point, coordinates already\nrescaled from omni's 0–1000 convention to screen pixels. Omni output enters\nthe window ONLY as this tool result (planner_integrity); the session model is\nnever swapped.
EDGES
  ^contains=matrix/neo/internal/server.Engine
  ^defines=matrix/neo/internal/server/dojo.go

NODE id=matrix/neo/internal/server.Engine.dispatchAutomatrixRun kind=method
