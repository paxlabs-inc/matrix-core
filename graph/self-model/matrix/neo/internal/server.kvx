NODE id=matrix/neo/internal/server.deathEntry#State kind=field
  digest=b3:6db57a92bdcbdc7bb6a2a74a3b70516e619fb55f72c5798c8f4cfb61ce8a3ebf file=neo/internal/server/session.go range=953:953 lang=go exported=true byte_range=40453:40469
