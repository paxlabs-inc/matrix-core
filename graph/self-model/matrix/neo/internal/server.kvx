NODE id=matrix/neo/internal/server.broker.setTap kind=method
  digest=b3:9987593a9f626af2c45bc3e7bf38caeb8f731e28c16edb5ec1f7087ed27ef557 file=neo/internal/server/sse.go range=55:58 lang=go exported=false byte_range=1740:1993
  sig=func (b *broker) setTap(fn func(id string, ev Event))
  doc=setTap installs the post-publish event tap (F3 durable workspace trace). The\ntap callback must be non-blocking; it is invoked once per published event,\noutside the topic lock.
