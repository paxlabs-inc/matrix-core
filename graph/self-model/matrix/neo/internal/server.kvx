NODE id=matrix/neo/internal/server.automatrixGovernor.SetEnabled kind=method
  digest=b3:2ed8dee80813e5d218c2d873c9c531d2987d8ec1b1f5747c4e2a23aabf2aab3e file=neo/internal/server/automatrix_governor.go range=173:207 lang=go exported=true byte_range=7344:8749
