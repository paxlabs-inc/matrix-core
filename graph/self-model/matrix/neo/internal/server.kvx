NODE id=matrix/neo/internal/server.deathDigest kind=func
  digest=b3:b56868100030aaae0d42a9c6191f8600a8a68568956d98046674dd3eaec2c2e6 file=neo/internal/server/session.go range=926:940 lang=go exported=false byte_range=39235:39808
  sig=func deathDigest(prev error) string
  doc=deathDigest extracts a concise, model-readable reason a prior supervised\nattempt ended, for the successor's catch-up prime. It strips the ErrIncomplete\nsentinel prefix so only the where-it-got-stuck digest remains. Returns "" when\nthere is no prior failure (the first attempt).
EDGES
  ^defines=matrix/neo/internal/server/session.go

NODE id=matrix/neo/internal/server.deathEntry kind=type
  digest=b3:e95bf54ee8a3ca811fe998b0c5c07dbc476f4410f936fa9b5cb1ccb970e3f004 file=neo/internal/server/session.go range=942:954 lang=go exported=false byte_range=39810:40529
  sig=type deathEntry struct {\n	Objective	string\n	Attempt		int\n	Class		delegate.FailureClass\n	Digest		string	// where-it-got-stuck, ErrIncomplete sentinel already stripped\n	State		string	// the agent's rich loop-state line ("" when unavailable)\n}
  doc=deathEntry is the SINGLE description of one supervised-attempt death — the\nshared source for BOTH death-journal read paths (self-model task 3.1,\nreq.4.3), so the immediate successor-prime digest and the durable Neocortex\nrecord cannot describe the same death differently. The where-it-got-stuck\nDigest is the same deathDigest(err) both paths read; Class and State live on\nthe durable record (the richer surface), while the prime folds in the Digest.
EDGES
  contains=matrix/neo/internal/server.deathEntry#Attempt,matrix/neo/internal/server.deathEntry#Class,matrix/neo/internal/server.deathEntry#Digest,matrix/neo/internal/server.deathEntry#Objective,matrix/neo/internal/server.deathEntry#State,matrix/neo/internal/server.deathEntry.durableSummary
  ^defines=matrix/neo/internal/server/session.go

