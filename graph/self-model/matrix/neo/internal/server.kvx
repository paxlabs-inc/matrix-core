NODE id=matrix/neo/internal/server.automatrixMaxAttempts kind=const
  digest=b3:67f083a24dd69c7d59fa023c0febb60bb0c721354aafd116ddbe6635a78029de file=neo/internal/server/automatrix_run.go range=46:51 lang=go exported=false byte_range=2036:2441
  sig=untyped int
  doc=automatrixMaxAttempts bounds how many times an autonomous opportunity is\nretried across wakes before it is DISMISSED rather than re-queued (req 5.5:\n"eventually dismiss it"). A partial/failed attempt re-pends with attempts++;\nonce attempts reach this ceiling the opportunity is dropped from the queue so\na persistently-unachievable item cannot churn forever.
