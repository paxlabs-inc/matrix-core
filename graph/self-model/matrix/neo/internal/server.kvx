NODE id=matrix/neo/internal/server.Engine.dojoBoot kind=method
  digest=b3:d91e3a623b8f22bfbdf67c74b48f6f9b6a434741669594bf613e43293e1fc3d7 file=neo/internal/server/dojo.go range=86:110 lang=go exported=false byte_range=2771:3827
  sig=func (e *Engine) dojoBoot(ctx context.Context) error
  doc=dojoBoot is the wave-3 provisioning trigger: it ensures the active\nconversation has a desktop session (starting a BACKGROUND boot when none\nexists — the client renders it as the computer turning on) and waits briefly\nfor readiness. nil means the desktop is ready to drive; dojo.ErrBooting means\nit is still provisioning; any other error is a typed lifecycle failure.
EDGES
  ^contains=matrix/neo/internal/server.Engine
  ^defines=matrix/neo/internal/server/dojo.go

NODE id=matrix/neo/internal/server.Engine.emitAutomatrixComplete kind=method
  digest=b3:2353c85429f605414f286c2111fc3b7bf6ca5be1bd64e013e1cf5df6c3bacf11 file=neo/internal/server/engine.go range=1218:1244 lang=go exported=false byte_range=51555:52894
  sig=func (e *Engine) emitAutomatrixComplete(convID, opportunitySummary, resultSummary string) automatrixlog.Record
  doc=emitAutomatrixComplete writes the durable in-app completion record and\npublishes the automatrix.complete broker event so a live client surfaces the\nsurprise result immediately. The durable record is the canonical, replayable\nsurface: it is written FIRST so the result is never lost even if no client is\nconnected (and regardless of any out-of-app ntfy/Apprise ping). This is the\nclean writer seam the completion path (5.3) calls on a genuinely-gated pass;\nit never signs, writes Neocortex, or touches the plan/walk. No secrets are\nrecorded — only the result-not-protocol fields.
EDGES
  ^contains=matrix/neo/internal/server.Engine
  ^defines=matrix/neo/internal/server/engine.go

NODE id=matrix/neo/internal/server.Engine.emitConstructSurface kind=method
