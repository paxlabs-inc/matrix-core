NODE id=matrix/neo/internal/server.Engine#gateClaimsMu kind=field
  digest=b3:4ab4b0082da2496d63811dc7520f195f419101e8e18f33bb7c1f67479ae1e260 file=neo/internal/server/engine.go range=98:106 lang=go exported=false byte_range=3974:4557
  sig=sync.Mutex
  doc=gateClaims serialises approval-gate answering across the per-call\ndelegate clients (engine.coreExecute builds a fresh delegate.Client per\ncall). Keyed on MCL intent id + gate node id, it lets only ONE delegate\nservice a given gate, so two concurrent attaches to the same in-flight\nintent (a re-dispatch joining a parked launch) cannot double-answer it\n(req 2.4). This is the delegate-side reconcile chosen over a daemon-side\nidempotent-create: it lives entirely on the conversational seam and never\ntouches the signed MCL path.
EDGES
  ^contains=matrix/neo/internal/server.Engine

