NODE id=matrix/neo/internal/server.subagentEffectiveMax kind=func
  digest=b3:b16a628cee134b31b6d22d3a8d6f8c4f495ac0e9432e7f7a3c231659735517fc file=neo/internal/server/swarm.go range=380:394 lang=go exported=false byte_range=13395:13973
  sig=func subagentEffectiveMax(err error) int
  doc=subagentEffectiveMax classifies a leg's terminal error to pick its retry\nceiling: a deterministic provider rejection won't change on retry (die fast — a\nsingle attempt); a provider-transient failure (rate-limited / unreachable) gets\nthe higher transient ceiling with hard backoff; everything else keeps the\ndefault recovery budget.
EDGES
  ^defines=matrix/neo/internal/server/swarm.go

NODE id=matrix/neo/internal/server.subagentFailureTransient kind=func
  digest=b3:31cdc60b10583931d2100d37302047646638c56a98ad6f7580762d74e86f2ab7 file=neo/internal/server/swarm.go range=396:402 lang=go exported=false byte_range=13975:14382
  sig=func subagentFailureTransient(err error) bool
  doc=subagentFailureTransient reports whether a leg's error is a provider-transient\nfailure — an upstream that is rate-limiting or unreachable, where a fresh leg\nafter a hard backoff can succeed (the transient MiMo storm the extra attempts\nexist to ride out).
EDGES
  ^defines=matrix/neo/internal/server/swarm.go

NODE id=matrix/neo/internal/server.subagentMaxAttempts kind=const
  digest=b3:a5f9f07680eeba944009c909ae97c242a7293cd5a218c6e2bf852963e7f8445a file=neo/internal/server/swarm.go range=31:37 lang=go exported=false byte_range=844:1293
  sig=untyped int
  doc=subagentMaxAttempts is how many times a sub-agent's whole task is attempted\nbefore giving up: one initial run plus bounded recovery retries. A sub-agent\nwhose loop hard-fails (a model/transport error that survives the in-loop\nretry ladder) used to die on the spot with an empty report; instead it gets a\nfresh window and another go, so a transient provider hiccup no longer wastes\nthe whole sub-agent.
EDGES
  ^defines=matrix/neo/internal/server/swarm.go

NODE id=matrix/neo/internal/server.subagentMaxInheritedPatterns kind=const
  digest=b3:922be55dbc1a4ddae653f8f41dfce29b3a09f03380f2f040ef61764e06965ddb file=neo/internal/server/swarm.go range=435:438 lang=go exported=false byte_range=15442:15711
  sig=untyped int
  doc=subagentMaxInheritedPatterns caps how many how-I-fail patterns a sub-agent\ninherits, so the alignment context stays compact against the sub-agent's\nsmaller window while still carrying the recurring failure modes to avoid.
EDGES
  ^defines=matrix/neo/internal/server/swarm.go

NODE id=matrix/neo/internal/server.subagentMaxResultRunes kind=const
  digest=b3:29724546f41d7d57d19d8c90a51335d298256fa0616755fb304ef44bda346dad file=neo/internal/server/swarm.go range=26:29 lang=go exported=false byte_range=586:842
  sig=untyped int
  doc=subagentMaxResultRunes bounds the evidence returned by one worker to the\nparent context. The live step stream remains available to the client, while\nthe parent receives only this compact, structured report.
EDGES
  ^defines=matrix/neo/internal/server/swarm.go

NODE id=matrix/neo/internal/server.subagentMaxTransientAttempts kind=const
  digest=b3:5ab4d4d522826f2fb08e96241456e17e8367f6f30e84ea514d0a830523cdedd0 file=neo/internal/server/swarm.go range=39:45 lang=go exported=false byte_range=1295:1814
  sig=untyped int
  doc=subagentMaxTransientAttempts is the retry ceiling for a leg that died on a\nPROVIDER-transient failure (rate-limited / unreachable upstream), higher than\nthe default so a transient MiMo storm under concurrency — several legs hitting\nthe provider at once — no longer kills a researcher after a single recovery\ntry. A deterministic provider rejection still dies fast (a retry sends the same\nbody), and a leg that produced ANY usable text is still never retried.
EDGES
  ^defines=matrix/neo/internal/server/swarm.go

NODE id=matrix/neo/internal/server.subagentTurnTimeout kind=const
  digest=b3:e22991142254e3a3434841028871e2eb5d652b94ff20e87ba40e318231275ada file=neo/internal/server/swarm.go range=22:24 lang=go exported=false byte_range=384:584
  sig=time.Duration
  doc=subagentTurnTimeout bounds a single sub-agent's whole run, independent of the\nparent turn's budget, so one stuck sub-agent can't hold the swarm open.
EDGES
  ^defines=matrix/neo/internal/server/swarm.go

NODE id=matrix/neo/internal/server.superviseAction kind=type
  digest=b3:a09075ab7f7434cafa9da46634be64167f3b452476d2a3a74538a5306e6dc2b5 file=neo/internal/server/session.go range=855:856 lang=go exported=false byte_range=35225:35327
  sig=type superviseAction int
  doc=superviseAction is the policy outcome for one finished supervised attempt.
EDGES
  ^defines=matrix/neo/internal/server/session.go

NODE id=matrix/neo/internal/server.superviseBackoff kind=func
  digest=b3:561076244aa811988ff1c9c378f9b24f33c498073b09b492c64d9bd70b0a2ecf file=neo/internal/server/session.go range=1157:1185 lang=go exported=false byte_range=49567:50727
  sig=func superviseBackoff(ctx context.Context, attempt int, rateLimited bool) bool
  doc=superviseBackoff sleeps an attempt-scaled, jittered interval before a\nrespawn, honoring task cancellation. Jitter avoids a synchronized retry\nstampede when many users' daemons hit the same upstream hiccup at once.\n\nrateLimited stretches the interval hard: an upstream 429 means the provider\nis overloaded, so respawning quickly across many daemons is a self-amplifying\nrequest storm. On a 429 the base grows to ~15s/attempt (cap 90s) with a full\n15s of jitter, draining pressure off the upstream instead of adding to it,\nwhile still eventually retrying (the Task Durability Rule is preserved — we\nkeep going, just far more slowly).
EDGES
  ^defines=matrix/neo/internal/server/session.go

NODE id=matrix/neo/internal/server.superviseDecision kind=func
  digest=b3:a6e5ecfa8e3af988b144c1cf439af090095ce0dbb7655cf758452bb88b75350d file=neo/internal/server/session.go range=866:892 lang=go exported=false byte_range=35777:37028
  sig=func superviseDecision(stopped bool, attemptErr error, failClass delegate.FailureClass, taskCtxErr error, attempt, maxRespawns int) superviseAction
  doc=superviseDecision is the PURE policy for one finished attempt, given whether\nthe run was stopped, the attempt's error (nil = genuine completion), the\nshared failure class of the attempt's most recent classified tool failure,\nthe task context's error (non-nil = wall-clock blown), the attempt number,\nand the respawn budget. Order matters: a user stop wins over everything; a\nclean finish is done; a DETERMINISTIC blocker stops-and-asks (a fresh agent\nwould hit the same wall, so don't respawn or consume the budget); a blown\nwall-clock or an exhausted respawn budget hits the ceiling; otherwise\nrespawn. Every other non-clean exit (model/transport error, a stall, an\nexhausted step budget, a timed-out attempt, or a transient/conflict/pending\nfailure) flows to respawn until the ceiling.
EDGES
  ^defines=matrix/neo/internal/server/session.go

NODE id=matrix/neo/internal/server.surfaceIs kind=var
  digest=b3:a6d89c31750052c1ab03418df8b2986547d27ec484404bb7efc5bff53fed0faf file=neo/internal/server/server.go range=188:198 lang=go exported=false byte_range=14176:14946
  sig=[]string
  doc=surfaceIs / surfaceIsNot are the architectural is / is-not facts of the\nserving surface, declared HERE — beside the route table they qualify, owned\nby the package that IS the surface — and written into the durable self-model\n(epistemic-core req.2.1): the arena incident's false premise ("I can wire my\nown API up directly / I have an OpenAI-compatible endpoint") must collide\nwith these resident facts at the moment it would form.
EDGES
  ^defines=matrix/neo/internal/server/server.go

NODE id=matrix/neo/internal/server.surfaceIsNot kind=var
  digest=b3:cf6360cb2be468eb9b2eb3e7b80b3192e0464d7aa59eea53b5313e32c4f274ec file=neo/internal/server/server.go range=188:202 lang=go exported=false byte_range=14176:15302
  sig=[]string
  doc=surfaceIs / surfaceIsNot are the architectural is / is-not facts of the\nserving surface, declared HERE — beside the route table they qualify, owned\nby the package that IS the surface — and written into the durable self-model\n(epistemic-core req.2.1): the arena incident's false premise ("I can wire my\nown API up directly / I have an OpenAI-compatible endpoint") must collide\nwith these resident facts at the moment it would form.
EDGES
  ^defines=matrix/neo/internal/server/server.go

