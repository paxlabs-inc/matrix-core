NODE id=matrix/neo/internal/server.Server.handleConversationDelete kind=method
  digest=b3:6247b7f9698988ee7bb42314364536a4115d5b8c83dde5f2421df7a280506ff4 file=neo/internal/server/server.go range=622:677 lang=go exported=false byte_range=32843:34987
  sig=func (s *Server) handleConversationDelete(w http.ResponseWriter, r *http.Request, id string)
  doc=handleConversationDelete permanently removes one conversation (CHAT-01). It\nrefuses while a run is still in flight (409) so an active task's state is not\ntorn out from under it; the client must stop the run first. On success it\nremoves the durable turn logs and every associated run's workspace trace, and\nreturns a cleanup disclosure of what was purged.
EDGES
  ^contains=matrix/neo/internal/server.Server
  ^defines=matrix/neo/internal/server/server.go

NODE id=matrix/neo/internal/server.Server.handleConversationFork kind=method
  digest=b3:3d44614415c2e8824035c243e1d22ac0addbb174247495673e0acbfdf7e51f95 file=neo/internal/server/server.go range=679:733 lang=go exported=false byte_range=34989:37154
  sig=func (s *Server) handleConversationFork(w http.ResponseWriter, r *http.Request, id string)
  doc=handleConversationFork creates a new conversation from the chronological\nprefix of an existing one up to a selected turn (CHAT-01). Body:\n{"up_to_turn": N} — copy the first N turns of the source's full history into a\nfresh conversation with parent/turn provenance and an independent future. A\nmissing/deleted parent yields an explicit 404; an out-of-range turn a 400.
EDGES
  ^contains=matrix/neo/internal/server.Server
  ^defines=matrix/neo/internal/server/server.go

NODE id=matrix/neo/internal/server.Server.handleConversationPatch kind=method
  digest=b3:9f55a0e7fd659c639442c2f8b6f53abcb38c5ed5d16e1f0717721035f14e1bc3 file=neo/internal/server/server.go range=585:620 lang=go exported=false byte_range=31245:32841
  sig=func (s *Server) handleConversationPatch(w http.ResponseWriter, r *http.Request, id string)
  doc=handleConversationPatch renames or archives one conversation (CHAT-01).\nBody: {"title":"…"} to rename (empty clears the override) and/or\n{"archived":true|false} to archive/unarchive. A missing/deleted conversation\nyields an explicit 404 rather than a silent create. Returns the refreshed\nsummary so an optimistic client can reconcile.
EDGES
  ^contains=matrix/neo/internal/server.Server
  ^defines=matrix/neo/internal/server/server.go

NODE id=matrix/neo/internal/server.Server.handleConversations kind=method
  digest=b3:de0a94b26a4c65642306293efeb8489ff250bbbd7077f7cbca1ae6a45a95f580 file=neo/internal/server/server.go range=502:583 lang=go exported=false byte_range=27829:31243
  sig=func (s *Server) handleConversations(w http.ResponseWriter, r *http.Request)
  doc=handleConversations serves GET /conversations (list) and\nGET /conversations/<id> (full turn log) from Neo's durable store. The shape\nmirrors the daemon's routes (and the web client's expectations) exactly:\nlist → {"items":[summary...]}, detail → the record. When persistence is\ndisabled it proxies to the daemon so the legacy store still answers.\n\nF1 wire shape (additive, byte-compatible): the detail response carries a\nsibling `live_run` field — the in-flight intent_id for this conversation, or\n"" once the run has settled. The existing record fields\n(conversation_id, title, turns, updated) are emitted unchanged so older\nclients keep deserialising. New clients use `live_run` to subscribe to the\nSSE stream with replay on reopen/relogin without waiting for the\n/messages/async/<id> poll — the durable resume signal that closes the\n"thread looks done while agent is still working" defect.
EDGES
  ^contains=matrix/neo/internal/server.Server
  ^defines=matrix/neo/internal/server/server.go

NODE id=matrix/neo/internal/server.Server.handleCreateProject kind=method
  digest=b3:b0b727dab65d2a2b756eae3d79d7141685a4d7ccaf064a29602bd476c071654d file=neo/internal/server/projects.go range=543:588 lang=go exported=false byte_range=14911:16742
  sig=func (s *Server) handleCreateProject(w http.ResponseWriter, r *http.Request)
