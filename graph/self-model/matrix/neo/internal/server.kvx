  ^defines=matrix/neo/internal/server/session.go

NODE id=matrix/neo/internal/server.session.submitSystemWake kind=method
  digest=b3:75e0da254be28e1bab1e49129f8098b1e91bcc63144cc53c8c3f81a71d86e0c7 file=neo/internal/server/session.go range=447:476 lang=go exported=false byte_range=18111:19364
  sig=func (s *session) submitSystemWake(message, key string) (runID string, fresh, duplicate, busy bool, err error)
  doc=submitSystemWake dispatches a durable internal wake only while the\nconversation is idle. Unlike a user message it never joins the live inbox:\nthe durable Build wake outbox retries later, keeping unrelated user work and\nbackground completion narration as separate turns.
EDGES
  ^contains=matrix/neo/internal/server.session
  ^defines=matrix/neo/internal/server/session.go

NODE id=matrix/neo/internal/server.session.submitWith kind=method
  digest=b3:9c61704bd39e76baca83233b49806d6f9a3e66abaf07af6c96d3b8288243179f file=neo/internal/server/session.go range=409:417 lang=go exported=false byte_range=16614:17131
  sig=func (s *session) submitWith(message string, onFinish func(task.Status)) (runID string, fresh bool)
  doc=submitWith is submit with a terminal observer: when the message dispatches a\nFRESH run, onFinish is attached to it (invoked once with the run's terminal\ntask status). When the message is queued into an already-live run, no hook is\nattached (the live run belongs to other work) and fresh=false tells the\ncaller so.
EDGES
  ^contains=matrix/neo/internal/server.session
  ^defines=matrix/neo/internal/server/session.go

NODE id=matrix/neo/internal/server.session.superviseAutomatrixTask kind=method
  digest=b3:3d8fda651f9b8d6f8ab45f06e90b81ea352d3f4b47259e272f4827b385e77101 file=neo/internal/server/session.go range=1187:1252 lang=go exported=false byte_range=50729:53705
  sig=func (s *session) superviseAutomatrixTask(ctx context.Context, objective string) task.Status
  doc=superviseAutomatrixTask is the QUIET sibling of superviseTask for an\nautonomous Automatrix run (task 4.1, req 5.1/5.3/5.4/5.5). It mirrors the\nreal supervisor's policy EXACTLY — the same pure superviseDecision over the\nagent's clean finish / failure class / wall-clock, the same jittered backoff,\nthe same FRESH-agent respawn over durable state across a non-clean exit — so\na proactive run is held to the SAME loop discipline (inside agent.Chat:\nno-progress stall / step budget / the unified unproductive counter, plus the\nCassandra 2.0 silent-voice controller) as any interactive turn. The two\ndifferences from superviseTask are deliberate: (1) the agent is the\nRESTRICTED no-money surface (the session was minted with automatrix=true), and\n(2) it surfaces NOTHING — no SSE/broker terminals, no honest-partial bubble in\nthe thread (req 5.5: a partial/failed proactive attempt is silent, never\nfailed-surprise spam). It returns the terminal task.Status so the runner can\nsettle the opportunity (done vs pending+attempts). A user stop cannot happen\nhere (no live run / no barge-in), so actInterrupted is unreachable.
EDGES
  ^contains=matrix/neo/internal/server.session
  ^defines=matrix/neo/internal/server/session.go

NODE id=matrix/neo/internal/server.session.superviseBriefTask kind=method
  digest=b3:f9409235cc51b120dad12b49c74005734d87fec2ae184833f896acba01e52cf5 file=neo/internal/server/session.go range=1254:1315 lang=go exported=false byte_range=53707:56393
  sig=func (s *session) superviseBriefTask(ctx context.Context, objective string) task.Status
  doc=superviseBriefTask is the QUIET sibling of superviseTask for an autonomous\nMORNING_BRIEF run (ORACLE task 5.4, req 15.1/15.2). It mirrors the real\nsupervisor's policy EXACTLY — the same pure superviseDecision over the agent's\nclean finish / failure class / wall-clock, the same jittered backoff, the same\nFRESH-agent respawn over durable state across a non-clean exit — so a brief is\nheld to the SAME loop discipline as any interactive turn. The two differences\nare deliberate: (1) the agent is the TIGHT read-only brief surface (the\nsession was minted with brief=true, so it physically cannot reach money /\nsigning / filesystem / deploy / exec tools, req 15.1), and (2) it surfaces\nNOTHING live — the composed brief is delivered out of band as a durable\nconversation turn + inbox record before any notification (req 15.2). It\nreturns the terminal task.Status so the runner can settle the ledger (done vs\nceiling). A user stop cannot happen here (no live run / no barge-in).
EDGES
  ^contains=matrix/neo/internal/server.session
  ^defines=matrix/neo/internal/server/session.go

NODE id=matrix/neo/internal/server.session.superviseTask kind=method
  digest=b3:7109d950fddb425f5078981d9a7c09520e2674347581889f4fc8630523db3219 file=neo/internal/server/session.go range=676:788 lang=go exported=false byte_range=27917:33074
  sig=func (s *session) superviseTask(ctx context.Context, r *run, objective string, resume bool, audio *agent.AudioTurn) task.Status
  doc=superviseTask keeps at least one agent on the task until it is genuinely\ncomplete (the agent's own completion gate accepts and it Says its answer), is\ninterrupted by the user, or hits a hard ceiling. Every non-clean exit — a\nmodel/transport error, a no-progress stall, an exhausted step budget, a\nstuck attempt that timed out — is treated as "not done": it checkpoints, tells\nthe user it is still working (never a fake "done"), backs off, respawns a\nFRESH agent over durable state, and goes again.
EDGES
  ^contains=matrix/neo/internal/server.session
  ^defines=matrix/neo/internal/server/session.go

