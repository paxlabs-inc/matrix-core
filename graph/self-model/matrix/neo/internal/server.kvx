NODE id=matrix/neo/internal/server.swarmActiveKey kind=type
  digest=b3:bb05259f016415e7511ac2c99a6566a835043b1e95031e1ecd295b3e51c1b1bc file=neo/internal/server/swarm.go range=52:55 lang=go exported=false byte_range=2072:2332
  sig=type swarmActiveKey struct{}
  doc=swarmActiveKey marks a context as already running inside a swarm, so a\nsub-agent that somehow reaches spawn_subagents is refused (no recursion /\nfork-bombs). Sub-agents are never advertised the tool, so this is a backstop.
EDGES
  ^defines=matrix/neo/internal/server/swarm.go

NODE id=matrix/neo/internal/server.swarmBackoff kind=func
  digest=b3:09a624213d1b7ecd8a50975fafb77933ed37effc8a3f228b7ad4ba94faa9c00e file=neo/internal/server/swarm.go range=333:356 lang=go exported=false byte_range=12143:12829
  sig=func swarmBackoff(ctx context.Context, attempt int, hard bool) bool
  doc=swarmBackoff sleeps a bounded, attempt-scaled interval before a sub-agent\nretry, returning false if the parent context is cancelled during the wait. A\nprovider storm (hard=true) backs off harder and longer so N recovering legs\ndon't re-collide on the recovering upstream the instant they retry.
EDGES
  ^defines=matrix/neo/internal/server/swarm.go

NODE id=matrix/neo/internal/server.swarmStagger kind=func
  digest=b3:a7367142ff8e07fdd2b15e26ebfff67245011e0a1e3f9a2c06cfe5efc8d85c99 file=neo/internal/server/swarm.go range=358:378 lang=go exported=false byte_range=12831:13393
  sig=func swarmStagger(ctx context.Context, index int) bool
  doc=swarmStagger delays leg `index` by (index-1)*staggerStep before its first\nattempt so concurrent legs don't start in lockstep, capped so a high index\ncan't over-delay. Returns false if the parent context is cancelled during the\nwait. Leg 1 never waits.
EDGES
  ^defines=matrix/neo/internal/server/swarm.go

