  ^contains=matrix/neo/internal/server.broker
  ^defines=matrix/neo/internal/server/sse.go

NODE id=matrix/neo/internal/server.broker.subscribe kind=method
  digest=b3:6870a8147b952f67cdbc40ce1cf27b449436b00878f980a7cce251b5e38834c2 file=neo/internal/server/sse.go range=172:200 lang=go exported=false byte_range=5140:5868
  sig=func (b *broker) subscribe(id string, sinceSeq int) (replay []Event, ch chan Event, cancel func())
  doc=subscribe returns the current replay buffer plus a live channel for\nsubsequent events, and a cancel func to detach. If the run already closed,\nch is nil (caller streams the replay then returns).
