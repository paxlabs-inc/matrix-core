NODE id=matrix/neo/internal/server.Server.handleWorkspacePreview kind=method
  digest=b3:c10ad8fb60a0869a67e0f8f6d7bca796fe8b91c58a30da9eba90a923af87d3aa file=neo/internal/server/preview.go range=75:111 lang=go exported=false byte_range=2666:4169
  sig=func (s *Server) handleWorkspacePreview(w http.ResponseWriter, r *http.Request)
  doc=handleWorkspacePreview is the single-action (re)preview: POST it to\nprovision the project's on-demand sandbox. It returns 202 and the lifecycle\nunfolds on preview.pending/ready/failed/expired events; the client renders\nthose. A run need not be active — the user can ask for a preview of the\ncurrent project state at any time.
EDGES
  ^contains=matrix/neo/internal/server.Server
  ^defines=matrix/neo/internal/server/preview.go

NODE id=matrix/neo/internal/server.Server.handleWorkspaceRaw kind=method
  digest=b3:ee827e8475bf59798fbd4c45518cca669d702b3688f1192bc834d119a7427526 file=neo/internal/server/workspace.go range=324:369 lang=go exported=false byte_range=9822:11372
  sig=func (s *Server) handleWorkspaceRaw(w http.ResponseWriter, r *http.Request)
  doc=handleWorkspaceRaw streams one workspace file's exact bytes — the download\npath of the Files page. Unlike the JSON editor read it is binary-safe and\nuncapped. Images / video / audio serve inline (thumbnails, previews);\neverything else downloads as an attachment so user-uploaded markup can\nnever execute on this origin (the /media stored-XSS posture).
EDGES
  ^contains=matrix/neo/internal/server.Server
  ^defines=matrix/neo/internal/server/workspace.go

NODE id=matrix/neo/internal/server.Server.handleWorkspaceTree kind=method
  digest=b3:23b7d6c450b6a0eef0bda60a58d979464909519a89be511617ecd3f600ff99d8 file=neo/internal/server/workspace.go range=228:276 lang=go exported=false byte_range=7233:8550
  sig=func (s *Server) handleWorkspaceTree(w http.ResponseWriter, r *http.Request)
  doc=handleWorkspaceTree serves the depth-first project listing.
EDGES
  ^contains=matrix/neo/internal/server.Server
  ^defines=matrix/neo/internal/server/workspace.go

NODE id=matrix/neo/internal/server.Server.handleWorkspaceUpload kind=method
  digest=b3:c4fb056fab2b80fd561d253c43de0dd345d1f067272ba9703e752d4d97d66899 file=neo/internal/server/workspace.go range=371:459 lang=go exported=false byte_range=11374:14375
  sig=func (s *Server) handleWorkspaceUpload(w http.ResponseWriter, r *http.Request)
  doc=handleWorkspaceUpload receives user files onto the REAL workspace — the\nsame root Neo's fs and exec tools mutate (POST multipart, one or more\n"file" parts, optional "dir" field targeting a workspace subdirectory).\nEach file lands atomically (temp + rename, the editor-save posture) under\nits own base name; the response reports the normalized workspace-relative\npaths so the client can show exactly what Neo will see.
EDGES
  ^contains=matrix/neo/internal/server.Server
  ^defines=matrix/neo/internal/server/workspace.go

