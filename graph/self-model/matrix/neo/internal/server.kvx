NODE id=matrix/neo/internal/server.Engine#automatrixWG kind=field
  digest=b3:5f1db78151d8c35bbc0f9765be7fd022e824ab0cf5e4e524eaf61a4254ce59ef file=neo/internal/server/engine.go range=214:218 lang=go exported=false byte_range=9785:10105
  sig=sync.WaitGroup
  doc=automatrixWG tracks the same dispatch goroutines for shutdown: Close\nwaits (bounded) so an in-flight settle never touches the pager after the\ncaller has closed it. A run that outlives the bound simply stays\nin_progress and is resumed at next boot (ResumeInProgressAutomatrix).
EDGES
  ^contains=matrix/neo/internal/server.Engine

