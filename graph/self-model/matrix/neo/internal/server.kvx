  digest=b3:608f4c2b380d86de720accb6009dbfadbda620a80811d8fdc201bd70575bfe55 file=neo/internal/server/dojo.go range=373:405 lang=go exported=false byte_range=14014:15428
  sig=func (s *Server) handleDojoLease(w http.ResponseWriter, r *http.Request, move func(string) (dojo.Session, error))
