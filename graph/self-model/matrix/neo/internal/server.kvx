  digest=b3:2aba87c50552f072b7704184f9afa15a62a00f336f5bed5d4782649012ca4459 file=neo/internal/server/sse.go range=157:170 lang=go exported=false byte_range=4830:5138
  sig=func (b *broker) closeRun(id string)
  doc=closeRun marks a topic done and closes all subscriber channels so their SSE\nhandlers return.
EDGES
  ^contains=matrix/neo/internal/server.broker
  ^defines=matrix/neo/internal/server/sse.go

NODE id=matrix/neo/internal/server.broker.drop kind=method
  digest=b3:8080c1ab11fdcbb7200c3426424f1dc2fd9e6e20d1fe8d8d8dd4a2dceb6dc6ce file=neo/internal/server/sse.go range=202:208 lang=go exported=false byte_range=5870:6081
  sig=func (b *broker) drop(id string)
  doc=drop discards a finished run's topic to bound memory. Called after a grace\nperiod so late reconnects can still replay.
EDGES
  ^contains=matrix/neo/internal/server.broker
  ^defines=matrix/neo/internal/server/sse.go

NODE id=matrix/neo/internal/server.broker.ensure kind=method
  digest=b3:faf7997ea013cf3237e00503092b6865eee3388390811a5bbe73c74d521d95bd file=neo/internal/server/sse.go range=80:87 lang=go exported=false byte_range=2432:3002
  sig=func (b *broker) ensure(id string)
  doc=ensure creates the topic for id if absent. session.start calls this at\ndispatch time — BEFORE POST /chat returns and before the run's first publish\n— so handleEvents/handleReplay/handleAsyncPoll recognise the id as Neo's the\ninstant the client connects. Without it the client's immediate subscribe\nloses the race against the first publish, has(id) is false, and the stream\nis reverse-proxied to the daemon's (empty) event stream forever — the run\ncompletes but the user never sees the answer.
EDGES
  ^contains=matrix/neo/internal/server.broker
  ^defines=matrix/neo/internal/server/sse.go

NODE id=matrix/neo/internal/server.broker.has kind=method
  digest=b3:baa34f4ec5500c8cc86ece145686b2ce447ac7e7067c3fdf378dd00472d67963 file=neo/internal/server/sse.go range=71:78 lang=go exported=false byte_range=2195:2430
  sig=func (b *broker) has(id string) bool
  doc=has reports whether a run id is one of Neo's own topics (vs. a daemon intent\nthe request should be reverse-proxied for).
EDGES
  ^contains=matrix/neo/internal/server.broker
  ^defines=matrix/neo/internal/server/sse.go

