NODE id=matrix/neo/internal/server.session.setActive kind=method
  digest=b3:005663a57b1013e679ee5105f52ac25d0a3138effee4ca028f1cc4167f3e4300 file=neo/internal/server/session.go range=944:953 lang=go exported=false byte_range=41077:41526
  sig=func (s *session) setActive(r *run)
  doc=setActive / clearActive / interruptActive coordinate barge-in. active is the\nlatest dispatched run; interruptActive cancels it (LIFO), so each new message\nsupersedes the one before whether it is running or still queued. clearActive\nonly nils active when it still points at r, so a turn that has already been\nsuperseded never clears its successor.
EDGES
  ^contains=matrix/neo/internal/server.session
  ^defines=matrix/neo/internal/server/session.go

NODE id=matrix/neo/internal/server.session.startResume kind=method
  digest=b3:37708e80b0416927c8627d9c76be0b12e72bcc8a13c9ab4b26529e51f9344145 file=neo/internal/server/session.go range=348:353 lang=go exported=false byte_range=13793:14105
  sig=func (s *session) startResume(objective string) *run
  doc=startResume re-dispatches an orphaned task (the boot reaper after a restart /\nFly suspend): it drives the original objective with the catch-up prime from\nattempt one, since work may already exist on the volume.
EDGES
  ^contains=matrix/neo/internal/server.session
  ^defines=matrix/neo/internal/server/session.go

NODE id=matrix/neo/internal/server.session.submit kind=method
  digest=b3:b552cec119e3453add87119a932c486d2118cbf6c7fd3fdf1b61c73eed6cef80 file=neo/internal/server/session.go range=320:330 lang=go exported=false byte_range=12442:13148
  sig=func (s *session) submit(message string) (runID string, fresh bool)
  doc=submit routes a fresh user message (F5: non-interrupting). If a turn is\nalready in flight for this conversation, the message is QUEUED into the live\nagent's inbox — delivered at the agent's NEXT tool-call boundary without\ninterrupting the run — and submit returns the active run's id with fresh\nfalse (the client keeps watching the same live stream). Otherwise it\ndispatches a fresh run and returns its id with fresh true. The active check\nand the dispatch are atomic under actMu so two near-simultaneous messages\nnever both spawn a run (the second folds into the first).
EDGES
  ^contains=matrix/neo/internal/server.session
  ^defines=matrix/neo/internal/server/session.go

NODE id=matrix/neo/internal/server.session.submitWith kind=method
  digest=b3:bf2d70aa7cb405af90aaad68d44b0a6561d22a3733c383c6bb91ca204bf90c6a file=neo/internal/server/session.go range=332:346 lang=go exported=false byte_range=13150:13791
  sig=func (s *session) submitWith(message string, onFinish func(task.Status)) (runID string, fresh bool)
  doc=submitWith is submit with a terminal observer: when the message dispatches a\nFRESH run, onFinish is attached to it (invoked once with the run's terminal\ntask status). When the message is queued into an already-live run, no hook is\nattached (the live run belongs to other work) and fresh=false tells the\ncaller so.
EDGES
  ^contains=matrix/neo/internal/server.session
  ^defines=matrix/neo/internal/server/session.go

NODE id=matrix/neo/internal/server.session.superviseAutomatrixTask kind=method
  digest=b3:742e9cc2dae6169449ec23566ac726c2374b103a209fa0de92f13dd08c645d61 file=neo/internal/server/session.go range=890:942 lang=go exported=false byte_range=38636:41075
  sig=func (s *session) superviseAutomatrixTask(ctx context.Context, objective string) task.Status
  doc=superviseAutomatrixTask is the QUIET sibling of superviseTask for an\nautonomous Automatrix run (task 4.1, req 5.1/5.3/5.4/5.5). It mirrors the\nreal supervisor's policy EXACTLY — the same pure superviseDecision over the\nagent's clean finish / failure class / wall-clock, the same jittered backoff,\nthe same FRESH-agent respawn over durable state across a non-clean exit — so\na proactive run is held to the SAME loop discipline (inside agent.Chat:\nno-progress stall / step budget / the unified unproductive counter, plus the\nCassandra 2.0 silent-voice controller) as any interactive turn. The two\ndifferences from superviseTask are deliberate: (1) the agent is the\nRESTRICTED no-money surface (the session was minted with automatrix=true), and\n(2) it surfaces NOTHING — no SSE/broker terminals, no honest-partial bubble in\nthe thread (req 5.5: a partial/failed proactive attempt is silent, never\nfailed-surprise spam). It returns the terminal task.Status so the runner can\nsettle the opportunity (done vs pending+attempts). A user stop cannot happen\nhere (no live run / no barge-in), so actInterrupted is unreachable.
EDGES
  ^contains=matrix/neo/internal/server.session
  ^defines=matrix/neo/internal/server/session.go

NODE id=matrix/neo/internal/server.session.superviseTask kind=method
  digest=b3:b806db646ca1eb99115d0b3beea2ef99f64d21143cdcb23765d4d79a0be1fe52 file=neo/internal/server/session.go range=525:598 lang=go exported=false byte_range=21619:24923
  sig=func (s *session) superviseTask(ctx context.Context, r *run, objective string, resume bool) task.Status
  doc=superviseTask keeps at least one agent on the task until it is genuinely\ncomplete (the agent's own completion gate accepts and it Says its answer), is\ninterrupted by the user, or hits a hard ceiling. Every non-clean exit — a\nmodel/transport error, a no-progress stall, an exhausted step budget, a\nstuck attempt that timed out — is treated as "not done": it checkpoints, tells\nthe user it is still working (never a fake "done"), backs off, respawns a\nFRESH agent over durable state, and goes again.
EDGES
  ^contains=matrix/neo/internal/server.session
  ^defines=matrix/neo/internal/server/session.go

