NODE id=matrix/neo/internal/server.Server.handleDojoSession kind=method
  digest=b3:0a34a379b7f8bc47051adee073db904942ca271e1db9d85a57bdbeb2b555382e file=neo/internal/server/dojo.go range=210:237 lang=go exported=false byte_range=7313:8353
  sig=func (s *Server) handleDojoSession(w http.ResponseWriter, r *http.Request)
  doc=handleDojoSession serves GET /dojo/session?conversation={id}: the live dojo\nsession snapshot for a conversation (or null), so a freshly opened client can\nseed its desktop panel without replaying the whole trace.
EDGES
  ^contains=matrix/neo/internal/server.Server
  ^defines=matrix/neo/internal/server/dojo.go

NODE id=matrix/neo/internal/server.Server.handleDojoShutdown kind=method
  digest=b3:4f22e9e6668cf195dc14e74dea3e84d1ecb6e2867bfc97768fdc373ac6495814 file=neo/internal/server/dojo.go range=322:353 lang=go exported=false byte_range=11811:13192
  sig=func (s *Server) handleDojoShutdown(w http.ResponseWriter, r *http.Request)
  doc=handleDojoShutdown serves POST /dojo/shutdown {conversation_id}: the USER\nturns the desktop off. This is the normal teardown pipeline — work ships\nhome first (req 5.1); it is NOT a discard. Idempotent: shutting down an\nalready-off desktop answers 200 with a null session.
EDGES
  ^contains=matrix/neo/internal/server.Server
  ^defines=matrix/neo/internal/server/dojo.go

NODE id=matrix/neo/internal/server.Server.handleDojoTakeover kind=method
  digest=b3:61cb097d687665fca6f975c9a00a5a854740e2317762d69fd18bf7297302c683 file=neo/internal/server/dojo.go range=355:362 lang=go exported=false byte_range=13194:13622
  sig=func (s *Server) handleDojoTakeover(w http.ResponseWriter, r *http.Request)
  doc=handleDojoTakeover serves POST /dojo/takeover {conversation_id}: the human\ntakes the control lease (req 4.2). While held, agent desktop calls are\nrejected with takeover_active; the human's input passes through /dojo/input.
EDGES
  ^contains=matrix/neo/internal/server.Server
  ^defines=matrix/neo/internal/server/dojo.go

