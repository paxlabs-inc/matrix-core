NODE id=matrix/neo/internal/server.Server.handleDeleteProject kind=method
  digest=b3:26ed6665657c6077c8bf5cc8f19143bd9ee72adf268e6c053e617ed3b8500d66 file=neo/internal/server/projects.go range=771:801 lang=go exported=false byte_range=22765:23917
  sig=func (s *Server) handleDeleteProject(w http.ResponseWriter, r *http.Request, id string)
  doc=handleDeleteProject removes a project from the registry. It REFUSES while a\nrun is live in that project. With ?purge=true the workspace subtree is also\nremoved (strict-subdirectory guarded).
EDGES
  ^contains=matrix/neo/internal/server.Server
  ^defines=matrix/neo/internal/server/projects.go

