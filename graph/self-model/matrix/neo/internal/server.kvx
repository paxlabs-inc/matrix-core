NODE id=matrix/neo/internal/server.Engine.subagentSelfModelBrief kind=method
  digest=b3:f31a6f6fbadcc216dda3731be33ea4f8c69d9e9831f05b09efea1851e4e8b0d0 file=neo/internal/server/swarm.go range=440:481 lang=go exported=false byte_range=15713:17061
  sig=func (e *Engine) subagentSelfModelBrief(ctx context.Context) string
  doc=subagentSelfModelBrief renders the shared self-model each sub-agent inherits\nat spawn (self-model task 4.3, req.9.1): the structural self-summary (how the\nagent is built) plus the most salient how-I-fail patterns (what to avoid). It\nis resolved once per swarm from the shared Neocortex pager. Returns "" when no\npager is wired or the self-model is empty (a fresh install before the\nself-graph is loaded) — the sub-agent then runs on its persona + bounds alone,\nnever blocked on the self-model.
EDGES
  ^contains=matrix/neo/internal/server.Engine
  ^defines=matrix/neo/internal/server/swarm.go

NODE id=matrix/neo/internal/server.Engine.submitNormalizedMessage kind=method
  digest=b3:27d394a40e16d48e872cf1ad9fbc54191e08703a5c8dd4c2fa15eace8b3f28f6 file=neo/internal/server/channel_submit.go range=16:54 lang=go exported=false byte_range=277:1946
  sig=func (e *Engine) submitNormalizedMessage(ctx context.Context, envelope channelgateway.Envelope) (runID, conversationID string, duplicate bool, err error)
  doc=submitNormalizedMessage is the one channel-adapter submission seam. It\ndeliberately delegates to the existing session registry and idempotent\nsubmit operation; it does not own a loop, context, completion, or delivery.
EDGES
  ^contains=matrix/neo/internal/server.Engine
  ^defines=matrix/neo/internal/server/channel_submit.go

NODE id=matrix/neo/internal/server.Engine.surfaceSubagentStep kind=method
  digest=b3:693908ae6fafeb2f7623e7fc7d1bd3b1dfe72a2b09488c1271cf95b9a97e84d3 file=neo/internal/server/swarm.go range=404:418 lang=go exported=false byte_range=14384:14975
  sig=func (e *Engine) surfaceSubagentStep(r *run, swarmID string, index int, name string, ev agent.ToolEvent)
  doc=surfaceSubagentStep mirrors surfaceTool for a sub-agent: the same animated\nworkspace step (terminal / browser / editor / …), tagged with the swarm +\nagent index so the client routes it into that sub-agent's own window.
EDGES
  ^contains=matrix/neo/internal/server.Engine
  ^defines=matrix/neo/internal/server/swarm.go

NODE id=matrix/neo/internal/server.Engine.surfaceTool kind=method
  digest=b3:026022d318da45642f383d0283c6b832e32657ddfa5aa8d34b9889144ac9cfcb file=neo/internal/server/engine.go range=1274:1385 lang=go exported=false byte_range=53859:58453
  sig=func (e *Engine) surfaceTool(r *run, ev agent.ToolEvent)
  doc=surfaceTool turns a tool call into the live "Neo Workspace" — a single\n`tool.step` event the client renders as an ANIMATED VIEWPORT of the action\nitself: a terminal when Neo runs a command, a browser window when it\nbrowses, an editor when it reads/writes files. The same step id is updated\nfrom running→done across the start/end pair, so the viewport fills in place\nrather than appending a new card. Web-search results and generated media ALSO\nkeep their dedicated rich events (cards / media grid) on completion.
EDGES
  ^contains=matrix/neo/internal/server.Engine
  ^defines=matrix/neo/internal/server/engine.go

NODE id=matrix/neo/internal/server.Engine.sweepMedia kind=method
  digest=b3:86be59b2e88b2ce49487eee3f7dd6de5cd6a05b9024c478977a26ebb9fb32143 file=neo/internal/server/media_filmstrip.go range=107:132 lang=go exported=false byte_range=3733:4431
  sig=func (e *Engine) sweepMedia()
  doc=sweepMedia removes served media files whose mtime is older than the retention\nwindow. Best-effort per file: a stat/remove error on one file never aborts the\nsweep. Directories are skipped (the media dir is flat).
EDGES
  ^contains=matrix/neo/internal/server.Engine
  ^defines=matrix/neo/internal/server/media_filmstrip.go

