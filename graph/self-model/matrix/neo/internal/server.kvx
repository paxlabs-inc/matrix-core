  digest=b3:56290381dd67899aa75d443b0825e8a2eb4d22e99ce54c9512b18d0ab79f710b file=neo/internal/server/session.go range=719:728 lang=go exported=false byte_range=30623:31145
  sig=func (e deathEntry) durableSummary() string
  doc=durableSummary renders the entry as the durable cortex death-journal line: the\nunchanged prefix from last session (objective, attempt, class, digest) plus\nthe agent's rich loop-state suffix (self-model task 2.2), so the record\ncarries the actual failure MODE, not just a sentence.
