NODE id=matrix/neo/internal/server.Server.handleChat kind=method
  digest=b3:3646910b265b8b4ac5d9ab607cdccbab92d0f8990ada39fc40af5507ea69e57a file=neo/internal/server/server.go range=232:293 lang=go exported=false byte_range=10604:13433
