NODE id=matrix/neo/internal/server.parseAlarmID kind=func
  digest=b3:9ddf53afb36db6523abf609aaa1f3ffc64a8d97fad221cc0a9efd3d77eedbda7 file=neo/internal/server/automatrix_governor.go range=327:343 lang=go exported=false byte_range=12942:13639
  sig=func parseAlarmID(out string) string
  doc=parseAlarmID extracts the created alarm's id from the alarm_set result. The\nchronos MCP bridge (tools/chronos/chronos.mjs envelopeResult) returns the\nchronosd envelope {"ok":true,"data":{"id":...,"next_fire_at":...,"status":...}}\nas the tool text, so the id normally lives one level down at data.id; a bare\n{"id":...} object is also accepted. Best-effort: parse the first JSON object\ncarrying an "id", descending through "data"/"alarm" wrappers.
EDGES
  ^defines=matrix/neo/internal/server/automatrix_governor.go

NODE id=matrix/neo/internal/server.parseArtifact kind=func
  digest=b3:c61e78ca3d7c4db26f93f9135169cc1ce2bfefd2f35f24abc7a65ea4142cb39f file=neo/internal/server/engine.go range=1477:1504 lang=go exported=false byte_range=61339:62408
  sig=func parseArtifact(raw string) (artifactPayload, bool)
  doc=parseArtifact recognises a successful artifact-tool result. It accepts both\nthe nested ({ok:true,artifact:{kind,url,…}}) and the flat ({ok,kind,url,…})\nshapes, requires a deliverable kind + a URL ref, and never matches a media or\nsearch result (kind gating). Returns (payload, false) on any other shape so\nthe additive event is emitted ONLY for genuine deliverables.
EDGES
  ^defines=matrix/neo/internal/server/engine.go

NODE id=matrix/neo/internal/server.parseAskAnswerPath kind=func
  digest=b3:f56deb88f4804ab3f71add919c23a1f3559c67f17a69f99e072b8e16a40708c9 file=neo/internal/server/server.go range=1119:1126 lang=go exported=false byte_range=51045:51379
