  ^defines=matrix/neo/internal/server/improvement.go

NODE id=matrix/neo/internal/server.Engine.runOneSubagent kind=method
  digest=b3:38f9a16b4205606f0ac2aefa0427efc4fa22808cead40794bd0ac48ad7fa96ff file=neo/internal/server/swarm.go range=178:273 lang=go exported=false byte_range=6212:9965
  sig=func (e *Engine) runOneSubagent(ctx context.Context, r *run, swarmID string, index int, spec tools.SubagentSpec, selfModel string) subResult
  doc=runOneSubagent builds and runs a single headless sub-agent to completion,\nstreaming its workspace activity onto the parent stream tagged with its\nindex, and returns its distilled report. A hard failure with no usable output\nis retried with a fresh window (bounded by subagentMaxAttempts) so a\ntransient provider error doesn't kill the sub-agent outright.
EDGES
  ^contains=matrix/neo/internal/server.Engine
  ^defines=matrix/neo/internal/server/swarm.go

NODE id=matrix/neo/internal/server.Engine.runSwarm kind=method
  digest=b3:451d1b92f093f052effc591955bbd727c3b6bbcf305dba4369654fe355ce837a file=neo/internal/server/swarm.go range=87:176 lang=go exported=false byte_range=3041:6210
  sig=func (e *Engine) runSwarm(ctx context.Context, specs []tools.SubagentSpec) (string, error)
  doc=runSwarm is the SwarmFunc wired into the tool manager. It fans a set of\ntask-scoped sub-agents out to run CONCURRENTLY — each its own headless agent\nloop over a fresh, isolated context window with the positive read-only\nresearch tool surface — streams their progress onto the parent\nconversation's event stream as a live Agent Swarm, and returns an aggregated,\nmodel-readable digest of their findings. Heavy tool work stays in the\nsub-agents' windows; only the distilled results return to the parent's.
EDGES
  ^contains=matrix/neo/internal/server.Engine
  ^defines=matrix/neo/internal/server/swarm.go

NODE id=matrix/neo/internal/server.Engine.savePersonalizationProfile kind=method
  digest=b3:4c72d6e75bb617f65331b4564b8185cd9697b83f10a0041889349f6e2afc9c3c file=neo/internal/server/interview_routes.go range=54:79 lang=go exported=false byte_range=2042:3303
  sig=func (e *Engine) savePersonalizationProfile(ctx context.Context, profileJSON []byte) (string, error)
  doc=savePersonalizationProfile is the engine-side writer behind the\nconfirmation-gated save_personalization_profile tool (task 5.3): it decodes\nthe confirmed profile JSON and persists it as the single versioned Neocortex\nrecord through the real pager (req 13.1).
EDGES
  ^contains=matrix/neo/internal/server.Engine
  ^defines=matrix/neo/internal/server/interview_routes.go

