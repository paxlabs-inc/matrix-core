NODE id=matrix/neo/internal/server.commandQueue kind=type
  digest=b3:e07b8ccc37b2026990806445605dc4bd9b1e4c89bdc4dfe378234365bf7c985b file=neo/internal/server/queue.go range=26:65 lang=go exported=false byte_range=735:2301
  sig=type commandQueue struct {\n	mode	QueueMode\n\n	mu	sync.Mutex\n	pending	[]string\n	gen	uint64	// current generation (last dispatched or superseded)\n	active	bool	// a turn is in flight\n	notify	chan struct{}\n\n	// executor runs one turn. gen is the turn's generation. The context is\n	// cancelled on Stop/supersede. Returns the turn's terminal error\n	// (nil = clean completion).\n	executor	func(ctx context.Context, gen uint64, message string) error\n\n	// onResult is called (in the pump goroutine) when a turn completes, ONLY\n	// if the turn's generation is still current (not superseded). Stale\n	// results are silently dropped.\n	onResult	func(gen uint64, err error)\n\n	runCancel	context.CancelFunc	// cancels the active turn's context\n\n	ctx	context.Context\n	cancel	context.CancelFunc\n	wg	sync.WaitGroup\n	started	bool\n}
  doc=commandQueue is the per-session command lane. It guarantees strict serial\nexecution — no two turns overlap within a session — and processes queued\ninbound messages according to its mode:\n\n  - QueueCollect: coalesce queued messages into one followup turn.\n  - QueueFollowup: run each queued message as its own turn, in FIFO order.\n\nA monotonically increasing generation counter tags every dispatched turn.\nA result whose generation has been superseded (by an explicit Stop or a\nnewer dispatch) is discarded as stale — the onResult callback fires ONLY for\nthe current generation.\n\nThis implements P2-6 (lane-based concurrency). Steer / nextTurn are out of\nscope and logged as a follow-up.
EDGES
  contains=matrix/neo/internal/server.commandQueue#active,matrix/neo/internal/server.commandQueue#cancel,matrix/neo/internal/server.commandQueue#ctx,matrix/neo/internal/server.commandQueue#executor,matrix/neo/internal/server.commandQueue#gen,matrix/neo/internal/server.commandQueue#mode,matrix/neo/internal/server.commandQueue#mu,matrix/neo/internal/server.commandQueue#notify,matrix/neo/internal/server.commandQueue#onResult,matrix/neo/internal/server.commandQueue#pending,matrix/neo/internal/server.commandQueue#runCancel,matrix/neo/internal/server.commandQueue#started,matrix/neo/internal/server.commandQueue#wg,matrix/neo/internal/server.commandQueue.Close,matrix/neo/internal/server.commandQueue.Enqueue,matrix/neo/internal/server.commandQueue.Generation,matrix/neo/internal/server.commandQueue.IsStale,matrix/neo/internal/server.commandQueue.Start,matrix/neo/internal/server.commandQueue.Stop,matrix/neo/internal/server.commandQueue.drainLocked,matrix/neo/internal/server.commandQueue.pump
