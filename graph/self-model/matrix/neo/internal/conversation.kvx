  digest=b3:a4ced17b584f40f58541082aa2d81e831638fb10104b3a57ab41144dcd2084d7 file=neo/internal/conversation/store.go range=327:336 lang=go exported=false byte_range=11107:11347
  sig=func buildJSONL(turns []Turn) []byte
  doc=buildJSONL serializes a turn slice as newline-delimited JSON.
EDGES
  ^defines=matrix/neo/internal/conversation/store.go

