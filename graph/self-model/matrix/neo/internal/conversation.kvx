  sig=func (s *Store) metaAD(convID string) vault.AD
  doc=metaAD reconstructs the associated data for a conversation's meta sidecar —\nnever stored, so a sidecar moved between users or conversations fails auth.
EDGES
  ^contains=matrix/neo/internal/conversation.Store
  ^defines=matrix/neo/internal/conversation/store.go

