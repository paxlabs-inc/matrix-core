  digest=b3:e28a3b68317130bbc4e1cb117ed34cb0d99feb0128a28390b7ac61a716b60d5e file=neo/internal/conversation/store.go range=121:133 lang=go exported=false byte_range=4767:5122
  sig=func retainedTurnsFromEnv() int
  doc=retainedTurnsFromEnv reads the NEO_CONVERSATION_RETAINED_TURNS env var; an\nabsent/invalid value yields 0 (Open then applies the default).
