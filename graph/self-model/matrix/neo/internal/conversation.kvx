NODE id=matrix/neo/internal/conversation.Store.nextSeqLocked kind=method
  digest=b3:5ee49c2f612c97d1503b346d01ba38ba5c7a8c2004ed87036512db1b7e137e15 file=neo/internal/conversation/store.go range=143:156 lang=go exported=false byte_range=5493:5911
  sig=func (s *Store) nextSeqLocked(path string) uint64
  doc=nextSeqLocked returns the next record sequence for a file, seeding the cache\nonce by counting existing lines so the seq binds each record to its position\nwhile keeping appends O(1). Caller MUST hold s.mu.
EDGES
  ^contains=matrix/neo/internal/conversation.Store
  ^defines=matrix/neo/internal/conversation/store.go

NODE id=matrix/neo/internal/conversation.Store.pathLocked kind=method
  digest=b3:71066515dbd9b7cd600e7f151202f5515e528e1ca99e6d82b342dcf5d1ce6f73 file=neo/internal/conversation/store.go range=212:217 lang=go exported=false byte_range=7483:7631
  sig=func (s *Store) pathLocked(convID string) string
EDGES
  ^contains=matrix/neo/internal/conversation.Store
  ^defines=matrix/neo/internal/conversation/store.go

NODE id=matrix/neo/internal/conversation.Store.readTurns kind=method
  digest=b3:f26bf5c766cb1fd7a13d8a8f51eb26006447c43f1e458e0d524ac6fce39301cc file=neo/internal/conversation/store.go range=267:312 lang=go exported=false byte_range=9087:10481
  sig=func (s *Store) readTurns(storeType, stream, path string) ([]Turn, time.Time)
  doc=readTurns parses a newline-delimited turn file, decrypting each record under\nthe reconstructed associated data (legacy plaintext lines pass through until\nmigrated). A line that fails to decrypt or unmarshal — including a wrong-key,\ntampered, or crash-truncated final line — is skipped; the record sequence\nstill advances so surviving records stay bound to their positions. Returns\n(turns, latestUpdated).
EDGES
  ^contains=matrix/neo/internal/conversation.Store
  ^defines=matrix/neo/internal/conversation/store.go

NODE id=matrix/neo/internal/conversation.Store.rollIfOverCapLocked kind=method
  digest=b3:0063e6737b8d689e68994d4bb348b41ba6fc33d68b3be796a4a88185a8c467ec file=neo/internal/conversation/store.go range=377:425 lang=go exported=false byte_range=12549:14387
  sig=func (s *Store) rollIfOverCapLocked(convID string)
  doc=rollIfOverCapLocked moves the oldest overflow turns from the hot .jsonl to\nthe archive when the hot set exceeds the retained cap. The archive rollup\nuses the rename-based atomic write (tmp+rename) — the ONLY place that path\nis used now. Caller MUST hold s.mu.
EDGES
  ^contains=matrix/neo/internal/conversation.Store
  ^defines=matrix/neo/internal/conversation/store.go

NODE id=matrix/neo/internal/conversation.Store.saveMetaLocked kind=method
  digest=b3:6ce4bccf95aead0934fce1bc72a47298731678d9b89f1a55a2dc9eb54c26fa9d file=neo/internal/conversation/store.go range=516:544 lang=go exported=false byte_range=17082:18173
  sig=func (s *Store) saveMetaLocked(convID string, m convMeta)
  doc=saveMetaLocked persists a conversation's meta sidecar (atomic tmp+rename,\nsealed at rest when the vault is wired). Caller MUST hold s.mu. Best-effort\nlike Append: IO errors are logged, never fatal.
EDGES
  ^contains=matrix/neo/internal/conversation.Store
  ^defines=matrix/neo/internal/conversation/store.go

