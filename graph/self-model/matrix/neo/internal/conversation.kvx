NODE id=matrix/neo/internal/conversation.appendJSONLTurn kind=func
  digest=b3:414c342acb0fe792155b60fb7b00a496680a96e1c2f376cc67c7a757164dfb68 file=neo/internal/conversation/store.go range=232:251 lang=go exported=false byte_range=7934:8541
  sig=func appendJSONLTurn(path string, turn Turn) error
  doc=appendJSONLTurn appends one turn as a single JSON line to path. O_APPEND +\na single Write makes the line atomically visible (POSIX) — no reader can see\na half-written line. Crash-atomic: a torn write yields an unparseable final\nline that readJSONLTurns skips.
EDGES
  ^defines=matrix/neo/internal/conversation/store.go

