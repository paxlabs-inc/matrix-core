NODE id=matrix/neo/internal/conversation.readJSONLTurns kind=func
  digest=b3:b90db5000010068e858b7684b657e26c0f7a00e4883658c781d98c7a4407bfd8 file=neo/internal/conversation/store.go range=193:230 lang=go exported=false byte_range=6846:7932
  sig=func readJSONLTurns(path string) ([]Turn, time.Time)
  doc=readJSONLTurns parses a newline-delimited JSON turn file. A line that fails\nto unmarshal (including a crash-truncated final line with no trailing\nnewline) is skipped — crash-atomic. Returns (turns, latestUpdated).
EDGES
  ^defines=matrix/neo/internal/conversation/store.go

