NODE id=matrix/neo/internal/memory.patternMode kind=func
  digest=b3:9acce48ce614c7a09e23ab9eb47c87892f01c74bc78b728ba7b86b2f95d1d2c1 file=neo/internal/memory/consolidate.go range=177:182 lang=go exported=false byte_range=5957:6291
