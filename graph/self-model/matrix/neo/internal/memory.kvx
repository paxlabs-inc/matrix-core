  ^defines=matrix/neo/internal/memory/relation.go

NODE id=matrix/neo/internal/memory.RelationSupersedes kind=const
  digest=b3:ecb0126abd5a5cb9945c00426896e90785c8169bd299a99aa892720b6c908ea3 file=neo/internal/memory/relation.go range=31:34 lang=go exported=true byte_range=1070:1325
  sig=memory.Relation
  doc=RelationSupersedes: refines/replaces the older memory (e.g. a\ncorrection or an updated preference). Write the new one, then link\nnew -> old with EdgeSupersedes so the stale one drops out of retrieval.
EDGES
  ^defines=matrix/neo/internal/memory/relation.go

