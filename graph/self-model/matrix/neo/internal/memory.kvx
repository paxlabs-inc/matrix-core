NODE id=matrix/neo/internal/memory.ClassifyFinancial kind=func
  digest=b3:6042d4940989d1a29488ba51452126556fe70a102b575a52ee323bd80bf921d7 file=neo/internal/memory/classifier.go range=110:139 lang=go exported=true byte_range=6141:7254
  sig=func ClassifyFinancial(summary string) bool
  doc=ClassifyFinancial reports whether the opportunity summary describes work with\na deterministic financial / on-chain ACTION signal. It is the reusable\nkeyword + symbol re-check that backs EligibleForAutonomy; it never consults\nthe extraction model's flag, so it is a pure, side-effect-free function of\nthe summary text. An analysis-framed task (see analysisFramed) is never\nfinancial: its deliverable is words about money, not a movement of it —\nkeyword topics like "price"/"subscription"/"token" in a modeling task must\nnot disqualify autonomous work the restricted surface already makes safe.
EDGES
  ^defines=matrix/neo/internal/memory/classifier.go

NODE id=matrix/neo/internal/memory.DeathRecord kind=type
  digest=b3:094184bb594f523e0413de5d506dda91e77f2771d2e54db80d3944ad33575e8c file=neo/internal/memory/deathjournal.go range=33:43 lang=go exported=true byte_range=1291:1825
  sig=type DeathRecord struct {\n	URI		string\n	Summary		string\n	CreatedAt	time.Time\n}
  doc=DeathRecord is one durable death-journal entry read back from cortex — the\nfirst-class read side of the durable death path (self-model task 3.1). The\nSummary is the full death-journal line written by RecordLoopDeath (objective,\nattempt, class, where-it-got-stuck digest, and the rich loop-state suffix), so\na consumer (the self-authoring pass, the observability surface) can parse the\nfailure MODE from it without a second fetch.
EDGES
  contains=matrix/neo/internal/memory.DeathRecord#CreatedAt,matrix/neo/internal/memory.DeathRecord#Summary,matrix/neo/internal/memory.DeathRecord#URI
  ^defines=matrix/neo/internal/memory/deathjournal.go

