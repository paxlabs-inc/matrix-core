NODE id=matrix/neo/internal/memory.Pager.Transcript kind=method
  digest=b3:9d3d69993a12666cef9fec3a1d5ebc0d0869e207d0575b604fb5847490a4fc08 file=neo/internal/memory/pager.go range=149:156 lang=go exported=true byte_range=4902:5426
  sig=func (p *Pager) Transcript(conv string, sinceSeq uint64, limit int) ([]cortex.Message, error)
  doc=Transcript reads the durable conversation transcript back from cortex (a thin\ndelegate to cortex.Transcript). It is a pure read — no journal append, no SMT\nwrite — and returns messages from sinceSeq onward, up to limit (0 = all). Used\nto observe the durable ground truth (e.g. that Cassandra's in-window overlay\nnever rewrote what the agent actually said).
EDGES
  ^contains=matrix/neo/internal/memory.Pager
  ^defines=matrix/neo/internal/memory/pager.go

NODE id=matrix/neo/internal/memory.Pager.TriggeredGuidance kind=method
  digest=b3:85917f217a17811543bb1ff438453a57292b5d492c453045dcd5c4a4d1c566da file=neo/internal/memory/trigger.go range=53:130 lang=go exported=true byte_range=2521:4939
  sig=func (p *Pager) TriggeredGuidance(ctx context.Context, turnText string) []Snippet
  doc=TriggeredGuidance returns behavioral guidance whose trigger matches the live\nturn by embedding similarity, independent of global salience. Sources:\n\n  - non-hard Constraints (hard ones are already pinned verbatim by\n    hardConstraints; surfacing them here would duplicate them);\n  - Patterns that carry a Trigger (an explicit "when to apply" behavior),\n    surfaced WITHOUT the procedural coverage gate because a trigger memory\n    encodes a behavior to apply now, not a proven recipe to reuse.\n\nEach result keeps its URI so the loop can attest it as USED like any other\nsurfaced memory. Requires an embedder (trigger matching is inherently\nsemantic); without one it returns nil so behavior stays salience-ranked.\nBest-effort: any error yields no trigger guidance (never load-bearing alone).
EDGES
  ^contains=matrix/neo/internal/memory.Pager
  ^defines=matrix/neo/internal/memory/trigger.go

