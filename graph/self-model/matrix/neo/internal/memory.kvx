  sig=func (p *Pager) UserProfile(ctx context.Context) []string
  doc=UserProfile returns the durable facts stored about the user themselves\n(subject matrix://knowledge/user), newest-versions-first, bounded.
EDGES
  ^contains=matrix/neo/internal/memory.Pager
  ^defines=matrix/neo/internal/memory/pager.go

