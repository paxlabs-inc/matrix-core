NODE id=matrix/neo/internal/memory.selfLookupPrefix kind=const
  digest=b3:b7cb0807f018ae2f85e7cb90a74518e7e1039ded24ae9e29773adaf4481c8d22 file=neo/internal/memory/self_model.go range=29:35 lang=go exported=false byte_range=688:1160
  sig=untyped string
  doc=selfLookupPrefix routes a memory_recall query to the structural\nself-graph instead of the ordinary cortex index: "self:<symbol>" pages\nthe fragment for that self-package symbol, and a bare "self:" returns the\nresident structural self-summary. Keeping it on the existing recall verb\n(rather than a new tool) satisfies req.2.2 — the full self-graph is\nreachable on demand through the retrieval verb the agent already has.
EDGES
  ^defines=matrix/neo/internal/memory/self_model.go

