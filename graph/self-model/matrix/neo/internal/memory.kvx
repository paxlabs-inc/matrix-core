NODE id=matrix/neo/internal/memory.Pager.lexicalExcerptMatchesTruth kind=method
  digest=b3:86adf88f3dd24546c4e8ceda8441e9e85dd71f06e19d27bff7f0a1c8f9728f3c file=neo/internal/memory/pager.go range=921:952 lang=go exported=false byte_range=32774:33922
  sig=func (p *Pager) lexicalExcerptMatchesTruth(ex EpisodicExcerpt, asOf time.Time) bool
  doc=lexicalExcerptMatchesTruth prevents an old transcript sentence from\nreactivating a fact that the authoritative memory lane has superseded or\ndeleted. Transcript search remains historical evidence, but current recall\nnever presents a verbatim match whose corresponding typed memory is not\ncurrent at the requested instant.
