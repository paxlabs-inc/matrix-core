NODE id=matrix/neo/internal/memory.Pager.lastUsedNano kind=method
  digest=b3:8a062ed9669e595f5f6148f00af64d16839e6026be21a5de0b281342efb7a7a8 file=neo/internal/memory/salience_realism.go range=79:92 lang=go exported=false byte_range=3175:3658
  sig=func (p *Pager) lastUsedNano(id memory.ID) int64
  doc=lastUsedNano returns the salience LastUsed timestamp (unix nano) for id, or\n0 when no salience record exists yet — so the per-type recency re-rank\ntreats an un-scored memory as fresh (multiplier 1.0) rather than maximally\nstale. Best-effort: a read error reads as 0 too.
EDGES
  ^contains=matrix/neo/internal/memory.Pager
  ^defines=matrix/neo/internal/memory/salience_realism.go

NODE id=matrix/neo/internal/memory.Pager.neighbors kind=method
  digest=b3:4955dda4cbc88878e93de92413bc5b7f8c60c6376a22f9c4de2dc61181c33ba7 file=neo/internal/memory/relation.go range=102:142 lang=go exported=false byte_range=4116:5358
  sig=func (p *Pager) neighbors(t memory.Type, text string, k int) []Neighbor
  doc=neighbors returns up to k live same-type memories nearest to text, ascending\nby distance. text MUST be the exact render cortex embeds for the candidate\nwrite — forms.RenderFull(head, data) — so the distances line up with the\ndedup path. The Find limit overshoots k so the same-type post-filter still\nyields up to k. Empty when text is blank or the embedder is unavailable.
EDGES
  ^contains=matrix/neo/internal/memory.Pager
  ^defines=matrix/neo/internal/memory/relation.go

