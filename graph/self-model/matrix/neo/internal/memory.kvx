NODE id=matrix/neo/internal/memory.Pager.InProgressOpportunities kind=method
  digest=b3:ae992e464d58f38c41f1c8fbfb47099471fddf636c06841ef8f8015e91007568 file=neo/internal/memory/writeback.go range=583:627 lang=go exported=true byte_range=22847:24296
  sig=func (p *Pager) InProgressOpportunities(ctx context.Context, limit int) ([]OpportunitySpec, error)
  doc=InProgressOpportunities returns the eligible-autonomous opportunities left in\nthe IN_PROGRESS state — the set a process restart must pick back up so a\nproactive task in flight when the daemon died is driven to completion (the\nTask Durability Rule, req 5.1). Only eligible_autonomous items are returned,\nso a restart can never resume work on anything but the restricted (non-\nfinancial) surface. Unranked (order is irrelevant for resume); capped at\nlimit (<=0 = all).
EDGES
  ^contains=matrix/neo/internal/memory.Pager
  ^defines=matrix/neo/internal/memory/writeback.go

NODE id=matrix/neo/internal/memory.Pager.LearnedGuidance kind=method
  digest=b3:089fd8028b2854dce2a2954ad6386fd023cd81ac5119007f600b9063fd234bfb file=neo/internal/memory/pager.go range=345:410 lang=go exported=true byte_range=12802:14992
  sig=func (p *Pager) LearnedGuidance(ctx context.Context) []string
  doc=LearnedGuidance returns short behavioral guidance lines Neo has LEARNED:\nnon-hard learned/declared Constraints (hard ones are pinned verbatim by\nhardConstraints) followed by strong durable Preferences. This is the\nstructural fix for "Neo keeps forgetting a learned behavior" — a correction\nor working preference (e.g. "render a Construct surface while working")\nbecomes a line pinned to EVERY turn, changing behavior reliably instead of\ndepending on salience-ranked retrieval luck. Ranked by the Find planner's\nsalience-desc default and bounded by learnedGuidanceMax.
EDGES
  ^contains=matrix/neo/internal/memory.Pager
  ^defines=matrix/neo/internal/memory/pager.go

NODE id=matrix/neo/internal/memory.Pager.LinkSessionProvenance kind=method
  digest=b3:76f8dc7656bafc2cef926fb5bf538c114fa7de0649c19650748ed53b24454390 file=neo/internal/memory/writeback.go range=19:40 lang=go exported=true byte_range=330:1305
  sig=func (p *Pager) LinkSessionProvenance(memURI, conv string, seqLo, seqHi uint64) error
  doc=LinkSessionProvenance adds a derived_from provenance edge from a\nconsolidated memory (memURI) back to the session transcript slice it was\nextracted from — the (conv, seqLo, seqHi) span the consolidator knows at\nwrite time (DEJA-VU req 1.1). It is a thin delegate to\ncortex.AddSessionProvenance. Best-effort per the fail-open doctrine for the\nwrite path: an empty URI (a deduped write returns none) or a blank\nconversation is a no-op; a parse/edge error is returned for the caller to\nswallow so a failed edge never fails the memory write.
EDGES
  ^contains=matrix/neo/internal/memory.Pager
  ^defines=matrix/neo/internal/memory/writeback.go

