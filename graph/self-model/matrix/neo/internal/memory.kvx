NODE id=matrix/neo/internal/memory.Pager.AppendMessage kind=method
  digest=b3:c6612f2d34f5a83dc262b26bdf928452329364e4d650e514a8f6ddab1a8b01aa file=neo/internal/memory/pager.go range=139:147 lang=go exported=true byte_range=4377:4900
  sig=func (p *Pager) AppendMessage(m cortex.Message) (memory.URI, error)
  doc=AppendMessage records one conversation message durably in the cortex\nsession/transcript store (continuous-memory task 6.1). It is a thin delegate\nto cortex.AppendMessage — under the continuous-memory collapse the pager is\nthe agent-side shim over the cortex brain, holding no independent state. The\nderived-lane discipline (journal entry + sess/ record, NO SMT write) lives\nentirely inside cortex.
EDGES
  ^contains=matrix/neo/internal/memory.Pager
  ^defines=matrix/neo/internal/memory/pager.go

NODE id=matrix/neo/internal/memory.Pager.AttestRejected kind=method
  digest=b3:49dd37068ad6e5b0b2033f15ee1a8e955fa9f9a3236dde7a7d3a016303f65470 file=neo/internal/memory/salience_realism.go range=178:221 lang=go exported=true byte_range=6605:8159
  sig=func (p *Pager) AttestRejected(ctx context.Context, intentID string, ignoredURIs []string)
  doc=AttestRejected records that the given memories were surfaced into a turn but\ndemonstrably ignored, sending the negative salience signal (DecrementCitation\n+ EMA-away via cortex's decrementOnFailure path) so memories that crowd the\nbudget without being used decay out of the working set over time.\n\nThe attest is Outcome=Failure, Reason=wrong_assumption: surfacing the memory\nassumed a relevance the produced turn did not bear out, and wrong_assumption\nis one of the two §8.3 reasons that trigger the citation decrement. The\ncaller is responsible for passing only memories that cleared the\nRejectionCandidates guardrails (off-topic, non-pinned, capped). Best-effort\nand never blocks the turn — a failed attest just skips the signal.
EDGES
  ^contains=matrix/neo/internal/memory.Pager
  ^defines=matrix/neo/internal/memory/salience_realism.go

NODE id=matrix/neo/internal/memory.Pager.AttestUsed kind=method
  digest=b3:67888039ae30c566baa109bda4016cf50fb7550529fa9b98c3710eba242512f5 file=neo/internal/memory/writeback.go range=772:819 lang=go exported=true byte_range=28619:30283
  sig=func (p *Pager) AttestUsed(ctx context.Context, intentID string, citedURIs []string, success bool)
  doc=AttestUsed records that the given cortex memories were surfaced into a\ncompleted turn, feeding the usage-based salience signals (access +\ncitation) and the per-actor EMA weight learner via cortex.Attest. This is\nwhat turns the cortex LEARNING LOOP ON for Neo: Neo's page-fault Find calls\nare compile-time (no journal, no access bump), so without this the actor's\nsalience would stay frozen at the cold recency×importance formula and the\nstore could never learn what is actually useful. Best-effort and never\nblocks the turn — a failed attest just skips the signal for that turn.\n\nsuccess=false attests a failed turn for audit only; per cortex §8.3 a\ngeneric failure (no factual-error/wrong-assumption reason) leaves citations\nuntouched, so we do not punish surfaced memories for an unrelated stall.
EDGES
  ^contains=matrix/neo/internal/memory.Pager
  ^defines=matrix/neo/internal/memory/writeback.go

NODE id=matrix/neo/internal/memory.Pager.Close kind=method
