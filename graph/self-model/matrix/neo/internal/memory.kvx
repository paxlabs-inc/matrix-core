NODE id=matrix/neo/internal/memory.hopDecay kind=func
  digest=b3:35deb0e39e01f59f86c57eb10050e4def620e40411a1501ac99f1d2d0b9c1583 file=neo/internal/memory/pager.go range=637:645 lang=go exported=false byte_range=22826:23082
  sig=func hopDecay(hop int) float32
  doc=hopDecay returns the cascade score multiplier at hop distance hop: 0.7^hop\n(hop1 -> 0.7, hop2 -> 0.49). Cheap integer-power loop; hops are 1 or 2.
EDGES
  ^defines=matrix/neo/internal/memory/pager.go

NODE id=matrix/neo/internal/memory.humanMode kind=func
  digest=b3:5fa57294df6824861677af21e80b65c0cd56a2eec8861afe2180722294413c4e file=neo/internal/memory/consolidate.go range=214:230 lang=go exported=false byte_range=7067:7660
  sig=func humanMode(mode string) string
  doc=humanMode / modeLesson turn a machine mode id into readable prose + a concrete\nlesson the agent can apply at reasoning time to avoid the pattern (req.5.3).
EDGES
  ^defines=matrix/neo/internal/memory/consolidate.go

NODE id=matrix/neo/internal/memory.invariantRules kind=var
  digest=b3:066c95c4e0812aec5f5e224deb4e35f9f1650eaa33591f962895c0845c7597a5 file=neo/internal/memory/pager.go range=286:303 lang=go exported=false byte_range=9515:11501
  sig=[]string
  doc=invariantRules are Neo's hard rules, lifted from the frozen spec invariants\n(i1–i6) and phrased for the model in human terms (transparency rule). They\nmust stay TRUE on every surface they are pinned into: the interactive agent\ncarries the paxeer wallet write lane directly (NEO NO-BARRIER, 2026-07-11 —\nthere is no core_execute delegation step on this surface), while restricted\nsurfaces (Automatrix, sub-agents) simply have no money tools advertised at\nall. A pinned rule naming a tool the surface does not advertise sends the\nmodel hunting for a ghost — the 2026-07-12 core_execute circling incident.
EDGES
  ^defines=matrix/neo/internal/memory/pager.go

NODE id=matrix/neo/internal/memory.learnedGuidanceMax kind=const
  digest=b3:5942310992f6d5827004f8ff71935dfb8f2871009348c9f8534d8931a27aca63 file=neo/internal/memory/pager.go range=336:338 lang=go exported=false byte_range=12380:12555
  sig=untyped int
  doc=learnedGuidanceMax bounds the pinned learned-guidance block so it can never\ncrowd out the rules/profile/goal inside the pinned token budget.
EDGES
  ^defines=matrix/neo/internal/memory/pager.go

