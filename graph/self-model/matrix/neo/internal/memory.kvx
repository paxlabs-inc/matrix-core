NODE id=matrix/neo/internal/memory.dupDistanceThreshold kind=const
  digest=b3:0363293b1c58ca7371f09ecfb94c23eb926b5095a24fb18930866e67f661aab0 file=neo/internal/memory/writeback.go range=764:770 lang=go exported=false byte_range=28124:28617
  sig=float32
  doc=dupDistanceThreshold is the HNSW distance below which a candidate write is\ntreated as a semantic duplicate of an existing same-type memory. Distance\nis 1-cosine under unit norm (0=identical, 2=opposite); 0.08 ≈ cosine ~0.92,\ndeliberately tight so genuinely distinct statements are never merged. The\nconflict-aware write core (writeWithRelations, relation.go) reads it to\nshort-circuit a duplicate before spending a classifier call.
EDGES
  ^defines=matrix/neo/internal/memory/writeback.go

NODE id=matrix/neo/internal/memory.encodeOpportunityGoal kind=func
