NODE id=matrix/neo/internal/memory.Pager.PendingOpportunities kind=method
  digest=b3:b6cdfb32b61a815c3e5e84c6449afe05e8306a99e8d7d429b4651c60182f3d8a file=neo/internal/memory/writeback.go range=357:418 lang=go exported=true byte_range=14492:16480
  sig=func (p *Pager) PendingOpportunities(ctx context.Context, limit int) ([]OpportunitySpec, error)
  doc=PendingOpportunities returns ONLY eligible-autonomous, pending opportunities\n— the set the autonomous picker may act on — ranked by confidence x salience\nx recency (highest first) and capped at limit (<=0 = all). Financial\nopportunities (eligible_autonomous=false) and any non-pending item are never\nreturned, so the picker structurally cannot select work that must not run\nunprompted.
EDGES
  ^contains=matrix/neo/internal/memory.Pager
  ^defines=matrix/neo/internal/memory/writeback.go

