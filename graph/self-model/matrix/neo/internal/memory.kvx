NODE id=matrix/neo/internal/memory.userFactSubject kind=const
  digest=b3:8dd2637856804b996840d4354b59e7c6a8e9de95443feba2eabac587f9d36c4a file=neo/internal/memory/writeback.go range=74:78 lang=go exported=false byte_range=2665:2936
  sig=untyped string
