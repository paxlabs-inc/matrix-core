NODE id=matrix/neo/internal/memory.ClassifyFinancial kind=func
  digest=b3:6042d4940989d1a29488ba51452126556fe70a102b575a52ee323bd80bf921d7 file=neo/internal/memory/classifier.go range=110:139 lang=go exported=true byte_range=6141:7254
  sig=func ClassifyFinancial(summary string) bool
  doc=ClassifyFinancial reports whether the opportunity summary describes work with\na deterministic financial / on-chain ACTION signal. It is the reusable\nkeyword + symbol re-check that backs EligibleForAutonomy; it never consults\nthe extraction model's flag, so it is a pure, side-effect-free function of\nthe summary text. An analysis-framed task (see analysisFramed) is never\nfinancial: its deliverable is words about money, not a movement of it —\nkeyword topics like "price"/"subscription"/"token" in a modeling task must\nnot disqualify autonomous work the restricted surface already makes safe.
EDGES
  ^defines=matrix/neo/internal/memory/classifier.go

