  digest=b3:053f4fc8ad5653874693b92126d753d367706034f1efe5618f3247fb80e058d1 file=neo/internal/memory/self_model.go range=48:76 lang=go exported=true byte_range=1576:2787
  sig=func (p *Pager) LoadStructuralSelf(ctx context.Context) (string, error)
