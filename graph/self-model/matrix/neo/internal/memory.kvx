  ^defines=matrix/neo/internal/memory/relation.go

NODE id=matrix/neo/internal/memory.RelationRelates kind=const
  digest=b3:c60d73ac4ff56b8f61405e6542e81dc43f3f02b67f3b399f1cdf41c375f6c568 file=neo/internal/memory/relation.go range=39:41 lang=go exported=true byte_range=1584:1760
  sig=memory.Relation
