  ^defines=matrix/neo/internal/memory/consolidate.go

NODE id=matrix/neo/internal/memory.pickEmbedder kind=func
  digest=b3:bdad4120d7ae60caaf1470fd90221cccd1fdf2b80601e3d193ea6c927da43891 file=neo/internal/memory/embedder.go range=17:89 lang=go exported=false byte_range=289:3397
  sig=func pickEmbedder(cfg config.Config) embed.Embedder
  doc=pickEmbedder selects the best available embedding backend for semantic\npage-faulting. It returns an embed.EmbedderChain that tries providers in\norder of preference and falls through on error/timeout, with the local\nHash stub as the terminal fallback (degraded but non-fatal).\n\nProvider order (P2-8):\n\n 1. the metered Matrix gateway /v1/embeddings route, when the gateway is\n    wired (MATRIX_GATEWAY_URL + MATRIX_GATEWAY_TOKEN + actor DID) — spend\n    is attributed to the actor under slot "neo" exactly like chat calls;\n 2. the provider directly (Baseten), when BASETEN_API_KEY is set;\n 3. the deterministic hash embedder — retrieval quality degrades to\n    pseudo-lexical, but nothing breaks (the pre-v5 behavior).\n\nEach real provider is boot-probed (probeEmbedder) before being added to the\nchain: a provider that fails the probe (misconfigured credentials, 403,\nunreachable) is omitted so we don't pay the latency of a guaranteed-fail\ncall on every page-fault. The Hash stub terminal fallback guarantees the\nchain never returns an error even if every real provider is down at call\ntime (a provider can pass the probe but fail later under load).\n\nThe cortex embedder worker lazily re-embeds memories whose recorded model\ndiffers from the active one, so upgrading from hash → API vectors migrates\nthe brain automatically in the background.
EDGES
  ^defines=matrix/neo/internal/memory/embedder.go

NODE id=matrix/neo/internal/memory.probeEmbedder kind=func
  digest=b3:6e4ae4c32636929171ef617c203f5341ecc6f45e381a9f973b9b201ae593e428 file=neo/internal/memory/embedder.go range=91:99 lang=go exported=false byte_range=3399:3895
  sig=func probeEmbedder(e embed.Embedder) bool
  doc=probeEmbedder issues one tiny boot-time embed to prove the backend actually\naccepts our model/credentials. Without this, a misconfigured backend (e.g.\na gateway still running a pre-v5 rate card that 403s the embed model) would\nbe selected anyway — and every page-fault would then return NOTHING, which\nis strictly worse than the hash fallback.
EDGES
  ^defines=matrix/neo/internal/memory/embedder.go

NODE id=matrix/neo/internal/memory.recallTypeAliases kind=var
  digest=b3:f658b72d244909ad3898463645b3219afa58d7748e98b3c503c335fd2a11b34c file=neo/internal/memory/pager.go range=716:730 lang=go exported=false byte_range=25915:26530
  sig=map[string]memory.Type
  doc=recallTypeAliases maps the lowercase type names the model passes in the\nmemory_recall 'types' filter onto cortex memory types. Unknown names are\nignored so a bad filter degrades to the default durable set rather than\nerroring the lookup.
EDGES
  ^defines=matrix/neo/internal/memory/pager.go

NODE id=matrix/neo/internal/memory.recencyMultiplier kind=func
  digest=b3:6e8de884b25d8515ffe14613b08c2d43b77138601047a26ac048f41852ccca36 file=neo/internal/memory/salience_realism.go range=59:77 lang=go exported=false byte_range=2379:3173
  sig=func recencyMultiplier(typ string, lastUsedNano int64, now time.Time) float32
  doc=recencyMultiplier returns the per-type half-life decay multiplier in (0,1]\nfor a memory of type typ last touched at lastUsedNano (unix nano), evaluated\nat now. It is 1.0 (no decay) when the type has no half-life, when the\ntimestamp is unknown (<= 0), or when the timestamp is in the future (clock\nskew) — never a penalty for missing data. Exact half-life decay:\nmultiplier = 2^(-Δt/H) = exp(-Δt·ln2/H). Pure read-time math; nothing\nis persisted.
EDGES
  ^defines=matrix/neo/internal/memory/salience_realism.go

NODE id=matrix/neo/internal/memory.rejectableType kind=func
  digest=b3:768385edbb4c46bdb615dca8d37fa5e151938c9399c1bbd8208fafe33abf70b8 file=neo/internal/memory/salience_realism.go range=94:108 lang=go exported=false byte_range=3660:4327
  sig=func rejectableType(typ string) bool
  doc=rejectableType reports whether a surfaced memory of this type may be\npenalized by the rejection (negative-attest) path. Only ephemeral knowledge\nmemories — Fact, Event, Belief — are eligible. Identity, Constraint,\nPreference, Goal, Pattern and Capability are NEVER penalized: they are\npinned every turn or structurally protected, so demoting their salience\nwould fight the pinned floor (guardrail c — never demote Identity / Hard\nConstraint / Active Goal).
EDGES
  ^defines=matrix/neo/internal/memory/salience_realism.go

NODE id=matrix/neo/internal/memory.relationBandDistance kind=const
  digest=b3:324058214d028032e9658100fc7076c0aa5495a165d61ba5521842a73b2375ea file=neo/internal/memory/relation.go range=95:100 lang=go exported=false byte_range=3716:4114
  sig=float32
  doc=relationBandDistance is the upper HNSW-distance bound for treating a neighbor\nas a relation candidate worth a classifier call: topically similar (cosine\n~>=0.65) but beyond the tight duplicate threshold. Conservative on purpose —\na wider band would burn cheap-model calls on unrelated memories and risk\nnoisy contradiction edges (risk R5).
EDGES
  ^defines=matrix/neo/internal/memory/relation.go

NODE id=matrix/neo/internal/memory.renderPreference kind=func
  digest=b3:f899c8ddbbc2504d8e372381634fb03bd3b498c0a5cb772571a888a306b9a757 file=neo/internal/memory/pager.go range=398:413 lang=go exported=false byte_range=15044:15495
  sig=func renderPreference(pd memory.PreferenceData) string
  doc=renderPreference turns a stored Preference into a one-line imperative for\nthe pinned guidance block.
EDGES
  ^defines=matrix/neo/internal/memory/pager.go

NODE id=matrix/neo/internal/memory.renderScoredSnippets kind=func
  digest=b3:ee7a3007689c28f2898cc81946c78e1218da1f476651dc2c6cf7b7bd02b71287 file=neo/internal/memory/pager.go range=1017:1054 lang=go exported=false byte_range=36769:37949
  sig=func renderScoredSnippets(res *query.Result) []scoredSnip
  doc=renderScoredSnippets renders res into snippets paired with each memory's\ncortex salience score (res.Scores), so the seed lanes rank by utility\ninstead of a flat 1.0 (v3 #4). A memory missing from res.Scores defaults\nto 0 — it sinks to the bottom of the working set, which is the correct\nposture for a memory cortex assigned no utility.
EDGES
  ^defines=matrix/neo/internal/memory/pager.go

NODE id=matrix/neo/internal/memory.scoredSnip kind=type
  digest=b3:0fd4bdf8631bd746166e447d5fdd59ba9b1c0a93e25f09c57aaddc03f3b9ec45 file=neo/internal/memory/pager.go range=623:630 lang=go exported=false byte_range=22871:23184
  sig=type scoredSnip struct {\n	snip		Snippet\n	score		float32\n	validUntil	*time.Time\n}
  doc=scoredSnip pairs a rendered memory with its score and the closed valid-time\n(v3 #2) of its current version (nil = still valid) so the Retrieve filter can\ndrop superseded/expired memories with an O(1) pointer check.
EDGES
  contains=matrix/neo/internal/memory.scoredSnip#score,matrix/neo/internal/memory.scoredSnip#snip,matrix/neo/internal/memory.scoredSnip#validUntil
  ^defines=matrix/neo/internal/memory/pager.go

