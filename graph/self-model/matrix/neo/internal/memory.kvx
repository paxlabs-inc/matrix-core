NODE id=matrix/neo/internal/memory.Pager.recallFlat kind=method
  digest=b3:ff75e659d5b60002b223b6d331b42ae1b0bac1d744c1bab19183408a74bdf1e5 file=neo/internal/memory/pager.go range=927:971 lang=go exported=false byte_range=34151:35514
  sig=func (p *Pager) recallFlat(ctx context.Context, queryText string, types []string, k int, asOf *time.Time) (string, error)
  doc=recallFlat is the flat (single-index) memory lookup: the pinned user profile\nplus a structured cortex.Find retrieval for the query. It is the legacy\nmemory_recall path (continuous-memory off) and the graceful fallback for the\nrecursive path when the timeline reaches nothing.
EDGES
  ^contains=matrix/neo/internal/memory.Pager
  ^defines=matrix/neo/internal/memory/pager.go

NODE id=matrix/neo/internal/memory.Pager.recallRecursive kind=method
  digest=b3:793621d919fad349cebd01190bd4f467fff9121dec6007e20b890a6bb146648c file=neo/internal/memory/pager.go range=857:925 lang=go exported=false byte_range=31581:34149
  sig=func (p *Pager) recallRecursive(ctx context.Context, queryText string, types []string, k int, asOf *time.Time) (string, error)
  doc=recallRecursive renders the recursive-recall descent (RLM applied to time)\nbehind memory_recall under the continuous-memory collapse (task 6.3). It\ndescends the T0 timeline into the finer tiers to reach the exact memories\npaged in on demand, preserving the type filter and the bi-temporal as_of at\nevery level (req.8.3). Each hit is rendered with its type, text, valid-until,\nand cortex URI — the same shape recallFlat renders — so the model's parsing\nis unchanged. When the descent reaches no leaf (empty/pre-cascade timeline,\nor a memory not yet a rollup member) it falls back to the flat index lookup\nso the tool is never worse than before.
EDGES
  ^contains=matrix/neo/internal/memory.Pager
  ^defines=matrix/neo/internal/memory/pager.go

NODE id=matrix/neo/internal/memory.Pager.recallSelf kind=method
  digest=b3:b2cf0dd2917a4b251184d6616e45b239465cb99c2e2ea2da1148d9e6b279122c file=neo/internal/memory/self_model.go range=78:105 lang=go exported=false byte_range=2789:4332
  sig=func (p *Pager) recallSelf(ctx context.Context, symbol string) (string, error)
  doc=recallSelf renders the on-demand self-graph paging behind a "self:<symbol>"\nmemory_recall query (req.2.2). A concrete symbol returns its compact\ncodegraph fragment (location + one-line summary, never raw source); a bare\n"self:" returns the resident structural self-summary the agent carries. A\nlookup miss degrades to a readable in-band message with a nil error so the\ntool surfaces it to the model rather than treating it as a transport failure.
EDGES
  ^contains=matrix/neo/internal/memory.Pager
  ^defines=matrix/neo/internal/memory/self_model.go

NODE id=matrix/neo/internal/memory.Pager.reinforceFailurePattern kind=method
  digest=b3:e6c142ab2f68624c8548499f35e18e6060d043eeecf99f522097201a3f60e748 file=neo/internal/memory/consolidate.go range=108:125 lang=go exported=false byte_range=3567:4282
  sig=func (p *Pager) reinforceFailurePattern(uri, statement string, evidence []string) (string, error)
  doc=reinforceFailurePattern updates an existing failure-pattern belief in place —\na new cortex Version with refreshed recency (so the recurring mode's salience\nrises) and the merged supporting-death evidence — WITHOUT creating a second\nmemory. The head (importance, subject) is preserved by cortex.Update.
EDGES
  ^contains=matrix/neo/internal/memory.Pager
  ^defines=matrix/neo/internal/memory/consolidate.go

NODE id=matrix/neo/internal/memory.Pager.relate kind=method
  digest=b3:7229ee94dbdc9af33f9e23213c269031fe66dd1c36e04673b993b6848eba8107 file=neo/internal/memory/relation.go range=144:184 lang=go exported=false byte_range=5360:6998
  sig=func (p *Pager) relate(fromURI, toURI string, rel Relation, hint string) error
  doc=relate links a freshly written memory (fromURI) to an existing one (toURI)\nvia the cortex edge implied by rel. Edges are bidirectional in storage (one\nrecord readable both ways), so a single AddEdge is enough; supersedes /\ncontradicts are written new -> old so the inbound-supersedes filter and\ncontradiction surfacing read the direction consistently. No-op for relations\nthat imply no edge, for unparseable URIs, or for a self-edge (same memory).
EDGES
  ^contains=matrix/neo/internal/memory.Pager
  ^defines=matrix/neo/internal/memory/relation.go

