NODE id=matrix/neo/internal/memory.triggerGuidanceMax kind=const
  digest=b3:6003229de37a4c9a328972d1471acdfdda0a669b0eafdf4d635ece399ffb964d file=neo/internal/memory/trigger.go range=49:51 lang=go exported=false byte_range=2336:2519
  sig=untyped int
  doc=triggerGuidanceMax bounds how many trigger guidance lines are injected in one\nturn so a turn that matches many behaviors can never crowd the window.
EDGES
  ^defines=matrix/neo/internal/memory/trigger.go

NODE id=matrix/neo/internal/memory.triggerLine kind=func
  digest=b3:1eb090849d41621a3952befbc17d0be672ae1f5727601aaea3476207618af37b file=neo/internal/memory/trigger.go range=132:173 lang=go exported=false byte_range=4941:6228
  sig=func triggerLine(t memory.Type, data memory.TypedData, res *query.Result, i int) string
  doc=triggerLine renders the imperative guidance for a matched trigger memory.\nHard Constraints are skipped (already pinned verbatim). A Pattern only fires\nas a trigger when it carries an explicit Trigger field; its guidance is the\nproven path (name → steps), so "what to do when this turn shows up" is\nconcrete. Returns "" to drop a candidate that should not surface.
EDGES
  ^defines=matrix/neo/internal/memory/trigger.go

NODE id=matrix/neo/internal/memory.triggerMatchCosine kind=const
  digest=b3:1e1e221744a4ddcb56c3fb707fbfaeb5ae1fb5aee7108dca266de3f23d3e61cd file=neo/internal/memory/trigger.go range=34:41 lang=go exported=false byte_range=1441:2041
  sig=float32
  doc=triggerMatchCosine is the minimum cosine similarity between the live turn and\na behavioral memory's embedded content for the memory to fire as a trigger.\ncortex returns HNSW distance = 1 − cosine (0 = identical), so the equivalent\ndistance ceiling is 1 − triggerMatchCosine. 0.50 is deliberately stricter\nthan the relation band (cosine ~0.65 / distance 0.35 is "topically similar")\n— a trigger must be clearly ABOUT this turn before it overrides salience, so\noff-topic behaviors never pin themselves (mirrors risk R5's conservatism).
EDGES
  ^defines=matrix/neo/internal/memory/trigger.go

NODE id=matrix/neo/internal/memory.triggerScanK kind=const
  digest=b3:6191721fff08e0cf1ea4097f6920ccc76bf6899f359dea3f3527329ce6608674 file=neo/internal/memory/trigger.go range=43:47 lang=go exported=false byte_range=2043:2334
  sig=untyped int
  doc=triggerScanK bounds how many nearest memories the trigger lane inspects per\nturn. The Near query overshoots the Constraint/Pattern post-filter so a turn\nsurrounded by Facts/Events still yields candidates, while the cap keeps the\nsingle vector query cheap.
EDGES
  ^defines=matrix/neo/internal/memory/trigger.go

