NODE id=matrix/neo/internal/memory.Pager.Pinned kind=method
  digest=b3:9379a0627157ffdd469e290da7f9d0b02e02e3538ebe877041c4a3b520af4fb8 file=neo/internal/memory/pager.go range=182:244 lang=go exported=true byte_range=6650:8502
  sig=func (p *Pager) Pinned(ctx context.Context, goal string) string
  doc=Pinned composes the always-injected pinned block: identity, the inviolable\noperating rules (Neo's invariants + any hard constraints in cortex), and\nthe active goal. Bounded by cfg.PinnedBudgetTokens.\n\ngoal is the caller's (per-conversation) active goal — passed in rather than\nread from shared pager state so that many conversations can share one cortex\nstore without clobbering each other's goal. Empty falls back to any\nprocess-level ActiveGoal (CLI path) then to a neutral placeholder.
EDGES
  ^contains=matrix/neo/internal/memory.Pager
  ^defines=matrix/neo/internal/memory/pager.go

NODE id=matrix/neo/internal/memory.Pager.Procedural kind=method
  digest=b3:335ca8e768bacc067fa17bb038cb91c12ebf8bba58f6ddae7858f9c3e43edd37 file=neo/internal/memory/pager.go range=1070:1112 lang=go exported=true byte_range=37859:39110
  sig=func (p *Pager) Procedural(ctx context.Context, goal string) ([]Pattern, error)
  doc=Procedural returns proven how-to patterns whose trigger matches the goal,\ngated by the anti-overfit guard (coverage >= cfg.MinPatternSuccesses).
EDGES
  ^contains=matrix/neo/internal/memory.Pager
  ^defines=matrix/neo/internal/memory/pager.go

NODE id=matrix/neo/internal/memory.Pager.QueuedOpportunities kind=method
  digest=b3:5dc6ce24c4ef53f80991bd339b1cdc4d84bba0bdf53f5d4673a6297d5db12bad file=neo/internal/memory/writeback.go range=420:486 lang=go exported=true byte_range=16482:18885
  sig=func (p *Pager) QueuedOpportunities(ctx context.Context, limit int) ([]OpportunitySpec, error)
  doc=QueuedOpportunities returns ALL pending opportunities — eligible-autonomous\nAND financial alike — ranked by confidence x salience x recency (highest\nfirst) and capped at limit (<=0 = all). It is the management-UI reader (req\n7.3): unlike PendingOpportunities (the autonomous picker's set, which filters\nto eligible_autonomous only and must stay that way so a financial item can\nnever be auto-run), this surfaces the financial items too so the user can\ndismiss them or approve one for a normal, gated, user-initiated run. Each\nreturned spec carries its EligibleAutonomous flag, so the caller knows which\nitems are financial (eligible_autonomous=false). Done/dismissed/in-flight\nitems are excluded — only the actionable pending queue is shown.
EDGES
  ^contains=matrix/neo/internal/memory.Pager
  ^defines=matrix/neo/internal/memory/writeback.go

NODE id=matrix/neo/internal/memory.Pager.Recall kind=method
  digest=b3:5cbd61c4e2ea3dfbf397a2eadaaf45155e8a1f419b5b8e4f707c3d9ecfbfd888 file=neo/internal/memory/pager.go range=851:885 lang=go exported=true byte_range=29864:31897
  sig=func (p *Pager) Recall(ctx context.Context, queryText string, types []string, k int, asOf *time.Time) (string, error)
  doc=Recall renders an explicit, user-visible memory lookup: the pinned user\nprofile plus the structured retrieval for the query. This backs Neo's\nmemory_recall tool so "check your memory" is an action, not an apology, and\nis now the PRIMARY reasoning-time retrieval verb (v3 #1) — the model calls\nit iteratively with narrowing queries/type filters instead of being\nforce-fed an ambient blob. Each rendered line carries the memory's type, a\ncontradiction advisory when present, its valid-until when closed (the as-of\ntime-travel signal), and its cortex URI for citation/provenance.\n\nThe tool is pointed at the cortex RECURSIVE-RECALL surface (RecallDescend)\n— the model descends the temporal ladder to page in exact specifics — while\npreserving the AmbientRetrievalTopK pull-over-push philosophy (this is the\npull verb) and the as_of parameter. It falls back to the flat lookup when the\ntimeline yields nothing (pre-cascade / a memory not yet rolled up), so the\ntool never regresses.
EDGES
  ^contains=matrix/neo/internal/memory.Pager
  ^defines=matrix/neo/internal/memory/pager.go

NODE id=matrix/neo/internal/memory.Pager.RecallDescend kind=method
  digest=b3:aec193408c62c98ecd86745e958d2975af442d900c5acc0c2dea77471edee0c8 file=neo/internal/memory/pager.go range=167:173 lang=go exported=true byte_range=5962:6403
  sig=func (p *Pager) RecallDescend(query string, opts cortex.RecallOpts) (*cortex.RecallResult, error)
  doc=RecallDescend runs the cortex recursive-recall descent (RLM applied to time)\nbehind the memory_recall tool's recursive path (continuous-memory task 6.3).\nA thin delegate to cortex.RecallDescend; it is a pure read (no journal\nappend, no SMT write) and stays off the per-turn hot path.
EDGES
  ^contains=matrix/neo/internal/memory.Pager
  ^defines=matrix/neo/internal/memory/pager.go

NODE id=matrix/neo/internal/memory.Pager.RecallHits kind=method
  digest=b3:a48d70d1ebaf70812215de89ba47858f34220ce1c3f1c63c267a0ebf1e97da5b file=neo/internal/memory/pager.go range=782:849 lang=go exported=true byte_range=27695:29862
  sig=func (p *Pager) RecallHits(_ context.Context, queryText string, types []string, k int, asOf *time.Time) ([]RecallHit, error)
  doc=RecallHits runs the structured, parameterized memory lookup behind the\nmemory_recall tool (v3 #1: reasoning-time retrieval). It honours an optional\ntype filter, a result cap k (<=0 = RetrievalTopK), and a bi-temporal as-of\ninstant (nil = now; v3 #2). Results are ranked by utility-keyed salience\n(v3 #4 default) and each hit carries its URI, type, score, closed valid-time,\nand a contradiction advisory when two surfaced hits disagree — the structure\nthe model iterates over and the verification layer surfaces.
EDGES
  ^contains=matrix/neo/internal/memory.Pager
  ^defines=matrix/neo/internal/memory/pager.go

NODE id=matrix/neo/internal/memory.Pager.RecordLoopDeath kind=method
  digest=b3:2edd5c7f20438220f485a0a75cea1611f95a9123c4efb5ab55606aa77b2388cf file=neo/internal/memory/writeback.go range=211:239 lang=go exported=true byte_range=8435:9729
  sig=func (p *Pager) RecordLoopDeath(ctx context.Context, summary, intentRef string) (string, error)
  doc=RecordLoopDeath persists a durable death-journal entry when a supervised\nattempt died in a loop-affecting way and forced a respawn — the DURABLE read\npath of the death journal (the immediate path is the successor's resume\nprime). It is a failure-outcome observation Event so ordinary recall/Activate\nsurfaces it, letting the agent self-author its world-model of how it fails,\nAND it carries the death-journal tag so the journal is directly readable as a\nwhole via DeathJournal (self-model task 3.1, req.4.2) — the tag is additive,\nnever excluding the record from ordinary recall. Importance 6 sits above a\nroutine outcome (4) so a recurring failure mode stays salient enough to inform\nfuture attempts. Best-effort: an empty summary or a write error is swallowed\nso it can never block a respawn.
EDGES
  ^contains=matrix/neo/internal/memory.Pager
  ^defines=matrix/neo/internal/memory/writeback.go

NODE id=matrix/neo/internal/memory.Pager.RecordOutcome kind=method
  digest=b3:8ebe11b44754b57a74fd1c44aad4f0be7cb7aa59abccbd21ee4a6844f5ce9787 file=neo/internal/memory/writeback.go range=194:209 lang=go exported=true byte_range=7898:8433
  sig=func (p *Pager) RecordOutcome(ctx context.Context, summary string, outcome memory.Outcome, intentRef string) (string, error)
  doc=RecordOutcome stores an episodic outcome (success/failure/partial). The\nbackground write-back pass and the loop's termination both call this.
EDGES
  ^contains=matrix/neo/internal/memory.Pager
  ^defines=matrix/neo/internal/memory/writeback.go

NODE id=matrix/neo/internal/memory.Pager.ReinforcePattern kind=method
  digest=b3:eec91d4d897c98ad59f8c8e45aa5b2086e9f0207594595b7fb9c52ad5fe82420 file=neo/internal/memory/writeback.go range=260:299 lang=go exported=true byte_range=10420:11849
  sig=func (p *Pager) ReinforcePattern(ctx context.Context, spec PatternSpec, derivedFrom []string) (string, error)
  doc=ReinforcePattern implements the procedural lifecycle's distill+reinforce\nstages: if a pattern with the same dedup identity (name → trigger → steps)\nalready exists it is reinforced (coverage++ and strength nudged up) so it can\ngraduate past the anti-overfit gate; otherwise a fresh low-confidence\ncandidate is written. Dedup is deliberately simple for v1 (semantic dedup is\na follow-up).
EDGES
  ^contains=matrix/neo/internal/memory.Pager
  ^defines=matrix/neo/internal/memory/writeback.go

NODE id=matrix/neo/internal/memory.Pager.RejectionCandidates kind=method
  digest=b3:41164f52a560fc7db7109bdc464fec671ace8e0fb308e3bff62bc4317090805b file=neo/internal/memory/salience_realism.go range=121:176 lang=go exported=true byte_range=4905:6603
  sig=func (p *Pager) RejectionCandidates(turnText string, surfaced []Snippet) []string
  doc=RejectionCandidates returns the URIs of memories that were SURFACED into a\nturn but were demonstrably ignored. A surfaced memory is a candidate when\nALL guardrails hold:\n\n	(a) the turn produced concrete output  — turnText is non-empty;\n	(b) the memory is clearly off-topic    — cosine(turn, memory) < offTopicCosine;\n	(c) the memory is not pinned/protected — rejectableType(type) is true.\n\nThe result is ordered farthest-first (lowest cosine) and capped at\nmaxRejectionsPerTurn. It requires an embedder for the cosine gate; without\none it returns nil so the rejection path stays conservative.
EDGES
  ^contains=matrix/neo/internal/memory.Pager
  ^defines=matrix/neo/internal/memory/salience_realism.go

NODE id=matrix/neo/internal/memory.Pager.RememberConstraint kind=method
  digest=b3:ecb8fdaf3aa7f8713a30ceaa53904fbf5f8d63a2c72364af93753c6abe398ced file=neo/internal/memory/writeback.go range=166:173 lang=go exported=true byte_range=6510:7081
  sig=func (p *Pager) RememberConstraint(ctx context.Context, statement, polarity, strength string) (string, error)
  doc=RememberConstraint stores a durable behavioral rule Neo learned — typically\nfrom a USER CORRECTION ("you did X, do Y instead"). Source=learned. It is\npinned every turn (hard-strength rules verbatim via hardConstraints, softer\nones via the learned-guidance block) so the correction sticks structurally\nrather than depending on retrieval luck. Deduped semantically.
EDGES
  ^contains=matrix/neo/internal/memory.Pager
  ^defines=matrix/neo/internal/memory/writeback.go

NODE id=matrix/neo/internal/memory.Pager.RememberConstraintRelated kind=method
  digest=b3:2c5ade7aedf4849ff5dcfbca8d0332524b92acdc960a3b79f5e9264da3735b5d file=neo/internal/memory/writeback.go range=175:192 lang=go exported=true byte_range=7083:7896
  sig=func (p *Pager) RememberConstraintRelated(ctx context.Context, statement, polarity, strength string, classify RelationClassifier) (string, error)
  doc=RememberConstraintRelated is RememberConstraint with conflict-aware linking:\na refined behavioral rule supersedes the stale one it corrects; an opposite\nrule contradicts it. A nil classifier is exactly RememberConstraint\n(dedup-or-write, no edges).
EDGES
  ^contains=matrix/neo/internal/memory.Pager
  ^defines=matrix/neo/internal/memory/writeback.go

NODE id=matrix/neo/internal/memory.Pager.RememberFact kind=method
  digest=b3:41ae0c4f37de9bff85fa88943767bd94e439f358f3660fbd15b00b826ee626bf file=neo/internal/memory/writeback.go range=82:89 lang=go exported=true byte_range=2971:3459
  sig=func (p *Pager) RememberFact(ctx context.Context, statement string) (string, error)
  doc=RememberFact stores a durable objective fact (semantic memory). Skips a\nwrite whose statement is near-identical to an existing fact (semantic\ndedup) so a repeatedly-relevant truth doesn't accumulate duplicates that\ndilute retrieval — its recency/salience is refreshed instead via the\nAttest usage loop when it is surfaced and cited.
EDGES
  ^contains=matrix/neo/internal/memory.Pager
  ^defines=matrix/neo/internal/memory/writeback.go

NODE id=matrix/neo/internal/memory.Pager.RememberFactRelated kind=method
  digest=b3:5b28ad1b920f35620a5da02ab8181b6de97099b04064b69121d6c8480b3c4ce6 file=neo/internal/memory/writeback.go range=91:108 lang=go exported=true byte_range=3461:4238
  sig=func (p *Pager) RememberFactRelated(ctx context.Context, statement string, classify RelationClassifier) (string, error)
  doc=RememberFactRelated is RememberFact with conflict-aware linking: when a\ntopically-similar (but not duplicate) fact already exists, classify decides\nwhether the new fact supersedes / contradicts / merely relates to it, and\nthe appropriate cortex edge is linked after the write. A nil classifier is\nexactly RememberFact (dedup-or-write, no edges).
EDGES
  ^contains=matrix/neo/internal/memory.Pager
  ^defines=matrix/neo/internal/memory/writeback.go

NODE id=matrix/neo/internal/memory.Pager.RememberOpportunity kind=method
  digest=b3:92f877dda150e24f96014e71c612da89b0d0ff2c6aadcaff7da61deee5b3b2f9 file=neo/internal/memory/writeback.go range=317:355 lang=go exported=true byte_range=12676:14490
  sig=func (p *Pager) RememberOpportunity(ctx context.Context, spec OpportunitySpec) (string, error)
  doc=RememberOpportunity stores a durable Automatrix opportunity (the proactive\nwork queue), deduplicated against existing PENDING opportunities with the\nsame discipline as RememberFact: a normalized-statement match (also catches\ncase/spacing drift, embedder-independent) OR a semantic-similarity match\nwithin the duplicate threshold short-circuits the write so a repeatedly\nmentioned need does not accumulate duplicates. Status defaults to pending\nand timestamps are stamped here. Returns the (possibly pre-existing,\ndeduped) record URI; an empty summary is a no-op.
EDGES
  ^contains=matrix/neo/internal/memory.Pager
  ^defines=matrix/neo/internal/memory/writeback.go

NODE id=matrix/neo/internal/memory.Pager.RememberPreference kind=method
  digest=b3:48e640e6d510615d3f032e6757b70ce2b2274408224c4eb5a3d1d4878cbb89e1 file=neo/internal/memory/writeback.go range=137:145 lang=go exported=true byte_range=5030:5673
  sig=func (p *Pager) RememberPreference(ctx context.Context, topic, polarity string, strength float32, rationale string) (string, error)
  doc=RememberPreference stores a durable WORKING preference Neo learned about\nhow the user wants it to behave (tone, format, which surfaces/tools to use,\netc.). Preferences are surfaced every turn via the pager's pinned\nlearned-guidance block, so a learned working style actually changes\nbehavior instead of being lost in salience-ranked retrieval. Deduped\nsemantically so repeats don't bloat the pinned block.
EDGES
  ^contains=matrix/neo/internal/memory.Pager
  ^defines=matrix/neo/internal/memory/writeback.go

NODE id=matrix/neo/internal/memory.Pager.RememberPreferenceRelated kind=method
  digest=b3:3d19fdde7de24f5883c3bba00a1aa4fd9206141fd88c7050d8143b501f983423 file=neo/internal/memory/writeback.go range=147:164 lang=go exported=true byte_range=5675:6508
  sig=func (p *Pager) RememberPreferenceRelated(ctx context.Context, topic, polarity string, strength float32, rationale string, classify RelationClassifier) (string, error)
  doc=RememberPreferenceRelated is RememberPreference with conflict-aware linking:\nan updated preference about the same topic supersedes the stale one, an\nopposite-polarity preference contradicts it. A nil classifier is exactly\nRememberPreference (dedup-or-write, no edges).
EDGES
  ^contains=matrix/neo/internal/memory.Pager
  ^defines=matrix/neo/internal/memory/writeback.go

NODE id=matrix/neo/internal/memory.Pager.RememberUserFact kind=method
  digest=b3:fcd18017e5ea8f8c5f08ce39a07111e1205ec2825aadd55d549595ebc5b4d807 file=neo/internal/memory/writeback.go range=110:135 lang=go exported=true byte_range=4240:5028
  sig=func (p *Pager) RememberUserFact(ctx context.Context, statement string) (string, error)
  doc=RememberUserFact stores a durable fact about the user themselves (their\nname, role, stable preferences). Pinned every turn via UserProfile, and\ndeduped on the normalized statement so repeats don't bloat the profile.
EDGES
  ^contains=matrix/neo/internal/memory.Pager
  ^defines=matrix/neo/internal/memory/writeback.go

NODE id=matrix/neo/internal/memory.Pager.Retrieve kind=method
  digest=b3:2f4f2e84f6d00ba508840ab96423191db1c911091d525bc1818732e53abe1f6f file=neo/internal/memory/pager.go range=451:619 lang=go exported=true byte_range=15894:22087
  sig=func (p *Pager) Retrieve(ctx context.Context, queryText string) ([]Snippet, error)
  doc=Retrieve page-faults the top-K records relevant to queryText. Seeds come\nfrom two lanes scored 1.0: semantic (HNSW) results when an embedder is\nrunning, ALWAYS merged with a salience-ranked lane over the durable types\n(the embedding worker is async, so a memory written seconds ago is invisible\nto the vector index — without the salience lane a "remember this" → "what do\nyou know?" round trip inside one session comes back empty).\n\nThe seeds then cascade over the relationship graph (cortex edges, depth 2,\nboth directions) so connected memories surface with a hop-decayed score\n(0.7^hop). A bi-temporal validity filter (v3 #2) drops any candidate whose\nvalid-time has been closed (ValidUntil <= now, stamped on supersession) so\nNeo sees the current version; contradiction edges annotate the conflicting\npair so Neo reconciles before trusting. Sorted by score desc (stable on\nfirst-seen order) and bounded by RetrievalTopK.
EDGES
  ^contains=matrix/neo/internal/memory.Pager
  ^defines=matrix/neo/internal/memory/pager.go

NODE id=matrix/neo/internal/memory.Pager.SavePersonalizationProfile kind=method
  digest=b3:619dddf9672214ab5bb28a14f72bfc27bf3c4f56f45712aa47802823e321a6cd file=neo/internal/memory/personalization.go range=198:248 lang=go exported=true byte_range=7815:9542
  sig=func (p *Pager) SavePersonalizationProfile(ctx context.Context, prof PersonalizationProfile) (string, error)
  doc=SavePersonalizationProfile normalizes, validates, and persists the profile as\nthe single authoritative record: a versioned UPDATE when one exists, a fresh\npinned record otherwise (req 13.1 — never a second record, never a fragment).\nReturns the record URI.
EDGES
  ^contains=matrix/neo/internal/memory.Pager
  ^defines=matrix/neo/internal/memory/personalization.go

NODE id=matrix/neo/internal/memory.Pager.SelfModel kind=method
  digest=b3:6a17e314f8420b08ec0c7e8bb40035fa69fae74efddfa65eef77c506eb5f50db file=neo/internal/memory/self_model.go range=190:197 lang=go exported=true byte_range=7162:7679
  sig=func (p *Pager) SelfModel(_ context.Context) (SelfModel, error)
  doc=SelfModel resolves the shared self-model artifact. It delegates to the\nfaculty-neutral resolver (matrix/cortex/self) over this pager's cortex store,\nso the conversation faculty and every other faculty that reads the same store\nobserve the byte-identical identity, structural summary, and failure patterns\n(self-model req.6.4) rather than a per-faculty reimplementation that can drift.
EDGES
  ^contains=matrix/neo/internal/memory.Pager
  ^defines=matrix/neo/internal/memory/self_model.go

