NODE id=matrix/neo/internal/memory.analysisFramed kind=func
  digest=b3:15913a5e0a19ec2fa018adb5e73912e72b613acd1914cc1014ae5ceb7193c580 file=neo/internal/memory/classifier.go range=95:108 lang=go exported=false byte_range=5543:6139
  sig=func analysisFramed(s string) bool
  doc=analysisFramed reports whether the summary's imperative frame is an\nanalysis/authoring verb — i.e. the task's deliverable is a document, model,\nor design rather than an action. Only the LEADING token frames the task\n("Model the PAX price volatility…", "Help Andrew design…" via "help"): a\nlist word appearing later is usually a noun ("Transfer the design files")\nand must not soften the fail-closed scan.
EDGES
  ^defines=matrix/neo/internal/memory/classifier.go

NODE id=matrix/neo/internal/memory.analysisVerbs kind=var
  digest=b3:62468eb43a25f52b78050ccbc53b666e895462ee0b40b13a7060e19538fc0d2e file=neo/internal/memory/classifier.go range=75:93 lang=go exported=false byte_range=4208:5541
  sig=map[string]struct{}
  doc=analysisVerbs are task-framing verbs whose deliverable is words, models, or\ndesigns — never a value movement. A summary whose imperative frame opens with\none of these is ANALYSIS work about a (possibly financial) topic, not an\naction that spends: "Model the PAX subscription revenue…", "Evaluate a burn\nmechanism…", "Sketch out the tier structure…". The financial boundary guards\nagainst tasks that MOVE value, not tasks that DISCUSS it — an analysis task\non the restricted autonomous surface structurally cannot reach the signing\npath regardless of its topic, so gating it on topic keywords only defeats\nthe feature (everything the user works on mentions money).
EDGES
  ^defines=matrix/neo/internal/memory/classifier.go

