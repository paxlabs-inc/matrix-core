NODE id=matrix/neo/internal/memory.offTopicCosine kind=const
  digest=b3:28882a90d04c4f0e54199c480b4b2ca0c427ea80aa74c5f858a198e43905cb06 file=neo/internal/memory/salience_realism.go range=110:114 lang=go exported=false byte_range=4329:4677
  sig=float32
  doc=offTopicCosine is the cosine ceiling below which a surfaced memory is treated\nas demonstrably off-topic to the produced turn (guardrail b). 0.30 mirrors\nthe topic-pivot threshold; deliberately low so only memories with little\nbearing on the turn are penalized, keeping false negatives rare (risk R2).
EDGES
  ^defines=matrix/neo/internal/memory/salience_realism.go

NODE id=matrix/neo/internal/memory.opportunityDupCosine kind=const
  digest=b3:89d5b3ce70cd8a658808580ecc1840a06ab4e894bea684b593f2eb2ce1261a0c file=neo/internal/memory/writeback.go range=311:315 lang=go exported=false byte_range=12323:12674
  sig=float32
  doc=opportunityDupCosine is the cosine-similarity ceiling above which a new\nopportunity summary is treated as a semantic duplicate of an existing\npending one. It is the exact mirror of RememberFact's duplicate discipline:\ndupDistanceThreshold is 1-cosine, so the cosine gate is 1 minus it.
EDGES
  ^defines=matrix/neo/internal/memory/writeback.go

NODE id=matrix/neo/internal/memory.opportunityImportance kind=const
  digest=b3:865f99f196cb2561adabc15870242c252218642e7a44af54e36fb3f12e45700c file=neo/internal/memory/writeback.go range=301:304 lang=go exported=false byte_range=11851:12074
  sig=uint8
  doc=opportunityImportance is the declared importance for a captured opportunity\n— moderate (same as a Fact): the proactive queue is durable working state,\nnot an inviolable rule.
EDGES
  ^defines=matrix/neo/internal/memory/writeback.go

