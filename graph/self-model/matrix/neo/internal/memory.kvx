NODE id=matrix/neo/internal/memory.deathJournalScanCap kind=const
  digest=b3:e45b139e066927ca7e3867e09ff8322f339176d0b576d4811c216c663b6c57dd file=neo/internal/memory/deathjournal.go range=27:31 lang=go exported=false byte_range=963:1289
  sig=untyped int
  doc=deathJournalScanCap bounds how many death records the journal reader scans\nbefore ordering. The journal is small by design (one entry per supervised\nrespawn, importance-6 Events that the normal salience trim keeps bounded), so\na generous fixed cap surfaces the whole recent journal.
EDGES
  ^defines=matrix/neo/internal/memory/deathjournal.go

NODE id=matrix/neo/internal/memory.deathJournalTag kind=const
  digest=b3:3b8fd930d0256b77fd95f77cde80a94622b3230335de61fa877fb9348edb16a5 file=neo/internal/memory/deathjournal.go range=17:25 lang=go exported=false byte_range=300:961
  sig=memory.Tag
  doc=deathJournalTag marks a cortex Event as a supervised-loop death record, so the\ndeath journal is a FIRST-CLASS, directly-queryable set (self-model task 3.1,\nreq.4.2) — the self-authoring consolidation pass (task 3.2) reads it by tag\nrather than guessing which failure Events were loop deaths. The tag is\nADDITIVE: a death record is still a TypeEvent failure observation, so ordinary\nrecall/Activate keeps surfacing it in the working set when salient (req.4.2).\nUnlike the opportunity tag it does NOT exclude the record from recall — it\nonly makes the journal readable as a whole.
EDGES
  ^defines=matrix/neo/internal/memory/deathjournal.go

NODE id=matrix/neo/internal/memory.deathMode kind=func
  digest=b3:8c53fe6a1535a03fa7c181000983bcdf4990da90e761e486c95ec96ed9ac9051 file=neo/internal/memory/consolidate.go range=148:159 lang=go exported=false byte_range=5033:5477
