NODE id=matrix/neo/internal/memory.Open kind=func
  digest=b3:fb4cc26d79dc0059871ab034451cfe3243a115d7b609a904d685c646295c5295 file=neo/internal/memory/pager.go range=61:95 lang=go exported=true byte_range=1816:3251
