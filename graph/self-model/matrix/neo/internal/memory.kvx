NODE id=matrix/neo/internal/memory.financialPhrases kind=var
  digest=b3:8d88220503646f8dcaabddb4ae53410e3d3bb8f5421db9381b3245339d7f526e file=neo/internal/memory/classifier.go range=59:70 lang=go exported=false byte_range=3502:4085
  sig=[]string
  doc=financialPhrases catches multi-word financial signals whose individual words\nare too common to gate on alone. Matched as substrings of the normalized\n(lower-cased, single-spaced) summary, with hyphens flattened to spaces so\n"on-chain" and "on chain" both hit.
EDGES
  ^defines=matrix/neo/internal/memory/classifier.go

NODE id=matrix/neo/internal/memory.financialSymbols kind=const
  digest=b3:c572d58db5ea32a9415e19d8792488660da7e901cb79cd81b53b845aa14cfd9c file=neo/internal/memory/classifier.go range=72:73 lang=go exported=false byte_range=4087:4206
  sig=untyped string
  doc=financialSymbols are currency/value glyphs whose mere presence signals money.
EDGES
  ^defines=matrix/neo/internal/memory/classifier.go

NODE id=matrix/neo/internal/memory.financialTokens kind=var
  digest=b3:ac6f2d890aae56b27d49b33e2007dfb70e83674c6a799f6f289bf3684778afbe file=neo/internal/memory/classifier.go range=20:57 lang=go exported=false byte_range=1045:3500
  sig=map[string]struct{}
  doc=financialTokens is the curated set of word-level financial signals. Matching\nis word-boundary (token) based — never substring — so an innocuous summary\nsuch as "Summarize the API rate-limit thread" is not falsely flagged. Tokens\nare deliberately money/chain-specific. A few genuinely ambiguous words the\nspec lists as financial signals (notably "transfer") are kept here on the\nfail-closed principle: a "transfer the files" task is then conservatively\nsurfaced for explicit approval rather than auto-run. Truly broad words that\nroutinely occur in non-financial work (send, value, order, book, rate) are\nintentionally excluded here and handled, where they matter, as multi-word\nphrases below so the autonomy boundary stays usable while still failing\nclosed on a genuine financial signal.
EDGES
  ^defines=matrix/neo/internal/memory/classifier.go

NODE id=matrix/neo/internal/memory.financialTokens2 kind=func
  digest=b3:f619b698a1e998848557e73e321bb3bd300080309df5d24d286c04238a5ed5ef file=neo/internal/memory/classifier.go range=141:148 lang=go exported=false byte_range=7256:7610
  sig=func financialTokens2(s string) []string
  doc=financialTokens2 splits s into lower-case alphanumeric tokens on any\nnon-[a-z0-9] boundary, so "buy/sell", "on-chain", and "swap 100 PAX" all\nyield clean word tokens for set membership.
EDGES
  ^defines=matrix/neo/internal/memory/classifier.go

