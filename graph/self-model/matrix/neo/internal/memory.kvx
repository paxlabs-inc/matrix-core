  digest=b3:49066091db76419c2de311098ddfae570e7f97575153fad3b841133b7769abb1 file=neo/internal/memory/relation.go range=84:93 lang=go exported=true byte_range=2909:3714
  sig=type RelationClassifier func(ctx context.Context, newText string, candidates []Neighbor) (rel Relation, targetURI, hint string)
  doc=RelationClassifier decides how a new statement relates to its nearest\nexisting same-type neighbors. It is implemented by the consolidator using\nthe cheap background model and is invoked by the conflict-aware write path\nONLY when a neighbor lands in the relation band (similar but not identical),\nso the common "nothing nearby" case never spends a model call. It returns\nthe relation, the chosen target URI (must be one of candidates' URIs), and\nan optional free-text hint carried verbatim on the edge (e.g. which fields\nconflict). A nil classifier means "dedup-or-write, never link" — the v1\nbehavior — so non-consolidator callers are unaffected.
EDGES
  ^defines=matrix/neo/internal/memory/relation.go

NODE id=matrix/neo/internal/memory.RelationContradicts kind=const
  digest=b3:f29de4275c6b61f834cf3e2399a367af880b5ccd58211f64c8861746b77acc6b file=neo/internal/memory/relation.go range=35:38 lang=go exported=true byte_range=1327:1582
  sig=memory.Relation
  doc=RelationContradicts: conflicts with the older memory. Write the new\none, then link new -> old with EdgeContradicts so both surface with a\nreconcile-first annotation rather than one silently winning.
EDGES
  ^defines=matrix/neo/internal/memory/relation.go

NODE id=matrix/neo/internal/memory.RelationDuplicate kind=const
  digest=b3:ae65a1caaf508b461ed98e07c3f46acc2ce73a82197560a0220275ea5b173947 file=neo/internal/memory/relation.go range=28:30 lang=go exported=true byte_range=889:1068
  sig=memory.Relation
  doc=RelationDuplicate: near-identical — skip the write (recency is\nrefreshed instead via the Attest usage loop when it is surfaced).
EDGES
  ^defines=matrix/neo/internal/memory/relation.go

