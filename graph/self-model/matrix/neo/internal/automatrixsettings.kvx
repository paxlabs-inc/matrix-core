  digest=b3:0bbfa6a5553a31f3eb062ab3b73ada3757602ee7ebf6639f27f12a445577a855 file=neo/internal/automatrixsettings/automatrixsettings.go range=275:287 lang=go exported=true byte_range=8906:9450
  sig=func Dir(override, cortexRoot string) string
  doc=Dir resolves Neo's Automatrix settings directory. An explicit override wins;\nelse it derives from the cortex root's parent (matching the conversation /\ntask / trace / automatrix stores, so it shares /data with them and survives\nsuspend / redeploy). Returns "" when neither is available (in-memory only).
EDGES
  ^defines=matrix/neo/internal/automatrixsettings/automatrixsettings.go

NODE id=matrix/neo/internal/automatrixsettings.Open kind=func
  digest=b3:2c8484539fa86725932c0b00cf3a779ff51057f09eaf813deaaaf92972e368db file=neo/internal/automatrixsettings/automatrixsettings.go range=82:99 lang=go exported=true byte_range=3475:4173
  sig=func Open(dir string) *Store
  doc=Open builds a store rooted at dir. State is loaded lazily on the first\noperation (Load), so SetVault can be wired between Open and first use. An\nempty dir yields an in-memory-only store (a safe, durable-less fallback) so\ndev/CLI runs and tests still toggle the opt-in correctly.
EDGES
  ^defines=matrix/neo/internal/automatrixsettings/automatrixsettings.go

