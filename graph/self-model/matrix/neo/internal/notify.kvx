NODE id=matrix/neo/internal/notify.Deliver kind=func
  digest=b3:8c08fcf0c662612170bef836cde29e3c090d87be83af7a8bbcb7702faf9de5aa file=neo/internal/notify/notify.go range=144:159 lang=go exported=true byte_range=4953:5567
  sig=func Deliver(n Notifier, note Notification)
  doc=Deliver sends the notification BEST-EFFORT on a background goroutine. It never\nblocks the caller and never returns an error: a failed external send is logged\nhonestly and dropped (the durable in-app record remains the canonical\nsurface). A nil notifier is a safe no-op.
EDGES
  ^defines=matrix/neo/internal/notify/notify.go

NODE id=matrix/neo/internal/notify.DeriveTopic kind=func
  digest=b3:e9f64310486fe06fe39d7528213f7908a8ede140ca7e2d25c645c454b31e4a99 file=neo/internal/notify/notify.go range=88:98 lang=go exported=true byte_range=3515:3923
  sig=func DeriveTopic(did string) string
  doc=DeriveTopic derives a deterministic, per-user, unguessable ntfy topic from\nthe agent DID. Returns "" for a blank DID (ntfy then has no topic and is\nskipped). The DID itself is never exposed: only an opaque hash prefix.
EDGES
  ^defines=matrix/neo/internal/notify/notify.go

