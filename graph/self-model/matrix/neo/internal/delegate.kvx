NODE id=matrix/neo/internal/delegate.classifyHTTP kind=func
  digest=b3:27cf91ab3053cb89cf0f4070c88ac3cb408ee56e25f52cb4116ac211df3abc31 file=neo/internal/delegate/classify.go range=81:109 lang=go exported=false byte_range=2857:4120
  sig=func classifyHTTP(status int, body string) FailureClass
  doc=classifyHTTP maps an HTTP status + response body to a FailureClass. The\nmapping is the design's taxonomy: 409 already-exists -> conflict, 403 ->\ndeterministic, 422 -> pending, 5xx / 429 -> transient, any other 4xx\n(validation / unparseable / not-owner) -> deterministic.
EDGES
  ^defines=matrix/neo/internal/delegate/classify.go

NODE id=matrix/neo/internal/delegate.classifyTerminal kind=func
  digest=b3:28b5329f5c5875e7b3720fba13097517e338c6e28a9ac705935e71b6e17d5673 file=neo/internal/delegate/client.go range=267:293 lang=go exported=false byte_range=10295:11231
  sig=func classifyTerminal(st *statusResp) (string, error, bool)
  doc=classifyTerminal maps an authoritative status response to a result/error when\nthe status is terminal (or a clarification is required). done is false when\nthe run is still in flight.
EDGES
  ^defines=matrix/neo/internal/delegate/client.go

NODE id=matrix/neo/internal/delegate.existingIntentID kind=func
  digest=b3:692241d580a25055cb4d07fe8be0f6d68804858b76c381d6e78ade383dcaf84d file=neo/internal/delegate/classify.go range=111:121 lang=go exported=false byte_range=4122:4555
  sig=func existingIntentID(err error) string
  doc=existingIntentID recovers the in-flight intent id from a conflict error (a\n409 "already exists in async registry"), so the delegate can ATTACH to the\nwork already underway instead of re-submitting. Returns "" when err is not a\ndaemon HTTP error or no id is present in the body.
EDGES
  ^defines=matrix/neo/internal/delegate/classify.go

NODE id=matrix/neo/internal/delegate.httpError kind=type
  digest=b3:cb1265d1f71be1fada5af2060d50f31772e62c8ac4518fdd3754296471d00c7e file=neo/internal/delegate/classify.go range=64:72 lang=go exported=false byte_range=2217:2647
  sig=type httpError struct {\n	status	int\n	body	string\n}
  doc=httpError carries the daemon's HTTP status code and (truncated) response body\nso the classifier can map an outcome to a FailureClass. It is the typed error\nthe delegate's request helper returns on a non-2xx response; it survives\nfmt.Errorf("...: %w", err) wrapping, so callers far up the chain (the\ndispatch ladder, the supervisor) recover the class via ClassOf.
EDGES
  contains=matrix/neo/internal/delegate.httpError#body,matrix/neo/internal/delegate.httpError#status,matrix/neo/internal/delegate.httpError.Error,matrix/neo/internal/delegate.httpError.Status
  ^defines=matrix/neo/internal/delegate/classify.go

