  digest=b3:6a15f7e46f8c902d2bfba9a94ae723aaab99d408271ecf23c04440bbd396e5ab file=neo/internal/delegate/classify.go range=15:20 lang=go exported=true byte_range=267:609
  sig=type FailureClass int
  doc=FailureClass is the single shared taxonomy for an outcome crossing the\nNeo<->MCL seam. Both the tool-dispatch ladder (agent.dispatchWithRetry) and\nthe task supervisor (server.superviseDecision) read THIS classification, so\nthe retry / stop / attach / ask decision is made once, never re-guessed per\nlayer.
EDGES
