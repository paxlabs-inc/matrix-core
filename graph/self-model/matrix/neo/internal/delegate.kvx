NODE id=matrix/neo/internal/delegate.Client.subscribeEvents kind=method
  digest=b3:e703bd889579acfd376394156ae6904c4a6b18745ed8e2be5f2d3f26b59cf3e2 file=neo/internal/delegate/client.go range=304:341 lang=go exported=false byte_range=11507:12734
  sig=func (c *Client) subscribeEvents(ctx context.Context, intentID string) (<-chan sseEvent, <-chan struct{})
  doc=subscribeEvents opens a goroutine that subscribes to the daemon's\nGET /events?intent_id=<id> SSE stream and delivers parsed events on evCh.\nOn a stream error it attempts a bounded number of reconnects (sseBackoff\nbetween each); once exhausted it signals failCh once and closes evCh. evCh\nis also closed on a clean stream end or context cancellation. The poller is\nexpected to keep driving regardless, so a closed evCh is never fatal.
EDGES
  ^contains=matrix/neo/internal/delegate.Client
  ^defines=matrix/neo/internal/delegate/client.go

NODE id=matrix/neo/internal/delegate.Client.track kind=method
  digest=b3:07419e2eab78e412606cbb68297245af668783429fe4b264c92de835a3507ff8 file=neo/internal/delegate/client.go range=174:238 lang=go exported=false byte_range=6764:9328
  sig=func (c *Client) track(ctx context.Context, id string) (string, error)
  doc=track drives an intent (freshly created or attached-to) to its terminal\noutcome, servicing approval gates inline. It subscribes to the daemon's SSE\nevent stream and drives gate/terminal transitions from events (sub-ms\nlatency). A poller is retained as an explicit safety net + fallback: it\ncovers the dispatch→subscribe race and silent stream drops, and becomes the\nsole driver once the SSE stream's bounded reconnect attempts exhaust. The\nper-run answered set (touched only from this goroutine) guarantees a gate is\nnever answered twice within this call even when an event and a poll tick both\nobserve it; the optional shared gateClaim guard (keyed on intent id + node\nid) additionally prevents two concurrent attaches to the same intent from\ndouble-answering the same gate.
EDGES
  ^contains=matrix/neo/internal/delegate.Client
  ^defines=matrix/neo/internal/delegate/client.go

