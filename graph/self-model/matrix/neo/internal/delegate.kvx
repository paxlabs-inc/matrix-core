  digest=b3:519504eea823a97ee30b3da725ce9a1744a670f2bdb53ba6827828539403e1a2 file=neo/internal/delegate/classify.go range=123:144 lang=go exported=false byte_range=4557:5165
  sig=func parseExistingIntentID(body string) string
  doc=parseExistingIntentID extracts the quoted intent id from a daemon conflict\nbody. The daemon returns {"error":"intent \\"<ID>\\" already exists in async\nregistry"}; the id is the first double-quoted token of that message.
