NODE id=matrix/neo/internal/delegate.ClassConflict kind=const
  digest=b3:b730b647a71bbc7e885ffaafcafa7b8318397503ed6c82aad9c783db92f55dec file=neo/internal/delegate/classify.go range=37:41 lang=go exported=true byte_range=1460:1721
  sig=delegate.FailureClass
  doc=ClassConflict is the deterministic-ID 409 "already exists in async\nregistry": the work is already in flight. It is NOT a failure — the\ndelegate resolves the existing intent and attaches to it (the\nattach-to-existing handler, P2).
