  ^defines=matrix/neo/internal/delegate/classify.go

NODE id=matrix/neo/internal/delegate.ClassDeterministic kind=const
  digest=b3:260271276f3ed39a798621d0e8767da677e80ad97af9b00db433a82a763384c4 file=neo/internal/delegate/classify.go range=31:36 lang=go exported=true byte_range=1081:1458
  sig=delegate.FailureClass
  doc=ClassDeterministic will recur identically on a re-submit of the same\nrequest: a validation reject, a leash/mode/cap denial (403), a\nwrong-strategy / not-owner rejection, or an unparseable intent. It is\nNEVER retried and NEVER respawned over — it is surfaced as a terminal\nresult so the agent stops-and-asks or reports an honest partial.
EDGES
  ^defines=matrix/neo/internal/delegate/classify.go

