  digest=b3:2ee30da177029a2e90ca0b777d4a387178374a4e6d579670a0e261a663633fe0 file=neo/internal/dojo/dojo.go range=898:913 lang=go exported=true byte_range=28147:28570
  sig=func (m *Manager) Close()
  doc=Close tears down every live session (graceful daemon shutdown).
EDGES
  ^contains=matrix/neo/internal/dojo.Manager
  ^defines=matrix/neo/internal/dojo/dojo.go

NODE id=matrix/neo/internal/dojo.Manager.Discard kind=method
  digest=b3:e313ca994d3f0bd8298ead48b63b8e5679b669a7cf60387dda04b5bb64488d40 file=neo/internal/dojo/dojo.go range=735:756 lang=go exported=true byte_range=23925:24497
  sig=func (m *Manager) Discard(ctx context.Context, id string) error
  doc=Discard destroys a session WITHOUT shipping — only the explicit user\ndiscard path calls this (req 5.4). Idempotent.
EDGES
  ^contains=matrix/neo/internal/dojo.Manager
  ^defines=matrix/neo/internal/dojo/dojo.go

NODE id=matrix/neo/internal/dojo.Manager.Enabled kind=method
  digest=b3:dcd3162d6ac8ba56e8caec4127722ec6ce89cac479155128d2e3ed163b4fe159 file=neo/internal/dojo/dojo.go range=249:252 lang=go exported=true byte_range=9289:9411
  sig=func (m *Manager) Enabled() bool
  doc=Enabled reports whether the Manager can provision.
EDGES
  ^contains=matrix/neo/internal/dojo.Manager
  ^defines=matrix/neo/internal/dojo/dojo.go

NODE id=matrix/neo/internal/dojo.Manager.EnsureSession kind=method
  digest=b3:c6685da194681454a4de73a8c76460d128575a272ada02ff8c6846664a54d58f file=neo/internal/dojo/dojo.go range=279:300 lang=go exported=true byte_range=10148:10915
  sig=func (m *Manager) EnsureSession(convID string) (Session, error)
  doc=EnsureSession returns the conversation's live session, registering a fresh\none and provisioning it in the BACKGROUND when none exists — the wave-3\nboot trigger: the caller returns a typed "booting" result immediately while\nthe client watches the dojo.* boot events (req 4.1). The background boot is\nbounded by ProvisionTimeout exactly like the synchronous path.
EDGES
  ^contains=matrix/neo/internal/dojo.Manager
  ^defines=matrix/neo/internal/dojo/dojo.go

NODE id=matrix/neo/internal/dojo.Manager.Frame kind=method
  digest=b3:dc6fa245cd4cb73be90d9097415bd40b1ed2b814f369bf7444645bf2bd10944f file=neo/internal/dojo/bridge.go range=229:267 lang=go exported=true byte_range=8252:9730
  sig=func (m *Manager) Frame(ctx context.Context, convID string) ([]byte, error)
  doc=Frame captures a live-view screenshot of the conversation's desktop for the\nclient panel (req 4.1) and returns the raw PNG. It is a PASSIVE view: it\nnever bumps the idle clock (an abandoned open tab must not keep a sandbox\nbilled forever — actively driving does, watching does not), never activates\nthe session, and works in every attached state including takeover (the human\nwatches themselves drive).
EDGES
  ^contains=matrix/neo/internal/dojo.Manager
  ^defines=matrix/neo/internal/dojo/bridge.go

NODE id=matrix/neo/internal/dojo.Manager.Get kind=method
  digest=b3:461a4b6d460a084ed2a28bec4fc3a3ec3df7fd50ef9c88d6056cbc7656199399 file=neo/internal/dojo/dojo.go range=470:479 lang=go exported=true byte_range=16258:16490
  sig=func (m *Manager) Get(id string) (Session, error)
  doc=Get returns the snapshot of a session by id.
EDGES
  ^contains=matrix/neo/internal/dojo.Manager
  ^defines=matrix/neo/internal/dojo/dojo.go

NODE id=matrix/neo/internal/dojo.Manager.Handback kind=method
  digest=b3:89d0b2779fda0cbeb79a539e409260153162860f6215dab917fff31e2ca17ae1 file=neo/internal/dojo/dojo.go range=617:645 lang=go exported=true byte_range=20534:21479
  sig=func (m *Manager) Handback(id string) (Session, error)
  doc=Handback returns control to the agent (takeover -> active) and arms the\nre-observation contract (req 4.3): the agent's next mutating action is\nrejected until a fresh observation lands — it never acts on a pre-takeover\nworld model. The flag is set under the SAME lock as the transition so no\nagent call can slip between them.
EDGES
  ^contains=matrix/neo/internal/dojo.Manager
  ^defines=matrix/neo/internal/dojo/dojo.go

NODE id=matrix/neo/internal/dojo.Manager.HandbackConv kind=method
  digest=b3:6637bf18ceb6b43a14bb10b5387df7cc6789a0bc4bcdd5a0cbc12dae86da2086 file=neo/internal/dojo/dojo.go range=666:673 lang=go exported=true byte_range=22049:22313
  sig=func (m *Manager) HandbackConv(convID string) (Session, error)
  doc=HandbackConv returns control to the agent for a conversation's live session.
EDGES
  ^contains=matrix/neo/internal/dojo.Manager
  ^defines=matrix/neo/internal/dojo/dojo.go

NODE id=matrix/neo/internal/dojo.Manager.Provision kind=method
  digest=b3:228a20ff13ceed1af488324739d85761ccfc19902618d444bd823f1457b859fc file=neo/internal/dojo/dojo.go range=259:277 lang=go exported=true byte_range=9505:10146
  sig=func (m *Manager) Provision(ctx context.Context, req Request) (Session, error)
  doc=Provision brings up the dojo session for a conversation, or reattaches to\nthe conversation's live session if one exists (sessions are reattachable\nacross turns and reconnects, req 1.2). It is synchronous and bounded by\nProvisionTimeout — it returns a typed error rather than hanging the turn.
EDGES
  ^contains=matrix/neo/internal/dojo.Manager
  ^defines=matrix/neo/internal/dojo/dojo.go

NODE id=matrix/neo/internal/dojo.Manager.Reattach kind=method
  digest=b3:cae3397a3c70d6d558fbbe4e330dcf94cfcb6a429a792a477dc99b30b701ba89 file=neo/internal/dojo/dojo.go range=532:566 lang=go exported=true byte_range=18069:19168
  sig=func (m *Manager) Reattach(ctx context.Context, id string) (Session, error)
  doc=Reattach verifies a session's sandbox is still alive, bumps its idle clock,\nand returns it. A dead sandbox is torn down honestly and reported as\nErrDestroyed — the caller re-provisions rather than acting on a corpse.
EDGES
  ^contains=matrix/neo/internal/dojo.Manager
  ^defines=matrix/neo/internal/dojo/dojo.go

NODE id=matrix/neo/internal/dojo.Manager.RegisterSessionForTest kind=method
  digest=b3:bcbe532523c6460e6b8ce1dedd2cc50acb46b2dad66eeb3925574c924efc1cba file=neo/internal/dojo/bridge.go range=269:291 lang=go exported=true byte_range=9732:10457
  sig=func (m *Manager) RegisterSessionForTest(sandboxID string) (Session, error)
  doc=RegisterSessionForTest hand-registers a live (active) session bound to the\ngiven sandbox id, bypassing Provision — for docker contract tests that drive\nan existing local bytebot-desktop container through the carrier seam. It\nreturns the session snapshot. Not used in production paths.
EDGES
  ^contains=matrix/neo/internal/dojo.Manager
  ^defines=matrix/neo/internal/dojo/bridge.go

NODE id=matrix/neo/internal/dojo.Manager.SessionForConv kind=method
  digest=b3:0db71418d0900fc85950db400053f27777709977666fceec75dc990d1bddc86a file=neo/internal/dojo/dojo.go range=481:494 lang=go exported=true byte_range=16492:16878
  sig=func (m *Manager) SessionForConv(convID string) (Session, bool)
  doc=SessionForConv returns the live session for a conversation, if any.
EDGES
  ^contains=matrix/neo/internal/dojo.Manager
  ^defines=matrix/neo/internal/dojo/dojo.go

NODE id=matrix/neo/internal/dojo.Manager.SessionForConvOrLive kind=method
  digest=b3:3976751efa104b088837ffd1d022dcf85a129232ef7be9b60d9d9164c065b014 file=neo/internal/dojo/dojo.go range=513:530 lang=go exported=true byte_range=17390:18067
  sig=func (m *Manager) SessionForConvOrLive(convID string) (Session, bool)
  doc=SessionForConvOrLive resolves a conversation's session, falling back to THE\nlive session when the conversation has none bound. With MaxActive=1 (the\ndefault) the user has exactly one computer — every conversation's panel\nshows and controls it, whichever conversation booted it. With a larger cap\nthe fallback is disabled and bindings stay strictly per-conversation.
EDGES
  ^contains=matrix/neo/internal/dojo.Manager
  ^defines=matrix/neo/internal/dojo/dojo.go

NODE id=matrix/neo/internal/dojo.Manager.SessionResultForConv kind=method
  digest=b3:3d53c51bf4731a6c20945377da905c6341eeced83dc6a72d2b8a8e0d64a59aa3 file=neo/internal/dojo/dojo.go range=496:511 lang=go exported=true byte_range=16880:17388
  sig=func (m *Manager) SessionResultForConv(convID string) (Session, bool)
  doc=SessionResultForConv returns a conversation's latest non-destroyed result,\nincluding a failed boot so clients can render its bounded reason. A retry\nstill replaces the failed record through ensureRecord.
EDGES
  ^contains=matrix/neo/internal/dojo.Manager
  ^defines=matrix/neo/internal/dojo/dojo.go

NODE id=matrix/neo/internal/dojo.Manager.SetTransport kind=method
  digest=b3:abbf075389e42c62c97157a4e4c0bbdac4085eefc7c14ebb477953337c48a286 file=neo/internal/dojo/dojo.go range=233:241 lang=go exported=true byte_range=8768:9166
  sig=func (m *Manager) SetTransport(t BytebotdTransport)
  doc=SetTransport swaps the desktop actuation carrier. Production keeps the\ndefault exec-curl carrier over the Railway client; a docker contract test\ninjects a direct-container carrier so the SAME Manager drives real bytebotd\nover a local HTTP/exec path. nil leaves the default in place.
EDGES
  ^contains=matrix/neo/internal/dojo.Manager
  ^defines=matrix/neo/internal/dojo/dojo.go

NODE id=matrix/neo/internal/dojo.Manager.StartReaper kind=method
  digest=b3:30a6b7c48828751da7e7ad6ae6c07723262e5cee2aa985d73ce19db2d3287d34 file=neo/internal/dojo/dojo.go range=858:870 lang=go exported=true byte_range=27162:27440
  sig=func (m *Manager) StartReaper(ctx context.Context)
  doc=StartReaper enforces the idle-timeout and hard-lifetime caps until ctx ends.
EDGES
  ^contains=matrix/neo/internal/dojo.Manager
  ^defines=matrix/neo/internal/dojo/dojo.go

NODE id=matrix/neo/internal/dojo.Manager.Takeover kind=method
  digest=b3:001c7ac2550ae81c93102e452671662425bedda1c2cf29c9c521ba2cc58636af file=neo/internal/dojo/dojo.go range=610:615 lang=go exported=true byte_range=20203:20532
  sig=func (m *Manager) Takeover(id string) (Session, error)
  doc=Takeover hands the control lease to the human (active -> takeover, req 4.2).\nWhile held, every AGENT desktop call is rejected with ErrTakeoverActive; the\nhuman's input passes through via TakeoverInput.
EDGES
  ^contains=matrix/neo/internal/dojo.Manager
  ^defines=matrix/neo/internal/dojo/dojo.go

NODE id=matrix/neo/internal/dojo.Manager.TakeoverConv kind=method
  digest=b3:2d6815b73d8d766fc9f888701010d0fff644d22ed9b4f07da10bef6260f9a835 file=neo/internal/dojo/dojo.go range=647:664 lang=go exported=true byte_range=21481:22047
  sig=func (m *Manager) TakeoverConv(convID string) (Session, error)
  doc=TakeoverConv hands the control lease to the human for a conversation's live\nsession. Grabbing a booted-but-idle desktop (ready) first marks it active so\nthe machine's edges stay closed.
EDGES
  ^contains=matrix/neo/internal/dojo.Manager
  ^defines=matrix/neo/internal/dojo/dojo.go

NODE id=matrix/neo/internal/dojo.Manager.TakeoverInput kind=method
  digest=b3:df97cc680f3cddf5ea80b3d831c25e6e1ed845b41b01654092bcbd6d10b70e27 file=neo/internal/dojo/bridge.go range=164:188 lang=go exported=true byte_range=6055:6993
  sig=func (m *Manager) TakeoverInput(ctx context.Context, convID string, body []byte) ([]byte, error)
  doc=TakeoverInput passes ONE human input action through to the desktop while the\nhuman holds the control lease (req 4.2). It is refused in every other state\n— the passthrough exists only under an explicit takeover, and holding the\nmouse never widens anyone's authority.
EDGES
  ^contains=matrix/neo/internal/dojo.Manager
  ^defines=matrix/neo/internal/dojo/bridge.go

NODE id=matrix/neo/internal/dojo.Manager.Teardown kind=method
  digest=b3:7b58c8c7eceb7d4c1a666056fba06d7a7decd6caeebdddf158c36a32e93213f6 file=neo/internal/dojo/dojo.go range=699:733 lang=go exported=true byte_range=22884:23923
  sig=func (m *Manager) Teardown(ctx context.Context, id, reason string) error
  doc=Teardown runs the full teardown pipeline for a session: shipping (the ship\nseam runs, its failure reported honestly, never silently dropped) then\ndestroy. Idempotent — tearing down a session already shipping or destroyed\nis a no-op (req 1.3).
EDGES
  ^contains=matrix/neo/internal/dojo.Manager
  ^defines=matrix/neo/internal/dojo/dojo.go

NODE id=matrix/neo/internal/dojo.Manager.Touch kind=method
  digest=b3:68db3ffb8b3fb1c7c14766179a2b2ecdcc4745f98d95715adee46f9500e792a7 file=neo/internal/dojo/dojo.go range=568:575 lang=go exported=true byte_range=19170:19338
