  doc=PNGDimensions reads the width and height from a PNG's IHDR chunk without\ndecoding pixels, so desktop_look knows the screenshot size to rescale into.
EDGES
  ^defines=matrix/neo/internal/dojo/look.go

NODE id=matrix/neo/internal/dojo.ParseA11yTree kind=func
  digest=b3:591541963e6e5f004ff570c1455ce606185b2d858ed3b71a0ef6d791c2e76a1c file=neo/internal/dojo/a11y.go range=147:166 lang=go exported=true byte_range=4522:5249
  sig=func ParseA11yTree(raw string) (A11yTree, error)
  doc=ParseA11yTree decodes the dumper's JSON output, failing closed on an error\nobject or unparsable output so a broken a11y bus is a typed error the planner\nreads, never a silently empty tree.
EDGES
  ^defines=matrix/neo/internal/dojo/a11y.go

NODE id=matrix/neo/internal/dojo.ParseGrounding kind=func
  digest=b3:45e0e80dd37440fef4779e30d34c0863be8658a58c7f7b72259dcd0d20808d6d file=neo/internal/dojo/look.go range=88:127 lang=go exported=true byte_range=3719:5057
  sig=func ParseGrounding(raw string, width, height int) (Grounding, error)
  doc=ParseGrounding decodes an omni grounding response (tolerant of a stray\nmarkdown fence) and rescales every coordinate from the 0–1000 convention to\npixels for a width×height screenshot. It fails closed on unparsable output so\na bad grounding is a typed error the planner reads, never a silent wrong\nclick.
EDGES
  ^defines=matrix/neo/internal/dojo/look.go

NODE id=matrix/neo/internal/dojo.RailwayClient kind=interface
  digest=b3:b51fc755de015be7702660c872bd7bba9b26c2c311f186bb20ef82039b8cd22e file=neo/internal/dojo/railway.go range=105:117 lang=go exported=true byte_range=3911:4609
  sig=type RailwayClient interface {\n	// CreateSandbox provisions a sandbox in the configured environment.\n	CreateSandbox(ctx context.Context, opts CreateOpts) (SandboxInfo, error)\n	// GetSandbox reads a sandbox's live status (the reattach read).\n	GetSandbox(ctx context.Context, id string) (SandboxInfo, error)\n	// ExecSandbox runs one shell command inside the sandbox, bounded by\n	// timeoutSec server-side.\n	ExecSandbox(ctx context.Context, id, command string, timeoutSec int) (ExecResult, error)\n	// DestroySandbox tears the sandbox down. Destroying an already-gone\n	// sandbox is not an error.\n	DestroySandbox(ctx context.Context, id string) error\n}
  doc=RailwayClient is the Manager-facing wire seam.
EDGES
  ^implements=matrix/neo/internal/dojo.railway
  ^defines=matrix/neo/internal/dojo/railway.go

NODE id=matrix/neo/internal/dojo.RailwayConfig kind=type
