  digest=b3:6a1bb185f206de0ea4ff45ab47536febd46517f31493693ffcaa693185dd12b7 file=neo/internal/dojo/bridge.go range=500:510 lang=go exported=true byte_range=16875:17551
  sig=func WrapDesktopExec(container, command string) string
  doc=WrapDesktopExec builds the shell that runs command inside the named appliance\ncontainer as the desktop user, with DISPLAY and the live XFCE session's\na11y D-Bus address exported (discovered from xfce4-session's environ). It is\nexported so a docker contract test builds the identical wrapper for its own\nlocal container.
