NODE id=matrix/neo/internal/dojo.Manager.A11yDump kind=method
  digest=b3:15b9c8b73cd075fb99caea68ac9d41eac6e8b6a6e63e046dc7fd1964ae3d3e2b file=neo/internal/dojo/bridge.go range=190:227 lang=go exported=true byte_range=6995:8250
  sig=func (m *Manager) A11yDump(ctx context.Context) (A11yTree, error)
  doc=A11yDump resolves the live session and runs the AT-SPI accessibility dumper\ninside the appliance desktop, returning the parsed accessibility tree — the\ndeterministic middle rung of the driving ladder (roles, labels, screen-pixel\ncoordinates), no vision model involved.
EDGES
  ^contains=matrix/neo/internal/dojo.Manager
  ^defines=matrix/neo/internal/dojo/bridge.go

NODE id=matrix/neo/internal/dojo.Manager.Activate kind=method
  digest=b3:e2d289dd2e15b51ce1f14bbb7914bab2f97fbc2e0eaa47aa35b5eff08260dd15 file=neo/internal/dojo/dojo.go range=577:608 lang=go exported=true byte_range=19340:20201
  sig=func (m *Manager) Activate(id string) (Session, error)
  doc=Activate marks the agent as driving (ready -> active). Activating an\nalready-active session just bumps the idle clock. Activating during a\ntakeover is refused — the human holds the controls.
EDGES
  ^contains=matrix/neo/internal/dojo.Manager
  ^defines=matrix/neo/internal/dojo/dojo.go

NODE id=matrix/neo/internal/dojo.Manager.CallBytebotd kind=method
  digest=b3:247e5db820c739712f892756186105a78a736b6ea9d57c7c4455422ba0e1eb8d file=neo/internal/dojo/bridge.go range=78:121 lang=go exported=true byte_range=3358:4845
  sig=func (m *Manager) CallBytebotd(ctx context.Context, body []byte) ([]byte, error)
  doc=CallBytebotd resolves the live session and issues one bytebotd /computer-use\nrequest through the carrier. A non-2xx status is returned as ErrBytebotd with\nthe body preserved so the caller can surface bytebotd's own message.
EDGES
  ^contains=matrix/neo/internal/dojo.Manager
  ^defines=matrix/neo/internal/dojo/bridge.go

