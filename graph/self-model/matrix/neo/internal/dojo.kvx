NODE id=matrix/neo/internal/dojo.a11yDumpPython kind=const
  digest=b3:bb5468adb7f12441a6a47e7bcbae10e5d1822179727358e01ac5c4cbefc6d54e file=neo/internal/dojo/a11y.go range=37:138 lang=go exported=false byte_range=1103:4194
  sig=untyped string
  doc=a11yDumpPython is the AT-SPI walker. It runs inside the appliance as the\ndesktop user (WrapDesktopExec supplies DISPLAY + the session bus), walks each\nregistered application to a bounded depth, and prints one JSON object of the\non-screen interactive elements with their center in screen pixels. Every\nAT-SPI call is defensive: a flaky node degrades to skipped, never a crash.
EDGES
  ^defines=matrix/neo/internal/dojo/a11y.go

