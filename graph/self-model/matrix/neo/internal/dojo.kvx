  ^defines=matrix/neo/internal/dojo/dojo.go

NODE id=matrix/neo/internal/dojo.Manager.WaitReady kind=method
  digest=b3:b74c67e37f1b75c301034a01229a4f7240b1e18aed03b2a93b0f65e6a72b3e1e file=neo/internal/dojo/dojo.go range=302:324 lang=go exported=true byte_range=10917:11592
