NODE id=matrix/neo/internal/runtime/loop.defaultMaxTurnTokens kind=const
  digest=b3:76e0a024f6e8c2aeedb306afe34e775305ea63a72a22fbf3823c730d81ef8d49 file=neo/internal/runtime/loop/loop.go range=31:36 lang=go exported=false byte_range=660:1037
  sig=untyped int
  doc=defaultMaxTurnTokens bounds the cumulative tokens ONE turn may merge\nacross every provider call it makes. It sits below the recorded ~1M\nnon-convergence burn while leaving headroom for a genuinely long turn on\nthe 1M window. Exhaustion is never a failure: it routes to the honest\npartial, which delivers the work already done.
