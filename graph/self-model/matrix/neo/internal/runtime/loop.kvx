  digest=b3:284f4681037b7fa1b8dc2e447d2a40f3f6ffcae60faadf59fc0786f4ff467e2f file=neo/internal/runtime/loop/loop.go range=915:931 lang=go exported=false byte_range=30088:30682
  sig=func (loop *Loop) derivePolicy(\n	userContent string,\n	state cursor,\n) (liveness.Policy, error)
  doc=derivePolicy reads the measured epistemic counters once per turn and derives\nthe bounds the turn runs under. It fails closed: an unvalidatable policy is a\ntyped incomplete over the checkpoint, never an unbounded turn.
