  digest=b3:c55b30b4bf8397600ce3298b2a8092e493f8c9b188b716b1720fc2d11e2b3b2b file=neo/internal/runtime/controller/controller.go range=144:187 lang=go exported=true byte_range=4104:5473
  sig=func (controller *Controller) Observe(signals Signals) (Mod, bool)
  doc=Observe classifies the step and, when a doubt edit is warranted and the\ncadence allows it, records the dual record and returns the line for the\nloop to fold into a request-time clone. Silence when healthy: no trigger,\nno mod, and the request is byte-identical to the controller absent.
