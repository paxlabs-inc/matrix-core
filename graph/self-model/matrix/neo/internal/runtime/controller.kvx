  digest=b3:20590bcb39e16f5275cfe3ea24bfcc16f64ec6e62329ab3946660469d6df1e25 file=neo/internal/runtime/controller/loop_adapter.go range=13:38 lang=go exported=true byte_range=266:1058
  sig=func (controller *Controller) ObserveMismatch(\n	ctx context.Context,\n	step int,\n	execution loop.ToolExecution,\n) (string, bool)
  doc=ObserveMismatch implements loop.DoubtController. Only evidence that is\nactually anchored arms the voice: an execution with no verified citation is\nnot a mismatch the controller may act on, because the mismatch verdict\nitself would be uncited (req.7.3).
