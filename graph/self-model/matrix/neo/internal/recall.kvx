  digest=b3:c46c6f5f9385e7c3b789f13387d9f9e767f85ee1133dc80a9fead77f6546b226 file=neo/internal/recall/recall.go range=90:145 lang=go exported=true byte_range=3060:4434
  sig=func (r *Recaller) Relevant(ctx context.Context, queryText string) []Hit
  doc=Relevant returns up to topK past turns most similar to queryText, ranked by\ncosine similarity and bounded by the token budget. Best-effort: any embed\nfailure degrades to fewer/no hits rather than erroring (the RAM tier + recent\ntail still carry the turn). The caller is expected to drop any hit already\npresent in the live transcript (dedup lives at the agent boundary).
