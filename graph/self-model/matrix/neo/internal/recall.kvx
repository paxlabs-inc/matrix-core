  digest=b3:00370653d598a49587d4c8df302a8cc6f7954602e994648a2fb5b9389c796d6e file=neo/internal/recall/recall.go range=171:194 lang=go exported=false byte_range=4821:5563
  sig=func (r *Recaller) refreshLocked()
  doc=refreshLocked embeds any turns appended since the last call, extending the\ncache. On an embed error it stops and leaves the remaining turns for a later\npass (embedded is not advanced past the failed turn), so transient embedder\nhiccups self-heal. Caller MUST hold r.mu.
