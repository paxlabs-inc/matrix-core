NODE id=matrix/neo/internal/writeback.Consolidator.classifyRelation kind=method
  digest=b3:fd978a3445343016a152c1ca78a9ba5a2b979e8ca711d63ba40298c58ad04a9c file=neo/internal/writeback/consolidator.go range=436:473 lang=go exported=false byte_range=18478:19880
  sig=func (c *Consolidator) classifyRelation(ctx context.Context, newText string, candidates []memory.Neighbor) (memory.Relation, string, string)
  doc=classifyRelation implements memory.RelationClassifier using the cheap\nconsolidation model. It is passed to the Remember*Related write paths and\ninvoked only when a similar neighbor exists. On any model/parse error it\nreturns RelationNew (no edge), so a flaky classifier degrades to the plain\nv1 write rather than mislinking memories.
EDGES
  ^contains=matrix/neo/internal/writeback.Consolidator
  ^defines=matrix/neo/internal/writeback/consolidator.go

NODE id=matrix/neo/internal/writeback.Consolidator.linkProvenance kind=method
  digest=b3:7642e8722167d5345da0e08ef04a60fa692a3c2423fa7ba5822db8eccc3d8fdb file=neo/internal/writeback/consolidator.go range=246:256 lang=go exported=false byte_range=11846:12459
  sig=func (c *Consolidator) linkProvenance(uri string, job consolidateJob)
  doc=linkProvenance adds a best-effort derived_from provenance edge from a\nfreshly written memory back to the session slice it was extracted from\n(DEJA-VU req 1.1/1.2). It runs AFTER the memory write has already committed,\nso a failed or impossible edge (empty URI from a deduped write, blank conv on\nthe CLI path, or an edge error) never fails the memory write.
EDGES
  ^contains=matrix/neo/internal/writeback.Consolidator
  ^defines=matrix/neo/internal/writeback/consolidator.go

