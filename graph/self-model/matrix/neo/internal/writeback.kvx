NODE id=matrix/neo/internal/writeback.Consolidator.Consolidate kind=method
  digest=b3:49fa86712448750f1ea8e2f269a4442866207789bced6f735a11517525cd0590 file=neo/internal/writeback/consolidator.go range=70:89 lang=go exported=true byte_range=2369:3295
  sig=func (c *Consolidator) Consolidate(transcript string)
  doc=Consolidate enqueues a turn transcript for background consolidation. Never\nblocks the agent: if the queue is full the job is handed to a detached\ngoroutine instead of being dropped, so a burst of turns never silently\nrots the durable store (cortex stays best-effort + eventually-current; the\nlive transcript is ground truth for the turn anyway).
EDGES
  ^contains=matrix/neo/internal/writeback.Consolidator
  ^defines=matrix/neo/internal/writeback/consolidator.go

NODE id=matrix/neo/internal/writeback.Consolidator.ConsolidateSync kind=method
  digest=b3:536703ee4a8c2a42e82a60b32a39fae5c23a1defb5a8ba1b3ea8573404420205 file=neo/internal/writeback/consolidator.go range=91:109 lang=go exported=true byte_range=3297:4377
  sig=func (c *Consolidator) ConsolidateSync(ctx context.Context, transcript string)
  doc=ConsolidateSync runs the SAME extraction logic as Consolidate, but\nSYNCHRONOUSLY on the caller's goroutine — not through the async jobs\nchannel. It is called from compact() before evicting older turns so that\ndurable facts/events/patterns in the about-to-be-evicted transcript reach\ncortex BEFORE the turns are lost from the working window. This closes the\ngap where an async sweep could lag behind compaction and lose the last\nturns. The call respects the context deadline and never panics on a nil\nreceiver. It does NOT touch the async queue (steady-state is unchanged).
EDGES
  ^contains=matrix/neo/internal/writeback.Consolidator
  ^defines=matrix/neo/internal/writeback/consolidator.go

NODE id=matrix/neo/internal/writeback.Consolidator.ProposedSkills kind=method
  digest=b3:7700ce97cafda6fab41f35ae72cc356df33e321682312bbd12e6370f17dcfd33 file=neo/internal/writeback/consolidator.go range=146:158 lang=go exported=true byte_range=5456:5864
  sig=func (c *Consolidator) ProposedSkills() []string
  doc=ProposedSkills returns the list of skill names that have been auto-proposed\nby the consolidator (patterns that crossed the MinPatternSuccesses guard).\nNil-safe: returns nil for a nil receiver.
