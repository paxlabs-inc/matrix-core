  digest=b3:5a55c27d1a15f04cdc765859cdc1e21478e16c64e1b4e1a069b68190cc05305a file=neo/internal/writeback/consolidator.go range=45:60 lang=go exported=true byte_range=1600:2242
  sig=func New(extract, classify *llm.Client, pager *memory.Pager, cfg config.Config) *Consolidator
  doc=New builds a consolidator. extract drives the per-turn learning extraction\n(its quality directly sets memory quality); classify is the cheap model used\nonly on the rare similar-neighbor relation check. A nil classify falls back\nto extract.
