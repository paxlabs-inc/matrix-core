NODE id=matrix/neo/internal/agent.Agent.renderActivationBundle kind=method
  digest=b3:775e5d1545f423b2fd31549f1c391b703dbf23c43733f22de9fafdec2acde88c file=neo/internal/agent/continuous.go range=296:374 lang=go exported=false byte_range=10393:13268
  sig=func (a *Agent) renderActivationBundle(b *cortex.ActivationBundle) string
  doc=renderActivationBundle renders the cortex.Activate bundle into the trailing\nworking-memory block — the single window law's memory tail (MORPHEUS req.1.3).\nIt frames the block as in-progress reference (never a new instruction — the\nleading line tells the model to continue, not restart), then surfaces the\nstanding objective as background, the Pinned tier (identity, hard constraints,\nactive cortex goals), the durable story-so-far, the T0 timeline and T1 recent\ntiers, and a note that exact specifics page in on demand via memory_recall\n(T3 handles — the pull-over-push philosophy, req.9.5). The transcript slice is\nNOT re-rendered here: the live transcript is the window's middle already.\n\nThe block is delivered by the caller as a USER-role trailing message\n(assembleWindowUserTail) so strict Qwen-derived chat templates accept it (the\nprompt-window portability fix), keeping the byte-stable system prefix at\nindex 0.
EDGES
  ^contains=matrix/neo/internal/agent.Agent
  ^defines=matrix/neo/internal/agent/continuous.go

NODE id=matrix/neo/internal/agent.Agent.renderCapabilitySurface kind=method
  digest=b3:7b780494eef9a37eae047a51b06e706ff5a7878f763a4b349df01ff6c2217ccd file=neo/internal/agent/capability.go range=43:130 lang=go exported=false byte_range=2058:4649
  sig=func (a *Agent) renderCapabilitySurface() string
  doc=renderCapabilitySurface renders the resident capability-surface section of\nthe stable prefix. Byte-stable per agent: it reads only construction-time\nstate (a.capability, a.schemas), so it is byte-identical across every step\nof a turn (req.2.4).
EDGES
  ^contains=matrix/neo/internal/agent.Agent
  ^defines=matrix/neo/internal/agent/capability.go

