NODE id=matrix/neo/internal/agent.Agent.finishTurn kind=method
  digest=b3:13456d36fc6cdeee8230db2d4a9253755cd1737c6b7b763638d4b28f181cf582 file=neo/internal/agent/finish.go range=18:70 lang=go exported=false byte_range=562:3631
