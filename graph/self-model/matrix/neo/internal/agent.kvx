  digest=b3:622caddb29014fb536c12cd5bd71b568c0d71beb5704022e55e04a3a4ff8d0ee file=neo/internal/agent/agent.go range=108:112 lang=go exported=true byte_range=5130:5422
  sig=agent.ToolPhase
  doc=ToolStream is the mid-flight live-typing fragment for a file write the\nmodel is still generating (StreamPath/StreamDelta/StreamOffset). It fires\nBEFORE the call's ToolStart (the model hasn't finished the call yet) and\nnever carries Args/Result.
EDGES
  ^defines=matrix/neo/internal/agent/agent.go

