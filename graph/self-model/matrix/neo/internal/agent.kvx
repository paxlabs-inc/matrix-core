NODE id=matrix/neo/internal/agent.groundTruth kind=var
  digest=b3:8743ee802c322fc062bd2f35c83f38fe3368f9d64a31772e1c8fa55f91e453a8 file=neo/internal/agent/prompt.go range=12:18 lang=go exported=false byte_range=225:581
  sig=string
  doc=groundTruth is Neo's always-injected factual grounding (who it is, that\nPaxeer is a real live chain, the canonical RPC/explorer/docs endpoints, and\nhow to answer chain questions with its read tools instead of blind web\nsearch). Embedded so it ships in the binary and can't drift from the build.
EDGES
  ^defines=matrix/neo/internal/agent/prompt.go

NODE id=matrix/neo/internal/agent.groundTruthFor kind=func
  digest=b3:71b47b91c76d437b4ee886a38b17df6e5e9f4128c876eb120ecae82b24991141 file=neo/internal/agent/prompt.go range=243:248 lang=go exported=false byte_range=26196:26547
  sig=func groundTruthFor(name string) string
  doc=groundTruthFor renders the embedded ground truth for the configured agent\nidentity: the {{AGENT_NAME}} placeholder binds the name from config\n(MORPHEUS req.8) so the grounding can never carry a stale hardcoded name.
EDGES
  ^defines=matrix/neo/internal/agent/prompt.go

NODE id=matrix/neo/internal/agent.guardCassandraSelfHeal kind=func
  digest=b3:943a2054f1273a0cb8298366b47fb87f21a8d9b33c93fcdf6014c3096551e6b5 file=neo/internal/agent/closechain.go range=189:202 lang=go exported=false byte_range=9386:10188
  sig=func guardCassandraSelfHeal(_ *Agent, cc *closeContext) (closeDecision, bool)
  doc=guardCassandraSelfHeal: Cassandra 2.0 self-heal on a would-be close\n(req.6.2) — if the controller folded doubt into this bare answer (premature/\nunverified close, or a close that bailed out of a loop), re-loop so the\nmodel re-reads its OWN doubt and re-verifies instead of finishing. The\ndelivered answer is untouched (finishTurn reads the result copy, separate\nfrom the edited a.working entry); it is bounded by the per-turn mod cap +\nper-trigger cooldown so it can never loop forever, and never fabricates a\ncompletion — it only asks the agent to check. Contract — mutates: nothing.
EDGES
  ^defines=matrix/neo/internal/agent/closechain.go

NODE id=matrix/neo/internal/agent.guardDeliver kind=func
  digest=b3:ff972aebcdda3065a375fa65f628219b8e9b2dfc9e7f60f30c3e076549bc7427 file=neo/internal/agent/closechain.go range=204:210 lang=go exported=false byte_range=10190:10600
  sig=func guardDeliver(_ *Agent, _ *closeContext) (closeDecision, bool)
  doc=guardDeliver is the terminal guard: nothing blocked the close, so the answer\nships. It always fires, making the chain total — every evaluation produces a\ndecision. Contract — mutates: nothing (delivery itself happens in closeTurn\nvia finishTurn, the single choke point).
EDGES
  ^defines=matrix/neo/internal/agent/closechain.go

NODE id=matrix/neo/internal/agent.guardEmptyAnswer kind=func
  digest=b3:37d128a947cdf3782ae8b5fe505cdf73aee6ddc9533c8ec94e2a6a78b2502cd5 file=neo/internal/agent/closechain.go range=126:138 lang=go exported=false byte_range=6074:6775
  sig=func guardEmptyAnswer(a *Agent, cc *closeContext) (closeDecision, bool)
  doc=guardEmptyAnswer: empty AND no tools → anti-premature steer to continue via\nthe guidance channel, bounded so a model that keeps returning nothing\nescalates rather than looping forever. Contract — mutates: the working\ntranscript (guidance) and the unified unproductive counter.
EDGES
  ^defines=matrix/neo/internal/agent/closechain.go

NODE id=matrix/neo/internal/agent.guardIdentityLeak kind=func
  digest=b3:caa9db672cb7e6896c7227b539e9f8258ba48c3ad661accd1b2c2b370b2551b5 file=neo/internal/agent/closechain.go range=166:187 lang=go exported=false byte_range=8147:9384
  sig=func guardIdentityLeak(a *Agent, cc *closeContext) (closeDecision, bool)
  doc=guardIdentityLeak: the identity-compliance canary (P0) — if the settled\nanswer broke character and self-identified as the underlying LLM, treat it\nas a charter breach, not a typo: a model that won't hold its own name is\nsignalling it may ignore the harder rules too. Surface it on the audit\nside-channel (never blind), scrub the answer, and re-anchor via the guidance\nchannel so the model regenerates a compliant answer. Once the nudge budget\nis spent the honest, SCRUBBED answer is delivered rather than looping\nforever (finishTurn re-scrubs at delivery regardless). Contract — mutates:\ncc.answer (the scrub), the working transcript (guidance), and the unified\nunproductive counter; emits the identity.leak audit event.
EDGES
  ^defines=matrix/neo/internal/agent/closechain.go

NODE id=matrix/neo/internal/agent.guardInboxDrain kind=func
  digest=b3:628c461be526f9748c33d4ec00fdd8c68af4b8d445bba19665fd354086a7463e file=neo/internal/agent/closechain.go range=97:107 lang=go exported=false byte_range=4472:5049
  sig=func guardInboxDrain(a *Agent, _ *closeContext) (closeDecision, bool)
  doc=guardInboxDrain: a message queued mid-turn (F5) may have arrived during this\nmodel call, just as the agent is about to finish. Address it instead of\nclosing the turn, so a non-interrupting mid-task message is never dropped at\nthe turn boundary. Contract — mutates: the working transcript (appends the\ndrained user messages); fires only when at least one message was injected.
EDGES
  ^defines=matrix/neo/internal/agent/closechain.go

NODE id=matrix/neo/internal/agent.guardSourceFetch kind=func
  digest=b3:756749d843679a08eb47bce80c917289ae4bf370376fcdf5e2697ed08f1a4175 file=neo/internal/agent/closechain.go range=156:164 lang=go exported=false byte_range=7562:8145
  sig=func guardSourceFetch(a *Agent, _ *closeContext) (closeDecision, bool)
EDGES
  ^defines=matrix/neo/internal/agent/closechain.go

NODE id=matrix/neo/internal/agent.guardTruncatedAnswer kind=func
  digest=b3:83f2e2b4831d90ed11077820af113fc4513311104c042e9ce1d76b95463660a9 file=neo/internal/agent/closechain.go range=109:124 lang=go exported=false byte_range=5051:6072
  sig=func guardTruncatedAnswer(a *Agent, cc *closeContext) (closeDecision, bool)
  doc=guardTruncatedAnswer: a truncated generation (finish_reason=length) is NEVER\na final answer — the cut-off text is half-formed monologue/payload (the\nmodel may have been inlining a large blob) and saying it raw leaks internal\nthoughts into the chat. Nudge for a compact retry via the guidance channel,\nbounded so a model that keeps getting cut off escalates rather than\nre-nudging forever. Contract — mutates: the working transcript (guidance)\nand the unified unproductive counter.
EDGES
  ^defines=matrix/neo/internal/agent/closechain.go

NODE id=matrix/neo/internal/agent.guardUnreadOverflow kind=func
  digest=b3:8c8809e5b8583d40e5d99e1cfc392108074a683c37594258dd36763ba1228e7c file=neo/internal/agent/closechain.go range=140:154 lang=go exported=false byte_range=6777:7560
  sig=func guardUnreadOverflow(a *Agent, _ *closeContext) (closeDecision, bool)
  doc=guardUnreadOverflow: read-full discipline (req.4.2) — a tool result too\nlarge to show inline was spilled to an overflow file. Don't let the turn end\non a bare answer while that output is still unread; steer (via the guidance\nchannel) to read it first, so the answer can't be drawn from a truncated\nresult. Contract — mutates: the working transcript (guidance) and the\nunified unproductive counter.
EDGES
  ^defines=matrix/neo/internal/agent/closechain.go

