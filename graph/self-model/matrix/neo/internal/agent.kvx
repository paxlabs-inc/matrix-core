NODE id=matrix/neo/internal/agent.narrateBatch kind=func
  digest=b3:ad59b6677924a0b63fce25354dc375ceff93621792c583f711cd820b2471b377 file=neo/internal/agent/narrate.go range=33:70 lang=go exported=false byte_range=1361:2505
  sig=func narrateBatch(calls []llm.ToolCall) string
  doc=narrateBatch produces one concise, action-specific intent line for a batch of\ntool calls about to be dispatched, or "" when there is nothing worth saying\n(e.g. a completion-only batch). A single call is described directly; a\nmulti-call batch is summarized by its distinct actions so the line still\nreflects the real work without spamming one line per call.
EDGES
  ^defines=matrix/neo/internal/agent/narrate.go

NODE id=matrix/neo/internal/agent.narrateMaxLen kind=const
  digest=b3:0ec1d2802fc3dd9f5d4f8a102a59fd90b729c649fa1a1ce433f67065759b43a4 file=neo/internal/agent/narrate.go range=26:28 lang=go exported=false byte_range=1094:1253
  sig=untyped int
  doc=narrateMaxLen bounds a narration line so a long argument (a big command, a\npasted URL) can't blow the line into a wall of text.
EDGES
  ^defines=matrix/neo/internal/agent/narrate.go

NODE id=matrix/neo/internal/agent.narratePhrase kind=func
  digest=b3:c2f008dc1a428275c0886a35e3d1a782f52fa855d97e355082a64a04dbab3a1b file=neo/internal/agent/narrate.go range=72:171 lang=go exported=false byte_range=2507:6580
  sig=func narratePhrase(call llm.ToolCall) string
  doc=narratePhrase returns the lowercase verb phrase for a single tool call (no\nleading capital, no trailing period) so narrateBatch can compose it either as\na standalone sentence or as one item in a list. Returns "" for calls that\nshould not be narrated (the completion gate).
EDGES
  ^defines=matrix/neo/internal/agent/narrate.go

