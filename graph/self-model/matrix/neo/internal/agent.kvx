NODE id=matrix/neo/internal/agent.ToolEvent#StreamPath kind=field
  digest=b3:94be1873552063679870fdc44a1d2297b2f9ffa571304ccb4624e11f86e3b5c3 file=neo/internal/agent/agent.go range=96:103 lang=go exported=true byte_range=4869:5402
  sig=string
  doc=Live file-typing channel (NEO-WORKBENCH, Phase==ToolStream only): while\nthe model is still GENERATING a write_file call, decoded fragments of the\nfile content stream out so an open editor renders Neo typing. StreamPath\nis the target file, StreamDelta the next decoded content fragment, and\nStreamOffset the number of decoded bytes that preceded it (gap/order\ndetection). Best-effort and bounded: a dropped or capped stream degrades\nto the final ToolEnd state, never a corrupted buffer.
EDGES
  ^contains=matrix/neo/internal/agent.ToolEvent

NODE id=matrix/neo/internal/agent.ToolObserver kind=type
  digest=b3:691f540eb2409829ede0c943746248cf88924cbf8d94ed76de78e76cce495b1b file=neo/internal/agent/agent.go range=123:126 lang=go exported=true byte_range=6061:6308
  sig=type ToolObserver func(ToolEvent)
  doc=ToolObserver receives every tool result as it happens. Optional; nil\ndisables surfacing. The harness (CLI or SSE server) decides how to render —\nthe agent loop stays oblivious to the presentation layer.
EDGES
  ^defines=matrix/neo/internal/agent/agent.go

NODE id=matrix/neo/internal/agent.ToolPhase kind=type
  digest=b3:3854de775c0a9320de0dc292550f635cfa6841c297987a231bdbcf784b9d5c31 file=neo/internal/agent/agent.go range=108:111 lang=go exported=true byte_range=5445:5694
  sig=type ToolPhase string
  doc=ToolPhase distinguishes the two observer callbacks for one tool call: a\nstart (so the surface can paint a live "running" viewport immediately) and\nan end (the result lands). The harness correlates them by ToolEvent.ID.
EDGES
  ^defines=matrix/neo/internal/agent/agent.go

