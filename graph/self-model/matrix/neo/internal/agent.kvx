NODE id=matrix/neo/internal/agent.groundTruth kind=var
  digest=b3:8743ee802c322fc062bd2f35c83f38fe3368f9d64a31772e1c8fa55f91e453a8 file=neo/internal/agent/prompt.go range=12:18 lang=go exported=false byte_range=225:581
  sig=string
  doc=groundTruth is Neo's always-injected factual grounding (who it is, that\nPaxeer is a real live chain, the canonical RPC/explorer/docs endpoints, and\nhow to answer chain questions with its read tools instead of blind web\nsearch). Embedded so it ships in the binary and can't drift from the build.
EDGES
  ^defines=matrix/neo/internal/agent/prompt.go

NODE id=matrix/neo/internal/agent.groundTruthFor kind=func
  digest=b3:71b47b91c76d437b4ee886a38b17df6e5e9f4128c876eb120ecae82b24991141 file=neo/internal/agent/prompt.go range=301:306 lang=go exported=false byte_range=36520:36871
  sig=func groundTruthFor(name string) string
  doc=groundTruthFor renders the embedded ground truth for the configured agent\nidentity: the {{AGENT_NAME}} placeholder binds the name from config\n(MORPHEUS req.8) so the grounding can never carry a stale hardcoded name.
EDGES
  ^defines=matrix/neo/internal/agent/prompt.go

NODE id=matrix/neo/internal/agent.guardDeliver kind=func
  digest=b3:ff972aebcdda3065a375fa65f628219b8e9b2dfc9e7f60f30c3e076549bc7427 file=neo/internal/agent/closechain.go range=223:229 lang=go exported=false byte_range=10764:11174
  sig=func guardDeliver(_ *Agent, _ *closeContext) (closeDecision, bool)
  doc=guardDeliver is the terminal guard: nothing blocked the close, so the answer\nships. It always fires, making the chain total — every evaluation produces a\ndecision. Contract — mutates: nothing (delivery itself happens in closeTurn\nvia finishTurn, the single choke point).
EDGES
  ^defines=matrix/neo/internal/agent/closechain.go

NODE id=matrix/neo/internal/agent.guardEmptyAnswer kind=func
  digest=b3:7f9f374add581ec23d245860a95ce8d005469698de829af5882c70ee2cbb760f file=neo/internal/agent/closechain.go range=136:148 lang=go exported=false byte_range=6159:6854
  sig=func guardEmptyAnswer(a *Agent, cc *closeContext) (closeDecision, bool)
  doc=guardEmptyAnswer: empty AND no tools → anti-premature steer to continue via\nthe guidance channel, bounded so a model that keeps returning nothing\nescalates rather than looping forever. Its bound is independent of all\nother close guards and tool-repeat detection.
EDGES
  ^defines=matrix/neo/internal/agent/closechain.go

NODE id=matrix/neo/internal/agent.guardIdentityLeak kind=func
  digest=b3:82efd8616fe2843dda64e4f1d6b07b44655fa2eb90f5aec3697994af5a68515b file=neo/internal/agent/closechain.go range=200:221 lang=go exported=false byte_range=9526:10762
  sig=func guardIdentityLeak(a *Agent, cc *closeContext) (closeDecision, bool)
  doc=guardIdentityLeak: the identity-compliance canary (P0) — if the settled\nanswer broke character and self-identified as the underlying LLM, treat it\nas a charter breach, not a typo: a model that won't hold its own name is\nsignalling it may ignore the harder rules too. Surface it on the audit\nside-channel (never blind), scrub the answer, and re-anchor via the guidance\nchannel so the model regenerates a compliant answer. Once the nudge budget\nis spent the honest, SCRUBBED answer is delivered rather than looping\nforever (finishTurn re-scrubs at delivery regardless). Contract — mutates:\ncc.answer (the scrub) and the working transcript (guidance); emits the\nidentity.leak audit event. Its retry bound is independent.
EDGES
  ^defines=matrix/neo/internal/agent/closechain.go

NODE id=matrix/neo/internal/agent.guardInboxDrain kind=func
  digest=b3:41a77adca3eef653e18685cc6054f10d2c075ca740ab211ff6c99317e7b5422e file=neo/internal/agent/closechain.go range=97:111 lang=go exported=false byte_range=4159:4920
  sig=func guardInboxDrain(a *Agent, _ *closeContext) (closeDecision, bool)
  doc=guardInboxDrain: a message queued mid-turn (F5) may have arrived during this\nmodel call, just as the agent is about to finish. Address it instead of\nclosing the turn, so a non-interrupting mid-task message is never dropped at\nthe turn boundary. Contract — mutates: the working transcript (appends the\ndrained user messages); fires only when at least one message was injected.
EDGES
  ^defines=matrix/neo/internal/agent/closechain.go

NODE id=matrix/neo/internal/agent.guardSourceFetch kind=func
  digest=b3:f941c44a60bb96d4feb7f9b5ada0f88d83c9dfa8eaa63923d5f2a5d2480708f0 file=neo/internal/agent/closechain.go range=188:198 lang=go exported=false byte_range=8853:9524
  sig=func guardSourceFetch(a *Agent, _ *closeContext) (closeDecision, bool)
EDGES
  ^defines=matrix/neo/internal/agent/closechain.go

NODE id=matrix/neo/internal/agent.guardTruncatedAnswer kind=func
  digest=b3:dddadd0759008bd400101c872bd50afe2f2f09ca0944d460797795fb776445de file=neo/internal/agent/closechain.go range=113:134 lang=go exported=false byte_range=4922:6157
  sig=func guardTruncatedAnswer(a *Agent, cc *closeContext) (closeDecision, bool)
  doc=guardTruncatedAnswer: a truncated generation (finish_reason=length) is never\na final answer. It receives exactly one synthesis retry, independent of\nearlier tool-repeat or close-guard pressure. A second truncation ends this\nattempt as resumable so the supervisor can continue from durable state.
EDGES
  ^defines=matrix/neo/internal/agent/closechain.go

NODE id=matrix/neo/internal/agent.guardUnreadOverflow kind=func
  digest=b3:e64a1111f976821c5784a998d4bc102b344b1f4500249edbaa9f1dfb8b70bb39 file=neo/internal/agent/closechain.go range=154:175 lang=go exported=false byte_range=7035:8205
  sig=func guardUnreadOverflow(a *Agent, _ *closeContext) (closeDecision, bool)
  doc=guardUnreadOverflow: read-full discipline (req.4.2) — a tool result too\nlarge to show inline was spilled to an overflow file. Don't let the turn end\non a bare answer while that output is still unread; steer (via the guidance\nchannel) to read it first, so the answer can't be drawn from a truncated\nresult. The steer is honest about non-delivery (the held-back answer is in\nthe window but the user never saw it) and BOUNDED: past overflowNudgeCap the\nguard stands down and the answer delivers — the identity-leak posture. The\nunbounded form drove the 2026-07-22 loopty-loop death spiral: complete\nanswers were silently withheld until an unrelated shared cap killed the\nturn. Contract — mutates the working transcript and the per-turn overflow\nnudge counter; fires only while under its own cap.
EDGES
  ^defines=matrix/neo/internal/agent/closechain.go

NODE id=matrix/neo/internal/agent.httpErrorRe kind=var
