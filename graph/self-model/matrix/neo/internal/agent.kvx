  ^defines=matrix/neo/internal/agent/premise.go

NODE id=matrix/neo/internal/agent.Agent.prepareTurn kind=method
  digest=b3:065eed073b8993b0056ce8e9d373527e6b83a8a89608f1cb355c5aaad123922e file=neo/internal/agent/agent.go range=714:838 lang=go exported=false byte_range=32046:37485
  sig=func (a *Agent) prepareTurn(ctx context.Context, userInput, audioData string) (string, error)
  doc=prepareTurn is the turn half of the prepare stage (MORPHEUS req.3.1), run\nONCE at Chat entry. Contract — inputs: the trimmed user input; mutates: the\nworking transcript (appends the user message), the durable cortex transcript\n(records it), the turn's surfaced-memory sets, and activationAssemblies;\nreturns: the rendered activation tail (cmTail) frozen for the whole turn.\n\nThe single memory path (MORPHEUS req.1): the per-turn working set comes\nfrom cortex.Activate, computed ONCE per turn and rendered as the trailing\nUSER-role tail (the activation snapshot is frozen for the whole turn — the\nNE-7 discipline). The Q2 first-turn relevance push rides the same tail so\nthe usage-salience attestation loop still learns from what surfaced.
EDGES
  ^contains=matrix/neo/internal/agent.Agent
  ^defines=matrix/neo/internal/agent/agent.go

NODE id=matrix/neo/internal/agent.Agent.prepareWindow kind=method
  digest=b3:0ede8d0a90b8396d8e06fced2b73b45d081d4d8093c425be8cb8c054d03860a9 file=neo/internal/agent/agent.go range=840:876 lang=go exported=false byte_range=37487:39336
  sig=func (a *Agent) prepareWindow(cmTail string) (window []llm.Message, tail string, pct int, err error)
  doc=prepareWindow is the step half of the prepare stage and the ONE window-\nassembly site per step (MORPHEUS req.3.2) — the oversize-recovery path\nre-enters it rather than assembling its own window. Contract — inputs: the\nturn-frozen activation tail; mutates: the working transcript ONLY via the\ntrim/strip recovery helpers (cmTrimWorking, stripOldImages) when over\nbudget; returns: the assembled window, the full trailing tail, and the\ncontext-fill percentage for the budget stat.\n\nThe single window law (MORPHEUS req.1.3): the byte-stable charter prefix at\nindex 0 + the append-only live transcript + the rendered Activate bundle as\nONE trailing USER-role message (Qwen-template portability). Over-budget\ntrimming is NON-summarizing (cmTrimWorking) because the older turns are\ndurable in cortex and the coarse history rides the durable story-so-far\nalready surfaced in cmTail. The request-body byte cap is independent of the\ntoken budget: the token estimate undercounts the serialized JSON, so a\nwindow within token budget can still 413 — images strip first (cheaper,\nless lossy), then the trim.
EDGES
  ^contains=matrix/neo/internal/agent.Agent
  ^defines=matrix/neo/internal/agent/agent.go

NODE id=matrix/neo/internal/agent.Agent.provenanceRange kind=method
  digest=b3:ce043ce74f49db79a7c57d80b41aec1509d7fb92618ec77057f0dc7a6bd917ce file=neo/internal/agent/continuous.go range=170:180 lang=go exported=false byte_range=5029:5560
  sig=func (a *Agent) provenanceRange() (conv string, seqLo, seqHi uint64)
  doc=provenanceRange returns the conversation id and inclusive session seq span\nconsolidation should stamp onto every memory it writes this turn (DEJA-VU req\n1.1). It returns a blank conv (disabling provenance linking) when nothing was\nappended this turn (no pager / bare agent), so a memory is never linked to a\nslice that does not exist.
EDGES
  ^contains=matrix/neo/internal/agent.Agent
  ^defines=matrix/neo/internal/agent/continuous.go

NODE id=matrix/neo/internal/agent.Agent.pushGuidance kind=method
  digest=b3:3071bafc7c5dc2808924c52728132ca38cfb390d638f9f86e1fefe15b0d49bff file=neo/internal/agent/agent.go range=1201:1220 lang=go exported=false byte_range=56172:57235
  sig=func (a *Agent) pushGuidance(text string) llm.Message
  doc=pushGuidance is THE guidance choke point (MORPHEUS req.3.3): every\nguidance-channel injection — the close-chain nudges, the legacy converge\nsteer, the self-claim contradiction and forced-revision directives, and the\nprediction-mismatch guidance — flows through this one function. It builds\nthe turn via llm.GuidanceMessage (the Guidance flag + envelope are what keep\nsteering out of the durable cortex transcript — cmRecordAssistant's\nIsGuidance gate — and off every user-facing surface — StripGuidance at the\nharness) and appends it to the working transcript. Contract — mutates: the\nworking transcript only; blank text appends nothing. Returns the built\nmessage (zero when nothing was appended) so a caller that must also thread\nthe steer into an in-flight window copy (forcedRevisionStep) reuses the SAME\nturn instead of minting a second one.
EDGES
  ^contains=matrix/neo/internal/agent.Agent
  ^defines=matrix/neo/internal/agent/agent.go

NODE id=matrix/neo/internal/agent.Agent.pushGuidanceNudge kind=method
  digest=b3:9f23d3f95bb19c0e629b1c3f53799f0a6c4aee5869311664c46d33c771827e53 file=neo/internal/agent/agent.go range=1222:1234 lang=go exported=false byte_range=57237:57962
  sig=func (a *Agent) pushGuidanceNudge(text string, counter *int) (capExceeded bool)
  doc=pushGuidanceNudge routes a system-steering nudge through the guidance choke\npoint (req.1.1) and folds it into the ONE unified unproductive-attempt\ncounter (req.8.1): it increments the counter and reports whether the bound is\nnow exceeded. The close-chain guards (truncation/empty/read-full/identity\nsteers) all push through here, so they share ONE bound with the no-progress\nrepeats fed in the loop. The counter is reset ONLY on genuine accepted\nprogress (req.8.2) — never by a plain tool dispatch. A cap of 0 disables the\nbound (unbounded nudging).
EDGES
  ^contains=matrix/neo/internal/agent.Agent
  ^defines=matrix/neo/internal/agent/agent.go

NODE id=matrix/neo/internal/agent.Agent.readOverflow kind=method
  digest=b3:ceeefbecf6cc7e296f0fa83bdf84671c2d310c40cd7d3aa4b77be9b4f866e787 file=neo/internal/agent/overflow.go range=224:254 lang=go exported=false byte_range=7510:8866
  sig=func (a *Agent) readOverflow(args map[string]interface{}) (string, bool)
  doc=readOverflow handles a model read_overflow call: it returns a bounded window\nof a stored overflow payload and marks it read. Parse/usage errors come back\nin-band (isError=true) so the model corrects rather than the harness retrying.
EDGES
  ^contains=matrix/neo/internal/agent.Agent
  ^defines=matrix/neo/internal/agent/overflow.go

NODE id=matrix/neo/internal/agent.Agent.readStepSignals kind=method
  digest=b3:0acbe4711bef4f98185a3049d77fdedaac9ee21b5483f8ee5c66fa525ce47501 file=neo/internal/agent/signals.go range=57:106 lang=go exported=false byte_range=2607:4497
  sig=func (a *Agent) readStepSignals(step int, calls []llm.ToolCall, repeats int, recentSigs []string, prevSig string, prevCalls []llm.ToolCall, distinct map[string]struct{}, closing bool) *stepSignals
  doc=readStepSignals is THE one computation of the per-step behavioral read\n(req.5.1). The stall inputs (repeats/recentSigs/prevSig/prevCalls/distinct)\nare explicit so the same core serves both the live turn state\n(computeStepSignals) and an explicitly-supplied state (buildCassandraSignals,\nkept for the controller's test surface). The ledger/graph/counter reads come\nfrom the live turn.
EDGES
  ^contains=matrix/neo/internal/agent.Agent
  ^defines=matrix/neo/internal/agent/signals.go

