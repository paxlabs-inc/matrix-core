  digest=b3:032d2d5e3649931fb1894d06744f91ba42c2340f0e17aa6a2871b4d6290768b6 file=neo/internal/agent/overflow.go range=61:86 lang=go exported=false byte_range=2367:3188
  sig=func (s *overflowStore) put(content string) (token string, path string, ok bool)
  doc=put writes content to a fresh run-scoped file and returns its token. On any\nfilesystem error it returns ok=false so the caller falls back to plain\nhead+tail truncation (graceful degradation — a bounded transcript beats a\ncrash).
EDGES
  ^contains=matrix/neo/internal/agent.overflowStore
  ^defines=matrix/neo/internal/agent/overflow.go

NODE id=matrix/neo/internal/agent.overflowStore.read kind=method
  digest=b3:854d22c8eafd3a6e95e6df1162775dc7c2f9b99a327ec7cbf91bc7580bb9af6b file=neo/internal/agent/overflow.go range=88:124 lang=go exported=false byte_range=3190:4062
  sig=func (s *overflowStore) read(token string, offset, limit int) (chunk string, total, next int, ok bool)
  doc=read returns a bounded window [offset, offset+limit) of the stored payload\nand marks the entry read. ok=false when the token is unknown. next is the\noffset to pass for the following page, or -1 when the end was reached.
EDGES
  ^contains=matrix/neo/internal/agent.overflowStore
  ^defines=matrix/neo/internal/agent/overflow.go

NODE id=matrix/neo/internal/agent.overflowStore.unread kind=method
  digest=b3:313d3ee41f9188756dfe0bc4d3fa8ce848160671487d9302daf988042a1a7f77 file=neo/internal/agent/overflow.go range=136:148 lang=go exported=false byte_range=4305:4641
  sig=func (s *overflowStore) unread() []string
  doc=unread returns the tokens of overflow payloads not yet read, in stable order.
EDGES
  ^contains=matrix/neo/internal/agent.overflowStore
  ^defines=matrix/neo/internal/agent/overflow.go

NODE id=matrix/neo/internal/agent.overlapPct kind=func
  digest=b3:043f78927c060665ef2a59d87ccee18db99223c2204fd0247984fcf58dfe55c2 file=neo/internal/agent/semantic.go range=162:183 lang=go exported=false byte_range=6314:6822
  sig=func overlapPct(a, b map[string]struct{}) int
  doc=overlapPct is the overlap coefficient (|a∩b| / min(|a|,|b|)) as a percentage.\nTwo empty word sets count as fully overlapping (identical word-free op); a\nnon-empty vs empty pair counts as no overlap.
EDGES
  ^defines=matrix/neo/internal/agent/semantic.go

