NODE id=matrix/neo/internal/agent.maxMediaTypeSpan kind=const
  digest=b3:46bba1cea23ca88378622137e0739a012b530592f814f8aa1d7f106f37811727 file=neo/internal/agent/payload.go range=41:45 lang=go exported=false byte_range=1686:1958
  sig=untyped int
  doc=maxMediaTypeSpan bounds how far after "data:" the ";base64," marker may sit\nfor the run to count as a data URI (a real media type is short, e.g.\n"image/png"); anything longer is treated as ordinary prose containing the\nword "data:".
EDGES
  ^defines=matrix/neo/internal/agent/payload.go

NODE id=matrix/neo/internal/agent.maxRequestBodyBytes kind=const
  digest=b3:c3ac12eda87260ce44914753c286c41a8890a9a2b576c546b9d2a0c094d8ad81 file=neo/internal/agent/agent.go range=2077:2082 lang=go exported=false byte_range=92509:92874
  sig=untyped int
  doc=maxRequestBodyBytes is the approximate serialized request-body ceiling Neo\nkeeps the outgoing window under. It sits below the provider's hard cap\n(Fireworks rejects bodies over 1,048,576 bytes with HTTP 413\n"body_too_large") with headroom for JSON structure + escaping that the byte\nestimate does not model exactly.
EDGES
  ^defines=matrix/neo/internal/agent/agent.go

NODE id=matrix/neo/internal/agent.maxRevisionsPerTurn kind=const
  digest=b3:d9fa072efa90307857fe5dcce23452e9f9c7a23e728f3197810d43044df5b268 file=neo/internal/agent/gate.go range=97:99 lang=go exported=false byte_range=3690:3872
  sig=untyped int
  doc=maxRevisionsPerTurn bounds forced revision steps so a pathological ledger\ncan never wedge a turn; past the bound the outer failsafes own the loop.
EDGES
  ^defines=matrix/neo/internal/agent/gate.go

NODE id=matrix/neo/internal/agent.maxThinkChars kind=const
  digest=b3:3e8c26d08e0b80d68bc58851f5aca6e8b471c42c678fb6afcfe5d9f2452c1ccc file=neo/internal/agent/agent.go range=1312:1314 lang=go exported=false byte_range=61547:61719
  sig=untyped int
  doc=maxThinkChars bounds the reasoning glimpse surfaced to the UI — enough to\nread the gist of the current thought, never the whole monologue.
EDGES
  ^defines=matrix/neo/internal/agent/agent.go

NODE id=matrix/neo/internal/agent.maxToolResultChars kind=const
  digest=b3:122dcfa38d20841e6aba787894f90a4a0c9fcb9bb8aa50a9d5fa2b0fd41ea5d4 file=neo/internal/agent/agent.go range=2084:2090 lang=go exported=false byte_range=92876:93358
  sig=untyped int
  doc=maxToolResultChars caps how much of a single tool result enters the working\ntranscript. A large fetch / file read / MCP payload appended verbatim can\nblow the provider's request-body byte cap on its own; the MCL walker bounds\ntool output for the same reason (runtime/walker.go). The full, untruncated\nresult is still handed to the observer so the product can show real\nevidence — only the model-facing transcript copy is bounded.
EDGES
  ^defines=matrix/neo/internal/agent/agent.go

NODE id=matrix/neo/internal/agent.minImageBlob kind=const
  digest=b3:7146a9800f43ac8c3b3a7a61f07b3fb74a6d83aea583b558aa89c7a4a1e73101 file=neo/internal/agent/payload.go range=47:50 lang=go exported=false byte_range=1960:2219
  sig=untyped int
  doc=minImageBlob is the smallest base64 payload treated as a strippable inline\nimage. Short data URIs in prose (a tiny icon, an example) are left verbatim;\nonly genuine payloads (a few hundred+ bytes) are charged flat / stripped.
EDGES
  ^defines=matrix/neo/internal/agent/payload.go

