  sig=func (a *Agent) noteNormalizedFailure(name string, args map[string]interface{}, failureClass exectool.FailureClass, recoveryClass delegate.FailureClass, isErr bool) error
  doc=noteNormalizedFailure bounds repeated deterministic failures by the\ninvariant strategy and semantic failure layer. Changing a guessed URL/path\nwhile repeating the same shell/search/fetch strategy cannot reset the bound.
EDGES
  ^contains=matrix/neo/internal/agent.Agent
  ^defines=matrix/neo/internal/agent/agent.go

