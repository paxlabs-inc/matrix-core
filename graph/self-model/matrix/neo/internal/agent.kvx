NODE id=matrix/neo/internal/agent.Agent.screenshotForCall kind=method
  digest=b3:29815c0ee8a6916fb533d0216224d7d5f9dda4dea90934cd3a73fa92c394518c file=neo/internal/agent/agent.go range=1873:1903 lang=go exported=false byte_range=85546:86855
  sig=func (a *Agent) screenshotForCall(ctx context.Context, name, directShot string, isErr bool) string
  doc=screenshotForCall resolves the page still to attach to a completed browser\ncall's observer event (BROWSER-FILMSTRIP). A direct browser_take_screenshot\nalready carries its persisted URL (directShot); otherwise, after a SUCCESSFUL\nview-changing browser action, it fires the deterministic, model-invisible\nauto-capture — gated by NEO_BROWSER_AUTOSHOT and bounded by the per-turn cap.\nBest-effort throughout: it returns "" (no frame) rather than ever disturbing\nthe call's result or the turn. Called only from the single-threaded result-\nassembly paths, so the per-turn counter never races the dispatch goroutines.
EDGES
  ^contains=matrix/neo/internal/agent.Agent
  ^defines=matrix/neo/internal/agent/agent.go

NODE id=matrix/neo/internal/agent.Agent.semanticRepeat kind=method
  digest=b3:c717311a242552c750078bc7734daba090797c8a2c6af3f1eaad742f81895e8b file=neo/internal/agent/semantic.go range=15:45 lang=go exported=false byte_range=261:2019
  sig=func (a *Agent) semanticRepeat(prev, cur []llm.ToolCall) bool
  doc=semanticRepeat reports whether the current tool-call batch is a no-progress\nrepeat of the previous one at the SAME operation, even when the surface\nwording of the arguments differs — so a cosmetic reword cannot defeat the\nno-progress guard (NE-4). Two batches are a semantic repeat when they share:\n  - the same tool SHAPE (the sorted tool names + the keys/values of any\n    NON-text arguments), so a different structured target (a different pool\n    id, a different numeric arg) is a distinct operation, not a repeat; AND\n  - the same TARGET identifiers (symbols / addresses / hashes / numbers\n    extracted from the text arguments), so reading two different pools does\n    NOT count as a repeat (the false-trip guard, req 4.3); AND\n  - a word overlap (the remaining free-text tokens) at or above the\n    configured threshold, so a genuinely different operation on the same\n    target (e.g. "read balance of X" vs "transfer from X") does not trip.\n\nIt returns false when semantic detection is disabled (threshold <= 0) or\neither batch is empty. The exact byte-signature path (batchSignature) remains\nthe primary trip; this catches the reworded case the exact path misses.
EDGES
  ^contains=matrix/neo/internal/agent.Agent
  ^defines=matrix/neo/internal/agent/semantic.go

NODE id=matrix/neo/internal/agent.Agent.snapshotLoop kind=method
  digest=b3:52081730afc691b1d53a92602dd03d7b9e3e487553ff4bde5a365a8aea660ec4 file=neo/internal/agent/death.go range=76:95 lang=go exported=false byte_range=3251:4002
  sig=func (a *Agent) snapshotLoop(step, pct, repeats int, recentSigs []string, batch []llm.ToolCall, distinct map[string]struct{})
  doc=snapshotLoop refreshes the live loop-state snapshot for THIS iteration. Called\nonce per step after the no-progress read, so a subsequent death exit captures\nthe real state. distinctTools is the breadth seen through prior steps plus any\nnew tool this batch introduces.
EDGES
  ^contains=matrix/neo/internal/agent.Agent
  ^defines=matrix/neo/internal/agent/death.go

NODE id=matrix/neo/internal/agent.Agent.stableSystem kind=method
  digest=b3:c4b977cd2a08f65f23492ff6637aa5fe72956c2d06a148e5effeee56f91534a5 file=neo/internal/agent/prompt.go range=35:65 lang=go exported=false byte_range=1514:2981
  sig=func (a *Agent) stableSystem() string
  doc=stableSystem returns the byte-stable system prefix: the behavioral charter\n(systemPrompt) + the embedded ground truth. It is identical across every\nturn of a session — nothing turn-varying (pinned memory, recalled turns,\nretrieved seeds, the consolidated summary, the budget stat) lives here — so\nit can ride the provider's longest-stable-prefix prompt cache. It is injected\nas the FIRST message of every window (P1-2).
EDGES
  ^contains=matrix/neo/internal/agent.Agent
  ^defines=matrix/neo/internal/agent/prompt.go

NODE id=matrix/neo/internal/agent.Agent.stripOldImages kind=method
  digest=b3:6097a205fde2de57cc819983130895c1ebc307661d0cfd24ac408a6af5b01a2b file=neo/internal/agent/payload.go range=174:192 lang=go exported=false byte_range=5814:6589
  sig=func (a *Agent) stripOldImages() int
  doc=stripOldImages drops inline image payloads from all but the most recent\nturns, returning the count stripped. Recent turns keep their images (the\nmodel may still be working with them); only older, already-discussed payloads\nare replaced. Used by the byte-cap backstop and the 413 recovery path as a\ncheaper, less lossy first step before a full compaction.
EDGES
  ^contains=matrix/neo/internal/agent.Agent
  ^defines=matrix/neo/internal/agent/payload.go

