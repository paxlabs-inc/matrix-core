NODE id=matrix/neo/internal/agent.NewAutomatrix kind=func
  digest=b3:5dc587185314028d881988cfefde682b66bb67df32465447b1eabdc139059d17 file=neo/internal/agent/automatrix_surface.go range=8:21 lang=go exported=true byte_range=218:896
  sig=func NewAutomatrix(o Options) *Agent
  doc=NewAutomatrix builds an Agent for an autonomous Automatrix run on the\nRESTRICTED (no-money) tool surface. It is a thin wrapper over New that FORCES\nRestrictTools — the existing sub-agent restricted-surface mechanism — so the\nmoney/chain core_execute delegate is structurally absent from the advertised\ntool schema set (req.3.2).\n\nConstructing the run through this helper means the restriction is a property\nof the constructor, not a caller responsibility: the engine cannot\naccidentally dispatch a proactive run on the full, money-capable surface.
EDGES
  ^defines=matrix/neo/internal/agent/automatrix_surface.go

NODE id=matrix/neo/internal/agent.NewInterview kind=func
  digest=b3:dd80734b8514b83ec0acf11797642adc2235f5ad210ff68f2263947519297b10 file=neo/internal/agent/interview.go range=26:33 lang=go exported=true byte_range=1057:1371
  sig=func NewInterview(o Options, existing string) *Agent
  doc=NewInterview builds an Agent for a personalization-interview conversation.\nexisting is the rendered existing-answers block for a repeat/edit interview\n("" on a first run, req 12.1).
EDGES
  ^defines=matrix/neo/internal/agent/interview.go

NODE id=matrix/neo/internal/agent.NewMorningBrief kind=func
  digest=b3:184e095296cb71d6a70f5666be0c2a7684421681d6ad697ced2c112c3129f9a9 file=neo/internal/agent/morningbrief.go range=30:42 lang=go exported=true byte_range=1537:2241
  sig=func NewMorningBrief(o Options) *Agent
  doc=NewMorningBrief builds an Agent for an autonomous morning-brief run on the\nTIGHT read-only information surface (Manager.BriefSchemas): web_news /\nweb_search / fetch + memory_recall only. Financial, signing, filesystem,\ndeployment, and arbitrary-execution tools (including core_execute) are\nstructurally absent (req 15.1). It also forces Automatrix so the run gets the\nautonomous-mode charter (user away, work self-contained, no screen surfaces,\nno questions back). The restriction is a property of the constructor, so the\nengine cannot accidentally dispatch a brief on a wider surface.
EDGES
  ^defines=matrix/neo/internal/agent/morningbrief.go

