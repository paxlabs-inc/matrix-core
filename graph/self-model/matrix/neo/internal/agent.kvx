  sig=func imageAwareTokens(s string) int
  doc=imageAwareTokens estimates the token cost of s, charging a flat per-image\nbudget for inline base64 image payloads instead of their (wildly larger)\nbase64 character length.
EDGES
  ^defines=matrix/neo/internal/agent/payload.go

