  digest=b3:ca41ba52bb0166253ef91a719a6c360ff34dba21be1f5191db7f34f9b8419044 file=neo/internal/agent/decompose.go range=8:31 lang=go exported=false byte_range=198:1542
  sig=func (a *Agent) budgetTail(pct int) string
  doc=budgetTail renders the live context-budget stat that trails every turn's\nwindow, plus — for a top-level agent that can actually decompose — the\nself-aware decomposition line (self-model task 4.2). Both are turn-varying, so\nthey live in the trailing message AFTER the byte-stable charter prefix and\nnever disturb the prompt-cache invariant.
EDGES
  ^contains=matrix/neo/internal/agent.Agent
  ^defines=matrix/neo/internal/agent/decompose.go

NODE id=matrix/neo/internal/agent.Agent.buildCassandraSignals kind=method
  digest=b3:3663c9f810cc5126f5f34469b9a9f65e8fa454f706f87cf157434d33e2b0e86b file=neo/internal/agent/cassandra.go range=137:148 lang=go exported=false byte_range=6758:7740
  sig=func (a *Agent) buildCassandraSignals(step int, msg llm.Message, repeats int, recentSigs []string, prevSig string, prevCalls []llm.ToolCall, distinctToolSet map[string]struct{}, closing bool) cassandraSignals
  doc=buildCassandraSignals assembles the controller's signal bundle from an\nexplicitly-supplied loop state — a thin projection over readStepSignals, the\nONE place the repeat reads are computed (MORPHEUS req.5.1). The repeat read\n(repeats / recentSigs / prevSig / prevCalls) still reflects the PREVIOUS\ncommitted batch here — noteBatch commits the current batch later — so\ncomparing the current batch against it yields the same repeat verdict\nnoteBatch will, one step early. effectiveRepeats adds 1 when the current\nbatch is itself a repeat, so the loop trigger can fire ONE step before the\nhard NoProgressStall.
EDGES
  ^contains=matrix/neo/internal/agent.Agent
  ^defines=matrix/neo/internal/agent/cassandra.go

NODE id=matrix/neo/internal/agent.Agent.bumpAnswerBudget kind=method
  digest=b3:d7c5a66991d8295c26a4eb7495c191a367f8a4e747f5dfad262ccbb4b0faf049 file=neo/internal/agent/agent.go range=1638:1657 lang=go exported=false byte_range=72695:73422
  sig=func (a *Agent) bumpAnswerBudget()
  doc=bumpAnswerBudget raises this turn's per-request output-token budget one rung.\nThe bumped budget rides every subsequent generate call this turn (turn.answer\nTokenBudget threads into the ChatRequest); 0 leaves the client default. Bounded\nby maxAnswerTokenBumps so a model that keeps getting cut off escalates through\nthe truncated-answer guard rather than growing the budget forever.
EDGES
  ^contains=matrix/neo/internal/agent.Agent
  ^defines=matrix/neo/internal/agent/agent.go

