NODE id=matrix/neo/internal/agent.Options#SelfModel kind=field
  digest=b3:2c8a95f06a698710f0042f2afc4eb87e3fe9c8fe0dd12c4276156e6c8af1b6e5 file=neo/internal/agent/agent.go range=351:359 lang=go exported=true byte_range=17062:17650
  sig=string
  doc=SelfModel is the shared self-model a sub-agent INHERITS from the agent that\nspawned it (self-model task 4.3, req.9.1): a compact rendering of the\nstructural self-summary plus the relevant how-I-fail patterns, injected into\nthe sub-agent's charter so it acts as the SAME mind (Neo) on a scoped slice\n— knowing how it is built and how it tends to fail — rather than a blank\nhelper. Empty on the top-level agent (which carries its self-model through\nits own memory surface) and on any sub-agent spawned before the self-model\nis populated.
EDGES
  ^contains=matrix/neo/internal/agent.Options

