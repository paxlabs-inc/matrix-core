  digest=b3:293ee487c45aeac7bf40b37dd8dcedf33855cacbab15c0ae72adeded9360b72a file=neo/internal/agent/overflow.go range=284:294 lang=go exported=false byte_range=10139:10397
  sig=func argInt(v interface{}, def int) int
  doc=argInt coerces a JSON number argument (float64) into an int, falling back to\ndef for a missing or non-numeric value.
