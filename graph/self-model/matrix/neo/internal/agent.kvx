NODE id=matrix/neo/internal/agent.injectExpectParam kind=func
  digest=b3:baaaec8d19a20a9edabeb1c7a399278bf2eabd4257442c329204a531e605d92a file=neo/internal/agent/prediction.go range=33:69 lang=go exported=false byte_range=1527:2753
  sig=func injectExpectParam(schemas []llm.Tool) []llm.Tool
  doc=injectExpectParam returns a copy of the advertised schemas with an `expect`\nstring property added only to genuinely uncertain probe schemas. Copy-on-write:\nthe Manager's own schema maps are never mutated — Schemas() hands out the\nSAME underlying parameter maps on every call, so an in-place edit here\nwould poison every later consumer (sub-agents, the capability surface).
EDGES
  ^defines=matrix/neo/internal/agent/prediction.go

