NODE id=matrix/neo/internal/agent.contentChurnSimilarityPct kind=const
  digest=b3:36f22da604bdd89a9293d34df49e133031aa087962ed27e81bf48238c8ca98fc file=neo/internal/agent/semantic.go range=90:96 lang=go exported=false byte_range=3674:4164
  sig=untyped int
  doc=contentChurnSimilarityPct is the word-overlap bar at which two consecutive\nbare-answer prose turns count as the same answer re-derived. It is HIGHER than\nthe tool-argument reword bar (SemanticStallSimilarityPct) because prose turns\nnaturally share far more common words than terse tool arguments, so the\nthreshold for "this is the same answer again" must be stricter to avoid\nflagging two genuinely different answers on the same topic.
EDGES
  ^defines=matrix/neo/internal/agent/semantic.go

