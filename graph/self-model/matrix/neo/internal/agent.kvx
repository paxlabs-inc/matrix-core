  digest=b3:44f3af43c54100004a5823ac2cb95082cda2e166e51294c25562f4dad8b657f1 file=neo/internal/agent/morningbrief.go range=23:28 lang=go exported=true byte_range=1229:1535
  sig=func IsMorningBriefWake(userInput string) bool
  doc=IsMorningBriefWake reports whether the user input is a Chronos MORNING_BRIEF\nwake — i.e. it carries the MORNING_BRIEF marker that distinguishes a brief\nturn from a normal user message.
