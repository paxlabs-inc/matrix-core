NODE id=matrix/neo/internal/agent.Agent.noteBatch kind=method
  digest=b3:75d2d7981faa5e3dc96a0e7ef34c3edebba654b465c57f0c8486304f7c8db9ce file=neo/internal/agent/agent.go range=1327:1355 lang=go exported=false byte_range=60367:61751
  sig=func (a *Agent) noteBatch(calls []llm.ToolCall) (repeat, stalled bool)
  doc=noteBatch commits the no-progress/stall read for ONE assistant tool-calling\nbatch from the unified per-step signal state (MORPHEUS req.5.1): the repeat\nverdict (byte-identical, SEMANTIC reword, or a rotating A→B→A→B cycle that\nintroduces no new tool — a distinct operation resets it, NE-4) was computed\nONCE in computeStepSignals at deliberate entry; noteBatch advances the\ncommitted stall bookkeeping from it. Sharing one read between the dispatch\npath and the Cassandra controller is what keeps the two from drifting\n(N2/req.8.3 heritage: nothing bypasses stall detection). Contract — mutates\nonly the turn's stall bookkeeping; returns whether the batch was a repeat\nand whether the pure-repeat stall bound (NoProgressStall) is met.
EDGES
  ^contains=matrix/neo/internal/agent.Agent
  ^defines=matrix/neo/internal/agent/agent.go

NODE id=matrix/neo/internal/agent.Agent.noteCloseChurn kind=method
  digest=b3:0a4879494c26edb401fd6fdeb72e0783857ba695de9c67e634a88dff8a9021f8 file=neo/internal/agent/agent.go range=1200:1221 lang=go exported=false byte_range=53746:54673
  sig=func (a *Agent) noteCloseChurn(answer string) bool
  doc=noteCloseChurn tracks reasoning churn across consecutive re-looped bare-answer\ncloses (item 2): a close that re-loops and whose prose substantially repeats\nthe previous re-looped close is the model re-deriving the same answer without\nprogressing. The tool-batch repeat detectors miss it — a bare answer carries no\ntool calls to compare. It counts consecutive such closes and reports whether\nthe count met the no-progress stall bound. The empty-answer case is owned by\nguardEmptyAnswer and skipped here; distinct prose resets the run.
EDGES
  ^contains=matrix/neo/internal/agent.Agent
  ^defines=matrix/neo/internal/agent/agent.go

NODE id=matrix/neo/internal/agent.Agent.noteFailureClass kind=method
  digest=b3:f3f308af9e082f332caa9feaa5637ee85832f5b4e42e0ad038bffe6f71362063 file=neo/internal/agent/agent.go range=1977:1996 lang=go exported=false byte_range=87245:88333
  sig=func (a *Agent) noteFailureClass(class delegate.FailureClass, isErr bool)
  doc=noteFailureClass records the classified outcome of the most recent tool\ndispatch this turn so the task supervisor (LastFailureClass) reads the SAME\ntaxonomy the dispatch ladder used. A SUCCESSFUL dispatch CLEARS a prior\nfailure: recovery is real progress, so a turn that later dies did NOT die on\na wall it already got past — without the clear, one recovered exploration\nmiss (a 404 read of a guessed path) converts any later unrelated death into\na false deterministic stop-and-ask (the misleading "permission or limit"\nterminal over a healthy turn). A content-level tool error that carries no\nclassified failure (isErr with ClassNone) leaves the record untouched: the\nagent may still be stuck on the recorded wall. Called only from the\nsingle-threaded result-assembly paths, so it never races the concurrent\ndispatch goroutines.
EDGES
  ^contains=matrix/neo/internal/agent.Agent
  ^defines=matrix/neo/internal/agent/agent.go

NODE id=matrix/neo/internal/agent.Agent.noteNormalizedFailure kind=method
  digest=b3:1de0fb4fe2198dfb3a37e004d14e15de69f78c569a22536c1f80c706b067e47c file=neo/internal/agent/agent.go range=1998:2038 lang=go exported=false byte_range=88335:89859
  sig=func (a *Agent) noteNormalizedFailure(name string, args map[string]interface{}, failureClass exectool.FailureClass, recoveryClass delegate.FailureClass, isErr bool) error
  doc=noteNormalizedFailure bounds repeated deterministic failures by the\ninvariant strategy and semantic failure layer. Changing a guessed URL/path\nwhile repeating the same shell/search/fetch strategy cannot reset the bound.
EDGES
  ^contains=matrix/neo/internal/agent.Agent
  ^defines=matrix/neo/internal/agent/agent.go

