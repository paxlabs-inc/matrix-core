NODE id=matrix/neo/internal/agent.Agent.Seed kind=method
  digest=b3:98e728869e69088390bacc3e02f57989e7dd00c110d1b9b67d8c61005bce5b4a file=neo/internal/agent/agent.go range=1283:1296 lang=go exported=true byte_range=60002:60588
  sig=func (a *Agent) Seed(history []llm.Message, goal string)
  doc=Seed primes a freshly-minted agent with a resumed conversation's durable\nhistory (user/assistant text turns, oldest-first) and goal, so reopening a\npast thread — or continuing one after a restart — retains context instead of\nstarting blank. No-op once the live transcript has any content, so it never\nclobbers an in-flight conversation.
EDGES
  ^contains=matrix/neo/internal/agent.Agent
  ^defines=matrix/neo/internal/agent/agent.go

NODE id=matrix/neo/internal/agent.Agent.SetGeneration kind=method
  digest=b3:f158d96032c6e666c4831d275e10249c70c8be9a5e083a9f2d090544457ecf79 file=neo/internal/agent/agent.go range=448:451 lang=go exported=true byte_range=21650:21941
  sig=func (a *Agent) SetGeneration(gen uint64)
  doc=SetGeneration tags this agent's current turn with a generation number from\nthe session's command queue (P2-6). A result whose generation has been\nsuperseded by a newer dispatch is discarded as stale. Call before Chat.
EDGES
  ^contains=matrix/neo/internal/agent.Agent
  ^defines=matrix/neo/internal/agent/agent.go

NODE id=matrix/neo/internal/agent.Agent.SetSkillIndex kind=method
  digest=b3:c7d1d409a428f31f721b410ff4a7d29528dfc6f12672a258ac24a0756540cc9f file=neo/internal/agent/agent.go range=480:487 lang=go exported=true byte_range=22947:23402
  sig=func (a *Agent) SetSkillIndex(names []string)
  doc=SetSkillIndex injects a names-only skill index into the STABLE system prefix\n(P2-2). The index lists available skills by NAME only — never full bodies\n(steps/gotchas/criteria), which are pulled on demand via memory_recall. This\nkeeps the cacheable prefix token-bounded and byte-stable across turns\n(consistent with P1-2). Call after the consolidator proposes skills.
EDGES
  ^contains=matrix/neo/internal/agent.Agent
  ^defines=matrix/neo/internal/agent/agent.go

NODE id=matrix/neo/internal/agent.Agent.SetUserProfile kind=method
  digest=b3:be4830c3c994733ebd631457d07f5a5cbb716d568547147d667bf3f51e501baa file=neo/internal/agent/agent.go range=489:502 lang=go exported=true byte_range=23404:24189
  sig=func (a *Agent) SetUserProfile(agentName, preferredName string, expertiseDomains []string)
  doc=SetUserProfile injects the onboarding profile (agent_name, preferred_name,\nexpertise_domains) into the STABLE system prefix. Called after agent\nconstruction (per session rebuild) so a later profile edit is reflected on\nsubsequent turns (req 8.2). The values are per-user-stable so they preserve\nthe prompt-cache byte-stability invariant (req 2.4): a non-empty agentName\noverrides cfg.AgentName, and empty preferredName + nil expertiseDomains\nproduce no identity section (clean fallback to default "Neo").
EDGES
  ^contains=matrix/neo/internal/agent.Agent
  ^defines=matrix/neo/internal/agent/agent.go

NODE id=matrix/neo/internal/agent.Agent.SetWorkspace kind=method
  digest=b3:5a483b9c9f9ddf65946b8fe1f289838d89b33e1cf78872bb5f3b36fee64468e3 file=neo/internal/agent/agent.go range=504:515 lang=go exported=true byte_range=24191:24894
  sig=func (a *Agent) SetWorkspace(root, projectID, projectName, projectRoot string)
  doc=SetWorkspace injects the coding-workspace context (workspace root + the\nconversation's active project) into the STABLE system prefix. Called after\nagent construction (per session rebuild), mirroring SetUserProfile. The\nvalues are per-conversation-stable (the project tag is fixed for a\nconversation), preserving the prompt-cache byte-stability invariant. An\nempty root disables the section (no workbench on this daemon).
EDGES
  ^contains=matrix/neo/internal/agent.Agent
  ^defines=matrix/neo/internal/agent/agent.go

NODE id=matrix/neo/internal/agent.Agent.WritebackEnabled kind=method
  digest=b3:0f879208cbdfb5c91aaca396e921ffe9b4eec11018f7cea1677f91f047cf9453 file=neo/internal/agent/interview.go range=35:39 lang=go exported=true byte_range=1373:1700
  sig=func (a *Agent) WritebackEnabled() bool
  doc=WritebackEnabled reports whether this agent runs background write-back\nextraction over its turns. False for interview agents (req 12.3: interview\nconversations are excluded from writeback so answers never become\nfragmented inferred memories).
EDGES
  ^contains=matrix/neo/internal/agent.Agent
  ^defines=matrix/neo/internal/agent/interview.go

NODE id=matrix/neo/internal/agent.Agent.act kind=method
  digest=b3:99d43d1ffaa3a5add185dc9055800c50a6a006cc0f6d61257e379fbee11c0704 file=neo/internal/agent/agent.go range=1056:1169 lang=go exported=false byte_range=48569:54784
  sig=func (a *Agent) act(ctx context.Context, step, pct int, res *llm.ChatResult) error
  doc=act is the act stage (MORPHEUS req.3.1): narration, the governor's outer\nfailsafe commit for this batch, the check-before-act gate, and tool\ndispatch with result assembly. Contract — inputs: the step index, this\nstep's context-fill pct, and the tool-calling model result; mutates: the\nworking transcript (tool results, guidance), the turn's stall bookkeeping\nand counters, the loop snapshot, and the epistemic run state (via the\nobserve seams); returns a terminal error (via governDeath) on a stall death\nor the unproductive-cap escalation, nil otherwise. (The failsafe commit\nstays after the preamble narration for order fidelity; its verdict comes\nfrom the unified signal state computed at deliberate.)
EDGES
  ^contains=matrix/neo/internal/agent.Agent
  ^defines=matrix/neo/internal/agent/agent.go

NODE id=matrix/neo/internal/agent.Agent.agentName kind=method
  digest=b3:9a829612d1d63e4465c772919de394590c8f6810579503cbe8419d09b2ab335d file=neo/internal/agent/identity.go range=72:79 lang=go exported=false byte_range=3706:3979
  sig=func (a *Agent) agentName() string
