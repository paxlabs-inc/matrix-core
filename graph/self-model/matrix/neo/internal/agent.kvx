  ^contains=matrix/neo/internal/agent.Agent
  ^defines=matrix/neo/internal/agent/death.go

NODE id=matrix/neo/internal/agent.Agent.LastFailureClass kind=method
  digest=b3:9d0331873124ce004e72b23ecce7e17364f265d4ed2a63348102c7d0b5410a27 file=neo/internal/agent/agent.go range=1804:1809 lang=go exported=true byte_range=81821:82267
  sig=func (a *Agent) LastFailureClass() delegate.FailureClass
  doc=LastFailureClass reports the shared FailureClass of the most recent\nclassified tool failure in the current turn (delegate.ClassNone when none).\nThe task supervisor reads it after Chat returns to decide whether a\nnon-clean exit is a deterministic blocker (stop-and-ask, no respawn) or a\ntransient/model/stall failure (the existing respawn path).
EDGES
  ^contains=matrix/neo/internal/agent.Agent
  ^defines=matrix/neo/internal/agent/agent.go

