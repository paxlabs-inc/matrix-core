NODE id=matrix/neo/internal/agent.Agent.predictionObserve kind=method
  digest=b3:faff53a4c4094f7a00feb9018babacac48cf67ac24acf25e7d4971327e231a82 file=neo/internal/agent/prediction.go range=202:279 lang=go exported=false byte_range=7567:11200
  sig=func (a *Agent) predictionObserve(ctx context.Context, name string, args map[string]interface{}, expect, content string, isErr bool) bool
  doc=predictionObserve is the belief-update seam, called from the single-threaded\nresult-assembly loops for every dispatched call. For a probe-class call it\nmaintains the strategy's hypothesis premise on the ledger (the expectation\nIS a premise: assumption at birth, cited on a match, refuted on a mismatch),\nadvances the per-strategy consecutive-mismatch meter, and appends structured\nguidance to the working transcript on a mismatch so the model must read the\nbelief update, not just another failure string. Returns whether the call was\na probe that MISSED its expectation (a missed probe discharges no evidence\non the task graph).
EDGES
  ^contains=matrix/neo/internal/agent.Agent
  ^defines=matrix/neo/internal/agent/prediction.go

NODE id=matrix/neo/internal/agent.Agent.premiseDischarge kind=method
  digest=b3:66d424ccf70a9e1c6658ccd6764d9de722b6625ee567faddf84ffc8370e5fd18 file=neo/internal/agent/premise.go range=282:292 lang=go exported=false byte_range=9616:9928
  sig=func (a *Agent) premiseDischarge(p *Premise, source, citation string)
  doc=premiseDischarge marks a premise cited (the check succeeded) and re-renders\nthe resident ledger the step it occurs.
