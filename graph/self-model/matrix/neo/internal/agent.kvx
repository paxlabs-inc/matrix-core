NODE id=matrix/neo/internal/agent.isLiveTypedTool kind=func
  digest=b3:22e09d7f45fdee3023f1c0d8c52a848e68e742731f87ab579e5bed4a2d994d5d file=neo/internal/agent/livetype.go range=39:47 lang=go exported=false byte_range=1400:1699
  sig=func isLiveTypedTool(name string) bool
