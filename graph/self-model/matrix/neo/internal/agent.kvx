NODE id=matrix/neo/internal/agent.Agent.cmRelevancePush kind=method
  digest=b3:d714095221e388e4687fe8acd0a316bf23aaa42f5b5900ee413311f48642b48e file=neo/internal/agent/continuous.go range=200:238 lang=go exported=false byte_range=6326:8016
  sig=func (a *Agent) cmRelevancePush(ctx context.Context, query string) ([]memory.Snippet, string)
  doc=cmRelevancePush is the Q2 first-message relevance push. cortex.Activate's\npushed tiers (Pinned/Timeline/Recent) are recency-based and query-INDEPENDENT\n(activate.go: the query arg is unused), so on the OPENING message the agent\ncarries recency but nothing matched to what the user actually asked unless it\nreactively calls memory_recall. This runs the pager's relevance retrieval\n(semantic HNSW + the always-on salience lane + edge cascade) ONCE, on turn 1\nonly, and returns both the retrieved snippets (so the caller can fold them\ninto the turn's surfaced set for the usage-salience learning loop) and a\nrendered block to append to the activation tail. After turn 1 the pull-not-\npush philosophy resumes (the model pages in the rest via memory_recall).\n\nReturns (nil, "") when disabled, off the first turn, without a pager, or when\nretrieval yields nothing — a pure read, no durable state is touched.
EDGES
  ^contains=matrix/neo/internal/agent.Agent
  ^defines=matrix/neo/internal/agent/continuous.go

NODE id=matrix/neo/internal/agent.Agent.cmTrimWorking kind=method
  digest=b3:2b153071e4ad4ca2a0fde4e72d5f05611a1e9e5898715b41ec37942d7f79c311 file=neo/internal/agent/continuous.go range=398:416 lang=go exported=false byte_range=14224:15029
  sig=func (a *Agent) cmTrimWorking()
  doc=cmTrimWorking is the continuous-memory replacement for a.compact (retired,\nreq.9.3): it bounds the live in-memory window WITHOUT an LLM summarization\npass, because the older turns are already durable in cortex (task 6.1) and\nthe coarse history is carried by the durable story-so-far (task 4.2), which\nActivate re-surfaces every turn. It keeps the most recent user turns verbatim\nand drops older ones; when the window is a single long turn (no older section\nto carve), it strips dead-weight inline images and keeps a provider-safe tail.
EDGES
  ^contains=matrix/neo/internal/agent.Agent
  ^defines=matrix/neo/internal/agent/continuous.go

NODE id=matrix/neo/internal/agent.Agent.compareExpectationModel kind=method
  digest=b3:c4a4b9aa6cffeefde33698d504cccc880399f603496fa58d736bda34c43d48fc file=neo/internal/agent/prediction.go range=174:195 lang=go exported=false byte_range=6729:7515
  sig=func (a *Agent) compareExpectationModel(ctx context.Context, expect, content string) bool
  doc=compareExpectationModel is the model-assisted comparison for outcomes the\ndeterministic detector cannot decide. Fails toward "match" (no belief-update\nevent on comparator failure — never fabricate a mismatch).
EDGES
  ^contains=matrix/neo/internal/agent.Agent
  ^defines=matrix/neo/internal/agent/prediction.go

NODE id=matrix/neo/internal/agent.Agent.computeStepSignals kind=method
  digest=b3:44fff0fcac902879e7ae29c7b254798db2ee0822673512e56a44d5bc211c604a file=neo/internal/agent/signals.go range=108:114 lang=go exported=false byte_range=4499:4932
  sig=func (a *Agent) computeStepSignals(step int, msg llm.Message) *stepSignals
  doc=computeStepSignals computes the unified signal state for THIS step from the\nturn's live state — called once per step at deliberate entry and stored on\nthe turn for every downstream consumer.
EDGES
  ^contains=matrix/neo/internal/agent.Agent
  ^defines=matrix/neo/internal/agent/signals.go

NODE id=matrix/neo/internal/agent.Agent.consolidateWorking kind=method
  digest=b3:2ba33090bd8f389bbcb4c4f5819917bd925ed20d954a56244263023f5c3d98ce file=neo/internal/agent/finish.go range=194:204 lang=go exported=false byte_range=7619:8201
  sig=func (a *Agent) consolidateWorking()
  doc=consolidateWorking sweeps the current turn's transcript into cortex (write-\nback option B). Called on EVERY terminal path — success, stall, step-budget\nexhaustion, and model error — so Neo also learns from failed/abandoned turns\n(a failure pattern is durable signal), not only from clean completions.\nBest-effort + idempotent enough: the consolidator de-dupes on write.
EDGES
  ^contains=matrix/neo/internal/agent.Agent
  ^defines=matrix/neo/internal/agent/finish.go

NODE id=matrix/neo/internal/agent.Agent.decompositionSelfKnowledge kind=method
  digest=b3:e6aae2148a0efdeae04ae18a2eebdb3b7e9850d1efec57a902b823db556555d2 file=neo/internal/agent/decompose.go range=21:60 lang=go exported=false byte_range=753:2822
  sig=func (a *Agent) decompositionSelfKnowledge(pct int) string
  doc=decompositionSelfKnowledge surfaces the agent's OWN context limit and current\nfill at the spawn_subagents decision point (self-model task 4.2, req.8.1/8.2),\nso the choice to fan a task out is grounded in the agent's real, self-known\nlimits rather than a single hardcoded threshold. It returns "" (surfaces\nnothing) unless this is the TOP-LEVEL agent AND spawning is actually available\nthis session — a sub-agent cannot spawn (no recursion / top-level-only,\nreq.8.3), so it is never given a decision it cannot act on.\n\nThe number is the same context window the budget math (budgetPct) meters\nagainst and the structural self-model records (StructuralSelf.ContextLimit),\nso the agent's decision-time self-knowledge is consistent with its derived\nself-model. The framing deliberately hands the JUDGEMENT to the model ("judge\nby whether the work fits what you can hold, not a fixed cutoff") rather than\nfiring at a constant — the existing budget/stall failsafes remain the backstop.
EDGES
  ^contains=matrix/neo/internal/agent.Agent
  ^defines=matrix/neo/internal/agent/decompose.go

NODE id=matrix/neo/internal/agent.Agent.deliberate kind=method
  digest=b3:bd16ad7971575dec348516fe5d799be826a67bad7ebf6cf3879f8034e1442062 file=neo/internal/agent/agent.go range=976:1023 lang=go exported=false byte_range=44204:46895
  sig=func (a *Agent) deliberate(step int, res *llm.ChatResult, streamedReasoning bool) (casMod bool)
  doc=deliberate is the deliberate stage (MORPHEUS req.3.1): the assistant turn\nis committed and the Cassandra controller reads the behavioral signals.\nContract — inputs: the step index, the model result, and whether reasoning\nalready streamed; mutates: the working transcript (appends the assistant\nmessage; Cassandra may edit that message's Content in place) and the\nCassandra per-turn state; returns: whether the controller modified the\nwindow this step (the close self-heal read).
EDGES
  ^contains=matrix/neo/internal/agent.Agent
  ^defines=matrix/neo/internal/agent/agent.go

NODE id=matrix/neo/internal/agent.Agent.dispatchWithRetry kind=method
  digest=b3:78f30d6ea0482f449c3d018c3effa5ac8f2b6eda0d78795d6c217a32c648c6c6 file=neo/internal/agent/agent.go range=1815:1939 lang=go exported=false byte_range=81997:88401
  sig=func (a *Agent) dispatchWithRetry(ctx context.Context, name string, args map[string]interface{}) (content, evidence, shot string, isErr bool, recoveryClass delegate.FailureClass, failureClass exectool.FailureClass)
  doc=dispatchWithRetry runs one tool call with the recovery ladder: bounded\nretries for transport/invocation errors (ladder 1); on exhaustion it\nreturns a descriptive failure as the tool result so the model can adapt\n(ladder 2/4) rather than the harness crashing.\n\nIt reads the shared failure taxonomy (delegate.ClassOf): a DETERMINISTIC\nfailure (a 4xx that recurs identically — a denied permission, an invalid or\nunparseable request) is returned as a SINGLE terminal result with no further\nattempts, mirroring chatWithRetry's ErrProviderRejected short-circuit. This\nstops the blind-retry amplifier (NE-1). Conflict (already-in-flight 409) and\npending (structured clarify) are deliberately NOT short-circuited here: they\nare left to their dedicated handlers (attach-to-existing / slot-fill); for\nnow they keep the bounded-retry behavior. The returned FailureClass is the\nclass of the failure that ended the dispatch (delegate.ClassNone on success),\nsurfaced so the supervisor reads the SAME classification.
EDGES
  ^contains=matrix/neo/internal/agent.Agent
  ^defines=matrix/neo/internal/agent/agent.go

NODE id=matrix/neo/internal/agent.Agent.drainInbox kind=method
  digest=b3:0fa3c4c4d72d58f2e52ca4bd39bc17bdf8ec138f1ffd5b6f6db215f93165291f file=neo/internal/agent/agent.go range=456:478 lang=go exported=false byte_range=22081:22945
  sig=func (a *Agent) drainInbox() bool
  doc=drainInbox folds any user messages queued while this turn is in flight (F5:\nnon-interrupting mid-task messages) into the working transcript, so the agent\naddresses them on its next step instead of the message cancelling the run.\nDrained at each tool-call boundary; returns true if it injected at least one.\nNo-op when no inbox is wired (CLI path). Injection happens at a clean\nboundary (loop top / pre-finish), where the transcript ends on a tool result\nor assistant turn, so appending a user message keeps it well-formed.
EDGES
  ^contains=matrix/neo/internal/agent.Agent
  ^defines=matrix/neo/internal/agent/agent.go

NODE id=matrix/neo/internal/agent.Agent.effectiveStepBudget kind=method
  digest=b3:15e5554cfec881b007d24f8f8c2e011682bfd209a6cc1e0cbaf9c93b1d515cf5 file=neo/internal/agent/agent.go range=536:601 lang=go exported=false byte_range=25896:28286
  sig=func (a *Agent) effectiveStepBudget(sig effectiveBudgetSignals) int
  doc=effectiveStepBudget computes the adaptive per-turn step budget within the\nconfigured [StepBudgetMin, StepBudgetMax] band, derived from observable\nturn-complexity signals (tool-call breadth so far).\n\nWhen adaptation is disabled (StepBudgetMin == 0, the default), it returns\nStepBudgetMax unchanged — today's fixed-budget behavior (no scope creep,\ndefault behavior matches exactly).\n\nWhen enabled (StepBudgetMin > 0), the budget scales UP from the floor\ntoward the ceiling as the turn shows breadth (more distinct tools). The\nscaling is conservative:\n\n  - 0-1 distinct tools → floor (simple turn, no breadth signal).\n  - Each additional distinct tool adds a proportional slice of the\n    [floor, ceiling] range, so 2 tools gets one step up, 3 gets more, etc.\n  - The result is clamped to [floor, ceiling] — never below the floor\n    for simple turns, never above the ceiling.\n\nThe no-progress stall path is independent and unaffected: a stalling turn\nterminates via NoProgressStall regardless of the effective budget (m9).
EDGES
  ^contains=matrix/neo/internal/agent.Agent
  ^defines=matrix/neo/internal/agent/agent.go

