NODE id=matrix/neo/internal/agent.Agent.SetSkillIndex kind=method
  digest=b3:c7d1d409a428f31f721b410ff4a7d29528dfc6f12672a258ac24a0756540cc9f file=neo/internal/agent/agent.go range=475:482 lang=go exported=true byte_range=22166:22621
  sig=func (a *Agent) SetSkillIndex(names []string)
  doc=SetSkillIndex injects a names-only skill index into the STABLE system prefix\n(P2-2). The index lists available skills by NAME only — never full bodies\n(steps/gotchas/criteria), which are pulled on demand via memory_recall. This\nkeeps the cacheable prefix token-bounded and byte-stable across turns\n(consistent with P1-2). Call after the consolidator proposes skills.
EDGES
  ^contains=matrix/neo/internal/agent.Agent
  ^defines=matrix/neo/internal/agent/agent.go

NODE id=matrix/neo/internal/agent.Agent.SetUserProfile kind=method
  digest=b3:be4830c3c994733ebd631457d07f5a5cbb716d568547147d667bf3f51e501baa file=neo/internal/agent/agent.go range=484:497 lang=go exported=true byte_range=22623:23408
  sig=func (a *Agent) SetUserProfile(agentName, preferredName string, expertiseDomains []string)
  doc=SetUserProfile injects the onboarding profile (agent_name, preferred_name,\nexpertise_domains) into the STABLE system prefix. Called after agent\nconstruction (per session rebuild) so a later profile edit is reflected on\nsubsequent turns (req 8.2). The values are per-user-stable so they preserve\nthe prompt-cache byte-stability invariant (req 2.4): a non-empty agentName\noverrides cfg.AgentName, and empty preferredName + nil expertiseDomains\nproduce no identity section (clean fallback to default "Neo").
EDGES
  ^contains=matrix/neo/internal/agent.Agent
  ^defines=matrix/neo/internal/agent/agent.go

NODE id=matrix/neo/internal/agent.Agent.SetWorkspace kind=method
  digest=b3:5a483b9c9f9ddf65946b8fe1f289838d89b33e1cf78872bb5f3b36fee64468e3 file=neo/internal/agent/agent.go range=499:510 lang=go exported=true byte_range=23410:24113
  sig=func (a *Agent) SetWorkspace(root, projectID, projectName, projectRoot string)
  doc=SetWorkspace injects the coding-workspace context (workspace root + the\nconversation's active project) into the STABLE system prefix. Called after\nagent construction (per session rebuild), mirroring SetUserProfile. The\nvalues are per-conversation-stable (the project tag is fixed for a\nconversation), preserving the prompt-cache byte-stability invariant. An\nempty root disables the section (no workbench on this daemon).
EDGES
  ^contains=matrix/neo/internal/agent.Agent
  ^defines=matrix/neo/internal/agent/agent.go

NODE id=matrix/neo/internal/agent.Agent.agentName kind=method
  digest=b3:9a829612d1d63e4465c772919de394590c8f6810579503cbe8419d09b2ab335d file=neo/internal/agent/identity.go range=72:79 lang=go exported=false byte_range=3706:3979
