NODE id=matrix/neo/internal/agent.turn.commitOutcome kind=method
  digest=b3:4e34c60513a96398adc9ea71a96d813bc5d7ef4a8ceed0f767815258cf11d009 file=neo/internal/agent/turn.go range=267:281 lang=go exported=false byte_range=11943:12611
  sig=func (t *turn) commitOutcome(outcome o1.OperationOutcome)
  doc=commitOutcome records the most recent O1 operation outcome. It is safe to\ncall from the concurrent tool-dispatch goroutines. Semantics are unchanged\nfrom the single-threaded form — last writer wins — so a serial sequence of\ncalls still ends on the last call's outcome; under concurrent dispatch "last"\nmeans last to COMPLETE, which is why the supervisor reads the run ledger (a\ncomplete, ordered record) for anything order-sensitive and treats this field\nonly as the most recent signal.
EDGES
  ^contains=matrix/neo/internal/agent.turn
  ^defines=matrix/neo/internal/agent/turn.go

NODE id=matrix/neo/internal/agent.turn.commitOutcomeIfStandingIsNotTerminal kind=method
  digest=b3:3f1fecbf9e1434bb37178cebed59f045395f80e935fcdf958f8ee3ff5b532d80 file=neo/internal/agent/turn.go range=294:307 lang=go exported=false byte_range=12891:13455
  sig=func (t *turn) commitOutcomeIfStandingIsNotTerminal(outcome o1.OperationOutcome)
  doc=commitOutcomeIfStandingIsNotTerminal records an outcome unless a TERMINAL\nfailure is already standing, so the synthetic turn-death outcome never\nmasks the real tool failure that caused the death. Same precedence rule the\ngovernor has always applied, moved under the lock with it.
EDGES
  ^contains=matrix/neo/internal/agent.turn
  ^defines=matrix/neo/internal/agent/turn.go

