NODE id=matrix/neo/internal/agent.Agent.validateSelfClaim kind=method
  digest=b3:2efd842f2d01644cfa62d708d944b15c5891451eb2708d58c127af5fd3edb805 file=neo/internal/agent/gate.go range=33:71 lang=go exported=false byte_range=1239:2990
  sig=func (a *Agent) validateSelfClaim(p *Premise) (claimVerdict, string)
  doc=validateSelfClaim checks a self-referential capability premise against the\nresident capability surface. Deterministic and complete-inventory-backed:\nthe surface section advertises itself as the full inventory ("a capability\nnot listed here is one you do NOT have"), so a surface-shaped claim that\nmatches no resident fact is FALSE, not merely unverified. With no resident\nsurface the verdict is unknown — never fabricated (req.2.3 posture).
EDGES
  ^contains=matrix/neo/internal/agent.Agent
  ^defines=matrix/neo/internal/agent/gate.go

NODE id=matrix/neo/internal/agent.Agent.windowBytes kind=method
  digest=b3:f3077244ec67b6325b85bad80e5fff56b42b2e768cae404a7a5bc57c53bce643 file=neo/internal/agent/agent.go range=2106:2121 lang=go exported=false byte_range=93726:94412
  sig=func (a *Agent) windowBytes(system string) int
  doc=windowBytes approximates the serialized chat-completions request body in\nBYTES: the system block + every working message's content and tool-call\narguments + the tool schemas. It is a byte proxy (NOT a token estimate)\nbecause the provider's 413 cap is on raw body bytes, which the token budget\ndoes not track. The per-message constant covers JSON structural overhead\n(role/keys/braces/quoting).
EDGES
  ^contains=matrix/neo/internal/agent.Agent
  ^defines=matrix/neo/internal/agent/agent.go

