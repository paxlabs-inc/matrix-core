NODE id=matrix/neo/internal/agent.Agent.escalateGuidance kind=method
  digest=b3:6e2173a1fb62bcb8e2f2dc8f894295b9829d679149e15bafded4974f141157a0 file=neo/internal/agent/agent.go range=1243:1252 lang=go exported=false byte_range=58295:59069
  sig=func (a *Agent) escalateGuidance(attempts int) error
  doc=escalateGuidance ends the turn with an honest stop-and-ask once the unified\nunproductive-attempt bound is exceeded (req.1.5, req.8): re-nudging — or\nre-attempting a premature completion — indefinitely is not the answer, so it\nmarks a DETERMINISTIC blocker (the task supervisor then stops-and-asks the\nuser rather than respawning into the same loop) and ends the turn through\nthe governor's terminal verdict with an honest where-it-stands digest.
EDGES
  ^contains=matrix/neo/internal/agent.Agent
  ^defines=matrix/neo/internal/agent/agent.go

NODE id=matrix/neo/internal/agent.Agent.evalCloseChain kind=method
  digest=b3:a14d7507a145af1917df0702d03aa7a561d04da50c942c1df706f504cc59245a file=neo/internal/agent/closechain.go range=82:95 lang=go exported=false byte_range=3795:4470
