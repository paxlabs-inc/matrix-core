  ^defines=matrix/neo/internal/agent/premise.go

NODE id=matrix/neo/internal/agent.Agent.premiseObservePlan kind=method
  digest=b3:a740676d3d0dfc0d69c811759136b5f978ac98a657e27c03046a735183d8a1d8 file=neo/internal/agent/premise.go range=167:205 lang=go exported=false byte_range=5749:7181
  sig=func (a *Agent) premiseObservePlan(ctx context.Context, planText string)
  doc=premiseObservePlan runs at the plan-formation seam: the first committing\nassistant turn of a run (and again on plan change via premisePlanChanged).\nIt extracts the plan's premises (deterministic self-claim detector + cheap-\nmodel extraction), seeds the ledger, and renders it resident. Best-effort on\nthe model half: extraction failure degrades to the deterministic premises,\nnever blocks the turn.
EDGES
  ^contains=matrix/neo/internal/agent.Agent
  ^defines=matrix/neo/internal/agent/premise.go

NODE id=matrix/neo/internal/agent.Agent.premisePlanChanged kind=method
  digest=b3:7338d509b84cea55f10dc0c53ab159d2fbe8df761c7f9a5c31624bfd7ac1ee18 file=neo/internal/agent/premise.go range=207:219 lang=go exported=false byte_range=7183:7595
  sig=func (a *Agent) premisePlanChanged()
  doc=premisePlanChanged resets the ledger for a revised plan (refute → revision\npath, req.4.1 "and on plan change"): standing refuted premises are marked\nrevised, and the next committing turn re-extracts.
EDGES
  ^contains=matrix/neo/internal/agent.Agent
  ^defines=matrix/neo/internal/agent/premise.go

NODE id=matrix/neo/internal/agent.Agent.premiseRefute kind=method
  digest=b3:9f568c74df79b277de37ef1fe7e5a5fbf35cf468c7c02d6e92723acf0a2096fe file=neo/internal/agent/premise.go range=294:306 lang=go exported=false byte_range=9930:10324
