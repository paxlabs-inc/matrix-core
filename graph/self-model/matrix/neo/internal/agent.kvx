NODE id=matrix/neo/internal/agent.ErrIncomplete kind=var
  digest=b3:4e6eed0e72cdf4fd0e9a62f9fd08d93c7fad50b9a32ab9fffabd4d7a56e547db file=neo/internal/agent/agent.go range=38:46 lang=go exported=true byte_range=1242:1884
  sig=error
  doc=ErrIncomplete marks a turn that ended WITHOUT completing the task: the loop\nstalled (no progress) or exhausted its step budget. It is distinct from a\nmodel/transport error and from a genuine completion (nil). The task\nsupervisor (internal/server) treats it as "not done — keep going": it\nrespawns a fresh agent over durable state and continues, rather than\nsurfacing a fake "Done" to the user. The wrapped text carries a short,\nhonest where-I-got-stuck digest for the next attempt's catch-up.\nDetect with errors.Is(err, agent.ErrIncomplete).
EDGES
  ^defines=matrix/neo/internal/agent/agent.go

NODE id=matrix/neo/internal/agent.HeartbeatOK kind=const
  digest=b3:ad5d33c867838e0708efd636a5995323c8449e7be63af70870ee287b65230db7 file=neo/internal/agent/heartbeat.go range=20:24 lang=go exported=true byte_range=773:1110
  sig=untyped string
  doc=HeartbeatOK is the sentinel the agent emits when a heartbeat wake reviewed\nactive goals/constraints and found nothing needing attention. When the\nagent's final answer is exactly this token, the turn is suppressed —\na.out.Say is never called, so HEARTBEAT_OK is never surfaced to the user.
EDGES
  ^defines=matrix/neo/internal/agent/heartbeat.go

NODE id=matrix/neo/internal/agent.HeartbeatWakeMarker kind=const
  digest=b3:051437e8f58c3812b47cb034a7f942d2e1a7891a4c40126f9a1c0cb01778815d file=neo/internal/agent/heartbeat.go range=26:30 lang=go exported=true byte_range=1112:1412
  sig=untyped string
  doc=HeartbeatWakeMarker is the token a Chronos heartbeat alarm's wake_message\ncarries so Neo can detect it as a heartbeat (proactive review) turn rather\nthan a normal user message. Distinct from HeartbeatOK so a wake never\naccidentally self-suppresses.
EDGES
  ^defines=matrix/neo/internal/agent/heartbeat.go

NODE id=matrix/neo/internal/agent.HeartbeatWakeMessage kind=const
  digest=b3:184b73618d93a5eb70d0d7f7d4e7eff035f7d12fdbaf75ac007ff9161052358f file=neo/internal/agent/heartbeat.go range=32:36 lang=go exported=true byte_range=1414:1860
  sig=untyped string
  doc=HeartbeatWakeMessage is the canonical wake_message a Chronos heartbeat alarm\ndelivers. It instructs the agent to review active goals/constraints and reply\nwith HEARTBEAT_OK when nothing needs attention, or surface real content when\nsomething does.
EDGES
  ^defines=matrix/neo/internal/agent/heartbeat.go

