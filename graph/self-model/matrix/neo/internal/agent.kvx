NODE id=matrix/neo/internal/agent.Agent.cmRecordUser kind=method
  digest=b3:1dbdda02ee4ad8942bf80f98f91a40fb98732251fe8dbe203ca95cbe1c874283 file=neo/internal/agent/continuous.go range=42:56 lang=go exported=false byte_range=1484:1826
