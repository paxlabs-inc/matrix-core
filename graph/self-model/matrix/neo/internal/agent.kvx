NODE id=matrix/neo/internal/agent.sourceFetchNudgeCap kind=const
  digest=b3:74ef5dfe780e7ed41ae36205512d565b5a968a9f07e2e0aa358eefe259ee22df file=neo/internal/agent/closechain.go range=177:186 lang=go exported=false byte_range=8207:8851
  sig=untyped int
  doc=sourceFetchNudgeCap bounds how many closes the source-fetch guard may block\nper turn before it stands down and lets the composed answer deliver. It\nmirrors overflowNudgeCap for the same reason: the guard's precondition is not\nalways ACHIEVABLE. When every fetch of a discovered URL fails (paywall, bot\nwall, dead host), no amount of steering can make webEvidenceReady true, and\nan unbounded guard then withholds a finished answer indefinitely. Standing\ndown is honest:\nthe model is told the answer was held back and why, so a delivered answer\ncarries its own caveat about unread sources.
EDGES
  ^defines=matrix/neo/internal/agent/closechain.go

NODE id=matrix/neo/internal/agent.splitForCompaction kind=func
  digest=b3:8308288c4e54f64f92738128cdaf068e233cfe9cf1ff119c1741a8925e1a426c file=neo/internal/agent/payload.go range=145:172 lang=go exported=false byte_range=4862:5815
  sig=func splitForCompaction(msgs []llm.Message, keepUserTurns int) (older, recent []llm.Message)
  doc=splitForCompaction divides the working transcript into an older section to\nsummarize and a recent tail to keep verbatim, split at a user-message\nboundary so a tool-result is never orphaned from its assistant tool-call.\nReturns older=nil when there are too few user turns to carve a clean split\n(the caller then degrades rather than summarizing recent context away). The\nrecent tail is copied so later appends never alias the older backing array.
EDGES
  ^defines=matrix/neo/internal/agent/payload.go

