NODE id=matrix/neo/internal/agent.Agent.overflowUnreadNudge kind=method
  digest=b3:63ab1fc8edf218f0b300d74c0b3c0b9a45b07d58fc7bde09a51cbe606af8b7bd file=neo/internal/agent/overflow.go range=208:222 lang=go exported=false byte_range=6906:7473
  sig=func (a *Agent) overflowUnreadNudge() string
  doc=overflowUnreadNudge composes the guidance-channel steer that blocks finishing\nwhile overflow output is unread, naming the outstanding tokens.
EDGES
  ^contains=matrix/neo/internal/agent.Agent
  ^defines=matrix/neo/internal/agent/overflow.go

NODE id=matrix/neo/internal/agent.Agent.predictionObserve kind=method
  digest=b3:3689dde190a3c6810b70d20fea465d119a51ff65fde373045dfd60ebffb55570 file=neo/internal/agent/prediction.go range=199:285 lang=go exported=false byte_range=7559:11553
  sig=func (a *Agent) predictionObserve(ctx context.Context, name string, args map[string]interface{}, expect, content string, isErr bool) bool
  doc=predictionObserve is the belief-update seam, called from the single-threaded\nresult-assembly loops for every dispatched call. For a probe-class call it\nmaintains the strategy's hypothesis premise on the ledger (the expectation\nIS a premise: assumption at birth, cited on a match, refuted on a mismatch),\nadvances the per-strategy consecutive-mismatch meter, and appends structured\nguidance to the working transcript on a mismatch so the model must read the\nbelief update, not just another failure string. Returns whether the call was\na probe that MISSED its expectation (a missed probe discharges no evidence\non the task graph).
EDGES
  ^contains=matrix/neo/internal/agent.Agent
  ^defines=matrix/neo/internal/agent/prediction.go

NODE id=matrix/neo/internal/agent.Agent.premiseDischarge kind=method
  digest=b3:66d424ccf70a9e1c6658ccd6764d9de722b6625ee567faddf84ffc8370e5fd18 file=neo/internal/agent/premise.go range=278:288 lang=go exported=false byte_range=9288:9600
  sig=func (a *Agent) premiseDischarge(p *Premise, source, citation string)
  doc=premiseDischarge marks a premise cited (the check succeeded) and re-renders\nthe resident ledger the step it occurs.
EDGES
  ^contains=matrix/neo/internal/agent.Agent
  ^defines=matrix/neo/internal/agent/premise.go

NODE id=matrix/neo/internal/agent.Agent.premiseObservePlan kind=method
  digest=b3:eec7d1314e07d0a09d7078e6622a7e3cbbf643c89c10e1e22ac15236a9cb40c5 file=neo/internal/agent/premise.go range=167:205 lang=go exported=false byte_range=5716:7128
  sig=func (a *Agent) premiseObservePlan(ctx context.Context, planText string)
  doc=premiseObservePlan runs at the plan-formation seam: the first committing\nassistant turn of a run (and again on plan change via premisePlanChanged).\nIt extracts the plan's premises (deterministic self-claim detector + cheap-\nmodel extraction), seeds the ledger, and renders it resident. Best-effort on\nthe model half: extraction failure degrades to the deterministic premises,\nnever blocks the turn.
EDGES
  ^contains=matrix/neo/internal/agent.Agent
  ^defines=matrix/neo/internal/agent/premise.go

NODE id=matrix/neo/internal/agent.Agent.premisePlanChanged kind=method
  digest=b3:fdcc45044a7a65bed2933c6caa79801d349b0d12e79508db8b543148f7d578d9 file=neo/internal/agent/premise.go range=207:219 lang=go exported=false byte_range=7130:7522
  sig=func (a *Agent) premisePlanChanged()
  doc=premisePlanChanged resets the ledger for a revised plan (refute → revision\npath, req.4.1 "and on plan change"): standing refuted premises are marked\nrevised, and the next committing turn re-extracts.
EDGES
  ^contains=matrix/neo/internal/agent.Agent
  ^defines=matrix/neo/internal/agent/premise.go

NODE id=matrix/neo/internal/agent.Agent.premiseRefute kind=method
  digest=b3:9f568c74df79b277de37ef1fe7e5a5fbf35cf468c7c02d6e92723acf0a2096fe file=neo/internal/agent/premise.go range=290:302 lang=go exported=false byte_range=9602:9996
  sig=func (a *Agent) premiseRefute(p *Premise, citation string)
  doc=premiseRefute marks a premise refuted (the check contradicted it) and\nre-renders. A refuted premise forces a plan-revision step before further\ndependent dispatches (enforced at the gate, task 3.1).
EDGES
  ^contains=matrix/neo/internal/agent.Agent
  ^defines=matrix/neo/internal/agent/premise.go

NODE id=matrix/neo/internal/agent.Agent.pushGuidanceNudge kind=method
  digest=b3:d1c76a1f6d49733b6ac07dfee943b5d1b5f2239483a5c8284504ba8896dd7321 file=neo/internal/agent/agent.go range=1204:1217 lang=go exported=false byte_range=57229:58006
  sig=func (a *Agent) pushGuidanceNudge(text string, counter *int) (capExceeded bool)
  doc=pushGuidanceNudge routes a system-steering nudge through the guidance channel\n(req.1.1) and folds it into the ONE unified unproductive-attempt counter\n(req.8.1): it increments the counter and reports whether the bound is now\nexceeded. Completion-gate rejections and read-full/identity steers all push\nthrough here, so they share ONE bound with the no-progress repeats fed in the\nloop. The counter is reset ONLY on genuine accepted progress (req.8.2) — never\nby a plain tool dispatch. A cap of 0 disables the bound (unbounded nudging).
EDGES
  ^contains=matrix/neo/internal/agent.Agent
  ^defines=matrix/neo/internal/agent/agent.go

NODE id=matrix/neo/internal/agent.Agent.readOverflow kind=method
  digest=b3:495b5292abdcdebbed655ba92a3e5a43290e7211f2e645466d3e81a5066c97f4 file=neo/internal/agent/overflow.go range=224:254 lang=go exported=false byte_range=7475:8821
  sig=func (a *Agent) readOverflow(args map[string]interface{}) (string, bool)
  doc=readOverflow handles a model read_overflow call: it returns a bounded window\nof a stored overflow payload and marks it read. Parse/usage errors come back\nin-band (isError=true) so the model corrects rather than the harness retrying.
EDGES
  ^contains=matrix/neo/internal/agent.Agent
  ^defines=matrix/neo/internal/agent/overflow.go

NODE id=matrix/neo/internal/agent.Agent.recallTurns kind=method
  digest=b3:3acd6fc16e96ca6950b814b37d1a2cb993b86a740ef6329b15a5d4be44e6ea1a file=neo/internal/agent/agent.go range=1482:1490 lang=go exported=false byte_range=68134:68503
  sig=func (a *Agent) recallTurns(ctx context.Context, q string) []recall.Hit
  doc=recallTurns asks the optional conversational recaller for the most relevant\nPAST turns of this thread (beyond the live transcript). Best-effort: a nil\nrecaller or empty result simply yields no recall section.
EDGES
  ^contains=matrix/neo/internal/agent.Agent
  ^defines=matrix/neo/internal/agent/agent.go

NODE id=matrix/neo/internal/agent.Agent.recordDeath kind=method
  digest=b3:d065863edf7f0159e89d111fe5855635d9aea32302c3444ec7e823480b82f858 file=neo/internal/agent/death.go range=97:114 lang=go exported=false byte_range=4004:4832
  sig=func (a *Agent) recordDeath(reason, digest string)
  doc=recordDeath finalizes the structured death record from the live loop snapshot\nat a death exit (stall, step budget, or the unproductive-cap escalation). It\nis best-effort observability: it never blocks or alters the returned error,\npreserving the existing summary + successor-prime digest (req.3.2).
EDGES
  ^contains=matrix/neo/internal/agent.Agent
  ^defines=matrix/neo/internal/agent/death.go

NODE id=matrix/neo/internal/agent.Agent.renderActivationBundle kind=method
  digest=b3:505d178cd4c3904a241f5095da95e74d4b14e3048b6d16ca0c78dbbd769d7865 file=neo/internal/agent/continuous.go range=209:282 lang=go exported=false byte_range=7838:10548
  sig=func (a *Agent) renderActivationBundle(b *cortex.ActivationBundle) string
  doc=renderActivationBundle renders the cortex.Activate bundle into the trailing\nworking-memory block that REPLACES the dynamicTail memory sections (req.9.4).\nIt frames the block as in-progress reference (never a new instruction — the\nleading line tells the model to continue, not restart), then surfaces the\nstanding objective as background, the Pinned tier (identity, hard constraints,\nactive cortex goals), the durable story-so-far, the T0 timeline and T1 recent\ntiers, and a note that exact specifics page in on demand via memory_recall\n(T3 handles — the pull-over-push philosophy, req.9.5). The transcript slice is\nNOT re-rendered here: the live transcript is the window's middle already.\n\nThe block is delivered by the caller as a USER-role trailing message\n(assembleWindowUserTail) so strict Qwen-derived chat templates accept it (the\nprompt-window portability fix), keeping the byte-stable system prefix at\nindex 0.
EDGES
  ^contains=matrix/neo/internal/agent.Agent
  ^defines=matrix/neo/internal/agent/continuous.go

NODE id=matrix/neo/internal/agent.Agent.renderCapabilitySurface kind=method
  digest=b3:3a34a0e5436eefa1bd68ba6aac0c8933ce93d264c734ec2c6db11580b1a06fe8 file=neo/internal/agent/capability.go range=43:129 lang=go exported=false byte_range=2058:4629
  sig=func (a *Agent) renderCapabilitySurface() string
  doc=renderCapabilitySurface renders the resident capability-surface section of\nthe stable prefix. Byte-stable per agent: it reads only construction-time\nstate (a.capability, a.schemas), so it is byte-identical across every step\nof a turn (req.2.4).
EDGES
  ^contains=matrix/neo/internal/agent.Agent
  ^defines=matrix/neo/internal/agent/capability.go

NODE id=matrix/neo/internal/agent.Agent.renderGraphTail kind=method
  digest=b3:8840a02d71873412e34b70b606185f3c031417518634e74869cbe8a403158ca0 file=neo/internal/agent/taskgraph.go range=147:172 lang=go exported=false byte_range=5320:6511
  sig=func (a *Agent) renderGraphTail()
  doc=renderGraphTail renders the graph into its fixed tail slot (req.7.4): what\nis proven (evidence), what is assumed (standing assumptions on the ledger),\nand what remains (subgoals). Empty graph renders nothing.
EDGES
  ^contains=matrix/neo/internal/agent.Agent
  ^defines=matrix/neo/internal/agent/taskgraph.go

NODE id=matrix/neo/internal/agent.Agent.renderPremiseTail kind=method
  digest=b3:e5292e1e8a47d48514a9559c0b351b5523c7e6041da36865f1c1ba3ef8ddc865 file=neo/internal/agent/premise.go range=304:328 lang=go exported=false byte_range=9998:11085
  sig=func (a *Agent) renderPremiseTail()
  doc=renderPremiseTail renders the ledger into its fixed tail slot (req.4.2).\nEmpty ledger renders nothing (a clean turn is byte-identical to disabled).
EDGES
  ^contains=matrix/neo/internal/agent.Agent
  ^defines=matrix/neo/internal/agent/premise.go

NODE id=matrix/neo/internal/agent.Agent.renderRecall kind=method
  digest=b3:e7de3bdbcc023d7d78e79b4a00127e7ee3c8b4034d399cc0426f6f6bbd0550fd file=neo/internal/agent/prompt.go range=139:174 lang=go exported=false byte_range=5653:6651
  sig=func (a *Agent) renderRecall(recalled []recall.Hit) string
  doc=renderRecall formats relevant past turns for injection, DEDUPED against the\nlive transcript: a turn already present in a.working (the RAM tier / resume\nseed) is skipped so the same text never appears twice in the window. Returns\n"" when nothing survives. High-entropy tokens are copied verbatim (the trust\ncontract — recall never paraphrases).
EDGES
  ^contains=matrix/neo/internal/agent.Agent
  ^defines=matrix/neo/internal/agent/prompt.go

