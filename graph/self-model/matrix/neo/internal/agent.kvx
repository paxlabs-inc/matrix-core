  ^defines=matrix/neo/internal/agent/agent.go

NODE id=matrix/neo/internal/agent.Agent.capToolResult kind=method
  digest=b3:d8256d31aa2a59d2d0f247177ea8441315d04e6a89ff0fa08a622456c0bf1996 file=neo/internal/agent/overflow.go range=170:199 lang=go exported=false byte_range=5345:6770
  sig=func (a *Agent) capToolResult(name, content string) string
  doc=capToolResult bounds a single tool result for the working transcript. Within\nbudget it is returned verbatim. When it exceeds maxToolResultChars the FULL\noutput is persisted to a run-scoped overflow file and the transcript keeps a\nhead + tail plus a truncation notice carrying the overflow token and how to\nread the remainder (req.4.1) — never a silent cut. If the file cannot be\nwritten it degrades to plain head+tail truncation (capToolResultPlain).\nname is the producing tool: gate-exempt tools spill without arming the\nunread-overflow close guard.
EDGES
  ^contains=matrix/neo/internal/agent.Agent
  ^defines=matrix/neo/internal/agent/overflow.go

