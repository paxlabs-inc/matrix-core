  ^defines=matrix/neo/internal/agent/overflow.go

NODE id=matrix/neo/internal/agent.assembleWindow kind=func
  digest=b3:8fdd08771d469fd0145fb50df7b6a4d06d72625bada4a000847ba0435cef06c4 file=neo/internal/agent/agent.go range=2123:2137 lang=go exported=false byte_range=94414:95460
  sig=func assembleWindow(stableSystem string, transcript []llm.Message, dynamicTail string) []llm.Message
  doc=assembleWindow builds the prompt-cache-friendly window (P1-2): a byte-stable\nsystem prefix, the append-only transcript, then ONE trailing dynamic tail\n(turn-varying memory + context-budget stat). The stable prefix is identical\nacross every turn of a session so the provider's longest-stable-prefix cache\nstays warm; only the trailing tail (and the growing transcript) change turn\nto turn. Window order: [stable system] + [transcript] + [dynamic tail].\n\nThe dynamic block keeps its system role and exact rendered content — only its\nPOSITION moves (formerly concatenated into the front system message, now a\ntrailing message after the transcript). The transcript slice is never mutated:\nthe inner append allocates a fresh backing array, so the outer append onto it\ncannot alias a.working.
EDGES
  ^defines=matrix/neo/internal/agent/agent.go

NODE id=matrix/neo/internal/agent.assembleWindowUserTail kind=func
  digest=b3:d4284180fa04716c69c79e07381803c36f9a06da9ffee896ebd28cbb857c598e file=neo/internal/agent/continuous.go range=297:304 lang=go exported=false byte_range=10926:11502
  sig=func assembleWindowUserTail(stableSystem string, transcript []llm.Message, tail string) []llm.Message
  doc=assembleWindowUserTail is the continuous-memory window assembly: the\nbyte-stable system prefix at index 0, the append-only live transcript, then\nthe rendered Activate bundle as ONE trailing USER-role message (req.9.4 — the\nQwen-template portability fix). The transcript slice is never mutated (the\ninner append allocates a fresh backing array).
EDGES
  ^defines=matrix/neo/internal/agent/continuous.go

NODE id=matrix/neo/internal/agent.auditEventIdentityLeak kind=const
  digest=b3:a5c13466444c8add319ed8dbc5f87c2d8448f1e9da40590c3a617d9eef6f4475 file=neo/internal/agent/identity.go range=11:19 lang=go exported=false byte_range=217:839
  sig=untyped string
  doc=auditEventIdentityLeak is emitted on the audit side-channel when the model\nbroke character and self-identified as its underlying LLM. It is a\nCOMPLIANCE canary, not merely a brand check: Neo is an agent (a charter\nimposed on some foundation model), and a model that will not hold the\nsimplest system rule — its own name — is signalling it may disregard the\nharder ones (money, safety, do-not-touch). Surfacing the breach keeps us from\nbeing blind to that; scrubbing (below) contains it; the guidance re-anchor\nmakes the model self-correct in-loop.
EDGES
  ^defines=matrix/neo/internal/agent/identity.go

NODE id=matrix/neo/internal/agent.auditEventMod kind=const
  digest=b3:d42d841424cb754d7055dd83c0a14f071a7909448ce32e29de602ac59d63c154 file=neo/internal/agent/cassandra.go range=37:42 lang=go exported=false byte_range=1798:2185
  sig=untyped string
  doc=auditEventMod is the single Cassandra 2.0 audit event: one silent modification\nof a prior assistant message. It rides the existing AuditObserver side-channel\n(engine.publishAudit -> broker) as a pure observability signal — it signs\nnothing, writes no cortex on the happy path, and is a no-op when no observer is\nwired (CLI / tests).
EDGES
  ^defines=matrix/neo/internal/agent/cassandra.go

