NODE id=matrix/neo/internal/agent.Agent.checkBeforeAct kind=method
  digest=b3:8f52291e0837f99fbae8b5d05b5c55548963369cca5c5713f72e6549787356d7 file=neo/internal/agent/gate.go range=117:177 lang=go exported=false byte_range=4254:7147
  sig=func (a *Agent) checkBeforeAct(calls []llm.ToolCall) ([]llm.ToolCall, bool)
  doc=checkBeforeAct is the dispatch gate (req.5.1/5.2/5.3), run against every\ntool batch before it dispatches. It first RUNS the cheap check every\nunchecked self-referential premise admits — validation against the resident\ncapability surface — discharging or refuting each (a contradiction is a\nmismatch event, rendered as structured guidance, never silently retained).\nIf any refuted premise then stands unrevised, the non-exempt calls of the\nbatch are refused with a directive naming the premise and the check, and a\ntools-stripped plan-revision step is forced before further dependent\ndispatches. Returns the calls that may dispatch and whether a refusal\nhappened.
EDGES
  ^contains=matrix/neo/internal/agent.Agent
  ^defines=matrix/neo/internal/agent/gate.go

NODE id=matrix/neo/internal/agent.Agent.cleanContent kind=method
  digest=b3:bd91712dd20fd69f797371a9ce493fa87cf31344f8d50359ec9b70d0f25e8a29 file=neo/internal/agent/identity.go range=81:87 lang=go exported=false byte_range=3981:4317
  sig=func (a *Agent) cleanContent(text string) string
  doc=cleanContent applies the identity scrub to a user-facing content surface,\ndiscarding the leaked flag (the caller only wants the safe text). Used at the\nnarration/answer surfaces where detection is handled separately.
EDGES
  ^contains=matrix/neo/internal/agent.Agent
  ^defines=matrix/neo/internal/agent/identity.go

NODE id=matrix/neo/internal/agent.Agent.closeTurn kind=method
  digest=b3:c498f980583067445265949a09dd547e50db0832ec93451051bd6800ef04d45a file=neo/internal/agent/agent.go range=1025:1054 lang=go exported=false byte_range=46897:48567
  sig=func (a *Agent) closeTurn(ctx context.Context, res *llm.ChatResult, casMod bool, userInput string) (finished bool, err error)
  doc=closeTurn is the close stage (MORPHEUS req.3.1) and the ONE evaluation site\nof the termination guard chain (req.4.1): a bare-answer turn (no tool calls)\nwalks closeGuardChain in table order and the first firing guard decides —\ndeliver | nudge-and-continue | suppress — with finishTurn remaining the\nsingle delivery choke point. Contract — inputs: the model result, whether\nCassandra modified this step, and the turn's user input; mutates: whatever\nthe one firing guard mutates (guidance nudges on the working transcript, the\nunified unproductive counter, the scrubbed answer); returns finished=true\nwhen the turn delivered (Chat returns nil), err on the unproductive-cap\nescalation, and (false, nil) when the loop must re-enter (a nudge or\nsuppression asked the model to continue).\n\nTermination (Cassandra 2.0: the proof-of-work completion gate is retired):\na turn ends when the model emits NO tool calls — the single completion path\n— once no guard in the chain blocks the close. Honesty emerges from the\nagent re-verifying under Cassandra's injected doubt, backstopped by the\nloop-discipline guarantees, not from a terminal adjudicator.
EDGES
  ^contains=matrix/neo/internal/agent.Agent
  ^defines=matrix/neo/internal/agent/agent.go

NODE id=matrix/neo/internal/agent.Agent.cmActivate kind=method
  digest=b3:edaf1e745960895732771851748bdf9023c778a101c5b268d8db770d6ce8dd47 file=neo/internal/agent/continuous.go range=182:198 lang=go exported=false byte_range=5562:6324
  sig=func (a *Agent) cmActivate(query string) *cortex.ActivationBundle
  doc=cmActivate computes this turn's activation bundle ONCE (Pinned computed once\nper turn — the NE-7 fix is realised by cortex's per-turn pinned cache plus\nthis single call site). Best-effort: on error it returns nil and the turn\ndegrades to the bare charter window (req.7.5 graceful degradation).
EDGES
  ^contains=matrix/neo/internal/agent.Agent
  ^defines=matrix/neo/internal/agent/continuous.go

NODE id=matrix/neo/internal/agent.Agent.cmAppend kind=method
  digest=b3:ef7f28721c7e80d7d21baa540ce032e7702b2808f72edce0557b1a1951a4a085 file=neo/internal/agent/continuous.go range=151:168 lang=go exported=false byte_range=4347:5027
  sig=func (a *Agent) cmAppend(m cortex.Message)
  doc=cmAppend writes one message to the cortex session store. Best-effort: a\ndurable-append failure does not crash the turn (the in-memory transcript\nremains the live source for THIS turn); durability is a background concern.\nThe allocated session seq is folded into the current turn's seq range\n(DEJA-VU req 1.1) so end-of-turn consolidation can stamp derived_from\nprovenance edges back to the exact transcript slice this turn produced.
EDGES
  ^contains=matrix/neo/internal/agent.Agent
  ^defines=matrix/neo/internal/agent/continuous.go

NODE id=matrix/neo/internal/agent.Agent.cmConvID kind=method
  digest=b3:3c4e66aa22a08401f08fcc1623c7ca6b5017e497c2a3c026cba63dfe1dd74c11 file=neo/internal/agent/continuous.go range=33:40 lang=go exported=false byte_range=1236:1482
  sig=func (a *Agent) cmConvID() string
  doc=cmConvID scopes the cortex session/transcript store: the agent's conversation\nid, or "cli" on the bare CLI path (mirrors turnIntentID's fallback).
