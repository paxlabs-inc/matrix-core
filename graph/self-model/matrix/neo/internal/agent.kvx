  digest=b3:38eea21f8a44202c562e20338b852c05c7315a69b9ca481c79de413867b86f0c file=neo/internal/agent/posture.go range=203:216 lang=go exported=false byte_range=6340:6778
  sig=func (a *Agent) promoteForIntent(objective string) error
