NODE id=matrix/neo/internal/agent.closeGuard#name kind=field
  digest=b3:620a713d8e76bba53c88aaa2fd09a7d9f64e53ec0dd207e3eca69dfbf5ee55cd file=neo/internal/agent/closechain.go range=54:54 lang=go exported=false byte_range=2203:2214
