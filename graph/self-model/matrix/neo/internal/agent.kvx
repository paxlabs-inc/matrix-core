  ^defines=matrix/neo/internal/agent/prediction.go

NODE id=matrix/neo/internal/agent.identityReanchorNudge kind=func
  digest=b3:f8541b859bfd8e7604c89ffea8104cceb989a24600df7cbb9c098bbe930187de file=neo/internal/agent/identity.go range=110:117 lang=go exported=false byte_range=5088:5672
  sig=func identityReanchorNudge(name string) string
  doc=identityReanchorNudge is the private guidance-channel steer used to re-anchor\na model that broke character. It corrects the CURRENT turn and reasserts the\ncharter's authority rather than only hiding the symptom.
EDGES
  ^defines=matrix/neo/internal/agent/identity.go

NODE id=matrix/neo/internal/agent.identityScrubs kind=var
  digest=b3:1a0c04c8aac9cf45e6e62a35fdf81e6da86cde806fc1352e6386ae1917986910 file=neo/internal/agent/identity.go range=46:70 lang=go exported=false byte_range=1978:3704
  sig=[]*regexp.Regexp
  doc=identityScrubs are the high-precision self-identification patterns. Each\ncaptures the leading cue in groups 1 and 2 (an optional article between the\ncue and the model name is consumed but dropped) so a replacement of\n"${1}${2}<name>" keeps the sentence intact while swapping only the identity\ntoken. They target FIRST-PERSON self-identification and self-role framing —\nnever a third-person mention — so legitimately discussing these models (e.g.\n"GPT is OpenAI's model", "I'm using Claude for this") is left untouched.
EDGES
  ^defines=matrix/neo/internal/agent/identity.go

NODE id=matrix/neo/internal/agent.imageAwareTokens kind=func
