NODE id=matrix/neo/internal/agent.ToolEvent#ScreenshotURL kind=field
  digest=b3:7d4f7c6f0fdfe3d02f2406dd26b9cc63b21ae64251f30121911207104ef9a63d file=neo/internal/agent/agent.go range=88:94 lang=go exported=true byte_range=4385:4866
  sig=string
  doc=ScreenshotURL is the out-of-band /media URL of a page still captured for\nthis call — either the image a browser_take_screenshot returned, or the\ndeterministic auto-capture fired after a view-changing browser action\n(BROWSER-FILMSTRIP). It NEVER enters the model transcript (that stays a\nterse placeholder); it rides only this observer event so the surface can\nrender the browsing filmstrip. Empty for non-browser / non-captured calls.
EDGES
  ^contains=matrix/neo/internal/agent.ToolEvent

NODE id=matrix/neo/internal/agent.ToolEvent#StreamDelta kind=field
  digest=b3:bc7e1e2c15df39c3bf483a41efe36a5caba84f38e6146e1674483e019102b2c3 file=neo/internal/agent/agent.go range=104:104 lang=go exported=true byte_range=5404:5423
