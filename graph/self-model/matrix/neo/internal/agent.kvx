  digest=b3:aa9a5c4cf5b285d92ce4db6a7abb63f1a5398e3292f0746e10992324ac362dbd file=neo/internal/agent/agent.go range=2091:2113 lang=go exported=false byte_range=93567:94589
  sig=func isViewChangingBrowser(name string) bool
