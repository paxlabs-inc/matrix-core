NODE id=matrix/neo/internal/agent.liveWriteScan kind=type
  digest=b3:6db537a78f9ca75be2961b201335ce22556bd6a3036566cae9a4ab496817d754 file=neo/internal/agent/livetype.go range=97:120 lang=go exported=false byte_range=2646:3710
  sig=type liveWriteScan struct {\n	id, name	string\n	ignore		bool\n\n	raw	[]byte\n	pos	int	// resume cursor into raw\n\n	state		wsState\n	depth		int	// nesting depth while skipping a non-string value\n	inStr		bool	// inside a string while skipping a nested value\n	key		strings.Builder\n	strVal		strings.Builder	// accumulates a completed small string value (the key or path)\n	capture		wsCapture	// what the current string value feeds\n	path		string\n	pending		[]byte	// decoded content bytes not yet emitted\n	emitted		int	// decoded content bytes already emitted\n	contDone	bool	// content string closed\n}
  doc=liveWriteScan is a resumable single-pass tokenizer over the growing raw\nargument JSON of one write_file call. It only understands what it needs: a\ntop-level object whose "path" and "content" members are strings (any other\nmember value — string, number, literal, nested object/array — is skipped\nwith full string/escape awareness). Decoding pauses cleanly at end-of-input\n(including mid-escape) and resumes on the next fragment.
EDGES
  contains=matrix/neo/internal/agent.liveWriteScan#capture,matrix/neo/internal/agent.liveWriteScan#contDone,matrix/neo/internal/agent.liveWriteScan#depth,matrix/neo/internal/agent.liveWriteScan#emitted,matrix/neo/internal/agent.liveWriteScan#id,matrix/neo/internal/agent.liveWriteScan#ignore,matrix/neo/internal/agent.liveWriteScan#inStr,matrix/neo/internal/agent.liveWriteScan#key,matrix/neo/internal/agent.liveWriteScan#name,matrix/neo/internal/agent.liveWriteScan#path,matrix/neo/internal/agent.liveWriteScan#pending,matrix/neo/internal/agent.liveWriteScan#pos,matrix/neo/internal/agent.liveWriteScan#raw,matrix/neo/internal/agent.liveWriteScan#state,matrix/neo/internal/agent.liveWriteScan#strVal,matrix/neo/internal/agent.liveWriteScan.decodeString,matrix/neo/internal/agent.liveWriteScan.put,matrix/neo/internal/agent.liveWriteScan.scan
