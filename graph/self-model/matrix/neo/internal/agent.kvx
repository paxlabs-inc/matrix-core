  sig=func (a *Agent) budgetTail(pct int) string
  doc=budgetTail renders the live context-budget stat that trails every turn's\nwindow, plus — for a top-level agent that can actually decompose — the\nself-aware decomposition line (self-model task 4.2). Both are turn-varying, so\nthey live in the trailing message AFTER the byte-stable charter prefix and\nnever disturb the prompt-cache invariant.
EDGES
  ^contains=matrix/neo/internal/agent.Agent
  ^defines=matrix/neo/internal/agent/decompose.go

NODE id=matrix/neo/internal/agent.Agent.buildCassandraSignals kind=method
  digest=b3:3663c9f810cc5126f5f34469b9a9f65e8fa454f706f87cf157434d33e2b0e86b file=neo/internal/agent/cassandra.go range=137:148 lang=go exported=false byte_range=6755:7737
  sig=func (a *Agent) buildCassandraSignals(step int, msg llm.Message, repeats int, recentSigs []string, prevSig string, prevCalls []llm.ToolCall, distinctToolSet map[string]struct{}, closing bool) cassandraSignals
  doc=buildCassandraSignals assembles the controller's signal bundle from an\nexplicitly-supplied loop state — a thin projection over readStepSignals, the\nONE place the repeat reads are computed (MORPHEUS req.5.1). The repeat read\n(repeats / recentSigs / prevSig / prevCalls) still reflects the PREVIOUS\ncommitted batch here — noteBatch commits the current batch later — so\ncomparing the current batch against it yields the same repeat verdict\nnoteBatch will, one step early. effectiveRepeats adds 1 when the current\nbatch is itself a repeat, so the loop trigger can fire ONE step before the\nhard NoProgressStall.
EDGES
  ^contains=matrix/neo/internal/agent.Agent
  ^defines=matrix/neo/internal/agent/cassandra.go

NODE id=matrix/neo/internal/agent.Agent.capExceeded kind=method
  digest=b3:fc278e9876db1bc0751c1aa80c920b421eee70e241c41435f34e645041bc9883 file=neo/internal/agent/agent.go range=1236:1241 lang=go exported=false byte_range=57964:58293
  sig=func (a *Agent) capExceeded(counter int) bool
  doc=capExceeded reports whether the unified unproductive-attempt counter has\npassed its bound (config MaxGuidanceNudges, the shared unproductive-attempt\ncap). A cap of 0 disables the bound (unbounded).
EDGES
  ^contains=matrix/neo/internal/agent.Agent
  ^defines=matrix/neo/internal/agent/agent.go

NODE id=matrix/neo/internal/agent.Agent.capToolResult kind=method
  digest=b3:63994cd6a583f6cd7268ba910261996381260d150a4d69b327580dd0bd4938d3 file=neo/internal/agent/overflow.go range=162:186 lang=go exported=false byte_range=4853:6098
  sig=func (a *Agent) capToolResult(content string) string
  doc=capToolResult bounds a single tool result for the working transcript. Within\nbudget it is returned verbatim. When it exceeds maxToolResultChars the FULL\noutput is persisted to a run-scoped overflow file and the transcript keeps a\nhead + tail plus a truncation notice carrying the overflow token and how to\nread the remainder (req.4.1) — never a silent cut. If the file cannot be\nwritten it degrades to plain head+tail truncation (capToolResultPlain).
EDGES
  ^contains=matrix/neo/internal/agent.Agent
  ^defines=matrix/neo/internal/agent/overflow.go

