  sig=func (a *Agent) compareExpectationModel(ctx context.Context, expect, content string) bool
  doc=compareExpectationModel is the model-assisted comparison for outcomes the\ndeterministic detector cannot decide. Fails toward "match" (no belief-update\nevent on comparator failure — never fabricate a mismatch).
EDGES
  ^contains=matrix/neo/internal/agent.Agent
  ^defines=matrix/neo/internal/agent/prediction.go

NODE id=matrix/neo/internal/agent.Agent.consolidateWorking kind=method
  digest=b3:34a56dcdc1690f88cde53a191e646b5c7547385fd7aafc81a91e545fd6b71772 file=neo/internal/agent/finish.go range=68:77 lang=go exported=false byte_range=3530:4048
  sig=func (a *Agent) consolidateWorking()
  doc=consolidateWorking sweeps the current turn's transcript into cortex (write-\nback option B). Called on EVERY terminal path — success, stall, step-budget\nexhaustion, and model error — so Neo also learns from failed/abandoned turns\n(a failure pattern is durable signal), not only from clean completions.\nBest-effort + idempotent enough: the consolidator de-dupes on write.
EDGES
  ^contains=matrix/neo/internal/agent.Agent
  ^defines=matrix/neo/internal/agent/finish.go

