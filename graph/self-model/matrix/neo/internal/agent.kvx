  ^defines=matrix/neo/internal/agent/resurrection.go

NODE id=matrix/neo/internal/agent.answerTokenCeiling kind=const
  digest=b3:6b5bb6ceb3a9bb8ebe8870acecffbe3c5503000d88b29b145b472a1f461147dd file=neo/internal/agent/agent.go range=1620:1628 lang=go exported=false byte_range=71812:72364
  sig=untyped int
  doc=Output-token escalation ladder for a truncated generation (synthesis-survives-\ndeath): a generation cut off by the output limit (finish_reason=length) is\nre-attempted with a higher per-request output-token budget so a long final\nsynthesis converges instead of re-truncating at the same limit — Claude Code's\n8K→64K posture. The floor matches the client's own default; each bump doubles\ntoward the ceiling, bounded so a pathologically long turn can't grow unbounded.
EDGES
  ^defines=matrix/neo/internal/agent/agent.go

