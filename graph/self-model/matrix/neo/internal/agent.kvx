NODE id=matrix/neo/internal/agent.injectExpectParam kind=func
  digest=b3:9d4356cacbf903561021517db335220cc1e277c85d1efdefc1a0bf6cbed61804 file=neo/internal/agent/prediction.go range=32:65 lang=go exported=false byte_range=1543:2750
  sig=func injectExpectParam(schemas []llm.Tool) []llm.Tool
  doc=injectExpectParam returns a copy of the advertised schemas with an `expect`\nstring property added to every tool's parameters (req.6.1 made universal:\nevery call carries a prediction, not just probe-class calls). Copy-on-write:\nthe Manager's own schema maps are never mutated — Schemas() hands out the\nSAME underlying parameter maps on every call, so an in-place edit here\nwould poison every later consumer (sub-agents, the capability surface).
EDGES
  ^defines=matrix/neo/internal/agent/prediction.go

