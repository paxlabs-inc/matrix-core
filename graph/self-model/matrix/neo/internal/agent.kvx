  sig=func stripDataURIs(s string) (string, int)
  doc=stripDataURIs replaces every inline base64 image data URI in s with\nimagePlaceholder and returns the rewritten string plus the count replaced.\nSingle allocation-light pass; a short data URI (blob < minImageBlob) or a\n"data:" that is not a base64 URI is left untouched. Deterministic.
EDGES
  ^defines=matrix/neo/internal/agent/payload.go

