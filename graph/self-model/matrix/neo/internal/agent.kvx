  doc=snapshotLoop refreshes the live loop-state snapshot for THIS iteration. Called\nonce per step after the no-progress read, so a subsequent death exit captures\nthe real state. distinctTools is the breadth seen through prior steps plus any\nnew tool this batch introduces.
EDGES
  ^contains=matrix/neo/internal/agent.Agent
  ^defines=matrix/neo/internal/agent/death.go

NODE id=matrix/neo/internal/agent.Agent.stableSystem kind=method
  digest=b3:c4b977cd2a08f65f23492ff6637aa5fe72956c2d06a148e5effeee56f91534a5 file=neo/internal/agent/prompt.go range=20:50 lang=go exported=false byte_range=583:2050
  sig=func (a *Agent) stableSystem() string
  doc=stableSystem returns the byte-stable system prefix: the behavioral charter\n(systemPrompt) + the embedded ground truth. It is identical across every\nturn of a session — nothing turn-varying (pinned memory, recalled turns,\nretrieved seeds, the consolidated summary, the budget stat) lives here — so\nit can ride the provider's longest-stable-prefix prompt cache. It is injected\nas the FIRST message of every window (P1-2).
EDGES
  ^contains=matrix/neo/internal/agent.Agent
  ^defines=matrix/neo/internal/agent/prompt.go

