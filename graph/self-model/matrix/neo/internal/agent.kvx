NODE id=matrix/neo/internal/agent.Agent.ambientMemory kind=method
  digest=b3:23ea916f8e00ba4395301541c1cbbeae5a99ce08ade64c1b1ef19f2a6d218b4e file=neo/internal/agent/agent.go range=1463:1480 lang=go exported=false byte_range=67301:68132
  sig=func (a *Agent) ambientMemory(ctx context.Context, q string) []memory.Snippet
  doc=ambientMemory returns the THIN ambient memory seed injected into the system\nblock this turn (v3 #1: reasoning-time retrieval). It is the bulk semantic\nretrieval demoted from a forced blob to a small seed, capped to\ncfg.AmbientRetrievalTopK. A cap of 0 means fully tool-driven retrieval: no\nambient seed at all — the model pulls exactly what it needs mid-thought with\nthe memory_recall tool. The pinned tier (identity, hard rules, learned\nguidance, active goal, user profile) is injected separately and is NEVER\ngated by this cap.
EDGES
  ^contains=matrix/neo/internal/agent.Agent
  ^defines=matrix/neo/internal/agent/agent.go

NODE id=matrix/neo/internal/agent.Agent.attestTurn kind=method
  digest=b3:525f4e85a32da9b4842378c6e32dcb30689f607d3e768a7017c308edd5d11bab file=neo/internal/agent/agent.go range=1399:1440 lang=go exported=false byte_range=65155:66793
  sig=func (a *Agent) attestTurn(ctx context.Context, surfaced map[string]struct{}, surfacedSnips map[string]memory.Snippet, turnInput, answer string)
  doc=attestTurn closes the usage-learning loop for a successful turn. It splits\nthe surfaced set into USED (reinforced) and IGNORED (penalized): a\nsurfaced-but-ignored memory is one the rejection gate flags as off-topic to\nthe produced turn AND of a non-pinned type. The two attests are disjoint so\nno memory is both bumped and decremented in the same turn. Best-effort: a\nnil pager or empty set is a no-op, and neither attest blocks the turn.
EDGES
  ^contains=matrix/neo/internal/agent.Agent
  ^defines=matrix/neo/internal/agent/agent.go

NODE id=matrix/neo/internal/agent.Agent.budgetPct kind=method
