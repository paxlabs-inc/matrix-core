NODE id=matrix/neo/internal/agent.Agent.BestEffort kind=method
  digest=b3:0a848fa33cf8c41227cd28c7b0806df40ef5f6dad984b4ae10f20173a65ed66d file=neo/internal/agent/agent.go range=1427:1440 lang=go exported=true byte_range=64770:65391
  sig=func (a *Agent) BestEffort() string
  doc=BestEffort returns the most honest "where things stand" digest the agent can\nproduce WITHOUT having finished — the latest assistant narration, else the\nlast tool summary. The task supervisor uses it to deliver a truthful partial\nwhen a task hits its hard ceiling; it is never a fabricated success. Empty\nwhen there is genuinely nothing to report.
EDGES
  ^contains=matrix/neo/internal/agent.Agent
  ^defines=matrix/neo/internal/agent/agent.go

NODE id=matrix/neo/internal/agent.Agent.Chat kind=method
  digest=b3:1640947bc2ba3ebd3303b3c850aa9ca286f01b2ba3929394939ef345f31459d3 file=neo/internal/agent/agent.go range=674:685 lang=go exported=true byte_range=30709:31394
  sig=func (a *Agent) Chat(ctx context.Context, userInput string) error
  doc=Chat runs one user turn through the staged loop (MORPHEUS req.3) until the\nmodel yields a final answer (no tool calls), the loop stalls/exhausts its\nbudget, or it is blocked needing the human. Chat itself is the skeleton: it\nconstructs the reified turn, runs the per-turn prepare, then iterates steps\n— prepare → generate → deliberate → act | close — each a named stage with a\ndocumented contract. Conversation state persists across calls.
EDGES
  ^contains=matrix/neo/internal/agent.Agent
  ^defines=matrix/neo/internal/agent/agent.go

NODE id=matrix/neo/internal/agent.Agent.ChatAudio kind=method
  digest=b3:56d0947df2f06eb2b2e5730b2da0b4e3219073d7aa46688edf4ecd21227cb489 file=neo/internal/agent/agent.go range=687:696 lang=go exported=true byte_range=31396:31961
  sig=func (a *Agent) ChatAudio(ctx context.Context, userInput string, audio *AudioTurn) error
  doc=ChatAudio runs the same staged turn with one audio-native user message. The\nASR result is produced concurrently with the first model generation; before\nany downstream deliberation/close, the visible user content is replaced by\nthe durable transcript plus sealed media ref and recorded to Neocortex.
EDGES
  ^contains=matrix/neo/internal/agent.Agent
  ^defines=matrix/neo/internal/agent/agent.go

