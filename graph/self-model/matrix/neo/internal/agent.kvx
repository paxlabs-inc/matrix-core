  sig=type closeVerdict string
  doc=closeVerdict is the explicit verdict a close guard returns (req.4.1).
EDGES
  ^defines=matrix/neo/internal/agent/closechain.go

NODE id=matrix/neo/internal/agent.collectSurfaced kind=func
  digest=b3:4032b3c533a029a275c4e534373fa8e42f2d6d178f28a492ab9c7aedb4a12817 file=neo/internal/agent/agent.go range=1355:1371 lang=go exported=false byte_range=62581:63194
  sig=func collectSurfaced(set map[string]struct{}, retrieved []memory.Snippet, procedural []memory.Pattern)
  doc=collectSurfaced records the cortex URIs injected into this turn so the loop\ncan attest them as USED on a successful completion — the cortex usage-salience\n+ EMA learning signal. Accumulates across the opening fault and every\nmid-turn refault (a set, so re-surfacing across refaults isn't double-counted\nwithin the turn).
EDGES
  ^defines=matrix/neo/internal/agent/agent.go

NODE id=matrix/neo/internal/agent.collectSurfacedSnips kind=func
  digest=b3:21d2f78be9937450c2a41ff4710e3ed868951d3068ae89ba66ebee20d9c66e4d file=neo/internal/agent/agent.go range=1373:1383 lang=go exported=false byte_range=63196:63668
  sig=func collectSurfacedSnips(set map[string]memory.Snippet, retrieved []memory.Snippet)
  doc=collectSurfacedSnips records the retrieved snippets (URI -> text/type) so the\ncompletion's rejection gate can score them for off-topic relevance. Keyed by\nURI so re-surfacing across refaults dedups within the turn. Patterns are\nintentionally excluded: they are coverage-gated and never penalized.
EDGES
  ^defines=matrix/neo/internal/agent/agent.go

