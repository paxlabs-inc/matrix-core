NODE id=matrix/neo/internal/agent.Agent.contentChurn kind=method
  digest=b3:eb803510391b485a2e373381dbbc98cf5f931028f127a0c870ff6891813f7077 file=neo/internal/agent/semantic.go range=98:118 lang=go exported=false byte_range=4166:5088
  sig=func (a *Agent) contentChurn(prev, cur string) bool
  doc=contentChurn reports whether two consecutive non-dispatching (bare-answer)\nturns repeat substantially the same prose — the reasoning-churn read the\ntool-batch repeat detectors miss (they compare only tool calls). It reuses the\nsignificant-word extraction and overlap coefficient of the semantic-repeat\npath. Gated on the same semantic-detection switch so disabling one disables\nboth; both texts must carry real content (short answers are too collision-prone\nto judge by word overlap).
EDGES
  ^contains=matrix/neo/internal/agent.Agent
  ^defines=matrix/neo/internal/agent/semantic.go

NODE id=matrix/neo/internal/agent.Agent.currentObjective kind=method
  digest=b3:bf3d703080d765e4bb550150df0676f4b77630a533ae832ac456a4565f8dae09 file=neo/internal/agent/intent.go range=29:34 lang=go exported=false byte_range=451:638
