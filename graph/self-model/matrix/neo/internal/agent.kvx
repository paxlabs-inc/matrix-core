NODE id=matrix/neo/internal/agent.Agent.cassandraClassify kind=method
  digest=b3:737d2adffcb98ef22571b32c13396934c01260442f7508fb48079b82c0411418 file=neo/internal/agent/cassandra.go range=230:294 lang=go exported=false byte_range=11318:13753
  sig=func (a *Agent) cassandraClassify(sig cassandraSignals) (modTrigger, modSide)
  doc=cassandraClassify maps the drift to (trigger, side), selecting the side that\npushes the run toward the productive middle (two-sided damping, never one-sided\ndoubt-spam). A strong loop is always doubt (step back, try a different\napproach); milder repetition splits by tool KIND — repeated reads/checks are\nover-verification (assurance: commit and move on), repeated mutations that\ncycle are oscillation (assurance: stop flip-flopping), and anything else is\ndoubt. On a closing turn the relevant drift is about finishing prematurely.\nReturns ("", "") when the run is healthy.
EDGES
  ^contains=matrix/neo/internal/agent.Agent
  ^defines=matrix/neo/internal/agent/cassandra.go

NODE id=matrix/neo/internal/agent.Agent.cassandraEdit kind=method
  digest=b3:c6e13051b418d4dd34f8cc5d7db99e034920a4c18570f2e884c57a4677f3bf0a file=neo/internal/agent/cassandra.go range=185:228 lang=go exported=false byte_range=9122:11316
  sig=func (a *Agent) cassandraEdit(target int, mod string, trig modTrigger, side modSide, step int) bool
  doc=cassandraEdit folds a first-person metacognitive line into the Content of the\nassistant-role message at index target, IN PLACE. Guardrail 1 (content-only) is\nenforced structurally: it asserts RoleAssistant and mutates ONLY .Content —\nnever ToolCalls / Role / Name, and never a tool / user / system message. The\nfold is additive (the original text is preserved and the mod is layered AFTER\nit as the agent's next thought), so guardrail 2 (metacognition-only, never a\nrewrite of facts) holds by construction. The dual-record + audit event\n(guardrail 3) are written BEFORE the mutation, and the durable Neocortex\ntranscript is NOT rewritten — a tool-calling turn's original was already\nrecorded at deliberate, and a bare answer's original is recorded from the\nuntouched res.Message only if it delivers (closeTurn) — so Neocortex stays\nground truth (req.7.1). Returns false (no-op) if the target is out of range\nor is not an assistant message.
EDGES
  ^contains=matrix/neo/internal/agent.Agent
  ^defines=matrix/neo/internal/agent/cassandra.go

NODE id=matrix/neo/internal/agent.Agent.cassandraStep kind=method
  digest=b3:d2f68dd9c19c0b4f895c3260b62519c09961f1735e5cd220d9568df493234cb2 file=neo/internal/agent/cassandra.go range=150:183 lang=go exported=false byte_range=7742:9120
  sig=func (a *Agent) cassandraStep(sig cassandraSignals) bool
  doc=cassandraStep is the per-step controller entry point. It is a no-op before\nmin_step, when the per-turn mod budget is spent, when the per-trigger cooldown\nis active, or when no drift trigger fires (the healthy case → the window is\nbyte-identical to the controller disabled). On a fire it edits the just-\nappended assistant message's Content in place, records the dual-record, and\nemits the cassandra.mod audit event. Returns whether it modified the window.
EDGES
  ^contains=matrix/neo/internal/agent.Agent
  ^defines=matrix/neo/internal/agent/cassandra.go

