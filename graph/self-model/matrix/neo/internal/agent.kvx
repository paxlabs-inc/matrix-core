NODE id=matrix/neo/internal/agent.Agent.pushGuidance kind=method
  digest=b3:27d90dcc25bc053d620da1cd27414745d90fa24c39a780e35e6c00c94b4990e9 file=neo/internal/agent/agent.go range=1357:1376 lang=go exported=false byte_range=61753:62819
  sig=func (a *Agent) pushGuidance(text string) llm.Message
  doc=pushGuidance is THE guidance choke point (MORPHEUS req.3.3): every\nguidance-channel injection — the close-chain nudges, the legacy converge\nsteer, the self-claim contradiction and forced-revision directives, and the\nprediction-mismatch guidance — flows through this one function. It builds\nthe turn via llm.GuidanceMessage (the Guidance flag + envelope are what keep\nsteering out of the durable Neocortex transcript — cmRecordAssistant's\nIsGuidance gate — and off every user-facing surface — StripGuidance at the\nharness) and appends it to the working transcript. Contract — mutates: the\nworking transcript only; blank text appends nothing. Returns the built\nmessage (zero when nothing was appended) so a caller that must also thread\nthe steer into an in-flight window copy (forcedRevisionStep) reuses the SAME\nturn instead of minting a second one.
EDGES
  ^contains=matrix/neo/internal/agent.Agent
  ^defines=matrix/neo/internal/agent/agent.go

NODE id=matrix/neo/internal/agent.Agent.pushGuidanceNudge kind=method
  digest=b3:dc6cef66351771414faee9a8fb9efb3bb8464be292b83a9893283deac5e116c3 file=neo/internal/agent/agent.go range=1378:1385 lang=go exported=false byte_range=62821:63197
  sig=func (a *Agent) pushGuidanceNudge(text string, counter *int) (capExceeded bool)
  doc=pushGuidanceNudge routes a system-steering nudge through the guidance choke\npoint and increments the caller's dedicated retry counter. No counter is\nshared between synthesis, evidence, identity, or tool-repeat policy.
EDGES
  ^contains=matrix/neo/internal/agent.Agent
  ^defines=matrix/neo/internal/agent/agent.go

NODE id=matrix/neo/internal/agent.Agent.readOverflow kind=method
  digest=b3:ceeefbecf6cc7e296f0fa83bdf84671c2d310c40cd7d3aa4b77be9b4f866e787 file=neo/internal/agent/overflow.go range=237:267 lang=go exported=false byte_range=8297:9653
  sig=func (a *Agent) readOverflow(args map[string]interface{}) (string, bool)
  doc=readOverflow handles a model read_overflow call: it returns a bounded window\nof a stored overflow payload and marks it read. Parse/usage errors come back\nin-band (isError=true) so the model corrects rather than the harness retrying.
EDGES
  ^contains=matrix/neo/internal/agent.Agent
  ^defines=matrix/neo/internal/agent/overflow.go

