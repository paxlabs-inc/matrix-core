  digest=b3:3c8eaaa55443d5f189d63cdbd98c85756313a4902b78d39e79229d41f730eca7 file=neo/internal/agent/agent.go range=115:115 lang=go exported=true byte_range=5736:5763
  sig=agent.ToolPhase
