  digest=b3:c65a93f5b7cce534560963ca34c6be3ce70eaa30f1f2ad9075814d52dc07f875 file=neo/internal/agent/closechain.go range=50:56 lang=go exported=false byte_range=1969:2277
  sig=type closeGuard struct {\n	name	string\n	eval	func(a *Agent, cc *closeContext) (closeDecision, bool)\n}
  doc=closeGuard is one named unit of the chain: eval reports whether the guard\nfires for this close and, when it does, the decision. A guard that does not\nfire must leave the agent and context untouched.
