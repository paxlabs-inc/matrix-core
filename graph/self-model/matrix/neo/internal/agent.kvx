NODE id=matrix/neo/internal/agent.ToolEvent#StreamOffset kind=field
  digest=b3:cd36f395ce3f4daef47153971e770241f55ebd6f7dd83986912177812694ed56 file=neo/internal/agent/agent.go range=105:105 lang=go exported=true byte_range=5425:5441
