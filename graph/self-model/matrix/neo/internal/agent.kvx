NODE id=matrix/neo/internal/agent.AutomatrixIdle kind=const
  digest=b3:f4a5ceeb2061be3e6eef46b853323d2164d91ab09475bc883927f2400e6b0710 file=neo/internal/agent/automatrix.go range=21:25 lang=go exported=true byte_range=905:1222
  sig=untyped string
  doc=AutomatrixIdle is the sentinel the agent emits when an Automatrix wake found\nnothing worth doing right now. When the agent's final answer is exactly this\ntoken, the turn is suppressed — a.out.Say is never called, so AUTOMATRIX_IDLE\nis never surfaced to the user.
EDGES
  ^defines=matrix/neo/internal/agent/automatrix.go

NODE id=matrix/neo/internal/agent.AutomatrixWakeMarker kind=const
  digest=b3:4a3fc3124baae9d0d33d5065c25460763f418498c9eea442e993ed29f6570c00 file=neo/internal/agent/automatrix.go range=27:31 lang=go exported=true byte_range=1224:1540
  sig=untyped string
  doc=AutomatrixWakeMarker is the token a Chronos AUTOMATRIX alarm's wake_message\ncarries so Neo can detect it as an Automatrix (proactive surprise-task) turn\nrather than a normal user message. Distinct from AutomatrixIdle so a wake\nnever accidentally self-suppresses.
EDGES
  ^defines=matrix/neo/internal/agent/automatrix.go

NODE id=matrix/neo/internal/agent.AutomatrixWakeMessage kind=const
  digest=b3:2b6d820fc769e0396f3ff9f98b8697bdfce506f89ae9749dc04445b240c036e7 file=neo/internal/agent/automatrix.go range=33:41 lang=go exported=true byte_range=1542:2325
  sig=untyped string
  doc=AutomatrixWakeMessage is the canonical wake_message a Chronos AUTOMATRIX alarm\ndelivers. It instructs the agent to review its pending non-financial\nopportunities, complete one if worthwhile and notify the user, or reply with\nexactly AUTOMATRIX_IDLE when nothing is worth doing right now.\n\nThis MUST stay byte-identical to the Chronos-side WakeMessage\n(chronos/internal/automatrix) — they share the AUTOMATRIX marker that the\nagent uses to detect an Automatrix wake.
EDGES
  ^defines=matrix/neo/internal/agent/automatrix.go

NODE id=matrix/neo/internal/agent.CapabilitySurface kind=type
  digest=b3:610367e1fb4e7f4ca4bf1a940b130ba3a6ae9a39ec34e00a2545100a3a7cf219 file=neo/internal/agent/capability.go range=20:34 lang=go exported=true byte_range=908:1650
  sig=type CapabilitySurface struct {\n	API		[]string\n	Is		[]string\n	IsNot		[]string\n	FailurePatterns	[]string\n	// StructuralSummary is the compressed codegraph-derived summary (kept for\n	// depth beneath the surface facts; renders after them).\n	StructuralSummary	string\n}
  doc=CapabilitySurface is the resolved capability-surface material the agent\nrenders resident. API/Is/IsNot come from the durable self-model's derived\nsurface facet (written by the serving layer from its live route table);\nFailurePatterns from the self-authored how-I-fail beliefs. The tool\ninventory is derived at render time from the agent's own advertised\nschemas, so it can never disagree with what the agent can actually call.
EDGES
