  ^defines=matrix/neo/internal/agent/decompose.go

NODE id=matrix/neo/internal/agent.Agent.buildCassandraSignals kind=method
  digest=b3:df3eeb48ca2b327a62326972c2e1eb1932275ff385983fb53eed6ea59319cd3f file=neo/internal/agent/cassandra.go range=135:169 lang=go exported=false byte_range=6661:8227
  sig=func (a *Agent) buildCassandraSignals(step int, msg llm.Message, repeats int, recentSigs []string, prevSig string, prevCalls []llm.ToolCall, distinctToolSet map[string]struct{}, closing bool) cassandraSignals
  doc=buildCassandraSignals assembles the signal bundle from the loop's live state.\nThe repeat read (repeats / recentSigs / prevSig / prevCalls) still reflects the\nPREVIOUS committed batch here — noteBatch commits the current batch later — so\ncomparing the current batch against it yields the same repeat verdict noteBatch\nwill, one step early. effectiveRepeats adds 1 when the current batch is itself a\nrepeat, so the loop trigger can fire ONE step before the hard NoProgressStall.
EDGES
  ^contains=matrix/neo/internal/agent.Agent
  ^defines=matrix/neo/internal/agent/cassandra.go

NODE id=matrix/neo/internal/agent.Agent.buildSystem kind=method
  digest=b3:d819d932b40d3eb31ebb267983d6bd810ae7530da0aea0ccb38b795902290cc1 file=neo/internal/agent/prompt.go range=23:33 lang=go exported=false byte_range=644:1512
  sig=func (a *Agent) buildSystem(pinned string, retrieved []memory.Snippet, procedural []memory.Pattern, triggered []memory.Snippet, recalled []recall.Hit) string
  doc=buildSystem composes the full combined system string used for budget/byte\naccounting and legacy callers: the byte-stable behavioral charter + ground\ntruth (stableSystem) followed by the turn-varying memory block (dynamicTail).\nIt is exactly the concatenation of the two halves now assembled separately\nfor the prompt cache (P1-2): buildSystem() == stableSystem() + dynamicTail().\nThe actual model-facing window no longer sends this as one front system\nmessage — see assembleWindow — but the combined size still drives the\nbudget/byte compaction thresholds, which is why it is retained.
EDGES
  ^contains=matrix/neo/internal/agent.Agent
  ^defines=matrix/neo/internal/agent/prompt.go

NODE id=matrix/neo/internal/agent.Agent.capExceeded kind=method
  digest=b3:fc278e9876db1bc0751c1aa80c920b421eee70e241c41435f34e645041bc9883 file=neo/internal/agent/agent.go range=1219:1224 lang=go exported=false byte_range=58008:58337
  sig=func (a *Agent) capExceeded(counter int) bool
  doc=capExceeded reports whether the unified unproductive-attempt counter has\npassed its bound (config MaxGuidanceNudges, the shared unproductive-attempt\ncap). A cap of 0 disables the bound (unbounded).
EDGES
  ^contains=matrix/neo/internal/agent.Agent
  ^defines=matrix/neo/internal/agent/agent.go

NODE id=matrix/neo/internal/agent.Agent.capToolResult kind=method
  digest=b3:d836425541d4394f3189235ddffa9ae93b894baa08fa420730679fedb91b7d7b file=neo/internal/agent/overflow.go range=162:186 lang=go exported=false byte_range=4853:6083
  sig=func (a *Agent) capToolResult(content string) string
  doc=capToolResult bounds a single tool result for the working transcript. Within\nbudget it is returned verbatim. When it exceeds maxToolResultChars the FULL\noutput is persisted to a run-scoped overflow file and the transcript keeps a\nhead + tail plus a truncation notice carrying the overflow token and how to\nread the remainder (req.4.1) — never a silent cut. If the file cannot be\nwritten it degrades to plain head+tail truncation (capToolResultPlain).
EDGES
  ^contains=matrix/neo/internal/agent.Agent
  ^defines=matrix/neo/internal/agent/overflow.go

