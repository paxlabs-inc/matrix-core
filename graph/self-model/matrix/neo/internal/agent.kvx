NODE id=matrix/neo/internal/agent.Agent.AdvertisedTools kind=method
  digest=b3:458aa9e79a3f410225fe26d1579354c9382e446c9c946d4da8d47413af9d10e8 file=neo/internal/agent/automatrix_surface.go range=23:31 lang=go exported=true byte_range=898:1308
  sig=func (a *Agent) AdvertisedTools() []llm.Tool
  doc=AdvertisedTools returns a copy of the exact tool schema set this agent\nadvertises to the model (the slice passed as ChatRequest.Tools). It exists so\nthe Automatrix structural guarantee can be asserted against the REAL surface\nthe model would see, not a reconstruction of it.
EDGES
  ^contains=matrix/neo/internal/agent.Agent
  ^defines=matrix/neo/internal/agent/automatrix_surface.go

NODE id=matrix/neo/internal/agent.Agent.BestEffort kind=method
  digest=b3:962f80fdc34a6828eb30108f4178685fb7a401b1a0603ca7ab3756a6a3f0339d file=neo/internal/agent/agent.go range=1271:1281 lang=go exported=true byte_range=59462:60000
  sig=func (a *Agent) BestEffort() string
  doc=BestEffort returns the most honest "where things stand" digest the agent can\nproduce WITHOUT having finished — the latest assistant narration, else the\nlast tool summary. The task supervisor uses it to deliver a truthful partial\nwhen a task hits its hard ceiling; it is never a fabricated success. Empty\nwhen there is genuinely nothing to report.
EDGES
  ^contains=matrix/neo/internal/agent.Agent
  ^defines=matrix/neo/internal/agent/agent.go

NODE id=matrix/neo/internal/agent.Agent.Chat kind=method
  digest=b3:e51a11eb33bbed3cbe6ef9be85e4d262f13cade25edbef9737a2faf9e5308a5e file=neo/internal/agent/agent.go range=603:611 lang=go exported=true byte_range=28288:28861
  sig=func (a *Agent) Chat(ctx context.Context, userInput string) error
  doc=Chat runs one user turn through the staged loop (MORPHEUS req.3) until the\nmodel yields a final answer (no tool calls), the loop stalls/exhausts its\nbudget, or it is blocked needing the human. Chat itself is the skeleton: it\nconstructs the reified turn, runs the per-turn prepare, then iterates steps\n— prepare → generate → deliberate → act | close — each a named stage with a\ndocumented contract. Conversation state persists across calls.
EDGES
  ^contains=matrix/neo/internal/agent.Agent
  ^defines=matrix/neo/internal/agent/agent.go

NODE id=matrix/neo/internal/agent.Agent.ChatAudio kind=method
  digest=b3:e3a39a96b3f144c2e3265b52e127df0ad039ce5a2f56a681c6a5f67f1706f746 file=neo/internal/agent/agent.go range=613:619 lang=go exported=true byte_range=28863:29301
  sig=func (a *Agent) ChatAudio(ctx context.Context, userInput string, audio *AudioTurn) error
  doc=ChatAudio runs the same staged turn with one audio-native user message. The\nASR result is produced concurrently with the first model generation; before\nany downstream deliberation/close, the visible user content is replaced by\nthe durable transcript plus sealed media ref and recorded to cortex.
EDGES
  ^contains=matrix/neo/internal/agent.Agent
  ^defines=matrix/neo/internal/agent/agent.go

