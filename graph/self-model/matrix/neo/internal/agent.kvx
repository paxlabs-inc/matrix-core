  digest=b3:ae4a0e4754a916b97d0d859d8e7c38eaf9b23044484d1057da5c241b0f5a5da1 file=neo/internal/agent/continuous.go range=240:250 lang=go exported=true byte_range=8018:8600
  sig=type MemoryEvent struct {\n	StorySoFar	string		// durable rolling summary of this conversation\n	Timeline	[]string	// coarse timeline short-forms, oldest first\n	TriggerClass	string\n	SelectionReason	string\n	Excerpts	[]EpisodicMemoryEvent\n}
