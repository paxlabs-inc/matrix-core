  ^defines=matrix/neo/internal/agent/agent.go

NODE id=matrix/neo/internal/agent.Agent.LastDeath kind=method
  digest=b3:b49b31d99dea8cb1e31ed6bc3b8da5a928a115b2a9bd014d87f18679db837cb5 file=neo/internal/agent/death.go range=116:126 lang=go exported=true byte_range=4874:5380
  sig=func (a *Agent) LastDeath() (LoopDeath, bool)
  doc=LastDeath returns the structured loop-state capture from the most recent\nloop-affecting death in the current turn (self-model task 2.2). ok is false\nwhen the turn did not die in a loop-affecting way (a clean finish, a plain\nmodel/transport error). The supervisor reads it to enrich the durable\ndeath-journal entry with the real loop state at death.
EDGES
  ^contains=matrix/neo/internal/agent.Agent
  ^defines=matrix/neo/internal/agent/death.go

NODE id=matrix/neo/internal/agent.Agent.LastFailureClass kind=method
  digest=b3:8c5700765be9976e889076130ef6de73f4c0d5f959610eab5c44889a964b7180 file=neo/internal/agent/agent.go range=1789:1794 lang=go exported=true byte_range=80955:81406
  sig=func (a *Agent) LastFailureClass() delegate.FailureClass
  doc=LastFailureClass reports the shared FailureClass of the most recent\nclassified tool failure in the current turn (delegate.ClassNone when none).\nThe task supervisor reads it after Chat returns to decide whether a\nnon-clean exit is a deterministic blocker (stop-and-ask, no respawn) or a\ntransient/model/stall failure (the existing respawn path).
EDGES
  ^contains=matrix/neo/internal/agent.Agent
  ^defines=matrix/neo/internal/agent/agent.go

