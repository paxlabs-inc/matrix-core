NODE id=matrix/neo/internal/agent.Agent.Seed kind=method
  digest=b3:98e728869e69088390bacc3e02f57989e7dd00c110d1b9b67d8c61005bce5b4a file=neo/internal/agent/agent.go range=1271:1284 lang=go exported=true byte_range=60206:60792
  sig=func (a *Agent) Seed(history []llm.Message, goal string)
  doc=Seed primes a freshly-minted agent with a resumed conversation's durable\nhistory (user/assistant text turns, oldest-first) and goal, so reopening a\npast thread — or continuing one after a restart — retains context instead of\nstarting blank. No-op once the live transcript has any content, so it never\nclobbers an in-flight conversation.
EDGES
  ^contains=matrix/neo/internal/agent.Agent
  ^defines=matrix/neo/internal/agent/agent.go

NODE id=matrix/neo/internal/agent.Agent.SetGeneration kind=method
  digest=b3:f158d96032c6e666c4831d275e10249c70c8be9a5e083a9f2d090544457ecf79 file=neo/internal/agent/agent.go range=444:447 lang=go exported=true byte_range=20915:21206
  sig=func (a *Agent) SetGeneration(gen uint64)
