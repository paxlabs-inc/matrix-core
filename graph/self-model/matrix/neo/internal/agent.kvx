  digest=b3:2056e32cd71ae7a4641a1b2584f74d82eb8c91a3347762ebb909034780137962 file=neo/internal/agent/continuous.go range=120:133 lang=go exported=false byte_range=3974:4699
  sig=func (a *Agent) cmActivate(query string) *cortex.ActivationBundle
  doc=cmActivate computes this turn's activation bundle ONCE (Pinned computed once\nper turn — the NE-7 fix is realised by cortex's per-turn pinned cache plus\nthis single call site). Best-effort: on error it returns nil and the turn\ndegrades to the bare charter window (req.7.5 graceful degradation).
EDGES
  ^contains=matrix/neo/internal/agent.Agent
  ^defines=matrix/neo/internal/agent/continuous.go

