NODE id=matrix/neo/internal/agent.Agent.forcedRevisionStep kind=method
  digest=b3:2416d2d6ae67f37745f6654f079c0d530daefe4e63415bcf7358ca6028a773c3 file=neo/internal/agent/gate.go range=179:213 lang=go exported=false byte_range=7149:8714
  sig=func (a *Agent) forcedRevisionStep(ctx context.Context, window []llm.Message, onDelta func(llm.Delta)) error
  doc=forcedRevisionStep runs the tools-stripped reasoning-only step (req.5.2 /\n6.3 / 7.2): the model must revise the plan in text before any further\ndispatch. The revision output becomes the new plan — the ledger re-extracts\nfrom it (plan change), refuted premises are marked revised, and the\nconvergence meter resets to give the revised strategy a fresh read. Returns\nan error only on transport failure.
EDGES
  ^contains=matrix/neo/internal/agent.Agent
  ^defines=matrix/neo/internal/agent/gate.go

NODE id=matrix/neo/internal/agent.Agent.generate kind=method
  digest=b3:352933b2a67db6bc83e89510f1ed675995e3d3cf92e1f07a8b078d329a18f43b file=neo/internal/agent/agent.go range=878:974 lang=go exported=false byte_range=39338:44202
  sig=func (a *Agent) generate(ctx context.Context, step int, cmTail string, window []llm.Message, tail string) (res *llm.ChatResult, streamedReasoning, proceed bool, err error)
  doc=generate is the generate stage (MORPHEUS req.3.1): one model call with live\nstreaming, the forced-revision variant, and the 413 oversize recovery.\nContract — inputs: the step index, the turn-frozen activation tail, and this\nstep's prepared window+tail; mutates: the working transcript only on a\nforced revision (via forcedRevisionStep) or a cut-off tool-call batch (the\ncompact-retry nudge), plus trim/strip during 413 recovery; returns: the\nmodel result, whether reasoning streamed live, and proceed=false when the\nloop must re-enter its next iteration without a result (forced revision ran,\nor the cut-off batch was dropped). err is a terminal model failure.
EDGES
  ^contains=matrix/neo/internal/agent.Agent
  ^defines=matrix/neo/internal/agent/agent.go

NODE id=matrix/neo/internal/agent.Agent.goalWantsAction kind=method
  digest=b3:67cf04e5ea5aacd41c9f2f581a687d07166fdbc00aa2e9810455bda01e08cc88 file=neo/internal/agent/cassandra.go range=417:429 lang=go exported=false byte_range=19062:19685
  sig=func (a *Agent) goalWantsAction() bool
  doc=goalWantsAction reports whether the active goal reads like a task that requires\ntool work (deploy/send/build/search/…), used to gate unverified_close so it\nnever fires on a pure-conversation turn (a greeting or an explanation is a valid\nbare answer with no tool evidence).
EDGES
  ^contains=matrix/neo/internal/agent.Agent
  ^defines=matrix/neo/internal/agent/cassandra.go

NODE id=matrix/neo/internal/agent.Agent.governDeath kind=method
  digest=b3:bce1911b37e11ac9bb661ce5f9f884ef0fba303090f5a5a107826da10694ca56 file=neo/internal/agent/governor.go range=67:92 lang=go exported=false byte_range=3263:4651
  sig=func (a *Agent) governDeath(reason, message string) error
  doc=governDeath is the governor's ONE terminal verdict (req.5.4): every\nloop-affecting death — the hard stall, the step budget, the unproductive cap\n— funnels through here. One place decides and records why a turn ended:\nconsolidate the transcript exactly once, record the structured death (the\nsupervisor's LastDeath read and the next-turn failure-context injection ride\nit), and return the honest ErrIncomplete. message carries the reason prose\n(ending with a colon); the where-it-stands digest is appended.
EDGES
  ^contains=matrix/neo/internal/agent.Agent
  ^defines=matrix/neo/internal/agent/governor.go

NODE id=matrix/neo/internal/agent.Agent.governEpistemic kind=method
  digest=b3:28431b972f61084fee813f9781db178549e11ea1ef8d5f3752264dc74acb5242 file=neo/internal/agent/governor.go range=38:44 lang=go exported=false byte_range=1825:2255
  sig=func (a *Agent) governEpistemic() (directive string, due bool)
  doc=governEpistemic is fire position 1: reports the pending forced-revision\ndirective (armed by the epistemic bounds) that must run as a tools-stripped\nreasoning-only step BEFORE any further dispatch. Contract — mutates nothing;\ngenerate consumes it at entry and forcedRevisionStep clears it.
EDGES
  ^contains=matrix/neo/internal/agent.Agent
  ^defines=matrix/neo/internal/agent/governor.go

NODE id=matrix/neo/internal/agent.Agent.governFailsafes kind=method
  digest=b3:df41f8d45a0320c873f2a68196379c237ff8b686206b858e247639fa948bf47c file=neo/internal/agent/governor.go range=58:65 lang=go exported=false byte_range=2767:3261
  sig=func (a *Agent) governFailsafes(calls []llm.ToolCall) (repeat, stalled bool)
  doc=governFailsafes is fire position 3: the outer no-progress failsafe — commits\nthe stall bookkeeping from the unified state (noteBatch) and returns the\nrepeat/stall verdict. The step budget and the unproductive cap, the other\ntwo outer failsafes, are enforced at their own sites (Chat's loop bound and\nescalateGuidance) and terminate through the same governDeath verdict.
EDGES
  ^contains=matrix/neo/internal/agent.Agent
  ^defines=matrix/neo/internal/agent/governor.go

NODE id=matrix/neo/internal/agent.Agent.governVoice kind=method
  digest=b3:9bb9f769ebebab36d02473c348f50b925e0762b36638c42f2610d84a2f340106 file=neo/internal/agent/governor.go range=46:56 lang=go exported=false byte_range=2257:2765
