  digest=b3:f6e4d124661da7b9110ee44131dde4eaeea32028165f6ba96027020609db5960 file=neo/internal/trace/trace.go range=333:356 lang=go exported=false byte_range=11471:12223
  sig=func (s *Store) appendEvent(runID string, seq uint64, path string, ev Event) error
  doc=appendEvent appends one event as a single (sealed, when encrypting) JSONL\nline. O_APPEND + a single Write makes the line atomically visible (POSIX); a\ntorn write yields an unparseable final line that readEvents skips\n(crash-atomic). seq binds the event to its position in the run.
