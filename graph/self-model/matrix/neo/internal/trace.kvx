  digest=b3:7005bd36432635afd8e264d7855d7e1ec150d8a4ab84dc06a05fe5de37be61c3 file=neo/internal/trace/trace.go range=358:393 lang=go exported=false byte_range=12225:13213
  sig=func (s *Store) readEvents(runID, path string) []Event
  doc=readEvents parses a newline-delimited event file, decrypting each record under\nthe reconstructed associated data (legacy plaintext lines pass through until\nmigrated). A line that fails to decrypt or unmarshal — including a wrong-key,\ntampered, or crash-truncated final line — is skipped; the record sequence\nstill advances so surviving events stay bound to their positions.
