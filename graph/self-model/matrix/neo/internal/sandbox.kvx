NODE id=matrix/neo/internal/sandbox.client.do kind=method
  digest=b3:85bcd925074018711fe5e94fc1838180dfcaea86f8a1020f645dcafdb950c69c file=neo/internal/sandbox/sandbox.go range=291:347 lang=go exported=false byte_range=10537:12831
  sig=func (c *client) do(ctx context.Context, query string, variables map[string]any, out any) error
  doc=do executes a GraphQL request against the Railway endpoint, decoding\nresponse.data into out (nil to discard). It mirrors the router railway\nclient: HTTP 401/403 and "not authorized"/"not found" GraphQL errors map to\nsentinels; Railway returns most application errors as 200s with an errors\narray. The response body is limited to 1 MiB.
EDGES
  ^contains=matrix/neo/internal/sandbox.client
  ^defines=matrix/neo/internal/sandbox/sandbox.go

NODE id=matrix/neo/internal/sandbox.defaultTimeout kind=const
  digest=b3:4c375816e2952f178018b5778357ca734fc0734e75588df9f6df0dafe156cf76 file=neo/internal/sandbox/sandbox.go range=51:55 lang=go exported=false byte_range=2364:2661
  sig=time.Duration
  doc=defaultTimeout bounds a single GraphQL round-trip when Config.Timeout is 0.\nLarger than the router's provisioner (30s) because sandbox create + exec can\nlegitimately run for a while; long operations should still pass their own\ncontext deadline.
EDGES
  ^defines=matrix/neo/internal/sandbox/sandbox.go

