  ^contains=matrix/neo/internal/config.Config

NODE id=matrix/neo/internal/config.Config.ActivationBudget kind=method
  digest=b3:703f03a8e55c2e037d5cfc45bb3a806414ad906dcaf94be933bda11458ac6570 file=neo/internal/config/config.go range=816:833 lang=go exported=true byte_range=40956:41623
  sig=func (c Config) ActivationBudget() int
  doc=ActivationBudget returns the per-turn cortex activation-bundle token budget.\nAn explicit ActivationBudgetTokens wins verbatim; otherwise it derives\nwindow-proportionally (2% of the context window) clamped to\n[activationBudgetFloorTokens, activationBudgetCapTokens] — 1M → 20000,\n256K → 5120, and any window ≤ 150K keeps the historical 3000.
EDGES
  ^contains=matrix/neo/internal/config.Config
  ^defines=matrix/neo/internal/config/config.go

