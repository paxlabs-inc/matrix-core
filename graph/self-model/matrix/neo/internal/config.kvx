NODE id=matrix/neo/internal/config.Config#HeartbeatInterval kind=field
  digest=b3:029895108f6d412f7cdac6fc5e8f6d2360d27126df109d27c0e9287ca19bee3a file=neo/internal/config/config.go range=217:225 lang=go exported=true byte_range=12708:13307
  sig=int
  doc=--- heartbeat (P1-4: Chronos-driven proactive turn convention) ---\nHeartbeatInterval is the recurring-alarm interval (minutes) for Neo's\nproactive self-review of active goals/constraints. 0 = disabled (the\ndefault: no wakeups occur). When >0, a Chronos recurring alarm fires at\nthis interval; its wake_message tells Neo to review active goals and\nreply with the HEARTBEAT_OK sentinel when nothing needs attention (the\nturn is then suppressed — no user-facing output). Config: [heartbeat]\nsection in neo.frozen.kvx / env NEO_HEARTBEAT_INTERVAL.
EDGES
  ^contains=matrix/neo/internal/config.Config

NODE id=matrix/neo/internal/config.Config#MCPCacheTTL kind=field
  digest=b3:a6f0d790b90cf3d1af2f8684b328435164891692b45ee67f57f56e0f2d772488 file=neo/internal/config/config.go range=227:233 lang=go exported=true byte_range=13310:13728
  sig=time.Duration
  doc=--- MCP tool result cache + parallel dispatch (P2-5) ---\nMCPCacheTTL is the TTL for the idempotent-read result cache. Zero\ndisables caching (the default). When >0, successful results for\nexplicitly-idempotent read tools (web_search, web_news) are served\nfrom cache within the TTL; side-effecting and money tools are never\ncached. Config: env NEO_MCP_CACHE_TTL_SECONDS.
EDGES
  ^contains=matrix/neo/internal/config.Config

