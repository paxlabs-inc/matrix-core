NODE id=matrix/neo/internal/config.Config.SoftBudgetTokens kind=method
  digest=b3:8503b0cc4f281e582ad30ba88389676a89a0b4d0819cca516f09c67456f683c8 file=neo/internal/config/config.go range=795:802 lang=go exported=true byte_range=40032:40517
  sig=func (c Config) SoftBudgetTokens() int
  doc=SoftBudgetTokens / HardBudgetTokens derive the compaction thresholds from\nthe configured context window: the percentage-derived budget, raised to\nwindow-minus-capped-headroom when the percentage would reserve more than the\nabsolute cap — so trimming fires only near true pressure at 1M scale while\nsmall windows keep the exact percentage behavior.
