  digest=b3:423d40155f7d2040bf4af27586b86c5d9317dd2689769b1078d37d58a778efad file=neo/internal/config/config.go range=173:175 lang=go exported=true byte_range=10295:10459
  sig=int
  doc=CassandraMinStep is the first loop step at which a mod may fire — there is\nno prior assistant turn to edit before step 2 (default 2).
