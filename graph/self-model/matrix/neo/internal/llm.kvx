NODE id=matrix/neo/internal/llm.idleTimeoutReader.Read kind=method
  digest=b3:c29c70cf36311fdea28c6196bce47f9320a980246ae144a46be5fb31c380fc22 file=neo/internal/llm/stream_idle.go range=34:42 lang=go exported=true byte_range=1139:1507
  sig=func (ir *idleTimeoutReader) Read(p []byte) (int, error)
  doc=Read arms the watchdog for the duration of the underlying Read and disarms it\nas soon as the Read returns (data or error), so the deadline governs silence\non the wire, never the caller's processing time between reads.
EDGES
  ^contains=matrix/neo/internal/llm.idleTimeoutReader
  ^defines=matrix/neo/internal/llm/stream_idle.go

NODE id=matrix/neo/internal/llm.idleTimeoutReader.stop kind=method
