NODE id=matrix/neo/internal/llm.newIdleTimeoutReader kind=func
  digest=b3:9957ef91ee70aae1722ffd9c9d45246efe9f0f3e9e4112a575e3ec749c6399fd file=neo/internal/llm/stream_idle.go range=23:32 lang=go exported=false byte_range=758:1137
  sig=func newIdleTimeoutReader(r io.Reader, idle time.Duration, onIdle func()) *idleTimeoutReader
  doc=newIdleTimeoutReader arms a watchdog around r. onIdle runs (once per stall)\nif any Read blocks longer than idle without returning.
EDGES
  ^defines=matrix/neo/internal/llm/stream_idle.go

NODE id=matrix/neo/internal/llm.parseTokenSection kind=func
  digest=b3:1f20ca1d7d9e563dfc6e6a48aae4676ca17ebfd3fd9c495cc6371aa57b94e142 file=neo/internal/llm/client.go range=957:986 lang=go exported=false byte_range=35332:36274
  sig=func parseTokenSection(section string, base int) []ToolCall
  doc=parseTokenSection decodes the calls inside one token-grammar section. base is\nthe running call count, used to synthesize stable call IDs.
EDGES
  ^defines=matrix/neo/internal/llm/client.go

NODE id=matrix/neo/internal/llm.previewVisible kind=func
  digest=b3:ed3247ae1a61c4811c88a8a834baddb06db0c859c1106e55fcdf61e94c658d25 file=neo/internal/llm/client.go range=511:522 lang=go exported=false byte_range=19099:19669
  sig=func previewVisible(content string) string
  doc=previewVisible returns the portion of an in-progress content buffer that is\nsafe to show as the visible answer so far: a leading <think>/<thinking>\nblock is moved out (held back until it closes) and any Kimi tool-call token\ngrammar is stripped. It reuses the exact helpers the final fold uses, so the\nstreamed prefix never diverges from the authoritative cleaned content.
EDGES
  ^defines=matrix/neo/internal/llm/client.go

NODE id=matrix/neo/internal/llm.reasoningEffort kind=func
  digest=b3:e474a83d78b97409484ddd7cc691d018f05ac20666b377ebbd5da17c1a621868 file=neo/internal/llm/client.go range=644:654 lang=go exported=false byte_range=23300:23766
  sig=func reasoningEffort(enabled bool) string
  doc=reasoningEffort maps the per-role EnableThinking flag onto xAI's\nreasoning_effort enum: reasoning ON → "medium" (balanced reasoning that keeps\ngrok-4.3 answering in the visible content channel instead of spending the\nwhole turn on chain-of-thought and emitting only a stub), OFF → "none"\n(disables reasoning entirely for token-tight mechanical roles).
EDGES
  ^defines=matrix/neo/internal/llm/client.go

NODE id=matrix/neo/internal/llm.sanitizeToolCalls kind=func
  digest=b3:04d0002f9188da778318d16df9213181d1faf9e62254849b872e1de06837d389 file=neo/internal/llm/client.go range=759:786 lang=go exported=false byte_range=27840:29060
  sig=func sanitizeToolCalls(calls []ToolCall) []ToolCall
  doc=sanitizeToolCalls guarantees every REPLAYED assistant tool_call carries a\nwell-formed function before it goes back on the wire. A truncated or\nmalformed generation can leave function.arguments empty or non-JSON; the\ntranscript is re-sent verbatim every turn, so replaying such a call makes a\nstrict provider (e.g. Together's DeepSeek-V4-Pro) reject the WHOLE request\nwith a 400 on the function field — which permanently wedges the conversation\n(every later turn carries the same poison). Coercing empty/invalid arguments\nto "{}" keeps the call structurally valid AND preserves the assistant↔\ntool_call_id pairing (so the matching tool-result is never orphaned). The\nagent already recorded the real parse error as that tool's result, so the\nmodel still gets the feedback it needs to re-issue the call correctly.
EDGES
  ^defines=matrix/neo/internal/llm/client.go

NODE id=matrix/neo/internal/llm.splitInlineThink kind=func
  digest=b3:3e85ebcb5a24c19aaf8d88ecac57497759a185816b6f78186724d3afabb545fb file=neo/internal/llm/client.go range=1253:1273 lang=go exported=false byte_range=43955:44887
  sig=func splitInlineThink(content string) (visible, reasoning string)
  doc=splitInlineThink moves a provider-inlined chain-of-thought block out of the\nvisible content and into the reasoning channel. Some providers/models emit\n`<think>…</think>` (or `<thinking>…</thinking>`) inside `content` instead of\nthe separate `reasoning_content` field; leaving it in place leaks internal\nmonologue into the chat. An unterminated opening tag (truncated generation)\nmeans the WHOLE remainder is reasoning.
EDGES
  ^defines=matrix/neo/internal/llm/client.go

