NODE id=matrix/neo/internal/llm.supportsReasoningEffort kind=func
  digest=b3:4291194511d0a3d04f3be28f9b178f8516a017576c2a41c07463db1a8c0075a3 file=neo/internal/llm/client.go range=636:642 lang=go exported=false byte_range=22904:23298
  sig=func supportsReasoningEffort(model string) bool
  doc=supportsReasoningEffort reports whether an xAI model accepts the\n`reasoning_effort` request field. Per xAI docs it is currently only honored\nby grok-4.3; other Grok models (grok-build-*, grok-4.20-*-non-reasoning)\nignore or reject it, so the field is omitted for them.
EDGES
  ^defines=matrix/neo/internal/llm/client.go

NODE id=matrix/neo/internal/llm.tagFunctionClose kind=const
  digest=b3:0f2551353992edb6de6b38827e7709ad7cf23fa0597fd8f0c3c5157665af9f49 file=neo/internal/llm/client.go range=1114:1123 lang=go exported=false byte_range=39751:40281
  sig=untyped string
  doc=Tag grammar MiMo (Qwen-family) models fall back to when the provider does\nnot parse their tool calls server-side: a `<tool_call>` wrapper, a\n`<function=NAME>` header, then one `<parameter=key>value` span per argument.\nClosing tags (`</parameter>`, `</function>`, `</tool_call>`) are frequently\nomitted or lost to truncation, so the parser treats every closer as optional.
EDGES
  ^defines=matrix/neo/internal/llm/client.go

