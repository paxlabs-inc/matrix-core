NODE id=matrix/neo/internal/llm.deltaFlushChars kind=const
  digest=b3:8649e64540b0001b2a7eeb781e6edaaef160f61c10dfe3688ac7027244743199 file=neo/internal/llm/client.go range=316:321 lang=go exported=false byte_range=11811:12201
  sig=untyped int
  doc=deltaFlushChars is the coalescing threshold for live streaming: incremental\nfragments are buffered until at least this many new visible/reasoning chars\nhave accumulated, then flushed via onDelta. Small enough for a smooth\n"typing" cadence, large enough to keep the SSE event volume sane (one event\nper ~handful of tokens rather than one per token).
EDGES
  ^defines=matrix/neo/internal/llm/client.go

NODE id=matrix/neo/internal/llm.enableThinkingArgs kind=func
  digest=b3:301db5fad87fc6fd10a499b30c12d05a434738d7380bf9aa905a33a6e6912f07 file=neo/internal/llm/client.go range=615:625 lang=go exported=false byte_range=21360:21933
  sig=func enableThinkingArgs(model string) map[string]any
  doc=enableThinkingArgs returns the chat_template_args that turn reasoning ON for\nBaseten-served models where it is OPT-IN: Kimi (moonshotai/*) emits its\nchain-of-thought as visible `content` unless enable_thinking makes the\nserver split it into the separate reasoning_content channel. Returns nil for\nmodels that reason by default or use a different provider param (never sent).
EDGES
  ^defines=matrix/neo/internal/llm/client.go

NODE id=matrix/neo/internal/llm.envKey kind=func
