  ^defines=matrix/neo/internal/llm/client.go

NODE id=matrix/neo/internal/llm.extractTagToolCalls kind=func
  digest=b3:e16b309431952188ea2574ff1bb10d3818861ae8d2f0d877e85ea9a8eef31327 file=neo/internal/llm/client.go range=1128:1195 lang=go exported=false byte_range=40354:42406
  sig=func extractTagToolCalls(content string) (string, []ToolCall)
  doc=extractTagToolCalls pulls tag-grammar tool calls out of content and returns\nthe content with those spans removed plus the structured calls. Parameter\nvalues run to the next parameter/closer (or end of content on truncation);\neach value is kept as a raw string unless it parses as standalone JSON.\nReturns (content, nil) when there is nothing to extract.
EDGES
  ^defines=matrix/neo/internal/llm/client.go

NODE id=matrix/neo/internal/llm.extractTokenToolCalls kind=func
  digest=b3:2af4cd98ee4abf55df255de812a958fb2f37ec3215b4192cc4d585e2607ae046 file=neo/internal/llm/client.go range=908:955 lang=go exported=false byte_range=33694:35330
  sig=func extractTokenToolCalls(content string) (string, []ToolCall)
  doc=extractTokenToolCalls pulls any token-grammar tool calls out of content and\nreturns the content with those spans removed plus the structured calls. It\ntolerates a missing section wrapper and an unterminated section (truncated\ngeneration): everything from the first marker onward is consumed so nothing\nleaks. Returns (content, nil) when there is nothing to extract.
EDGES
  ^defines=matrix/neo/internal/llm/client.go

NODE id=matrix/neo/internal/llm.extractXMLToolCalls kind=func
  digest=b3:7d3523b46b52489986cef55a78617ce958936fe344adec47766b5323116672fc file=neo/internal/llm/client.go range=1010:1064 lang=go exported=false byte_range=36998:38683
  sig=func extractXMLToolCalls(content string) (string, []ToolCall)
  doc=extractXMLToolCalls pulls any `<function_call name="NAME">ARGS</function_call>`\nspans out of content and returns the content with those spans removed plus the\nstructured calls. ARGS is normalized to a JSON object (the first {...} span, or\n"{}" when absent/unparseable) so downstream dispatch always receives valid\narguments. It tolerates a missing/truncated close tag (everything from the\nopen tag onward is consumed so nothing leaks). Returns (content, nil) when\nthere is nothing to extract.
EDGES
  ^defines=matrix/neo/internal/llm/client.go

NODE id=matrix/neo/internal/llm.fromWireRespMessage kind=func
  digest=b3:220ee1b2c738e48c7df53cd9500e7a8f6503a160a20c794f6229f5e56adf4342 file=neo/internal/llm/client.go range=837:894 lang=go exported=false byte_range=30769:33194
  sig=func fromWireRespMessage(m wireRespMessage) Message
EDGES
  ^defines=matrix/neo/internal/llm/client.go

NODE id=matrix/neo/internal/llm.holdbackPartial kind=func
  digest=b3:a4a901b23d3665c90f4b5e5120ef9c4087a2bbfd4cad6dad3585ce700617e7a1 file=neo/internal/llm/client.go range=524:544 lang=go exported=false byte_range=19671:20385
  sig=func holdbackPartial(s string) string
  doc=holdbackPartial withholds a trailing fragment that could be the start of a\ncontrol marker (<think>, <thinking>, or the Kimi tool-call section/call\ntokens) so a half-arrived marker is never streamed as visible text. A normal\n'<' in prose (e.g. "a < b") is left intact — only a tail that is a genuine\nprefix of a known marker is held back, to be resolved once more bytes arrive.
EDGES
  ^defines=matrix/neo/internal/llm/client.go

NODE id=matrix/neo/internal/llm.idleTimeoutReader kind=type
  digest=b3:cc330f9cbc80fc001f2c6022288a1f5319f20ba923d32f11d9edbb9e2da1a30e file=neo/internal/llm/stream_idle.go range=11:21 lang=go exported=false byte_range=208:756
  sig=type idleTimeoutReader struct {\n	r	io.Reader\n	idle	time.Duration\n	timer	*time.Timer\n}
  doc=idleTimeoutReader wraps a streaming response body and fires onIdle if a\nsingle Read makes no progress within idle. It is the stream-aware\nreplacement for a blunt http.Client.Timeout: a long but healthy generation\nstreams tokens continuously and never trips, while a provider that stalls\nmid-stream (or never produces a first token) is cancelled promptly. onIdle is\nexpected to cancel the request context, which unblocks the in-flight Read.
EDGES
  contains=matrix/neo/internal/llm.idleTimeoutReader#idle,matrix/neo/internal/llm.idleTimeoutReader#r,matrix/neo/internal/llm.idleTimeoutReader#timer,matrix/neo/internal/llm.idleTimeoutReader.Read,matrix/neo/internal/llm.idleTimeoutReader.stop
  ^defines=matrix/neo/internal/llm/stream_idle.go

