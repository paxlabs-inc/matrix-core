NODE id=matrix/neo/cmd/neo.newOmniClient kind=func
  digest=b3:5954a8068dc2e5efc3cedaf3aa5730fe0dbc39c2166f14d1519a445e1b30d260 file=neo/cmd/neo/main.go range=198:221 lang=go exported=false byte_range=5245:6276
  sig=func newOmniClient(model string) (*neollm.Client, error)
  doc=newOmniClient builds the stateless MiMo v2.5 omni vision grounder used only\ninside DOJO's desktop_look. The omni id ("mimo-v2.5") is not the Xiaomi text\nplanner id ("mimo-v2.5-pro"), so the provider is pinned explicitly and the\nclient talks DIRECTLY to api.xiaomimimo.com with the MiMo key — the same\ndirect posture VOICE uses for ASR — rather than riding the gateway. Returns\nnil when no MiMo key is configured (desktop_look then stays unadvertised).
EDGES
  ^defines=matrix/neo/cmd/neo/main.go

NODE id=matrix/neo/cmd/neo.newSlotClient kind=func
  digest=b3:9a7e7f75dde067ff2a89217570de65626b4b12283c6181f1d94da084f7ac10a5 file=neo/cmd/neo/main.go range=223:241 lang=go exported=false byte_range=6278:7252
  sig=func newSlotClient(model string, temp float64, maxTok int, slot string, enableThinking bool, cfg config.Config) (*neollm.Client, error)
  doc=newSlotClient builds a gateway-metered chat client tagged with the given\nslot label, so spend is attributed correctly (Neo's own "neo" slot, or\nCassandra's dedicated "cassandra" slot for completeness audits). enableThinking\nopts the client into extended reasoning where the toggle matters (xAI Grok's\nreasoning_effort control; Baseten Kimi's chat_template_args opt-in) — set ONLY\nfor the user-facing conversational loop (Neo).\nCassandra, background sub-agents, and the token-tight cheap/consolidation\nroles all run with thinking OFF; the core MCL pipeline manages its own.
EDGES
  ^defines=matrix/neo/cmd/neo/main.go

