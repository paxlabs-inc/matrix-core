  ^defines=matrix/executor/compilecache/cache.go

NODE id=matrix/executor/compilecache.Store kind=func
  digest=b3:9f239ab65f3f2d1d7d8d6cad18666219db53c18e8e2173aa93bb3a499d8dd8ed file=executor/compilecache/cache.go range=176:211 lang=go exported=true byte_range=6458:7722
  sig=func Store(s *store.Store, hexKey string, e *Entry) error
  doc=Store writes e at meta/compile_cache/<hexKey>. Overwrites silently\nwhen the key already exists (compile is deterministic for the same\ninputs, so a re-write of the same Entry is by construction a\nbyte-identical update; an over-write across model changes is the\nintended replacement semantic).\n\nThe caller MUST set Entry.SchemaVersion to SchemaVersion (Store\nvalidates and rejects otherwise so a forward-incompat write can't\npoison the cache before the schema bump is wired through the rest\nof the stack).
EDGES
  ^defines=matrix/executor/compilecache/cache.go

