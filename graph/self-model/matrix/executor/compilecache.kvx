  digest=b3:2b2a2707187620a78287a4b88f04d79d3a59d0a7d9931da8cb9ace101ed91973 file=executor/compilecache/cache.go range=54:57 lang=go exported=true byte_range=2331:2564
  sig=uint8
  doc=SchemaVersion is bumped on any incompatible Entry-encoding change.\nCold-load mismatch ⇒ Lookup returns (nil, false, nil) so the cache\nbehaves like a cold start instead of poisoning Intent IRs.
