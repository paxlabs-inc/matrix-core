  digest=b3:72a8cc5ecbee8d4f261df9a692ca1704aba6a98929fc6ca9ee9615edaff2e130 file=executor/compilecache/cache.go range=94:98 lang=go exported=true byte_range=3810:4076
  sig=byte
  doc=US is the 0x1f Unit Separator byte used to delimit the cache-key\ncomponents. Same separator the compiler seed derivation uses\n(executor/cmd/mcl-execute/compile.go:compilerSeed) so the two key\nderivations are stylistically consistent.
