  ^defines=matrix/executor/tool/registry.go

NODE id=matrix/executor/tool.cacheableTools kind=var
  digest=b3:d90da26d99e46c747769080ea95f42738285fccb5a56ca19e956d061521cdc8c file=executor/tool/registry.go range=46:56 lang=go exported=false byte_range=1282:1811
  sig=map[string]bool
  doc=cacheableTools is the closed allow-list of tool NAMES (server-local,\ni.e. the ToolEntry.Name, NOT the function name) whose results are\nsafe to cache: pure read-only idempotent lookups. web_search /\nweb_news return ranked results for a fixed query and never mutate\nstate. Anything that writes, shells out, touches the chain, or moves\nfunds is excluded by omission — "NEVER cache side-effecting or money\ntools" (P2-5 mandate).
EDGES
  ^defines=matrix/executor/tool/registry.go

