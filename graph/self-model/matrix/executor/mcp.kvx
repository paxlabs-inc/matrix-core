NODE id=matrix/executor/mcp.NewStdioTransport kind=func
  digest=b3:cba1e0bbdfeebf81ae417e3fa76af3bacdd5ae22db02048f66b4e245486282ab file=executor/mcp/stdio.go range=65:121 lang=go exported=true byte_range=1784:3375
  sig=func NewStdioTransport(p StdioParams) (*StdioTransport, error)
  doc=NewStdioTransport spawns the configured subprocess and wires its\nstdio streams. Returns the transport ready to Send/Recv. Errors\nfrom the spawn itself (binary not found, permission denied) surface\nhere; runtime errors come back through Send/Recv.\n\nThe caller (manager) is responsible for calling Close to signal\nshutdown; the transport will then close stdin and let the subprocess\ndrain naturally before reaping.
EDGES
  ^defines=matrix/executor/mcp/stdio.go

