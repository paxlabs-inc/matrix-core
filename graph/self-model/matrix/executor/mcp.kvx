NODE id=matrix/executor/mcp.Client.Initialize kind=method
  digest=b3:aaba5ac1032b5f5ceb22dbee350c5777f321571bc779ce44cbf58472f8bb76a1 file=executor/mcp/client.go range=88:126 lang=go exported=true byte_range=2795:3963
  sig=func (c *Client) Initialize(ctx context.Context) (*InitializeResult, error)
  doc=Initialize completes the MCP handshake: sends initialize request,\nawaits the result, sends notifications/initialized, and stashes the\nserver's capabilities for later inspection via Info.\n\nCalling Initialize twice is a no-op the second time (returns the\ncached InitializeResult). This is forgiving by design; the manager\ntreats Initialize as idempotent during reconnect attempts.
EDGES
  ^contains=matrix/executor/mcp.Client
  ^defines=matrix/executor/mcp/client.go

