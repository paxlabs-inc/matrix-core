NODE id=matrix/executor/mcp.Client.ToolsCall kind=method
  digest=b3:19823004fa1fe4cc59da54226a0cd3b696b4e767abdd1028576982493332bd0e file=executor/mcp/client.go range=168:186 lang=go exported=true byte_range=5057:5941
  sig=func (c *Client) ToolsCall(ctx context.Context, name string, args map[string]interface{}) (*CallToolResult, error)
  doc=ToolsCall invokes a tool by name. Args are server-validated against\nthe tool's inputSchema (and Matrix re-validates client-side via the\ntool registry).\n\nReturns the typed CallToolResult. Note: result.IsError=true is NOT\nsurfaced as a Go error — that's an in-band tool-level failure (e.g.\n"shell exit 1") which the executor maps to a Failure step. Only\ntransport-level / RPC-level errors come back through err.
EDGES
  ^contains=matrix/executor/mcp.Client
  ^defines=matrix/executor/mcp/client.go

NODE id=matrix/executor/mcp.Client.ToolsList kind=method
  digest=b3:1b49984362ad04bcb2a25ca78cd5defda5b35de5796ea1b6929b70556210ea54 file=executor/mcp/client.go range=140:166 lang=go exported=true byte_range=4245:5055
  sig=func (c *Client) ToolsList(ctx context.Context) ([]Tool, error)
  doc=ToolsList enumerates the server's exposed tools. Used by the\nmanager at startup to verify the agent manifest matches what the\nserver actually offers (Q21).\n\nPagination via NextCursor is fully consumed here so callers see one\nflat list; paginated servers are uncommon at v1 scale but the spec\nallows them.
EDGES
  ^contains=matrix/executor/mcp.Client
  ^defines=matrix/executor/mcp/client.go

NODE id=matrix/executor/mcp.Client.readLoop kind=method
  digest=b3:d887ecce6a262331f903b495040337c610367c40ad22e47b33aa814411c60a63 file=executor/mcp/client.go range=306:343 lang=go exported=false byte_range=8908:9955
  sig=func (c *Client) readLoop()
  doc=readLoop consumes inbound frames, classifies them, and routes to\npending response channels (responses) or the notify handler\n(notifications). Inbound requests are not expected at v1 (no\nsampling/createMessage support); they're logged and ignored.
EDGES
  ^contains=matrix/executor/mcp.Client
  ^defines=matrix/executor/mcp/client.go

