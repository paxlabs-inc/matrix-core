NODE id=matrix/executor/mcp.StdioTransport kind=type
  digest=b3:cfea2fc3947721334b8c6dbd756f4c82289b25c489391acda86b788e2f72749c file=executor/mcp/stdio.go range=17:40 lang=go exported=true byte_range=262:1050
  sig=type StdioTransport struct {\n	cmd	*exec.Cmd\n\n	stdin	io.WriteCloser\n	stdout	*bufio.Reader\n	stderr	io.ReadCloser\n\n	mu	sync.Mutex\n	closed	bool\n\n	// stderrSink optionally captures the subprocess's stderr for diagnostic\n	// surfacing. Default nil = discard. Manager wires this to a logger.\n	stderrSink	io.Writer\n}
  doc=StdioTransport runs an MCP server as a subprocess and exchanges\nJSON-RPC frames over its stdin/stdout, one frame per line.\n\nQ15 + Q16 locks: stdio is the primary v1 transport; the subprocess\nis owned by the manager (per-agent persistent), spawn-on-boot,\ngraceful drain on stop.\n\nQ18 lock: env-var refs in the agent manifest are resolved upstream\nand passed via Cmd.Env. Credentials never appear in the args slice\n(would leak through ps listings).
EDGES
  contains=matrix/executor/mcp.StdioTransport#closed,matrix/executor/mcp.StdioTransport#cmd,matrix/executor/mcp.StdioTransport#mu,matrix/executor/mcp.StdioTransport#stderr,matrix/executor/mcp.StdioTransport#stderrSink,matrix/executor/mcp.StdioTransport#stdin,matrix/executor/mcp.StdioTransport#stdout,matrix/executor/mcp.StdioTransport.Close,matrix/executor/mcp.StdioTransport.Process,matrix/executor/mcp.StdioTransport.Recv,matrix/executor/mcp.StdioTransport.Send,matrix/executor/mcp.StdioTransport.drainStderr
  implements=matrix/executor/mcp.Transport
  ^defines=matrix/executor/mcp/stdio.go

