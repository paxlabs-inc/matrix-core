  ^defines=matrix/executor/internal/snapshot/snapshot.go

NODE id=matrix/executor/internal/snapshot.Manager.Push kind=method
  digest=b3:0106dee69d664a2b6c944facd60e69ff991890b2fe23cc33198e4321513711d4 file=executor/internal/snapshot/snapshot.go range=334:409 lang=go exported=true byte_range=11021:13423
  sig=func (m *Manager) Push(ctx context.Context) (string, error)
  doc=Push tar+zstd's the DataDir tree, uploads it to\nusers/<uid>/snapshots/<ts>.tar.zst, then atomically updates\nusers/<uid>/latest.tar.zst via a server-side copy.\n\nReturns the timestamp-suffixed object key on success. Concurrent Push\ncalls serialize on pushMu (cortex-quiescence isn't promised; this\nonly prevents two concurrent mc cp uploads racing the alias write).
EDGES
  ^contains=matrix/executor/internal/snapshot.Manager
  ^defines=matrix/executor/internal/snapshot/snapshot.go

