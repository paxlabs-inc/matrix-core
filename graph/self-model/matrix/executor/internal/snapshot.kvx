NODE id=matrix/executor/internal/snapshot.tarZst kind=func
  digest=b3:16288d19c62622d51ee5c242cb82ea7450215cce4edcea91845aa849f15b51eb file=executor/internal/snapshot/snapshot.go range=483:497 lang=go exported=false byte_range=15500:16165
  sig=func tarZst(ctx context.Context, src, dst string) error
  doc=tarZst archives src/ as zstd-compressed tar at dst. Shells to\n`tar -I zstd -cf <dst> -C <src> .` so we avoid pulling a Go zstd\ndependency. The image's apt-installed zstd + tar are required at\nruntime (verified in deploy/railway/Dockerfile).
EDGES
  ^defines=matrix/executor/internal/snapshot/snapshot.go

NODE id=matrix/executor/internal/snapshot.untarZst kind=func
  digest=b3:0d1f0cfd6fa71da9560992528cbdd7afe86187791a53ed0204bd7256490a60ed file=executor/internal/snapshot/snapshot.go range=499:512 lang=go exported=false byte_range=16167:16741
  sig=func untarZst(ctx context.Context, src, dst string) error
  doc=untarZst extracts src (zstd-compressed tar) into dst/. dst must\nalready exist; tar will create subdirs as needed. Shells to\n`tar -I zstd -xf <src> -C <dst>`.
EDGES
  ^defines=matrix/executor/internal/snapshot/snapshot.go

