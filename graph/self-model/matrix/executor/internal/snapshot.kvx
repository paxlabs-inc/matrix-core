  digest=b3:42dbd5bbdaaa76f6e892b3b13c3a774b2e0f3e0fdca11ba794aafb8fbe850565 file=executor/internal/snapshot/snapshot.go range=147:200 lang=go exported=true byte_range=5462:6980
  sig=func New(cfg Config) (*Manager, error)
  doc=New validates cfg and returns a Manager.\n\nReturns ErrIncomplete (wrapped with the missing-field list) when any\nrequired field is empty. Endpoint is parsed with url.Parse; a\nmalformed URL also returns an error.
