  ^defines=matrix/executor/internal/snapshot/snapshot.go

NODE id=matrix/executor/internal/snapshot.New kind=func
  digest=b3:1beb53a122db6434d59244936eeca263488d1d0f94bd8980d3d71c5537b9d152 file=executor/internal/snapshot/snapshot.go range=143:196 lang=go exported=true byte_range=5232:6730
  sig=func New(cfg Config) (*Manager, error)
  doc=New validates cfg and returns a Manager.\n\nReturns ErrIncomplete (wrapped with the missing-field list) when any\nrequired field is empty. Endpoint is parsed with url.Parse; a\nmalformed URL also returns an error.
EDGES
  ^defines=matrix/executor/internal/snapshot/snapshot.go

NODE id=matrix/executor/internal/snapshot.SeededSentinel kind=const
  digest=b3:6173b79dcb9de608161d713910ba5a275f209510d42e9cf35464f4109eb8b9e5 file=executor/internal/snapshot/snapshot.go range=96:101 lang=go exported=true byte_range=3382:3750
  sig=untyped string
  doc=SeededSentinel is the path (relative to DataDir) that marks a Volume\nas already-seeded. New Machines pull latest.tar.zst the first time\nthis file is missing; once it's present, subsequent boots skip the\npull. The sentinel itself is part of the tarball, so a restore from\na previous snapshot lands in seeded state.
EDGES
  ^defines=matrix/executor/internal/snapshot/snapshot.go

NODE id=matrix/executor/internal/snapshot.isVaultFile kind=func
  digest=b3:c6c037b36eba40e7357c1e89c46209fd888c73d17bf68d81b0f08d6e4a083a5a file=executor/internal/snapshot/vault.go range=87:100 lang=go exported=false byte_range=2897:3247
  sig=func isVaultFile(path string) (bool, error)
  doc=isVaultFile sniffs whether the file at path begins with the vault magic.
EDGES
  ^defines=matrix/executor/internal/snapshot/vault.go

NODE id=matrix/executor/internal/snapshot.snapAD kind=func
  digest=b3:1d294374c81dfc552becf18380fde4377e113ea00f82f52e33cc15b379192ac6 file=executor/internal/snapshot/vault.go range=36:42 lang=go exported=false byte_range=1222:1628
  sig=func snapAD(user string) vault.AD
  doc=snapAD is the tarball's associated data. It deliberately binds the user\nonly — the same object bytes live under snapshots/<ts>.tar.zst AND the\nserver-side-copied latest.tar.zst alias, so the object key cannot be\nbound. Within the stream, chunk order and termination are bound per chunk.
EDGES
  ^defines=matrix/executor/internal/snapshot/vault.go

