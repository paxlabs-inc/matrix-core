NODE id=matrix/executor/internal/snapshot.tarZst kind=func
  digest=b3:999e292bcc50e8fdc7565b6de04ac14c932524b657fc997b6191af0b898b1089 file=executor/internal/snapshot/snapshot.go range=507:520 lang=go exported=false byte_range=16861:17478
  sig=func tarZst(ctx context.Context, src, dst string) error
  doc=tarZst archives src/ as zstd-compressed tar at dst. Shells to\n`tar -I zstd -cf <dst> -C <src> .` so we avoid pulling a Go zstd\ndependency. The image's apt-installed zstd + tar are required at\nruntime (verified in deploy/daemon/Dockerfile).
EDGES
  ^defines=matrix/executor/internal/snapshot/snapshot.go

NODE id=matrix/executor/internal/snapshot.untarZst kind=func
  digest=b3:279e153bc4ef66f129137d9699d51a2bf9deb7c894de26486cf036f1915c69b2 file=executor/internal/snapshot/snapshot.go range=522:534 lang=go exported=false byte_range=17480:18007
  sig=func untarZst(ctx context.Context, src, dst string) error
  doc=untarZst extracts src (zstd-compressed tar) into dst/. dst must\nalready exist; tar will create subdirs as needed. Shells to\n`tar -I zstd -xf <src> -C <dst>`.
EDGES
  ^defines=matrix/executor/internal/snapshot/snapshot.go

