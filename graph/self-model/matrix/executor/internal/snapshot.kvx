NODE id=matrix/executor/internal/snapshot.Manager.Start kind=method
  digest=b3:b185e405584ed460680164e47b55702123b818deefa4525cff90f32c3c4a8027 file=executor/internal/snapshot/snapshot.go range=411:433 lang=go exported=true byte_range=13425:14131
  sig=func (m *Manager) Start(ctx context.Context)
  doc=Start launches the periodic-push ticker if cfg.PushInterval >= 0.\nIdempotent: subsequent calls are no-ops. Returns immediately.\n\nPushInterval == 0 → DefaultPushInterval (5 minutes).\nPushInterval  < 0 → no ticker; periodic pushes disabled (only\nBootPull and Stop's final push remain).
EDGES
  ^contains=matrix/executor/internal/snapshot.Manager
  ^defines=matrix/executor/internal/snapshot/snapshot.go

NODE id=matrix/executor/internal/snapshot.Manager.Stop kind=method
  digest=b3:dac1c6d9c5f8c8618bfeb421bb312417ff673a6e3d3d63c30365f739f1d6d4fa file=executor/internal/snapshot/snapshot.go range=462:481 lang=go exported=true byte_range=14946:15498
  sig=func (m *Manager) Stop(ctx context.Context) error
  doc=Stop halts the periodic ticker and runs one final Push using ctx.\nIdempotent: subsequent calls are no-ops.\n\nReturns the error from the final Push (or nil); the ticker shutdown\nitself never errors.
EDGES
  ^contains=matrix/executor/internal/snapshot.Manager
  ^defines=matrix/executor/internal/snapshot/snapshot.go

