NODE id=matrix/executor/internal/snapshot.Manager.tick kind=method
  digest=b3:937fd98cae4003a9c674b8f83ddb80fff0ae4ebd05e163ab7ded59e0f6162ab0 file=executor/internal/snapshot/snapshot.go range=435:460 lang=go exported=false byte_range=14133:14944
  sig=func (m *Manager) tick(parent context.Context, interval time.Duration)
  doc=tick runs until ctx is cancelled OR Stop closes stopCh, then closes\ndoneCh and exits. Each tick fires Push with a fresh per-tick context\nderived from the parent so a long-running upload that misses the next\ntick doesn't block the ticker (each Push contends pushMu — slow\nuploads delay the next attempt rather than overlapping).
EDGES
  ^contains=matrix/executor/internal/snapshot.Manager
  ^defines=matrix/executor/internal/snapshot/snapshot.go

NODE id=matrix/executor/internal/snapshot.Manager.userPrefix kind=method
  digest=b3:29350a7a86cda0ed18af9b13ff08e3251c93081c65d8d272bc0d18a601dd64e6 file=executor/internal/snapshot/snapshot.go range=198:201 lang=go exported=false byte_range=6732:6845
  sig=func (m *Manager) userPrefix() string
  doc=userPrefix returns "users/<UserID>".
