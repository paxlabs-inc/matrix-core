  digest=b3:deb87592bee9e8ae7e3d3617012f84b049ebfa00318ecb03d6a6a4eddfca0a8e file=executor/internal/snapshot/vault.go range=55:85 lang=go exported=false byte_range=1958:2895
  sig=func (m *Manager) sealFile(src, dst string) error
  doc=sealFile streams src into dst as chunked AEAD ciphertext. Caller has\nverified the session is encrypting.
