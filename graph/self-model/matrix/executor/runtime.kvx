  digest=b3:946f5e6d45404af284f1cc01b95ed3c34965ce19dac56da1422ba9a773da1ef2 file=executor/runtime/argref.go range=38:40 lang=go exported=false byte_range=1698:1943
  sig=map[string]bool
  doc=wholeOutputSuffixes are the dotted suffixes that mean "substitute the entire\nnode output" rather than extract a named field.
