NODE id=matrix/executor/runtime.SkillReloader.Start kind=method
  digest=b3:cb5ef17880242e3cdfbd6c6845d132b2cf97a9aa9f64bc423b7aa2f535805c29 file=executor/runtime/skill_reload.go range=114:167 lang=go exported=true byte_range=4199:6145
  sig=func (r *SkillReloader) Start() error
  doc=Start begins watching the skills root for SKILL.mtx changes. On a disabled\nreloader it is a safe no-op (returns nil) — the production path.\n\nOn an enabled reloader it performs an initial full scan of the corpus\n(so the live registry is populated immediately, not only on the first\nedit), then starts an fsnotify watcher goroutine that re-parses changed\nSKILL.mtx files. Invalid edits are logged into r.errs and dropped; they\nnever crash the goroutine.
EDGES
  ^contains=matrix/executor/runtime.SkillReloader
  ^defines=matrix/executor/runtime/skill_reload.go

