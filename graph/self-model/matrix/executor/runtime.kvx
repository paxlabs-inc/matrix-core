  digest=b3:eba022d1f59a2a99653ce76a556e24f04e884037e595ecf83b5e35b6065aba73 file=executor/runtime/skill_loader.go range=124:132 lang=go exported=true byte_range=4640:4991
  sig=type SkillLoader struct {\n	// RepoRoot is the absolute filesystem root containing per-skill\n	// directories. Empty → DefaultSkillRepoRoot.\n	RepoRoot string\n}
  doc=SkillLoader resolves matrix://skill/... URIs against a filesystem repo.\n\nConstruction is cheap; Load is pure (no caching). Embed inside a\ncaching layer if your workload demands it.
EDGES
  contains=matrix/executor/runtime.SkillLoader#RepoRoot,matrix/executor/runtime.SkillLoader.Load
  ^defines=matrix/executor/runtime/skill_loader.go

NODE id=matrix/executor/runtime.SkillLoader#RepoRoot kind=field
  digest=b3:756a5f241293aec78f9ccd8b7f05c1a7b638afcc778eecb35395f4bd41614808 file=executor/runtime/skill_loader.go range=129:131 lang=go exported=true byte_range=4859:4989
