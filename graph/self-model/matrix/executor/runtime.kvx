NODE id=matrix/executor/runtime.stripCodeFence kind=func
  digest=b3:7661afd960cda01f7d3e20c6908aa5c226473279dfb33ca9d2632d14ee5c3af0 file=executor/runtime/coerce.go range=179:199 lang=go exported=false byte_range=6485:7259
  sig=func stripCodeFence(s string) string
  doc=stripCodeFence removes a leading Markdown code fence (``` or ```lang) and a\nmatching trailing fence from s, returning the inner body. An upstream codegen\nstep's text output (threaded into a tool arg via ${node.output}) commonly\narrives fenced; the strict tool parser needs the bare JSON. Returns the\ntrimmed input unchanged when there is no leading fence.
EDGES
  ^defines=matrix/executor/runtime/coerce.go

NODE id=matrix/executor/runtime.truncate kind=func
  digest=b3:e60637d9743e4a67c69ee12334dedd000066fc2913fcd17f193efe86bc3e75b6 file=executor/runtime/walker.go range=836:843 lang=go exported=false byte_range=28974:29217
  sig=func truncate(s string, n int) string
  doc=truncate clips s to at most n runes (rough; treats bytes as runes for\nthe ASCII-heavy paths the walker produces). Mirrors transcript.go:93.
EDGES
  ^defines=matrix/executor/runtime/walker.go

NODE id=matrix/executor/runtime.unwrapWrapper kind=func
  digest=b3:938638ee6d0ec5119113dd2641a3eee7b4d35c7009e9aef30db490a3e7b100b8 file=executor/runtime/coerce.go range=120:134 lang=go exported=false byte_range=4378:4915
  sig=func unwrapWrapper(key string, m map[string]interface{}) interface{}
  doc=unwrapWrapper returns m's single inner container when m is exactly\n{<key>: <container>} (the arg name echoed as a wrapper), else m verbatim. The\nexact key match + container-only inner keeps a real single-file `sources` map\n(whose key is a path like "src/A.sol", never the arg name) untouched.
EDGES
  ^defines=matrix/executor/runtime/coerce.go

