NODE id=matrix/executor/runtime.SkillLoader.Load kind=method
  digest=b3:ef8d5e77cb96d73af6fec93ff241e0a9f36826c448030555039b27c6dcb8696c file=executor/runtime/skill_loader.go range=142:227 lang=go exported=true byte_range=5214:7939
  sig=func (l *SkillLoader) Load(uri string) (*LoadedSkill, error)
  doc=Load resolves a matrix://skill/<slug>@<version> URI to a LoadedSkill.\n\nSteps:\n\n 1. Parse the URI (S23Q5 + Q22: version pin REQUIRED).\n 2. Read <RepoRoot>/<slug>/SKILL.mtx + (optional) SKILL.md.\n 3. Lex + parse the SKILL.mtx (MCL/mtx/parser.Parse).\n 4. Run ValidateSkill against all 10 rules (MCL/mtx/validator.ValidateSkill).\n 5. Extract §SKILL.id and §SKILL.version; verify they match the URI.\n 6. Compute the canonical AST hash (canonical.Hash).\n\nEach step that fails returns a wrapped error naming the URI + step.
EDGES
  ^contains=matrix/executor/runtime.SkillLoader
  ^defines=matrix/executor/runtime/skill_loader.go

NODE id=matrix/executor/runtime.SkillReloader kind=type
  digest=b3:9eb0341f9c03a93fe166741b07bc2a025dce34f221beed19536c007bacd4ceb1 file=executor/runtime/skill_reload.go range=42:66 lang=go exported=true byte_range=1725:2675
  sig=type SkillReloader struct {\n	loader	*SkillLoader\n	root	string\n\n	enabled	bool\n\n	mu	sync.RWMutex\n	live	map[string]*LoadedSkill	// uri -> parsed skill\n	done	chan struct{}		// closed when the watcher loop should stop\n	started	bool\n	closed	bool\n\n	// errs captures the most recent re-parse error so tests / ops can\n	// inspect why an edit was rejected rather than silently dropped. It is\n	// only ever set inside the watcher loop; reads are racy by design (a\n	// best-effort signal, not a contract).\n	errs	[]string\n}
  doc=SkillReloader is the dev hot-reload surface. It wraps a SkillLoader with a\nlive, mutex-guarded registry of parsed skills that is refreshed by an\nfsnotify watcher when a SKILL.mtx changes on disk.\n\nA DISABLED reloader (the production default) has enabled=false, no watcher,\nand inert Start/Close/Lookup. This structurally enforces the "off by\ndefault" + "prod stays read-only" acceptance criteria.
EDGES
  contains=matrix/executor/runtime.SkillReloader#closed,matrix/executor/runtime.SkillReloader#done,matrix/executor/runtime.SkillReloader#enabled,matrix/executor/runtime.SkillReloader#errs,matrix/executor/runtime.SkillReloader#live,matrix/executor/runtime.SkillReloader#loader,matrix/executor/runtime.SkillReloader#mu,matrix/executor/runtime.SkillReloader#root,matrix/executor/runtime.SkillReloader#started,matrix/executor/runtime.SkillReloader.Close,matrix/executor/runtime.SkillReloader.Enabled,matrix/executor/runtime.SkillReloader.LatestErrors,matrix/executor/runtime.SkillReloader.Lookup,matrix/executor/runtime.SkillReloader.Start,matrix/executor/runtime.SkillReloader.appendErr,matrix/executor/runtime.SkillReloader.dropSlug,matrix/executor/runtime.SkillReloader.initialScan,matrix/executor/runtime.SkillReloader.isSkillMtx,matrix/executor/runtime.SkillReloader.loop,matrix/executor/runtime.SkillReloader.parseAndLoad,matrix/executor/runtime.SkillReloader.reparseSlug
  ^defines=matrix/executor/runtime/skill_reload.go

