NODE id=matrix/executor/runtime.decodeEmbeddedJSON kind=func
  digest=b3:04b3c12df5e74028232135535370859ad9ed1283e1e90ed87fc67e9712b436db file=executor/runtime/coerce.go range=136:158 lang=go exported=false byte_range=4917:5741
  sig=func decodeEmbeddedJSON(s string) (interface{}, bool)
  doc=decodeEmbeddedJSON returns the first complete JSON object/array embedded in s,\nignoring any surrounding prose or Markdown fence. It walks each '{'/'[' and\nlets encoding/json decode one value from that offset (the decoder respects\nstring quoting, so braces inside Solidity source strings never confuse it)\nand stops at the first position that yields a container. Trailing prose after\nthe value is ignored by the streaming decoder.
EDGES
  ^defines=matrix/executor/runtime/coerce.go

