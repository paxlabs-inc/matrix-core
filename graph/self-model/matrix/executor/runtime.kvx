NODE id=matrix/executor/runtime.Walker.pollCorrections kind=method
  digest=b3:d767e3986add893ee9419e94e030c21f354ed43b56460558240f1bac829741b2 file=executor/runtime/walker.go range=339:386 lang=go exported=false byte_range=12350:13866
  sig=func (w *Walker) pollCorrections(ctx context.Context, wr *WalkResult) error
  doc=pollCorrections drains the CorrectionInbox non-blockingly between\nnodes and routes each delivered correction through OnCorrection.\nReturns ErrMaterialCorrection if any handler classified material;\nreturns the handler's error if it returned one; nil otherwise.\n\nSpec citation: matrix.kvx executor_locked_design Q11 (live during\nplan walk) — implementation as a between-node hook rather than\nmid-node preemption, which would risk leaving partial-journal state.
EDGES
  ^contains=matrix/executor/runtime.Walker
  ^defines=matrix/executor/runtime/walker.go

