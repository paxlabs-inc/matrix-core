NODE id=matrix/executor/materiality.ruleBudgetDelta kind=func
  digest=b3:58796dbdba181746b4fbcf0c27bf006e69b64971e22819d4054adfe9aca3b312 file=executor/materiality/classify.go range=154:200 lang=go exported=false byte_range=4977:6588
  sig=func ruleBudgetDelta(in Inputs) *Reason
  doc=---- rule 1: Budget delta ----\n\n§18.1: "expected_cost_new > expected_cost_original × 1.10 OR\n\n	expected_cost_new − expected_cost_original > 5 PAX.\n	(Whichever is larger.)"\n\nSource of expected_cost: ir.Budget.MaxCost (intent or plan). Plan budget\nnarrows intent budget (MCL/ir/plan.go:63-65); we read from plan when\npresent, else from intent.
EDGES
  ^defines=matrix/executor/materiality/classify.go

NODE id=matrix/executor/materiality.ruleDeadlineShift kind=func
  digest=b3:a460777871ba471297ae74d854f0f683b23d8649441aa685404e56ed1d00dcf1 file=executor/materiality/classify.go range=616:672 lang=go exported=false byte_range=18655:20602
  sig=func ruleDeadlineShift(in Inputs) *Reason
  doc=---- rule 7: Deadline shift > 25% ----\n\n§18.1: "New deadline moves the remaining-time window by more than 25%."\n\nremaining_orig = original_deadline − now\nremaining_new  = new_deadline − now\nshift_ratio    = |remaining_new − remaining_orig| / |remaining_orig|\nmaterial iff shift_ratio > 0.25.\n\nEdge cases:\n  - Adding a deadline where none existed → material (new constraint)\n  - Removing a deadline → material (removed deadline = unbounded)\n  - Original deadline already in the past → cannot compute remaining\n    window; treat any change as material.
EDGES
  ^defines=matrix/executor/materiality/classify.go

NODE id=matrix/executor/materiality.ruleHardConstraintRelaxed kind=func
  digest=b3:30efdd6fd8112eb2d3124d6ba8f75c4da3997a4b7d79cf919614f0fe5c667777 file=executor/materiality/classify.go range=379:419 lang=go exported=false byte_range=11957:13196
  sig=func ruleHardConstraintRelaxed(in Inputs) *Reason
  doc=---- rule 5: Hard constraint relaxation ----\n\n§18.1: "Any Constraint { hard: true } removed, or its bound loosened\n\n	(budget up, deadline later, quality min down, jurisdiction set\n	widened)."\n\nComparison strategy:\n  - Build a map of original hard constraints keyed by (Type, identifier).\n  - For each candidate constraint, find the matching original and check\n    whether the bound moved in the loosening direction.\n  - For each original hard constraint missing from candidate, fire.
EDGES
  ^defines=matrix/executor/materiality/classify.go

NODE id=matrix/executor/materiality.ruleNewSubAgent kind=func
  digest=b3:e46400670fb2fda965db3c1b412027869c35d08090b68fdd9fb9ee8d082f65e7 file=executor/materiality/classify.go range=218:245 lang=go exported=false byte_range=7180:8042
  sig=func ruleNewSubAgent(in Inputs) *Reason
  doc=---- rule 2: New sub-agent ----\n\n§18.1: "Any intent.dispatch to an AgentRef not present in the\n\n	originally-accepted plan."\n\nWe approximate intent.dispatch presence via NodeSubDispatch.AgentRef\nin the PlanTree (the plan-time declaration of what dispatches will\nfire). A run-time dispatch to an AgentRef NOT pre-declared in the\noriginally-accepted plan would be caught here when the corrected\nplan is the input.
EDGES
  ^defines=matrix/executor/materiality/classify.go

NODE id=matrix/executor/materiality.ruleNewToolNamespace kind=func
  digest=b3:5975579c13e0cf05b91acefd641b105d1d602d77512518577cb26af88f44edd9 file=executor/materiality/classify.go range=320:351 lang=go exported=false byte_range=10282:11334
  sig=func ruleNewToolNamespace(in Inputs) *Reason
  doc=---- rule 4: New tool namespace ----\n\n§18.1: "A ToolRef whose namespace (tools/<ns>/*) was not in the original\n\n	plan. Same-namespace swaps are non-material."\n\nWe parse every ToolRef via tool.ParseToolURI (which already enforces\nthe Q17 split into Provider/Server). The "namespace" is:\n\n  - For MCP tools: (Provider, Server). Two MCP tools differing only\n    in Name are same-namespace; differing in Server are different.\n  - For native tools: Provider alone (one of the 8 S6 namespaces).\n\nUnparseable tool refs surface as a material reason since they would\nfail validation anyway.
EDGES
  ^defines=matrix/executor/materiality/classify.go

NODE id=matrix/executor/materiality.ruleScopeExpansion kind=func
  digest=b3:706cece6b2fcec469028657489e054c2a8097cf994f4393106f5cb1074ed08e4 file=executor/materiality/classify.go range=273:308 lang=go exported=false byte_range=8724:9969
  sig=func ruleScopeExpansion(in Inputs) *Reason
  doc=---- rule 3: Scope expansion ----\n\n§18.1: "Any CortexScope.include or query widening passed to an existing\n\n	sub-agent vs. the originally-accepted scope."\n\nWe detect ScopeURI added/changed for an existing AgentRef. Full\nCortexScope set-difference would require resolving the Scope record\nfrom cortex (CortexScope lives in cortex/scope/ per Phase 10).\nv1 lock: signature-level change is the trigger; deeper Scope.include\ndiffing is deferred to v1.1 when the materiality classifier can take\nthe resolved Scope records as inputs.
EDGES
  ^defines=matrix/executor/materiality/classify.go

NODE id=matrix/executor/materiality.ruleSuccessCriteriaChanged kind=func
  digest=b3:dc1d1c1dd0be93d7cec07c16ae085879526ace74e185d6b57802b7d51ea2e3f1 file=executor/materiality/classify.go range=530:571 lang=go exported=false byte_range=16507:17739
  sig=func ruleSuccessCriteriaChanged(in Inputs) *Reason
  doc=---- rule 6: Success criteria change ----\n\n§18.1: "Any add, remove, or weakening of a Predicate in\n\n	frame.success_criteria."\n\nv1 detection: signature-level (Type + key identifying field). Any add\nor remove fires. Weakening of identically-typed predicates is hard to\nreason about without semantic understanding of the predicate's\ninternal data; we treat parameter changes on the same (Type, key)\npair as a material reason.
EDGES
  ^defines=matrix/executor/materiality/classify.go

NODE id=matrix/executor/materiality.stringDifference kind=func
  digest=b3:bd1b21b4e3bd7334424d133876a22342752716f065f834ed14831756c6736017 file=executor/materiality/classify.go range=515:528 lang=go exported=false byte_range=16218:16505
  sig=func stringDifference(a, b []string) []string
  doc=stringDifference returns elements present in a but not in b.
EDGES
  ^defines=matrix/executor/materiality/classify.go

NODE id=matrix/executor/materiality.walkPlanNodes kind=func
  digest=b3:84f0efa040a3fdf80aceb5c73610188ccb380db56e410af7819bf6a600723f0b file=executor/materiality/classify.go range=260:271 lang=go exported=false byte_range=8366:8722
  sig=func walkPlanNodes(n *ir.PlanNode, fn func(*ir.PlanNode))
  doc=walkPlanNodes is a simple recursive visitor over the plan tree.\nNot exported because callers should compose with the kind-specific\nextractors below rather than re-implement traversal.
EDGES
  ^defines=matrix/executor/materiality/classify.go

