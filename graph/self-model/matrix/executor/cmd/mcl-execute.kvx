  ^defines=matrix/executor/cmd/mcl-execute/router_metrics.go

NODE id=matrix/executor/cmd/mcl-execute.routerMetrics.Flush kind=method
  digest=b3:b30e8b5eb4fe1f766779a8743b5415fa1d3beec11b19bca6b462088c66ed5f4c file=executor/cmd/mcl-execute/router_metrics.go range=332:350 lang=go exported=true byte_range=10597:11291
  sig=func (m *routerMetrics) Flush(t *transcript) int
  doc=Flush emits a single router.histogram audit event into the\ntranscript carrying the current snapshot. Safe to call repeatedly;\ncounters are NOT reset (Prometheus convention: counters are\nmonotonic; resets only happen on process restart). Returns the\ntotal number of routes flushed for caller-side smoke logging.
EDGES
  ^contains=matrix/executor/cmd/mcl-execute.routerMetrics
  ^defines=matrix/executor/cmd/mcl-execute/router_metrics.go

