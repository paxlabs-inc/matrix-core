  digest=b3:186760ed31b222aaf5588e947f805d9506cdb6cee9e4a91ee29223e304f3f440 file=executor/cmd/mcl-execute/daemon_shell_routes.go range=547:572 lang=go exported=false byte_range=17009:17730
  sig=func forwardSignal(cmd *exec.Cmd, name string)
  doc=forwardSignal maps a string signal name to syscall.Signal and sends\nit to the child's process group. Recognized: INT, TERM, QUIT, HUP.\nUnknown names are silently ignored — no panic, no error frame —\nbecause the SPA might send vendor-specific names that future versions\nadd support for.
