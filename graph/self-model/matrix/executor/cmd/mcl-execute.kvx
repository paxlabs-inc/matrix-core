NODE id=matrix/executor/cmd/mcl-execute.friendlyFailLine kind=func
  digest=b3:f1afb862631862ce278170b3e0a1e9877bab6a1348f6bafd2ffdbebb4ae8d922 file=executor/cmd/mcl-execute/daemon_pipeline.go range=758:775 lang=go exported=false byte_range=32873:34006
  sig=func friendlyFailLine(reason string) string
  doc=friendlyFailLine maps a terminal reason code to a plain, jargon-free\nsentence for the user. The raw error (with the underlying provider\nmessage) stays on messageResult.Error for operators; the user never\nsees a 429 body or an internal reason token.
EDGES
  ^defines=matrix/executor/cmd/mcl-execute/daemon_pipeline.go

NODE id=matrix/executor/cmd/mcl-execute.friendlyName kind=func
  digest=b3:d8541eeaa1093c3cdbd92aecdcb6196e8587dc0bdb99895d0e063843c744c976 file=executor/cmd/mcl-execute/daemon_liaison.go range=713:742 lang=go exported=false byte_range=28105:28958
  sig=func friendlyName(raw string) string
  doc=friendlyName derives a warm first name from whatever display label the\nclient passed (a full name or an email), and rejects machine\nidentifiers (DIDs, URIs, UUIDs, long hex) so the Liaison never greets\nsomeone as "matrix://agent/did:matrix:…". Mirrors the client's\nfirstName() helper so the two stay consistent. Returns "" when nothing\nhuman-friendly is available.
EDGES
  ^defines=matrix/executor/cmd/mcl-execute/daemon_liaison.go

