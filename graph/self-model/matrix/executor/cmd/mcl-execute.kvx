NODE id=matrix/executor/cmd/mcl-execute.parsePaxeerCapFlag kind=func
  digest=b3:8e62f86472ee0666c4efe9cccb6d7c67a9033772ab9f6bd393f129212b412bbd file=executor/cmd/mcl-execute/paxeer_spend_policy.go range=617:649 lang=go exported=false byte_range=22328:23229
  sig=func parsePaxeerCapFlag(raw string) (*big.Int, bool)
  doc=parsePaxeerCapFlag interprets a cap-wei flag value:\n\n	""    → (nil, false)  — leave default in place\n	"-1"  → (nil, true)   — explicit disable for this layer\n	"0"   → (zero, true)  — explicit disable (Sign()==0 short-circuits)\n	"123" → (big.Int(123), true)\n\nBad input is treated as "leave default" (false) so a typo can't\nsilently weaken the policy.
EDGES
  ^defines=matrix/executor/cmd/mcl-execute/paxeer_spend_policy.go

NODE id=matrix/executor/cmd/mcl-execute.parsePorcelainV2 kind=func
  digest=b3:bd79d2c5322397ed0ffa1dd1253c7775a46b933114933d82e94e923bc447e968 file=executor/cmd/mcl-execute/daemon_git_routes.go range=209:313 lang=go exported=false byte_range=6575:10076
  sig=func parsePorcelainV2(repo, out string) gitStatusResponse
  doc=parsePorcelainV2 parses git status --porcelain=v2 -z output into a\ngitStatusResponse. The format is documented at\nhttps://git-scm.com/docs/git-status#_porcelain_format_version_2 ;\nbriefly:\n\n	# branch.oid <commit> | (initial)\n	# branch.head <branch> | (detached)\n	# branch.upstream <upstream>\n	# branch.ab +<ahead> -<behind>\n	1 <X><Y> <sub> <mH> <mI> <mW> <hH> <hI> <path>     (tracked)\n	2 <X><Y> <sub> <mH> <mI> <mW> <hH> <hI> <X><score> <path>\\0<orig> (rename/copy)\n	u <X><Y> <sub> <m1> <m2> <m3> <mW> <h1> <h2> <h3> <path>  (unmerged)\n	? <path>                                            (untracked)\n	! <path>                                            (ignored)\n\n`-z` separator is NUL between records (and additionally between path\nand orig path inside type-2 records).
EDGES
  ^defines=matrix/executor/cmd/mcl-execute/daemon_git_routes.go

