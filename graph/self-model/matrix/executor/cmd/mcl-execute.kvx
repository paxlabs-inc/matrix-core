NODE id=matrix/executor/cmd/mcl-execute.collectPlanAnswer kind=func
  digest=b3:e79a1934ed4f67af0e1791183258b11a35c2a714e5914bd39294e02b16d77b67 file=executor/cmd/mcl-execute/daemon_pipeline.go range=94:114 lang=go exported=false byte_range=4176:4935
