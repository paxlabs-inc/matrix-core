  doc=renderConversationHistory formats recent turns into a compact block\nfor an LLM prompt (triage / closing answer). Returns "" when empty.
EDGES
  ^defines=matrix/executor/cmd/mcl-execute/daemon_conversation.go

NODE id=matrix/executor/cmd/mcl-execute.resolveAndCheckRead kind=func
  digest=b3:ab1685998a574b1696d89e8071a53902e466d138e46d5e2b5beacaea2697f051 file=executor/cmd/mcl-execute/daemon_fs_routes.go range=375:393 lang=go exported=false byte_range=12532:13362
  sig=func resolveAndCheckRead(p *ForgeFSPolicy, path string) (string, error)
  doc=resolveAndCheckRead normalises + symlink-resolves the path, then calls\nthe policy CheckRead gate. The symlink resolution step is critical:\nwithout it a symlink at /root/matrix/foo → /etc/passwd would 200 the\nread because the textual prefix matches the allowlist.\n\nFor non-existent paths (the common write-new-file case) symlink\nresolution falls back to filepath.Clean of the input — there's no\nlink to follow yet, and the caller's CheckWrite enforces the policy\nagainst the textual path.
EDGES
  ^defines=matrix/executor/cmd/mcl-execute/daemon_fs_routes.go

NODE id=matrix/executor/cmd/mcl-execute.resolveAndCheckWrite kind=func
  digest=b3:f2f7e7350957b5824b110fb487a389be79fa8ceda34f468d88fc005f642de05f file=executor/cmd/mcl-execute/daemon_fs_routes.go range=395:425 lang=go exported=false byte_range=13364:14626
  sig=func resolveAndCheckWrite(p *ForgeFSPolicy, path string) (string, error)
  doc=resolveAndCheckWrite mirrors resolveAndCheckRead but applies CheckWrite.\nFor non-existent paths the policy check runs against the cleaned textual\npath AND, additionally, against the parent directory (so writing\n/root/matrix/cortex/store/new-file is rejected because the parent is\nin DenyPrefixes even though the file itself doesn't yet exist).
EDGES
  ^defines=matrix/executor/cmd/mcl-execute/daemon_fs_routes.go

NODE id=matrix/executor/cmd/mcl-execute.resolveHeaderEnv kind=func
  digest=b3:d18713fcf8d511c22b31c86fcb669b7af60bbbe0033b425e5c6ed916f2392a8c file=executor/cmd/mcl-execute/infra.go range=222:235 lang=go exported=false byte_range=6210:6551
  sig=func resolveHeaderEnv(in map[string]string) map[string]string
EDGES
  ^defines=matrix/executor/cmd/mcl-execute/infra.go

NODE id=matrix/executor/cmd/mcl-execute.resolveOutputRefs kind=func
  digest=b3:55da6b87e563951d56bddc5e22695c85b98e40371a4bbb3cc9471beb05396240 file=executor/cmd/mcl-execute/step_handler.go range=492:511 lang=go exported=false byte_range=17243:18129
  sig=func resolveOutputRefs(val string, outputs map[string]string) string
  doc=resolveOutputRefs replaces every ${<nodeID>.output} reference in val\nwith the upstream node's actual recorded output. An unresolved\nreference (node missing or produced no output) is replaced with an\nexplicit marker rather than left as a literal placeholder, so the\nmodel is told the data is unavailable instead of silently inventing it.
EDGES
  ^defines=matrix/executor/cmd/mcl-execute/step_handler.go

NODE id=matrix/executor/cmd/mcl-execute.resolveShellCwd kind=func
  digest=b3:dbd00b06fe599094df170492c6d867bfe42f8d74cb88bd4443cefd22eb95740e file=executor/cmd/mcl-execute/daemon_shell_routes.go range=421:448 lang=go exported=false byte_range=13912:14729
  sig=func resolveShellCwd(cfg *ForgeShellConfig, cwd string) (string, error)
  doc=resolveShellCwd cleans + validates the cwd argument. Empty falls back\nto AllowRoots[0]. Returns an error when the resolved path is not\nunder any AllowRoot.
EDGES
  ^defines=matrix/executor/cmd/mcl-execute/daemon_shell_routes.go

