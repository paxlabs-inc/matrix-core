  digest=b3:567869b17ef3984523487fd54f8e18b0e14f594124198b6d9f5fbd17e40aa413 file=executor/cmd/mcl-execute/forge_git_policy.go range=107:136 lang=go exported=true byte_range=4192:5275
  sig=func DefaultGitOpsPolicy() *GitOpsPolicy
  doc=DefaultGitOpsPolicy returns the Phase 3 self-maintenance posture.\n\n	Repo               = /root/matrix\n	AllowedVerbs       = [status, diff, branch_create, branch_list,\n	                      branch_delete, merge]\n	DeniedVerbs        = [push, force_push, reset_hard, clean]\n	ProtectedRefs      = [main, master, HEAD]\n	DefaultFastForward = true\n	MaxDiffBytes       = 4 MiB\n\nThe agent self-maintains on feature branches (forge/<intent_id>)\nper agents/forge.json convention; merges to main go fast-forward\nonly by default so the human review surface stays visible (a\nnon-ff merge commit hides the per-step transcript).
EDGES
  ^defines=matrix/executor/cmd/mcl-execute/forge_git_policy.go

NODE id=matrix/executor/cmd/mcl-execute.DefaultPaxeerSpendPolicy kind=func
  digest=b3:29e00398e365a104b94eaab19880039e1fe32656bcd195c897b0e556878d5597 file=executor/cmd/mcl-execute/paxeer_spend_policy.go range=166:217 lang=go exported=true byte_range=6696:8890
  sig=func DefaultPaxeerSpendPolicy() *PaxeerSpendPolicy
  doc=DefaultPaxeerSpendPolicy returns the production gate set.\n\nCaps:\n\n	PerCallCapWei   = 1 PAX  (1e18 wei) — single-call upper bound\n	AggregateCapWei = 5 PAX  (5e18 wei) — sum across the whole plan\n\nThese are conservative defaults that gate any plan above pocket-\nchange; operators tune them per-deployment via env vars consumed by\nthe daemon's flag layer (see daemon_cmd.go: -paxeer-cap-wei /\n-paxeer-aggregate-cap-wei).\n\nTool → value-arg mapping:\n\n	transfer        → amount_wei | amount | value\n	approve         → amount_wei | amount  (ERC-20 allowance set)\n	stream_open     → cap_wei | cap | total | total_wei\n	schedule_job    → deposit_wei | deposit | value_wei | value\n	delegate        → amount_wei | amount\n	redelegate      → amount_wei | amount\n	contract_write  → value_wei | value
EDGES
  ^defines=matrix/executor/cmd/mcl-execute/paxeer_spend_policy.go

