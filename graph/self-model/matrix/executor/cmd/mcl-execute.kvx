NODE id=matrix/executor/cmd/mcl-execute.fsWriteRequest kind=type
  digest=b3:b97a60f0acde8650620f1f73cbdf359a76ff952b9f05d858cff1e77f61ebf020 file=executor/cmd/mcl-execute/daemon_fs_routes.go range=72:84 lang=go exported=false byte_range=2657:3279
  sig=type fsWriteRequest struct {\n	Path		string	`json:"path"`\n	Content		string	`json:"content"`\n	Encoding	string	`json:"encoding,omitempty"`\n	PrevSHA256	string	`json:"prev_sha256,omitempty"`\n	CreateDirs	bool	`json:"create_dirs,omitempty"`\n}
  doc=fsWriteRequest is the POST /fs/write body. Encoding defaults to utf8;\nbase64 supported for future binary uploads. PrevSHA256, when non-empty,\ngates the write on optimistic-concurrency: if the on-disk file's hash\ndiffers, the route returns 409 Conflict so the SPA can re-fetch and\nmerge. Empty PrevSHA256 disables the check (initial create, brand-new\nfiles).
