NODE id=matrix/executor/cmd/mcl-execute.isSalientEvent kind=func
  digest=b3:8f122152b8983479f7d366ac588ec6f54effc2888aee3619f4e12ef2b0219ed5 file=executor/cmd/mcl-execute/daemon_liaison.go range=608:618 lang=go exported=false byte_range=25064:25479
  sig=func isSalientEvent(eventType string) bool
  doc=isSalientEvent reports whether an event is genuine news the user should\nalways hear about (an approval request/decision, or a completed on-chain\naction) — as opposed to generic internal progress that collapses to one\n"we're working" update.
EDGES
  ^defines=matrix/executor/cmd/mcl-execute/daemon_liaison.go

NODE id=matrix/executor/cmd/mcl-execute.isUnderPrefix kind=func
  digest=b3:b1d47b18dda609df9a09ae7c44899f218c4b28bb1700ae51a2e497acb0f7c59f file=executor/cmd/mcl-execute/forge_policy.go range=179:193 lang=go exported=false byte_range=6427:7011
  sig=func isUnderPrefix(path, prefix string) bool
  doc=isUnderPrefix reports whether `path` equals `prefix` or sits under it\nin the filesystem sense (a separator immediately follows). Path-string\nequality short-circuit avoids false positives for sibling directories\nthat share a textual prefix (e.g. "/var/foo" vs "/var/foobar").\n\nBoth arguments are expected to be already normalized via filepath.Clean.
EDGES
  ^defines=matrix/executor/cmd/mcl-execute/forge_policy.go

NODE id=matrix/executor/cmd/mcl-execute.isValidationError kind=func
  digest=b3:a6cba63f7b07f0d152d6ab5a7639b4c776b76292b57cc83274f29146b6abf583 file=executor/cmd/mcl-execute/daemon_memory_write.go range=392:406 lang=go exported=false byte_range=12184:12745
  sig=func isValidationError(err error) bool
  doc=isValidationError reports whether an error from cortex.Write is\ncaller-fixable (missing required fields, bad enum values, etc.) vs.\nserver-side (Pebble I/O, encoding bugs). The memory package returns\nerrors prefixed "validate" for the caller-fixable class.
EDGES
  ^defines=matrix/executor/cmd/mcl-execute/daemon_memory_write.go

NODE id=matrix/executor/cmd/mcl-execute.itoa kind=func
  digest=b3:d80fd20643f45cfdf68786c72e0885e5db3e880d9e40996a428dcdb5ef2699c8 file=executor/cmd/mcl-execute/daemon_metrics.go range=121:146 lang=go exported=false byte_range=4653:5149
  sig=func itoa(n int64) string
  doc=itoa / utoa: tiny no-alloc int-to-string helpers so /metrics\ndoesn't pull strconv into the hot path. The Prometheus exposition\nspec accepts decimal integers + IEEE 754 floats in standard\nnotation; we only need decimal here.
EDGES
  ^defines=matrix/executor/cmd/mcl-execute/daemon_metrics.go

