NODE id=matrix/executor/cmd/mcl-execute.genericProgressKey kind=const
  digest=b3:25705d7a91d458ff89e09c6d513a863c9d6b7f3c3a3a24b4ea1fde032017452b file=executor/cmd/mcl-execute/daemon_liaison.go range=253:260 lang=go exported=false byte_range=11395:11909
  sig=untyped string
  doc=genericProgressKey collapses every generic "we're working" milestone\n(request received, plan locked in, carrying out the plan, producing\noutput, etc.) onto ONE dedup key, so the narrator gives a single\nconfident update instead of repeating itself once per internal step —\nthe "buggy/cheap" feeling reported by testers. Genuinely salient events\n(approvals, on-chain actions) are deduped on their own text and still\nget their own turn.
EDGES
  ^defines=matrix/executor/cmd/mcl-execute/daemon_liaison.go

