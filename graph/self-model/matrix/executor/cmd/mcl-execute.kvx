NODE id=matrix/executor/cmd/mcl-execute.daemonState.handleEventsFiltered kind=method
  digest=b3:ffedc5b63f59780fbf530c3ba4b33bfca118ba77d90be7f33ac20093001977b8 file=executor/cmd/mcl-execute/daemon_events.go range=30:106 lang=go exported=false byte_range=800:2921
  sig=func (d *daemonState) handleEventsFiltered(w http.ResponseWriter, r *http.Request)
  doc=handleEventsFiltered serves GET /events with optional filtering.\n\nFilter precedence:\n\n	?intent_id=<id>      restrict to events whose Fields.intent_id matches\n	?phase=<phase>       restrict to events from a single phase\n	                     (boot|compile|synth|walk|attest|envelope|\n	                      lifecycle|infra|http|snapshot)\n	?since_seq=<int>     skip events with seq < this (pagination)\n\nAll filters compose; the empty-string default disables a filter.
EDGES
  ^contains=matrix/executor/cmd/mcl-execute.daemonState
  ^defines=matrix/executor/cmd/mcl-execute/daemon_events.go

NODE id=matrix/executor/cmd/mcl-execute.daemonState.handleEventsReplay kind=method
  digest=b3:0d0c01e24e94409106755aadedaa6aa16f3a43c96e33cde85ba28ec4d469d03c file=executor/cmd/mcl-execute/daemon_events.go range=108:180 lang=go exported=false byte_range=2923:5110
  sig=func (d *daemonState) handleEventsReplay(w http.ResponseWriter, r *http.Request)
  doc=handleEventsReplay serves GET /events/replay/:intent_id.\n\nRe-emits every event from the historical transcript JSONL for one\nintent in chronological order. Useful for clients that joined the\nSSE feed mid-flight and want to backfill.\n\nStreams the same SSE wire format as live /events so the same client\nparser works without branching on shape.
EDGES
  ^contains=matrix/executor/cmd/mcl-execute.daemonState
  ^defines=matrix/executor/cmd/mcl-execute/daemon_events.go

