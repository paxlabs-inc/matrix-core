  digest=b3:22679eef1d59ce6615b2483f2195c967a877c5b220ce4b79b4c476c49c9730f8 file=executor/cmd/mcl-execute/identity.go range=21:38 lang=go exported=false byte_range=355:1065
  sig=type actorIdentity struct {\n	DID		string\n	Public		ed25519.PublicKey\n	Private		ed25519.PrivateKey\n	UserURI		string	// matrix://user/<did>\n	AgentURI	string	// matrix://agent/<did>\n}
