NODE id=matrix/executor/cmd/mcl-execute.routerMetrics.AddCost kind=method
  digest=b3:711ff5072f6ec36e088a59bf1a7d7f95591a57f9a8647a2f0665819c6f295434 file=executor/cmd/mcl-execute/router_metrics.go range=229:253 lang=go exported=true byte_range=7795:8512
  sig=func (m *routerMetrics) AddCost(key costMetricKey, costPax string)
  doc=AddCost folds one PAX-denominated cost (decimal-string, e.g.\n"0.000123000000") into the cumulative counter keyed on key. Empty\nor "0" inputs are no-ops so /metrics never carries phantom rows\nfor BYO calls that bypass the gateway. Concurrency-safe via mu.\n\nSess#32 ambient-architect cost telemetry (plan §5.11 / §5.15).
EDGES
  ^contains=matrix/executor/cmd/mcl-execute.routerMetrics
  ^defines=matrix/executor/cmd/mcl-execute/router_metrics.go

