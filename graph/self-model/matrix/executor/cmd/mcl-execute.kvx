NODE id=matrix/executor/cmd/mcl-execute.deltaFlushBytes kind=const
  digest=b3:fe88e4c0298984bfbc0659c72c8eee1c5d78b0962f54a1a27d285134e265ada9 file=executor/cmd/mcl-execute/step_handler.go range=342:348 lang=go exported=false byte_range=11999:12434
  sig=untyped int
  doc=deltaFlushBytes is the byte-count threshold that triggers an\nimmediate step.text.delta emission. Tuned so a typical 800-token\nstep (~3.2 KB) yields ~16 events instead of one-per-token, which\nkeeps the SSE broker's per-subscriber 256-event buffer comfortably\nunder capacity for the brainstorming hot path (8 steps × 16 deltas\n+ per-step text/decode + ~50 walker bookkeeping events ~= 200).
EDGES
  ^defines=matrix/executor/cmd/mcl-execute/step_handler.go

