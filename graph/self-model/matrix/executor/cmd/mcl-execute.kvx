NODE id=matrix/executor/cmd/mcl-execute.emitChat kind=func
  digest=b3:d7c9b71f366b84029fad06bedf99572f2ad69581112d51be6b43341bd1e80983 file=executor/cmd/mcl-execute/daemon_liaison.go range=156:173 lang=go exported=false byte_range=6184:6945
  sig=func emitChat(t *transcript, role, conversationID, intentID, text, reasoning string)
  doc=emitChat writes a chat.* event to the per-intent transcript (JSONL +\nSSE broker). role is "user" | "assistant". conversationID + intentID\nare stamped so the client can thread + filter. reasoning, when present,\nis the model's chain-of-thought carried in a SEPARATE field so the UI\nrenders it as a labeled "reasoning" disclosure, never as the answer.\nThis is the ONLY thing the Liaison persists.
EDGES
  ^defines=matrix/executor/cmd/mcl-execute/daemon_liaison.go

NODE id=matrix/executor/cmd/mcl-execute.emitChatFinal kind=func
  digest=b3:9975412ae6556c9eb05ec36abad676489a0c749ad20010496cf084aa7f729ef3 file=executor/cmd/mcl-execute/daemon_liaison.go range=175:192 lang=go exported=false byte_range=6947:7636
  sig=func emitChatFinal(t *transcript, role, conversationID, intentID, text, reasoning string)
  doc=emitChatFinal is emitChat for the Liaison's closing turn (the final\nanswer or failure explanation composed AFTER the run's terminal event).\nIt stamps final:true so the client closes the stream on THIS turn and\nnot on a stale trailing progress turn that can land just after the\nterminal event.
EDGES
  ^defines=matrix/executor/cmd/mcl-execute/daemon_liaison.go

