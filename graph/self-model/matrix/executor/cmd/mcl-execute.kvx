NODE id=matrix/executor/cmd/mcl-execute.liaisonHeartbeat kind=const
  digest=b3:a32a1f20c6e70b1abf06cc6f1f87d60448ffb8ae2d39591177127989f840f5f6 file=executor/cmd/mcl-execute/daemon_liaison.go range=247:250 lang=go exported=false byte_range=11177:11391
  sig=time.Duration
  doc=liaisonHeartbeat is the minimum gap before a generic "still\nworking" progress update may repeat, so a long run never goes\nsilent yet never spams near-identical turns.
EDGES
  ^defines=matrix/executor/cmd/mcl-execute/daemon_liaison.go

NODE id=matrix/executor/cmd/mcl-execute.liaisonIdentity kind=var
  digest=b3:67457c0520099a57598847d05869771d830bd27df110dbdd95d923e90f791f73 file=executor/cmd/mcl-execute/daemon_liaison.go range=200:208 lang=go exported=false byte_range=7877:8542
  sig=string
  doc=liaisonIdentity is the agent's first-person identity prose prepended to\nevery Liaison prompt. It is DERIVED from the shared, faculty-neutral\nself-model (matrix/cortex/self.Persona) rather than hand-written here, so the\nexecution faculty and the conversation faculty speak with one reconciled\nself-description that cannot disagree with the actual self-model\n(self-model req.7.1). The persona is the identity facet only — machinery-free\n(req.7.2) — so it still answers "what are you / what is Matrix / what is\nPaxeer" without exposing internal structure.
EDGES
  ^defines=matrix/executor/cmd/mcl-execute/daemon_liaison.go

