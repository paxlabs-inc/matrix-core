  digest=b3:159c633118ce486ff878e1a66de7d3c91e6b171e2e8ed68757c0fa6e7e047ef4 file=executor/cmd/mcl-execute/step_handler.go range=45:78 lang=go exported=false byte_range=1390:2734
  sig=type llmStepHandler struct {\n	registry	*llm.ModelRegistry\n	overrideModel	string\n	overrideBaseURL	string\n	overrideSeed	int64\n\n	// --- sess#32 ambient-architect MatrixGateway routing (plan §5.16) ---\n	// Empty gatewayURL preserves the legacy direct-provider posture.\n	gatewayURL	string\n	actorDID	string\n	intentID	string\n	goalID		string\n	costHook	func(http.Header)\n\n	clientsMu	sync.Mutex\n	clients		map[llm.RouteKey]interpreter.LLM\n\n	skillURI	string\n	skillMD		[]byte\n	t		*transcript\n}
  doc=llmStepHandler implements runtime.StepHandler by calling the executor\nLLM with a step-specific prompt. SKILL.md body is folded into the\nsystem message so the executor model sees the per-skill rubric on\nevery step dispatch (matrix.kvx invariant 2026-05-24 sess#22c line 828:\n"SKILL.md = prose body (executor-LLM consumer)").\n\nSession 31b (model router · P2) upgrade: the handler now resolves a\nper-step llm.Client from llm.ModelRegistry using node.Step.Kind as\nthe routing dimension. Clients are lazy-cached per llm.RouteKey so\nthe brainstorming hot path (8 sequential reason-kind decodes) only\nbuilds one client. Override fields preserve the prior CLI semantics:\n--model on mcl-execute pins every step to that model, --base-url\ntargets a single proxy endpoint, --seed pins the seed across kinds.
EDGES
  contains=matrix/executor/cmd/mcl-execute.llmStepHandler#actorDID,matrix/executor/cmd/mcl-execute.llmStepHandler#clients,matrix/executor/cmd/mcl-execute.llmStepHandler#clientsMu,matrix/executor/cmd/mcl-execute.llmStepHandler#costHook,matrix/executor/cmd/mcl-execute.llmStepHandler#gatewayURL,matrix/executor/cmd/mcl-execute.llmStepHandler#goalID,matrix/executor/cmd/mcl-execute.llmStepHandler#intentID,matrix/executor/cmd/mcl-execute.llmStepHandler#overrideBaseURL,matrix/executor/cmd/mcl-execute.llmStepHandler#overrideModel,matrix/executor/cmd/mcl-execute.llmStepHandler#overrideSeed,matrix/executor/cmd/mcl-execute.llmStepHandler#registry,matrix/executor/cmd/mcl-execute.llmStepHandler#skillMD,matrix/executor/cmd/mcl-execute.llmStepHandler#skillURI,matrix/executor/cmd/mcl-execute.llmStepHandler#t,matrix/executor/cmd/mcl-execute.llmStepHandler.HandleStep,matrix/executor/cmd/mcl-execute.llmStepHandler.buildSystem,matrix/executor/cmd/mcl-execute.llmStepHandler.buildUser,matrix/executor/cmd/mcl-execute.llmStepHandler.cfgFor,matrix/executor/cmd/mcl-execute.llmStepHandler.clientFor,matrix/executor/cmd/mcl-execute.llmStepHandler.streamStep
  implements=matrix/executor/runtime.StepHandler
  ^defines=matrix/executor/cmd/mcl-execute/step_handler.go

