NODE id=matrix/executor/cmd/mcl-execute.routerMetrics.Observe kind=method
  digest=b3:a62018703c663429ae0e0497b38053fcbf5d9879dd4f391a69b232555599b6df file=executor/cmd/mcl-execute/router_metrics.go range=171:207 lang=go exported=true byte_range=6537:7458
  sig=func (m *routerMetrics) Observe(key routeMetricKey, ms int64, err error)
  doc=Observe records one routed-decode latency observation. err == nil\nmeans success; non-nil increments the per-route error counter\nalongside the histogram bucket so /metrics can report a clean\nerror-rate. ms < 0 is treated as 0 (defensive against clock skew /\nmonotonic-clock weirdness in CI under -race).
EDGES
  ^contains=matrix/executor/cmd/mcl-execute.routerMetrics
  ^defines=matrix/executor/cmd/mcl-execute/router_metrics.go

