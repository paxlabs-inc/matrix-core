NODE id=matrix/executor/cmd/mcl-execute.recordIntentCost kind=func
  digest=b3:8af84c44e3fb6347088a02ce92a5bc6bb1615823c936ca1f8a6789a0463442e0 file=executor/cmd/mcl-execute/intent_cost.go range=87:144 lang=go exported=false byte_range=3193:5182
  sig=func recordIntentCost(t *transcript, m *routerMetrics, h http.Header, meta intentCostMeta)
  doc=recordIntentCost is the daemon-side wrapper invoked from llm.Config\n.OnResponseHeaders. Reads the X-Matrix-Cost-Pax + spent/remain\nheaders off the upstream response, stamps an `intent.cost` event,\nand increments the Prometheus counter on routerMetrics.\n\nSafe to call when h is empty (BYO calls don't carry cost headers);\nthe function then no-ops without touching the transcript or the\nmetrics counter so the audit stream stays clean of zero-cost rows.
EDGES
  ^defines=matrix/executor/cmd/mcl-execute/intent_cost.go

NODE id=matrix/executor/cmd/mcl-execute.recordRouterDecision kind=func
  digest=b3:9beba44b97c0a6e29b1a5003352a06ef075d4519009f74ab2d224c7dad21f6ad file=executor/cmd/mcl-execute/router_metrics.go range=59:83 lang=go exported=false byte_range=2350:3031
  sig=func recordRouterDecision(t *transcript, d routerDecision)
  doc=recordRouterDecision emits a router.decision audit event into the\ntranscript. Idempotent + non-fatal: a nil transcript silently\ndrops the event so test code-paths that don't wire a transcript\nstay simple.
EDGES
  ^defines=matrix/executor/cmd/mcl-execute/router_metrics.go

