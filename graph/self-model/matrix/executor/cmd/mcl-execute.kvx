NODE id=matrix/executor/cmd/mcl-execute.plannerDecodeTimeout kind=const
  digest=b3:0d31f37789727d7e128c49ab3009d18d37ee8f22c692358e90e7ff873c42d9c7 file=executor/cmd/mcl-execute/synthesize.go range=25:32 lang=go exported=false byte_range=456:1024
  sig=time.Duration
  doc=plannerDecodeTimeout is the per-round HTTP ceiling for the planner LLM\ncall. Plan synthesis is the hardest tier and runs on a high-capability\nfrontier model; emitting a full plan_tree@1 (often after a long internal\nreasoning pass) routinely needs more than the llm library's 90s default,\nespecially under gateway load. A too-tight ceiling is what surfaced as the\nrepeating "context deadline exceeded" synthesis failure. This budget bounds\na SINGLE decode round (synthesize retries MaxRetry+1 rounds).
EDGES
  ^defines=matrix/executor/cmd/mcl-execute/synthesize.go

