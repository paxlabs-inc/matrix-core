NODE id=matrix/executor/cmd/mcl-execute.PaxeerSpendPolicy.Evaluate kind=method
  digest=b3:cf80096e178f70cf59ecf87ec47408d6b1e75537b3350cde85512bd7727f8e9b file=executor/cmd/mcl-execute/paxeer_spend_policy.go range=234:297 lang=go exported=true byte_range=9325:11210
  sig=func (p *PaxeerSpendPolicy) Evaluate(toolRef string, args map[string]string) SpendEvaluation
  doc=Evaluate gates a single tool call against the per-call cap. Returns\nSpendAllow with ValueWei=nil for non-monetary writes (so callers can\nskip aggregate accumulation cleanly). Pure: no I/O, no state mutation.
EDGES
  ^contains=matrix/executor/cmd/mcl-execute.PaxeerSpendPolicy
  ^defines=matrix/executor/cmd/mcl-execute/paxeer_spend_policy.go

NODE id=matrix/executor/cmd/mcl-execute.PaxeerSpendPolicy.EvaluateAggregate kind=method
  digest=b3:bdae95721ad7e465eb4faad3a3382a04751f210d32826ded880d554621dbbca2 file=executor/cmd/mcl-execute/paxeer_spend_policy.go range=299:331 lang=go exported=true byte_range=11212:12403
  sig=func (p *PaxeerSpendPolicy) EvaluateAggregate(evs []SpendEvaluation) SpendEvaluation
  doc=EvaluateAggregate folds a sequence of per-call evaluations into a\nplan-level verdict. Returns the first hard verdict (deny > gate) or\nan aggregate-cap gate when the running total of allowed values\ncrosses AggregateCapWei. Per-call gates short-circuit the aggregate\ncheck because the per-call gate already triggers the same broker.
EDGES
  ^contains=matrix/executor/cmd/mcl-execute.PaxeerSpendPolicy
  ^defines=matrix/executor/cmd/mcl-execute/paxeer_spend_policy.go

NODE id=matrix/executor/cmd/mcl-execute.PaxeerSpendPolicy.EvaluateWithState kind=method
  digest=b3:58ead12b607ce3526fffb99efe5b33a1116a0cc315909b20874bb5f9e3742256 file=executor/cmd/mcl-execute/paxeer_spend_policy.go range=436:590 lang=go exported=true byte_range=16109:21593
  sig=func (p *PaxeerSpendPolicy) EvaluateWithState(toolRef string, args map[string]string, st *SpendPolicyState, now time.Time) SpendEvaluation
  doc=EvaluateWithState is the hardened evaluation entry point. It runs the\npure per-call Evaluate first, then layers on the stateful checks:\n  - circuit breaker: if tripped and cooldown not elapsed → SpendDeny\n    (fail CLOSED);\n  - per-recipient cap: if this call's recipient would exceed\n    PerRecipientCapWei → SpendGate + record violation;\n  - rolling-window budget: if the window total + this call would exceed\n    RollingWindowBudgetWei → SpendGate + record violation.\n\nAllowed calls record their spend into the per-recipient + rolling-window\nlogs. Cap-violations (gate/deny) are recorded as breaker violations.\n\n`now` is injected so tests can drive time deterministically; production\ncallers pass time.Now().
EDGES
  ^contains=matrix/executor/cmd/mcl-execute.PaxeerSpendPolicy
  ^defines=matrix/executor/cmd/mcl-execute/paxeer_spend_policy.go

NODE id=matrix/executor/cmd/mcl-execute.PaxeerSpendPolicy.NewState kind=method
  digest=b3:bdf96dc2f0ffe1c2c2ccc2843d8df65e07e0dd1e48f086b14878207647aaebe6 file=executor/cmd/mcl-execute/paxeer_spend_policy.go range=378:386 lang=go exported=true byte_range=14189:14578
  sig=func (p *PaxeerSpendPolicy) NewState() *SpendPolicyState
  doc=NewState returns a fresh, empty SpendPolicyState bound to this policy.\nThe daemon calls this once at boot and holds the returned pointer for the\nprocess lifetime. The state is sidecar: it is not referenced by any\nsnapshot/serialization path.
EDGES
  ^contains=matrix/executor/cmd/mcl-execute.PaxeerSpendPolicy
  ^defines=matrix/executor/cmd/mcl-execute/paxeer_spend_policy.go

