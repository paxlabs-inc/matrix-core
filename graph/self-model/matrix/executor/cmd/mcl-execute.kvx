NODE id=matrix/executor/cmd/mcl-execute.ValidateRefName kind=func
  digest=b3:68eb7688a747d7da497df21e970b6e830e437fee30b214d10bd5d02c91e21ca6 file=executor/cmd/mcl-execute/forge_git_policy.go range=209:241 lang=go exported=true byte_range=7466:8607
  sig=func ValidateRefName(ref string) error
  doc=ValidateRefName enforces a strict subset of git's ref naming rules.\nAllows: alphanumerics, '-', '_', '/', '.'. Rejects: leading '-'\n(could be parsed as a flag by `git branch`), '..' (path traversal),\nany whitespace, any shell metachar. Rejects refs longer than 240\nchars (git's hard cap is 255 minus the heads/tags/ prefix).
EDGES
  ^defines=matrix/executor/cmd/mcl-execute/forge_git_policy.go

