  ^defines=matrix/executor/cmd/mcl-execute/synthesize.go

NODE id=matrix/executor/cmd/mcl-execute.extractPlanJSON kind=func
  digest=b3:83c6d8f302af82c8f68af30d2519a76552f541a3d8d74bf1383fc97dbd775eac file=executor/cmd/mcl-execute/synthesize.go range=808:855 lang=go exported=false byte_range=29283:30692
  sig=func extractPlanJSON(raw string) string
  doc=extractPlanJSON pulls the plan_tree@1 JSON object out of a raw planner\nresponse. Frontier/reasoning planner models often wrap the JSON in\nchain-of-thought prose, <think> blocks, or markdown fences, so a naive\njson.Unmarshal of the whole string fails on the first prose character\n(the 'invalid character' synth.parse.error class). This drops inline\nreasoning tag blocks, strips fences, then returns the first balanced\ntop-level {...} object (brace-counted, string/escape aware). When no\nbalanced object is found it returns the input from the first '{' (or the\ncleaned string) so the caller's unmarshal still surfaces a useful error.
EDGES
  ^defines=matrix/executor/cmd/mcl-execute/synthesize.go

