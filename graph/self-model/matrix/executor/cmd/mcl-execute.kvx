NODE id=matrix/executor/cmd/mcl-execute.buildDaemonWalker kind=func
  digest=b3:2c25c2ee8e7af386eba6dacb1b33f901b0471be8363db38c6a50e369090d1211 file=executor/cmd/mcl-execute/daemon_pipeline.go range=622:726 lang=go exported=false byte_range=27304:31531
  sig=func buildDaemonWalker(d *daemonState, drv *lifecycleDriver, stream *envelopeStream, skill *runtime.LoadedSkill, t *transcript, intentID, goalID string, costAcc *intentCostAccumulator) (*runtime.Walker, error)
  doc=buildDaemonWalker mirrors walk_cmd.go:buildWalker but selects the\ngate handler dynamically: when d.gateBroker is wired (sess#27+),\ngates block on POST /intents/<id>/gates/<nid>/answer; otherwise\nthe legacy stdin-policy=approve handler auto-approves so sync-only\nCLI flows from sess#26 still pass.\n\nSub-dispatch is enabled iff daemonState.allowSubDispatch is true\n(Q6 v1 carve-out: same agent, in-process only; cross-agent +\nCortexScope Merkle proof handoff is v1.1).\n\ngoalID + costAcc are sess#32 ambient-architect plumbing (plan §5.11):\ngoalID stamps every gateway-routed step decode as X-Matrix-Goal-ID;\ncostAcc receives the per-call X-Matrix-Cost-Pax for the intent.
EDGES
  ^defines=matrix/executor/cmd/mcl-execute/daemon_pipeline.go

NODE id=matrix/executor/cmd/mcl-execute.buildDirectIntent kind=func
  digest=b3:0f725be32dd3e5e487a07269ad4ab46fd96e0c63e4efa47c8f682cc141fa1b44 file=executor/cmd/mcl-execute/daemon_gideon_pipeline.go range=276:343 lang=go exported=false byte_range=10516:12854
  sig=func buildDirectIntent(d *daemonState, req messageRequest, intentID, snapHash string) (*ir.Intent, []byte, string, error)
  doc=buildDirectIntent assembles a signed, content-addressed *ir.Intent\ndirectly from the request, bypassing the compiler. Scope (the typed\nobjects the intent operates on) is sourced from req.SlotValues — each\nkey/value becomes a Frame object so an operator (or the scheduler)\ncan pin hosts/services without a compile round-trip.\n\nVerb resolution: req.Verb when a valid D7 verb; otherwise the sensible\nops default "monitor". CompileMetadata is fully populated (with a\ndeterministic seed) so the intent is replay-verifiable exactly like a\ncompiled one — the only difference is there was no compiler LLM call.
EDGES
  ^defines=matrix/executor/cmd/mcl-execute/daemon_gideon_pipeline.go

NODE id=matrix/executor/cmd/mcl-execute.buildExecutionDigest kind=func
  digest=b3:7fffffe9d3b703f0b163203dbc7f910f9d1351511ea1bf0eaa4c95b7c3cd8e84 file=executor/cmd/mcl-execute/critique.go range=71:117 lang=go exported=false byte_range=3019:4547
  sig=func buildExecutionDigest(plan *ir.PlanTree) string
  doc=buildExecutionDigest renders the executed plan tree into a compact,\ndispatch-ordered transcript of what actually ran: each tool_call with its\nargs and (truncated) result, and each step with its (truncated) output. This\nis the ground-truth evidence the critic audits against the user's request —\nNOT the plan's intent, but what the walker actually produced (ResultText is\npopulated by runtime/walker.go for both tool calls and steps).
EDGES
  ^defines=matrix/executor/cmd/mcl-execute/critique.go

NODE id=matrix/executor/cmd/mcl-execute.buildIntent kind=func
  digest=b3:3f44192d9aec04f1233e6f0e7942fe5988327f9de175ca8379e6a2391729a7bd file=executor/cmd/mcl-execute/compile.go range=589:677 lang=go exported=false byte_range=20455:23103
  sig=func buildIntent(opts compileOpts, run *interpreter.RunResult, snapHash, modelID string) (*ir.Intent, error)
  doc=buildIntent converts an interpreter RunResult into a typed *ir.Intent.\nThe CompileMetadata fields are filled per D11.
EDGES
  ^defines=matrix/executor/cmd/mcl-execute/compile.go

NODE id=matrix/executor/cmd/mcl-execute.buildIntentSummary kind=func
  digest=b3:2c524c6c857514a090874f45e1bc7f57787b6452e62143a2e7465d9bfa15c67d file=executor/cmd/mcl-execute/daemon_intent_index.go range=248:384 lang=go exported=false byte_range=7555:11905
  sig=func buildIntentSummary(intentID, dir string) *intentSummary
  doc=buildIntentSummary scans a single intent dir and derives the typed\nsummary. Reads:\n\n  - All envelope filenames (cheap; dir read).\n  - The first intent-compiled envelope body (to extract verb,\n    skill_uri, intent_hash, prose).\n  - The terminal envelope body (intent-attest / intent-fail /\n    intent-cancel) for outcome + completed_at.\n\nSkips body parsing of plan.step / plan.output / envelope-signed\nrows since those are dispatch noise — their seq numbers contribute\nto envelope_count but not to summary fields.
EDGES
  ^defines=matrix/executor/cmd/mcl-execute/daemon_intent_index.go

NODE id=matrix/executor/cmd/mcl-execute.buildMemoryQuery kind=func
  digest=b3:768b8ef6375f5702cd6bace58cf31da5205ac4382e13399cca75262a95b46743 file=executor/cmd/mcl-execute/daemon_memory_routes.go range=385:406 lang=go exported=false byte_range=12205:13028
  sig=func buildMemoryQuery(r *http.Request, limit int, d *daemonState) (query.Query, error)
  doc=buildMemoryQuery translates URL params into a query.Query.
EDGES
  ^defines=matrix/executor/cmd/mcl-execute/daemon_memory_routes.go

NODE id=matrix/executor/cmd/mcl-execute.buildSubIntent kind=func
  digest=b3:0fddae5b9426d6151c0b108d499136346df811393ab35b1151542161e8f6a75e file=executor/cmd/mcl-execute/step_handler.go range=602:689 lang=go exported=false byte_range=21126:24307
  sig=func buildSubIntent(sk *runtime.LoadedSkill, parent *ir.PlanTree, node *ir.PlanNode, actor *actorIdentity) *ir.Intent
  doc=buildSubIntent assembles the synthetic *ir.Intent that v1 in-process\nsub-dispatch feeds to synthesize() for the sub-skill (Q6 carve-out).\n\nWhy this helper exists (sess#37c):\n\n	synthesize() guards its inputs with a nil-check that rejects\n	Intent==nil with "synthesize: missing required input (skill/intent/\n	manifest/registry)". The pre-sess#37c synthesizer closure passed\n	Intent: nil with the comment "v1: sub-plan derived from sub-skill\n	manifest only" — but that contract was never honored on the\n	consumer side, so every sub_dispatch hit the guard immediately\n	after sub.skill.loaded and the walker bubbled subagent_failed.\n\nv1 sub-dispatch skips the compile phase against the sub-skill (no\nclarify, no slot resolve, no LLM compile round-trip). The sub-Intent\nis derived structurally from the parent walk context + sub-skill\nmetadata so synthesize() has the minimum it needs to render the\nplanner prompt: a non-nil Intent with ID + Frame.Verb + Prose.\n\nVerb resolution (highest-priority wins):\n 1. node.SubDispatch.SubIntent.Verb when the parent planner\n    populated NodeSubDispatch.sub_intent (future-proofing; the v1\n    planner system prompt only emits {skill_ref}).\n 2. The sub-skill's first §SKILL.mcl.verbs entry. Sub-skills declare\n    the verb their §PROCEDURE on-block handles; this matches.\n 3. "analyze" — D7 read-only fallback when the sub-skill has no\n    declared verbs (defensive; the loader rejects skills without\n    §SKILL.mcl.verbs but the runtime never trusts that invariant).\n\nOther fields (Frame.Objects, Frame.Constraints, etc.) inherit from\nnode.SubDispatch.SubIntent when present, else zero-value. Parent\nlinkage uses ir.Intent.Parent so the cortex audit chain ties the\nsub-Intent back to the parent.
EDGES
  ^defines=matrix/executor/cmd/mcl-execute/step_handler.go

NODE id=matrix/executor/cmd/mcl-execute.buildSystemPrompt kind=func
  digest=b3:067ccaf2ae455d159f9e6f3c0abe5247da71edcd519344a66eb94b2e1fbcc90f file=executor/cmd/mcl-execute/synthesize.go range=379:509 lang=go exported=false byte_range=12674:19768
  sig=func buildSystemPrompt(skill *runtime.LoadedSkill, manifest *tool.AgentManifest, mgr *mcp.Manager, workspaceRoot string) string
  doc=buildSystemPrompt assembles the role + capabilities section. The\nagent's manifest tool URIs are filtered through the skill's\n§TOOLS allow-list so the executor LLM only sees what the skill\nauthor sanctioned. When mgr is non-nil, each tool's live\nInputSchema (from MCP tools/list) is embedded so the model emits\nvalid args. workspaceRoot is announced so path-taking tools (fs,\ngit) get sane absolute paths instead of hallucinated ones.
EDGES
  ^defines=matrix/executor/cmd/mcl-execute/synthesize.go

NODE id=matrix/executor/cmd/mcl-execute.buildToolListing kind=func
  digest=b3:b7a71f34db76c4c1171ccf68a787831e24428a59a2b0103309152828e5690af5 file=executor/cmd/mcl-execute/daemon_tools_routes.go range=198:217 lang=go exported=false byte_range=6440:7144
  sig=func buildToolListing(m *tool.AgentManifest, mgr *mcp.Manager) []toolDTO
  doc=buildToolListing flattens an AgentManifest into the wire-shape list.
EDGES
  ^defines=matrix/executor/cmd/mcl-execute/daemon_tools_routes.go

NODE id=matrix/executor/cmd/mcl-execute.buildTree kind=func
  digest=b3:bfb352418502862398d9b81ce9a0d037bd66d1b7e50dbf98b233979002ac4f1d file=executor/cmd/mcl-execute/daemon_fs_routes.go range=445:494 lang=go exported=false byte_range=15137:16610
  sig=func buildTree(p *ForgeFSPolicy, path string, info os.FileInfo, depth int) fsTreeNode
  doc=buildTree assembles an fsTreeNode rooted at path with the given\nremaining depth. Directories matching a DenyPrefix render with\nDenied=true and no Children so the SPA can render a hint icon.\nSorted by name for determinism (replay-friendly UI snapshots).
EDGES
  ^defines=matrix/executor/cmd/mcl-execute/daemon_fs_routes.go

NODE id=matrix/executor/cmd/mcl-execute.buildUserPrompt kind=func
  digest=b3:ddf1e678b50c217f71d1fcc488c679df003e521a9f5926c7959bd13224892aec file=executor/cmd/mcl-execute/synthesize.go range=511:556 lang=go exported=false byte_range=19770:21457
