  ^defines=matrix/executor/cmd/mcl-execute/daemon_construct.go

NODE id=matrix/executor/cmd/mcl-execute.daemonState.criticMod kind=method
  digest=b3:c2dfb9af90b0cf98a229640ba866fc26ae4394ef95806783ca753bd8ba4d6d57 file=executor/cmd/mcl-execute/critique.go range=60:69 lang=go exported=false byte_range=2609:3017
  sig=func (d *daemonState) criticMod() string
  doc=criticMod returns the model the completeness critic should use: the\ndedicated criticModel knob when set, else Cassandra's non-reasoning grok\npin (defaultCriticModel). Never empty, so critiquePlan always audits on\nCassandra's model rather than the planner/executor default.
EDGES
  ^contains=matrix/executor/cmd/mcl-execute.daemonState
  ^defines=matrix/executor/cmd/mcl-execute/critique.go

NODE id=matrix/executor/cmd/mcl-execute.daemonState.critiquePlan kind=method
  digest=b3:f63d27fd2a03a49b8d1c728c1eab0142e91a1cf30cd98eb431afcb246faaeac2 file=executor/cmd/mcl-execute/critique.go range=175:225 lang=go exported=false byte_range=6266:8646
  sig=func (d *daemonState) critiquePlan(ctx context.Context, prose, executedDigest, intentID, goalID string, t *transcript, acc *intentCostAccumulator) (*cassandra.Verdict, error)
  doc=critiquePlan asks the Cassandra adjudicator whether the executed work\nsatisfies the user's original request. executedDigest is the cumulative\nbuildExecutionDigest across every walk so far. Returns the verdict, or an\nerror if the LLM call / parse failed (the caller fails OPEN on error: a\ncritic hiccup must never convert an otherwise-clean walk into a failure).\n\nThis is the MCL seam of the shared Cassandra faculty (cassandra.frozen.kvx\n[seams.mcl]): the verdict-shaped logic now lives in matrix/cassandra; the\nMCL gate consults verdict.CoverageComplete(), preserving the legacy\ncriticVerdict.Complete behavior byte-for-byte.
EDGES
  ^contains=matrix/executor/cmd/mcl-execute.daemonState
  ^defines=matrix/executor/cmd/mcl-execute/critique.go

