NODE id=matrix/executor/cmd/mcl-execute.daemonState.recordSurfaceFrame kind=method
  digest=b3:247e43726971e617a141d01893a1f683f338cd8adad300842a54b65dcb719502 file=executor/cmd/mcl-execute/daemon_surfacestore.go range=122:144 lang=go exported=false byte_range=4509:5381
  sig=func (d *daemonState) recordSurfaceFrame(ev sseEvent, conversationID string)
  doc=recordSurfaceFrame tees ONE broker event into the durable surface store, but\nonly for construct-phase surface frames (construct.surface[.patch]); every\nother pipeline event is ignored. The sseEvent → schema.Frame mapping is\n1:1 (the wire shapes are identical by design), so a reopen replays the\npersisted stream through the client's reducer byte-for-byte.\n\nstore.Record is non-blocking and drops on saturation, so this never blocks\nthe broker publish path (R16.1/16.3).
EDGES
  ^contains=matrix/executor/cmd/mcl-execute.daemonState
  ^defines=matrix/executor/cmd/mcl-execute/daemon_surfacestore.go

NODE id=matrix/executor/cmd/mcl-execute.daemonState.requireAuth kind=method
  digest=b3:ff00e12fc47e7d2e80b9a1582900b8c91184a153d7ace8f6881e0a1f19fb3481 file=executor/cmd/mcl-execute/daemon_server.go range=292:308 lang=go exported=false byte_range=10627:11228
  sig=func (d *daemonState) requireAuth(w http.ResponseWriter, r *http.Request) bool
  doc=requireAuth enforces the bearer token when configured. Returns true\niff the request is authorized (or auth is disabled). On 401 the\nresponse is fully written and the caller must return.
EDGES
  ^contains=matrix/executor/cmd/mcl-execute.daemonState
  ^defines=matrix/executor/cmd/mcl-execute/daemon_server.go

NODE id=matrix/executor/cmd/mcl-execute.daemonState.requireAuthPolicy kind=method
  digest=b3:96f72180058b5c92aae659c6d866acfdce41cdcfe000d71f392ec7aa46162686 file=executor/cmd/mcl-execute/daemon_auth.go range=99:172 lang=go exported=false byte_range=3447:6353
  sig=func (d *daemonState) requireAuthPolicy(w http.ResponseWriter, r *http.Request, policy authPolicy) (context.Context, bool)
  doc=requireAuthPolicy gates a request per the supplied policy. Returns\n(ctx, true) on success; on failure writes the 401/403 and returns\n(nil, false). Callers MUST return after a false result.\n\nOn success, ctx carries ctxKeyUserID + ctxKeyAdmin so route handlers\ncan attribute the call to a user without re-parsing headers.
EDGES
  ^contains=matrix/executor/cmd/mcl-execute.daemonState
  ^defines=matrix/executor/cmd/mcl-execute/daemon_auth.go

NODE id=matrix/executor/cmd/mcl-execute.daemonState.resumeAsyncJobs kind=method
  digest=b3:ec1f044082351823019ea7f99bb075f728f00fbcc40a3796c431ad25f83c0731 file=executor/cmd/mcl-execute/daemon_async_durable.go range=151:197 lang=go exported=false byte_range=4922:6550
  sig=func (d *daemonState) resumeAsyncJobs(t *transcript)
  doc=resumeAsyncJobs is invoked once after the server is listening. It\ncompletes the durable-inbox guarantee:\n\n  - queued jobs (accepted but never started) are dispatched, so an\n    accepted message always runs even if the daemon died before it\n    began.\n  - running jobs (interrupted mid-flight by a crash/redeploy) are\n    marked failed with a deterministic, user-facing "interrupted"\n    outcome rather than blindly re-run — re-running could double a\n    side effect (e.g. an on-chain write). The user retries explicitly.
EDGES
  ^contains=matrix/executor/cmd/mcl-execute.daemonState
  ^defines=matrix/executor/cmd/mcl-execute/daemon_async_durable.go

NODE id=matrix/executor/cmd/mcl-execute.daemonState.runAsyncMessage kind=method
  digest=b3:e403b28e931e5b6cdb4d883edc7d9e2cda14235fee051ef628b68439c2e2e835 file=executor/cmd/mcl-execute/daemon_intents_routes.go range=840:880 lang=go exported=false byte_range=26744:28331
  sig=func (d *daemonState) runAsyncMessage(intentID string, req messageRequest, t *transcript)
  doc=runAsyncMessage is the goroutine that runs one async job. It\nacquires d.busy (the cortex single-writer mutex), constructs an\nhttpGateHandler keyed by intent_id, and threads the resulting\ngoroutine context through runMessage.
EDGES
  ^contains=matrix/executor/cmd/mcl-execute.daemonState
  ^defines=matrix/executor/cmd/mcl-execute/daemon_intents_routes.go

NODE id=matrix/executor/cmd/mcl-execute.daemonState.runConstructProjector kind=method
  digest=b3:561e47299ba87779a83a06e9739a56cd3be5baf71055df4592c629c452933322 file=executor/cmd/mcl-execute/daemon_construct.go range=84:118 lang=go exported=false byte_range=3354:4380
  sig=func (d *daemonState) runConstructProjector(ctx context.Context, t *transcript, p *constructProjector, ch <-chan sseEvent, intentID, conversationID string)
  doc=runConstructProjector is the per-run projection loop. It projects each\npipeline event live (so surfaces stream progressively, like the narration),\nthen drains any buffered events on stop so a result that arrived just before\nthe run returned is not lost. Pure side-channel: the only writes are\nconstruct.surface transcript events.
EDGES
  ^contains=matrix/executor/cmd/mcl-execute.daemonState
  ^defines=matrix/executor/cmd/mcl-execute/daemon_construct.go

NODE id=matrix/executor/cmd/mcl-execute.daemonState.runGideonGate kind=method
  digest=b3:28d564726914868dca7c52475fb49e54fdf03ab3b9346f430c5872fd79a47fb5 file=executor/cmd/mcl-execute/daemon_gideon_pipeline.go range=431:472 lang=go exported=false byte_range=15669:17355
  sig=func (d *daemonState) runGideonGate(ctx context.Context, intentID, nodeID string, ev OpsEvaluation, t *transcript) (bool, error)
  doc=runGideonGate opens a forced approval gate for a chain-state-loss risk\nthrough the same gateBroker/httpGateHandler used for synthesized gate\nnodes, so a channel (Telegram) or the panel can answer it via POST\n/intents/<id>/gates/<nid>/answer. Returns whether it was approved.\n\nWhen no gateBroker is wired the gate cannot be answered, so it\nfail-closed denies — a chain-state-loss action is NEVER auto-approved.
EDGES
  ^contains=matrix/executor/cmd/mcl-execute.daemonState
  ^defines=matrix/executor/cmd/mcl-execute/daemon_gideon_pipeline.go

NODE id=matrix/executor/cmd/mcl-execute.daemonState.runGideonScheduler kind=method
  digest=b3:9f55e1ecbf6a2e3f0616435b12a86eedfe560589649f684315f59f43c250a80a file=executor/cmd/mcl-execute/gideon_scheduler.go range=37:68 lang=go exported=false byte_range=1542:2369
  sig=func (d *daemonState) runGideonScheduler(ctx context.Context, t *transcript)
  doc=runGideonScheduler is the ambient reasoning loop. Blocks until ctx is\ncancelled. Safe to call in a goroutine; it owns its own ticker.
EDGES
  ^contains=matrix/executor/cmd/mcl-execute.daemonState
  ^defines=matrix/executor/cmd/mcl-execute/gideon_scheduler.go

NODE id=matrix/executor/cmd/mcl-execute.daemonState.runGideonSweep kind=method
  digest=b3:fbadf9e39f65451479974960cbbb7fcb4672886ddf8b8c09dea78f9828f88b94 file=executor/cmd/mcl-execute/gideon_scheduler.go range=70:140 lang=go exported=false byte_range=2371:4634
  sig=func (d *daemonState) runGideonSweep(ctx context.Context, cycle int, t *transcript)
  doc=runGideonSweep executes one sweep cycle. Respects single-flight: if\nd.busy is held (a human/async intent is mid-flight) the cycle is\nskipped. Otherwise it acquires the mutex, fires the internal intent\nvia runMessageDirect, and persists a chronology Event before\nreleasing the lock.
EDGES
  ^contains=matrix/executor/cmd/mcl-execute.daemonState
  ^defines=matrix/executor/cmd/mcl-execute/gideon_scheduler.go

NODE id=matrix/executor/cmd/mcl-execute.daemonState.runLiaisonNarrator kind=method
  digest=b3:9e0a13c7ff3061c158a5eb6ce68165f3f58b6bd50300b74d0507ba7fd5584d31 file=executor/cmd/mcl-execute/daemon_liaison.go range=314:400 lang=go exported=false byte_range=13870:16998
  sig=func (d *daemonState) runLiaisonNarrator(ctx context.Context, t *transcript, n *liaisonNarrator, ch <-chan sseEvent, intentID, conversationID, userProse, userName string)
  doc=runLiaisonNarrator is the per-run narration loop. It ONLY emits live\nprogress turns (the warm "here's what's happening" updates) by\ndebouncing the technical event stream. It does NOT compose the closing\nanswer: that is now owned by runMessage via emitFinalTurn, which emits\na deterministic, guaranteed final turn from the run's ground-truth\nresult (not a lossy re-read of this event stream). This inversion is\nwhat makes the answer always land, never hallucinated, never silent.\n\nPure side-channel: the only writes are chat.* transcript events. Once\nrunMessage emits the final turn (n.finalSent), this loop emits nothing\nfurther, so no trailing progress update can hide the real answer.
EDGES
  ^contains=matrix/executor/cmd/mcl-execute.daemonState
  ^defines=matrix/executor/cmd/mcl-execute/daemon_liaison.go

NODE id=matrix/executor/cmd/mcl-execute.daemonState.runPaxeerSpendGate kind=method
  digest=b3:485926c61869f9afb7a5d01c7dfd0abaf68d26a5c61c363dd50af8b23ac653ff file=executor/cmd/mcl-execute/daemon_paxeer_spend.go range=120:165 lang=go exported=false byte_range=3789:5439
  sig=func (d *daemonState) runPaxeerSpendGate(ctx context.Context, intentID, nodeID string, ev SpendEvaluation, t *transcript) (bool, error)
  doc=runPaxeerSpendGate opens a forced approval gate for a per-call or\naggregate spend cap exceedance through the same gateBroker /\nhttpGateHandler used for synthesized gate nodes. Returns whether it\nwas approved.\n\nWhen no gateBroker is wired the gate cannot be answered, so it\nfail-closes (denies). A spend over cap is NEVER auto-approved.
EDGES
  ^contains=matrix/executor/cmd/mcl-execute.daemonState
  ^defines=matrix/executor/cmd/mcl-execute/daemon_paxeer_spend.go

NODE id=matrix/executor/cmd/mcl-execute.daemonState.runSurfaceStoreTee kind=method
  digest=b3:1daeca2eb29bdd53a9f0ee338700321b033adf41cfce356451f8f1061927f307 file=executor/cmd/mcl-execute/daemon_surfacestore.go range=86:120 lang=go exported=false byte_range=3523:4507
  sig=func (d *daemonState) runSurfaceStoreTee(ctx context.Context, tee *surfaceStoreTee, ch <-chan sseEvent, conversationID string)
  doc=runSurfaceStoreTee is the per-run tee loop. It records each construct surface\nframe live (so the durable record tracks the live workspace), then drains any\nbuffered frames on stop so a surface that arrived just before the run\nreturned is still persisted. Pure side-channel: the only effect is an async,\nbest-effort append via the store.
EDGES
  ^contains=matrix/executor/cmd/mcl-execute.daemonState
  ^defines=matrix/executor/cmd/mcl-execute/daemon_surfacestore.go

NODE id=matrix/executor/cmd/mcl-execute.daemonState.selectSkill kind=method
  digest=b3:289e086d2e74517d0b4eea64ac90891df83c5c5754321320a8d38ee923e4bfef file=executor/cmd/mcl-execute/daemon_skill_select.go range=38:54 lang=go exported=false byte_range=1410:2234
  sig=func (d *daemonState) selectSkill(prose, verb string) string
  doc=selectSkill chooses the skill URI for an incoming user message when the\nclient did NOT explicitly pin one. Strong Solidity/contract signals route to\nthe focused tachyon-engineer skill; everything else keeps the configured\ncatch-all default. The check is deterministic (no LLM) and conservative:\ngeneric build/deploy verbs only route when paired with a contract noun, so\nchain reads, swaps, transfers, and software tasks stay on the default skill.\n\nverb is accepted for future verb-aware routing but currently unused: skill\nselection happens before the compiler classifies the verb, so req.Verb is\nalmost always empty here.
EDGES
  ^contains=matrix/executor/cmd/mcl-execute.daemonState
  ^defines=matrix/executor/cmd/mcl-execute/daemon_skill_select.go

NODE id=matrix/executor/cmd/mcl-execute.daemonState.startConstructProjector kind=method
  digest=b3:17fa3cc989427d40eb70ec503d94bbc885690f71a889ef0a37ba430d0b3f6cb6 file=executor/cmd/mcl-execute/daemon_construct.go range=61:69 lang=go exported=false byte_range=2455:3066
  sig=func (d *daemonState) startConstructProjector(ctx context.Context, t *transcript, intentID, conversationID string) *constructProjector
  doc=startConstructProjector subscribes to the broker SYNCHRONOUSLY (so no early\npipeline event is missed) and launches the projection loop. runMessage defers\nprojector.shutdown() so the loop drains and detaches before t.Close().
EDGES
  ^contains=matrix/executor/cmd/mcl-execute.daemonState
  ^defines=matrix/executor/cmd/mcl-execute/daemon_construct.go

NODE id=matrix/executor/cmd/mcl-execute.daemonState.startLiaisonNarrator kind=method
  digest=b3:4f822526c732d7506b4c17abe222e4fcd9472e3cee92671d9e137e2540e15ca5 file=executor/cmd/mcl-execute/daemon_liaison.go range=304:312 lang=go exported=false byte_range=13238:13868
  sig=func (d *daemonState) startLiaisonNarrator(ctx context.Context, t *transcript, intentID, conversationID, userProse, userName string) *liaisonNarrator
  doc=startLiaisonNarrator subscribes to the broker SYNCHRONOUSLY (so no early\npipeline event is missed) and launches the narration loop. runMessage\ndefers narrator.shutdown() so the closing turn lands before t.Close().
EDGES
  ^contains=matrix/executor/cmd/mcl-execute.daemonState
  ^defines=matrix/executor/cmd/mcl-execute/daemon_liaison.go

NODE id=matrix/executor/cmd/mcl-execute.daemonState.startSurfaceStoreTee kind=method
  digest=b3:9cdb6bc5e634881fa242ce2463d6ae87fa0fb19fe287ad173354e5a0e0489312 file=executor/cmd/mcl-execute/daemon_surfacestore.go range=61:71 lang=go exported=false byte_range=2555:3237
  sig=func (d *daemonState) startSurfaceStoreTee(ctx context.Context, intentID, conversationID string) *surfaceStoreTee
  doc=startSurfaceStoreTee subscribes to the broker SYNCHRONOUSLY (so no early\nsurface frame is missed) and launches the tee loop. runMessage defers\ntee.shutdown() so the loop drains and detaches before t.Close(). It mirrors\nstartConstructProjector exactly, except it records surface frames instead of\nprojecting pipeline events.
EDGES
  ^contains=matrix/executor/cmd/mcl-execute.daemonState
  ^defines=matrix/executor/cmd/mcl-execute/daemon_surfacestore.go

NODE id=matrix/executor/cmd/mcl-execute.daemonState.surfaceStoreEnabled kind=method
  digest=b3:36408c92a8213987838a0213d9ea1eb7cc1365f4c60645baf6ee4b3822eb6d2f file=executor/cmd/mcl-execute/daemon_surfacestore.go range=45:50 lang=go exported=false byte_range=2031:2343
  sig=func (d *daemonState) surfaceStoreEnabled() bool
  doc=surfaceStoreEnabled reports whether the durable surface-store tee should run:\nonly when the store resolved to a real /data-rooted directory (a disabled\nno-op store, e.g. dev/CLI, leaves the tee unspawned).
EDGES
  ^contains=matrix/executor/cmd/mcl-execute.daemonState
  ^defines=matrix/executor/cmd/mcl-execute/daemon_surfacestore.go

NODE id=matrix/executor/cmd/mcl-execute.daemonState.synthMod kind=method
  digest=b3:fea144c89d80ebb044a61d855312f7578761b6d2ef54c906c4c45e3b0a124b07 file=executor/cmd/mcl-execute/daemon_cmd.go range=261:270 lang=go exported=false byte_range=11423:11824
  sig=func (d *daemonState) synthMod() string
  doc=synthMod returns the model the planner (plan synthesis) slot should\nuse: the dedicated plannerModel when set, else the executorModel knob\n(v1 launch decoupling with single-knob back-compat). An empty result\nlets synthesize() fall through to llm.DefaultPlannerModel().
EDGES
  ^contains=matrix/executor/cmd/mcl-execute.daemonState
  ^defines=matrix/executor/cmd/mcl-execute/daemon_cmd.go

NODE id=matrix/executor/cmd/mcl-execute.daemonState.triageMessage kind=method
  digest=b3:a3ba94237769dc536f8bc05c8a48d5d06f487c582e7ea6cc34ae3b218888acfb file=executor/cmd/mcl-execute/daemon_liaison.go range=778:801 lang=go exported=false byte_range=31157:32280
  sig=func (d *daemonState) triageMessage(ctx context.Context, intentID, message, userName string, history []convTurn, t *transcript) triageDecision
  doc=triageMessage asks the Liaison whether to answer directly or dispatch a\nrun. history is the recent conversation (oldest-first) so follow-up\nmessages are understood in context; it may be empty. On any failure it\nfalls back to dispatching the raw message (the product exists to do\ntasks; never silently drop a request).
EDGES
  ^contains=matrix/executor/cmd/mcl-execute.daemonState
  ^defines=matrix/executor/cmd/mcl-execute/daemon_liaison.go

NODE id=matrix/executor/cmd/mcl-execute.daemonState.tryProbeBusy kind=method
  digest=b3:78ecfe0e4ca17532a694f85c70e7abd01ce5790ba9c949114508c81e1840f98a file=executor/cmd/mcl-execute/daemon_server.go range=355:364 lang=go exported=false byte_range=12820:13141
  sig=func (d *daemonState) tryProbeBusy() bool
  doc=tryProbeBusy returns true iff /messages is currently held. It does\nNOT attempt to acquire the lock (that's the request's job); a brief\nbest-effort read using TryLock+Unlock is fine for /healthz.
EDGES
  ^contains=matrix/executor/cmd/mcl-execute.daemonState
  ^defines=matrix/executor/cmd/mcl-execute/daemon_server.go

