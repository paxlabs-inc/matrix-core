NODE id=matrix/executor/cmd/mcl-execute.outputRefPattern kind=var
  digest=b3:e9a70716625d163dbfca47ac325da7742ae4f2729bb6cb0c31ef08635ffc750c file=executor/cmd/mcl-execute/step_handler.go range=457:466 lang=go exported=false byte_range=15905:16656
  sig=*regexp.Regexp
  doc=outputRefPattern matches plan-step input references of the form\n${<nodeID>.output}, ${<nodeID>.text}, or bare ${<nodeID>}. The planner\nemits these in Step.Inputs to wire a prior node's output into a later\nstep (e.g. "fleet_summary": "${n02.output}"). Liberal in what it accepts:\nboth ${...} and Jinja-style {{...}} delimiters, and any dotted suffix\n(.output / .text / .outputs / .outputs.<field>) — all resolve to the whole\nupstream node output. Mirrors runtime/argref.go so step inputs and tool-call\nargs share one reference grammar. nodeID is the loose set of chars used for\nplan node ids (alphanumerics, _, -).
EDGES
  ^defines=matrix/executor/cmd/mcl-execute/step_handler.go

NODE id=matrix/executor/cmd/mcl-execute.pageParams kind=func
  digest=b3:2c212950c7d05162ac989a9afea1ea4b13e1ccbe0f1f92d63623bb5dc01318e3 file=executor/cmd/mcl-execute/daemon_pagination.go range=43:90 lang=go exported=false byte_range=1249:2601
  sig=func pageParams(w http.ResponseWriter, r *http.Request, defaultLimit, maxLimit int) (listCursor, int, bool)
  doc=pageParams parses ?cursor= and ?limit= from a request, applies caps,\nand returns the typed cursor (zero-value when no cursor was supplied)\nplus the resolved limit.\n\nErrors are written to w as 400 and (false, ...) returned; callers\nMUST return after a false result.
EDGES
  ^defines=matrix/executor/cmd/mcl-execute/daemon_pagination.go

