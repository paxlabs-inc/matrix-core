  ^defines=matrix/executor/cmd/mcl-execute/daemon_memory_routes.go

NODE id=matrix/executor/cmd/mcl-execute.daemonState.handleMemoryResolve kind=method
  digest=b3:32c2ff910e0db9618a2d99670f258cc946b50bf0b5eac18753f19ecf009714bb file=executor/cmd/mcl-execute/daemon_memory_routes.go range=204:251 lang=go exported=false byte_range=6764:8403
  sig=func (d *daemonState) handleMemoryResolve(w http.ResponseWriter, r *http.Request)
  doc=handleMemoryResolve serves GET /memory/<url-encoded-uri>.\n\nThe URI lives in the path component immediately after /memory/.\nTrailing path segments are accepted as-is; the URI is URL-decoded\nbefore passing to cortex.Resolve.
EDGES
  ^contains=matrix/executor/cmd/mcl-execute.daemonState
  ^defines=matrix/executor/cmd/mcl-execute/daemon_memory_routes.go

NODE id=matrix/executor/cmd/mcl-execute.daemonState.handleMemoryRoot kind=method
  digest=b3:11ab59c2b75a240c5dadcfe6767255e9fab542c5e0472d8a5a8238877bf663ce file=executor/cmd/mcl-execute/daemon_server.go range=183:199 lang=go exported=false byte_range=6942:7545
  sig=func (d *daemonState) handleMemoryRoot(w http.ResponseWriter, r *http.Request)
  doc=handleMemoryRoot dispatches the bare /memory path by method:\n\n	GET  /memory   →  handleMemoryFind (existing list+filter surface)\n	POST /memory   →  handleMemoryWrite (sess#29; writes typed memory)\n\nMethod-not-allowed for everything else.
EDGES
  ^contains=matrix/executor/cmd/mcl-execute.daemonState
  ^defines=matrix/executor/cmd/mcl-execute/daemon_server.go

NODE id=matrix/executor/cmd/mcl-execute.daemonState.handleMemoryRouter kind=method
  digest=b3:72b6a53f8ebecef6a0203e8321e2d6f43b68348194ffe0b1db0dc4f9838001e1 file=executor/cmd/mcl-execute/daemon_server.go range=201:221 lang=go exported=false byte_range=7547:8296
  sig=func (d *daemonState) handleMemoryRouter(w http.ResponseWriter, r *http.Request)
  doc=handleMemoryRouter dispatches /memory/<URI-encoded> | /memory/search\n| /memory/types | /memory/recent | /memory/salience/top to the\ncorrect handler. ServeMux picks the longest matching prefix, but\nsome sub-paths (search, types, recent, salience/top) are explicit\nregistered above; this catch-all handles arbitrary URI-encoded\npaths under /memory/.
EDGES
  ^contains=matrix/executor/cmd/mcl-execute.daemonState
  ^defines=matrix/executor/cmd/mcl-execute/daemon_server.go

