NODE id=matrix/executor/cmd/mcl-execute.writeSubSkillSection kind=func
  digest=b3:7d843970cd82ae685f7babcbf2172812e01c8109bb2e6b4cb6e9f7a7bb259b0b file=executor/cmd/mcl-execute/synthesize.go range=748:769 lang=go exported=false byte_range=27713:28598
  sig=func writeSubSkillSection(sb *strings.Builder, skill *runtime.LoadedSkill)
  doc=writeSubSkillSection renders the "== Available sub-skills ==" block.\nnone → strong negative; an allow-list → enumeration; absence/empty\n→ no section emitted (sub_dispatch nodes are independently gated by\nthe daemonState.allowSubDispatch flag).
EDGES
  ^defines=matrix/executor/cmd/mcl-execute/synthesize.go

NODE id=matrix/executor/cmd/mcl-execute.writeToolListing kind=func
  digest=b3:7ab69a4f58e0b1884c7c3d9c69da91e5e52e653f8db42b0b383cc67be71f026f file=executor/cmd/mcl-execute/synthesize.go range=681:715 lang=go exported=false byte_range=25542:26812
  sig=func writeToolListing(sb *strings.Builder, manifest *tool.AgentManifest, mgr *mcp.Manager, allow map[string]struct{})
  doc=writeToolListing renders the manifest tools, optionally filtered\nby allow. When allow is nil, every tool is listed (legacy mode).
EDGES
  ^defines=matrix/executor/cmd/mcl-execute/synthesize.go

NODE id=matrix/executor/cmd/mcl-execute.writeToolSection kind=func
  digest=b3:fed3edfd8c54642072c4f9e37ecf9e69074118af0d6227604ed3e8d260c843f2 file=executor/cmd/mcl-execute/synthesize.go range=655:679 lang=go exported=false byte_range=24466:25540
  sig=func writeToolSection(sb *strings.Builder, skill *runtime.LoadedSkill, manifest *tool.AgentManifest, mgr *mcp.Manager)
  doc=writeToolSection renders the "== Available tools ==" block,\nfiltered by the skill's §TOOLS allow-list. When mgr is non-nil and\nhas live schemas for the relevant alias, each tool entry includes\nits JSON-Schema InputSchema so the LLM emits valid args.
EDGES
  ^defines=matrix/executor/cmd/mcl-execute/synthesize.go

