NODE id=matrix/executor/cmd/mcl-execute.daemonState.handleMemoryFind kind=method
  digest=b3:22a0c2efffe6c58b91cd9bf71ac8b9efb4432ff3741a51294a116720b38f51e1 file=executor/cmd/mcl-execute/daemon_memory_routes.go range=76:127 lang=go exported=false byte_range=2827:4449
  sig=func (d *daemonState) handleMemoryFind(w http.ResponseWriter, r *http.Request)
  doc=handleMemoryFind serves GET /memory.\n\nQuery params (all optional):\n\n	?type=<TypeName>       Identity|Fact|Preference|Belief|Event|Goal|Constraint|Capability|Pattern\n	?tag=<single-tag>\n	?near=<text>           NL phrase for vector recall (requires embedder)\n	?limit=<int>           default 20, cap 200\n	?form=<short|medium|full>  default medium\n	?include_tombstoned=<bool> default false\n	?cursor=<opaque>       pagination cursor
EDGES
  ^contains=matrix/executor/cmd/mcl-execute.daemonState
  ^defines=matrix/executor/cmd/mcl-execute/daemon_memory_routes.go

