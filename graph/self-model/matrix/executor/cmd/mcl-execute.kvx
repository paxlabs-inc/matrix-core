NODE id=matrix/executor/cmd/mcl-execute.splitMCPToolRef kind=func
  digest=b3:c37de6e3a15baa659d910b746f20762884861c0dfe803dffe0e3faa4418b1d0c file=executor/cmd/mcl-execute/paxeer_spend_policy.go range=668:690 lang=go exported=false byte_range=23658:24431
  sig=func splitMCPToolRef(toolRef string) (alias, name string)
  doc=splitMCPToolRef extracts (alias, name) from a tool URI, e.g.\n\n	matrix://tool/mcp/paxeer-net/transfer@0.1.0  →  ("paxeer-net", "transfer")\n	matrix://tool/mcp/fs/read_text_file@2024.11  →  ("fs",         "read_text_file")\n\nBare or malformed refs return ("", raw); callers treat unknown alias\nas "not our concern" and pass through.
EDGES
  ^defines=matrix/executor/cmd/mcl-execute/paxeer_spend_policy.go

NODE id=matrix/executor/cmd/mcl-execute.splitReasoning kind=func
  digest=b3:954b57e310e05d8f6cdac19c0bd907f27ef6dd8e76aee3d677f8947159212767 file=executor/cmd/mcl-execute/daemon_liaison.go range=132:154 lang=go exported=false byte_range=5199:6182
  sig=func splitReasoning(content string) (answer, reasoning string)
  doc=splitReasoning separates a model's inline reasoning from the visible\nanswer. It returns (answer, reasoning): answer is content with any\nreasoning tag blocks removed; reasoning is the concatenated text of\nthose blocks (tags stripped). When there are no tags, answer == content\nand reasoning == "". This NEVER changes the answer's facts — it only\nmoves chain-of-thought to a separate channel so the UI can label it.
EDGES
  ^defines=matrix/executor/cmd/mcl-execute/daemon_liaison.go

