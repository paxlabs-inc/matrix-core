  digest=b3:100b0ecaf2c4a920c410f6f7e5fd7511ce389e51c9dfa11787d48960ccfc1950 file=executor/cmd/mcl-execute/step_handler.go range=145:178 lang=go exported=false byte_range=5026:6371
  sig=func (h *llmStepHandler) cfgFor(key llm.RouteKey) llm.Config
  doc=cfgFor returns the effective Config for a route key after applying\nthe CLI overrides. Pure (no I/O); separated from clientFor for tests.
