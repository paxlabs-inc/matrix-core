NODE id=matrix/executor/cmd/mcl-execute.liaisonNarrator#finalSent kind=field
  digest=b3:13e487ea9904373441436ab296b82e6ab9694cdccc675829af9169adbbc37ad4 file=executor/cmd/mcl-execute/daemon_liaison.go range=269:274 lang=go exported=false byte_range=12163:12500
  sig=int32
  doc=finalSent is set (atomically) the instant the deterministic\nclosing turn is emitted by runMessage via emitFinalTurn. Once\nset, the progress loop emits no further turns, so a trailing\nprogress update can never land after — and hide — the real\nanswer (the post-launch "chat just stops talking" bug).
EDGES
