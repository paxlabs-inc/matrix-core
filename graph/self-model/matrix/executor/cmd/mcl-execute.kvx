NODE id=matrix/executor/cmd/mcl-execute.makeCostHook kind=func
  digest=b3:32ce43a2f955abcd5445b867be00c2f637052991e0f2d4359d95a35b306a47f2 file=executor/cmd/mcl-execute/intent_cost.go range=223:240 lang=go exported=false byte_range=7691:8419
  sig=func makeCostHook(t *transcript, m *routerMetrics, acc *intentCostAccumulator, meta intentCostMeta) func(http.Header)
  doc=makeCostHook returns an llm.Config.OnResponseHeaders compatible\nclosure that pipes the response headers into recordIntentCost +\nthe supplied accumulator. Used by compile.go / synthesize.go /\nstep_handler.go so each routed-LLM call site shares the same\ncost-capture surface.\n\nThe closure is safe for concurrent use (recordIntentCost guards\ntranscript + metrics writes; accumulator has its own mutex).
EDGES
  ^defines=matrix/executor/cmd/mcl-execute/intent_cost.go

NODE id=matrix/executor/cmd/mcl-execute.makeFailedResult kind=func
  digest=b3:4862f2477adc5350d0bf0af7c5ffe3cf364c8fee52a2d979a0bd5289e98c5fcf file=executor/cmd/mcl-execute/daemon_pipeline.go range=728:756 lang=go exported=false byte_range=31533:32871
  sig=func makeFailedResult(intentID, intentHash string, drv *lifecycleDriver, walk *runtime.WalkResult, plan *ir.PlanTree, reason, msg string, start time.Time) *messageResult
  doc=makeFailedResult assembles a messageResult for non-fatal terminal\nfailures (synth fail, walk error, in-band tool error). Fatal errors\n(broken cortex, signal abort) bubble up to the HTTP layer instead.\n\nplan is the executed plan (nil when failure occurred before/at\nsynthesis); any partial node output it captured is folded into the\ndeterministic Answer alongside the failure reason, so even a failed\nrun carries real, ground-truth context rather than a bare code.
EDGES
  ^defines=matrix/executor/cmd/mcl-execute/daemon_pipeline.go

