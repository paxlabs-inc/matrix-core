  sig=func buildWalker(in *infra, drv *lifecycleDriver, stream *envelopeStream, actor *actorIdentity, skill *runtime.LoadedSkill, execModel, llmBaseURL string, seed int64, gatePolicy string, allowSubDispatch bool, t *transcript) (*runtime.Walker, error)
