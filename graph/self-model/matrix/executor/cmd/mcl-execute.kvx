  digest=b3:9ab133df301a4474cb980a62f36a10ad04620dc134a179837695beb41405be51 file=executor/cmd/mcl-execute/daemon_async_durable.go range=35:50 lang=go exported=false byte_range=1351:1997
  sig=func asyncJobDir(cortexRoot, transcriptsDir string) string
  doc=asyncJobDir derives the durable async-job directory from the daemon's\npersistent roots. It co-locates with the snapshotted data tree (the\nparent of cortex-root, e.g. /data in prod, so /data/async), falling\nback to the transcripts parent, then a local default. Returning "" is\navoided so persistence is on by default wherever the daemon has a\npersistent root.
