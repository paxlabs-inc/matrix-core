NODE id=matrix/executor/cmd/mcl-execute.daemonState.handleMemoryTypes kind=method
  digest=b3:b0b43619ac8947f0587c3d2507fd48e327db9dcd3d66624697cb52d17a3f593e file=executor/cmd/mcl-execute/daemon_memory_routes.go range=253:290 lang=go exported=false byte_range=8405:9605
  sig=func (d *daemonState) handleMemoryTypes(w http.ResponseWriter, r *http.Request)
  doc=handleMemoryTypes serves GET /memory/types.\n\nReturns one entry per memory type with a count derived from\ncortex.ListByType. Counts are best-effort (an active embedder might\nbe appending while we count); for an exact figure use /cortex/stats.
