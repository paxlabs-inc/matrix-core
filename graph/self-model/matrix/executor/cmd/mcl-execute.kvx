NODE id=matrix/executor/cmd/mcl-execute.paxAdd kind=func
  digest=b3:ca0afefcf32abb58fe5a0dbb34771acb050a11be7a743cec3c1041556a6ccee9 file=executor/cmd/mcl-execute/intent_cost.go range=242:265 lang=go exported=false byte_range=8421:9255
  sig=func paxAdd(a, b string) (string, error)
  doc=paxAdd sums two PAX-denominated decimal strings using big.Float math\n(mirrors gateway/internal/rates.AddPax). 256-bit precision keeps\nrounding error well below NUMERIC(20,12) least-significant digit.\nOutput is fixed-12 decimal so the daemon-side accumulator's\nsnapshot is stable across calls.
EDGES
  ^defines=matrix/executor/cmd/mcl-execute/intent_cost.go

