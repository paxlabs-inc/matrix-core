  ^defines=matrix/executor/cmd/mcl-execute/daemon_liaison.go

NODE id=matrix/executor/cmd/mcl-execute.liaisonNarrator kind=type
  digest=b3:2e5946241da2b4161b5e19e6fb54f79faed9961a74a7948922f5e2659de18a07 file=executor/cmd/mcl-execute/daemon_liaison.go range=262:275 lang=go exported=false byte_range=11911:12502
  sig=type liaisonNarrator struct {\n	subID	uint64\n	stop	chan struct{}\n	done	chan struct{}\n	once	sync.Once\n	// finalSent is set (atomically) the instant the deterministic\n	// closing turn is emitted by runMessage via emitFinalTurn. Once\n	// set, the progress loop emits no further turns, so a trailing\n	// progress update can never land after — and hide — the real\n	// answer (the post-launch "chat just stops talking" bug).\n	finalSent	int32\n}
  doc=liaisonNarrator is the handle runMessage uses to control the narration\ngoroutine: signal wrap-up (stop) and wait for the closing turn (done).
EDGES
  contains=matrix/executor/cmd/mcl-execute.liaisonNarrator#done,matrix/executor/cmd/mcl-execute.liaisonNarrator#finalSent,matrix/executor/cmd/mcl-execute.liaisonNarrator#once,matrix/executor/cmd/mcl-execute.liaisonNarrator#stop,matrix/executor/cmd/mcl-execute.liaisonNarrator#subID,matrix/executor/cmd/mcl-execute.liaisonNarrator.finalAlreadySent,matrix/executor/cmd/mcl-execute.liaisonNarrator.markFinalSent,matrix/executor/cmd/mcl-execute.liaisonNarrator.shutdown
  ^defines=matrix/executor/cmd/mcl-execute/daemon_liaison.go

NODE id=matrix/executor/cmd/mcl-execute.liaisonNarrator#done kind=field
  digest=b3:e14021a27b604effc9a39b755c96d69f429e4f08c9bf72f4332de6640122909a file=executor/cmd/mcl-execute/daemon_liaison.go range=267:267 lang=go exported=false byte_range=12125:12144
  sig=chan struct{}
EDGES
