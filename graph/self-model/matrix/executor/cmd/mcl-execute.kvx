NODE id=matrix/executor/cmd/mcl-execute.daemonState.persistSweepEvent kind=method
  digest=b3:27bab1da3cb5e6224f56e0319f2e5aed08d018f764ec5af897462a4ccfc5a812 file=executor/cmd/mcl-execute/gideon_scheduler.go range=142:178 lang=go exported=false byte_range=4636:5888
  sig=func (d *daemonState) persistSweepEvent(intentID string, outcome memory.Outcome, summary string, t *transcript)
  doc=persistSweepEvent writes a chronology Event memory for one sweep cycle\nso the timeline (panel /memory/recent) reflects the ambient loop even\nwhen the sweep itself wrote no per-tool Events. Errors are logged, not\nfatal — a missed chronology row never crashes the scheduler.
EDGES
  ^contains=matrix/executor/cmd/mcl-execute.daemonState
  ^defines=matrix/executor/cmd/mcl-execute/gideon_scheduler.go

NODE id=matrix/executor/cmd/mcl-execute.daemonState.projectConstructEvent kind=method
  digest=b3:7beb41f5696971b9f7f4c960e452dd198efe769141b8f280bc3a0da2e362db21 file=executor/cmd/mcl-execute/daemon_construct.go range=120:138 lang=go exported=false byte_range=4382:5166
  sig=func (d *daemonState) projectConstructEvent(t *transcript, ev sseEvent, intentID, conversationID string)
  doc=projectConstructEvent runs one event through the deterministic projector and\nemits any resulting surfaces. The loop guard drops our OWN construct events\nso the projector never re-projects what it just emitted.
EDGES
  ^contains=matrix/executor/cmd/mcl-execute.daemonState
  ^defines=matrix/executor/cmd/mcl-execute/daemon_construct.go

