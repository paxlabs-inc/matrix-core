NODE id=matrix/executor/cmd/mcl-execute.daemonState.handleMemoryWrite kind=method
  digest=b3:f7e978eb130851751928c6ae271cd6a68826a0203b55a5102f4c0972744863bd file=executor/cmd/mcl-execute/daemon_memory_write.go range=105:300 lang=go exported=false byte_range=3739:10073
  sig=func (d *daemonState) handleMemoryWrite(w http.ResponseWriter, r *http.Request)
  doc=handleMemoryWrite serves POST /memory.\n\nBody shape:\n\n	{\n	  "type":  "Identity" | "Fact" | ... | "Pattern",\n	  "data":  { ... }   // type-specific JSON; matches memory.<Type>Data\n	  "tags":  ["..."],\n	  "declared_importance": 0-255,\n	  "visibility":          "private" | "scoped" | "actor_public",\n	  "created_by":          "matrix://user/<did>",  // optional override\n	  "actor_scope":         "...",                  // optional override\n	  "confidence":          0.0-1.0,\n	  "provenance_source":   "<short tag>"\n	}\n\nOn success returns 201 + memorySummaryDTO of the new memory.
EDGES
  ^contains=matrix/executor/cmd/mcl-execute.daemonState
  ^defines=matrix/executor/cmd/mcl-execute/daemon_memory_write.go

