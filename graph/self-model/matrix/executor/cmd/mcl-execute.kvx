NODE id=matrix/executor/cmd/mcl-execute.gitMutex kind=var
  digest=b3:b906e11e9cb663a46266a3bad430fab6b21942821424decdf09d5112cc5f52a8 file=executor/cmd/mcl-execute/daemon_git_routes.go range=122:126 lang=go exported=false byte_range=4063:4363
  sig=*main.gitOpsLock
  doc=gitMutex provides a process-global lock for daemon-side git\noperations. Single-flight is the right posture: even mcl-execute\ndaemon's other goroutines (e.g. an MCP-side git_commit) don't share\nthis mutex, but the HTTP-side surface is consistent within itself.
EDGES
  ^defines=matrix/executor/cmd/mcl-execute/daemon_git_routes.go

NODE id=matrix/executor/cmd/mcl-execute.gitOpsLock kind=type
  digest=b3:dd37c6bd8cbdcfca2d08141f66bb2c77766d91c0279fa64886dfe7a0de146ec9 file=executor/cmd/mcl-execute/daemon_git_routes.go range=114:120 lang=go exported=false byte_range=3793:4061
  sig=type gitOpsLock struct {\n	mu sync.RWMutex\n}
  doc=gitOpsLock serializes every mutating /git/* call.\nIntentionally shared across requests because the working tree is\nthe contended resource. Reads (status, diff, branch list) take a\nread lock; mutations take write.
EDGES
  contains=matrix/executor/cmd/mcl-execute.gitOpsLock#mu
  ^defines=matrix/executor/cmd/mcl-execute/daemon_git_routes.go

