  digest=b3:e1eab2e3c1323b58e61db1626b83dffa17edebb01f31798010705b431253947f file=executor/cmd/mcl-execute/synthesize.go range=906:913 lang=go exported=false byte_range=32057:32410
  sig=func extractOutputCardinalityHints(mtxBytes []byte) map[string]int
  doc=extractOutputCardinalityHints returns a map verb -> N (positive int)\nfor every top-level on-block in §PROCEDURE that declares an\n`output_cardinality = <int>` KV. nil when no annotations exist.\nSession 31c · P3c.
