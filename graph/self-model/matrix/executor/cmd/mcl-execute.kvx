  ^contains=matrix/executor/cmd/mcl-execute.ForgeShellConfig

NODE id=matrix/executor/cmd/mcl-execute.ForgeShellConfig#IdleTimeout kind=field
  digest=b3:ba8c9d054be128752f4a96f9092ff6bf8b474171494cbf8b0ce044202d906c6a file=executor/cmd/mcl-execute/daemon_shell_routes.go range=86:89 lang=go exported=true byte_range=3114:3336
  sig=time.Duration
  doc=IdleTimeout closes the session when no input arrives for this\nduration. Default 30 min — long enough for builds + tests, short\nenough that a forgotten tab doesn't hold a PTY forever.
EDGES
  ^contains=matrix/executor/cmd/mcl-execute.ForgeShellConfig

NODE id=matrix/executor/cmd/mcl-execute.ForgeShellConfig#MaxFrameBytes kind=field
  digest=b3:cbe6f6d9a0fc67ba3946b6a97c043fd32bc1c90cbb6a11721987faeb92d9c3e6 file=executor/cmd/mcl-execute/daemon_shell_routes.go range=91:95 lang=go exported=true byte_range=3339:3614
  sig=int64
  doc=MaxFrameBytes caps how much data the daemon will accept per\ninbound WS frame; defends against a malicious client streaming\ngigabytes of input. Default 64 KiB (one frame ≈ pasted shell\ncommand, far larger than any realistic key sequence).
EDGES
  ^contains=matrix/executor/cmd/mcl-execute.ForgeShellConfig

NODE id=matrix/executor/cmd/mcl-execute.ForgeShellConfig#MaxOutputFrameBytes kind=field
  digest=b3:c2b46de51938fc7909de064a967e526b75c98f449037744f16a1fafe089d6410 file=executor/cmd/mcl-execute/daemon_shell_routes.go range=97:100 lang=go exported=true byte_range=3617:3828
  sig=int
  doc=MaxOutputFrameBytes is the chunk size used when forwarding PTY\noutput to the client. Smaller = lower latency, larger = fewer\nframes; 4 KiB is a sweet spot for xterm rendering.
EDGES
  ^contains=matrix/executor/cmd/mcl-execute.ForgeShellConfig

NODE id=matrix/executor/cmd/mcl-execute.ForgeShellConfig#Shell kind=field
  digest=b3:5c73bbbd54c54835704421c3e70ba3ef1bfe0c69cfda1e619045ec1f4da82b2e file=executor/cmd/mcl-execute/daemon_shell_routes.go range=82:84 lang=go exported=true byte_range=2973:3111
  sig=string
  doc=Shell is the binary to exec inside the PTY. Empty falls back to\n$MATRIX_FORGE_SHELL env, then $SHELL, then /bin/bash.
EDGES
  ^contains=matrix/executor/cmd/mcl-execute.ForgeShellConfig

NODE id=matrix/executor/cmd/mcl-execute.GideonOpsPolicy kind=type
  digest=b3:20f8fde75ab0765ca0a6f74d3841a653e5cea1e539239ef6239cb692af277f99 file=executor/cmd/mcl-execute/gideon_ops_policy.go range=93:115 lang=go exported=true byte_range=3369:4477
  sig=type GideonOpsPolicy struct {\n	// ChainStateLossPatterns is the allowlist of command-string regexes\n	// that classify a tool call as a chain-state-loss risk → forced\n	// gate. Matched case-insensitively against the ssh_exec `command`.\n	ChainStateLossPatterns	[]namedPattern\n\n	// ValidatorHostIDs are hosts.json ids treated as the untouchable\n	// validator cluster. Matched case-insensitively against `host`.\n	ValidatorHostIDs	[]string\n\n	// ValidatorAddrs are raw addresses/IPs that also resolve to the\n	// validator cluster (a `host` arg may carry an IP instead of an id).\n	ValidatorAddrs	[]string\n\n	// MutatingTools is the set of tool names that perform a write /\n	// restart / exec / ssh action. Only these trigger the validator\n	// hard-deny; read-only tools (node_status, metrics_read, log_tail,\n	// RPC reads) are always permitted, including against the validators.\n	MutatingTools	map[string]bool\n}
  doc=GideonOpsPolicy encodes the two hard guardrails. Built once\n(DefaultGideonOpsPolicy) and held on daemonState; immutable at\nruntime so it is safe to share across the scheduler + HTTP goroutines.
EDGES
  contains=matrix/executor/cmd/mcl-execute.GideonOpsPolicy#ChainStateLossPatterns,matrix/executor/cmd/mcl-execute.GideonOpsPolicy#MutatingTools,matrix/executor/cmd/mcl-execute.GideonOpsPolicy#ValidatorAddrs,matrix/executor/cmd/mcl-execute.GideonOpsPolicy#ValidatorHostIDs,matrix/executor/cmd/mcl-execute.GideonOpsPolicy.Evaluate,matrix/executor/cmd/mcl-execute.GideonOpsPolicy.isValidatorHost,matrix/executor/cmd/mcl-execute.GideonOpsPolicy.matchChainStateLoss,matrix/executor/cmd/mcl-execute.GideonOpsPolicy.proseNamesValidator
