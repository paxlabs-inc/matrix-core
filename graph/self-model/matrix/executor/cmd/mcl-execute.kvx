NODE id=matrix/executor/cmd/mcl-execute.daemonState.authorizeShellRequest kind=method
  digest=b3:ef0d69edaadad4ee805879ab97306da615cc610f9b2911c9743341c14526d231 file=executor/cmd/mcl-execute/daemon_shell_routes.go range=386:419 lang=go exported=false byte_range=12575:13910
  sig=func (d *daemonState) authorizeShellRequest(w http.ResponseWriter, r *http.Request) bool
  doc=authorizeShellRequest validates either Authorization: Bearer or the\nSec-WebSocket-Protocol "auth.bearer.<token>" entry. Returns true iff\nthe client is authorized; otherwise writes a 401 + returns false.\n\nThe subprotocol path is the LOAD-BEARING one for the browser SPA\nbecause `new WebSocket()` doesn't accept custom headers. Browsers\npass the protocols array; the daemon's upgrader echoes back the\nchosen subprotocol ("matrix-shell.v1") on the handshake, so the\nauth marker doesn't need to ride the chosen protocol — just the\noffered list.
EDGES
  ^contains=matrix/executor/cmd/mcl-execute.daemonState
  ^defines=matrix/executor/cmd/mcl-execute/daemon_shell_routes.go

NODE id=matrix/executor/cmd/mcl-execute.daemonState.callLiaison kind=method
  digest=b3:dd51b374e2bab0c972720d5fcfb5200f2a4aa6ca210a0c66b30f3e16663569b3 file=executor/cmd/mcl-execute/daemon_liaison.go range=61:119 lang=go exported=false byte_range=1968:4593
  sig=func (d *daemonState) callLiaison(ctx context.Context, intentID, goalID string, t *transcript, system, user string) (answer, reasoning string, err error)
  doc=callLiaison runs one non-streaming Liaison completion. Mirrors the\ngateway-routing wiring of compile.go / synthesize.go: SlotLiaison is\nmetered under the gateway's "liaison" free-tier whitelist. Returns the\nclean answer and, separately, any model reasoning (chain-of-thought)\nso callers can surface it as a DISTINCT channel — never as the answer.\nintentID/goalID are echoed as X-Matrix-* headers for cost telemetry;\nacc is nil because the Liaison is a side-channel and its spend is\nfolded into the same intent via the cost hook.
EDGES
  ^contains=matrix/executor/cmd/mcl-execute.daemonState
  ^defines=matrix/executor/cmd/mcl-execute/daemon_liaison.go

