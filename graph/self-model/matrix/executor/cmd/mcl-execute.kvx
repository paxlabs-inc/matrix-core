  digest=b3:72f2b1b55bc9d53ad34ffe273125e2beb4dfe131f9ce73f5b294ece0b7d9d62f file=executor/cmd/mcl-execute/daemon_git_routes.go range=589:605 lang=go exported=false byte_range=17967:18597
  sig=func runGit(ctx context.Context, cwd string, args ...string) (string, error)
  doc=runGit shells `git` with the given args inside cwd (the policy repo).\nReturns stdout+stderr concat (git's status output goes to stdout;\nerrors typically to stderr; we want both for the SPA + audit feed).
