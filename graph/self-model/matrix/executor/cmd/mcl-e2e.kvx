NODE id=matrix/executor/cmd/mcl-e2e.VerifyReplayInvariant kind=func
  digest=b3:d2a260d2be10b0932adca3364000609003f06030e6bf23c343bb3b5e5ed20260 file=executor/cmd/mcl-e2e/replay.go range=14:74 lang=go exported=true byte_range=260:2592
  sig=func VerifyReplayInvariant(c *cortex.Cortex, t *Transcript, assert *AssertCtx) (preHex, postHex string, err error)
  doc=VerifyReplayInvariant exercises the §13.4 byte-identical replay path:\n 1. Stop the embedder (Phase 11 invariant: Rebuild requires no embedder).\n 2. Take a final snapshot for audit.\n 3. Capture pre-rebuild OverallRoot.\n 4. Run cortex.Rebuild — drops indexes/, walks j/, re-derives every\n    derived projection.\n 5. Verify Pre==Post via replay.VerifyPreservesRoot.\n\nReturns Pre/Post for the assertion layer to log + diff.
EDGES
  ^defines=matrix/executor/cmd/mcl-e2e/replay.go

NODE id=matrix/executor/cmd/mcl-e2e.WalkPlan kind=func
  digest=b3:04148a88a472dfbf050c3887f0aada07e316a7dc8d018680ef8a44201874aa73 file=executor/cmd/mcl-e2e/walk.go range=31:48 lang=go exported=true byte_range=668:1540
  sig=func WalkPlan(ctx context.Context, plan *ir.PlanTree, reg *tool.Registry, c *cortex.Cortex, drv *LifecycleDriver, actorURI string, t *Transcript) (*WalkResult, error)
  doc=WalkPlan walks the tree depth-first (with concurrent dispatch on parallel\nbranches), invokes every ToolCall via the registry, journals each result\ninto a cortex Event memory, and signs a plan.step envelope per node.\n\nSteps + Gates + SubDispatch nodes are skipped (the harness runs without a\nreal executor model + without sub-agents); they're recorded in the\ntranscript so the kind-coverage shows up in the post-run audit.
EDGES
  ^defines=matrix/executor/cmd/mcl-e2e/walk.go

NODE id=matrix/executor/cmd/mcl-e2e.WalkResult kind=type
  digest=b3:987c61b68225cb7f3bbaf82472844ca750998fe8257d070b850e34709e6ceb76 file=executor/cmd/mcl-e2e/walk.go range=21:29 lang=go exported=true byte_range=363:666
  sig=type WalkResult struct {\n	NodeIDs		[]string\n	EventURIs	[]memory.URI\n	ToolDurations	map[string]int64\n	Errors		map[string]string\n	IsErrors	map[string]bool\n}
  doc=WalkResult collects the per-node outcomes of a manual plan walk so the\nattest stage can cite the resulting Event memories.
EDGES
  contains=matrix/executor/cmd/mcl-e2e.WalkResult#Errors,matrix/executor/cmd/mcl-e2e.WalkResult#EventURIs,matrix/executor/cmd/mcl-e2e.WalkResult#IsErrors,matrix/executor/cmd/mcl-e2e.WalkResult#NodeIDs,matrix/executor/cmd/mcl-e2e.WalkResult#ToolDurations
