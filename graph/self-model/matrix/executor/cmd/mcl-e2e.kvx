NODE id=matrix/executor/cmd/mcl-e2e.SeedCortex kind=func
  digest=b3:862f39a1a920098e5057dd369779070a4916499c3fb0cba8c22b9d5344778313 file=executor/cmd/mcl-e2e/cortex_seed.go range=48:179 lang=go exported=true byte_range=1360:5538
  sig=func SeedCortex(c *cortex.Cortex, actorURI string, t *Transcript) ([]memory.URI, error)
  doc=SeedCortex writes the baseline knowledge-graph state every run starts\nwith. Same memories, same order, same content → byte-identical\nOverallRoot post-seed across all runs sharing the same FixedClock +\nSeededIDGen. The embedder is started AFTER seeding (and DrainEmbedder\nruns once) so vector writes are also captured into the deterministic\ninitial state.\n\nReturns the seed URIs (in write order) so attest can cite them by ref.
EDGES
  ^defines=matrix/executor/cmd/mcl-e2e/cortex_seed.go

NODE id=matrix/executor/cmd/mcl-e2e.SeedGitRepo kind=func
  digest=b3:44003a5652032325a091799cc414890d672326895c2c22d45a2f2c7215ab73e6 file=executor/cmd/mcl-e2e/setup.go range=101:127 lang=go exported=true byte_range=3357:4307
  sig=func SeedGitRepo(dir string) error
  doc=SeedGitRepo initializes the git-mcp jail with one commit so git_log/git_status\nhave something real to report.
EDGES
  ^defines=matrix/executor/cmd/mcl-e2e/setup.go

NODE id=matrix/executor/cmd/mcl-e2e.SeededIDGen kind=func
  digest=b3:0fda9ee275d9ace7d369d8526621efa64c448a31d03fb7b870a24d67d6449271 file=executor/cmd/mcl-e2e/cortex_seed.go range=23:46 lang=go exported=true byte_range=510:1358
  sig=func SeededIDGen(initial uint64) func() memory.ID
  doc=SeededIDGen returns a memory.NewID-compatible generator backed by a\ndeterministic counter so cortex memory IDs are byte-stable across runs.\n\nmemory.ID is a 16-byte ULID; we synthesize one from a 6-byte big-endian\ntimestamp + 10-byte big-endian counter. Format-compatible with oklog/ulid\nat the byte level (which the cortex store treats as opaque bytes).
EDGES
  ^defines=matrix/executor/cmd/mcl-e2e/cortex_seed.go

