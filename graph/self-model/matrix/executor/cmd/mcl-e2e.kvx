  ^defines=matrix/executor/cmd/mcl-e2e/setup.go

NODE id=matrix/executor/cmd/mcl-e2e.BuildPlan kind=func
  digest=b3:37c107d5f20f84bc69f05d774e75d659698805f4c32b53a195c86d0e7ef28c56 file=executor/cmd/mcl-e2e/plan.go range=13:149 lang=go exported=true byte_range=228:4786
  sig=func BuildPlan(intentID, agentURI, skillRef, fsJail, gitRepoDir string) (*ir.PlanTree, error)
  doc=BuildPlan constructs the hand-authored PlanTree the harness walks. It\nexercises all three real MCP servers (fs, fetch, git) plus a parallel\nbranch and a sub-dispatch placeholder so plan_validate covers the full\nnode-kind matrix.\n\nConcretely, the root is Sequential with 4 children:\n\n 1. Sequential (fs roundtrip): list_directory → write_file → read_text_file\n 2. Parallel (concurrent reads): get_file_info on README.md  (fs)\n    git_status (git)\n 3. ToolCall fetch_url (fetch)\n 4. Step in-skill prompt (no LLM call here; just validates the kind path)\n\nEvery ToolCall has an explicit SideEffectClass so the capability gate\nfires at Registry.Get time.
EDGES
  ^defines=matrix/executor/cmd/mcl-e2e/plan.go

