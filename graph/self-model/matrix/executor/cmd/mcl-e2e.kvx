  sig=type Transcript struct {\n	mu	sync.Mutex\n	file	*os.File\n	enc	*json.Encoder\n	mirror	bool\n	seq	uint64\n	run	string\n}
  doc=Transcript writes one JSON object per line to a file (and optionally stderr\nfor live tailing). Every event includes a monotonic seq + wall-clock + the\ncaller-supplied phase tag so post-run greps can slice by phase.
