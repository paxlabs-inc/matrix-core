NODE id=matrix/cortex/store.WriteBatch.Abort kind=method
  digest=b3:9665cf255dc028d176b4ae45c23449efdce9591a7b7390230fecedb1b523deb0 file=cortex/store/writebatch.go range=204:213 lang=go exported=true byte_range=7595:7852
  sig=func (wb *WriteBatch) Abort()
  doc=Abort releases the batch without committing. Safe to call after Commit\n(becomes a no-op). Always safe in a `defer wb.Abort()` line.
