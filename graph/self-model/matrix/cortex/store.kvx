  ^contains=matrix/cortex/store.WriteBatch
  ^defines=matrix/cortex/store/writebatch.go

NODE id=matrix/cortex/store.WriteBatch.AppendJournal kind=method
  digest=b3:c1cfaf403f1a5256dcd5f0bcae722c65fbb809069374a01657fbda56d8773de0 file=cortex/store/writebatch.go range=107:164 lang=go exported=true byte_range=4154:6350
  sig=func (wb *WriteBatch) AppendJournal(e *journal.Entry) error
  doc=AppendJournal canonical-encodes e (filling Seq from the batch), writes it\nto j/<seq>, and writes meta/journal_head=seq+1. May be called more than\nonce per batch — each call consumes the next seq in the batch's pre-\nallocated range, and meta/journal_head is rewritten to the last-\nappended-seq+1 (Pebble overwrite semantics: the final value wins on\ncommit). Must be called at least once before Commit (the replay\ninvariant: every store mutation MUST be journaled).\n\nMultiple-append usage: cortex.Attest (KindAttest at seq=N then\nKindLearnWeights at seq=N+1) is the canonical case. Other callers\nappend exactly once.
EDGES
  ^contains=matrix/cortex/store.WriteBatch
  ^defines=matrix/cortex/store/writebatch.go

NODE id=matrix/cortex/store.WriteBatch.Commit kind=method
  digest=b3:a09d467c4a05349beecd67dab6ee2d85691f07703d9b86d6010f80dd2206a8ea file=cortex/store/writebatch.go range=181:202 lang=go exported=true byte_range=6925:7593
  sig=func (wb *WriteBatch) Commit() error
  doc=Commit flushes the batch to disk with Pebble's Sync option. On success the\nstore's nextSeq advances to lastSeq+1 (i.e. by the number of journal\nentries appended); on failure the batch is closed and seqMu is released,\nbut nextSeq does not advance (so the same seq range can be reused).
EDGES
  ^contains=matrix/cortex/store.WriteBatch
  ^defines=matrix/cortex/store/writebatch.go

NODE id=matrix/cortex/store.WriteBatch.Delete kind=method
  digest=b3:a7ecd0a2d3b3db03b5bc743f0e4ba790178f757980ef1be8f7eb1295e2f8f639 file=cortex/store/writebatch.go range=98:105 lang=go exported=true byte_range=3883:4152
  sig=func (wb *WriteBatch) Delete(key []byte) error
  doc=Delete adds a key deletion to the batch. Reserved for tombstone-related\nflows; ordinary memory writes never delete primary records.
EDGES
  ^contains=matrix/cortex/store.WriteBatch
  ^defines=matrix/cortex/store/writebatch.go

NODE id=matrix/cortex/store.WriteBatch.LeafHash kind=method
  digest=b3:61c2d57d811aca7dc11ce7b76b18b1f34b6dc4be6e1f5aff42710a1f88711b09 file=cortex/store/writebatch.go range=175:179 lang=go exported=true byte_range=6599:6923
  sig=func (wb *WriteBatch) LeafHash() [32]byte
  doc=LeafHash returns the journal leaf hash computed by the most recent\nAppendJournal call on this batch. Returns the zero hash before\nAppendJournal is called or when no hook recorded a hash. Useful for\ncallers that want to log the leaf hash for audit.
EDGES
  ^contains=matrix/cortex/store.WriteBatch
  ^defines=matrix/cortex/store/writebatch.go

NODE id=matrix/cortex/store.WriteBatch.Seq kind=method
  digest=b3:d00ec12c01e7e666ca20a2149517e723b37d2d36fcbbe3233960d02b7ebae787 file=cortex/store/writebatch.go range=77:82 lang=go exported=true byte_range=3049:3441
  sig=func (wb *WriteBatch) Seq() uint64
  doc=Seq returns the seq of the most recently appended journal entry, or the\nnext-to-allocate seq if no AppendJournal has been called yet. Stable\nafter the most recent AppendJournal on this batch; callers that need\nthe matching seq for an entry should call Seq() IMMEDIATELY after the\nAppendJournal that wrote that entry.
EDGES
  ^contains=matrix/cortex/store.WriteBatch
  ^defines=matrix/cortex/store/writebatch.go

NODE id=matrix/cortex/store.WriteBatch.Set kind=method
  digest=b3:8b137cfeeea05ab2099139ca15b9305777a449b8503ee51cd429e20c56e5b275 file=cortex/store/writebatch.go range=84:96 lang=go exported=true byte_range=3443:3881
  sig=func (wb *WriteBatch) Set(key, value []byte) error
  doc=Set adds a key/value to the batch. Mirrors pebble.Batch.Set. Values in\nuser-content namespaces are sealed at rest here — callers hash the\nplaintext encoding they pass in, so all anchoring stays above this seam.
EDGES
  ^contains=matrix/cortex/store.WriteBatch
  ^defines=matrix/cortex/store/writebatch.go

NODE id=matrix/cortex/store.WriteBatch.seqGetter kind=method
