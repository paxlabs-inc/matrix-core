  sig=func (wb *WriteBatch) seqGetter() uint64
  doc=seqGetter returns wb.lastSeq if there has been at least one AppendJournal\ncall, otherwise startSeq (the to-be-allocated seq).
EDGES
  ^contains=matrix/cortex/store.WriteBatch
  ^defines=matrix/cortex/store/writebatch.go

