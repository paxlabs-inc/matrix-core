  digest=b3:06b32ccb88f61bc136e2c75c8196c131cc2dc38d1f11610f301cafc16202ccfd file=cortex/scope/match.go range=10:64 lang=go exported=true byte_range=220:1567
  sig=func (sel *Selector) Matches(h *memory.Head) bool
  doc=Matches returns true if the candidate Head satisfies AT LEAST ONE\ncriterion populated on sel. Empty selectors NEVER match anything —\ncallers must populate at least one of {Types, Tags, IDs, Frame} for\na Selector to be useful.\n\nSet-union semantics across populated criteria; per-criterion\nsemantics:\n\n  - Types: head.Type ∈ sel.Types\n  - Tags:  any tag in head.Tags appears in sel.Tags (case-sensitive)\n  - IDs:   head.ID ∈ sel.IDs\n  - Frame: any FrameRef on head.Frames matches sel.Frame.Verb AND\n    its 16-byte ObjHash is in sel.Frame.ObjHashes\n\nEmpty-selector returns false. For include semantics this manifests\nas "no access"; for exclude semantics as "no extra deny".
EDGES
  ^contains=matrix/cortex/scope.Selector
  ^defines=matrix/cortex/scope/match.go

NODE id=matrix/cortex/scope.Sign kind=func
  digest=b3:b565d314f915c3864095990b75f53ffec81c6ba09a59e46f0bc63792c942b431 file=cortex/scope/scope.go range=214:228 lang=go exported=true byte_range=8623:9189
  sig=func Sign(s *Scope, priv ed25519.PrivateKey) error
  doc=Sign sets s.Signature to the ed25519 signature of UnsignedBytes(s)\nunder priv. Returns an error if the unsigned bytes cannot be\nproduced. Used by tests + the agent runtime / CLI; cortex itself\nnever calls this (no key material at the cortex layer per D4).
EDGES
  ^defines=matrix/cortex/scope/scope.go

NODE id=matrix/cortex/scope.StaticKeyResolver kind=type
  digest=b3:d2b2682a2eb89e08aecc671e8719552f1e935adb9837da11b5ff4f9fb17e1a1d file=cortex/scope/verify.go range=26:29 lang=go exported=true byte_range=763:1005
  sig=type StaticKeyResolver map[string]ed25519.PublicKey
  doc=StaticKeyResolver maps known refs to known public keys. Used by\ntests and the CLI; production swaps in a registry-backed resolver.\nMap values must be ed25519 public keys (32 bytes).
EDGES
  contains=matrix/cortex/scope.StaticKeyResolver.ResolveAgentKey
  implements=matrix/cortex/scope.KeyResolver
  ^defines=matrix/cortex/scope/verify.go

NODE id=matrix/cortex/scope.StaticKeyResolver.ResolveAgentKey kind=method
  digest=b3:3ef94dfa89ea6dbbbc2d6317a45c9ae36c7b8b0f2bfa7fb89333949e9958f12d file=cortex/scope/verify.go range=31:41 lang=go exported=true byte_range=1007:1369
  sig=func (s StaticKeyResolver) ResolveAgentKey(ref string) (ed25519.PublicKey, error)
  doc=ResolveAgentKey implements KeyResolver.
EDGES
  ^contains=matrix/cortex/scope.StaticKeyResolver
  ^defines=matrix/cortex/scope/verify.go

NODE id=matrix/cortex/scope.UnsignedBytes kind=func
  digest=b3:2e07d9edeb579171601448ccccf2393dc2443230949f53f4b806364ac9f7cac3 file=cortex/scope/scope.go range=199:212 lang=go exported=true byte_range=8123:8621
  sig=func UnsignedBytes(s *Scope) ([]byte, error)
  doc=UnsignedBytes returns the canonical CBOR encoding of s with\nSignature explicitly cleared. This is the message that GrantedBy's\ned25519 key signs (and that VerifySignature checks against).\n\nThe returned bytes deliberately retain the SchemaVersion field so\nsignature replays across schema versions are blocked.
EDGES
  ^defines=matrix/cortex/scope/scope.go

NODE id=matrix/cortex/scope.Verify kind=func
  digest=b3:684ce953346be1263215aba27970d8c5e394202b731dc035e2da811ae96f70bf file=cortex/scope/verify.go range=58:123 lang=go exported=true byte_range=1969:4080
  sig=func Verify(s *Scope, snapState *snapshot.State, resolver KeyResolver, opts VerifyOpts) error
  doc=Verify runs the full scope verification chain (research/06-agents.md\n§7.2). Returns nil iff:\n\n 1. SchemaVersion matches the package constant.\n 2. Include is non-empty (at least one criterion populated).\n 3. Now ≤ ExpiresAt (or ExpiresAt is zero).\n 4. Signature is a valid ed25519 sig from GrantedBy's pubkey over\n    UnsignedBytes(s).\n 5. SnapshotHash is resolvable: there exists a snap/<seq> manifest\n    with OverallRoot == SnapshotHash. Skipped if\n    opts.SkipSnapshotResolution.\n 6. If Proofs is non-nil:\n    - len(Proofs.Proofs) == len(Include.IDs)\n    - each proof's KeyHash matches snapshot.HashMemoryKey(IDs[i])\n    - Proofs.VerifyAgainstManifest(found-manifest) passes\n\nVerify does NOT enforce against any specific memory — that is the\nper-read enforcement done by Scope.Allows / cortex.enforceScope.
EDGES
  ^defines=matrix/cortex/scope/verify.go

NODE id=matrix/cortex/scope.VerifyOpts kind=type
  digest=b3:e0030a4bc7635b7f9b78e1c5972a9b240af28eb0de718fb41bc0910ce8adaeb6 file=cortex/scope/verify.go range=43:56 lang=go exported=true byte_range=1371:1967
  sig=type VerifyOpts struct {\n	// Now is the wall-clock used for expiry comparison. Zero defers\n	// to time.Now(). Tests always populate this for determinism.\n	Now	time.Time\n\n	// SkipSnapshotResolution skips the FindSnapshotByRoot check.\n	// Reserved for replay tooling that walks the journal forward and\n	// already knows the snapshot existed; never used on the hot read\n	// path. Default false.\n	SkipSnapshotResolution	bool\n}
  doc=VerifyOpts holds the optional inputs to Verify. Required inputs (the\nScope, the snapshot.State, the resolver) are positional on Verify\nfor clarity at the call site.
EDGES
  contains=matrix/cortex/scope.VerifyOpts#Now,matrix/cortex/scope.VerifyOpts#SkipSnapshotResolution
  ^defines=matrix/cortex/scope/verify.go

NODE id=matrix/cortex/scope.VerifyOpts#Now kind=field
  digest=b3:9e5ee19c33e7dc133fb751a60d58c99f6a44ce3545e59f64f4c38ee85b12aa97 file=cortex/scope/verify.go range=47:49 lang=go exported=true byte_range=1571:1713
  sig=time.Time
  doc=Now is the wall-clock used for expiry comparison. Zero defers\nto time.Now(). Tests always populate this for determinism.
EDGES
  ^contains=matrix/cortex/scope.VerifyOpts

NODE id=matrix/cortex/scope.VerifyOpts#SkipSnapshotResolution kind=field
  digest=b3:58bc7c14330d6736d8200c48b8fc2ecd5002e5f20d70469995a224478f4310f8 file=cortex/scope/verify.go range=51:55 lang=go exported=true byte_range=1716:1965
  sig=bool
  doc=SkipSnapshotResolution skips the FindSnapshotByRoot check.\nReserved for replay tooling that walks the journal forward and\nalready knows the snapshot existed; never used on the hot read\npath. Default false.
EDGES
  ^contains=matrix/cortex/scope.VerifyOpts

NODE id=matrix/cortex/scope.VerifySignature kind=func
  digest=b3:6c7be3f9dfb443f0dfc99da0b8fed6097d481df02b1b2c58ff7572ea28abf72c file=cortex/scope/scope.go range=230:251 lang=go exported=true byte_range=9191:9927
  sig=func VerifySignature(s *Scope, pub ed25519.PublicKey) error
  doc=VerifySignature checks that s.Signature is a valid ed25519 signature\nfrom pub over UnsignedBytes(s). Returns ErrSignatureInvalid on any\nmismatch (length, key, message).
EDGES
  ^defines=matrix/cortex/scope/scope.go

