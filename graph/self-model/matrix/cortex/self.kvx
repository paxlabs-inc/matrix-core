NODE id=matrix/cortex/self.Persona kind=func
  digest=b3:0d84a1a867a3a0e37841ffc7cc235f791fb9d3ebb04d5e518d2e24b6d9c1fce7 file=cortex/self/self.go range=140:157 lang=go exported=true byte_range=5510:6517
  sig=func Persona(m SelfModel) string
  doc=Persona renders the canonical first-person identity charter — the identity\nfacet of the shared self-model. It is the SINGLE source of the agent's\nuser-facing self-description, so every faculty that speaks as the agent\nderives its persona from here rather than a hand-written duplicate that\ndrifts from reality (req.7.1).\n\nThe persona is intentionally a function of the model's IDENTITY facet only,\nnever the structural one: the user talks to a product (Matrix), not to a\npackage graph, so the prose stays machinery-free and leaks no internal\nstructure (req.7.2). The internal codename (m.Identity, default Neo) is what\nthe identity canary anchors on; the user-facing brand below is Matrix.
EDGES
  ^defines=matrix/cortex/self/self.go

NODE id=matrix/cortex/self.Resolve kind=func
  digest=b3:92f8576894efabc7cce068e781b42301f4a0b1046e05de9f90fa9ae0e327720a file=cortex/self/self.go range=94:138 lang=go exported=true byte_range=3956:5508
  sig=func Resolve(cx *cortex.Cortex, agentName string) (SelfModel, error)
  doc=Resolve reads the shared self-model from a cortex store. agentName seeds the\nidentity name (falling back to DefaultName); the structural summary and the\nfailure patterns are collected from the durable memories under Subject. This\nis the ONE resolver every faculty calls, so two faculties reading the same\nstore observe byte-identical self-knowledge (req.6.4).
EDGES
  ^defines=matrix/cortex/self/self.go

