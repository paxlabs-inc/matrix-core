  digest=b3:4ceba7b4c4c6a097b034d0e726a58616e492716f7c6a78550d7046d8240957b1 file=cortex/salience/salience.go range=69:72 lang=go exported=true byte_range=2868:3081
  sig=uint8
  doc=WeightsSchemaVersion is bumped on any incompatible Weights-encoding\nchange. Bump invalidates every actor's learned weights → fallback to\nDefaultWeights at next read.
