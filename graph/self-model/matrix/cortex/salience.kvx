NODE id=matrix/cortex/salience.Weights kind=type
  digest=b3:b087617321780d6e83926ffd5fe6871afbe97a9c71d7713d3c526e0501ee658c file=cortex/salience/salience.go range=81:94 lang=go exported=true byte_range=3424:4169
  sig=type Weights struct {\n	SchemaVersion	uint8	`cbor:"0,keyasint"`\n	WR		float32	`cbor:"1,keyasint"`	// recency\n	WA		float32	`cbor:"2,keyasint"`	// access\n	WC		float32	`cbor:"3,keyasint"`	// citations\n	WD		float32	`cbor:"4,keyasint"`	// declared importance\n	WV		float32	`cbor:"5,keyasint"`	// vector similarity\n	UpdatedAt	int64	`cbor:"6,keyasint,omitempty"`\n	Updates		uint64	`cbor:"7,keyasint,omitempty"`\n}
  doc=Weights is the per-actor learned weight set persisted at\nmeta/salience_weights. WR+WA+WC+WD+WV must sum to 1.0 (renormalised on\nevery UpdateWeightsEMA). UpdatedAt + Updates are advisory audit fields,\nnot part of the math — the journal-of-record is KindLearnWeights.
EDGES
  contains=matrix/cortex/salience.Weights#SchemaVersion,matrix/cortex/salience.Weights#UpdatedAt,matrix/cortex/salience.Weights#Updates,matrix/cortex/salience.Weights#WA,matrix/cortex/salience.Weights#WC,matrix/cortex/salience.Weights#WD,matrix/cortex/salience.Weights#WR,matrix/cortex/salience.Weights#WV
  ^defines=matrix/cortex/salience/salience.go

