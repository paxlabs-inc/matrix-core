NODE id=matrix/cortex/salience.ZeroForTombstone kind=func
  digest=b3:a41ecab52ef6c2ac926088373e0be83e04a80fa87c03eae9397e5bf23620b8e2 file=cortex/salience/salience.go range=525:533 lang=go exported=true byte_range=19119:19554
  sig=func ZeroForTombstone(s *Score, now time.Time)
  doc=ZeroForTombstone collapses a Score to a tombstoned-equivalent state. We\nkeep the record (as opposed to deleting it) so that operational replay\nfrom journal+m/+mv/ produces a byte-identical salience namespace; deleting\nwould require an explicit tombstone marker in the salience namespace too,\nwhich is unnecessary complexity.
EDGES
  ^defines=matrix/cortex/salience/salience.go

NODE id=matrix/cortex/salience.canonicalDec kind=var
  digest=b3:dcdd8cc7cd99193be8e275aa339d7a71b3555ade1b84b89a33117ed2ddff3826 file=cortex/salience/salience.go range=174:179 lang=go exported=false byte_range=7303:7537
  sig=cbor.DecMode
  doc=canonicalEnc / canonicalDec ensure Score encodes deterministically so the\ncached bytes hash identically across processes (matters for snapshot\nintegrity in Phase 7).
EDGES
  ^defines=matrix/cortex/salience/salience.go

NODE id=matrix/cortex/salience.canonicalEnc kind=var
  digest=b3:5094b9935714df28122dd888d216c646b14c0af42e56adf96c0ab38fc53174f0 file=cortex/salience/salience.go range=174:178 lang=go exported=false byte_range=7303:7510
