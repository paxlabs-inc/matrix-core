  ^defines=matrix/cortex/salience/salience.go

NODE id=matrix/cortex/salience.factorProfile kind=func
  digest=b3:24b082f5a6a2cad24e4d7aa2ae8ef5b717207c93ea4598cf99ff19bd6177cdae file=cortex/salience/salience.go range=330:344 lang=go exported=false byte_range=11909:12477
  sig=func factorProfile(s *Score, now time.Time) [4]float32
  doc=factorProfile returns the (R, A, C, D) factor contributions for one\nScore at the given clock, normalised against the cold-weight denominator.\nV is omitted (Phase 12 trains four-factor only; vector signal lands when\nV-aware Find ranking lands in a later phase). Returned slice always has\nlength 4 in order WR, WA, WC, WD.
EDGES
  ^defines=matrix/cortex/salience/salience.go

