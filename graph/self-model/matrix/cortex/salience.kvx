NODE id=matrix/cortex/salience.HalfLifeNanos kind=const
  digest=b3:80cd8e1af0c67d33653c2f08b9b3500225836bf4bb07e54c8d0a01340b134bc1 file=cortex/salience/salience.go range=138:145 lang=go exported=true byte_range=5359:5915
  sig=int64
  doc=HalfLifeNanos is the recency time constant from §8.1: 90 days. The spec\nformula is `exp(-Δt / half_life)`; despite the label, this is a 1/e decay\n(R drops to ~0.368 at one constant, not 0.5). Adopting the spec formula\nverbatim keeps cortex_snapshot_hash byte-identical with any independent\nre-implementation. If we ever switch to a strict-half-life decay\n(`exp(-Δt·ln2 / H)`), every salience cache entry needs recomputation —\nthat's a journaled migration, not a code change.
EDGES
  ^defines=matrix/cortex/salience/salience.go

