NODE id=matrix/cortex/salience.AccessSaturation kind=const
  digest=b3:d3fbdb491e2b9dd9c426733e9f8ccc16292570ed35a82b491b0551b3f2b6c911 file=cortex/salience/salience.go range=150:156 lang=go exported=true byte_range=6015:6461
  sig=untyped float
  doc=AccessSaturation is the denominator constant used to normalize\naccess_count and cite_in_successful_plans into [0,1]. We use a fixed\nconstant (not per-actor max) because the spec's max-based formula is\nunstable under cold start and creates ranking discontinuities when a\nsingle memory pulls the max upward. log(1+1000) is the saturation point\nwhere ranking gain approaches zero in practical loads.
EDGES
  ^defines=matrix/cortex/salience/salience.go

NODE id=matrix/cortex/salience.BumpForAccess kind=func
  digest=b3:3928b5af7ef12183eddb735648d504d7e464c07b26c2f79a728be8c5402a1fab file=cortex/salience/salience.go range=460:478 lang=go exported=true byte_range=16352:17249
  sig=func BumpForAccess(s *Score, now time.Time)
  doc=BumpForAccess increments AccessCount, advances LastUsed, and recomputes\nthe cached cold score. Fired per returned candidate from a LateBinding\nFind (research/04-cortex.md §8.1 input `access_count` + §8.4 cache\ninvalidation trigger). AccessCount saturates at math.MaxUint64; the\nlogSat normalizer floors the score contribution at 1.0 well before\nthen, so we just refuse to wrap rather than journal an overflow.\n\nPhase 11.5: this is the only path that feeds salience.AccessCount.\nCompile-time Find does NOT call this (research/04 §12 + Phase 3\ninvariant: compile-time Find does not journal); compile-time access\ngets accounted for downstream via cortex.Attest cited_uris.
EDGES
  ^defines=matrix/cortex/salience/salience.go

NODE id=matrix/cortex/salience.BumpForCitation kind=func
  digest=b3:11e3a7e5c33eee6d716f72616bb7cf010b31450448c97f27837a4c04eaa65510 file=cortex/salience/salience.go range=480:500 lang=go exported=true byte_range=17251:18132
  sig=func BumpForCitation(s *Score, now time.Time)
  doc=BumpForCitation increments Citations AND AccessCount, advances LastUsed,\nand recomputes the cached cold score. Fired per cited URI from a\nsuccessful cortex.Attest (research/04-cortex.md §8.3 verbatim: "For\neach `cited` memory in the plan, increment `cite_in_successful_plans`").\n\nAccessCount also goes up because a citation implies an access — the\nagent had to read the memory to cite it. Bundling the two bumps in a\nsingle primitive keeps the salience cache consistent across the\nFind→Attest path: a memory found via late-binding Find and then cited\nin a successful attest has both signals reflected.
EDGES
  ^defines=matrix/cortex/salience/salience.go

NODE id=matrix/cortex/salience.BumpForUpdate kind=func
  digest=b3:1307ec1ca2ba9cfd7ae0e3012d7956b906a0c750b21b9ac2942d02a7709d8c54 file=cortex/salience/salience.go range=451:458 lang=go exported=true byte_range=16034:16350
  sig=func BumpForUpdate(s *Score, importance uint8, now time.Time)
  doc=BumpForUpdate refreshes a Score after a memory's Data was updated.\nLastUsed advances to now and the cached value is recomputed.
EDGES
  ^defines=matrix/cortex/salience/salience.go

NODE id=matrix/cortex/salience.ColdScore kind=func
  digest=b3:bf2752bca45130ae92c4866ef0a4ee12e0a77a475d2f158918f5ef11190d726d file=cortex/salience/salience.go range=230:242 lang=go exported=true byte_range=8628:9252
  sig=func ColdScore(s *Score, now time.Time) float32
  doc=ColdScore computes salience(m) using the cold (default) weights with V\nskipped (no q.near). Preserved for source-compat with Phase 3+ callers;\ninternally delegates to ColdScoreWith.\n\nLive ranking SHOULD prefer ColdScoreWith with the actor's learned\nWeights (loaded via ReadWeights) so EMA updates are honored. Bumpers\n(BumpForAccess/BumpForCitation/etc.) intentionally use this default-\nweights path for sc.Cached: per Phase 12 Q4, sc.Cached is a debug\nsnapshot, not the live ranking value.
EDGES
  ^defines=matrix/cortex/salience/salience.go

NODE id=matrix/cortex/salience.ColdScoreWith kind=func
  digest=b3:fc705c7b2c35a398580c85b95dc0038a8777631eb6419ae26b383553df3d51c3 file=cortex/salience/salience.go range=244:281 lang=go exported=true byte_range=9254:10419
  sig=func ColdScoreWith(s *Score, w Weights, now time.Time) float32
  doc=ColdScoreWith computes salience(m) using the supplied weights with V\nskipped (q.near unset). The non-vector weights are renormalised over\ntheir own sum so the final score lives in [0,1] regardless of what\nEMA has done to WV.\n\n§8.2 "vector weight gating" rule when q.near is unset: w5 is\nredistributed across the remaining weights proportionally. Equivalent\nto dividing the non-vector component by (WR+WA+WC+WD). Done here so\nthe formula is symmetric for both default and learned weights.\n\nPinned memories floor at PinnedFloor.
EDGES
  ^defines=matrix/cortex/salience/salience.go

NODE id=matrix/cortex/salience.ColdScoreWithV kind=func
  digest=b3:6c902850938a3791d68cf45ee249d0f382afb4ea74fb3cd28f6d794cd9318cc8 file=cortex/salience/salience.go range=283:328 lang=go exported=true byte_range=10421:11907
  sig=func ColdScoreWithV(s *Score, w Weights, dist float32, now time.Time) float32
  doc=ColdScoreWithV computes salience(m) using the supplied weights with the\nV (vector-similarity) term LIVE — the q.near-SET counterpart to\nColdScoreWith. The §8.1 V(m,q) = cos(embedding(m), embedding(q)) term is\nrecovered from the HNSW distance: distance is 1 - cosine in unit-norm\nspace (vector package), so v := 1 - dist/2 maps dist∈[0,2] back to a\ncosine-like proximity in [0,1] (dist=0 → v=1, dist=2 → v=0). v is clamped\nto [0,1] defensively.\n\nAll five weights already sum to 1.0 (DefaultWeights and the EMA\nrenormaliser both preserve this), so — unlike ColdScoreWith, which\nredistributes WV across the other four when q.near is unset — no\nrenormalisation denominator is applied here. Utility stays primary by\nweight (WC=0.30 citations, plus WR/WA/WD) dwarfing WV=0.10, so semantic\nproximity refines the utility ranking rather than dominating it.\n\nPinned memories floor at PinnedFloor; the result is clamped to [0,1].
EDGES
  ^defines=matrix/cortex/salience/salience.go

