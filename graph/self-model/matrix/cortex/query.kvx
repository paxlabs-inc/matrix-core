NODE id=matrix/cortex/query.withinValidity kind=func
  digest=b3:73ea5e372ada2a29f4cafa24aa1f89dd30970ab541dc1ff442d2c8f2275194b4 file=cortex/query/find.go range=673:683 lang=go exported=false byte_range=23405:24021
  sig=func withinValidity(v *memory.Version, asOf time.Time) bool
  doc=withinValidity reports whether v's bi-temporal valid-time interval and\nexpiry contain asOf (v3 #2). ValidFrom defaults to CreatedAt when nil;\nValidUntil nil means "still valid"; ExpiresAt nil means "never expires".\nThe valid interval is half-open [ValidFrom, ValidUntil) so a supersession\nthat stamps ValidUntil = successor.ValidFrom leaves no overlap at the\nboundary instant. ExpiresAt — dead since Phase 2 — is finally honored\nhere with the same at/after-close semantics.
EDGES
  ^defines=matrix/cortex/query/find.go

