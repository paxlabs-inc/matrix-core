NODE id=matrix/cortex/query.scalarEq kind=func
  digest=b3:ac5e14181c2b9c2f1fc6dfcbdd15ce7d6b2b354e402440ef52039453dc15d399 file=cortex/query/eval.go range=383:420 lang=go exported=false byte_range=9877:11144
