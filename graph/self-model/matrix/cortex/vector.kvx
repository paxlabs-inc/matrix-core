  digest=b3:4210d0e577ac3f89d95ddf1dff07f618631cd3f914b5046c3b7b54dbd23b2baf file=cortex/vector/vector.go range=270:289 lang=go exported=false byte_range=9541:10076
  sig=func (i *Index) chooseLevel() int
  doc=chooseLevel samples a level from the geometric distribution dictated by\nthe §13.1 HNSW spec: level = floor(-ln(U) * mL). Higher levels are\nexponentially rarer.
