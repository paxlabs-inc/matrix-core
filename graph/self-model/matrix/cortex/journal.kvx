NODE id=matrix/cortex/journal.KindAttest kind=const
  digest=b3:a80917a109510b68a440f207a4afe631717c7e4c37ec005cb8f686c3da91b552 file=cortex/journal/journal.go range=92:102 lang=go exported=true byte_range=4971:5663
  sig=journal.Kind
  doc=KindAttest is appended by cortex.Attest (Phase 11.5) when an\nagent runtime calls back to record the outcome of an executed\nintent. Spec: research/04-cortex.md §8.3 ("Two updates fire on\n`intent.attest`"). The payload is a canonical CBOR AttestPayload\n(see below); it carries the affected memory IDs so the replay\nharness can re-apply salience.Citations bumps deterministically.\nCitations and AccessCount on cited memories are mutated in the\nsame atomic batch as this journal entry. This is the cortex-\nside primitive that the MCL `intent.attest` message kind (see\nresearch/02-protocol.md §3 — kind 12 of 15) hands off to.
EDGES
  ^defines=matrix/cortex/journal/journal.go

NODE id=matrix/cortex/journal.KindCompact kind=const
  digest=b3:5ac2ee65372805be231c116df2421d8e77f1082b9015dad1c12e6f84d3297df3 file=cortex/journal/journal.go range=60:70 lang=go exported=true byte_range=2955:3649
  sig=journal.Kind
  doc=KindCompact is appended by cortex.Compact (Phase 9) when it persists\na checkpoint record. Spec: research/03-retrieval-patterns.md §5.1\nstep 3 ("Emit a journal checkpoint") + §5.3 (the cortex.compact\nprimitive). The payload is a canonical CBOR CompactPayload (see\nbelow); the full CheckpointRecord lives at chk/<intent>/<step>\nand is integrity-bound to this entry via CheckpointHash. Same\nshape rationale as KindEmbed: payload stays small (no full URI\nlist or compacted-stub vector), the heavy data lives at its own\ncontent-addressable key, replay re-derives the heavy data from\nthe journal entry + cortex state at this seq.
EDGES
  ^defines=matrix/cortex/journal/journal.go

NODE id=matrix/cortex/journal.KindEmbed kind=const
  digest=b3:15f2d059b3d5cc0d7ad70f998eae2d71dd8280f6ce968dab82d1ccb950df2182 file=cortex/journal/journal.go range=51:59 lang=go exported=true byte_range=2365:2953
  sig=journal.Kind
  doc=KindEmbed is appended by the async embedding worker (Phase 5) when it\npersists a freshly computed vector to vec/meta/<id> and updates the\ncorresponding MemoryHead.EmbeddingRef. The payload is a canonical\nCBOR EmbedPayload (see below). Logged so the replay invariant covers\nvec/meta: re-running the journal reproduces every embedding write\nwithout re-embedding from scratch (the vector bytes live in the\nvec/meta value rather than the journal payload to keep payloads\ncompact; replay re-embeds with the same deterministic Embedder).
EDGES
  ^defines=matrix/cortex/journal/journal.go

NODE id=matrix/cortex/journal.KindFind kind=const
  digest=b3:905b9f4731ae1f64fcf565b6654c61cfb8d7b7b091f4c2f26779cd51708a52d2 file=cortex/journal/journal.go range=46:50 lang=go exported=true byte_range=2068:2363
  sig=journal.Kind
  doc=KindFind is appended ONLY when a Find call is flagged late_binding=true\n(i.e. issued mid-execution rather than at compile time). Compile-time\nFinds are not journaled; this is an audit hook for D13 anti-pattern\ndetection (research/04-cortex.md §12.3).
EDGES
  ^defines=matrix/cortex/journal/journal.go

NODE id=matrix/cortex/journal.KindGC kind=const
  digest=b3:29a217b6f2050658b86ede18ed1c491d2451a0ca24e89b1dc374c9232ec9eef9 file=cortex/journal/journal.go range=44:44 lang=go exported=true byte_range=1949:1975
  sig=journal.Kind
