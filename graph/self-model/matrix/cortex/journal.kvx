NODE id=matrix/cortex/journal.KindAddEdge kind=const
  digest=b3:c095d0739a12cb2e687bb0b12c475f6ec1d413f3b2cfdac240367f7336c062a2 file=cortex/journal/journal.go range=42:42 lang=go exported=true byte_range=1816:1848
