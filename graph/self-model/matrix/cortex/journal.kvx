NODE id=matrix/cortex/journal.KindRemoveEdge kind=const
  digest=b3:145f501fe355ae1fcf977940f3cf03335a5cd9e7997386a35d99a9b4f2eafbe3 file=cortex/journal/journal.go range=43:43 lang=go exported=true byte_range=1881:1916
