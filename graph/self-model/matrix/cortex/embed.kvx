NODE id=matrix/cortex/embed.EmbedderChain.Dim kind=method
  digest=b3:7aebb4c51b5c40ff0d27030eb6a21fcd6d636d787799bf5204b612e2d2b8b7c9 file=cortex/embed/chain.go range=131:142 lang=go exported=true byte_range=4731:5188
  sig=func (c *EmbedderChain) Dim() int
  doc=Dim implements Embedder. Returns the Dim() of the most-recently-resolved\nprovider (or the first provider before any Embed call). All providers in a\nwell-formed chain share the same Dim (DefaultDim); a mismatch is a config\nerror surfaced by the worker's len(vec) != Dim() check.
EDGES
  ^contains=matrix/cortex/embed.EmbedderChain
  ^defines=matrix/cortex/embed/chain.go

NODE id=matrix/cortex/embed.EmbedderChain.Embed kind=method
  digest=b3:1d98ba66365ddebe5b2ef488f6d9e89946af1fd55d5850d31def2064209f388f file=cortex/embed/chain.go range=157:179 lang=go exported=true byte_range=5686:6630
  sig=func (c *EmbedderChain) Embed(text string) ([]float32, error)
  doc=Embed implements Embedder. Tries each provider in order with a per-provider\ntimeout; on error or timeout, falls through to the next provider. The\nterminal Hash stub (appended at construction) guarantees a non-error result.
EDGES
  ^contains=matrix/cortex/embed.EmbedderChain
  ^defines=matrix/cortex/embed/chain.go

NODE id=matrix/cortex/embed.EmbedderChain.Model kind=method
  digest=b3:a107f15f6cfb0bf769495648ca14461e56d263b9ed84752b381bb4dddf38caa0 file=cortex/embed/chain.go range=144:155 lang=go exported=true byte_range=5190:5684
  sig=func (c *EmbedderChain) Model() string
  doc=Model implements Embedder. Returns the Model() of the most-recently-resolved\nprovider (or the first provider before any Embed call). This is what feeds\nHead.EmbeddingRef.Model and thus the replay invariant — it MUST reflect the\nprovider that actually produced the vectors, never a synthetic chain id.
EDGES
  ^contains=matrix/cortex/embed.EmbedderChain
  ^defines=matrix/cortex/embed/chain.go

NODE id=matrix/cortex/embed.EmbedderChain.embedWithTimeout kind=method
  digest=b3:8ca25db000a90751ef16c5461d9e71df439e6a98573858f602fa7a25ff91e848 file=cortex/embed/chain.go range=181:216 lang=go exported=false byte_range=6632:7799
  sig=func (c *EmbedderChain) embedWithTimeout(p Embedder, text string) ([]float32, error)
  doc=embedWithTimeout calls p.Embed with a context-bounded deadline. If p.Embed\ndoes not respect context cancellation (the HashEmbedder and APIEmbedder do,\nbut a custom Embedder might not), the goroutine is abandoned after Timeout\nand the error is treated as a fallthrough trigger — the chain proceeds to\nthe next provider. This bounds latency even with a misbehaving embedder.
EDGES
  ^contains=matrix/cortex/embed.EmbedderChain
  ^defines=matrix/cortex/embed/chain.go

NODE id=matrix/cortex/embed.ErrDimMismatch kind=var
  digest=b3:8036706e721f5c1b9a2380344753f9dd50a6126e8f5a44896a82437bf8702a09 file=cortex/embed/embed.go range=47:52 lang=go exported=true byte_range=1964:2370
  sig=error
  doc=ErrDimMismatch is returned when an embedder produces a vector whose\nlength does not equal the Dim() it advertises. Callers (the vector\nworker, the Find Near path) MUST treat this as a hard error rather\nthan silently truncating, since it indicates either an embedder bug\nor a model-version mismatch.
EDGES
  ^defines=matrix/cortex/embed/embed.go

NODE id=matrix/cortex/embed.ErrEmptyInput kind=var
  digest=b3:5823f72a93f7d3e5f05d5733639f4cada40b831d535ab522877aac699fba840a file=cortex/embed/embed.go range=42:45 lang=go exported=true byte_range=1743:1961
  sig=error
  doc=ErrEmptyInput indicates an embedder rejected zero-length text. The\nstub accepts empty strings (returns a zero-mean vector); HTTP-backed\nembedders may differ.
EDGES
  ^defines=matrix/cortex/embed/embed.go

NODE id=matrix/cortex/embed.FireworksEmbedEndpoint kind=const
  digest=b3:6a7bcf42e7507f648a33e8fe4826165e1f88017158f83a2bac884a3b5f529e24 file=cortex/embed/api_embedder.go range=91:92 lang=go exported=true byte_range=3378:3530
