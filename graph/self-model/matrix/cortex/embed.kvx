  sig=string
EDGES
  ^contains=matrix/cortex/embed.HashEmbedder

NODE id=matrix/cortex/embed.HashEmbedder#salt kind=field
  digest=b3:1746a79e5f60aac0b30ff7e3cc3c568eafbc5577ad0c20666b191e8247ccfdea file=cortex/embed/embed.go range=96:96 lang=go exported=false byte_range=4336:4348
  sig=string
EDGES
