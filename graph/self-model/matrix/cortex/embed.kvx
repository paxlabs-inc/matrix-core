  ^defines=matrix/cortex/embed/embed.go

NODE id=matrix/cortex/embed.HashEmbedder.Embed kind=method
  digest=b3:c566169338d0a22695afcaaec3289115ab78fcada5cde44517d826b683acbe43 file=cortex/embed/embed.go range=147:210 lang=go exported=true byte_range=5732:7987
  sig=func (h *HashEmbedder) Embed(text string) ([]float32, error)
  doc=Embed returns a unit-normalized pseudo-vector derived from sha256 of the\n(salt, text) pair. Algorithm:\n\n 1. seed = sha256("hash-stub.v1" || salt || text)\n 2. Stream a sha256-based xorshift PRNG keyed by seed to produce dim\n    float32 components in [-1, 1].\n 3. L2-normalize the vector so dot-products match cosine similarity\n    (HNSW search and Find Near use dot-product as their distance proxy).\n\nDeterminism: byte-identical for byte-identical (salt, text). No\nsystem-clock, no PRNG state outside the seeded chain.\n\nEmpty-text handling: returns a deterministic vector (the seed expansion\nof just salt). This differs from production embedders but keeps tests\nclean — they can write a memory with empty rendered text without\ncrashing the worker.
EDGES
  ^contains=matrix/cortex/embed.HashEmbedder
  ^defines=matrix/cortex/embed/embed.go

NODE id=matrix/cortex/embed.HashEmbedder.Model kind=method
  digest=b3:7c20b3fd23e22f116db26fc409e8061644a111393f199346414661eaf6b3670f file=cortex/embed/embed.go range=144:145 lang=go exported=true byte_range=5644:5730
  sig=func (h *HashEmbedder) Model() string
  doc=Model implements Embedder.
EDGES
  ^contains=matrix/cortex/embed.HashEmbedder
  ^defines=matrix/cortex/embed/embed.go

