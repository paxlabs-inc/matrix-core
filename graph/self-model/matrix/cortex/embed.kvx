  digest=b3:265f5e0cbc3d9f2ce2b825cc35a83bb8916f842b3edd9fd897190fdad147ce0a file=cortex/embed/chain.go range=57:57 lang=go exported=false byte_range=2552:2575
  sig=time.Duration
