NODE id=matrix/cortex/embed.Cosine kind=func
  digest=b3:4086a1a451a5e415c7c9495792b57d1c05ea1010f756106b2725fe0bf492fd43 file=cortex/embed/embed.go range=212:238 lang=go exported=true byte_range=7989:8886
  sig=func Cosine(a, b []float32) float32
  doc=Cosine returns the cosine similarity of a and b. Both slices must be the\nsame length; returns 0 on a length mismatch rather than erroring so\ncallers in tight loops don't have to plumb errors. The HNSW index uses\nCosine via the negative-cosine distance to keep min-heap semantics\n(lower distance = closer).\n\nImplementation note: a and b are expected to be unit-normalized (the\nHashEmbedder and the planned production embedder both normalize) so\nCosine reduces to a plain dot product. We still divide by the norms to\nstay correct under non-normalized inputs.
EDGES
  ^defines=matrix/cortex/embed/embed.go

NODE id=matrix/cortex/embed.DefaultDim kind=const
  digest=b3:ef790f6e0a4831d073ecf764bdd4e7b71a1586355ea91ccba488b1814eb81116 file=cortex/embed/embed.go range=73:77 lang=go exported=true byte_range=3134:3444
  sig=untyped int
  doc=DefaultDim is the embedding dimensionality used by the Phase 5 stub. It\nmatches the spec lean (nomic-embed-text-v1.5 at 768 dims) so swapping in\na real embedder does not force a re-index. Lower-dim Matryoshka slices\n(e.g. 256) remain available by composing a custom Embedder.
EDGES
  ^defines=matrix/cortex/embed/embed.go

