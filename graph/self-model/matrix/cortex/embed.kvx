NODE id=matrix/cortex/embed.NewChainFromEnv kind=func
  digest=b3:7af8351eae0253f75a9740b8d38d6e94e81f0881cdbe5fa8b04166de5be3f583 file=cortex/embed/chain.go range=218:259 lang=go exported=true byte_range=7801:9182
  sig=func NewChainFromEnv(model string, gatewayDID string) *EmbedderChain
  doc=NewChainFromEnv builds an EmbedderChain from environment variables, mirroring\nthe preference order used by neo/internal/memory.pickEmbedder:\n\n 1. the Matrix gateway when MATRIX_GATEWAY_URL + MATRIX_GATEWAY_TOKEN are set;\n 2. the provider directly when FIREWORKS_API_KEY is set;\n 3. the Hash stub terminal fallback (always present).\n\nThis lets production wiring construct a chain declaratively while tests pass\nan explicit provider list via NewEmbedderChain.\n\ngatewayDID, when non-empty, is stamped as X-Matrix-Actor-DID on gateway\nrequests for metering attribution.
EDGES
  ^defines=matrix/cortex/embed/chain.go

NODE id=matrix/cortex/embed.NewEmbedderChain kind=func
  digest=b3:1685a61a7cf379745cfcb8145742f2a47c12fc59d1d6ee90e9e072d5ec013116 file=cortex/embed/chain.go range=90:129 lang=go exported=true byte_range=3658:4729
  sig=func NewEmbedderChain(cfg ChainConfig) *EmbedderChain
  doc=NewEmbedderChain constructs an EmbedderChain from cfg. If none of the\nconfigured providers is a *HashEmbedder, a fresh NewHashEmbedder() is\nappended as the terminal fallback so Embed() can never return an error.
EDGES
  ^defines=matrix/cortex/embed/chain.go

