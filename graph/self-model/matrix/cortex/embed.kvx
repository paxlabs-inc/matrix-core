NODE id=matrix/cortex/embed.HashEmbedder.Dim kind=method
  digest=b3:57ef70530fe82cdc4a930985a9f0817ee789d07d8363070e5fcd0813701c2631 file=cortex/embed/embed.go range=141:142 lang=go exported=true byte_range=5565:5642
  sig=func (h *HashEmbedder) Dim() int
  doc=Dim implements Embedder.
