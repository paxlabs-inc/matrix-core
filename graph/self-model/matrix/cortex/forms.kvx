NODE id=matrix/cortex/forms.Ellipsis kind=const
  digest=b3:1216a4ad64b2d2f4e2166f10e65aedd1560765da1c1765e0211db7477178f73d file=cortex/forms/truncate.go range=21:27 lang=go exported=true byte_range=713:1159
  sig=untyped string
  doc=Ellipsis is the suffix appended when truncation occurs. One byte ("…" is\n3 bytes in UTF-8 = 1 token under bytes/4) was avoided so that very tight\nbudgets still leave room for content. Using "..." would consume 3 bytes\n= 1 token which is a smaller fraction of medium's 200-token budget; we\npick "…" anyway because it reads cleaner in CLI output and the cost is\n1 token either way under bytes/4 ceiling.
EDGES
  ^defines=matrix/cortex/forms/truncate.go

NODE id=matrix/cortex/forms.Render kind=func
  digest=b3:6f5126a05df51d843c93fbe78636953f3aec0a4761de5bfedf7c2136d16d251f file=cortex/forms/forms.go range=33:49 lang=go exported=true byte_range=1353:2062
  sig=func Render(h *memory.Head, data memory.TypedData) memory.Forms
  doc=Render returns auto-generated Short and Medium for the (head, data) pair.\nFull is computed separately via RenderFull because it is never persisted\nin the Forms struct and is only materialized on demand (e.g. when a Find\ncaller selects FormFull).\n\nReturned Forms always satisfy memory.CountTokens(short) ≤ MaxShortTokens\nand likewise for medium — by construction, via truncate.
EDGES
  ^defines=matrix/cortex/forms/forms.go

NODE id=matrix/cortex/forms.RenderFull kind=func
  digest=b3:d9cd46783a533bd9b507c1a0f9b8cb6a7716ac2e5319e338b9410ad8af75ad6b file=cortex/forms/forms.go range=51:60 lang=go exported=true byte_range=2064:2502
  sig=func RenderFull(h *memory.Head, data memory.TypedData) string
  doc=RenderFull returns the canonical full-form rendering of typed data.\nUnbounded by design (§9: "full = canonical render of typed Data"), so no\ntruncation. Mostly a debug/audit surface — production paths usually walk\nthe typed Data struct directly rather than parsing this string.
EDGES
  ^defines=matrix/cortex/forms/forms.go

NODE id=matrix/cortex/forms.TruncateToTokens kind=func
  digest=b3:a352d607c7e86d87fa3bac401b21277c4c2289aee23196207af5bd816263921f file=cortex/forms/truncate.go range=29:54 lang=go exported=true byte_range=1161:2186
  sig=func TruncateToTokens(s string, maxTokens int) string
  doc=TruncateToTokens trims s so that memory.CountTokens(out) ≤ maxTokens. If\ntruncation occurs, an Ellipsis is appended and the trim point is moved\ninward to make room for it without exceeding the budget. UTF-8 boundaries\nare respected — a multi-byte rune is never split mid-codepoint.\n\nmaxTokens ≤ 0 returns the empty string.
EDGES
  ^defines=matrix/cortex/forms/truncate.go

