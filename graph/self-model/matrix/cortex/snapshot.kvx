  ^defines=matrix/cortex/snapshot/smt.go

NODE id=matrix/cortex/snapshot.SMT.StageUpdate kind=method
  digest=b3:06ab4782c004f3750d67d6457dca04d42a38e043b09459fa7a00720279062df3 file=cortex/snapshot/smt.go range=243:320 lang=go exported=true byte_range=8541:11270
  sig=func (t *SMT) StageUpdate(setter Setter, keyHash, valueHash [32]byte) error
  doc=StageUpdate stages writes for setting (keyHash → valueHash) onto wb.\nA zero valueHash is treated as a deletion (the leaf is replaced with\nthe empty-leaf hash and the subtree collapses upward as siblings allow).\n\nCost: ≤ 256 readNode + ≤ 257 stageNode per call (depth + leaf). In\npractice empty-subtree compression keeps the stored node count near\nlog₂(N) per key, but the walk is always 256 levels. For our anchored\nnamespaces (memories ≤ 100k, edges ≤ ~1M) that's a few thousand SMT\nnode reads per write — Pebble handles that in single-digit\nmilliseconds on commodity hardware.
EDGES
  ^contains=matrix/cortex/snapshot.SMT
  ^defines=matrix/cortex/snapshot/smt.go

NODE id=matrix/cortex/snapshot.SMT.readNode kind=method
  digest=b3:6bdd11affda37fdc82337d65d6cdd81a09b905df433611c55bb2cc27efe54797 file=cortex/snapshot/smt.go range=206:227 lang=go exported=false byte_range=7329:8058
  sig=func (t *SMT) readNode(depth uint16, path [32]byte) ([32]byte, bool, error)
  doc=readNode reads the node hash at (depth, path). Returns (hash, true,\nnil) when the key is present, (zero, false, nil) when it is absent\n(caller treats that as the empty subtree at the level).
EDGES
  ^contains=matrix/cortex/snapshot.SMT
  ^defines=matrix/cortex/snapshot/smt.go

NODE id=matrix/cortex/snapshot.SMT.stageNode kind=method
  digest=b3:5df6cf6e1944050144a95b8579e7836092b87e798a030ef4316e7139c8341ea7 file=cortex/snapshot/smt.go range=229:241 lang=go exported=false byte_range=8060:8539
  sig=func (t *SMT) stageNode(setter Setter, depth uint16, path [32]byte, nodeHash [32]byte, isEmpty bool) error
  doc=stageNode writes nodeHash at (depth, path) onto setter, OR deletes the\nkey when isEmpty is true. Empty-subtree collapse is the only path that\nproduces deletions; all other writes set 32 bytes.
EDGES
  ^contains=matrix/cortex/snapshot.SMT
  ^defines=matrix/cortex/snapshot/smt.go

