NODE id=matrix/cortex/snapshot.MultiProof kind=type
  digest=b3:9e8a97a62c8a2ec9674fc9f127900b9b678cfb858d8928fed9098e2d496fa626 file=cortex/snapshot/multiproof.go range=36:50 lang=go exported=true byte_range=1553:2284
  sig=type MultiProof struct {\n	SchemaVersion	uint8			`cbor:"0,keyasint"`\n	Namespace	string			`cbor:"1,keyasint"`\n	Root		[32]byte		`cbor:"2,keyasint"`\n	Proofs		[]MembershipProof	`cbor:"3,keyasint"`\n}
  doc=MultiProof bundles N MembershipProofs against the same SMT root. Each\nproof verifies independently; the bundle's job is to (a) name the\nnamespace, (b) pin the root the proofs were built against, and (c)\ncarry the proofs together over the wire.\n\nEncoded as canonical CBOR with integer keys (matches Manifest +\nEdgeRecord style). CBOR keys are stable across schema versions; new\nfields land at unused integer keys, deletions are forbidden without\na SchemaVersion bump.
EDGES
  contains=matrix/cortex/snapshot.MultiProof#Namespace,matrix/cortex/snapshot.MultiProof#Proofs,matrix/cortex/snapshot.MultiProof#Root,matrix/cortex/snapshot.MultiProof#SchemaVersion,matrix/cortex/snapshot.MultiProof.Verify,matrix/cortex/snapshot.MultiProof.VerifyAgainstManifest
  ^defines=matrix/cortex/snapshot/multiproof.go

