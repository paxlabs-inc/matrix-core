NODE id=matrix/cortex/snapshot.SMT.Prove kind=method
  digest=b3:b6caaf57e29f4804da944480e287f85d77c18da610f6e3d2b00801417f4691d2 file=cortex/snapshot/smt.go range=351:398 lang=go exported=true byte_range=12249:14301
  sig=func (t *SMT) Prove(keyHash [32]byte) (*MembershipProof, error)
  doc=Prove returns a proof for keyHash. The returned proof asserts the\ncurrent leaf value at that key — set if a leaf has been written for\nit (last value's hash), else zero (the empty-leaf, attesting absence).\n\nCost: ≤ 256 readNode calls. Used by sub-agent dispatch (CortexScope\nmulti-proof composition; see Phase 10 wiring).
EDGES
  ^contains=matrix/cortex/snapshot.SMT
  ^defines=matrix/cortex/snapshot/smt.go

NODE id=matrix/cortex/snapshot.SMT.ProveWithValue kind=method
  digest=b3:ee04110899b1e0021170d5b24114e08b776291f9f628f75d5579d9c6cd96bbc7 file=cortex/snapshot/smt.go range=400:414 lang=go exported=true byte_range=14303:14901
  sig=func (t *SMT) ProveWithValue(keyHash [32]byte, canonical []byte) (*MembershipProof, error)
  doc=ProveWithValue is the variant Prove that also accepts the canonical\nvalue bytes the caller asserts is current. It computes valueHash via\nHashValue, calls Prove, and fills proof.ValueHash. The caller is\nresponsible for ensuring `canonical` matches the bytes that were last\nstaged via StageUpdate — otherwise the proof will fail to verify.
EDGES
  ^contains=matrix/cortex/snapshot.SMT
  ^defines=matrix/cortex/snapshot/smt.go

