  ^defines=matrix/cortex/snapshot/smt.go,matrix/cortex/snapshot/snapshot.go

NODE id=matrix/cortex/snapshot.keyMetaSnapshotSeq kind=var
  digest=b3:27d1f998ccc4aa1fe326e17b48896b7c4a856beb593a65d3defc58ffca30bf50 file=cortex/snapshot/snapshot.go range=502:505 lang=go exported=false byte_range=18279:18568
  sig=[]byte
  doc=keyMetaSnapshotSeq is meta/snapshot_seq, the next-to-allocate snapshot\nseq counter. Distinct from MetaJournalHead so journal ops and snapshot\nops don't interleave on the same counter.
EDGES
  ^defines=matrix/cortex/snapshot/snapshot.go

NODE id=matrix/cortex/snapshot.mmrSize kind=func
  digest=b3:a05269a6b675887ff8a8d125f8ed37acb80440f6170462ca70074b483730bb9b file=cortex/snapshot/mmr.go range=119:130 lang=go exported=false byte_range=4398:4801
  sig=func mmrSize(n uint64) uint64
  doc=mmrSize returns the number of MMR nodes for n leaves.\n\nIdentity: mmr_size(n) = 2n - popcount(n). Each peak of height h\ncontributes 2^(h+1) - 1 nodes; popcount(n) gives the number of peaks\n(one per set bit of n), and summing 2^(h+1)-1 over the set bits\ntelescopes to 2n - popcount(n).
EDGES
  ^defines=matrix/cortex/snapshot/mmr.go

NODE id=matrix/cortex/snapshot.normalizePath kind=func
  digest=b3:cb3e1e037e280216c4839e258dd2547cba40fec1a075822404c052f39e6436d9 file=cortex/snapshot/smt.go range=167:186 lang=go exported=false byte_range=5965:6591
  sig=func normalizePath(path [32]byte, significantBits uint16) [32]byte
  doc=normalizePath returns a copy of path with bits [significantBits, 256)\nzeroed. significantBits ∈ [0..256]: 0 means "no significant bits" (root\npath, all zeros), 256 means "all significant" (no change).
EDGES
  ^defines=matrix/cortex/snapshot/smt.go

NODE id=matrix/cortex/snapshot.peakPositions kind=func
  digest=b3:34d3361c69e6dcfdb66d2dc72595b84597785cc6f12efa63730afad11fa97fcb file=cortex/snapshot/mmr.go range=132:157 lang=go exported=false byte_range=4803:5585
  sig=func peakPositions(n uint64) []uint64
  doc=peakPositions returns the 1-indexed positions of MMR peaks for n leaves\nin DESCENDING height order (tallest peak first). For n=4 → [7]. For\nn=3 → [3, 4]. For n=7 → [7, 10, 11].\n\nThe high-bit-first walk gives us peak positions in left-to-right\norder (the tallest tree is leftmost in the MMR), which is what\nbag-of-peaks consumes from-the-right-end.
EDGES
  ^defines=matrix/cortex/snapshot/mmr.go

NODE id=matrix/cortex/snapshot.setBitAt kind=func
  digest=b3:1648a3af4c650c526926113c88a7a9f5e6e8c2da0950ed1adb2bcc71a5a5be3b file=cortex/snapshot/smt.go range=154:165 lang=go exported=false byte_range=5666:5963
  sig=func setBitAt(path [32]byte, idx uint16, b byte) [32]byte
  doc=setBitAt returns a copy of path with bit `idx` set to b (0 or 1).
EDGES
  ^defines=matrix/cortex/snapshot/smt.go

