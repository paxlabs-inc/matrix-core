NODE id=matrix/cortex/snapshot.MultiProof.Verify kind=method
  digest=b3:136e7dc8b5be809ab7a74ba7a95101f12cee4627422ab3df8a838d231f54e27f file=cortex/snapshot/multiproof.go range=151:170 lang=go exported=true byte_range=5866:6648
  sig=func (mp *MultiProof) Verify() error
  doc=Verify checks every proof in mp against mp.Root via VerifyMembership.\nReturns the first failure with key index in the error chain.\n\nSelf-contained: does NOT cross-check mp.Root against a snapshot\nmanifest. Pair with VerifyAgainstManifest when the bundle ships with\na manifest (the standard sub-agent dispatch path).
EDGES
  ^contains=matrix/cortex/snapshot.MultiProof
  ^defines=matrix/cortex/snapshot/multiproof.go

NODE id=matrix/cortex/snapshot.MultiProof.VerifyAgainstManifest kind=method
  digest=b3:7cdac24d1ed93e2678eb685bb4563325e71237578543951e832b80c272996971 file=cortex/snapshot/multiproof.go range=172:194 lang=go exported=true byte_range=6650:7624
  sig=func (mp *MultiProof) VerifyAgainstManifest(m *Manifest) error
  doc=VerifyAgainstManifest is the convenience verifier for the standard\nsub-agent dispatch path: it cross-checks mp.Root against\nmanifest.StateRoots[mp.Namespace] before calling mp.Verify. This is\nthe only verification path that establishes "the proven keys are\nproven against the snapshot the parent claims" — without it, a\ncompromised parent could ship a MultiProof whose Root is unrelated\nto the manifest it was bundled with.
EDGES
  ^contains=matrix/cortex/snapshot.MultiProof
  ^defines=matrix/cortex/snapshot/multiproof.go

