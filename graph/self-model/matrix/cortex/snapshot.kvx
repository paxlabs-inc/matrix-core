NODE id=matrix/cortex/snapshot.State.Snapshot kind=method
  digest=b3:b61b48ba988d653332e3ba831a21585375afd26c9035b41cf6beba98245323ed file=cortex/snapshot/snapshot.go range=351:417 lang=go exported=true byte_range=13613:15716
  sig=func (st *State) Snapshot(actor string, trigger string, now time.Time) (*Manifest, error)
  doc=Snapshot assembles a Manifest at the current state and persists it\nunder snap/<seq>. Returns the manifest. The seq monotonically advances\nacross snapshots independent of the journal seq — multiple snapshots\nat the same JournalSeq are legal (e.g. one for "compile" plus one for\n"attest" if no journal mutation happened in between), each with its\nown snap/<seq>.\n\nCounters are computed by scanning idx/type/ + e/from/ prefix counts\n(cheap relative to the SMT walks already done). Counters are NOT in\nOverallRoot.
EDGES
  ^contains=matrix/cortex/snapshot.State
  ^defines=matrix/cortex/snapshot/snapshot.go

NODE id=matrix/cortex/snapshot.State.StageEdgeUpdate kind=method
  digest=b3:584b65c9ae3d742614e5907964cf9f951b84ab0b8e9f0b46f87c24c22c4c3e91 file=cortex/snapshot/snapshot.go range=315:328 lang=go exported=true byte_range=12110:12841
  sig=func (st *State) StageEdgeUpdate(setter Setter, src [16]byte, edgeType byte, dst [16]byte, canonicalEdge []byte) error
  doc=StageEdgeUpdate stages an SMT update for the edges namespace. Forward\ndirection only — the reverse e/to record is byte-identical and would\ndouble-anchor the same fact. canonicalEdge is the canonical-CBOR\nencoding of the new EdgeRecord (Phase 6 EncodeEdge output); nil\nexpresses deletion (not used today since RemoveEdge is a soft tombstone\nthat still produces a non-empty EdgeRecord).
EDGES
  ^contains=matrix/cortex/snapshot.State
  ^defines=matrix/cortex/snapshot/snapshot.go

NODE id=matrix/cortex/snapshot.State.StageJournalLeaf kind=method
  digest=b3:b72dc90cbf2c75359a1129b2969a26464b6cd2a685a1fd115c0f6da9bacff7ea file=cortex/snapshot/snapshot.go range=279:288 lang=go exported=true byte_range=10453:10956
  sig=func (st *State) StageJournalLeaf(setter Setter, leafHash [32]byte) error
  doc=StageJournalLeaf appends one leaf to the MMR via setter. The leaf hash\nis the canonical journal-leaf hash already computed by the caller.\n\nMost callers should NOT use this directly: install MMRHook() as the\nstore's JournalHook and the MMR will track every journal write\ntransparently. StageJournalLeaf remains exposed for tests + the\nreplay harness (Phase 11).
EDGES
  ^contains=matrix/cortex/snapshot.State
  ^defines=matrix/cortex/snapshot/snapshot.go

NODE id=matrix/cortex/snapshot.State.StageMemoryUpdate kind=method
  digest=b3:8a6b0983ebd2d1355c6cb1c83e94545d2a13bc88986b7c76b0a54f0ee5699c48 file=cortex/snapshot/snapshot.go range=300:313 lang=go exported=true byte_range=11402:12108
  sig=func (st *State) StageMemoryUpdate(setter Setter, id [16]byte, canonicalHead []byte) error
  doc=StageMemoryUpdate stages an SMT update for the memories namespace.\ncanonicalHead is the canonical-CBOR encoding of the new memory.Head;\npass nil to express deletion (which doesn't happen in the cortex API\ntoday — we tombstone via Head.Tombstoned, which still produces a non-\nnil Head and therefore a non-zero value hash; callers don't need the\ndelete path until retention-policy hard-delete lands).
EDGES
  ^contains=matrix/cortex/snapshot.State
  ^defines=matrix/cortex/snapshot/snapshot.go

