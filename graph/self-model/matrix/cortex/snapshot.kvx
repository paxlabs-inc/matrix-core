NODE id=matrix/cortex/snapshot.copyHash kind=func
  digest=b3:6a0e60ebf8f0f02d124d91e87a02f028b29d70c6dd71437242a3248bac2bb89b file=cortex/snapshot/mmr.go range=415:423 lang=go exported=false byte_range=14896:15232
  sig=func copyHash(h [32]byte) []byte
  doc=copyHash returns a fresh slice from h so callers can mutate the\noriginal after staging. wb.Set retains the slice (Pebble batches copy\nat commit, but explicit copy makes intent obvious and resilient to\nfuture Pebble-internal changes).
EDGES
  ^defines=matrix/cortex/snapshot/mmr.go

NODE id=matrix/cortex/snapshot.countEdges kind=func
  digest=b3:83b80a9570d0cf9cb446ff3a8bfe22ba55c347b15a9f8664ef889f9c14fcfbda file=cortex/snapshot/snapshot.go range=546:555 lang=go exported=false byte_range=20105:20421
  sig=func countEdges(s *store.Store) (uint64, error)
  doc=countEdges returns the number of forward edge keys (live + tombstoned).\nForward direction only; reverse is by construction the same count.
EDGES
  ^defines=matrix/cortex/snapshot/snapshot.go

NODE id=matrix/cortex/snapshot.countMemories kind=func
  digest=b3:4196a4b3d120c23c467346a0dd85d4d3c1c12b039fd4fe188de2e5dae72aad19 file=cortex/snapshot/snapshot.go range=507:544 lang=go exported=false byte_range=18570:20103
  sig=func countMemories(s *store.Store) (live uint64, tombstoned uint64, err error)
  doc=countMemories returns (live_count, tombstoned_count). Walks idx/type/\n(a key-only iterator that does NOT load Head bytes) + per-id Head\nload to inspect Tombstoned. For 100k memories this is ~100k Pebble\npoint lookups, ~30ms on commodity hardware — the snapshot path is\npull-driven and not on the hot write path, so this is acceptable.
EDGES
  ^defines=matrix/cortex/snapshot/snapshot.go

NODE id=matrix/cortex/snapshot.emptyHashes kind=var
  digest=b3:6a486a1d975113aa384e00c058a482faa45c15814fb0f8a44077516e40e9d4bc file=cortex/snapshot/smt.go range=64:69 lang=go exported=false byte_range=2896:3188
  sig=[257][32]byte
  doc=emptyHashes[r] = hash of an empty subtree of remaining-depth r.\n  - emptyHashes[0]   = sha256(SMTEmptyDomain).        (empty leaf)\n  - emptyHashes[r+1] = hashSMTNode(emptyHashes[r], emptyHashes[r]).\n\nInitialized in init(); never mutated afterwards.
EDGES
  ^defines=matrix/cortex/snapshot/smt.go

NODE id=matrix/cortex/snapshot.hashMMRBag kind=func
  digest=b3:9cfef66ee738df3d8b421a57e26757c61e5f8363a0b6de6a5c014a55cfe3c277 file=cortex/snapshot/mmr.go range=86:97 lang=go exported=false byte_range=3344:3698
  sig=func hashMMRBag(left, right [32]byte) [32]byte
  doc=hashMMRBag = sha256(MMRBagDomain || left || right). Used for the\nright-to-left peak fold so internal merge nodes and bag spine nodes\ncan never collide.
EDGES
  ^defines=matrix/cortex/snapshot/mmr.go

NODE id=matrix/cortex/snapshot.hashMMRNode kind=func
  digest=b3:6ddbfa4a1968b1e7e5888ac2ae3a8d357f0df50b21fda5bcd896fa245fc01308 file=cortex/snapshot/mmr.go range=75:84 lang=go exported=false byte_range=3090:3342
  sig=func hashMMRNode(left, right [32]byte) [32]byte
  doc=hashMMRNode = sha256(MMRNodeDomain || left || right).
EDGES
  ^defines=matrix/cortex/snapshot/mmr.go

NODE id=matrix/cortex/snapshot.hashMMRRoot kind=func
  digest=b3:f99956ad8a829f8aa7b9024e7c69f6ab237699a1c2fe4901080a8e93c2ce4307 file=cortex/snapshot/mmr.go range=99:113 lang=go exported=false byte_range=3700:4195
  sig=func hashMMRRoot(leafCount uint64, bag [32]byte) [32]byte
  doc=hashMMRRoot = sha256(MMRRootDomain || u64BE(leafCount) || bag). The\nfinal wrap pins the leaf count into the root so the journal commitment\ncan't be confused with a smaller or larger journal sharing the same\npeak structure.
EDGES
  ^defines=matrix/cortex/snapshot/mmr.go

NODE id=matrix/cortex/snapshot.hashSMTLeaf kind=func
  digest=b3:3dc4077c516298ab704ed466d3afc334f5f2c0541e27e5f00316749c15c23eea file=cortex/snapshot/smt.go range=86:95 lang=go exported=false byte_range=3709:3982
  sig=func hashSMTLeaf(keyHash, valueHash [32]byte) [32]byte
  doc=hashSMTLeaf = sha256(SMTLeafDomain || keyHash || valueHash).
EDGES
  ^defines=matrix/cortex/snapshot/smt.go

NODE id=matrix/cortex/snapshot.hashSMTNode kind=func
  digest=b3:8b04bf0d372e835ee7d9e49f8a8ed52d8d6e33a9905b5ab24c1e57fc9bc2cf8f file=cortex/snapshot/smt.go range=97:106 lang=go exported=false byte_range=3984:4236
  sig=func hashSMTNode(left, right [32]byte) [32]byte
  doc=hashSMTNode = sha256(SMTNodeDomain || left || right).
EDGES
  ^defines=matrix/cortex/snapshot/smt.go

NODE id=matrix/cortex/snapshot.init kind=func
  digest=b3:7df9e927f573da3de4bb111c5f426a7fa7c9fb86632fe713d399b7c26679d480 file=cortex/snapshot/snapshot.go range=178:189 lang=go exported=false byte_range=7495:7787
  sig=func init()
