NODE id=matrix/cortex/snapshot.State.BuildMultiProof kind=method
  digest=b3:cb7e1ea6ae8271e27042621813942571bd4ae6bd3aef6cb0d85448399657bbf0 file=cortex/snapshot/multiproof.go range=80:111 lang=go exported=true byte_range=3360:4539
  sig=func (st *State) BuildMultiProof(namespace string, keyHashes [][32]byte) (*MultiProof, error)
  doc=BuildMultiProof composes one MembershipProof per keyHash against the\nnamespace SMT at its current root. ValueHash fields stay zero — use\nBuildMultiProofWithValues when canonical value bytes are available\n(almost always the case, since the parent agent owns the cortex it's\ngranting scope into).\n\nO(K · 256) Pebble reads where K = len(keyHashes). For typical scope\nsizes (≤32 keys) this is microseconds.
EDGES
  ^contains=matrix/cortex/snapshot.State
  ^defines=matrix/cortex/snapshot/multiproof.go

NODE id=matrix/cortex/snapshot.State.BuildMultiProofWithValues kind=method
  digest=b3:1a973cbfa939a9b018c2180cac9594e1d964f7244e9789f228959084429f16b4 file=cortex/snapshot/multiproof.go range=113:149 lang=go exported=true byte_range=4541:5864
  sig=func (st *State) BuildMultiProofWithValues(namespace string, items []MultiProofItem) (*MultiProof, error)
  doc=BuildMultiProofWithValues is the variant that fills ValueHash from\ncanonical value bytes per item. Pass Canonical=nil to assert non-\nmembership (proof.ValueHash stays zero).\n\nIMPORTANT: the caller must ensure each Canonical matches the bytes\nthat were last staged via StageMemoryUpdate / StageEdgeUpdate for\nthat key. Stale bytes produce proofs that fail to verify against\nthe current root.
EDGES
  ^contains=matrix/cortex/snapshot.State
  ^defines=matrix/cortex/snapshot/multiproof.go

NODE id=matrix/cortex/snapshot.State.CurrentRoots kind=method
  digest=b3:e5f684903a489fb74e6a3a9147bb96380f20e2645322893c67b7dbffa3d191c5 file=cortex/snapshot/snapshot.go range=330:349 lang=go exported=true byte_range=12843:13611
  sig=func (st *State) CurrentRoots() ([32]byte, map[string][32]byte, [32]byte, error)
  doc=CurrentRoots returns (journalRoot, stateRoots, overallRoot) for the\ncurrent persisted state. Pure function of committed state — no batch,\nno in-memory caching. Used by Snapshot and by Cortex.OverallRoot for\nthe compiler determinism seed (D11).
EDGES
  ^contains=matrix/cortex/snapshot.State
  ^defines=matrix/cortex/snapshot/snapshot.go

NODE id=matrix/cortex/snapshot.State.FindSnapshotByRoot kind=method
  digest=b3:df0038507ed51b8b3f9478687641844b75a7b77e627697530a88c57f88386c63 file=cortex/snapshot/snapshot.go range=448:476 lang=go exported=true byte_range=16629:17565
  sig=func (st *State) FindSnapshotByRoot(root [32]byte) (*Manifest, error)
  doc=FindSnapshotByRoot returns the manifest whose OverallRoot matches the\nsupplied hash, or ErrSnapshotNotFound if no persisted snap/<seq> has\nthat root.\n\nUsed by the scope verifier (research/06-agents.md §7.2 step 2:\n"Verifies the scope's snapshot_hash is still resolvable") so a sub-\nagent can be certain the root the scope was anchored against is one\nthe cortex still recognizes (i.e. has not been retention-policy-GC'd).\n\nO(N) scan over snap/. For v1 actor counts this is microseconds; the\nreverse index idx/snap_root/<root:32> can land later if profiling\ndemands it.
EDGES
  ^contains=matrix/cortex/snapshot.State
  ^defines=matrix/cortex/snapshot/snapshot.go

NODE id=matrix/cortex/snapshot.State.IterSnapshots kind=method
