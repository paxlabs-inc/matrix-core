NODE id=matrix/workforce/internal/approval.OpenSealedBatch kind=func
  digest=b3:fa7f43e4e9961cdfd998775c043f759da794f9f624724024a35d6d5267ef474b file=workforce/internal/approval/store.go range=438:492 lang=go exported=true byte_range=13956:16432
  sig=func OpenSealedBatch(\n	userVault *vault.UserVault,\n	tenantID string,\n	organizationID contracts.OrganizationID,\n	batchID contracts.ApprovalID,\n	sealed []byte,\n	canonicalHash string,\n	authority Authority,\n) (BatchApproval, error)
  doc=OpenSealedBatch recovers one owner-signed batch from its Vault-sealed bytes,\nbinds it to the exact tenant, organization, and batch it claims, and verifies\nthe owner's signature over it. Callers that authorize spending must take the\nceiling, expiry, and intent membership from the returned value: the relational\ncolumns beside the sealed record are projections, and only the verified\nsignature — not the seal — proves the owner approved this authority.
EDGES
  ^defines=matrix/workforce/internal/approval/store.go

