NODE id=matrix/workforce/internal/processisolation.verifyPrivateImageParent kind=func
  digest=b3:d716842ddea7dd76ce62dd8758eebc8479abb45a5fc19d9328d7ea975c384dc8 file=workforce/internal/processisolation/command.go range=307:333 lang=go exported=false byte_range=10849:12145
  sig=func verifyPrivateImageParent(parent string) error
  doc=verifyPrivateImageParent rejects a temporary parent that other users could\nrename or replace entries in. A shared directory is acceptable only when the\nsticky bit prevents one user from removing another's entries, which is what\nkeeps the private image directory ours for its whole lifetime.
EDGES
  ^defines=matrix/workforce/internal/processisolation/command.go

NODE id=matrix/workforce/internal/processisolation.verifyTrustedLauncher kind=func
  digest=b3:4c0804f7b1088c8b6306f72b40bafa3141665bc0d136d0d07aa11bd0c5e43cd8 file=workforce/internal/processisolation/command.go range=146:180 lang=go exported=false byte_range=4276:5706
  sig=func verifyTrustedLauncher(path string) error
  doc=verifyTrustedLauncher rejects a Bubblewrap launcher that anyone outside the\nkernel's own trust boundary could replace. The launcher runs with the\nworkforced identity before any sandbox argument takes effect, so a\nsubstituted launcher would silently ignore the whole boundary.
EDGES
  ^defines=matrix/workforce/internal/processisolation/command.go

NODE id=matrix/workforce/internal/processisolation.verifyTrustedOwner kind=func
  digest=b3:a5b827ae9adf2eff7503f76f1bc5f6594f1dfb503900f04d6f8177fdbe42c532 file=workforce/internal/processisolation/command.go range=182:195 lang=go exported=false byte_range=5708:6281
  sig=func verifyTrustedOwner(info os.FileInfo, name string) error
  doc=verifyTrustedOwner requires root ownership rather than merely accepting the\nservice's own identity. The launcher is executed by pathname, so anything a\nsame-identity process could replace between verification and execution would\nsilently discard the sandbox.
EDGES
  ^defines=matrix/workforce/internal/processisolation/command.go

