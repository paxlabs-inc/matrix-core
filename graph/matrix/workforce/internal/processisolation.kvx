  digest=b3:3cedf476d0e87f7d602952606d70093981a5668469eb65a4df03ed9c1d73d3e0 file=workforce/internal/processisolation/command.go range=49:74 lang=go exported=true byte_range=1077:1919
  sig=func (command *IsolatedCommand) Close() error
  doc=Close releases the private verified worker image. Run calls it; callers that\nabandon a built command before running it must call it themselves. Each piece\nof state is cleared only once it is actually released, so a failed cleanup\nstays visible to a repeated Close rather than being silently forgotten.
