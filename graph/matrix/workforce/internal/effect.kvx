NODE id=matrix/workforce/internal/effect.Gateway.requireCompiledProposal kind=method
  digest=b3:96b37bb20c9babd4290a8161caa2e70460748a60ba970367daeed5c33a66d1e8 file=workforce/internal/effect/gateway.go range=1028:1072 lang=go exported=false byte_range=36974:38582
  sig=func (gateway *Gateway) requireCompiledProposal(\n	ctx context.Context,\n	proposal Proposal,\n	proposalHash string,\n) error
  doc=requireCompiledProposal admits a dispatch only when the durable compiled plan\nauthorizes this exact proposal. The relational hash column alone is not\nsufficient authority: it is a projection, so the Vault-sealed plan is opened\nand the operation the compiler actually approved is compared field for field.
EDGES
  ^contains=matrix/workforce/internal/effect.Gateway
  ^defines=matrix/workforce/internal/effect/gateway.go

NODE id=matrix/workforce/internal/effect.Gateway.reverifyPreparedApproval kind=method
  digest=b3:6883cc5d46a98308d5eff5f1b2def8fe787737dc3c4f1abfb5f0abaa23027964 file=workforce/internal/effect/gateway.go range=854:918 lang=go exported=false byte_range=30598:32857
  sig=func (gateway *Gateway) reverifyPreparedApproval(\n	ctx context.Context,\n	tx pgx.Tx,\n	proposal Proposal,\n	now time.Time,\n) error
  doc=reverifyPreparedApproval re-establishes owner authority for an irreversible\neffect that was prepared by an earlier attempt and is about to be dispatched\nnow. It re-checks the signed batch, its revocation and expiry, and this\nproposal's exact recorded consumption. It never charges again: the\nconsumption row written at preparation is the authority being confirmed.
EDGES
  ^contains=matrix/workforce/internal/effect.Gateway
  ^defines=matrix/workforce/internal/effect/gateway.go

