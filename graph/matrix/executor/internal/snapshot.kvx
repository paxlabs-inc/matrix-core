NODE id=matrix/executor/internal/snapshot.Manager.tick kind=method
  digest=b3:937fd98cae4003a9c674b8f83ddb80fff0ae4ebd05e163ab7ded59e0f6162ab0 file=executor/internal/snapshot/snapshot.go range=414:439 lang=go exported=false byte_range=14093:14904
