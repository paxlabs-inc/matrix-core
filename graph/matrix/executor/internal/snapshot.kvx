  ^defines=matrix/executor/internal/snapshot/snapshot.go

NODE id=matrix/executor/internal/snapshot.Manager.Start kind=method
  digest=b3:b185e405584ed460680164e47b55702123b818deefa4525cff90f32c3c4a8027 file=executor/internal/snapshot/snapshot.go range=390:412 lang=go exported=true byte_range=13385:14091
  sig=func (m *Manager) Start(ctx context.Context)
  doc=Start launches the periodic-push ticker if cfg.PushInterval >= 0.\nIdempotent: subsequent calls are no-ops. Returns immediately.\n\nPushInterval == 0 → DefaultPushInterval (5 minutes).\nPushInterval  < 0 → no ticker; periodic pushes disabled (only\nBootPull and Stop's final push remain).
EDGES
  ^contains=matrix/executor/internal/snapshot.Manager
  ^defines=matrix/executor/internal/snapshot/snapshot.go

