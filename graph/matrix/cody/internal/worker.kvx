  sig=func (w *Worker) toolGlob(args map[string]interface{}) string
  doc=toolGlob finds files by path pattern (with ** support), newest first — the\norientation primitive fs_list one-directory-at-a-time cannot provide.
EDGES
  ^contains=matrix/cody/internal/worker.Worker
  ^defines=matrix/cody/internal/worker/search.go

