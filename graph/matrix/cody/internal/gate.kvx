NODE id=matrix/cody/internal/gate.Screen kind=func
  digest=b3:ecd4943b171ed12fd6817c0fe0fb36f6991616cb1ba5758447de6fbc1c5221f8 file=cody/internal/gate/gate.go range=135:192 lang=go exported=true byte_range=3928:6166
  sig=func Screen(root string, baseline TestBaseline, sheet *contract.TaskSheet, report *contract.TurnInReport) string
  doc=Screen runs the deterministic constitution checks on a turn-in. It returns\n"" when the turn-in passes, or a concrete rejection verdict. Violations here\nare hard: they can never be talked past because no report content is\nconsulted for the facts — only the workspace itself.
EDGES
  ^defines=matrix/cody/internal/gate/gate.go

NODE id=matrix/cody/internal/gate.ScreenDesign kind=func
  digest=b3:431fa65bcf06a253df24b4a005b647852527c4a13c142b0f1ef794036b10a579 file=cody/internal/gate/gate.go range=200:231 lang=go exported=true byte_range=6392:7737
  sig=func ScreenDesign(root string, sheet *contract.TaskSheet, report *contract.TurnInReport) string
  doc=ScreenDesign is the deterministic design-drift screen (req 9.3): when a UI\nsheet carries a Design Language Record, the changed UI files are scanned for\nthe banned AI-tells the record forbids (purple/indigo gradient heroes,\ngradient/glass blobs, default framework blue, stock component themes, emoji\nchrome). A hit is a hard rejection — the same banned-defaults doctrine that\nscreened the DLR at authoring time screens its downstream implementation.\nReturns "" when the turn-in passes or the sheet is not a DLR-bound UI task.
EDGES
  ^defines=matrix/cody/internal/gate/gate.go

NODE id=matrix/cody/internal/gate.ScreenScreenshot kind=func
  digest=b3:1049004ba6d8cbe518236fd69f8bb087281fc3ad4dedbbbbe9e1699a8af4385a file=cody/internal/gate/gate.go range=233:266 lang=go exported=true byte_range=7739:9082
  sig=func ScreenScreenshot(sheet *contract.TaskSheet, report *contract.TurnInReport) string
  doc=ScreenScreenshot enforces the screenshot-evidence requirement on UI turn-ins\n(req 13.2): a UI task's turn-in must carry a screenshot artifact in its\nverification evidence — design quality is verified against what was built,\nnot asserted. The requirement is EVIDENCE-BASED: it applies only when the\nturn-in actually changed a renderable UI file. UITask is set by an\ninclusive keyword heuristic (orchestrator.IsUITask), so a pure-logic task\n(e.g. a Go library) can be flagged UI by a false positive; requiring a\nscreenshot of a surface that does not exist would wedge such a task\npermanently with no satisfiable action. Returns "" when the sheet is not a\nUI task, changed no rendered surface, or a screenshot is present.
EDGES
  ^defines=matrix/cody/internal/gate/gate.go

