NODE id=matrix/cody/internal/gate.BuildEvidence kind=func
  digest=b3:d0124bdd391f104f2bb486fc20b1337e36efb9b031f1a7136305485abd06a077 file=cody/internal/gate/gate.go range=364:391 lang=go exported=true byte_range=13152:14346
  sig=func BuildEvidence(root string, report *contract.TurnInReport, rerun string) string
  doc=BuildEvidence renders the ground truth for the verdict: the worker's factual\nchange record, the ACTUAL SOURCE of the changed files read from the\nworkspace, and the ORCHESTRATOR'S OWN independent verification re-run — the\nworker's narration is the claim, never the evidence.
EDGES
  ^defines=matrix/cody/internal/gate/gate.go

