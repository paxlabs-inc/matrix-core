  digest=b3:1c215521758560685f52009425e72ea92dd24d87726239397387bd773fc7625a file=cody/internal/gate/gate.go range=268:285 lang=go exported=true byte_range=9084:10222
  sig=func BuildRequest(sheet *contract.TaskSheet) string
  doc=BuildRequest renders the sheet as the contract the adjudicator judges\nagainst: the goal, the testable acceptance criteria, and the constitution\nclauses the outcome must not have violated.
