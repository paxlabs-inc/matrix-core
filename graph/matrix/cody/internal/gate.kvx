  digest=b3:1ee8d64c525095477604ab4b75a92538189d2b5ad1496cd2b9f5491841ab704e file=cody/internal/gate/gate.go range=376:408 lang=go exported=true byte_range=13555:14853
  sig=func Adjudicate(ctx context.Context, adj *cassandra.Adjudicator, root string, sheet *contract.TaskSheet, report *contract.TurnInReport, rerun string) string
  doc=Adjudicate renders the goal-vs-outcome verdict on a done claim. Empty\nverdict = accept. An adjudicator error fails OPEN (returns accept): the\nindependent green verification record is the structural floor, and a\nCassandra hiccup never wedges a plan (the proven Neo posture).
EDGES
  ^defines=matrix/cody/internal/gate/gate.go

NODE id=matrix/cody/internal/gate.BuildEvidence kind=func
  digest=b3:d0124bdd391f104f2bb486fc20b1337e36efb9b031f1a7136305485abd06a077 file=cody/internal/gate/gate.go range=347:374 lang=go exported=true byte_range=12359:13553
  sig=func BuildEvidence(root string, report *contract.TurnInReport, rerun string) string
  doc=BuildEvidence renders the ground truth for the verdict: the worker's factual\nchange record, the ACTUAL SOURCE of the changed files read from the\nworkspace, and the ORCHESTRATOR'S OWN independent verification re-run — the\nworker's narration is the claim, never the evidence.
EDGES
  ^defines=matrix/cody/internal/gate/gate.go

