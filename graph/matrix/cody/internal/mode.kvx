  digest=b3:7547a590fbad2cef369398758d9d05287919a698fd8493103d41f030c3ff87fe file=cody/internal/mode/mode.go range=163:176 lang=go exported=true byte_range=6147:6698
  sig=func (p Policy) OrchestratorLLM(gatewayURL, actorDID string) mcllm.Config
  doc=OrchestratorLLM builds the orchestrator-role client config: the stronger\nmodel, cold temperature (planning adjudication + the Cassandra gate), the\ncody slot. This is the COLD judge for decision phases — divergent candidates\nare generated hot (DecisionLLM) and picked cold here.
