NODE id=matrix/cody/internal/llm.GuidanceMessage kind=func
  digest=b3:4c3d8b1cbc89fe96793c8aa9372035c3bbcfcc0b4f17fe1dc89e4cef3cec66c5 file=cody/internal/llm/message.go range=146:163 lang=go exported=true byte_range=5457:6253
  sig=func GuidanceMessage(content string) Message
  doc=GuidanceMessage builds a guidance-channel turn: system steering the model is\ninstructed to act on but never acknowledge or echo (the Cascade\n<system_guidance> contract). It rides as a user-role turn — every provider\naccepts a user message mid-conversation — with the content wrapped in the\nguidance envelope and the Guidance flag set so the harness keeps it off every\nuser-facing surface (reasoning/thinking deltas and the durable transcript).\nBlank content yields a zero Message (no empty guidance turn is emitted).
EDGES
  ^defines=matrix/cody/internal/llm/message.go

NODE id=matrix/cody/internal/llm.GuidanceOpen kind=const
  digest=b3:ec86f102ac14e845723a24cc228f232a5a93944dc45955469983707f13ed6e95 file=cody/internal/llm/message.go range=32:37 lang=go exported=true byte_range=1185:1531
  sig=untyped string
  doc=Guidance-channel envelope tags. System steering injected through the guidance\nchannel is wrapped in these so the model can recognize it as a non-answerable\nhint (the Cascade <system_guidance> contract), and so the harness can detect\nand strip guidance turns from every user-facing surface.
EDGES
  ^defines=matrix/cody/internal/llm/message.go

NODE id=matrix/cody/internal/llm.Message kind=type
  digest=b3:fb6de0f934d9c6642e29c386166308373d4481d5b9cd51a8ed666bae786a230b file=cody/internal/llm/message.go range=41:64 lang=go exported=true byte_range=1573:2803
  sig=type Message struct {\n	Role		string		`json:"role"`\n	Content		string		`json:"content,omitempty"`\n	ToolCalls	[]ToolCall	`json:"tool_calls,omitempty"`\n	ToolCallID	string		`json:"tool_call_id,omitempty"`\n	Name		string		`json:"name,omitempty"`\n\n	// Reasoning carries a reasoning model's chain-of-thought when the\n	// provider surfaces it as a separate channel. Never serialized onto the\n	// wire and never treated as the answer; surfaced as a distinct channel\n	// only (mirrors MCL's DecodeWithReasoning posture).\n	Reasoning	string	`json:"-"`\n\n	// Guidance marks this as a guidance-channel turn: system steering the\n	// model is instructed to act on but never acknowledge or echo (the Cascade\n	// <system_guidance> contract). It rides on the wire as an ordinary\n	// role+content turn (the flag is process-only, never serialized), so the\n	// provider accepts it; the flag lets the harness keep guidance out of every\n	// user-facing surface and out of the durable transcript.\n	Guidance	bool	`json:"-"`\n}
  doc=Message is one turn in the conversation. It is both the on-wire shape and\nthe in-transcript shape (Neo's state). An assistant turn may carry\nToolCalls; a tool-result turn sets Role=tool + ToolCallID.
EDGES
  contains=matrix/cody/internal/llm.Message#Content,matrix/cody/internal/llm.Message#Guidance,matrix/cody/internal/llm.Message#Name,matrix/cody/internal/llm.Message#Reasoning,matrix/cody/internal/llm.Message#Role,matrix/cody/internal/llm.Message#ToolCallID,matrix/cody/internal/llm.Message#ToolCalls,matrix/cody/internal/llm.Message.IsGuidance
  ^defines=matrix/cody/internal/llm/message.go

