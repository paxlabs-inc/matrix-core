NODE id=matrix/cody/internal/llm.parseTokenSection kind=func
  digest=b3:1f20ca1d7d9e563dfc6e6a48aae4676ca17ebfd3fd9c495cc6371aa57b94e142 file=cody/internal/llm/client.go range=842:871 lang=go exported=false byte_range=30000:30942
  sig=func parseTokenSection(section string, base int) []ToolCall
  doc=parseTokenSection decodes the calls inside one token-grammar section. base is\nthe running call count, used to synthesize stable call IDs.
EDGES
  ^defines=matrix/cody/internal/llm/client.go

NODE id=matrix/cody/internal/llm.previewVisible kind=func
  digest=b3:ed3247ae1a61c4811c88a8a834baddb06db0c859c1106e55fcdf61e94c658d25 file=cody/internal/llm/client.go range=444:455 lang=go exported=false byte_range=15431:16001
  sig=func previewVisible(content string) string
  doc=previewVisible returns the portion of an in-progress content buffer that is\nsafe to show as the visible answer so far: a leading <think>/<thinking>\nblock is moved out (held back until it closes) and any Kimi tool-call token\ngrammar is stripped. It reuses the exact helpers the final fold uses, so the\nstreamed prefix never diverges from the authoritative cleaned content.
EDGES
  ^defines=matrix/cody/internal/llm/client.go

NODE id=matrix/cody/internal/llm.reasoningEffort kind=func
  digest=b3:a1ab147b4e6ebb83e421671c344080db0eb93d9176d3f83f2f7051f349d29ea9 file=cody/internal/llm/client.go range=573:585 lang=go exported=false byte_range=19518:20144
  sig=func reasoningEffort(enabled bool) string
  doc=reasoningEffort maps the per-role enableThinking flag onto xAI's\nreasoning_effort enum: reasoning ON → "medium" (balanced reasoning that keeps\ngrok-4.3 answering in the visible content channel instead of spending the\nwhole turn on chain-of-thought and emitting only a stub), OFF → "none"\n(disables reasoning entirely for token-tight mechanical roles). When enabled\nthe server splits chain-of-thought into the separate reasoning_content channel\n(which aggregateStreamReader routes to the thinking channel).
EDGES
  ^defines=matrix/cody/internal/llm/client.go

NODE id=matrix/cody/internal/llm.sanitizeToolCalls kind=func
  digest=b3:04d0002f9188da778318d16df9213181d1faf9e62254849b872e1de06837d389 file=cody/internal/llm/client.go range=659:686 lang=go exported=false byte_range=23322:24542
  sig=func sanitizeToolCalls(calls []ToolCall) []ToolCall
  doc=sanitizeToolCalls guarantees every REPLAYED assistant tool_call carries a\nwell-formed function before it goes back on the wire. A truncated or\nmalformed generation can leave function.arguments empty or non-JSON; the\ntranscript is re-sent verbatim every turn, so replaying such a call makes a\nstrict provider (e.g. Together's DeepSeek-V4-Pro) reject the WHOLE request\nwith a 400 on the function field — which permanently wedges the conversation\n(every later turn carries the same poison). Coercing empty/invalid arguments\nto "{}" keeps the call structurally valid AND preserves the assistant↔\ntool_call_id pairing (so the matching tool-result is never orphaned). The\nagent already recorded the real parse error as that tool's result, so the\nmodel still gets the feedback it needs to re-issue the call correctly.
EDGES
  ^defines=matrix/cody/internal/llm/client.go

