  digest=b3:39e0e0eb15e8ac0b0d1d678ba4d7adefb6e03dda706d22f99e3cbef035d77184 file=neo/internal/config/config.go range=42:46 lang=go exported=true byte_range=1902:2246
  sig=string
  doc=ConsolidationModel extracts durable learnings from each turn's transcript\ninto Neocortex (memory write-back). A stronger model than CheapModel because\nextraction quality directly sets memory quality; still cheap-tier (it runs\nonce per turn in the background). Must be on the gateway neo-slot whitelist.
