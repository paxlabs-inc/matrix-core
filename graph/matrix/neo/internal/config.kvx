NODE id=matrix/neo/internal/config.Config#BrowserAutoshot kind=field
  digest=b3:a1a34fbe8da374bbb34c0efd364e521abd4de26c39c8d6215edea686a9a2c883 file=neo/internal/config/config.go range=129:138 lang=go exported=true byte_range=7806:8514
  sig=bool
  doc=--- browser filmstrip (BROWSER-FILMSTRIP; see [browser] / NEO_BROWSER_*) ---\nBrowserAutoshot deterministically captures a viewport JPEG after each\nview-changing browser action (navigate/back/click/form submit) so the\n"Neo's Computer" browsing surface reads as a live filmstrip without\nrelying on the model choosing to screenshot. Default ON; a capture failure\nnever blocks the navigation or the turn (best-effort). BrowserAutoshotMax\ncaps captures per run so a long browsing turn can't grow media without\nbound. MediaRetentionHours bounds screenshot/media growth on the volume:\nthe GC sweep deletes served media files older than this (0 disables).
EDGES
  ^contains=matrix/neo/internal/config.Config

NODE id=matrix/neo/internal/config.Config#BrowserAutoshotMax kind=field
  digest=b3:fb32beb0bb5454ddfc6327e85709410a2cfe5ff65c91f799fc2e555e49b7c488 file=neo/internal/config/config.go range=139:139 lang=go exported=true byte_range=8516:8539
