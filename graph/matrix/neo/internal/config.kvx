  ^contains=matrix/neo/internal/config.Config

NODE id=matrix/neo/internal/config.Config#EpistemicPremises kind=field
  digest=b3:3a8cbfceeb34ceee2d9721cb160d86b80a01dd5f6c9722961b37e5d03331fcac file=neo/internal/config/config.go range=199:203 lang=go exported=true byte_range=11632:11956
  sig=bool
  doc=--- epistemic core (EPISTEMIC-CORE; [epistemic] block / NEO_EPISTEMIC_*) ---\nEpistemicPremises arms Mechanism 1 (premise ledger + check-before-act\ngate): a plan's load-bearing premises are extracted with provenance and\nno action dispatches on a cheaply-checkable unverified assumption.
EDGES
  ^contains=matrix/neo/internal/config.Config

NODE id=matrix/neo/internal/config.Config#EscalateActions kind=field
  digest=b3:452c661eba23f949e58afc6faa032b62cbebf9517002550abcc5d38b829990a5 file=neo/internal/config/config.go range=271:271 lang=go exported=true byte_range=15731:15755
