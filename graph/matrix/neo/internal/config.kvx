NODE id=matrix/neo/internal/config.envIntNonNeg kind=func
  digest=b3:45d7a67ea60e91d1c56256ded6d6a80a84b7d175cc0b1a34e77dddecd3742a64 file=neo/internal/config/config.go range=811:822 lang=go exported=false byte_range=42132:42624
  sig=func envIntNonNeg(key string, fallback int) int
  doc=envIntNonNeg overlays a non-negative integer from the environment, keeping\nthe fallback when the var is absent or not a non-negative integer. Unlike\nenvInt it accepts 0 — used for knobs where zero is a meaningful setting\n(e.g. AmbientRetrievalTopK=0 = fully tool-driven retrieval).
EDGES
  ^defines=matrix/neo/internal/config/config.go

