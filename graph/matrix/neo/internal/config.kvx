  digest=b3:a6f0d790b90cf3d1af2f8684b328435164891692b45ee67f57f56e0f2d772488 file=neo/internal/config/config.go range=249:255 lang=go exported=true byte_range=14370:14788
  sig=time.Duration
  doc=--- MCP tool result cache + parallel dispatch (P2-5) ---\nMCPCacheTTL is the TTL for the idempotent-read result cache. Zero\ndisables caching (the default). When >0, successful results for\nexplicitly-idempotent read tools (web_search, web_news) are served\nfrom cache within the TTL; side-effecting and money tools are never\ncached. Config: env NEO_MCP_CACHE_TTL_SECONDS.
EDGES
  ^contains=matrix/neo/internal/config.Config

