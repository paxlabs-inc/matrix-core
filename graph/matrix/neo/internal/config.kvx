  ^contains=matrix/neo/internal/config.Config

NODE id=matrix/neo/internal/config.Config#CassandraCooldownSteps kind=field
  digest=b3:1aec5b83897d7bebc4afcb6c24a74bbb64666c9a1d92f1d011c9d5ed85222f26 file=neo/internal/config/config.go range=194:197 lang=go exported=true byte_range=11429:11629
  sig=int
  doc=CassandraCooldownSteps is the minimum number of steps between mods of the\nsame trigger class, so the controller never nags the same drift every step\n(default 2).
EDGES
  ^contains=matrix/neo/internal/config.Config

NODE id=matrix/neo/internal/config.Config#CassandraEnabled kind=field
  digest=b3:a0d01843cb87a1e8482c7fd72c9d57b4ce8e086d868efb467bb8584194e68bd6 file=neo/internal/config/config.go range=171:182 lang=go exported=true byte_range=10100:10828
  sig=bool
  doc=--- cassandra 2.0 (the silent-voice controller) ---\nCassandra 2.0 replaces the retired proof-of-work completion gate with a\nsilent, first-person feedback controller that edits the agent's OWN prior\nassistant-message content in place (folding in Doubt / Questioning /\nCuriosity / Assurance / Urge-to-verify) so the model reads it as its own\nemerging thought. It is a two-sided damping loop and a self-healing loop\nkiller; it is SILENT on a clean run. These knobs gate it. Config:\n[cassandra] block / NEO_CASSANDRA_* env.\n\nCassandraEnabled is the master switch: when false the controller is a\nCOMPLETE no-op and the window is byte-identical to the pre-feature loop.
EDGES
  ^contains=matrix/neo/internal/config.Config

NODE id=matrix/neo/internal/config.Config#CassandraEscalateModel kind=field
  digest=b3:b668d06d2a95eb1ed35e035fe8bca10cb5a5863099433c7cb6e43d1d94a2fc13 file=neo/internal/config/config.go range=54:54 lang=go exported=true byte_range=2734:2763
  sig=string
EDGES
  ^contains=matrix/neo/internal/config.Config

NODE id=matrix/neo/internal/config.Config#CassandraLoopThreshold kind=field
  digest=b3:e28e54787242bc4a829d783896f3d1671b15bea8be84433b163a17cd23baccd6 file=neo/internal/config/config.go range=189:193 lang=go exported=true byte_range=11122:11427
  sig=int
  doc=CassandraLoopThreshold is the repeat count that arms the doubt side, chosen\nto fire ONE step BEFORE the hard no-progress stall (NoProgressStall). 0 (the\ndefault) derives it as NoProgressStall-1 so it tracks the stall bound when\nunset; a positive value overrides.
EDGES
  ^contains=matrix/neo/internal/config.Config

NODE id=matrix/neo/internal/config.Config#CassandraMaxModsPerTurn kind=field
  digest=b3:1ab1c1537f0a8cbb0da41baa6e411fedfa34bbbaa7abc4266420e2fcfa087e8d file=neo/internal/config/config.go range=186:188 lang=go exported=true byte_range=10996:11120
  sig=int
  doc=CassandraMaxModsPerTurn caps total modifications in one Chat turn (anti-nag;\ndefault 3).
EDGES
  ^contains=matrix/neo/internal/config.Config

NODE id=matrix/neo/internal/config.Config#CassandraMinStep kind=field
  digest=b3:423d40155f7d2040bf4af27586b86c5d9317dd2689769b1078d37d58a778efad file=neo/internal/config/config.go range=183:185 lang=go exported=true byte_range=10830:10994
  sig=int
  doc=CassandraMinStep is the first loop step at which a mod may fire — there is\nno prior assistant turn to edit before step 2 (default 2).
