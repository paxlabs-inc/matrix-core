  digest=b3:063dbed7317c9cd3ad8819e6431cb51ef716d2a7ac205ce29fd7c742aa962f09 file=neo/internal/config/config.go range=48:53 lang=go exported=true byte_range=2353:2732
  sig=string
  doc=CassandraModel is the cheap/fast Cassandra completeness auditor (the\ncompletion-gate adjudicator, metered on the dedicated "cassandra" slot);\nCassandraEscalateModel is the stronger second-opinion model consulted on\nlow-certainty high-stakes audits ("" disables escalation). Both must be on\nthe gateway's cassandra-slot whitelist.
EDGES
  ^contains=matrix/neo/internal/config.Config

NODE id=matrix/neo/internal/config.Config#CheapModel kind=field
  digest=b3:0b80c6d8a8fbf8c23458b32a8abc2a803102d3629115a8c5429a13a6a8b41edd file=neo/internal/config/config.go range=41:41 lang=go exported=true byte_range=1822:1839
