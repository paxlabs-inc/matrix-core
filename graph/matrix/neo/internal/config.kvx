NODE id=matrix/neo/internal/config.Config#HeartbeatInterval kind=field
  digest=b3:029895108f6d412f7cdac6fc5e8f6d2360d27126df109d27c0e9287ca19bee3a file=neo/internal/config/config.go range=239:247 lang=go exported=true byte_range=13768:14367
  sig=int
  doc=--- heartbeat (P1-4: Chronos-driven proactive turn convention) ---\nHeartbeatInterval is the recurring-alarm interval (minutes) for Neo's\nproactive self-review of active goals/constraints. 0 = disabled (the\ndefault: no wakeups occur). When >0, a Chronos recurring alarm fires at\nthis interval; its wake_message tells Neo to review active goals and\nreply with the HEARTBEAT_OK sentinel when nothing needs attention (the\nturn is then suppressed — no user-facing output). Config: [heartbeat]\nsection in neo.frozen.kvx / env NEO_HEARTBEAT_INTERVAL.
EDGES
  ^contains=matrix/neo/internal/config.Config

