NODE id=matrix/neo/internal/config.hardHeadroomCapTokens kind=const
  digest=b3:671a9a4c7b6a15a795b9095a5cdfeefd808cbc910db68eefd8a20caa61b999fb file=neo/internal/config/config.go range=877:885 lang=go exported=false byte_range=44008:44512
  sig=untyped int
  doc=Headroom caps for the budget derivation below: at large windows a percentage\nthreshold reserves an absurd absolute slice (80% of 1M leaves 200K tokens\nidle), so the reserved headroom is the SMALLER of the percentage-derived\nslice and these absolute caps. Below ~320K windows the caps never bind, so\nsmall local-model configurations (32K via NEO_CONTEXT_WINDOW_TOKENS) keep\ntheir exact prior trim/compaction behavior.
EDGES
  ^defines=matrix/neo/internal/config/config.go

