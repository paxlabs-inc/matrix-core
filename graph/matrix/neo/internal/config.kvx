  digest=b3:0620992be37cf1732ce71d0255a5e613b3b28b5e6a0c07e2e62da98a881e76a9 file=neo/internal/config/config.go range=100:105 lang=go exported=true byte_range=5530:5935
  sig=bool
  doc=WarmOnOpen makes the FIRST inbound HTTP request spin up the embedder + HNSW\nsemantic substrate in the background (one-shot). Activate + StorySoFar are\nalready cheap (materialized scans, deterministic, no LLM); the only real\ncold-start is the embedder/HNSW that the relevance push depends on, so\nwarming it on app-open keeps the first message's recall off the cold path.
EDGES
  ^contains=matrix/neo/internal/config.Config

NODE id=matrix/neo/internal/config.Config.ActivationBudget kind=method
  digest=b3:703f03a8e55c2e037d5cfc45bb3a806414ad906dcaf94be933bda11458ac6570 file=neo/internal/config/config.go range=909:926 lang=go exported=true byte_range=45440:46107
  sig=func (c Config) ActivationBudget() int
  doc=ActivationBudget returns the per-turn cortex activation-bundle token budget.\nAn explicit ActivationBudgetTokens wins verbatim; otherwise it derives\nwindow-proportionally (2% of the context window) clamped to\n[activationBudgetFloorTokens, activationBudgetCapTokens] — 1M → 20000,\n256K → 5120, and any window ≤ 150K keeps the historical 3000.
EDGES
  ^contains=matrix/neo/internal/config.Config
  ^defines=matrix/neo/internal/config/config.go

