  digest=b3:ffe017ba859a1fc1f4b3e5afd2c75593c583583e98673ce759ec3fd037df8522 file=neo/internal/conversation/store.go range=334:344 lang=go exported=true byte_range=11125:11765
  sig=func (s *Store) AppendUser(convID, intentID, text string)
  doc=AppendUser / AppendAssistant are thin helpers for the two turn kinds.\n\nintentID is the owning run id minted at dispatch time. Persisting it on the\nuser turn is the durable anchor a reload/relogin uses to reattach the live\nstream — the client (and the GET /conversations/{id} live_run signal) reads\nit back to decide whether the run is still in flight. An empty intent_id is\nfine (omitempty preserves the pre-F1 wire shape exactly for direct replies\nand tests that don't model a run).
EDGES
  ^contains=matrix/neo/internal/conversation.Store
  ^defines=matrix/neo/internal/conversation/store.go

