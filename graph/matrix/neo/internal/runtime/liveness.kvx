NODE id=matrix/neo/internal/runtime/liveness.DefaultRepeatThreshold kind=const
  digest=b3:e35657cff8af101f709b0519e7615260391d83c85c15b785c6d5bb83b7873a57 file=neo/internal/runtime/liveness/circuit.go range=14:22 lang=go exported=true byte_range=266:857
  sig=untyped int
  doc=DefaultRepeatThreshold is the number of dispatches of one canonical tool\nsignature a turn may make before the breaker opens. It sits deliberately\nabove the same-strategy retry bound (which tops out at four consecutive\ndispatches of one signature) so both mechanisms stay reachable: the retry\nbound catches consecutive repetition and returns the more informative typed\nincomplete, while the breaker is the phase-crossing backstop that also sees\ninterleaved repetition — the A/B/A/B churn the legacy similarity heuristic\nwas blind to.
EDGES
  ^references=matrix/neo/internal/runtime/liveness.BreakerConfig.normalized,matrix/neo/internal/runtime/liveness.DefaultBreakerConfig
  ^defines=matrix/neo/internal/runtime/liveness/circuit.go

