NODE id=matrix/neo/internal/runtime/loop.Loop.TurnWithHistory kind=method
  digest=b3:92203ca1e21b9865c89924da411de4c2512903aa1e0c5f4f209d853767151c6f file=neo/internal/runtime/loop/loop.go range=329:360 lang=go exported=true byte_range=12411:13589
  sig=func (loop *Loop) TurnWithHistory(\n	ctx context.Context,\n	userContent string,\n	history []protocol.Message,\n) (Response, error)
