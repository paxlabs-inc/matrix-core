  ^references=matrix/neo/internal/agent.Agent.chatResurrectionWithGuidance,matrix/neo/internal/runtime/loop.NeocortexCheckpointStore.LoadTurnState,matrix/neo/internal/runtime/loop.NeocortexCheckpointStore.SaveTurnCheckpoint,matrix/neo/internal/runtime/loop.NeocortexCheckpointStore.SetTurnRecovery,matrix/neo/internal/runtime/loop.NeocortexCheckpointStore.SetTurnStatus
  ^defines=matrix/neo/internal/runtime/loop/neocortex.go

