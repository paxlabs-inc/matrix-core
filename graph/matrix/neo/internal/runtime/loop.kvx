  digest=b3:1aec3239c0240781545cafb9bca507acd113cd6200cee3e0348850980f90e35a file=neo/internal/runtime/loop/neocortex.go range=240:274 lang=go exported=true byte_range=7802:9014
  sig=func (store *NeocortexCheckpointStore) LoadTurnState(\n	ctx context.Context,\n	turnID string,\n) (turnstate.TurnState, error)
  doc=LoadTurnState keeps process-local lifecycle metadata in turnstate but always\nreplaces its checkpoint with the latest cortexd projection. Missing,\nmalformed, or unavailable cortexd state is an error; local checkpoint bytes\nare never a recovery fallback on the neocortex substrate.
