NODE id=matrix/neo/internal/llm.ErrProviderRejected kind=var
  digest=b3:2d7b828f00b400d9286a7c08f47caba0d25cb340a9a265a618338a896efc4cd6 file=neo/internal/llm/client.go range=30:36 lang=go exported=true byte_range=709:1246
  sig=error
  doc=ErrProviderRejected marks a deterministic 4xx validation reject (e.g. a 400\n"InvalidParameter" on the function/tool fields). It is NOT recoverable by\nretrying the identical body — the request shape itself is bad — so callers\nmust stop the retry ladder when they see it instead of burning calls (and,\non a metered gateway, real spend) re-sending the same rejected request.\nDetect with errors.Is(err, llm.ErrProviderRejected).
EDGES
  ^defines=matrix/neo/internal/llm/client.go

NODE id=matrix/neo/internal/llm.ErrRateLimited kind=var
  digest=b3:30e86c31c5b2c1ed9fd57af1ba27a3f77cea8a7457f32734843432c4549a5041 file=neo/internal/llm/client.go range=38:44 lang=go exported=true byte_range=1248:1809
  sig=error
  doc=ErrRateLimited marks an upstream 429 (the provider/gateway is rate-limiting\nor overloaded). It IS retryable, but callers should back off HARD rather than\nrespawn immediately: a persistent 429 that is retried aggressively across many\ndaemons becomes a self-amplifying request storm (the exact failure mode that\nturned "Baseten is slow" into "20 runaway Neos"). The task supervisor reads\nthis to lengthen its respawn backoff. Detect with errors.Is(err, llm.ErrRateLimited).
EDGES
  ^defines=matrix/neo/internal/llm/client.go

NODE id=matrix/neo/internal/llm.ErrRequestTooLarge kind=var
  digest=b3:903e68c8510742fbbf549e3161279d64486d175b8313620ff7c5c621fddcbcca file=neo/internal/llm/client.go range=24:28 lang=go exported=true byte_range=344:707
  sig=error
  doc=ErrRequestTooLarge marks a provider reject where the request body exceeded\nthe provider's hard byte cap (e.g. Fireworks HTTP 413 "body_too_large",\n1,048,576 bytes). It is recoverable: the caller can compact the window and\nretry. Detect with errors.Is(err, llm.ErrRequestTooLarge).
EDGES
  ^defines=matrix/neo/internal/llm/client.go

