NODE id=matrix/neo/internal/llm.holdbackPartial kind=func
  digest=b3:a4a901b23d3665c90f4b5e5120ef9c4087a2bbfd4cad6dad3585ce700617e7a1 file=neo/internal/llm/client.go range=452:472 lang=go exported=false byte_range=15717:16431
  sig=func holdbackPartial(s string) string
  doc=holdbackPartial withholds a trailing fragment that could be the start of a\ncontrol marker (<think>, <thinking>, or the Kimi tool-call section/call\ntokens) so a half-arrived marker is never streamed as visible text. A normal\n'<' in prose (e.g. "a < b") is left intact — only a tail that is a genuine\nprefix of a known marker is held back, to be resolved once more bytes arrive.
EDGES
  ^defines=matrix/neo/internal/llm/client.go

NODE id=matrix/neo/internal/llm.jsonArgs kind=func
  digest=b3:f9f37fa574b414448b0ad5c13883ab873e1d1acab8333e369756d75a469534f4 file=neo/internal/llm/client.go range=958:983 lang=go exported=false byte_range=32894:33506
  sig=func jsonArgs(s string) string
  doc=jsonArgs normalizes an improvised tool-call argument blob to a JSON object\nstring: it returns the first balanced {...} span if present, else "{}". This\nkeeps dispatch robust when a model emits prose or partial JSON around the args.
EDGES
  ^defines=matrix/neo/internal/llm/client.go

NODE id=matrix/neo/internal/llm.kimiArgBegin kind=const
  digest=b3:da1a6e647c06a72ccdc510e97fbdba870180569f3038d8273858206c31e0c31e file=neo/internal/llm/client.go range=767:775 lang=go exported=false byte_range=26953:27407
  sig=untyped string
  doc=Special-token grammar Kimi/Moonshot K2 models use to emit tool calls inside\n`content`. A section wraps one or more calls; each call is a\n`functions.<name>:<index>` header, an argument-begin marker, the JSON\narguments, then a call-end marker.
EDGES
  ^defines=matrix/neo/internal/llm/client.go

