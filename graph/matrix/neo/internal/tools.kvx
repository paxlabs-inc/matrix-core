NODE id=matrix/neo/internal/tools.Manager.dispatchTodo kind=method
  digest=b3:2ad589316eaaadac353bd4e47f32cd47c0819dcb8eebc902f321fc79d672223c file=neo/internal/tools/tools.go range=542:573 lang=go exported=false byte_range=21481:23110
  sig=func (m *Manager) dispatchTodo(ctx context.Context, args map[string]interface{}) (string, bool, error)
  doc=dispatchTodo is the live task-list handler (neo-smoothness req.3). It parses\nthe model's ordered plan, ENFORCES the lifecycle invariants — at most one\nitem in_progress at a time (req.3.2) — and surfaces the list through the\ninjected emitter. It no-ops gracefully on a trivial single-step turn (req.3.4)\nso the feature adds visibility on real multi-step work without ceremony.\nValidation failures are returned in-band (isError=true, err=nil) so the model\nreads the steer and corrects rather than the harness retrying.
EDGES
  ^contains=matrix/neo/internal/tools.Manager
  ^defines=matrix/neo/internal/tools/tools.go

NODE id=matrix/neo/internal/tools.Manager.dispatchWriteSkill kind=method
  digest=b3:e153e4e8d00b1b62512701f9ed28640744d5538b42e47383c0a9802c7b45e8ae file=neo/internal/tools/tools.go range=513:540 lang=go exported=false byte_range=19826:21479
  sig=func (m *Manager) dispatchWriteSkill(ctx context.Context, args map[string]interface{}) (string, bool, error)
  doc=dispatchWriteSkill is the P2-2 skill-writing handler: it parses the model's\nwrite_skill arguments into a validated PatternSpec and persists it as a\ncortex Pattern via the injected WriteSkillFunc (which calls\nReinforcePattern). A spec with no usable identity (empty name, trigger, and\nsteps) is rejected in-band so the model reads the error and corrects rather\nthan the harness retrying. On success the cortex URI is returned so the\nagent can cite the persisted skill.
EDGES
  ^contains=matrix/neo/internal/tools.Manager
  ^defines=matrix/neo/internal/tools/tools.go

NODE id=matrix/neo/internal/tools.MemoryRecallTool kind=const
  digest=b3:ad9498e0f923913dacd24f8f01616a000ccbe097ccc235e50ccd84fd0b390ecf file=neo/internal/tools/tools.go range=40:45 lang=go exported=true byte_range=1305:1738
  sig=untyped string
  doc=MemoryRecallTool is the synthetic function Neo exposes for explicitly\nsearching its own durable cortex memory. It is the PRIMARY reasoning-time\nretrieval verb (v3 #1): ambient injection is now only a thin seed (or off),\nso the model PULLS what it needs mid-thought — iteratively, with a narrowing\nquery, type filter, and optional as-of instant — instead of being force-fed.
EDGES
  ^defines=matrix/neo/internal/tools/tools.go

