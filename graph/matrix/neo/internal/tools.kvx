NODE id=matrix/neo/internal/tools.Manager.dispatchTodo kind=method
  digest=b3:2ad589316eaaadac353bd4e47f32cd47c0819dcb8eebc902f321fc79d672223c file=neo/internal/tools/tools.go range=1070:1101 lang=go exported=false byte_range=42794:44423
  sig=func (m *Manager) dispatchTodo(ctx context.Context, args map[string]interface{}) (string, bool, error)
  doc=dispatchTodo is the live task-list handler (neo-smoothness req.3). It parses\nthe model's ordered plan, ENFORCES the lifecycle invariants — at most one\nitem in_progress at a time (req.3.2) — and surfaces the list through the\ninjected emitter. It no-ops gracefully on a trivial single-step turn (req.3.4)\nso the feature adds visibility on real multi-step work without ceremony.\nValidation failures are returned in-band (isError=true, err=nil) so the model\nreads the steer and corrects rather than the harness retrying.
EDGES
  calls=matrix/neo/internal/server.Engine.emitTodo,matrix/neo/internal/tools.parseTodoItems,matrix/neo/internal/tools.summarizeTodo
  references=matrix/neo/internal/tools.Manager,matrix/neo/internal/tools.TodoInProgress,matrix/neo/internal/tools.args,matrix/neo/internal/tools.ctx,matrix/neo/internal/tools.err,matrix/neo/internal/tools.inProgress,matrix/neo/internal/tools.it,matrix/neo/internal/tools.items,matrix/neo/internal/tools.m,matrix/neo/internal/tools.parseTodoItems,matrix/neo/internal/tools.summarizeTodo
  ^contains=matrix/neo/internal/tools.Manager
  ^calls=matrix/neo/internal/tools.Manager.dispatch
  ^references=matrix/neo/internal/tools.Manager.dispatch
  ^defines=matrix/neo/internal/tools/tools.go

NODE id=matrix/neo/internal/tools.Manager.dispatchWriteSkill kind=method
  digest=b3:9a6d329dcb559b264d7f61fe2ac969095dbb25300fc93c9f4aabf9a572ce8d47 file=neo/internal/tools/tools.go range=1041:1068 lang=go exported=false byte_range=41130:42792
  sig=func (m *Manager) dispatchWriteSkill(ctx context.Context, args map[string]interface{}) (string, bool, error)
  doc=dispatchWriteSkill is the P2-2 skill-writing handler: it parses the model's\nwrite_skill arguments into a validated PatternSpec and persists it as a\nNeocortex Pattern via the injected WriteSkillFunc (which calls\nReinforcePattern). A spec with no usable identity (empty name, trigger, and\nsteps) is rejected in-band so the model reads the error and corrects rather\nthan the harness retrying. On success the Neocortex URI is returned so the\nagent can cite the persisted skill.
EDGES
  calls=matrix/neo/internal/memory.PatternSpec.IsEmpty,matrix/neo/internal/tools.asString,matrix/neo/internal/tools.asStringSlice
  references=matrix/neo/internal/memory.PatternSpec,matrix/neo/internal/memory.PatternSpec.IsEmpty,matrix/neo/internal/tools.Manager,matrix/neo/internal/tools.args,matrix/neo/internal/tools.asString,matrix/neo/internal/tools.asStringSlice,matrix/neo/internal/tools.ctx,matrix/neo/internal/tools.err,matrix/neo/internal/tools.m,matrix/neo/internal/tools.spec,matrix/neo/internal/tools.uri
  ^contains=matrix/neo/internal/tools.Manager
  ^calls=matrix/neo/internal/tools.Manager.dispatch
  ^references=matrix/neo/internal/tools.Manager.dispatch
  ^defines=matrix/neo/internal/tools/tools.go

