NODE id=matrix/neo/internal/tools.WriteSkillFunc kind=type
  digest=b3:a174e63729a92c1645dafffc029dfb83038e39f3d303934c1c6d1744e88353ae file=neo/internal/tools/tools.go range=231:237 lang=go exported=true byte_range=11974:12524
  sig=type WriteSkillFunc func(ctx context.Context, spec memory.PatternSpec) (string, error)
  doc=WriteSkillFunc persists a reusable recipe as a Neocortex Pattern (P2-2). It\nreceives a validated PatternSpec (non-empty identity) and returns the Neocortex\nURI of the written/reinforced pattern. Injected from the pager (which calls\nReinforcePattern); nil until wired, in which case write_skill is not\nadvertised at all. The coverage starts low and is reinforced on each repeat\nsuccess, so a single authoring does not overfit (procedural.guards).
EDGES
  references=matrix/neo/internal/memory.PatternSpec
  ^references=matrix/neo/internal/tools.Manager,matrix/neo/internal/tools.Manager.SetWriteSkill
  ^defines=matrix/neo/internal/tools/tools.go

NODE id=matrix/neo/internal/tools.WriteSkillTool kind=const
  digest=b3:9fbf11afbe8e74d856c28a1cde18c2736210123df0d9be49adaceea93f7d6353 file=neo/internal/tools/tools.go range=70:80 lang=go exported=true byte_range=3121:3908
  sig=untyped string
  doc=WriteSkillTool is the synthetic function Neo exposes for the agent to\nCONSCIOUSLY persist a reusable recipe as a Neocortex Pattern (P2-2: the\nskill-writing / synthesis loop). After a proven task, the agent authors a\nstructured PatternSpec (name, trigger, preconditions, steps, gotchas,\nsuccess_criteria) and this tool validates it and writes it to the durable\nprocedural store. The spec is validated against PatternSpec (non-empty\nidentity) before the write; coverage starts low and is reinforced on each\nrepeat success, so a single authoring does not overfit (procedural.guards).\nReadable on demand via memory_recall. Like memory_recall it is NOT a real\nMCP server, so it never enters the manifest tool-bijection check.
EDGES
  ^references=matrix/neo/internal/agent.narratePhrase,matrix/neo/internal/tools.Manager.Preflight,matrix/neo/internal/tools.Manager.ToolSideEffectClass,matrix/neo/internal/tools.Manager.dispatch,matrix/neo/internal/tools.writeSkillSchema
  ^defines=matrix/neo/internal/tools/tools.go

