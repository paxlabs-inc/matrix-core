NODE id=matrix/neo/internal/tools.SwarmFunc kind=type
  digest=b3:38fbbf946650d516a620f40fc9036744518d02348c4261c75305711a4eb6490f file=neo/internal/tools/tools.go range=143:147 lang=go exported=true byte_range=7183:7544
  sig=type SwarmFunc func(ctx context.Context, specs []SubagentSpec) (string, error)
  doc=SwarmFunc runs a set of sub-agents concurrently and returns an aggregated,\nmodel-readable digest of their results. Injected by the engine wiring (see\ninternal/server); nil until wired, in which case spawn_subagents reports it\nis unavailable and is not advertised at all.
EDGES
  ^defines=matrix/neo/internal/tools/tools.go

NODE id=matrix/neo/internal/tools.TaskCompleteTool kind=const
  digest=b3:f2c117705ded8a8dc82fd5f29d80962f180af5ac114db0c34b4fdb2e43fcb0d6 file=neo/internal/tools/tools.go range=65:74 lang=go exported=true byte_range=2942:3660
  sig=untyped string
  doc=TaskCompleteTool is the synthetic completion gate (Cassandra Phase 1): the\nONLY legal way for Neo to end a turn that touched state. It carries a\ncompleteness object (summary + coverage + evidence + open_gaps +\nassumptions) that the agent loop validates against the working transcript\n(the ground truth) before the turn may terminate — positive-proof of\ncompletion, never the mere absence of further tool calls. Like core_execute\nit is synthetic (no MCP server, no manifest bijection); unlike the others it\nis intercepted in the agent loop, not routed through Manager.Dispatch,\nbecause the validator needs the live transcript the Manager cannot see.
EDGES
  ^defines=matrix/neo/internal/tools/tools.go

