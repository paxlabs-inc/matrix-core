NODE id=matrix/neo/internal/tools.RecallFunc kind=type
  digest=b3:b49819ed35d3b35671b65e511a6b2943730176c846791a0c8a8f2a9f890716cc file=neo/internal/tools/tools.go range=126:132 lang=go exported=true byte_range=6307:6832
  sig=type RecallFunc func(ctx context.Context, query string, types []string, k int, asOf *time.Time) (string, error)
  doc=RecallFunc searches the durable memory store and returns a rendered,\nuser-presentable digest. It is the PRIMARY reasoning-time retrieval verb\n(v3 #1): the model calls it iteratively with a narrowing query, an optional\ntype filter, a result cap, and an optional bi-temporal as-of instant\n(nil = now). Injected from the pager; nil until wired, in which case\nmemory_recall is not advertised at all.
EDGES
  ^defines=matrix/neo/internal/tools/tools.go

NODE id=matrix/neo/internal/tools.Spawn kind=func
  digest=b3:b474e20364ef12aed089e7b2955091e3c3ec5208bb79f62aa623ff08b0f05302 file=neo/internal/tools/tools.go range=212:284 lang=go exported=true byte_range=9967:12201
  sig=func Spawn(ctx context.Context, opts Options) (*Manager, error)
  doc=Spawn loads the agent manifest, starts every declared MCP server (a server\nthat fails to start is recorded as a warning and skipped — Neo degrades\ngracefully rather than refusing to boot), and binds the resulting tools.
EDGES
  ^defines=matrix/neo/internal/tools/tools.go

NODE id=matrix/neo/internal/tools.SpawnSubagentsTool kind=const
  digest=b3:314239b293840b91e6692f5d46e4e89e11adebbbcdea4f1df60ebc2a1e561d4a file=neo/internal/tools/tools.go range=47:54 lang=go exported=true byte_range=1740:2323
  sig=untyped string
  doc=SpawnSubagentsTool is the synthetic function Neo exposes to fan a task out\nto several task-scoped sub-agents that run CONCURRENTLY, each in its own\nisolated context window, and to collect their distilled results. It is a\ncontext-conservation strategy as much as a parallelism one: the heavy tool\nwork (reading a repo, crawling pages) happens in the sub-agents' windows and\nonly a compact result returns to Neo's. Reachable only from the top-level\nagent — sub-agents do NOT get this tool (no recursion / fork-bombs).
EDGES
  ^defines=matrix/neo/internal/tools/tools.go

