NODE id=matrix/neo/internal/tools.Surface kind=type
  digest=b3:9950bfc9f7b0bc2160ad3b50cfb503569b08418b551f7475091116ee5b865527 file=neo/internal/tools/surface.go range=8:16 lang=go exported=true byte_range=202:752
  sig=type Surface int
  doc=Surface is where an action sits relative to the wall into MCL.\n\nPer the frozen spec's execution surface, reversible actions stay "Natural"\n(Neo performs them directly, fully permissive) while actions that move or\ncommit the user's on-chain funds — or need a wallet signature — "Escalate"\nacross the wall into the MCL pipeline (which owns the approval gate). Neo\nholds no signing key, so escalate-class tools are never advertised as\ndirectly-callable functions; they are reachable only through core_execute.
EDGES
  contains=matrix/neo/internal/tools.Surface.String
  ^defines=matrix/neo/internal/tools/surface.go

