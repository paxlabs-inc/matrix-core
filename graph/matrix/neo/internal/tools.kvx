  ^contains=matrix/neo/internal/tools.Manager
  ^calls=matrix/neo/internal/tools.Manager.dispatchConstructRender
  ^references=matrix/neo/internal/tools.Manager.dispatchConstructRender
  ^defines=matrix/neo/internal/tools/tools.go

