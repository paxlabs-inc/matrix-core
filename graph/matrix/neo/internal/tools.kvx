NODE id=matrix/neo/internal/tools.Manager.Dispatch kind=method
  digest=b3:c7281f37e49e176019567a46e7ea9959c6f5624f3f3bec2b224531beede2f2c1 file=neo/internal/tools/tools.go range=589:600 lang=go exported=true byte_range=23831:24512
  sig=func (m *Manager) Dispatch(ctx context.Context, funcName string, args map[string]interface{}) (string, bool, error)
  doc=Dispatch executes a tool call by function name.\n\nReturns (content, isError, err): err is a transport/invocation failure that\nfeeds the recovery ladder (retry/adapt); isError=true with err==nil is an\nin-band failure the model should see and adapt to; both empty err means the\ntool ran. Unknown names and escalate-guard rejections come back as\n(message, true, nil) so the model reads and corrects rather than the harness\nretrying a doomed call.
EDGES
  calls=matrix/neo/internal/tools.Manager.dispatch
  references=matrix/neo/internal/tools.Manager,matrix/neo/internal/tools.Manager.dispatch,matrix/neo/internal/tools.args,matrix/neo/internal/tools.content,matrix/neo/internal/tools.ctx,matrix/neo/internal/tools.err,matrix/neo/internal/tools.funcName,matrix/neo/internal/tools.isErr,matrix/neo/internal/tools.m
  ^contains=matrix/neo/internal/tools.Manager
  ^calls=matrix/neo/internal/server.briefMCPAlarmController.Cancel,matrix/neo/internal/server.briefMCPAlarmController.Set,matrix/neo/internal/server.mcpAlarmController.Cancel,matrix/neo/internal/server.mcpAlarmController.Set
  ^references=matrix/neo/internal/server.briefMCPAlarmController.Cancel,matrix/neo/internal/server.briefMCPAlarmController.Set,matrix/neo/internal/server.mcpAlarmController.Cancel,matrix/neo/internal/server.mcpAlarmController.Set
  ^defines=matrix/neo/internal/tools/tools.go

