  digest=b3:e006df07b4acd1fd3e39b55428ae23da7f57640b1195a9dfd22648145d6accdc file=neo/internal/task/store.go range=139:164 lang=go exported=true byte_range=4954:5850
  sig=func (s *Store) Begin(convID, runID, objective string)
  doc=Begin records (or replaces) a conversation's task as running, owned by runID.\nA new dispatch for a conversation supersedes any previous task — the new\nrunID becomes the CAS token, so a superseded older run's later Finish is a\nno-op. Created is preserved across a same-conversation supersession only if\nthe objective is unchanged (a genuine resume); otherwise it resets.
EDGES
