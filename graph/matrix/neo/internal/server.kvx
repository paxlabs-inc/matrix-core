NODE id=matrix/neo/internal/server.Server.handleConversations kind=method
  digest=b3:ec73cf0dbc5fa6b6f2ec3aa774ab6ae1b33e7007d51ca31e35e678e37dd91638 file=neo/internal/server/server.go range=154:207 lang=go exported=false byte_range=6594:9015
  sig=func (s *Server) handleConversations(w http.ResponseWriter, r *http.Request)
  doc=handleConversations serves GET /conversations (list) and\nGET /conversations/<id> (full turn log) from Neo's durable store. The shape\nmirrors the daemon's routes (and the web client's expectations) exactly:\nlist → {"items":[summary...]}, detail → the record. When persistence is\ndisabled it proxies to the daemon so the legacy store still answers.\n\nF1 wire shape (additive, byte-compatible): the detail response carries a\nsibling `live_run` field — the in-flight intent_id for this conversation, or\n"" once the run has settled. The existing record fields\n(conversation_id, title, turns, updated) are emitted unchanged so older\nclients keep deserialising. New clients use `live_run` to subscribe to the\nSSE stream with replay on reopen/relogin without waiting for the\n/messages/async/<id> poll — the durable resume signal that closes the\n"thread looks done while agent is still working" defect.
EDGES
  ^contains=matrix/neo/internal/server.Server
  ^defines=matrix/neo/internal/server/server.go

NODE id=matrix/neo/internal/server.Server.handleEvents kind=method
  digest=b3:acf4de26f31a32ae4ad01bf21c2093e1fd578dc35c394c52ec23137690d1b881 file=neo/internal/server/server.go range=262:272 lang=go exported=false byte_range=11272:11707
  sig=func (s *Server) handleEvents(w http.ResponseWriter, r *http.Request)
  doc=handleEvents serves the live SSE stream for a Neo run, or proxies to the\ndaemon when the intent_id belongs to a daemon-side run (dashboard dispatch).
EDGES
  ^contains=matrix/neo/internal/server.Server
  ^defines=matrix/neo/internal/server/server.go

NODE id=matrix/neo/internal/server.Server.handleHalt kind=method
  digest=b3:5a035568f77e3844b8954244f7f18d9955fdc59e11eaa3ed1a031120ad119d84 file=neo/internal/server/server.go range=313:326 lang=go exported=false byte_range=13328:14052
  sig=func (s *Server) handleHalt(w http.ResponseWriter, r *http.Request)
  doc=handleHalt is the global kill switch (POST /halt): it interrupts EVERY live\nNeo run this daemon is driving and reports how many were signalled. Each\ndaemon is single-tenant, so this stops exactly the calling user's own runaway\n/ parallel Neos — the deliberate "Stop all" escape hatch when the model is\nslow or a storm of respawns is underway. Idempotent: halting with nothing\nlive returns halted:0.
EDGES
  ^contains=matrix/neo/internal/server.Server
  ^defines=matrix/neo/internal/server/server.go

NODE id=matrix/neo/internal/server.Server.handleIntents kind=method
  digest=b3:6c88b422d39c33499d0de67f10c7926d6345e73fa341f17c7a1e0800c4b0ec08 file=neo/internal/server/server.go range=328:368 lang=go exported=false byte_range=14054:15888
  sig=func (s *Server) handleIntents(w http.ResponseWriter, r *http.Request)
  doc=handleIntents intercepts the gate-answer and the Construct Ask-answer for a\nlive Neo run; every other /intents/* route proxies to the daemon.
EDGES
  ^contains=matrix/neo/internal/server.Server
  ^defines=matrix/neo/internal/server/server.go

NODE id=matrix/neo/internal/server.Server.handleMedia kind=method
  digest=b3:508aa32e4ef0a2b25896626413b96e5478c72dfcf168817f61ac3d16660a780f file=neo/internal/server/media.go range=127:161 lang=go exported=false byte_range=4055:5269
  sig=func (s *Server) handleMedia(w http.ResponseWriter, r *http.Request)
  doc=handleMedia streams a stored media file (GET /media/<name>). It is a Neo-owned\nroute registered before the catch-all daemon proxy.
EDGES
  ^contains=matrix/neo/internal/server.Server
  ^defines=matrix/neo/internal/server/media.go

NODE id=matrix/neo/internal/server.Server.handleReplay kind=method
  digest=b3:0fbb0fd6bc9d7acb3a63de52857c9cc3b49664377f01effe8319b0dd0848b873 file=neo/internal/server/server.go range=274:285 lang=go exported=false byte_range=11709:12214
  sig=func (s *Server) handleReplay(w http.ResponseWriter, r *http.Request)
  doc=handleReplay dumps a Neo run's buffered events and closes (finite), so the\nclient can reconnect: replay history, then open the live stream with\nsince_seq. Daemon intents fall through to the proxy.
EDGES
  ^contains=matrix/neo/internal/server.Server
  ^defines=matrix/neo/internal/server/server.go

NODE id=matrix/neo/internal/server.Server.handleTrace kind=method
  digest=b3:c1457d64a7ef5504ac618026f629548e131ad0868662235cb15c8e62ec7862f6 file=neo/internal/server/server.go range=236:260 lang=go exported=false byte_range=10304:11270
  sig=func (s *Server) handleTrace(w http.ResponseWriter, r *http.Request, id string)
  doc=handleTrace serves the durable workspace timeline for a conversation's most\nrecent run. A trace-disabled store, an unknown conversation, or a run with no\npersisted workspace all return 200 with an empty events list so the client\ndegrades to a text-only thread rather than erroring.
EDGES
  ^contains=matrix/neo/internal/server.Server
  ^defines=matrix/neo/internal/server/server.go

NODE id=matrix/neo/internal/server.Server.handleUpload kind=method
  digest=b3:a5da1fab0effb76e08d4eeef8f4310cad989fd878ec33767e4b289d54b78b529 file=neo/internal/server/media.go range=163:231 lang=go exported=false byte_range=5271:7804
  sig=func (s *Server) handleUpload(w http.ResponseWriter, r *http.Request)
  doc=handleUpload stores a user-uploaded media input (POST /upload, multipart with\na "file" field) on the machine volume and returns its /media reference. The\nclient embeds that reference in the next chat message so the model can pass\nit to edit_image / generate_video / transcribe_audio.
EDGES
  ^contains=matrix/neo/internal/server.Server
  ^defines=matrix/neo/internal/server/media.go

NODE id=matrix/neo/internal/server.Server.streamSSE kind=method
  digest=b3:b55f9b6dc328222015da78dabb9512f5745eef552685796d7ed62f40c06d09ef file=neo/internal/server/server.go range=403:458 lang=go exported=false byte_range=17360:18858
  sig=func (s *Server) streamSSE(w http.ResponseWriter, r *http.Request, id string, since int, live bool)
  doc=streamSSE writes the run's events as text/event-stream. When live is true it\nreplays buffered events (seq>since) then follows live until the run closes or\nthe client disconnects; when false it writes the buffer and returns.
EDGES
  ^contains=matrix/neo/internal/server.Server
  ^defines=matrix/neo/internal/server/server.go

NODE id=matrix/neo/internal/server.Server.warmOnFirstRequest kind=method
  digest=b3:ed439ecf34d96c4ec76e253ee127d674f7704f512b0a7697a92ef1d3f36ae33d file=neo/internal/server/server.go range=83:90 lang=go exported=false byte_range=3550:3881
  sig=func (s *Server) warmOnFirstRequest(next http.Handler) http.Handler
  doc=warmOnFirstRequest wraps next so every inbound request first pokes\nEngine.Warm (a no-op after the one-shot fires), then serves normally.
