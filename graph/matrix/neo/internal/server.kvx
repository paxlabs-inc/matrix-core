  ^implements=matrix/neo/internal/server.mcpAlarmController
  ^references=matrix/neo/internal/server.automatrixGovernor,matrix/neo/internal/server.newAutomatrixGovernor
  ^defines=matrix/neo/internal/server/automatrix_governor.go

NODE id=matrix/neo/internal/server.AutomatrixAlarmSpec kind=type
  digest=b3:d1d74027b7e9e9a9da3d9353b9dd85e8f27b4e40bd8dd2e6877b6b1c6e1c8e51 file=neo/internal/server/automatrix_governor.go range=38:58 lang=go exported=true byte_range=1538:2691
  sig=type AutomatrixAlarmSpec struct {\n	// ConversationID is the conversation Chronos delivers the wake turn into\n	// (required by Chronos). The proactive run itself resumes into each picked\n	// opportunity's own origin conversation (task 4.1), independent of this.\n	ConversationID	string\n	// CronExpr is the base recurring cadence (e.g. "@every 45m"); Neo\n	// reschedules each fire with jitter so wakes feel random (req 4.3).\n	CronExpr	string\n	// WakeMessage is the canonical AUTOMATRIX wake_message (carries the marker\n	// the agent detects). Set by the governor; the controller passes it through.\n	WakeMessage	string\n	// IdempotencyKey deduplicates the alarm so re-enabling never creates a\n	// second one (a user enables Automatrix exactly once; req 4.1 "exactly ONE").\n	IdempotencyKey	string\n	// Label is a human-readable label for the alarm.\n	Label	string\n}
  doc=AutomatrixAlarmSpec is the shape of the single recurring AUTOMATRIX alarm the\ngovernor asks the controller to create on enable. The wake_message is fixed\n(the canonical AUTOMATRIX marker text, agent.AutomatrixWakeMessage); only the\ndelivery conversation, cadence, and dedup key vary.
EDGES
  contains=matrix/neo/internal/server.AutomatrixAlarmSpec#ConversationID,matrix/neo/internal/server.AutomatrixAlarmSpec#CronExpr,matrix/neo/internal/server.AutomatrixAlarmSpec#IdempotencyKey,matrix/neo/internal/server.AutomatrixAlarmSpec#Label,matrix/neo/internal/server.AutomatrixAlarmSpec#WakeMessage
