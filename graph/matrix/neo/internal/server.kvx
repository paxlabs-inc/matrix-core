  ^defines=matrix/neo/internal/server/session.go

NODE id=matrix/neo/internal/server.session.setActive kind=method
  digest=b3:005663a57b1013e679ee5105f52ac25d0a3138effee4ca028f1cc4167f3e4300 file=neo/internal/server/session.go range=680:689 lang=go exported=false byte_range=28703:29152
  sig=func (s *session) setActive(r *run)
  doc=setActive / clearActive / interruptActive coordinate barge-in. active is the\nlatest dispatched run; interruptActive cancels it (LIFO), so each new message\nsupersedes the one before whether it is running or still queued. clearActive\nonly nils active when it still points at r, so a turn that has already been\nsuperseded never clears its successor.
EDGES
  ^contains=matrix/neo/internal/server.session
  ^defines=matrix/neo/internal/server/session.go

NODE id=matrix/neo/internal/server.session.startResume kind=method
  digest=b3:37708e80b0416927c8627d9c76be0b12e72bcc8a13c9ab4b26529e51f9344145 file=neo/internal/server/session.go range=277:282 lang=go exported=false byte_range=10355:10667
  sig=func (s *session) startResume(objective string) *run
  doc=startResume re-dispatches an orphaned task (the boot reaper after a restart /\nFly suspend): it drives the original objective with the catch-up prime from\nattempt one, since work may already exist on the volume.
EDGES
  ^contains=matrix/neo/internal/server.session
  ^defines=matrix/neo/internal/server/session.go

NODE id=matrix/neo/internal/server.session.submit kind=method
  digest=b3:7834b01433ffdb460c30a692e646d9a72da68a2dde2808a335689765971ca5df file=neo/internal/server/session.go range=258:275 lang=go exported=false byte_range=9483:10353
  sig=func (s *session) submit(message string) (runID string, fresh bool)
  doc=submit routes a fresh user message (F5: non-interrupting). If a turn is\nalready in flight for this conversation, the message is QUEUED into the live\nagent's inbox — delivered at the agent's NEXT tool-call boundary without\ninterrupting the run — and submit returns the active run's id with fresh\nfalse (the client keeps watching the same live stream). Otherwise it\ndispatches a fresh run and returns its id with fresh true. The active check\nand the dispatch are atomic under actMu so two near-simultaneous messages\nnever both spawn a run (the second folds into the first).
EDGES
  ^contains=matrix/neo/internal/server.session
  ^defines=matrix/neo/internal/server/session.go

NODE id=matrix/neo/internal/server.session.superviseAutomatrixTask kind=method
  digest=b3:472d95193206f55ef95adcc3bf331985014a660ae36cdbcba144c1639a693c49 file=neo/internal/server/session.go range=630:678 lang=go exported=false byte_range=26461:28701
  sig=func (s *session) superviseAutomatrixTask(ctx context.Context, objective string) task.Status
  doc=superviseAutomatrixTask is the QUIET sibling of superviseTask for an\nautonomous Automatrix run (task 4.1, req 5.1/5.3/5.4/5.5). It mirrors the\nreal supervisor's policy EXACTLY — the same pure superviseDecision over the\nagent's clean finish / failure class / wall-clock, the same jittered backoff,\nthe same FRESH-agent respawn over durable state across a non-clean exit — so\na proactive run is held to the SAME completion gate (inside agent.Chat:\nGateAllWork + the Cassandra adjudicator) as any state-touching turn. The two\ndifferences from superviseTask are deliberate: (1) the agent is the\nRESTRICTED no-money surface (the session was minted with automatrix=true), and\n(2) it surfaces NOTHING — no SSE/broker terminals, no honest-partial bubble in\nthe thread (req 5.5: a partial/failed proactive attempt is silent, never\nfailed-surprise spam). It returns the terminal task.Status so the runner can\nsettle the opportunity (done vs pending+attempts). A user stop cannot happen\nhere (no live run / no barge-in), so actInterrupted is unreachable.
EDGES
  ^contains=matrix/neo/internal/server.session
  ^defines=matrix/neo/internal/server/session.go

NODE id=matrix/neo/internal/server.session.superviseTask kind=method
  digest=b3:f4ac3bff741d020900513baf90cc503c55239d1e1905dfd9c6c5bb53a8da0608 file=neo/internal/server/session.go range=413:479 lang=go exported=false byte_range=16111:18995
  sig=func (s *session) superviseTask(ctx context.Context, r *run, objective string, resume bool) task.Status
  doc=superviseTask keeps at least one agent on the task until it is genuinely\ncomplete (the agent's own completion gate accepts and it Says its answer), is\ninterrupted by the user, or hits a hard ceiling. Every non-clean exit — a\nmodel/transport error, a no-progress stall, an exhausted step budget, a\nstuck attempt that timed out — is treated as "not done": it checkpoints, tells\nthe user it is still working (never a fake "done"), backs off, respawns a\nFRESH agent over durable state, and goes again.
EDGES
  ^contains=matrix/neo/internal/server.session
  ^defines=matrix/neo/internal/server/session.go

