NODE id=matrix/neo/internal/server.session#deathsSinceConsolidate kind=field
  digest=b3:e42dd73fa2f74107e5debef8224ab06338ae6d1b989c8cedb5b1cee0b22a61fd file=neo/internal/server/session.go range=90:96 lang=go exported=false byte_range=3546:3971
  sig=int
  doc=deathsSinceConsolidate counts loop deaths recorded since the last\nself-authoring consolidation pass (self-model task 3.2). When it reaches\ncfg.DeathConsolidateEvery the pass runs and the counter resets, so\nconsolidation happens on a bounded cadence — never every turn (req.5.2).\nMutated only under the serialized turn path (drive holds s.mu), so it needs\nno separate lock.
EDGES
  ^contains=matrix/neo/internal/server.session

