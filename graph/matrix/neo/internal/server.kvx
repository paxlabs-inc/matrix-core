NODE id=matrix/neo/internal/server.Engine.MaybeHandleAutomatrixWake kind=method
  digest=b3:ba10eb24e54a8b0bdb4337b8f1b3c2e201edaed8383360dee34360b7498f39b1 file=neo/internal/server/automatrix_wake.go range=189:201 lang=go exported=true byte_range=9567:10222
  sig=func (e *Engine) MaybeHandleAutomatrixWake(ctx context.Context, convID, message string) bool
  doc=MaybeHandleAutomatrixWake intercepts a Chronos AUTOMATRIX wake delivered over\nPOST /chat. It returns true iff the message is an AUTOMATRIX wake (so the\ncaller must NOT dispatch it as a normal user turn): the wake produces no live\nconversational run of its own — any proactive work is dispatched out of band\nby the runner seam (task 4.1). A non-wake message returns false and is left\nfor the normal /chat path.
EDGES
  calls=matrix/neo/internal/server.Engine.handleAutomatrixWake
  references=matrix/neo/internal/agent.AutomatrixWakeMarker,matrix/neo/internal/server.Engine,matrix/neo/internal/server.Engine.handleAutomatrixWake,matrix/neo/internal/server.convID,matrix/neo/internal/server.ctx,matrix/neo/internal/server.e,matrix/neo/internal/server.message
  ^contains=matrix/neo/internal/server.Engine
  ^calls=matrix/neo/internal/server.Server.handleChat
  ^references=matrix/neo/internal/server.Server.handleChat
  ^defines=matrix/neo/internal/server/automatrix_wake.go

NODE id=matrix/neo/internal/server.Engine.MaybeHandleMorningBriefWake kind=method
  digest=b3:b60a15472f132138e8f3c926ec4fe2d8231d4836175a86f818a451c07dfc56df file=neo/internal/server/brief_wake.go range=57:69 lang=go exported=true byte_range=2716:3360
  sig=func (e *Engine) MaybeHandleMorningBriefWake(ctx context.Context, convID, message string) bool
  doc=MaybeHandleMorningBriefWake intercepts a Chronos MORNING_BRIEF wake delivered\nover POST /chat. It returns true iff the message is a MORNING_BRIEF wake (so\nthe caller must NOT dispatch it as a normal user turn): the wake produces no\nlive conversational run of its own — the brief is composed out of band by the\nrunner and delivered durably (task 5.4). A non-wake message returns false and\nis left for the normal /chat path.
EDGES
  calls=matrix/neo/internal/agent.IsMorningBriefWake,matrix/neo/internal/server.Engine.handleMorningBriefWake
  references=matrix/neo/internal/agent.IsMorningBriefWake,matrix/neo/internal/server.Engine,matrix/neo/internal/server.Engine.handleMorningBriefWake,matrix/neo/internal/server.ctx,matrix/neo/internal/server.e,matrix/neo/internal/server.message
  ^contains=matrix/neo/internal/server.Engine
  ^calls=matrix/neo/internal/server.Server.handleChat
  ^references=matrix/neo/internal/server.Server.handleChat
  ^defines=matrix/neo/internal/server/brief_wake.go

NODE id=matrix/neo/internal/server.Engine.ResumeInProgressAutomatrix kind=method
  digest=b3:1074b0de2a5c28c17ab28ae8e6846d335f494758141398f0e906dd752d1a2a81 file=neo/internal/server/automatrix_run.go range=263:283 lang=go exported=true byte_range=12274:13131
  sig=func (e *Engine) ResumeInProgressAutomatrix() int
  doc=ResumeInProgressAutomatrix re-dispatches every opportunity left IN_PROGRESS in\nNeocortex — proactive runs that were in flight when the daemon was restarted or\nsuspended (the Task Durability Rule, req 5.1). Each resumes on the RESTRICTED\nsurface through the same dispatch path (InProgressOpportunities only returns\neligible-autonomous items, so a restart can never resume work on the money\nsurface). Called once at boot, after the normal task reaper. Best-effort;\nreturns the count resumed.
EDGES
  calls=matrix/neo/internal/memory.Pager.InProgressOpportunities,matrix/neo/internal/server.Engine.dispatchAutomatrixRun
  references=matrix/neo/internal/memory.Pager.InProgressOpportunities,matrix/neo/internal/server.Engine,matrix/neo/internal/server.Engine.dispatchAutomatrixRun,matrix/neo/internal/server.e,matrix/neo/internal/server.err,matrix/neo/internal/server.opp,matrix/neo/internal/server.opps
  ^contains=matrix/neo/internal/server.Engine
  ^calls=matrix/neo/cmd/neo.runServe
  ^references=matrix/neo/cmd/neo.runServe
  ^defines=matrix/neo/internal/server/automatrix_run.go

NODE id=matrix/neo/internal/server.Engine.ResumeInProgressBriefs kind=method
  digest=b3:bbb712cd48bed62085fae36f22b238bb7ed670c508b39ed2a324438fe62c5c4f file=neo/internal/server/brief_run.go range=253:272 lang=go exported=true byte_range=11307:12288
  sig=func (e *Engine) ResumeInProgressBriefs() int
  doc=ResumeInProgressBriefs re-dispatches every brief left running in the durable\nledger — briefs that were mid-compose when the daemon was restarted or\nsuspended (the Task Durability Rule, req 15.2). Each resumes on the RESTRICTED\nbrief surface through the same dispatch path (RunningKind returns ONLY\nKindBrief tasks, so a restart can never resume a brief on the money surface,\nand the normal reaper's Running() already excludes them). Called once at boot,\nafter the normal task reaper. Best-effort; returns the count resumed.
EDGES
  calls=matrix/neo/internal/server.Engine.dispatchBriefRun,matrix/neo/internal/task.Store.Enabled,matrix/neo/internal/task.Store.RunningKind
  references=matrix/neo/internal/server.Engine,matrix/neo/internal/server.Engine.dispatchBriefRun,matrix/neo/internal/server.briefs,matrix/neo/internal/server.e,matrix/neo/internal/server.localDate,matrix/neo/internal/server.t,matrix/neo/internal/task.KindBrief,matrix/neo/internal/task.Store.Enabled,matrix/neo/internal/task.Store.RunningKind
  ^contains=matrix/neo/internal/server.Engine
  ^calls=matrix/neo/cmd/neo.runServe
  ^references=matrix/neo/cmd/neo.runServe
  ^defines=matrix/neo/internal/server/brief_run.go

NODE id=matrix/neo/internal/server.Engine.ResumeOrphanedTasks kind=method
  digest=b3:aa6c0ddc2cd4a498a021d8ecda91d080765a4bf8e205785d7192072896ac0f09 file=neo/internal/server/engine.go range=480:510 lang=go exported=true byte_range=24169:25391
  sig=func (e *Engine) ResumeOrphanedTasks() int
  doc=ResumeOrphanedTasks re-dispatches every task left "running" in the durable\nledger — tasks orphaned when the daemon was restarted or Fly-suspended\nmid-work. Each resumes on its own conversation with the catch-up prime, so\nthe Task Durability Rule holds across a process death: a dropped task is\npicked back up and driven to completion rather than silently lost. Called\nonce at boot (cmd/neo serve). Best-effort + idempotent — a task that actually\nfinished is no longer "running" and is skipped, and the ledger's CAS-on-run-id\nkeeps a stale record from clobbering a live one. Returns the count resumed.
EDGES
  calls=matrix/neo/internal/runrecord.Record.Terminal,matrix/neo/internal/server.Engine.getRunRecord,matrix/neo/internal/server.session.startResume,matrix/neo/internal/server.sessionRegistry.get,matrix/neo/internal/task.Store.Enabled,matrix/neo/internal/task.Store.Finish,matrix/neo/internal/task.Store.Running
  references=matrix/neo/internal/runrecord.Record.Terminal,matrix/neo/internal/runrecord.StatusCompleted,matrix/neo/internal/runrecord.StatusInterrupted,matrix/neo/internal/server.Engine,matrix/neo/internal/server.Engine.getRunRecord,matrix/neo/internal/server.e,matrix/neo/internal/server.ok,matrix/neo/internal/server.orphans,matrix/neo/internal/server.rec,matrix/neo/internal/server.resumed,matrix/neo/internal/server.session.startResume,matrix/neo/internal/server.sessionRegistry.get,matrix/neo/internal/server.status,matrix/neo/internal/server.t,matrix/neo/internal/task.StatusCeiling,matrix/neo/internal/task.StatusDone,matrix/neo/internal/task.StatusInterrupted,matrix/neo/internal/task.Store.Enabled,matrix/neo/internal/task.Store.Finish,matrix/neo/internal/task.Store.Running
  ^contains=matrix/neo/internal/server.Engine
  ^calls=matrix/neo/cmd/neo.runServe
  ^references=matrix/neo/cmd/neo.runServe
  ^defines=matrix/neo/internal/server/engine.go

NODE id=matrix/neo/internal/server.Engine.RunAutomatrixOpportunity kind=method
  digest=b3:0c962fa8bb821d84f4b9d8a4e6acda086848ebbc240c4ef68d8e6717222a7242 file=neo/internal/server/automatrix_run.go range=53:84 lang=go exported=true byte_range=2446:4070
  sig=func (e *Engine) RunAutomatrixOpportunity(ctx context.Context, opp memory.OpportunitySpec) error
  doc=RunAutomatrixOpportunity is the AutomatrixRunner (wired via\nSetAutomatrixRunner). It performs the in-flight status hand-off synchronously\n(so a failure to even mark the opportunity in_progress is reported back to\nthe wake handler, which then does NOT advance the per-day counter) and then\ndispatches the supervised restricted-surface run on a background goroutine.\nA nil return means the proactive task was cleanly started.
EDGES
  calls=matrix/neo/internal/memory.Pager.SetOpportunityStatus,matrix/neo/internal/server.Engine.dispatchAutomatrixRun
  references=matrix/neo/internal/memory.OpportunityInProgress,matrix/neo/internal/memory.OpportunityPending,matrix/neo/internal/memory.OpportunityScheduled,matrix/neo/internal/memory.OpportunitySpec,matrix/neo/internal/memory.Pager.SetOpportunityStatus,matrix/neo/internal/server.Engine,matrix/neo/internal/server.Engine.dispatchAutomatrixRun,matrix/neo/internal/server.ctx,matrix/neo/internal/server.e,matrix/neo/internal/server.err,matrix/neo/internal/server.opp,matrix/neo/internal/server.uri
  ^contains=matrix/neo/internal/server.Engine
  ^calls=matrix/neo/internal/server.Engine.handleAutomatrixWake
  ^references=matrix/neo/cmd/neo.runServe
  ^defines=matrix/neo/internal/server/automatrix_run.go

NODE id=matrix/neo/internal/server.Engine.RunMorningBrief kind=method
  digest=b3:64e6b15d5d12eef5bedda36d3aa427c37744a78a56c1ae2b63d35b03353323eb file=neo/internal/server/brief_run.go range=44:54 lang=go exported=true byte_range=1919:2438
  sig=func (e *Engine) RunMorningBrief(_ context.Context, convID, localDate string) error
  doc=RunMorningBrief is the production BriefRunner. It records the brief durably in\nthe task ledger (Kind=brief, so the normal boot reaper never resumes it on the\nmoney surface) and dispatches the supervised run on a background goroutine.
