  ^contains=matrix/neo/internal/server.Server
  ^references=matrix/neo/internal/server.Server.routes
  ^defines=matrix/neo/internal/server/dojo.go

NODE id=matrix/neo/internal/server.Server.handleDojoComputerUse kind=method
  digest=b3:186368b7e96b1e0260d2e1cd1d37eca76945566d4b753dcadf5a7b5367311471 file=neo/internal/server/dojo.go range=470:538 lang=go exported=false byte_range=17867:21235
  sig=func (s *Server) handleDojoComputerUse(w http.ResponseWriter, r *http.Request)
  doc=handleDojoComputerUse is the loopback proxy the desktop bridge posts to\n(MATRIX_DOJO_URL/computer-use). It resolves the user's live disposable-desktop\nsession and rides the exec-curl carrier into the appliance's localhost:9990,\nrelaying the bytebotd response verbatim. It is gated on the shared bridge\ntoken so only the co-located bridge — never external router-forwarded\ntraffic — can drive the desktop (DOJO guard_surface).
EDGES
  calls=matrix/neo/internal/dojo.Manager.CallBytebotd,matrix/neo/internal/server.Engine.dojoBoot,matrix/neo/internal/server.bearerEquals,matrix/neo/internal/server.writeJSON
  references=matrix/neo/internal/dojo.ErrBooting,matrix/neo/internal/dojo.ErrBytebotd,matrix/neo/internal/dojo.ErrNoSession,matrix/neo/internal/dojo.ErrReobserveRequired,matrix/neo/internal/dojo.ErrTakeoverActive,matrix/neo/internal/dojo.Manager.CallBytebotd,matrix/neo/internal/server.Engine.dojoBoot,matrix/neo/internal/server.Server,matrix/neo/internal/server.bearerEquals,matrix/neo/internal/server.berr,matrix/neo/internal/server.body,matrix/neo/internal/server.desktopBootingMessage,matrix/neo/internal/server.e,matrix/neo/internal/server.err,matrix/neo/internal/server.r,matrix/neo/internal/server.resp,matrix/neo/internal/server.s,matrix/neo/internal/server.w,matrix/neo/internal/server.writeJSON
  ^contains=matrix/neo/internal/server.Server
  ^references=matrix/neo/internal/server.Server.routes
  ^defines=matrix/neo/internal/server/dojo.go

NODE id=matrix/neo/internal/server.Server.handleDojoFrame kind=method
  digest=b3:479fc50e201f21d33027c7c6aabbd5dd89d690a76eaa47350c0b23f0b1b55af3 file=neo/internal/server/dojo.go range=239:282 lang=go exported=false byte_range=8359:10151
  sig=func (s *Server) handleDojoFrame(w http.ResponseWriter, r *http.Request)
  doc=handleDojoFrame serves GET /dojo/frame?conversation={id}: one live-view\nframe of the conversation's desktop, JPEG-encoded for the wire. This is the\nwave-3 live-view transport: the client polls it while the panel is visible —\nplain request/response over the existing exec-curl carrier, no held stream\nto keepalive (the 2026-07-11 browser-heartbeat failure class cannot occur).\nFrames are passive: they never bump the session's idle clock.
EDGES
