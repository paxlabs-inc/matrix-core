  digest=b3:ef4c5d09c19246f5c512be4efae1b5dcb24bc8683b0a8443625dd4d46711f654 file=neo/internal/server/projects.go range=472:516 lang=go exported=false byte_range=13014:14040
  sig=func syncProjectTree(root string) error
  doc=syncProjectTree makes Save explicit: regular files are flushed before their\ncontaining directories, then the project root itself is synced.
