  ^contains=matrix/neo/internal/server.Engine
  ^references=matrix/neo/internal/server.Server.handleAutomatrixApprove
  ^defines=matrix/neo/internal/server/automatrix_routes.go

NODE id=matrix/neo/internal/server.Engine.settleAutomatrixOpportunity kind=method
  digest=b3:18195563ffa8e9344ce38888e07a48f610f3fee73b92aaa4d93dd73388b2347f file=neo/internal/server/automatrix_run.go range=125:151 lang=go exported=false byte_range=5789:7315
  sig=func (e *Engine) settleAutomatrixOpportunity(ctx context.Context, opp memory.OpportunitySpec, convID string, status task.Status, resultSummary string)
  doc=settleAutomatrixOpportunity records the run's terminal outcome on the\nopportunity (req 5.5). A genuine completion-gate pass marks it done AND\nannounces the result out of band (task 5.3); any other terminal (an honest\npartial at the ceiling, a deterministic blocker) leaves it re-pended with\nattempts++ (bounded; dismissed at the ceiling) for a later wake to retry —\nand surfaces NOTHING to the user (req 5.5/8.3: a non-completed task is never\nannounced). convID is the conversation the run executed in (origin thread, or\na synthetic one); resultSummary is the agent's captured final answer.
EDGES
  calls=matrix/neo/internal/memory.Pager.FailOpportunityAttempt,matrix/neo/internal/memory.Pager.SetOpportunityStatus,matrix/neo/internal/server.Engine.announceAutomatrixCompletion
  references=matrix/neo/internal/memory.OpportunityDone,matrix/neo/internal/memory.OpportunitySpec,matrix/neo/internal/memory.Pager.FailOpportunityAttempt,matrix/neo/internal/memory.Pager.SetOpportunityStatus,matrix/neo/internal/server.Engine,matrix/neo/internal/server.Engine.announceAutomatrixCompletion,matrix/neo/internal/server.automatrixMaxAttempts,matrix/neo/internal/server.convID,matrix/neo/internal/server.ctx,matrix/neo/internal/server.e,matrix/neo/internal/server.err,matrix/neo/internal/server.opp,matrix/neo/internal/server.resultSummary,matrix/neo/internal/server.status,matrix/neo/internal/server.uri,matrix/neo/internal/task.Status,matrix/neo/internal/task.StatusDone
  ^contains=matrix/neo/internal/server.Engine
  ^references=matrix/neo/internal/server.Engine.dispatchAutomatrixRun
  ^defines=matrix/neo/internal/server/automatrix_run.go

