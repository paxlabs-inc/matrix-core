NODE id=matrix/neo/internal/server.parseAlarmID kind=func
  digest=b3:9ddf53afb36db6523abf609aaa1f3ffc64a8d97fad221cc0a9efd3d77eedbda7 file=neo/internal/server/automatrix_governor.go range=286:302 lang=go exported=false byte_range=11810:12507
  sig=func parseAlarmID(out string) string
  doc=parseAlarmID extracts the created alarm's id from the alarm_set result. The\nchronos MCP bridge (tools/chronos/chronos.mjs envelopeResult) returns the\nchronosd envelope {"ok":true,"data":{"id":...,"next_fire_at":...,"status":...}}\nas the tool text, so the id normally lives one level down at data.id; a bare\n{"id":...} object is also accepted. Best-effort: parse the first JSON object\ncarrying an "id", descending through "data"/"alarm" wrappers.
EDGES
  calls=matrix/neo/internal/server.alarmIDFromObject
  references=matrix/neo/internal/server.alarmIDFromObject,matrix/neo/internal/server.obj,matrix/neo/internal/server.out
  ^calls=matrix/neo/internal/server.briefMCPAlarmController.Set,matrix/neo/internal/server.mcpAlarmController.Set
  ^references=matrix/neo/internal/server.briefMCPAlarmController.Set,matrix/neo/internal/server.mcpAlarmController.Set
  ^defines=matrix/neo/internal/server/automatrix_governor.go

NODE id=matrix/neo/internal/server.parseArtifact kind=func
  digest=b3:c61e78ca3d7c4db26f93f9135169cc1ce2bfefd2f35f24abc7a65ea4142cb39f file=neo/internal/server/engine.go range=1317:1344 lang=go exported=false byte_range=55485:56554
  sig=func parseArtifact(raw string) (artifactPayload, bool)
  doc=parseArtifact recognises a successful artifact-tool result. It accepts both\nthe nested ({ok:true,artifact:{kind,url,…}}) and the flat ({ok,kind,url,…})\nshapes, requires a deliverable kind + a URL ref, and never matches a media or\nsearch result (kind gating). Returns (payload, false) on any other shape so\nthe additive event is emitted ONLY for genuine deliverables.
EDGES
  calls=matrix/neo/internal/server.validArtifactKind
  references=matrix/neo/internal/server.a,matrix/neo/internal/server.artifactEnvelope,matrix/neo/internal/server.artifactPayload,matrix/neo/internal/server.env,matrix/neo/internal/server.err,matrix/neo/internal/server.raw,matrix/neo/internal/server.validArtifactKind
  ^calls=matrix/neo/internal/server.Engine.surfaceTool
  ^references=matrix/neo/internal/server.Engine.surfaceTool
  ^defines=matrix/neo/internal/server/engine.go

