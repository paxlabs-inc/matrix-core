NODE id=matrix/neo/internal/server.Engine.announceAutomatrixCompletion kind=method
  digest=b3:e2a397ada51c0742b6edb16b17dc35f65fe6fb8e6edbd57a3f67b2ca163c89c6 file=neo/internal/server/automatrix_run.go range=153:190 lang=go exported=false byte_range=7317:9384
  sig=func (e *Engine) announceAutomatrixCompletion(convID, opportunitySummary, resultSummary string)
  doc=announceAutomatrixCompletion is the completion -> durable record + notify seam\n(task 5.3, req 6.1/6.4/6.5/8.3). It runs ONLY on a genuine, gate-passed\nautonomous completion. The durable in-app record is written FIRST so the\nresult is the canonical, replayable surface even if no client is connected and\nregardless of any external-send outcome (req 6.1); the out-of-app ntfy/Apprise\nping is then fired BEST-EFFORT + non-blocking via notify.Deliver (req 6.4), so\na failed external send neither blocks the run nor disturbs the durable record\n(honest failure — a ping we couldn't send is never reported as delivered). All\ncopy is RESULT-not-protocol — no Chronos/alarm/marker/Neocortex jargon (req 6.5,\nthe consumer rule): the title is the helpful thing Neo took on and the body is\nthe result it produced (both plain English, sourced from the opportunity\nsummary + the agent's own final answer). No secrets are recorded or sent — the\nrecord shape is whitelist-only and the body is the model's user-facing answer.
EDGES
  calls=matrix/neo/internal/notify.Deliver,matrix/neo/internal/server.Engine.emitAutomatrixComplete,matrix/neo/internal/server.conciseAutomatrixResult
  references=matrix/neo/internal/notify.Deliver,matrix/neo/internal/notify.Notification,matrix/neo/internal/server.Engine,matrix/neo/internal/server.Engine.emitAutomatrixComplete,matrix/neo/internal/server.conciseAutomatrixResult,matrix/neo/internal/server.convID,matrix/neo/internal/server.e,matrix/neo/internal/server.opportunitySummary,matrix/neo/internal/server.result,matrix/neo/internal/server.resultSummary,matrix/neo/internal/server.title
  ^contains=matrix/neo/internal/server.Engine
  ^calls=matrix/neo/internal/server.Engine.settleApprovedOpportunity,matrix/neo/internal/server.Engine.settleAutomatrixOpportunity
  ^references=matrix/neo/internal/server.Engine.settleApprovedOpportunity,matrix/neo/internal/server.Engine.settleAutomatrixOpportunity
  ^defines=matrix/neo/internal/server/automatrix_run.go

