NODE id=matrix/neo/internal/server.swarmActiveKey kind=type
  digest=b3:bb05259f016415e7511ac2c99a6566a835043b1e95031e1ecd295b3e51c1b1bc file=neo/internal/server/swarm.go range=31:34 lang=go exported=false byte_range=987:1247
  sig=type swarmActiveKey struct{}
  doc=swarmActiveKey marks a context as already running inside a swarm, so a\nsub-agent that somehow reaches spawn_subagents is refused (no recursion /\nfork-bombs). Sub-agents are never advertised the tool, so this is a backstop.
EDGES
  ^defines=matrix/neo/internal/server/swarm.go

NODE id=matrix/neo/internal/server.swarmBackoff kind=func
  digest=b3:b37525655b417b9e61f7595b5703d6c490d0fca6c3f1d10f675c13a4fe70891a file=neo/internal/server/swarm.go range=236:251 lang=go exported=false byte_range=8210:8642
