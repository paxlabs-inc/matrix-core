NODE id=matrix/neo/internal/server.Server.handleChat kind=method
  digest=b3:131019d7d59f83a11ef7ad9ff782f062f10917e7701ceeb3083d828567bc6637 file=neo/internal/server/server.go range=98:152 lang=go exported=false byte_range=4091:6592
