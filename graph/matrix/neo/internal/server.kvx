NODE id=matrix/neo/internal/server.commandQueue.Close kind=method
  digest=b3:fe0ec990164fbd7d2db85e8283c1f70db1b8cdd308afd510321a055fe2c4b475 file=neo/internal/server/queue.go range=139:148 lang=go exported=true byte_range=4484:4745
  sig=func (q *commandQueue) Close()
  doc=Close shuts down the pump goroutine, cancelling any in-flight turn. It waits\nfor the pump to exit. After Close, the queue must not be reused.
