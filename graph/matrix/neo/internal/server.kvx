  ^contains=matrix/neo/internal/server.session
  ^defines=matrix/neo/internal/server/session.go

NODE id=matrix/neo/internal/server.session.pendingAsk kind=method
  digest=b3:f6e74cf8604e03a576cb7817e5fb8d54019cb6c44ff2d0e200c95d4cf080bea2 file=neo/internal/server/session.go range=788:798 lang=go exported=false byte_range=31475:31810
  sig=func (s *session) pendingAsk(askID string) (*primitives.Ask, bool)
  doc=pendingAsk returns the Ask a waiter is parked on, so the receiver can\nvalidate a posted response against its contract before delivering it.
EDGES
  ^contains=matrix/neo/internal/server.session
  ^defines=matrix/neo/internal/server/session.go

NODE id=matrix/neo/internal/server.session.rebuildAgent kind=method
  digest=b3:2af1f997c4b4942d39d66739de4aa41f3dfd0bc9dd3a06d1ef1ba4115c69715e file=neo/internal/server/session.go range=151:229 lang=go exported=false byte_range=4872:8800
  sig=func (s *session) rebuildAgent()
  doc=rebuildAgent mints a FRESH agent for this conversation over a clean context\nwindow and seeds it from durable history. It runs when the session is first\nminted AND on every task-supervisor respawn: a hard failure, a stall, or a\nwedged transcript never carries into the next attempt, because the new agent\nstarts from durable TEXT history (no prior tool_calls to re-poison a strict\nprovider) plus the resume prime and the work already on the volume.
EDGES
  ^contains=matrix/neo/internal/server.session
  ^defines=matrix/neo/internal/server/session.go

NODE id=matrix/neo/internal/server.session.registerAsk kind=method
  digest=b3:268bf595441886604ed3f41d61324b2fce452d58863ab9b4b1b06ca244693513 file=neo/internal/server/session.go range=780:786 lang=go exported=false byte_range=31236:31473
  sig=func (s *session) registerAsk(askID string, ask *primitives.Ask) <-chan *primitives.AskResponse
