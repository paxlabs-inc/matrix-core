NODE id=matrix/neo/internal/server.session.superviseTask kind=method
  digest=b3:01f0f6e82465c9a55b56d93cdcff4b346858339b5afca003ad4ec7d6e11659e7 file=neo/internal/server/session.go range=683:784 lang=go exported=false byte_range=28348:33169
  sig=func (s *session) superviseTask(ctx context.Context, r *run, objective string, resume bool, audio *agent.AudioTurn) task.Status
  doc=superviseTask keeps at least one agent on the task until it is genuinely\ncomplete (the agent's own completion gate accepts and it Says its answer), is\ninterrupted by the user, or hits a hard ceiling. Every non-clean exit — a\nmodel/transport error, a no-progress stall, an exhausted step budget, a\nstuck attempt that timed out — is treated as "not done": it checkpoints, tells\nthe user it is still working (never a fake "done"), backs off, respawns a\nFRESH agent over durable state, and goes again.
EDGES
  calls=matrix/neo/internal/agent.Agent.Chat,matrix/neo/internal/agent.Agent.ChatAudio,matrix/neo/internal/agent.Agent.ChatResume,matrix/neo/internal/agent.Agent.LastFailureClass,matrix/neo/internal/agent.Agent.SetRecentConversationHistory,matrix/neo/internal/agent.Agent.SetRunIdentity,matrix/neo/internal/conversation.Store.Enabled,matrix/neo/internal/conversation.Store.Recent,matrix/neo/internal/server.dropCurrentRun,matrix/neo/internal/server.friendlyErr,matrix/neo/internal/server.postureRespawnLimit,matrix/neo/internal/server.resumePrime,matrix/neo/internal/server.seedMessages,matrix/neo/internal/server.session.appendRecoveryEvent,matrix/neo/internal/server.session.appendSupervisorEvent,matrix/neo/internal/server.session.attemptContext,matrix/neo/internal/server.session.deliverCeiling,matrix/neo/internal/server.session.deliverDeterministicStop,matrix/neo/internal/server.session.emitProgress,matrix/neo/internal/server.session.rebuildAgent,matrix/neo/internal/server.session.recordLoopDeath,matrix/neo/internal/server.superviseBackoff,matrix/neo/internal/server.superviseDecision,matrix/neo/internal/server.withRun,matrix/neo/internal/task.Store.Checkpoint
