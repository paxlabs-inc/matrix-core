  digest=b3:8080c1ab11fdcbb7200c3426424f1dc2fd9e6e20d1fe8d8d8dd4a2dceb6dc6ce file=neo/internal/server/sse.go range=202:208 lang=go exported=false byte_range=5874:6085
  sig=func (b *broker) drop(id string)
  doc=drop discards a finished run's topic to bound memory. Called after a grace\nperiod so late reconnects can still replay.
