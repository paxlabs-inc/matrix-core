NODE id=matrix/neo/internal/server.Server.handleAskAnswer kind=method
  digest=b3:d333d29a765befbb645cb80fd3798c3c11123178effd769f91d9b182ba07c626 file=neo/internal/server/server.go range=908:939 lang=go exported=false byte_range=39846:41314
  sig=func (s *Server) handleAskAnswer(w http.ResponseWriter, r *http.Request, id, askID string)
  doc=handleAskAnswer delivers a typed human response to a parked Construct Ask\n(the back-channel of the construct_render(kind=ask) tool call). It validates\nthe posted AskResponse against the Ask it answers BEFORE delivering it, so a\nmalformed or off-contract answer is rejected (the run stays parked) rather\nthan resuming the agent with garbage. A stale/duplicate/unknown ask_id is a\n404. The caller has already confirmed the run is live.
EDGES
  calls=matrix/construct/backchannel.ValidateResponse,matrix/neo/internal/server.Engine.lookupRun,matrix/neo/internal/server.session.answerAsk,matrix/neo/internal/server.session.pendingAsk,matrix/neo/internal/server.writeJSON
  references=matrix/construct/backchannel.ValidateResponse,matrix/construct/schema/primitives.AskResponse,matrix/neo/internal/server.Engine.lookupRun,matrix/neo/internal/server.Server,matrix/neo/internal/server.ask,matrix/neo/internal/server.askID,matrix/neo/internal/server.err,matrix/neo/internal/server.id,matrix/neo/internal/server.ok,matrix/neo/internal/server.r,matrix/neo/internal/server.resp,matrix/neo/internal/server.run,matrix/neo/internal/server.s,matrix/neo/internal/server.session.answerAsk,matrix/neo/internal/server.session.pendingAsk,matrix/neo/internal/server.w,matrix/neo/internal/server.writeJSON
  ^contains=matrix/neo/internal/server.Server
  ^calls=matrix/neo/internal/server.Server.handleIntents
  ^references=matrix/neo/internal/server.Server.handleIntents
  ^defines=matrix/neo/internal/server/server.go

NODE id=matrix/neo/internal/server.Server.handleAsyncPoll kind=method
  digest=b3:f604a7d5d74437ea6d333c2455d2c3ebf98faa6ea040c66e4b4748486f53a154 file=neo/internal/server/server.go range=763:817 lang=go exported=false byte_range=34052:36085
  sig=func (s *Server) handleAsyncPoll(w http.ResponseWriter, r *http.Request)
  doc=handleAsyncPoll answers the poll_url that POST /chat advertises for a Neo run\n(GET /messages/async/<id>). The web client polls it on reload to decide\nwhether to reconnect a still-live run; without this it would be proxied to\nthe daemon, which has never heard of a neo_ intent and returns 404. Daemon\nasync jobs (non-Neo intents) fall through to the proxy unchanged.
EDGES
  calls=matrix/neo/internal/server.Engine.getRunRecord,matrix/neo/internal/server.Engine.lookupRun,matrix/neo/internal/server.broker.has,matrix/neo/internal/server.writeJSON
  references=matrix/neo/internal/server.Engine.getRunRecord,matrix/neo/internal/server.Engine.lookupRun,matrix/neo/internal/server.Server,matrix/neo/internal/server.body,matrix/neo/internal/server.broker.has,matrix/neo/internal/server.err,matrix/neo/internal/server.id,matrix/neo/internal/server.ok,matrix/neo/internal/server.r,matrix/neo/internal/server.rec,matrix/neo/internal/server.s,matrix/neo/internal/server.status,matrix/neo/internal/server.w,matrix/neo/internal/server.writeJSON
  ^contains=matrix/neo/internal/server.Server
  ^references=matrix/neo/internal/server.Server.routes
  ^defines=matrix/neo/internal/server/server.go

