NODE id=matrix/neo/internal/server.Engine#gateClaims kind=field
  digest=b3:85434c07a6c337d396b02fd4ed2d3ab30104fec334c083aad34e9a6ecf2d1ac3 file=neo/internal/server/engine.go range=148:148 lang=go exported=false byte_range=6496:6524
