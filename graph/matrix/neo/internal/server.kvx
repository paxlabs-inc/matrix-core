NODE id=matrix/neo/internal/server.Server.handleConversations kind=method
  digest=b3:de0a94b26a4c65642306293efeb8489ff250bbbd7077f7cbca1ae6a45a95f580 file=neo/internal/server/server.go range=405:486 lang=go exported=false byte_range=20359:23773
  sig=func (s *Server) handleConversations(w http.ResponseWriter, r *http.Request)
  doc=handleConversations serves GET /conversations (list) and\nGET /conversations/<id> (full turn log) from Neo's durable store. The shape\nmirrors the daemon's routes (and the web client's expectations) exactly:\nlist → {"items":[summary...]}, detail → the record. When persistence is\ndisabled it proxies to the daemon so the legacy store still answers.\n\nF1 wire shape (additive, byte-compatible): the detail response carries a\nsibling `live_run` field — the in-flight intent_id for this conversation, or\n"" once the run has settled. The existing record fields\n(conversation_id, title, turns, updated) are emitted unchanged so older\nclients keep deserialising. New clients use `live_run` to subscribe to the\nSSE stream with replay on reopen/relogin without waiting for the\n/messages/async/<id> poll — the durable resume signal that closes the\n"thread looks done while agent is still working" defect.
EDGES
  calls=matrix/neo/internal/conversation.Store.Enabled,matrix/neo/internal/conversation.Store.Get,matrix/neo/internal/conversation.Store.List,matrix/neo/internal/server.Engine.activeRunForConv,matrix/neo/internal/server.Server.handleConversationDelete,matrix/neo/internal/server.Server.handleConversationFork,matrix/neo/internal/server.Server.handleConversationPatch,matrix/neo/internal/server.Server.handleTrace,matrix/neo/internal/server.conversationDetailEnvelope,matrix/neo/internal/server.parseForkPath,matrix/neo/internal/server.parseTracePath,matrix/neo/internal/server.writeJSON
  references=matrix/neo/internal/conversation.Store.Enabled,matrix/neo/internal/conversation.Store.Get,matrix/neo/internal/conversation.Store.List,matrix/neo/internal/conversation.Summary,matrix/neo/internal/server.Engine.activeRunForConv,matrix/neo/internal/server.Server,matrix/neo/internal/server.Server.handleConversationDelete,matrix/neo/internal/server.Server.handleConversationFork,matrix/neo/internal/server.Server.handleConversationPatch,matrix/neo/internal/server.Server.handleTrace,matrix/neo/internal/server.conversationDetailEnvelope,matrix/neo/internal/server.filtered,matrix/neo/internal/server.id,matrix/neo/internal/server.it,matrix/neo/internal/server.items,matrix/neo/internal/server.ok,matrix/neo/internal/server.parseForkPath,matrix/neo/internal/server.parseTracePath,matrix/neo/internal/server.project,matrix/neo/internal/server.r,matrix/neo/internal/server.rec,matrix/neo/internal/server.s,matrix/neo/internal/server.w,matrix/neo/internal/server.writeJSON
  ^contains=matrix/neo/internal/server.Server
  ^references=matrix/neo/internal/server.Server.routes
  ^defines=matrix/neo/internal/server/server.go

