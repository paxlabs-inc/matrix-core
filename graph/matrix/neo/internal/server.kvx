NODE id=matrix/neo/internal/server.decideAutomatrixWake kind=func
  digest=b3:19216686268f4f801b593caccc2bce43e797245d19340991ab052a934a7ac1ba file=neo/internal/server/automatrix_wake.go range=143:172 lang=go exported=false byte_range=7542:9054
  sig=func decideAutomatrixWake(in automatrixWakeInput, rng *rand.Rand) automatrixDecision
  doc=decideAutomatrixWake is the PURE wake-decision policy. It consumes rng in a\nfixed order (jitter then skip) so any reschedule path is deterministic for a\nseeded rng regardless of which branch is taken. Order of checks matters:\nopt-out wins over everything (cancel, never run); a busy session defers; the\nper-day cap defers; a probabilistic skip defers; otherwise pick the top\neligible-pending opportunity, or resolve to idle when the queue is empty.
EDGES
  ^defines=matrix/neo/internal/server/automatrix_wake.go

NODE id=matrix/neo/internal/server.describeStep kind=func
  digest=b3:0577e6e64ba52f8bfbe7a1f589946e9165297ca25bccb4799149065064f28bb3 file=neo/internal/server/surface.go range=14:94 lang=go exported=false byte_range=275:3027
  sig=func describeStep(ev agent.ToolEvent) map[string]interface{}
  doc=describeStep classifies one tool call into a "workspace surface" the client\nrenders as an animated viewport — never a label. It extracts the REAL inputs\n(the command, the URL, the file path) from the call arguments and the output\nfrom the result, so the surface shows what Neo is actually doing.\n\nSurfaces:\n  - terminal : shell / service commands  -> animated terminal window\n  - browser  : browser_* + fetch          -> browser chrome + viewport\n  - editor   : filesystem reads/writes     -> code-editor window\n  - search   : web_search / web_news       -> running chip (cards render separately)\n  - media    : image/video/audio tools     -> running chip (media grid renders separately)\n  - action   : everything else             -> a minimal animated action chip
EDGES
  ^defines=matrix/neo/internal/server/surface.go

NODE id=matrix/neo/internal/server.extForUpload kind=func
  digest=b3:3ea7c968e7fa17efb187fd4d3c68f80655335e657ba66a5b6e10230af4e77fc5 file=neo/internal/server/media.go range=96:119 lang=go exported=false byte_range=3229:3892
  sig=func extForUpload(filename, contentType string) string
  doc=extForUpload picks a safe extension from the uploaded filename, falling back\nto the declared content type. Returns "" if neither yields a known media ext.
EDGES
  ^defines=matrix/neo/internal/server/media.go

NODE id=matrix/neo/internal/server.fillBrowser kind=func
  digest=b3:1fff2420f4c88465ef7b27d1e6b09569d55c59db2bc63a5008be83a287e24409 file=neo/internal/server/surface.go range=96:140 lang=go exported=false byte_range=3029:4545
  sig=func fillBrowser(step map[string]interface{}, bare string, ev agent.ToolEvent, running bool)
  doc=fillBrowser maps a browser_* tool onto the browser surface: the action verb,\nthe URL it's on, the human element it's acting on, and any typed text.\n\nPlaywright's tools return a structured page report (Page URL / Page Title /\na YAML accessibility snapshot), NOT human prose. We parse the real URL +\ntitle into the browser chrome and distil the snapshot into readable page\ntext — so the surface renders like a page, never a raw JSON/YAML dump.
EDGES
  ^defines=matrix/neo/internal/server/surface.go

