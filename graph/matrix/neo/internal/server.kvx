  ^defines=matrix/neo/internal/server/session.go

NODE id=matrix/neo/internal/server.sseReporter.Progress kind=method
  digest=b3:c70b5d3a552437d02ade43f87924107b3bbb94428add3cf8f62360647542243c file=neo/internal/server/session.go range=939:960 lang=go exported=true byte_range=36911:37894
  sig=func (r *sseReporter) Progress(text string)
  doc=Progress surfaces the SYNTHETIC narrate-before-act intent stub (e.g. "Layerx\ndeposit.") — Neo generated it from the tool name, so it is EPHEMERAL: shown\nlive (flagged ephemeral:true so the client renders it transiently and never\ncounts it as durable thread content) but NEVER persisted and NEVER marking\nrun.narrated. That distinction is load-bearing: run.narrated gates whether the\naccepted task_complete summary is hidden as a redundant recap, so letting a\nsynthetic stub set it was exactly the bug where a straight-to-task_complete\nturn dropped the real answer (the user saw only "Layerx deposit.").
EDGES
  ^contains=matrix/neo/internal/server.sseReporter
  ^defines=matrix/neo/internal/server/session.go

