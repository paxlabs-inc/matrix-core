  references=matrix/neo/internal/dojo.ErrBooting,matrix/neo/internal/dojo.ErrNoSession,matrix/neo/internal/dojo.ErrNotFound,matrix/neo/internal/dojo.Manager.Frame,matrix/neo/internal/server.Server,matrix/neo/internal/server.conv,matrix/neo/internal/server.e,matrix/neo/internal/server.err,matrix/neo/internal/server.jerr,matrix/neo/internal/server.jpg,matrix/neo/internal/server.png,matrix/neo/internal/server.r,matrix/neo/internal/server.reencodeJPEG,matrix/neo/internal/server.s,matrix/neo/internal/server.w,matrix/neo/internal/server.writeJSON
  ^contains=matrix/neo/internal/server.Server
  ^references=matrix/neo/internal/server.Server.routes
  ^defines=matrix/neo/internal/server/dojo.go

