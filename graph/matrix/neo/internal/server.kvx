NODE id=matrix/neo/internal/server.Engine.profileSnapshot kind=method
  digest=b3:fabf75ea3cf875d126b5498d1bb1642927c593aa369ade6ab1ca2125bc49c38f file=neo/internal/server/engine.go range=1030:1036 lang=go exported=false byte_range=41553:41887
  sig=func (e *Engine) profileSnapshot() (agentName, preferredName string, expertiseDomains []string)
  doc=profileSnapshot returns the current cached profile under lock, for safe\ninjection into a freshly rebuilt agent.
