  ^contains=matrix/neo/internal/server.commandQueue
  ^defines=matrix/neo/internal/server/queue.go

NODE id=matrix/neo/internal/server.commandQueue.Enqueue kind=method
  digest=b3:7dd123707896917f616691939fa865269aef8d400eb20e433da640529646f1b0 file=neo/internal/server/queue.go range=94:108 lang=go exported=true byte_range=3075:3643
  sig=func (q *commandQueue) Enqueue(msg string)
  doc=Enqueue adds a message to the pending buffer and wakes the pump. The message\nwill be dispatched (or coalesced, in collect mode) when the active turn\nfinishes — never interrupting the in-flight turn.
EDGES
  ^contains=matrix/neo/internal/server.commandQueue
  ^defines=matrix/neo/internal/server/queue.go

NODE id=matrix/neo/internal/server.commandQueue.Generation kind=method
  digest=b3:e0fb1c34b1e1604bbaf4ff316400368201ffb27b8997c77f0a6c35b1044fa6a6 file=neo/internal/server/queue.go range=124:130 lang=go exported=true byte_range=4066:4306
  sig=func (q *commandQueue) Generation() uint64
  doc=Generation returns the current generation counter (last dispatched or\nsuperseded). A result tagged with a generation < this value is stale.
EDGES
  ^contains=matrix/neo/internal/server.commandQueue
  ^defines=matrix/neo/internal/server/queue.go

NODE id=matrix/neo/internal/server.commandQueue.IsStale kind=method
