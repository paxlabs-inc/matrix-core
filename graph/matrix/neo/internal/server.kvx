NODE id=matrix/neo/internal/server.Engine.AutomatrixInbox kind=method
  digest=b3:afa8c71600aac44ec236558f3c36149ef6222945cf6f37c7b3ef0a56d2a6e965 file=neo/internal/server/engine.go range=722:725 lang=go exported=true byte_range=30802:31118
  sig=func (e *Engine) AutomatrixInbox() *automatrixlog.Store
  doc=AutomatrixInbox exposes the durable Automatrix completion store so the daemon\nroutes can render the in-app inbox / unread badge and mark items read (req\n7.4). Returns the (possibly disabled) store; never nil for a built engine.
EDGES
  ^contains=matrix/neo/internal/server.Engine
  ^defines=matrix/neo/internal/server/engine.go

NODE id=matrix/neo/internal/server.Engine.Close kind=method
  digest=b3:055eda94762b45e288359482491b570fa414df7e960defdb13801452ac8f941c file=neo/internal/server/engine.go range=266:274 lang=go exported=true byte_range=13026:13329
  sig=func (e *Engine) Close()
  doc=Close flushes and stops the engine's durable sidecar stores (today: the\nworkspace trace writer). Called on graceful shutdown so any queued workspace\nevents are persisted before exit. Idempotent + safe on a disabled store.
EDGES
  ^contains=matrix/neo/internal/server.Engine
  ^defines=matrix/neo/internal/server/engine.go

NODE id=matrix/neo/internal/server.Engine.MaybeHandleAutomatrixWake kind=method
  digest=b3:ba10eb24e54a8b0bdb4337b8f1b3c2e201edaed8383360dee34360b7498f39b1 file=neo/internal/server/automatrix_wake.go range=189:201 lang=go exported=true byte_range=9567:10222
  sig=func (e *Engine) MaybeHandleAutomatrixWake(ctx context.Context, convID, message string) bool
  doc=MaybeHandleAutomatrixWake intercepts a Chronos AUTOMATRIX wake delivered over\nPOST /chat. It returns true iff the message is an AUTOMATRIX wake (so the\ncaller must NOT dispatch it as a normal user turn): the wake produces no live\nconversational run of its own — any proactive work is dispatched out of band\nby the runner seam (task 4.1). A non-wake message returns false and is left\nfor the normal /chat path.
EDGES
  ^contains=matrix/neo/internal/server.Engine
  ^defines=matrix/neo/internal/server/automatrix_wake.go

NODE id=matrix/neo/internal/server.Engine.ResumeInProgressAutomatrix kind=method
  digest=b3:bfb2ccdd6585d06790fe6ed6ead876ed7a0e47858e32614a1e7afa31f1a62b14 file=neo/internal/server/automatrix_run.go range=242:262 lang=go exported=true byte_range=11405:12259
  sig=func (e *Engine) ResumeInProgressAutomatrix() int
  doc=ResumeInProgressAutomatrix re-dispatches every opportunity left IN_PROGRESS in\ncortex — proactive runs that were in flight when the daemon was restarted or\nsuspended (the Task Durability Rule, req 5.1). Each resumes on the RESTRICTED\nsurface through the same dispatch path (InProgressOpportunities only returns\neligible-autonomous items, so a restart can never resume work on the money\nsurface). Called once at boot, after the normal task reaper. Best-effort;\nreturns the count resumed.
EDGES
  ^contains=matrix/neo/internal/server.Engine
  ^defines=matrix/neo/internal/server/automatrix_run.go

NODE id=matrix/neo/internal/server.Engine.ResumeOrphanedTasks kind=method
  digest=b3:6e5193149c7e5efdb152dafa2f39292c4297a166bd6b488b4356bde0cdd5d2d9 file=neo/internal/server/engine.go range=247:264 lang=go exported=true byte_range=12157:13024
  sig=func (e *Engine) ResumeOrphanedTasks() int
  doc=ResumeOrphanedTasks re-dispatches every task left "running" in the durable\nledger — tasks orphaned when the daemon was restarted or Fly-suspended\nmid-work. Each resumes on its own conversation with the catch-up prime, so\nthe Task Durability Rule holds across a process death: a dropped task is\npicked back up and driven to completion rather than silently lost. Called\nonce at boot (cmd/neo serve). Best-effort + idempotent — a task that actually\nfinished is no longer "running" and is skipped, and the ledger's CAS-on-run-id\nkeeps a stale record from clobbering a live one. Returns the count resumed.
EDGES
  ^contains=matrix/neo/internal/server.Engine
  ^defines=matrix/neo/internal/server/engine.go

NODE id=matrix/neo/internal/server.Engine.RunAutomatrixOpportunity kind=method
  digest=b3:0c962fa8bb821d84f4b9d8a4e6acda086848ebbc240c4ef68d8e6717222a7242 file=neo/internal/server/automatrix_run.go range=52:83 lang=go exported=true byte_range=2407:4031
  sig=func (e *Engine) RunAutomatrixOpportunity(ctx context.Context, opp memory.OpportunitySpec) error
  doc=RunAutomatrixOpportunity is the AutomatrixRunner (wired via\nSetAutomatrixRunner). It performs the in-flight status hand-off synchronously\n(so a failure to even mark the opportunity in_progress is reported back to\nthe wake handler, which then does NOT advance the per-day counter) and then\ndispatches the supervised restricted-surface run on a background goroutine.\nA nil return means the proactive task was cleanly started.
EDGES
  ^contains=matrix/neo/internal/server.Engine
  ^defines=matrix/neo/internal/server/automatrix_run.go

NODE id=matrix/neo/internal/server.Engine.SetAutomatrixGovernor kind=method
  digest=b3:41457667809c6218a250c9f5c881e3e45336c8cf31f79186a72ec3c36b591b5d file=neo/internal/server/automatrix_wake.go range=85:87 lang=go exported=true byte_range=4337:4575
  sig=func (e *Engine) SetAutomatrixGovernor(g AutomatrixGovernor)
  doc=SetAutomatrixGovernor wires the per-user opt-in + alarm bookkeeping seam\n(task 6.1). Safe to leave unset: the wake handler fails closed without it.
EDGES
  ^contains=matrix/neo/internal/server.Engine
  ^defines=matrix/neo/internal/server/automatrix_wake.go

NODE id=matrix/neo/internal/server.Engine.SetAutomatrixNotifier kind=method
  digest=b3:1354d907a7bdea3ff262bd974386d3166cf4dfd0b56a22ca21c1f92be313d406 file=neo/internal/server/automatrix_wake.go range=93:99 lang=go exported=true byte_range=4813:5298
  sig=func (e *Engine) SetAutomatrixNotifier(n notify.Notifier)
  doc=SetAutomatrixNotifier overrides the out-of-app completion-ping Notifier\n(task 5.3). NewEngine already builds one from config; this seam lets wiring\nor a test install a real Notifier pointed at a specific endpoint (e.g. an\nhttptest ntfy server). A nil notifier is tolerated downstream (notify.Deliver\ntreats it as a safe no-op), and the durable in-app record is written\nregardless.
EDGES
  ^contains=matrix/neo/internal/server.Engine
  ^defines=matrix/neo/internal/server/automatrix_wake.go

NODE id=matrix/neo/internal/server.Engine.SetAutomatrixRunner kind=method
  digest=b3:0fc4cda8812916c41f3e30d004428f915a8174d67a044169952f0b08443b8538 file=neo/internal/server/automatrix_wake.go range=89:91 lang=go exported=true byte_range=4577:4811
  sig=func (e *Engine) SetAutomatrixRunner(r AutomatrixRunner)
  doc=SetAutomatrixRunner wires the supervised restricted-surface run dispatch\n(task 4.1). Safe to leave unset: the handler still picks + reschedules.
EDGES
  ^contains=matrix/neo/internal/server.Engine
  ^defines=matrix/neo/internal/server/automatrix_wake.go

NODE id=matrix/neo/internal/server.Engine.Warm kind=method
  digest=b3:68770e9d0b20e48eff5e5e6ac5072338908f5bbd4fd778a02c3abc212decda65 file=neo/internal/server/engine.go range=285:306 lang=go exported=true byte_range=13747:14537
  sig=func (e *Engine) Warm()
  doc=Warm is the Q2 warm-on-open hook: the FIRST inbound HTTP request kicks a\none-shot, NON-BLOCKING warm of the embedder + HNSW semantic substrate so the\nfirst message's relevance recall (agent.cmRelevancePush) isn't paying the\ncold-start. It returns immediately; the actual warm runs on a background\ngoroutine bounded by warmTimeout. Idempotent via warmOnce, and a no-op when\nWarmOnOpen is off, the pager is nil, or no embedder is running (the salience\nlane needs no warming).
EDGES
  ^contains=matrix/neo/internal/server.Engine
  ^defines=matrix/neo/internal/server/engine.go

NODE id=matrix/neo/internal/server.Engine.Warmed kind=method
  digest=b3:d37348c3deac1de7a09fe888af7fc6316470db7bb0e678f37c108cf85daec26a file=neo/internal/server/engine.go range=322:327 lang=go exported=true byte_range=15146:15420
  sig=func (e *Engine) Warmed() bool
  doc=Warmed reports whether the background warm has completed. Observability for\ntests + readiness checks; false until the warm goroutine finishes (or forever\nwhen warming is disabled / unavailable).
EDGES
  ^contains=matrix/neo/internal/server.Engine
  ^defines=matrix/neo/internal/server/engine.go

NODE id=matrix/neo/internal/server.Engine.activeRunForConv kind=method
  digest=b3:453f67114f9c08e1b135a11c5d2044865f48753ffde18ae6e04c41c7afc73ccc file=neo/internal/server/engine.go range=577:596 lang=go exported=false byte_range=24816:25607
  sig=func (e *Engine) activeRunForConv(convID string) string
  doc=activeRunForConv reports the in-flight run id for one conversation, or "" if\nnothing is live. Unlike broker.has(id) (which stays true for 2 minutes after\nsettlement so late reconnects can replay), this consults the authoritative\nruns registry: a run is here iff registerRun has fired and unregisterRun has\nNOT — i.e. iff drive() is still executing. handleConversations uses it to\nstamp `live_run` on the GET /conversations/{id} response so a fresh tab /\npost-relogin client can subscribe(replay:true) without waiting for the poll.
EDGES
  ^contains=matrix/neo/internal/server.Engine
  ^defines=matrix/neo/internal/server/engine.go

NODE id=matrix/neo/internal/server.Engine.announceAutomatrixCompletion kind=method
  digest=b3:ddc520b6959c6386e60437e0f05f785d3d876dc609983e648c3631e4a41183ed file=neo/internal/server/automatrix_run.go range=150:187 lang=go exported=false byte_range=7225:9289
  sig=func (e *Engine) announceAutomatrixCompletion(convID, opportunitySummary, resultSummary string)
  doc=announceAutomatrixCompletion is the completion -> durable record + notify seam\n(task 5.3, req 6.1/6.4/6.5/8.3). It runs ONLY on a genuine, gate-passed\nautonomous completion. The durable in-app record is written FIRST so the\nresult is the canonical, replayable surface even if no client is connected and\nregardless of any external-send outcome (req 6.1); the out-of-app ntfy/Apprise\nping is then fired BEST-EFFORT + non-blocking via notify.Deliver (req 6.4), so\na failed external send neither blocks the run nor disturbs the durable record\n(honest failure — a ping we couldn't send is never reported as delivered). All\ncopy is RESULT-not-protocol — no Chronos/alarm/marker/cortex jargon (req 6.5,\nthe consumer rule): the title is the helpful thing Neo took on and the body is\nthe result it produced (both plain English, sourced from the opportunity\nsummary + the agent's own final answer). No secrets are recorded or sent — the\nrecord shape is whitelist-only and the body is the model's user-facing answer.
EDGES
  ^contains=matrix/neo/internal/server.Engine
  ^defines=matrix/neo/internal/server/automatrix_run.go

NODE id=matrix/neo/internal/server.Engine.approverFor kind=method
  digest=b3:d46915c0157d321098a63738689256177d7dc81c128e6a90e693b5b2eeebb6af file=neo/internal/server/engine.go range=480:508 lang=go exported=false byte_range=21627:22591
  sig=func (e *Engine) approverFor(r *run) delegate.Approver
  doc=approverFor surfaces a delegated MCL gate as a gate.invoked event on the\nconversation stream and blocks until the user answers via Neo's gate-answer\nendpoint (or the context is cancelled, which denies).
EDGES
  ^contains=matrix/neo/internal/server.Engine
  ^defines=matrix/neo/internal/server/engine.go

NODE id=matrix/neo/internal/server.Engine.automatrixBusy kind=method
  digest=b3:7058306371c5af783f1e6df872141b556754ccbe09083135ec0163f303c6e3fd file=neo/internal/server/automatrix_wake.go range=278:291 lang=go exported=false byte_range=13517:14102
  sig=func (e *Engine) automatrixBusy() bool
  doc=automatrixBusy reports whether any run is in flight for the user. Because the\ndaemon is per-user, any active run means the user (or a prior proactive task)\nis busy, so a new proactive wake must defer rather than compete (req 4.5). It\ncovers both live conversational runs (the runs registry) and an autonomous\nAutomatrix run already executing (the in-flight guard, task 4.1) so two\nproactive tasks never overlap.
EDGES
  ^contains=matrix/neo/internal/server.Engine
  ^defines=matrix/neo/internal/server/automatrix_wake.go

NODE id=matrix/neo/internal/server.Engine.claimGate kind=method
  digest=b3:2ffdc2c6eb4bf06d11b4c6cca051bf179d775dcc33d45f75702ddd9bb571c5ae file=neo/internal/server/engine.go range=460:478 lang=go exported=false byte_range=20914:21625
  sig=func (e *Engine) claimGate(intentID, nodeID string) bool
  doc=claimGate is the shared cross-attach gate guard handed to every per-call\ndelegate client. The FIRST caller to claim (intentID, nodeID) wins and may\nanswer the gate; later callers (a concurrent attach to the same in-flight\nintent) lose the claim and skip answering, so a single approval gate is\nserviced exactly once even when two core_execute delegations join the same\nrun. Safe for concurrent use.
EDGES
  ^contains=matrix/neo/internal/server.Engine
  ^defines=matrix/neo/internal/server/engine.go

NODE id=matrix/neo/internal/server.Engine.coreExecute kind=method
  digest=b3:dd427fd2723e3b47d30a8da166a8561672622e2e57421e14b43d213daced7fcc file=neo/internal/server/engine.go range=443:458 lang=go exported=false byte_range=20245:20912
  sig=func (e *Engine) coreExecute(ctx context.Context, intent string) (string, error)
  doc=coreExecute is the in-conversation bridge to the MCL pipeline. It reads the\nactive run from ctx so it can surface the delegated run's approval gates and\nstatus onto that conversation's event stream, then delegates over HTTP to\nthe daemon (the only thing that can move funds), servicing gates inline.
EDGES
  ^contains=matrix/neo/internal/server.Engine
  ^defines=matrix/neo/internal/server/engine.go

NODE id=matrix/neo/internal/server.Engine.decideAutomatrixWakeLocked kind=method
  digest=b3:d7a78ea9cdc86daec7cdc128298ea0141accbeb6d7d84231ac27a7dd7e6613dc file=neo/internal/server/automatrix_wake.go range=270:276 lang=go exported=false byte_range=13144:13515
  sig=func (e *Engine) decideAutomatrixWakeLocked(in automatrixWakeInput) automatrixDecision
  doc=decideAutomatrixWakeLocked runs the pure decider under the RNG mutex (rand.Rand\nis not safe for concurrent use; wakes are infrequent so the lock is uncontended).
EDGES
  ^contains=matrix/neo/internal/server.Engine
  ^defines=matrix/neo/internal/server/automatrix_wake.go

NODE id=matrix/neo/internal/server.Engine.dispatchAutomatrixRun kind=method
  digest=b3:78af1fa00251b507a2af8cff74214876dd662e105aa2e4f355266888fd8d8ef3 file=neo/internal/server/automatrix_run.go range=85:120 lang=go exported=false byte_range=4033:5695
  sig=func (e *Engine) dispatchAutomatrixRun(opp memory.OpportunitySpec)
  doc=dispatchAutomatrixRun drives the supervised restricted-surface run for an\nalready-in_progress opportunity on a background goroutine, decoupled from any\nrequest context, and settles the opportunity on the terminal. Shared by the\nlive runner path and the restart-resume sweep.
EDGES
  ^contains=matrix/neo/internal/server.Engine
  ^defines=matrix/neo/internal/server/automatrix_run.go

NODE id=matrix/neo/internal/server.Engine.emitAutomatrixComplete kind=method
  digest=b3:fa2f760cc1e97be4739307ac72bec4d013ee8ac25aeb2146c9838b3b5563dd45 file=neo/internal/server/engine.go range=694:720 lang=go exported=false byte_range=29464:30800
  sig=func (e *Engine) emitAutomatrixComplete(convID, opportunitySummary, resultSummary string) automatrixlog.Record
  doc=emitAutomatrixComplete writes the durable in-app completion record and\npublishes the automatrix.complete broker event so a live client surfaces the\nsurprise result immediately. The durable record is the canonical, replayable\nsurface: it is written FIRST so the result is never lost even if no client is\nconnected (and regardless of any out-of-app ntfy/Apprise ping). This is the\nclean writer seam the completion path (5.3) calls on a genuinely-gated pass;\nit never signs, writes cortex, or touches the plan/walk. No secrets are\nrecorded — only the result-not-protocol fields.
EDGES
  ^contains=matrix/neo/internal/server.Engine
  ^defines=matrix/neo/internal/server/engine.go

NODE id=matrix/neo/internal/server.Engine.emitConstructSurface kind=method
  digest=b3:11bc65f6e509d62400d4a6b9bc848b2403a722d2e0f05ca75e277d919f543864 file=neo/internal/server/engine.go range=342:353 lang=go exported=false byte_range=15854:16487
  sig=func (e *Engine) emitConstructSurface(ctx context.Context, s *schema.Surface) error
  doc=emitConstructSurface is the ACTIVE-tier Construct emitter wired into the tool\nmanager: it streams an agent-authored surface onto the active run's event\nstream as a construct.surface event. Pure side-channel — it only publishes a\ntranscript event, exactly like surfaceTool / notifyFor; it never signs,\nwrites cortex, or touches the plan/walk.
EDGES
  ^contains=matrix/neo/internal/server.Engine
  ^defines=matrix/neo/internal/server/engine.go

NODE id=matrix/neo/internal/server.Engine.emitTodo kind=method
  digest=b3:5711c38506fc1ec7e31ed4853bcabef70a9c79728a9202b386919618ec86926a file=neo/internal/server/engine.go range=355:376 lang=go exported=false byte_range=16489:17465
  sig=func (e *Engine) emitTodo(ctx context.Context, items []tools.TodoItem) error
  doc=emitTodo is the live task-list emitter wired into the tool manager\n(neo-smoothness req.3): it streams the agent's ordered checklist onto the\nactive run's event stream as a tool.todo event. Pure side-channel — it only\npublishes a transcript event (like emitConstructSurface / surfaceTool); it\nnever signs, writes cortex, or touches the plan/walk. The trace tap persists\ntool.todo (traceWorkspaceTypes) so the checklist survives reopen + respawn.
EDGES
  ^contains=matrix/neo/internal/server.Engine
  ^defines=matrix/neo/internal/server/engine.go

NODE id=matrix/neo/internal/server.Engine.fetchUserProfile kind=method
  digest=b3:437fae54aed34b466a64d0ed1695303d6cd4b045703e4f48d89d86f63c02d09e file=neo/internal/server/engine.go range=967:1015 lang=go exported=false byte_range=39484:41074
  sig=func (e *Engine) fetchUserProfile()
  doc=fetchUserProfile fetches the onboarding profile from the daemon's\n/profile endpoint and caches it on the engine for injection into every\nagent's stable system prompt prefix (req 2.4/2.5). Best-effort: a\nmissing daemon, absent profile, or any error falls back to the default\n"Neo" identity cleanly (empty preferredName + nil expertiseDomains).\nThread-safe: writes the cached fields under profileMu.
EDGES
  ^contains=matrix/neo/internal/server.Engine
  ^defines=matrix/neo/internal/server/engine.go

NODE id=matrix/neo/internal/server.Engine.haltAll kind=method
  digest=b3:0e6a773bc24686b8a732ebf5a7ecb7b75c362968f6cd191d07ac2427b6f2e95e file=neo/internal/server/engine.go range=609:631 lang=go exported=false byte_range=25843:26793
  sig=func (e *Engine) haltAll() int
  doc=haltAll interrupts EVERY live run this daemon is driving — the global kill\nswitch behind the client's "Stop all" control. Each daemon is single-tenant,\nso this halts exactly the calling user's own in-flight Neos (their runaway\nrespawns / parallel conversations) and nothing else. It mirrors the per-run\nPOST /intents/{id}/stop path: interrupt() marks each run stopped + cancels its\ncontext, so drive() closes it quietly as StatusInterrupted and the reaper\nnever resumes it. Returns the number of runs signalled. The run snapshot is\ntaken under e.mu and released BEFORE interrupt() (which takes the session's\nactMu) to avoid any lock-ordering coupling with the dispatch path.
EDGES
  ^contains=matrix/neo/internal/server.Engine
  ^defines=matrix/neo/internal/server/engine.go

NODE id=matrix/neo/internal/server.Engine.handleAutomatrixWake kind=method
  digest=b3:764fdae2a18b32410d9748a826cfbd23f884f72ca0cff059d70d4e5ceabff8b2 file=neo/internal/server/automatrix_wake.go range=203:268 lang=go exported=false byte_range=10224:13142
  sig=func (e *Engine) handleAutomatrixWake(ctx context.Context, convID string)
  doc=handleAutomatrixWake runs the wake decision and acts on it: cancel on opt-out,\nhand the pick to the runner (task 4.1) on a run outcome, and reschedule the\nnext jittered wake on every non-opt-out path. Best-effort throughout — a\ngovernor/runner/pager error is logged and never wedges the wake.
EDGES
  ^contains=matrix/neo/internal/server.Engine
  ^defines=matrix/neo/internal/server/automatrix_wake.go

NODE id=matrix/neo/internal/server.Engine.latestRunForConv kind=method
  digest=b3:7fd3cbacb7502ae126b509977516dfeeefbc5d2b10c99499ea584d13ffae8837 file=neo/internal/server/engine.go range=727:748 lang=go exported=false byte_range=31120:31763
  sig=func (e *Engine) latestRunForConv(convID string) string
  doc=latestRunForConv resolves the run id whose workspace trace a reopened thread\nshould rebuild: the in-flight run if one is live, else the most recent run on\nthe conversation (the last persisted turn carrying an intent_id). Returns ""\nwhen the conversation has no run-bearing turn.
EDGES
  ^contains=matrix/neo/internal/server.Engine
  ^defines=matrix/neo/internal/server/engine.go

