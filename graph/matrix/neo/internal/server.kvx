NODE id=matrix/neo/internal/server.Engine.maybeRefreshProfile kind=method
  digest=b3:38f827ad315d025ba4a1529761f306103fcba73641072dc9c96ed0e0e3fc51cf file=neo/internal/server/engine.go range=1017:1028 lang=go exported=false byte_range=41076:41551
  sig=func (e *Engine) maybeRefreshProfile()
  doc=maybeRefreshProfile re-fetches the onboarding profile if the cached copy\nis older than profileRefreshTTL. Called at session rebuild so a profile\nedited in Settings (req 8.2) takes effect on subsequent conversations/\nturns without a process restart.
EDGES
  ^contains=matrix/neo/internal/server.Engine
  ^defines=matrix/neo/internal/server/engine.go

NODE id=matrix/neo/internal/server.Engine.newAutomatrixSession kind=method
  digest=b3:61d196d1a8bf0f043838fe9bba2fcb3b325f7b49f5fb5a19e7316f35d64a2bf1 file=neo/internal/server/automatrix_run.go range=210:225 lang=go exported=false byte_range=9996:10575
  sig=func (e *Engine) newAutomatrixSession(convID string) *session
  doc=newAutomatrixSession mints an ephemeral session for an autonomous run on the\nRESTRICTED (no-money) tool surface, bound to convID so it resumes that\nthread's durable history (req 5.2). It is intentionally NOT registered in the\nsession registry: a proactive run is a side task, not the conversation's live\nturn.
EDGES
  ^contains=matrix/neo/internal/server.Engine
  ^defines=matrix/neo/internal/server/automatrix_run.go

NODE id=matrix/neo/internal/server.Engine.newSession kind=method
  digest=b3:d77bf983112f1f8dec766768b7e47c6b5b723284a72a982f6c4de16b295714d9 file=neo/internal/server/session.go range=138:149 lang=go exported=false byte_range=4507:4870
  sig=func (e *Engine) newSession(convID string) *session
  doc=newSession builds a fresh agent bound to this conversation, with a reporter\nand tool-observer that stream onto whichever run is currently in flight.
EDGES
  ^contains=matrix/neo/internal/server.Engine
  ^defines=matrix/neo/internal/server/session.go

