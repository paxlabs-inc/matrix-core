  ^contains=matrix/neo/internal/server.session
  ^defines=matrix/neo/internal/server/session.go

NODE id=matrix/neo/internal/server.session.registerGate kind=method
  digest=b3:c2cc783ec40aac13f0e237714e7557e2598986d366d08f35514696ba4517e265 file=neo/internal/server/session.go range=740:746 lang=go exported=false byte_range=30249:30417
  sig=func (s *session) registerGate(nodeID string) chan gateAnswer
