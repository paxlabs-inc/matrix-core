NODE id=matrix/neo/internal/server.shouldRetrySubagent kind=func
  digest=b3:b4973643d5afdea103fc92690b9a5d190bd29a3aa876d3c1294bfba9a91410a1 file=neo/internal/server/swarm.go range=226:234 lang=go exported=false byte_range=7585:8208
  sig=func shouldRetrySubagent(attempt, maxAttempts int, err error, haveText bool, ctxErr error) bool
  doc=shouldRetrySubagent decides whether a failed sub-agent attempt warrants a\nfresh retry. Retry ONLY when the agent hard-failed (err != nil) and produced\nNO usable output, the parent context is still alive (ctxErr == nil), and\nattempts remain. A clean finish or any partial findings are accepted as-is —\nwe never burn a retry on a sub-agent that already returned something useful,\nand a cancelled/timed-out parent stops immediately.
EDGES
  ^defines=matrix/neo/internal/server/swarm.go

