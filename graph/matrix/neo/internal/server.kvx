NODE id=matrix/neo/internal/server.Engine.respondAsk kind=method
  digest=b3:3d90d0b051dad3ce726f868ef6e62730377ebcfa62fb20fae10d8e6ed462f15c file=neo/internal/server/engine.go range=693:750 lang=go exported=false byte_range=32061:34494
  sig=func (e *Engine) respondAsk(ctx context.Context, s *schema.Surface) (*primitives.AskResponse, error)
  doc=respondAsk is the ACTIVE-tier Construct back-channel (invariant i5): it shows\nan Ask surface, PARKS the agent's construct_render tool call on a per-ask\nwaiter keyed by the surface id, and returns the human's typed response once\nit is posted to /intents/{id}/asks/{ask_id}/answer. It mirrors approverFor\n(the in-walk gate) exactly — register the waiter FIRST so a fast answer can't\nrace the park, then emit; on answer, patch the Ask surface to its settled\nstate so the rendered control resolves. Pure side-channel: it publishes\ntranscript events and returns the answer as a tool result (an agent INPUT);\nit never signs, writes Neocortex, or touches the plan/walk.
EDGES
  calls=matrix/construct/backchannel.Answered,matrix/construct/transport.EmitSurface,matrix/construct/transport.PatchSurface,matrix/neo/internal/server.broker.publish,matrix/neo/internal/server.runFromContext,matrix/neo/internal/server.session.clearAsk,matrix/neo/internal/server.session.registerAsk
