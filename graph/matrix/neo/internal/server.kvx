NODE id=matrix/neo/internal/server.subagentMaxAttempts kind=const
  digest=b3:a5f9f07680eeba944009c909ae97c242a7293cd5a218c6e2bf852963e7f8445a file=neo/internal/server/swarm.go range=23:29 lang=go exported=false byte_range=536:985
  sig=untyped int
  doc=subagentMaxAttempts is how many times a sub-agent's whole task is attempted\nbefore giving up: one initial run plus bounded recovery retries. A sub-agent\nwhose loop hard-fails (a model/transport error that survives the in-loop\nretry ladder) used to die on the spot with an empty report; instead it gets a\nfresh window and another go, so a transient provider hiccup no longer wastes\nthe whole sub-agent.
EDGES
  ^defines=matrix/neo/internal/server/swarm.go

NODE id=matrix/neo/internal/server.subagentTurnTimeout kind=const
  digest=b3:e22991142254e3a3434841028871e2eb5d652b94ff20e87ba40e318231275ada file=neo/internal/server/swarm.go range=19:21 lang=go exported=false byte_range=334:534
  sig=time.Duration
  doc=subagentTurnTimeout bounds a single sub-agent's whole run, independent of the\nparent turn's budget, so one stuck sub-agent can't hold the swarm open.
EDGES
  ^defines=matrix/neo/internal/server/swarm.go

NODE id=matrix/neo/internal/server.superviseAction kind=type
  digest=b3:a09075ab7f7434cafa9da46634be64167f3b452476d2a3a74538a5306e6dc2b5 file=neo/internal/server/session.go range=481:482 lang=go exported=false byte_range=18997:19099
  sig=type superviseAction int
  doc=superviseAction is the policy outcome for one finished supervised attempt.
EDGES
  ^defines=matrix/neo/internal/server/session.go

NODE id=matrix/neo/internal/server.superviseBackoff kind=func
  digest=b3:561076244aa811988ff1c9c378f9b24f33c498073b09b492c64d9bd70b0a2ecf file=neo/internal/server/session.go range=600:628 lang=go exported=false byte_range=25299:26459
  sig=func superviseBackoff(ctx context.Context, attempt int, rateLimited bool) bool
  doc=superviseBackoff sleeps an attempt-scaled, jittered interval before a\nrespawn, honoring task cancellation. Jitter avoids a synchronized retry\nstampede when many users' daemons hit the same upstream hiccup at once.\n\nrateLimited stretches the interval hard: an upstream 429 means the provider\nis overloaded, so respawning quickly across many daemons is a self-amplifying\nrequest storm. On a 429 the base grows to ~15s/attempt (cap 90s) with a full\n15s of jitter, draining pressure off the upstream instead of adding to it,\nwhile still eventually retrying (the Task Durability Rule is preserved — we\nkeep going, just far more slowly).
EDGES
  ^defines=matrix/neo/internal/server/session.go

NODE id=matrix/neo/internal/server.superviseDecision kind=func
  digest=b3:0db12d4d37aa4e196c9939d90039fcd98e02ac20330ffcd46afc61540d8178d5 file=neo/internal/server/session.go range=492:518 lang=go exported=false byte_range=19549:20804
  sig=func superviseDecision(stopped bool, attemptErr error, failClass delegate.FailureClass, taskCtxErr error, attempt, maxRespawns int) superviseAction
  doc=superviseDecision is the PURE policy for one finished attempt, given whether\nthe run was stopped, the attempt's error (nil = genuine completion), the\nshared failure class of the attempt's most recent classified tool failure,\nthe task context's error (non-nil = wall-clock blown), the attempt number,\nand the respawn budget. Order matters: a user stop wins over everything; a\nclean finish is done; a DETERMINISTIC blocker stops-and-asks (a fresh agent\nwould hit the same wall, so don't respawn or consume the budget); a blown\nwall-clock or an exhausted respawn budget hits the ceiling; otherwise\nrespawn. Every other non-clean exit (model/transport error, a stall, an\nexhausted step budget, a timed-out attempt, or a transient/conflict/pending\nfailure) flows to respawn until the ceiling.
EDGES
  ^defines=matrix/neo/internal/server/session.go

NODE id=matrix/neo/internal/server.swarmActive kind=func
  digest=b3:10f45fb9142110e696534b48d8568f5dfec62ca58b269f5597ec4010ebe5f8f2 file=neo/internal/server/swarm.go range=40:43 lang=go exported=false byte_range=1367:1467
