NODE id=matrix/neo/internal/server.briefSettingsRequest kind=type
  digest=b3:70705472a7b7e73145fb0bba4fd24acda805ccecebb54e51313035cc47509efd file=neo/internal/server/brief_routes.go range=131:143 lang=go exported=false byte_range=5184:5861
  sig=type briefSettingsRequest struct {\n	Enabled		*bool		`json:"enabled,omitempty"`\n	Paused		*bool		`json:"paused,omitempty"`\n	Timezone	*string		`json:"timezone,omitempty"`\n	DeliveryTime	*string		`json:"delivery_time,omitempty"`\n	Days		*[]int		`json:"days,omitempty"`\n	Length		*string		`json:"length,omitempty"`\n	Sections	*[]string	`json:"sections,omitempty"`\n	ConversationID	*string		`json:"conversation_id,omitempty"`\n}
