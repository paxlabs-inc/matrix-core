  digest=b3:e19cee83cf65df3bab843a12956a1404fcaf3517c3c461d21f0da87e5cf754db file=neo/internal/server/engine.go range=378:382 lang=go exported=false byte_range=17467:17811
  sig=time.Duration
  doc=askWaitTimeout bounds how long a parked Ask waits for a human answer before\nit expires and the agent is told to proceed without it (still inside the\nrun's own 20-minute ceiling). Long enough for a deliberate human decision\n(read a tx, pick an option), short enough not to wedge a run forever.
