  ^contains=matrix/neo/internal/server.Engine
  ^defines=matrix/neo/internal/server/engine.go

NODE id=matrix/neo/internal/server.Engine.publishAudit kind=method
  digest=b3:c02d10c13c8da2f51ad44bdac2a1888c533335ea88a3433618c6e4096d9cec08 file=neo/internal/server/engine.go range=510:524 lang=go exported=false byte_range=22593:23188
  sig=func (e *Engine) publishAudit(r *run, ev agent.AuditEvent)
  doc=publishAudit streams a Cassandra audit event onto the run's event stream as\na cassandra.* event (cassandra.frozen.kvx [audit].events). Pure observability\nside-channel — it only publishes a transcript event, exactly like surfaceTool\n/ notifyFor; the adjudicator signs nothing and writes no cortex (i_cass_4,\ni_cass_6).
EDGES
  ^contains=matrix/neo/internal/server.Engine
  ^defines=matrix/neo/internal/server/engine.go

NODE id=matrix/neo/internal/server.Engine.publishMemory kind=method
  digest=b3:9e9d5d09223bc1ccbb908643671ab300ed88b785513bbe0a85ddd30be9f90190 file=neo/internal/server/engine.go range=526:547 lang=go exported=false byte_range=23190:24181
  sig=func (e *Engine) publishMemory(r *run, ev agent.MemoryEvent)
  doc=publishMemory streams the turn's continuous-memory activation summary onto\nthe run's event stream as a memory.activation event (continuous-memory task\n7.1). Pure observability side-channel — like publishAudit / surfaceTool it\nonly publishes a transcript event; cortex composed the bundle read-only and\nnothing here signs, writes cortex, or touches the plan/walk. It surfaces the\nRESULT (the durable story-so-far + a coarse memory timeline), never the\nprotocol (no journal / MMR / rollup / snapshot jargon). Empty payloads are\ndropped so a turn with nothing to remember emits nothing.
EDGES
  ^contains=matrix/neo/internal/server.Engine
  ^defines=matrix/neo/internal/server/engine.go

NODE id=matrix/neo/internal/server.Engine.publishSubagent kind=method
  digest=b3:d0aecc53bb19deccaffdf7e2bcf1433ba2db5f5748449b375bb40d69eabf173f file=neo/internal/server/swarm.go range=269:282 lang=go exported=false byte_range=9237:9700
  sig=func (e *Engine) publishSubagent(r *run, swarmID string, index int, typ string, fields map[string]interface{})
  doc=publishSubagent emits a swarm lifecycle event tagged with the swarm + agent\nindex, carrying the supplied fields.
EDGES
  ^contains=matrix/neo/internal/server.Engine
  ^defines=matrix/neo/internal/server/swarm.go

NODE id=matrix/neo/internal/server.Engine.recordTrace kind=method
  digest=b3:ae8ce90b4b0e8532cfab4bcaac59319be255a4dc99004fe2909ab4f0a9860cef file=neo/internal/server/engine.go range=657:684 lang=go exported=false byte_range=27865:28961
  sig=func (e *Engine) recordTrace(id string, ev Event)
  doc=recordTrace is the broker tap (F3): it persists the workspace-relevant slice\nof the live event stream to the durable sidecar trace store so "Neo's\nComputer" can be rebuilt when a thread is reopened — after the run settles,\nscrolls past the 512-event broker buffer, or the topic is reclaimed. It runs\non every publish, so it stays cheap: a map lookup, then a NON-BLOCKING\nenqueue (trace.Record drops rather than blocks). It never signs, never writes\ncortex, never touches plan/walk (pure sidecar — m9/i_trace).
EDGES
  ^contains=matrix/neo/internal/server.Engine
  ^defines=matrix/neo/internal/server/engine.go

NODE id=matrix/neo/internal/server.Engine.registerRun kind=method
  digest=b3:8a16e463dda22f89af3e75dfd633e8a3f8333be274a04c5da9eddb535c70fdb4 file=neo/internal/server/engine.go range=563:569 lang=go exported=false byte_range=24497:24713
  sig=func (e *Engine) registerRun(r *run)
  doc=registerRun / lookupRun / unregisterRun index active runs so the gate-answer\nroute can find the waiting approver by run id.
EDGES
  ^contains=matrix/neo/internal/server.Engine
  ^defines=matrix/neo/internal/server/engine.go

NODE id=matrix/neo/internal/server.Engine.respondAsk kind=method
  digest=b3:6c2188394c60a10d47534faaa544abcebfb806c8ba0e92e0003e4f9a63a89ac3 file=neo/internal/server/engine.go range=384:441 lang=go exported=false byte_range=17813:20243
  sig=func (e *Engine) respondAsk(ctx context.Context, s *schema.Surface) (*primitives.AskResponse, error)
  doc=respondAsk is the ACTIVE-tier Construct back-channel (invariant i5): it shows\nan Ask surface, PARKS the agent's construct_render tool call on a per-ask\nwaiter keyed by the surface id, and returns the human's typed response once\nit is posted to /intents/{id}/asks/{ask_id}/answer. It mirrors approverFor\n(the in-walk gate) exactly — register the waiter FIRST so a fast answer can't\nrace the park, then emit; on answer, patch the Ask surface to its settled\nstate so the rendered control resolves. Pure side-channel: it publishes\ntranscript events and returns the answer as a tool result (an agent INPUT);\nit never signs, writes cortex, or touches the plan/walk.
EDGES
  ^contains=matrix/neo/internal/server.Engine
  ^defines=matrix/neo/internal/server/engine.go

NODE id=matrix/neo/internal/server.Engine.runOneSubagent kind=method
  digest=b3:588d9384bdc0fdba43894b7c457ff063a5bd6aaa4400d781d898b9238cfe9f71 file=neo/internal/server/swarm.go range=139:224 lang=go exported=false byte_range=4624:7583
  sig=func (e *Engine) runOneSubagent(ctx context.Context, r *run, swarmID string, index int, spec tools.SubagentSpec) subResult
  doc=runOneSubagent builds and runs a single headless sub-agent to completion,\nstreaming its workspace activity onto the parent stream tagged with its\nindex, and returns its distilled report. A hard failure with no usable output\nis retried with a fresh window (bounded by subagentMaxAttempts) so a\ntransient provider error doesn't kill the sub-agent outright.
EDGES
  ^contains=matrix/neo/internal/server.Engine
  ^defines=matrix/neo/internal/server/swarm.go

NODE id=matrix/neo/internal/server.Engine.runSwarm kind=method
  digest=b3:7130118b9fcf7e6bf959d829a4e349ad12b475f75a7b1c3f1a883f22f7d91882 file=neo/internal/server/swarm.go range=55:137 lang=go exported=false byte_range=1709:4622
  sig=func (e *Engine) runSwarm(ctx context.Context, specs []tools.SubagentSpec) (string, error)
  doc=runSwarm is the SwarmFunc wired into the tool manager. It fans a set of\ntask-scoped sub-agents out to run CONCURRENTLY — each its own headless agent\nloop over a fresh, isolated context window with the restricted (full Natural,\nno money, no recursion) tool surface — streams their progress onto the parent\nconversation's event stream as a live Agent Swarm, and returns an aggregated,\nmodel-readable digest of their findings. Heavy tool work stays in the\nsub-agents' windows; only the distilled results return to the parent's.
EDGES
  ^contains=matrix/neo/internal/server.Engine
  ^defines=matrix/neo/internal/server/swarm.go

NODE id=matrix/neo/internal/server.Engine.settleAutomatrixOpportunity kind=method
  digest=b3:18195563ffa8e9344ce38888e07a48f610f3fee73b92aaa4d93dd73388b2347f file=neo/internal/server/automatrix_run.go range=122:148 lang=go exported=false byte_range=5697:7223
  sig=func (e *Engine) settleAutomatrixOpportunity(ctx context.Context, opp memory.OpportunitySpec, convID string, status task.Status, resultSummary string)
  doc=settleAutomatrixOpportunity records the run's terminal outcome on the\nopportunity (req 5.5). A genuine completion-gate pass marks it done AND\nannounces the result out of band (task 5.3); any other terminal (an honest\npartial at the ceiling, a deterministic blocker) leaves it re-pended with\nattempts++ (bounded; dismissed at the ceiling) for a later wake to retry —\nand surfaces NOTHING to the user (req 5.5/8.3: a non-completed task is never\nannounced). convID is the conversation the run executed in (origin thread, or\na synthetic one); resultSummary is the agent's captured final answer.
EDGES
  ^contains=matrix/neo/internal/server.Engine
  ^defines=matrix/neo/internal/server/automatrix_run.go

NODE id=matrix/neo/internal/server.Engine.surfaceSubagentStep kind=method
  digest=b3:693908ae6fafeb2f7623e7fc7d1bd3b1dfe72a2b09488c1271cf95b9a97e84d3 file=neo/internal/server/swarm.go range=253:267 lang=go exported=false byte_range=8644:9235
  sig=func (e *Engine) surfaceSubagentStep(r *run, swarmID string, index int, name string, ev agent.ToolEvent)
  doc=surfaceSubagentStep mirrors surfaceTool for a sub-agent: the same animated\nworkspace step (terminal / browser / editor / …), tagged with the swarm +\nagent index so the client routes it into that sub-agent's own window.
EDGES
  ^contains=matrix/neo/internal/server.Engine
  ^defines=matrix/neo/internal/server/swarm.go

NODE id=matrix/neo/internal/server.Engine.surfaceTool kind=method
  digest=b3:1021044f023ca545bc07608b7c213c0a65162d76d619144621a12459acf25766 file=neo/internal/server/engine.go range=750:819 lang=go exported=false byte_range=31765:34660
  sig=func (e *Engine) surfaceTool(r *run, ev agent.ToolEvent)
  doc=surfaceTool turns a tool call into the live "Neo Workspace" — a single\n`tool.step` event the client renders as an ANIMATED VIEWPORT of the action\nitself: a terminal when Neo runs a command, a browser window when it\nbrowses, an editor when it reads/writes files. The same step id is updated\nfrom running→done across the start/end pair, so the viewport fills in place\nrather than appending a new card. Web-search results and generated media ALSO\nkeep their dedicated rich events (cards / media grid) on completion.
EDGES
  ^contains=matrix/neo/internal/server.Engine
  ^defines=matrix/neo/internal/server/engine.go

NODE id=matrix/neo/internal/server.Engine.unregisterRun kind=method
  digest=b3:79f462312d69958673343433dc8d6212c4ad193de83f455dd6de3b64139d3a89 file=neo/internal/server/engine.go range=598:607 lang=go exported=false byte_range=25609:25841
  sig=func (e *Engine) unregisterRun(id string)
EDGES
  ^contains=matrix/neo/internal/server.Engine
  ^defines=matrix/neo/internal/server/engine.go

NODE id=matrix/neo/internal/server.Engine.warmBody kind=method
  digest=b3:7659f1c76c9e889af5c0f0d2d13c33e46d890ad957f3f59d2e01a766c6df6215 file=neo/internal/server/engine.go range=308:320 lang=go exported=false byte_range=14539:15144
  sig=func (e *Engine) warmBody(ctx context.Context)
  doc=warmBody performs the actual substrate warm synchronously: one relevance\nretrieval that loads the embedding model + opens the HNSW index. The result\nis discarded — the point is the side effect of spinning up the cold path.\nSplit out from Warm so tests can exercise it deterministically without the\nonce/goroutine wrapper. Best-effort: any error is swallowed (a failed warm\njust means the first real recall pays what it would have anyway).
EDGES
  ^contains=matrix/neo/internal/server.Engine
  ^defines=matrix/neo/internal/server/engine.go

NODE id=matrix/neo/internal/server.EngineOptions kind=type
  digest=b3:90231307b0e498a797201f016e1663749d4c0201ceb6328339450cb3d20dea3d file=neo/internal/server/engine.go range=143:162 lang=go exported=true byte_range=6728:8156
  sig=type EngineOptions struct {\n	Config			config.Config\n	Main			*llm.Client\n	Cheap			*llm.Client\n	SubMain			*llm.Client	// main-capability model, thinking OFF, for background sub-agents (nil falls back to Main)\n	Tools			*tools.Manager\n	Pager			*memory.Pager\n	Consolidator		agent.Consolidator\n	Adjudicator		*cassandra.Adjudicator	// shared Cassandra completeness faculty (Phase 3)\n	ConversationDir		string			// durable conversation store dir ("" disables persistence)\n	TaskDir			string			// durable task-ledger dir ("" disables; reaper needs it to resume after restart)\n	TraceDir		string			// durable workspace-trace dir ("" disables; the reopen-survives-reload store, F3)\n	AutomatrixDir		string			// durable Automatrix completion-inbox dir ("" disables; the in-app surprise-results store)\n	AutomatrixSettingsDir	string			// durable Automatrix opt-in settings dir ("" = in-memory only; wiring the production governor)\n	MediaDir		string			// machine-volume media dir ("" disables image/video/audio I/O)\n	BackendURL		string\n	BackendToken		string\n}
  doc=EngineOptions configures NewEngine. Main + Tools are required; the rest are\noptional (a nil pager/consolidator degrades gracefully).
