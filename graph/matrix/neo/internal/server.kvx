NODE id=matrix/neo/internal/server.session.deliverCeiling kind=method
  digest=b3:93f7da4e2c8617e73667ca596fe58daabcfdd5023d7ea779ebb7c3577648d8ee file=neo/internal/server/session.go range=554:573 lang=go exported=false byte_range=22916:23906
  sig=func (s *session) deliverCeiling(r *run, reason string) task.Status
  doc=deliverCeiling emits the ONE allowed terminal-without-completion: an honest\npartial at the hard ceiling. It hands the user the best real work so far\n(never fabricated) and invites them to continue. Idempotent if already closed.
EDGES
  ^contains=matrix/neo/internal/server.session
  ^defines=matrix/neo/internal/server/session.go

NODE id=matrix/neo/internal/server.session.deliverDeterministicStop kind=method
  digest=b3:c12176beb84ed6bbf63f3c25d7262bf144628da1f2319fb21978401ef9ff807a file=neo/internal/server/session.go range=575:598 lang=go exported=false byte_range=23908:25297
  sig=func (s *session) deliverDeterministicStop(r *run) task.Status
  doc=deliverDeterministicStop emits the terminal for a task blocked by a\nDETERMINISTIC failure — one that recurs identically (a denied permission, a\nlimit, an invalid request, a detail only the user can change). A fresh agent\nwould hit the same wall, so the supervisor does NOT respawn and does NOT\nconsume the respawn budget. Unlike the generic "still on it, taking another\nrun at it" progress copy, this states plainly that the task is blocked and\nhands the user the next step, with the best real work so far. Idempotent if\nalready closed.
EDGES
  ^contains=matrix/neo/internal/server.session
  ^defines=matrix/neo/internal/server/session.go

NODE id=matrix/neo/internal/server.session.dispatch kind=method
  digest=b3:4eb7e77d7775f35e042fb3e511d879f50c374af19dfbd76c77c51e88e75991a1 file=neo/internal/server/session.go range=284:292 lang=go exported=false byte_range=10669:11132
  sig=func (s *session) dispatch(message string, resume bool) *run
  doc=dispatch mints a run and drives it on a background goroutine. It does NOT\ninterrupt any in-flight turn (F5 removed barge-in from the message path —\nmid-task messages queue via submit instead; the only deliberate interrupt is\nPOST /intents/{id}/stop). Locks actMu so `active` is published synchronously.
EDGES
  ^contains=matrix/neo/internal/server.session
  ^defines=matrix/neo/internal/server/session.go

NODE id=matrix/neo/internal/server.session.dispatchLocked kind=method
  digest=b3:fe8455e4b98fd9a2f6d696eed3865c9f2e8d3430476fd7b6603a253efc5a7073 file=neo/internal/server/session.go range=294:310 lang=go exported=false byte_range=11134:12052
  sig=func (s *session) dispatchLocked(message string, resume bool) *run
  doc=dispatchLocked is dispatch's body; the caller MUST hold actMu. It records the\nrun as the conversation's active run synchronously (so submit's active check\nis race-free), creates the SSE topic before returning, then drives the turn.
EDGES
  ^contains=matrix/neo/internal/server.session
  ^defines=matrix/neo/internal/server/session.go

NODE id=matrix/neo/internal/server.session.drainInput kind=method
  digest=b3:dc0ee3447b2a21d7f26706a5072ebb9399719fa1a8892ec9312106792358c096 file=neo/internal/server/session.go range=320:333 lang=go exported=false byte_range=12329:12770
  sig=func (s *session) drainInput() []string
  doc=drainInput returns and clears any queued mid-run messages (F5). It is the\nagent's Inbox hook (drained each tool-call boundary) and is also swept at the\nend of a turn to catch a message that landed in the finishing window. Returns\nnil when the inbox is empty.
EDGES
  ^contains=matrix/neo/internal/server.session
  ^defines=matrix/neo/internal/server/session.go

NODE id=matrix/neo/internal/server.session.drive kind=method
  digest=b3:c7293dd0fd34c83c06ff486ca1b2f8330c50731e9a796077c8ab18106e351bdc file=neo/internal/server/session.go range=335:411 lang=go exported=false byte_range=12772:16109
  sig=func (s *session) drive(r *run, message string, resume bool)
  doc=drive owns one task's whole lifecycle. The task is DECOUPLED from the HTTP\nrequest that dispatched it (it runs on context.Background, bounded only by a\ngenerous wall-clock) — closing the app or dropping the SSE stream never ends\nit. It is recorded in the durable task ledger so even a daemon restart / Fly\nsuspend can resume it. The supervisor inside keeps at least one agent on the\ntask, respawning across model errors / tool failures / stalls, until the\nobjective is met to standard or a hard ceiling is hit. (The Task Durability\nRule.)
EDGES
  ^contains=matrix/neo/internal/server.session
  ^defines=matrix/neo/internal/server/session.go

NODE id=matrix/neo/internal/server.session.emitProgress kind=method
  digest=b3:f9a4cd8b98e3eaae87e27584e183bc692236858b653b6811e2e1f136b53476a2 file=neo/internal/server/session.go range=545:552 lang=go exported=false byte_range=22348:22914
  sig=func (s *session) emitProgress(r *run, attempt int, err error)
  doc=emitProgress tells the user the task is STILL IN PROGRESS after a failed\nattempt — honest and non-terminal, never a fake completion. The machine\ndetail (the real neo/llm error) goes to the logs for diagnosis.
EDGES
  ^contains=matrix/neo/internal/server.session
  ^defines=matrix/neo/internal/server/session.go

NODE id=matrix/neo/internal/server.session.enqueueInput kind=method
  digest=b3:7091440535271cb94fbd6e35dc00dd56262634e7a72f364f14000ea0e8fb2015 file=neo/internal/server/session.go range=312:318 lang=go exported=false byte_range=12054:12327
  sig=func (s *session) enqueueInput(message string)
  doc=enqueueInput appends a mid-run user message to the session inbox (F5). The\nlive agent drains it at its next tool-call boundary via drainInput.
EDGES
  ^contains=matrix/neo/internal/server.session
  ^defines=matrix/neo/internal/server/session.go

NODE id=matrix/neo/internal/server.session.interrupt kind=method
  digest=b3:4bc3229bedbdc44afce9ab304bd7bfbc6786f2c018dd9ea046ac96b96174f7be file=neo/internal/server/session.go range=712:723 lang=go exported=false byte_range=29542:29889
  sig=func (s *session) interrupt(r *run)
  doc=interrupt marks a specific run stopped and cancels its context, so its agent\nloop unwinds at the next cancellation checkpoint and drive closes it quietly.\nSafe on a nil run or a run whose cancel is not yet set.
EDGES
  ^contains=matrix/neo/internal/server.session
  ^defines=matrix/neo/internal/server/session.go

NODE id=matrix/neo/internal/server.session.interruptActive kind=method
  digest=b3:b750f8a9e0076051dbd3b105d8931b2cfd7a06440f8af4e222411887301c7524 file=neo/internal/server/session.go range=699:710 lang=go exported=false byte_range=29271:29540
  sig=func (s *session) interruptActive() string
  doc=interruptActive stops the latest dispatched turn (if any). Returns its id, or\n"" when nothing was in flight.
