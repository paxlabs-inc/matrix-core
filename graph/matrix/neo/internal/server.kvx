NODE id=matrix/neo/internal/server.automatrixGovernor.CancelAlarm kind=method
  digest=b3:b852c71847dfb0d4621e0432d8937926b8756279374e6d755838524d3a49e212 file=neo/internal/server/automatrix_governor.go range=126:141 lang=go exported=true byte_range=5569:6301
  sig=func (g *automatrixGovernor) CancelAlarm(ctx context.Context) error
  doc=CancelAlarm is the wake-side opt-out path (req 4.4): cancel this agent's own\nAUTOMATRIX alarm and persist the opt-in as off. Best-effort on the external\ncancel — if Chronos rejects it the opt-in still goes off (so the engine runs\nno further work) and the alarm id is retained for a later retry.
EDGES
  ^contains=matrix/neo/internal/server.automatrixGovernor
  ^defines=matrix/neo/internal/server/automatrix_governor.go

