NODE id=matrix/neo/internal/server.Server.handleAskAnswer kind=method
  digest=b3:d333d29a765befbb645cb80fd3798c3c11123178effd769f91d9b182ba07c626 file=neo/internal/server/server.go range=370:401 lang=go exported=false byte_range=15890:17358
  sig=func (s *Server) handleAskAnswer(w http.ResponseWriter, r *http.Request, id, askID string)
  doc=handleAskAnswer delivers a typed human response to a parked Construct Ask\n(the back-channel of the construct_render(kind=ask) tool call). It validates\nthe posted AskResponse against the Ask it answers BEFORE delivering it, so a\nmalformed or off-contract answer is rejected (the run stays parked) rather\nthan resuming the agent with garbage. A stale/duplicate/unknown ask_id is a\n404. The caller has already confirmed the run is live.
EDGES
  ^contains=matrix/neo/internal/server.Server
  ^defines=matrix/neo/internal/server/server.go

NODE id=matrix/neo/internal/server.Server.handleAsyncPoll kind=method
  digest=b3:0334418456060bec7e931c24c89ae144f79ad18c8d66cee5c2e84e997507de89 file=neo/internal/server/server.go range=287:311 lang=go exported=false byte_range=12216:13326
  sig=func (s *Server) handleAsyncPoll(w http.ResponseWriter, r *http.Request)
  doc=handleAsyncPoll answers the poll_url that POST /chat advertises for a Neo run\n(GET /messages/async/<id>). The web client polls it on reload to decide\nwhether to reconnect a still-live run; without this it would be proxied to\nthe daemon, which has never heard of a neo_ intent and returns 404. Daemon\nasync jobs (non-Neo intents) fall through to the proxy unchanged.
EDGES
  ^contains=matrix/neo/internal/server.Server
  ^defines=matrix/neo/internal/server/server.go

NODE id=matrix/neo/internal/server.Server.handleAutomatrix kind=method
  digest=b3:9e3372a419843f2addcfc4eec34160683599e186d1c6014b9cff06c22490bee9 file=neo/internal/server/automatrix_routes.go range=52:71 lang=go exported=false byte_range=2535:3350
  sig=func (s *Server) handleAutomatrix(w http.ResponseWriter, r *http.Request)
  doc=handleAutomatrix is the prefix dispatcher for /automatrix/*. Registered ahead\nof the daemon proxy so these Neo-owned routes are served locally.
EDGES
  ^contains=matrix/neo/internal/server.Server
  ^defines=matrix/neo/internal/server/automatrix_routes.go

NODE id=matrix/neo/internal/server.Server.handleAutomatrixApprove kind=method
  digest=b3:2470e5c81b80b97e3d3fcac81f7770dd54cb2199902bd79968f972d2b951f6b4 file=neo/internal/server/automatrix_routes.go range=204:264 lang=go exported=false byte_range=7970:10752
  sig=func (s *Server) handleAutomatrixApprove(w http.ResponseWriter, r *http.Request)
  doc=handleAutomatrixApprove approves a (typically financial) opportunity for a\nNORMAL, gated, user-initiated run. It dispatches the item exactly like a user\nmessage through the standard session path — so a financial item runs as an\nordinary core_execute-gated task (the user approves any value-moving step\ninline), NEVER on the restricted autonomous surface and NEVER auto-run. The\nopportunity is then marked scheduled so it leaves the pending management queue.
EDGES
  ^contains=matrix/neo/internal/server.Server
  ^defines=matrix/neo/internal/server/automatrix_routes.go

NODE id=matrix/neo/internal/server.Server.handleAutomatrixDismiss kind=method
  digest=b3:cecace2a204021f80bbce080419b1abab0c133195dd333f608b7c00657df9489 file=neo/internal/server/automatrix_routes.go range=177:202 lang=go exported=false byte_range=6865:7968
