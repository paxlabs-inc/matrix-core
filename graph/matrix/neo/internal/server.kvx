  digest=b3:e03cc96a2a1a1b821c8cea83273438fdb50b26dec06c19a4654bb90ce6551144 file=neo/internal/server/session.go range=530:543 lang=go exported=false byte_range=21244:22346
  sig=func resumePrime(objective string, attempt int) string
  doc=resumePrime is the catch-up instruction for a respawned / resumed agent: the\nobjective is unchanged, prior work may already be on the volume, build on it,\nand keep going until it is genuinely done. After a few stuck attempts it also\nnudges decomposition / delegation.
