NODE id=matrix/neo/internal/server.swarmStagger kind=func
  digest=b3:a7367142ff8e07fdd2b15e26ebfff67245011e0a1e3f9a2c06cfe5efc8d85c99 file=neo/internal/server/swarm.go range=295:315 lang=go exported=false byte_range=10844:11406
  sig=func swarmStagger(ctx context.Context, index int) bool
  doc=swarmStagger delays leg `index` by (index-1)*staggerStep before its first\nattempt so concurrent legs don't start in lockstep, capped so a high index\ncan't over-delay. Returns false if the parent context is cancelled during the\nwait. Leg 1 never waits.
EDGES
  references=matrix/neo/internal/server.ctx,matrix/neo/internal/server.d,matrix/neo/internal/server.index,matrix/neo/internal/server.staggerStep,matrix/neo/internal/server.t
  ^calls=matrix/neo/internal/server.Engine.runOneSubagent
  ^references=matrix/neo/internal/server.Engine.runOneSubagent
  ^defines=matrix/neo/internal/server/swarm.go

