  sig=func (p *Pager) Activate(conv, query string, budget cortex.Budget) (*cortex.ActivationBundle, error)
  doc=Activate composes the whole per-turn working set for a conversation via\ncortex.Activate (continuous-memory task 6.2): {Pinned, Timeline(T0),\nRecent(T1), Transcript(T2 slice), StorySoFar, ReachableURIs(T3 handles)},\nbudget-trimmed. Pinned is computed once per turn by cortex's per-turn cache\n(fixes NE-7). A thin delegate — no agent-side selection/ranking remains.
EDGES
  ^contains=matrix/neo/internal/memory.Pager
  ^defines=matrix/neo/internal/memory/pager.go

NODE id=matrix/neo/internal/memory.Pager.ActiveGoal kind=method
  digest=b3:8bd50f9dd031afe0310362e94f5d40de1c73fc1fe56133f01e873b4a717c9a9c file=neo/internal/memory/pager.go range=107:112 lang=go exported=true byte_range=3171:3314
  sig=func (p *Pager) ActiveGoal() string
  doc=ActiveGoal returns the current active goal.
EDGES
  ^contains=matrix/neo/internal/memory.Pager
  ^defines=matrix/neo/internal/memory/pager.go

NODE id=matrix/neo/internal/memory.Pager.AppendMessage kind=method
  digest=b3:c6612f2d34f5a83dc262b26bdf928452329364e4d650e514a8f6ddab1a8b01aa file=neo/internal/memory/pager.go range=128:136 lang=go exported=true byte_range=3849:4372
  sig=func (p *Pager) AppendMessage(m cortex.Message) (memory.URI, error)
  doc=AppendMessage records one conversation message durably in the cortex\nsession/transcript store (continuous-memory task 6.1). It is a thin delegate\nto cortex.AppendMessage — under the continuous-memory collapse the pager is\nthe agent-side shim over the cortex brain, holding no independent state. The\nderived-lane discipline (journal entry + sess/ record, NO SMT write) lives\nentirely inside cortex.
EDGES
  ^contains=matrix/neo/internal/memory.Pager
  ^defines=matrix/neo/internal/memory/pager.go

NODE id=matrix/neo/internal/memory.Pager.AttestRejected kind=method
  digest=b3:49dd37068ad6e5b0b2033f15ee1a8e955fa9f9a3236dde7a7d3a016303f65470 file=neo/internal/memory/salience_realism.go range=178:221 lang=go exported=true byte_range=6605:8159
  sig=func (p *Pager) AttestRejected(ctx context.Context, intentID string, ignoredURIs []string)
  doc=AttestRejected records that the given memories were surfaced into a turn but\ndemonstrably ignored, sending the negative salience signal (DecrementCitation\n+ EMA-away via cortex's decrementOnFailure path) so memories that crowd the\nbudget without being used decay out of the working set over time.\n\nThe attest is Outcome=Failure, Reason=wrong_assumption: surfacing the memory\nassumed a relevance the produced turn did not bear out, and wrong_assumption\nis one of the two §8.3 reasons that trigger the citation decrement. The\ncaller is responsible for passing only memories that cleared the\nRejectionCandidates guardrails (off-topic, non-pinned, capped). Best-effort\nand never blocks the turn — a failed attest just skips the signal.
EDGES
  ^contains=matrix/neo/internal/memory.Pager
  ^defines=matrix/neo/internal/memory/salience_realism.go

NODE id=matrix/neo/internal/memory.Pager.AttestUsed kind=method
  digest=b3:67888039ae30c566baa109bda4016cf50fb7550529fa9b98c3710eba242512f5 file=neo/internal/memory/writeback.go range=707:754 lang=go exported=true byte_range=25747:27411
  sig=func (p *Pager) AttestUsed(ctx context.Context, intentID string, citedURIs []string, success bool)
  doc=AttestUsed records that the given cortex memories were surfaced into a\ncompleted turn, feeding the usage-based salience signals (access +\ncitation) and the per-actor EMA weight learner via cortex.Attest. This is\nwhat turns the cortex LEARNING LOOP ON for Neo: Neo's page-fault Find calls\nare compile-time (no journal, no access bump), so without this the actor's\nsalience would stay frozen at the cold recency×importance formula and the\nstore could never learn what is actually useful. Best-effort and never\nblocks the turn — a failed attest just skips the signal for that turn.\n\nsuccess=false attests a failed turn for audit only; per cortex §8.3 a\ngeneric failure (no factual-error/wrong-assumption reason) leaves citations\nuntouched, so we do not punish surfaced memories for an unrelated stall.
EDGES
  ^contains=matrix/neo/internal/memory.Pager
  ^defines=matrix/neo/internal/memory/writeback.go

NODE id=matrix/neo/internal/memory.Pager.Close kind=method
  digest=b3:53dfe97037b16935df752db970b097c2225a0f07613a45b241520e16e0ff4f06 file=neo/internal/memory/pager.go range=86:98 lang=go exported=true byte_range=2725:2972
  sig=func (p *Pager) Close() error
  doc=Close stops the embedder and closes the store.
EDGES
  ^contains=matrix/neo/internal/memory.Pager
  ^defines=matrix/neo/internal/memory/pager.go

NODE id=matrix/neo/internal/memory.Pager.Embedder kind=method
  digest=b3:3b5aef6b10dc564a51ab6ec7abd9fb448fafbd0c06db31be2324a247dda84456 file=neo/internal/memory/pager.go range=117:126 lang=go exported=true byte_range=3448:3847
  sig=func (p *Pager) Embedder() embed.Embedder
  doc=Embedder returns the embedding backend Neo selected at open time (gateway,\ndirect provider, or the deterministic hash fallback — never nil in practice).\nSibling read-lanes (e.g. conversational recall) reuse it so the whole agent\nshares one embedding model. Returns nil only on a nil pager.
EDGES
  ^contains=matrix/neo/internal/memory.Pager
  ^defines=matrix/neo/internal/memory/pager.go

NODE id=matrix/neo/internal/memory.Pager.FailOpportunityAttempt kind=method
  digest=b3:34398d52f36e7f917f939f0b877b021300bf19909608a0412a4bf70f8394ae1a file=neo/internal/memory/writeback.go range=467:516 lang=go exported=true byte_range=17751:19973
  sig=func (p *Pager) FailOpportunityAttempt(ctx context.Context, uri string, maxAttempts int) (OpportunityStatus, error)
  doc=FailOpportunityAttempt records a failed/partial autonomous run attempt on an\nopportunity: it increments the bounded attempts counter and re-sets the\nlifecycle status, persisted atomically as a single cortex Update (one Pebble\nbatch commit). While attempts remain under maxAttempts the opportunity is\nreturned to PENDING so a later wake can retry it; once the attempts reach the\nceiling it is DISMISSED (eventually give up rather than retry forever, req\n5.5). maxAttempts <= 0 disables the ceiling (always re-pend). Returns the new\nstatus. No user-facing surface is touched — a failed proactive attempt is\nsilent (req 5.5: no failed-surprise spam).
EDGES
  ^contains=matrix/neo/internal/memory.Pager
  ^defines=matrix/neo/internal/memory/writeback.go

NODE id=matrix/neo/internal/memory.Pager.HasEmbedder kind=method
  digest=b3:848aabf691ea8ef73429916cac247cbf9cef0067722f29e4ec7c65bed441a3a7 file=neo/internal/memory/pager.go range=114:115 lang=go exported=true byte_range=3316:3446
  sig=func (p *Pager) HasEmbedder() bool
  doc=HasEmbedder reports whether semantic (HNSW) retrieval is available.
EDGES
  ^contains=matrix/neo/internal/memory.Pager
  ^defines=matrix/neo/internal/memory/pager.go

NODE id=matrix/neo/internal/memory.Pager.InProgressOpportunities kind=method
  digest=b3:ae992e464d58f38c41f1c8fbfb47099471fddf636c06841ef8f8015e91007568 file=neo/internal/memory/writeback.go range=518:562 lang=go exported=true byte_range=19975:21424
  sig=func (p *Pager) InProgressOpportunities(ctx context.Context, limit int) ([]OpportunitySpec, error)
  doc=InProgressOpportunities returns the eligible-autonomous opportunities left in\nthe IN_PROGRESS state — the set a process restart must pick back up so a\nproactive task in flight when the daemon died is driven to completion (the\nTask Durability Rule, req 5.1). Only eligible_autonomous items are returned,\nso a restart can never resume work on anything but the restricted (non-\nfinancial) surface. Unranked (order is irrelevant for resume); capped at\nlimit (<=0 = all).
EDGES
  ^contains=matrix/neo/internal/memory.Pager
  ^defines=matrix/neo/internal/memory/writeback.go

NODE id=matrix/neo/internal/memory.Pager.LearnedGuidance kind=method
  digest=b3:1463b6a938f21bc31b46fc3a327f4e4bae3d38223f147cd1740e0111c1adbe1e file=neo/internal/memory/pager.go range=310:372 lang=go exported=true byte_range=10596:12670
  sig=func (p *Pager) LearnedGuidance(ctx context.Context) []string
  doc=LearnedGuidance returns short behavioral guidance lines Neo has LEARNED:\nnon-hard learned/declared Constraints (hard ones are pinned verbatim by\nhardConstraints) followed by strong durable Preferences. This is the\nstructural fix for "Neo keeps forgetting a learned behavior" — a correction\nor working preference (e.g. "render a Construct surface while working")\nbecomes a line pinned to EVERY turn, changing behavior reliably instead of\ndepending on salience-ranked retrieval luck. Ranked by the Find planner's\nsalience-desc default and bounded by learnedGuidanceMax.
EDGES
  ^contains=matrix/neo/internal/memory.Pager
  ^defines=matrix/neo/internal/memory/pager.go

NODE id=matrix/neo/internal/memory.Pager.OpportunityByURI kind=method
  digest=b3:915e7ef603210208585bb01c718ac37d02e281d1ebd3eb4e616321d4f295d079 file=neo/internal/memory/writeback.go range=564:594 lang=go exported=true byte_range=21426:22536
  sig=func (p *Pager) OpportunityByURI(ctx context.Context, uri string) (OpportunitySpec, bool, error)
  doc=OpportunityByURI resolves a single opportunity record by its cortex URI. ok\nis false (with a nil error) when the URI does not resolve to an opportunity\nrecord. It is the point lookup the management/queue surfaces and the\nautonomous run's lifecycle bookkeeping read through.
EDGES
  ^contains=matrix/neo/internal/memory.Pager
  ^defines=matrix/neo/internal/memory/writeback.go

NODE id=matrix/neo/internal/memory.Pager.PendingOpportunities kind=method
  digest=b3:b6cdfb32b61a815c3e5e84c6449afe05e8306a99e8d7d429b4651c60182f3d8a file=neo/internal/memory/writeback.go range=292:353 lang=go exported=true byte_range=11620:13608
  sig=func (p *Pager) PendingOpportunities(ctx context.Context, limit int) ([]OpportunitySpec, error)
  doc=PendingOpportunities returns ONLY eligible-autonomous, pending opportunities\n— the set the autonomous picker may act on — ranked by confidence x salience\nx recency (highest first) and capped at limit (<=0 = all). Financial\nopportunities (eligible_autonomous=false) and any non-pending item are never\nreturned, so the picker structurally cannot select work that must not run\nunprompted.
EDGES
  ^contains=matrix/neo/internal/memory.Pager
  ^defines=matrix/neo/internal/memory/writeback.go

NODE id=matrix/neo/internal/memory.Pager.Pinned kind=method
  digest=b3:9379a0627157ffdd469e290da7f9d0b02e02e3538ebe877041c4a3b520af4fb8 file=neo/internal/memory/pager.go range=155:217 lang=go exported=true byte_range=5351:7203
  sig=func (p *Pager) Pinned(ctx context.Context, goal string) string
  doc=Pinned composes the always-injected pinned block: identity, the inviolable\noperating rules (Neo's invariants + any hard constraints in cortex), and\nthe active goal. Bounded by cfg.PinnedBudgetTokens.\n\ngoal is the caller's (per-conversation) active goal — passed in rather than\nread from shared pager state so that many conversations can share one cortex\nstore without clobbering each other's goal. Empty falls back to any\nprocess-level ActiveGoal (CLI path) then to a neutral placeholder.
EDGES
  ^contains=matrix/neo/internal/memory.Pager
  ^defines=matrix/neo/internal/memory/pager.go

NODE id=matrix/neo/internal/memory.Pager.Procedural kind=method
  digest=b3:335ca8e768bacc067fa17bb038cb91c12ebf8bba58f6ddae7858f9c3e43edd37 file=neo/internal/memory/pager.go range=940:982 lang=go exported=true byte_range=32556:33807
  sig=func (p *Pager) Procedural(ctx context.Context, goal string) ([]Pattern, error)
  doc=Procedural returns proven how-to patterns whose trigger matches the goal,\ngated by the anti-overfit guard (coverage >= cfg.MinPatternSuccesses).
EDGES
  ^contains=matrix/neo/internal/memory.Pager
  ^defines=matrix/neo/internal/memory/pager.go

NODE id=matrix/neo/internal/memory.Pager.QueuedOpportunities kind=method
  digest=b3:5dc6ce24c4ef53f80991bd339b1cdc4d84bba0bdf53f5d4673a6297d5db12bad file=neo/internal/memory/writeback.go range=355:421 lang=go exported=true byte_range=13610:16013
  sig=func (p *Pager) QueuedOpportunities(ctx context.Context, limit int) ([]OpportunitySpec, error)
  doc=QueuedOpportunities returns ALL pending opportunities — eligible-autonomous\nAND financial alike — ranked by confidence x salience x recency (highest\nfirst) and capped at limit (<=0 = all). It is the management-UI reader (req\n7.3): unlike PendingOpportunities (the autonomous picker's set, which filters\nto eligible_autonomous only and must stay that way so a financial item can\nnever be auto-run), this surfaces the financial items too so the user can\ndismiss them or approve one for a normal, gated, user-initiated run. Each\nreturned spec carries its EligibleAutonomous flag, so the caller knows which\nitems are financial (eligible_autonomous=false). Done/dismissed/in-flight\nitems are excluded — only the actionable pending queue is shown.
EDGES
  ^contains=matrix/neo/internal/memory.Pager
  ^defines=matrix/neo/internal/memory/writeback.go

NODE id=matrix/neo/internal/memory.Pager.Recall kind=method
  digest=b3:5d8900b6abcd5adc7faccf571bd5db707d84828031ef0890c0d3ac379aa9f771 file=neo/internal/memory/pager.go range=800:822 lang=go exported=true byte_range=27166:28619
  sig=func (p *Pager) Recall(ctx context.Context, queryText string, types []string, k int, asOf *time.Time) (string, error)
  doc=Recall renders an explicit, user-visible memory lookup: the pinned user\nprofile plus the structured retrieval for the query. This backs Neo's\nmemory_recall tool so "check your memory" is an action, not an apology, and\nis now the PRIMARY reasoning-time retrieval verb (v3 #1) — the model calls\nit iteratively with narrowing queries/type filters instead of being\nforce-fed an ambient blob. Each rendered line carries the memory's type, a\ncontradiction advisory when present, its valid-until when closed (the as-of\ntime-travel signal), and its cortex URI for citation/provenance.\n\nUnder the continuous-memory collapse (cfg.ContinuousMemory, task 6.3) the\ntool is pointed at the cortex RECURSIVE-RECALL surface (RecallDescend, req.8)\n— the model descends the temporal ladder to page in exact specifics — while\npreserving the AmbientRetrievalTopK pull-over-push philosophy (this is the\npull verb) and the as_of parameter. It falls back to the flat lookup when the\ntimeline yields nothing (pre-cascade / a memory not yet rolled up), so the\ntool never regresses. With the flag off the flat lookup is byte-identical to\nthe legacy behavior.
EDGES
  ^contains=matrix/neo/internal/memory.Pager
  ^defines=matrix/neo/internal/memory/pager.go

NODE id=matrix/neo/internal/memory.Pager.RecallDescend kind=method
  digest=b3:aec193408c62c98ecd86745e958d2975af442d900c5acc0c2dea77471edee0c8 file=neo/internal/memory/pager.go range=147:153 lang=go exported=true byte_range=4908:5349
  sig=func (p *Pager) RecallDescend(query string, opts cortex.RecallOpts) (*cortex.RecallResult, error)
  doc=RecallDescend runs the cortex recursive-recall descent (RLM applied to time)\nbehind the memory_recall tool's recursive path (continuous-memory task 6.3).\nA thin delegate to cortex.RecallDescend; it is a pure read (no journal\nappend, no SMT write) and stays off the per-turn hot path.
EDGES
  ^contains=matrix/neo/internal/memory.Pager
  ^defines=matrix/neo/internal/memory/pager.go

NODE id=matrix/neo/internal/memory.Pager.RecallHits kind=method
  digest=b3:8ef5644727a24df6990241eb739608717c25493fea80262724472a5ba5c12d53 file=neo/internal/memory/pager.go range=734:798 lang=go exported=true byte_range=25110:27164
  sig=func (p *Pager) RecallHits(_ context.Context, queryText string, types []string, k int, asOf *time.Time) ([]RecallHit, error)
  doc=RecallHits runs the structured, parameterized memory lookup behind the\nmemory_recall tool (v3 #1: reasoning-time retrieval). It honours an optional\ntype filter, a result cap k (<=0 = RetrievalTopK), and a bi-temporal as-of\ninstant (nil = now; v3 #2). Results are ranked by utility-keyed salience\n(v3 #4 default) and each hit carries its URI, type, score, closed valid-time,\nand a contradiction advisory when two surfaced hits disagree — the structure\nthe model iterates over and the verification layer surfaces.
EDGES
  ^contains=matrix/neo/internal/memory.Pager
  ^defines=matrix/neo/internal/memory/pager.go

NODE id=matrix/neo/internal/memory.Pager.RecordOutcome kind=method
  digest=b3:8ebe11b44754b57a74fd1c44aad4f0be7cb7aa59abccbd21ee4a6844f5ce9787 file=neo/internal/memory/writeback.go range=159:174 lang=go exported=true byte_range=6322:6857
  sig=func (p *Pager) RecordOutcome(ctx context.Context, summary string, outcome memory.Outcome, intentRef string) (string, error)
  doc=RecordOutcome stores an episodic outcome (success/failure/partial). The\nbackground write-back pass and the loop's termination both call this.
EDGES
  ^contains=matrix/neo/internal/memory.Pager
  ^defines=matrix/neo/internal/memory/writeback.go

NODE id=matrix/neo/internal/memory.Pager.ReinforcePattern kind=method
  digest=b3:eec91d4d897c98ad59f8c8e45aa5b2086e9f0207594595b7fb9c52ad5fe82420 file=neo/internal/memory/writeback.go range=195:234 lang=go exported=true byte_range=7548:8977
  sig=func (p *Pager) ReinforcePattern(ctx context.Context, spec PatternSpec, derivedFrom []string) (string, error)
  doc=ReinforcePattern implements the procedural lifecycle's distill+reinforce\nstages: if a pattern with the same dedup identity (name → trigger → steps)\nalready exists it is reinforced (coverage++ and strength nudged up) so it can\ngraduate past the anti-overfit gate; otherwise a fresh low-confidence\ncandidate is written. Dedup is deliberately simple for v1 (semantic dedup is\na follow-up).
EDGES
  ^contains=matrix/neo/internal/memory.Pager
  ^defines=matrix/neo/internal/memory/writeback.go

NODE id=matrix/neo/internal/memory.Pager.RejectionCandidates kind=method
  digest=b3:41164f52a560fc7db7109bdc464fec671ace8e0fb308e3bff62bc4317090805b file=neo/internal/memory/salience_realism.go range=121:176 lang=go exported=true byte_range=4905:6603
  sig=func (p *Pager) RejectionCandidates(turnText string, surfaced []Snippet) []string
  doc=RejectionCandidates returns the URIs of memories that were SURFACED into a\nturn but were demonstrably ignored. A surfaced memory is a candidate when\nALL guardrails hold:\n\n	(a) the turn produced concrete output  — turnText is non-empty;\n	(b) the memory is clearly off-topic    — cosine(turn, memory) < offTopicCosine;\n	(c) the memory is not pinned/protected — rejectableType(type) is true.\n\nThe result is ordered farthest-first (lowest cosine) and capped at\nmaxRejectionsPerTurn. It requires an embedder for the cosine gate; without\none it returns nil so the rejection path stays conservative.
EDGES
  ^contains=matrix/neo/internal/memory.Pager
  ^defines=matrix/neo/internal/memory/salience_realism.go

NODE id=matrix/neo/internal/memory.Pager.RememberConstraint kind=method
  digest=b3:ecb8fdaf3aa7f8713a30ceaa53904fbf5f8d63a2c72364af93753c6abe398ced file=neo/internal/memory/writeback.go range=131:138 lang=go exported=true byte_range=4934:5505
  sig=func (p *Pager) RememberConstraint(ctx context.Context, statement, polarity, strength string) (string, error)
  doc=RememberConstraint stores a durable behavioral rule Neo learned — typically\nfrom a USER CORRECTION ("you did X, do Y instead"). Source=learned. It is\npinned every turn (hard-strength rules verbatim via hardConstraints, softer\nones via the learned-guidance block) so the correction sticks structurally\nrather than depending on retrieval luck. Deduped semantically.
EDGES
  ^contains=matrix/neo/internal/memory.Pager
  ^defines=matrix/neo/internal/memory/writeback.go

NODE id=matrix/neo/internal/memory.Pager.RememberConstraintRelated kind=method
  digest=b3:2c5ade7aedf4849ff5dcfbca8d0332524b92acdc960a3b79f5e9264da3735b5d file=neo/internal/memory/writeback.go range=140:157 lang=go exported=true byte_range=5507:6320
  sig=func (p *Pager) RememberConstraintRelated(ctx context.Context, statement, polarity, strength string, classify RelationClassifier) (string, error)
  doc=RememberConstraintRelated is RememberConstraint with conflict-aware linking:\na refined behavioral rule supersedes the stale one it corrects; an opposite\nrule contradicts it. A nil classifier is exactly RememberConstraint\n(dedup-or-write, no edges).
EDGES
  ^contains=matrix/neo/internal/memory.Pager
  ^defines=matrix/neo/internal/memory/writeback.go

NODE id=matrix/neo/internal/memory.Pager.RememberFact kind=method
  digest=b3:41ae0c4f37de9bff85fa88943767bd94e439f358f3660fbd15b00b826ee626bf file=neo/internal/memory/writeback.go range=47:54 lang=go exported=true byte_range=1395:1883
  sig=func (p *Pager) RememberFact(ctx context.Context, statement string) (string, error)
  doc=RememberFact stores a durable objective fact (semantic memory). Skips a\nwrite whose statement is near-identical to an existing fact (semantic\ndedup) so a repeatedly-relevant truth doesn't accumulate duplicates that\ndilute retrieval — its recency/salience is refreshed instead via the\nAttest usage loop when it is surfaced and cited.
EDGES
  ^contains=matrix/neo/internal/memory.Pager
  ^defines=matrix/neo/internal/memory/writeback.go

NODE id=matrix/neo/internal/memory.Pager.RememberFactRelated kind=method
  digest=b3:5b28ad1b920f35620a5da02ab8181b6de97099b04064b69121d6c8480b3c4ce6 file=neo/internal/memory/writeback.go range=56:73 lang=go exported=true byte_range=1885:2662
  sig=func (p *Pager) RememberFactRelated(ctx context.Context, statement string, classify RelationClassifier) (string, error)
  doc=RememberFactRelated is RememberFact with conflict-aware linking: when a\ntopically-similar (but not duplicate) fact already exists, classify decides\nwhether the new fact supersedes / contradicts / merely relates to it, and\nthe appropriate cortex edge is linked after the write. A nil classifier is\nexactly RememberFact (dedup-or-write, no edges).
EDGES
  ^contains=matrix/neo/internal/memory.Pager
  ^defines=matrix/neo/internal/memory/writeback.go

NODE id=matrix/neo/internal/memory.Pager.RememberOpportunity kind=method
  digest=b3:92f877dda150e24f96014e71c612da89b0d0ff2c6aadcaff7da61deee5b3b2f9 file=neo/internal/memory/writeback.go range=252:290 lang=go exported=true byte_range=9804:11618
  sig=func (p *Pager) RememberOpportunity(ctx context.Context, spec OpportunitySpec) (string, error)
  doc=RememberOpportunity stores a durable Automatrix opportunity (the proactive\nwork queue), deduplicated against existing PENDING opportunities with the\nsame discipline as RememberFact: a normalized-statement match (also catches\ncase/spacing drift, embedder-independent) OR a semantic-similarity match\nwithin the duplicate threshold short-circuits the write so a repeatedly\nmentioned need does not accumulate duplicates. Status defaults to pending\nand timestamps are stamped here. Returns the (possibly pre-existing,\ndeduped) record URI; an empty summary is a no-op.
EDGES
  ^contains=matrix/neo/internal/memory.Pager
  ^defines=matrix/neo/internal/memory/writeback.go

NODE id=matrix/neo/internal/memory.Pager.RememberPreference kind=method
  digest=b3:48e640e6d510615d3f032e6757b70ce2b2274408224c4eb5a3d1d4878cbb89e1 file=neo/internal/memory/writeback.go range=102:110 lang=go exported=true byte_range=3454:4097
  sig=func (p *Pager) RememberPreference(ctx context.Context, topic, polarity string, strength float32, rationale string) (string, error)
  doc=RememberPreference stores a durable WORKING preference Neo learned about\nhow the user wants it to behave (tone, format, which surfaces/tools to use,\netc.). Preferences are surfaced every turn via the pager's pinned\nlearned-guidance block, so a learned working style actually changes\nbehavior instead of being lost in salience-ranked retrieval. Deduped\nsemantically so repeats don't bloat the pinned block.
EDGES
  ^contains=matrix/neo/internal/memory.Pager
  ^defines=matrix/neo/internal/memory/writeback.go

NODE id=matrix/neo/internal/memory.Pager.RememberPreferenceRelated kind=method
  digest=b3:3d19fdde7de24f5883c3bba00a1aa4fd9206141fd88c7050d8143b501f983423 file=neo/internal/memory/writeback.go range=112:129 lang=go exported=true byte_range=4099:4932
  sig=func (p *Pager) RememberPreferenceRelated(ctx context.Context, topic, polarity string, strength float32, rationale string, classify RelationClassifier) (string, error)
  doc=RememberPreferenceRelated is RememberPreference with conflict-aware linking:\nan updated preference about the same topic supersedes the stale one, an\nopposite-polarity preference contradicts it. A nil classifier is exactly\nRememberPreference (dedup-or-write, no edges).
EDGES
  ^contains=matrix/neo/internal/memory.Pager
  ^defines=matrix/neo/internal/memory/writeback.go

NODE id=matrix/neo/internal/memory.Pager.RememberUserFact kind=method
  digest=b3:fcd18017e5ea8f8c5f08ce39a07111e1205ec2825aadd55d549595ebc5b4d807 file=neo/internal/memory/writeback.go range=75:100 lang=go exported=true byte_range=2664:3452
  sig=func (p *Pager) RememberUserFact(ctx context.Context, statement string) (string, error)
  doc=RememberUserFact stores a durable fact about the user themselves (their\nname, role, stable preferences). Pinned every turn via UserProfile, and\ndeduped on the normalized statement so repeats don't bloat the profile.
