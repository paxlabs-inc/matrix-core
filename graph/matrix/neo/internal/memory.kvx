  digest=b3:421d3373b8ee5e8fc27fda5ba9ddc3ac507ef5b07536b8756de1a97e0ff71604 file=neo/internal/memory/pager.go range=1023:1032 lang=go exported=false byte_range=34991:35223
  sig=func truncateTokens(s string, maxTokens int) string
