NODE id=matrix/neo/internal/memory.dupDistanceThreshold kind=const
  digest=b3:0363293b1c58ca7371f09ecfb94c23eb926b5095a24fb18930866e67f661aab0 file=neo/internal/memory/writeback.go range=699:705 lang=go exported=false byte_range=25252:25745
  sig=float32
  doc=dupDistanceThreshold is the HNSW distance below which a candidate write is\ntreated as a semantic duplicate of an existing same-type memory. Distance\nis 1-cosine under unit norm (0=identical, 2=opposite); 0.08 ≈ cosine ~0.92,\ndeliberately tight so genuinely distinct statements are never merged. The\nconflict-aware write core (writeWithRelations, relation.go) reads it to\nshort-circuit a duplicate before spending a classifier call.
EDGES
  ^defines=matrix/neo/internal/memory/writeback.go

NODE id=matrix/neo/internal/memory.encodeOpportunityGoal kind=func
  digest=b3:f2aec4ed37894084d6fa539c0d7e600bdb16dd1e5de3656f1a70dbff0ea2b5ec file=neo/internal/memory/opportunity.go range=114:139 lang=go exported=false byte_range=4958:6090
  sig=func encodeOpportunityGoal(spec OpportunitySpec) memory.GoalData
  doc=encodeOpportunityGoal maps an OpportunitySpec onto a cortex GoalData. The\nsummary drives the embedded form (semantic dedup), the status is the\nauthoritative queryable field, and the bookkeeping rides a canonical-JSON\nsidecar in SuccessCriteria (rendered only as a count, so it never pollutes\nthe summary's embedding).
EDGES
  ^defines=matrix/neo/internal/memory/opportunity.go

