NODE id=matrix/neo/internal/memory.Pager.Retrieve kind=method
  digest=b3:3a89d7aac1ccb0158611084233d17735c417b4d3be0324855af3cba42a834e6b file=neo/internal/memory/pager.go range=413:571 lang=go exported=true byte_range=13572:19502
  sig=func (p *Pager) Retrieve(ctx context.Context, queryText string) ([]Snippet, error)
  doc=Retrieve page-faults the top-K records relevant to queryText. Seeds come\nfrom two lanes scored 1.0: semantic (HNSW) results when an embedder is\nrunning, ALWAYS merged with a salience-ranked lane over the durable types\n(the embedding worker is async, so a memory written seconds ago is invisible\nto the vector index — without the salience lane a "remember this" → "what do\nyou know?" round trip inside one session comes back empty).\n\nThe seeds then cascade over the relationship graph (cortex edges, depth 2,\nboth directions) so connected memories surface with a hop-decayed score\n(0.7^hop). A bi-temporal validity filter (v3 #2) drops any candidate whose\nvalid-time has been closed (ValidUntil <= now, stamped on supersession) so\nNeo sees the current version; contradiction edges annotate the conflicting\npair so Neo reconciles before trusting. Sorted by score desc (stable on\nfirst-seen order) and bounded by RetrievalTopK.
EDGES
  ^contains=matrix/neo/internal/memory.Pager
  ^defines=matrix/neo/internal/memory/pager.go

NODE id=matrix/neo/internal/memory.Pager.SetActiveGoal kind=method
  digest=b3:f8da28f4c250eb208049f54dab4d97c78ae1f0b2b4f86f22d33cac890e44e453 file=neo/internal/memory/pager.go range=100:105 lang=go exported=true byte_range=2974:3169
  sig=func (p *Pager) SetActiveGoal(goal string)
  doc=SetActiveGoal records the task Neo is currently pursuing (pinned every turn).
EDGES
  ^contains=matrix/neo/internal/memory.Pager
  ^defines=matrix/neo/internal/memory/pager.go

NODE id=matrix/neo/internal/memory.Pager.SetOpportunityStatus kind=method
  digest=b3:09bd07d2bc3ab5f557d22b581b7878155e391e120e131b028e9bddee4d79dfe6 file=neo/internal/memory/writeback.go range=423:465 lang=go exported=true byte_range=16015:17749
  sig=func (p *Pager) SetOpportunityStatus(ctx context.Context, uri string, status OpportunityStatus) error
  doc=SetOpportunityStatus transitions an opportunity to a new lifecycle status,\npersisted atomically as a single cortex Update (one Pebble batch commit) so\na restart never loses or double-runs an item. The opportunity tag and all\nother fields are preserved; updated_at is refreshed.
EDGES
  ^contains=matrix/neo/internal/memory.Pager
  ^defines=matrix/neo/internal/memory/writeback.go

NODE id=matrix/neo/internal/memory.Pager.TriggeredGuidance kind=method
  digest=b3:85917f217a17811543bb1ff438453a57292b5d492c453045dcd5c4a4d1c566da file=neo/internal/memory/trigger.go range=53:130 lang=go exported=true byte_range=2521:4939
  sig=func (p *Pager) TriggeredGuidance(ctx context.Context, turnText string) []Snippet
  doc=TriggeredGuidance returns behavioral guidance whose trigger matches the live\nturn by embedding similarity, independent of global salience. Sources:\n\n  - non-hard Constraints (hard ones are already pinned verbatim by\n    hardConstraints; surfacing them here would duplicate them);\n  - Patterns that carry a Trigger (an explicit "when to apply" behavior),\n    surfaced WITHOUT the procedural coverage gate because a trigger memory\n    encodes a behavior to apply now, not a proven recipe to reuse.\n\nEach result keeps its URI so the loop can attest it as USED like any other\nsurfaced memory. Requires an embedder (trigger matching is inherently\nsemantic); without one it returns nil so behavior stays salience-ranked.\nBest-effort: any error yields no trigger guidance (never load-bearing alone).
EDGES
  ^contains=matrix/neo/internal/memory.Pager
  ^defines=matrix/neo/internal/memory/trigger.go

NODE id=matrix/neo/internal/memory.Pager.UserProfile kind=method
  digest=b3:a07a43c61f38c9e47ea48c303868fb3168a1e4fd8e65fb6806578c32425b5358 file=neo/internal/memory/pager.go range=223:257 lang=go exported=true byte_range=7352:8214
  sig=func (p *Pager) UserProfile(ctx context.Context) []string
  doc=UserProfile returns the durable facts stored about the user themselves\n(subject matrix://knowledge/user), newest-versions-first, bounded.
EDGES
  ^contains=matrix/neo/internal/memory.Pager
  ^defines=matrix/neo/internal/memory/pager.go

