NODE id=matrix/neo/internal/memory.userFactPredicate kind=const
  digest=b3:6b14aa24762cbf611f692e84b08e8a39eae150fe42ca401df206cd2ea736afe8 file=neo/internal/memory/writeback.go range=31:44 lang=go exported=false byte_range=721:1391
  sig=untyped string
  doc=factSubject / factPredicate are the default provenance for Neo's\nauto-consolidated facts. cortex requires both a subject and a predicate on a\nFact (memory.ValidateMemory), so a fact written without them is rejected —\nthey are NOT optional. Mirrors the cortex-mem.sh convention.
EDGES
  ^defines=matrix/neo/internal/memory/writeback.go

NODE id=matrix/neo/internal/memory.userFactSubject kind=const
  digest=b3:8dd2637856804b996840d4354b59e7c6a8e9de95443feba2eabac587f9d36c4a file=neo/internal/memory/writeback.go range=39:43 lang=go exported=false byte_range=1089:1360
  sig=untyped string
  doc=userFactSubject scopes facts that describe THE USER (name, role,\nstable preferences). They get their own subject so the pager can pin\nthem every turn — identity questions must never depend on retrieval\nluck.
EDGES
  ^defines=matrix/neo/internal/memory/writeback.go

NODE id=matrix/neo/internal/memory.userProfileMax kind=const
  digest=b3:2b1101f106619871dc45dbb7c3121466eb7b0aa3224f968f60a105a9f02c9514 file=neo/internal/memory/pager.go range=219:221 lang=go exported=false byte_range=7205:7350
  sig=untyped int
  doc=userProfileMax bounds the pinned profile so it can never crowd out the\nrules/goal inside the pinned token budget.
