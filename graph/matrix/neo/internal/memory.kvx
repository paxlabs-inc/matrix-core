NODE id=matrix/neo/internal/memory.ClassifyFinancial kind=func
  digest=b3:899f18337570338a570bc6fd7685d3c98666dd1b5f84a4d03a8a12f83481aab6 file=neo/internal/memory/classifier.go range=75:97 lang=go exported=true byte_range=4208:4966
  sig=func ClassifyFinancial(summary string) bool
  doc=ClassifyFinancial reports whether the opportunity summary contains a\ndeterministic financial / on-chain signal. It is the reusable keyword + symbol\nre-check that backs EligibleForAutonomy; it never consults the extraction\nmodel's flag, so it is a pure, side-effect-free function of the summary text.
EDGES
  ^defines=matrix/neo/internal/memory/classifier.go

NODE id=matrix/neo/internal/memory.DecodePatternSpec kind=func
  digest=b3:f2368f2282b47cc784b6ad82403f81534c5b2ceadeb5f9c22480e15c6bca98d8 file=neo/internal/memory/pattern.go range=43:58 lang=go exported=true byte_range=1729:2259
  sig=func DecodePatternSpec(statement string) PatternSpec
  doc=DecodePatternSpec parses a stored Statement back into a PatternSpec. A plain\n(non-encoded) statement is treated as a single freeform step so legacy flat\npatterns continue to render.
EDGES
  ^defines=matrix/neo/internal/memory/pattern.go

NODE id=matrix/neo/internal/memory.EligibleForAutonomy kind=func
  digest=b3:4300eff23e10b784faff9fe9ed24e526d986955b70b17494ef59d5a6e3462f78 file=neo/internal/memory/classifier.go range=108:122 lang=go exported=true byte_range=5324:6132
  sig=func EligibleForAutonomy(summary string, modelFinancial bool) bool
  doc=EligibleForAutonomy is the authoritative, fail-closed verdict on whether an\nopportunity may be run UNPROMPTED by an autonomous Automatrix wake. It is\nnon-financial work only: it returns true ONLY when the extraction model did\nNOT flag the item financial AND the deterministic ClassifyFinancial re-check\nfinds no financial signal in the summary. Any doubt from either source —\nmodel flag set, a financial keyword, a phrase, or a currency symbol — yields\nfalse (not eligible), so the system fails closed. A false result does not\ndrop the opportunity: it is still captured and surfaced for explicit user\napproval, just never auto-run.
EDGES
  ^defines=matrix/neo/internal/memory/classifier.go

