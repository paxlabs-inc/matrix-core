NODE id=matrix/neo/internal/writeback.Consolidator.proposeIfReady kind=method
  digest=b3:9230f6c8b26ba65ac773c63c069260e6ef6f71fffc2fb9e67425595dd5c19547 file=neo/internal/writeback/consolidator.go range=142:175 lang=go exported=false byte_range=5043:6118
  sig=func (c *Consolidator) proposeIfReady(spec memory.PatternSpec, coverage int)
  doc=proposeIfReady checks if a pattern has accumulated enough successes\n(coverage >= cfg.MinPatternSuccesses) to be PROPOSED as a candidate skill.\nThis is the auto-propose extension (P2-2): when a successful tool-sequence\nrepeats past the existing confidence/N-success guard, the consolidator\nrecords the pattern's name as a proposed skill. Deduped by name (the dedup\nkey). Below the guard, nothing happens (anti-overfit). Nil-safe.
EDGES
  calls=matrix/neo/internal/memory.PatternSpec.IsEmpty
  references=matrix/neo/internal/memory.PatternSpec,matrix/neo/internal/memory.PatternSpec.IsEmpty,matrix/neo/internal/writeback.Consolidator,matrix/neo/internal/writeback.c,matrix/neo/internal/writeback.coverage,matrix/neo/internal/writeback.exists,matrix/neo/internal/writeback.name,matrix/neo/internal/writeback.spec
  ^contains=matrix/neo/internal/writeback.Consolidator
  ^calls=matrix/neo/internal/writeback.Consolidator.process
  ^references=matrix/neo/internal/writeback.Consolidator.process
  ^defines=matrix/neo/internal/writeback/consolidator.go

NODE id=matrix/neo/internal/writeback.New kind=func
  digest=b3:a07f6529195642504d8ddd366910780ddc33fd923dc15cd662c162866b264eb6 file=neo/internal/writeback/consolidator.go range=58:76 lang=go exported=true byte_range=1859:2641
  sig=func New(extract, classify *llm.Client, pager *memory.Pager, cfg config.Config) *Consolidator
  doc=New builds a consolidator. extract drives the per-turn learning extraction\n(its quality directly sets memory quality); classify is the cheap model used\nonly on the rare similar-neighbor relation check. A nil classify falls back\nto extract.
EDGES
  references=matrix/neo/internal/config.Config,matrix/neo/internal/consolidation.Job,matrix/neo/internal/llm.Client,matrix/neo/internal/memory.Pager,matrix/neo/internal/writeback.Consolidator,matrix/neo/internal/writeback.cfg,matrix/neo/internal/writeback.classify,matrix/neo/internal/writeback.extract,matrix/neo/internal/writeback.pager
