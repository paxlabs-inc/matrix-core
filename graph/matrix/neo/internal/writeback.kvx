  digest=b3:56fd8f9d2a9e545ab86fcbb7e6773ecd0e23819b1f46121e51b1405f1c607f39 file=neo/internal/writeback/consolidator.go range=333:343 lang=go exported=false byte_range=14503:15119
  sig=func (c *Consolidator) linkProvenance(uri string, job consolidation.Job)
  doc=linkProvenance adds a best-effort derived_from provenance edge from a\nfreshly written memory back to the session slice it was extracted from\n(DEJA-VU req 1.1/1.2). It runs AFTER the memory write has already committed,\nso a failed or impossible edge (empty URI from a deduped write, blank conv on\nthe CLI path, or an edge error) never fails the memory write.
