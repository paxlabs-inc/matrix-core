NODE id=matrix/neo/internal/agent.Agent.AdvertisedTools kind=method
  digest=b3:458aa9e79a3f410225fe26d1579354c9382e446c9c946d4da8d47413af9d10e8 file=neo/internal/agent/automatrix_surface.go range=22:30 lang=go exported=true byte_range=877:1287
