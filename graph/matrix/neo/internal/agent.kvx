  references=matrix/neo/internal/agent.Agent,matrix/neo/internal/agent.Agent.systemPrompt,matrix/neo/internal/agent.a,matrix/neo/internal/agent.b,matrix/neo/internal/agent.base,matrix/neo/internal/agent.name
