NODE id=matrix/neo/internal/agent.flatImageTokens kind=const
  digest=b3:8bbd415d4c3ff26743270926326afaeb843a2daabd54104c379e9d4128683105 file=neo/internal/agent/payload.go range=27:29 lang=go exported=false byte_range=1129:1281
