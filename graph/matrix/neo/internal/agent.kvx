NODE id=matrix/neo/internal/agent.Agent.cmRecordUser kind=method
  digest=b3:b339fc8eb6a5eb806a5d13f33fd2e2c0005458857163485ff23a7604007ba866 file=neo/internal/agent/continuous.go range=49:63 lang=go exported=false byte_range=1881:2241
