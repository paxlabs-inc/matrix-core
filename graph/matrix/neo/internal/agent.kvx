NODE id=matrix/neo/internal/agent.Agent.pushGuidanceNudge kind=method
  digest=b3:a1c473375a32ebda370ea17e6b3d8f70be59d2ff6d316ef5e36b1159e52c9c15 file=neo/internal/agent/agent.go range=1048:1059 lang=go exported=false byte_range=49762:50411
