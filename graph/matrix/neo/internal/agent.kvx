NODE id=matrix/neo/internal/agent.scrubIdentity kind=func
  digest=b3:504140e4c0f293b0415174ea96bb20d522dbd2b8169d965929b0115f18c87a82 file=neo/internal/agent/identity.go range=89:108 lang=go exported=false byte_range=4319:5086
  sig=func scrubIdentity(name, text string) (string, bool)
  doc=scrubIdentity rewrites any self-identification as an underlying model to the\nagent's own name and reports whether it changed anything (a detected leak).\nIt is deterministic and display-safe: applied to reasoning glimpses, streamed\ndeltas, and the delivered answer so a breach never reaches the user even when\nthe prompt-level guardrail and the in-loop re-anchor both miss.
EDGES
  ^defines=matrix/neo/internal/agent/identity.go

NODE id=matrix/neo/internal/agent.shouldSuppressAutomatrix kind=func
  digest=b3:6268c38c34e52449ff1cd6bd3368bf8092d8a4768167eb517c6a51330184bb19 file=neo/internal/agent/automatrix.go range=50:56 lang=go exported=false byte_range=2636:3038
  sig=func shouldSuppressAutomatrix(answer string) bool
  doc=shouldSuppressAutomatrix reports whether the agent's final answer is the\nAUTOMATRIX_IDLE sentinel (after trimming whitespace). Only the exact sentinel\nsuppresses — a message that merely contains the token does not, so a real\nanswer that happens to mention it still reaches the user.
EDGES
  ^defines=matrix/neo/internal/agent/automatrix.go

