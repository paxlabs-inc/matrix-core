  sig=func readOverflowSchema() llm.Tool
  doc=readOverflowSchema advertises the synthetic read-full tool to the model. It is\nappended to the agent's advertised schema set (top-level and sub-agent) so the\nagent can always page a truncated result back in.
EDGES
  ^defines=matrix/neo/internal/agent/overflow.go

NODE id=matrix/neo/internal/agent.readOverflowTool kind=const
  digest=b3:4011d94508dbfa1f39a98f695ce27fafc510dc854d4f155a759a3970918acb3c file=neo/internal/agent/overflow.go range=28:33 lang=go exported=false byte_range=1036:1433
  sig=untyped string
  doc=readOverflowTool is the synthetic, agent-intercepted function the model calls\nto page the full content of a truncated result back into the window. It is\nNOT a real MCP server (exempt from the manifest bijection check) and is\nhandled inside the agent loop, never routed through the tool Manager, because\nthe overflow store lives on the agent.
EDGES
  ^defines=matrix/neo/internal/agent/overflow.go

NODE id=matrix/neo/internal/agent.refaultEvery kind=const
  digest=b3:45244490f490f4dbc8a6ef9d2f836323f62260961b47183823856081bc87f428 file=neo/internal/agent/agent.go range=1119:1122 lang=go exported=false byte_range=52721:52957
  sig=untyped int
  doc=refaultEvery is how many loop steps pass between mid-turn page-fault\nrefreshes. Small enough to track sub-goal drift in long tool loops,\nlarge enough that retrieval cost (one embed call) stays negligible.
EDGES
  ^defines=matrix/neo/internal/agent/agent.go

