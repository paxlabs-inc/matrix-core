NODE id=matrix/neo/internal/agent.Agent.validateCompletion kind=method
  digest=b3:e72126c14b193e7633455926724c2da88d772ebb8a3394e26d16f40b00943e4e file=neo/internal/agent/completion.go range=72:128 lang=go exported=false byte_range=2718:6130
  sig=func (a *Agent) validateCompletion(ctx context.Context, call *llm.ToolCall, strict, highStakes bool, goal string) completionVerdict
  doc=validateCompletion adjudicates a task_complete call. It returns an accept\nverdict (with the answer) or a reject verdict (with feedback). The strict\nflag selects the goal-vs-outcome adjudication path (a state-touching turn, or\nany substantial deliverable under GateAllWork) vs. the light structural path\nfor reversible chat. It NEVER blocks the turn on its own error — an\nunparseable call is a soft reject (ask the model to re-issue), and a Cassandra\nhiccup fails open (i_cass_5).\n\nNeo proves completion by COMPLETING, not by citing evidence: it declares the\noutcome (summary + honest coverage) and Cassandra checks that outcome against\nthe task GOAL over the real executed transcript. When no adjudicator is wired\n(CLI / tests) the strict path fails open once the object is coherent — there\nis no local word-matching stand-in (that mechanism was meaningless).
EDGES
  ^contains=matrix/neo/internal/agent.Agent
  ^defines=matrix/neo/internal/agent/completion.go

NODE id=matrix/neo/internal/agent.Agent.windowBytes kind=method
  digest=b3:f3077244ec67b6325b85bad80e5fff56b42b2e768cae404a7a5bc57c53bce643 file=neo/internal/agent/agent.go range=1783:1798 lang=go exported=false byte_range=78453:79139
  sig=func (a *Agent) windowBytes(system string) int
  doc=windowBytes approximates the serialized chat-completions request body in\nBYTES: the system block + every working message's content and tool-call\narguments + the tool schemas. It is a byte proxy (NOT a token estimate)\nbecause the provider's 413 cap is on raw body bytes, which the token budget\ndoes not track. The per-message constant covers JSON structural overhead\n(role/keys/braces/quoting).
EDGES
  ^contains=matrix/neo/internal/agent.Agent
  ^defines=matrix/neo/internal/agent/agent.go

