NODE id=matrix/neo/internal/agent.Agent.cmRelevancePush kind=method
  digest=b3:d714095221e388e4687fe8acd0a316bf23aaa42f5b5900ee413311f48642b48e file=neo/internal/agent/continuous.go range=132:170 lang=go exported=false byte_range=4462:6152
  sig=func (a *Agent) cmRelevancePush(ctx context.Context, query string) ([]memory.Snippet, string)
  doc=cmRelevancePush is the Q2 first-message relevance push. cortex.Activate's\npushed tiers (Pinned/Timeline/Recent) are recency-based and query-INDEPENDENT\n(activate.go: the query arg is unused), so on the OPENING message the agent\ncarries recency but nothing matched to what the user actually asked unless it\nreactively calls memory_recall. This runs the pager's relevance retrieval\n(semantic HNSW + the always-on salience lane + edge cascade) ONCE, on turn 1\nonly, and returns both the retrieved snippets (so the caller can fold them\ninto the turn's surfaced set for the usage-salience learning loop) and a\nrendered block to append to the activation tail. After turn 1 the pull-not-\npush philosophy resumes (the model pages in the rest via memory_recall).\n\nReturns (nil, "") when disabled, off the first turn, without a pager, or when\nretrieval yields nothing — a pure read, no durable state is touched.
EDGES
  calls=matrix/neo/internal/memory.Pager.Retrieve
  references=matrix/neo/internal/agent.Agent,matrix/neo/internal/agent.a,matrix/neo/internal/agent.b,matrix/neo/internal/agent.ctx,matrix/neo/internal/agent.err,matrix/neo/internal/agent.line,matrix/neo/internal/agent.query,matrix/neo/internal/agent.s,matrix/neo/internal/agent.snips,matrix/neo/internal/memory.Pager.Retrieve,matrix/neo/internal/memory.Snippet
  ^contains=matrix/neo/internal/agent.Agent
  ^calls=matrix/neo/internal/agent.Agent.Chat
  ^references=matrix/neo/internal/agent.Agent.Chat
  ^defines=matrix/neo/internal/agent/continuous.go

NODE id=matrix/neo/internal/agent.Agent.cmTrimWorking kind=method
  digest=b3:2b153071e4ad4ca2a0fde4e72d5f05611a1e9e5898715b41ec37942d7f79c311 file=neo/internal/agent/continuous.go range=303:321 lang=go exported=false byte_range=11265:12070
  sig=func (a *Agent) cmTrimWorking()
  doc=cmTrimWorking is the continuous-memory replacement for a.compact (retired,\nreq.9.3): it bounds the live in-memory window WITHOUT an LLM summarization\npass, because the older turns are already durable in cortex (task 6.1) and\nthe coarse history is carried by the durable story-so-far (task 4.2), which\nActivate re-surfaces every turn. It keeps the most recent user turns verbatim\nand drops older ones; when the window is a single long turn (no older section\nto carve), it strips dead-weight inline images and keeps a provider-safe tail.
EDGES
  calls=matrix/neo/internal/agent.Agent.stripOldImages,matrix/neo/internal/agent.safeTail,matrix/neo/internal/agent.splitForCompaction
  references=matrix/neo/internal/agent.Agent,matrix/neo/internal/agent.Agent.stripOldImages,matrix/neo/internal/agent.a,matrix/neo/internal/agent.keepRecentUserTurns,matrix/neo/internal/agent.older,matrix/neo/internal/agent.recent,matrix/neo/internal/agent.safeTail,matrix/neo/internal/agent.splitForCompaction
  ^contains=matrix/neo/internal/agent.Agent
  ^calls=matrix/neo/internal/agent.Agent.Chat
  ^references=matrix/neo/internal/agent.Agent.Chat
  ^defines=matrix/neo/internal/agent/continuous.go

NODE id=matrix/neo/internal/agent.Agent.compact kind=method
  digest=b3:6a98f08ee42d81b335799ce74935c7904b8d572361796eb523b44ef7bba64adb file=neo/internal/agent/compaction.go range=28:112 lang=go exported=false byte_range=1221:4873
  sig=func (a *Agent) compact(ctx context.Context, reason string)
  doc=compact swaps OLDER working history into a consolidated summary when the\nwindow fills, while keeping the most recent turns VERBATIM (Phase 4.2). It\nannounces itself (the spoken promise — transparency rule), summarizes only\nthe older section (folding any prior summary forward so nothing accumulated\nis lost), strips dead-weight inline image payloads from that section first,\nvalidates that every high-entropy token survived, and keeps the recent tail\nintact. Best-effort: on failure it degrades to the recent tail rather than\nrisking a runaway window.\n\nreason is "hard" (forced, over the hard threshold) or "soft" (cooperative,\nat a clean boundary) — used only to tune the spoken notice.
EDGES
  calls=matrix/neo/cmd/neo.stdoutReporter.Notice,matrix/neo/internal/agent.Agent.stripOldImages,matrix/neo/internal/agent.nopReporter.Notice,matrix/neo/internal/agent.renderTranscript,matrix/neo/internal/agent.safeTail,matrix/neo/internal/agent.splitForCompaction,matrix/neo/internal/agent.stripImagesIn,matrix/neo/internal/agent.validateSummary,matrix/neo/internal/llm.Client.Chat,matrix/neo/internal/llm.SystemMessage,matrix/neo/internal/llm.UserMessage,matrix/neo/internal/server.automatrixReporter.Notice,matrix/neo/internal/server.captureReporter.Notice,matrix/neo/internal/server.sseReporter.Notice,matrix/neo/internal/writeback.Consolidator.ConsolidateSync
  references=matrix/neo/internal/agent.Agent,matrix/neo/internal/agent.Agent.stripOldImages,matrix/neo/internal/agent.Consolidator.ConsolidateSync,matrix/neo/internal/agent.Reporter.Notice,matrix/neo/internal/agent.a,matrix/neo/internal/agent.client,matrix/neo/internal/agent.compactionSystemPrompt,matrix/neo/internal/agent.ctx,matrix/neo/internal/agent.err,matrix/neo/internal/agent.keepRecentUserTurns,matrix/neo/internal/agent.older,matrix/neo/internal/agent.prior,matrix/neo/internal/agent.reason,matrix/neo/internal/agent.recent,matrix/neo/internal/agent.renderTranscript,matrix/neo/internal/agent.res,matrix/neo/internal/agent.safeTail,matrix/neo/internal/agent.source,matrix/neo/internal/agent.splitForCompaction,matrix/neo/internal/agent.stripImagesIn,matrix/neo/internal/agent.summary,matrix/neo/internal/agent.transcript,matrix/neo/internal/agent.userMsg,matrix/neo/internal/agent.validateSummary,matrix/neo/internal/llm.ChatRequest,matrix/neo/internal/llm.Client.Chat,matrix/neo/internal/llm.Message,matrix/neo/internal/llm.SystemMessage,matrix/neo/internal/llm.UserMessage
