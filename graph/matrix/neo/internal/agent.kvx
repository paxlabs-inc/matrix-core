NODE id=matrix/neo/internal/agent.splitCompletion kind=func
  digest=b3:c086a8be2d7b97b7de0430cbfc072ae97886c10185596e00102a7d42f656ca18 file=neo/internal/agent/completion.go range=39:55 lang=go exported=false byte_range=1453:2091
  sig=func splitCompletion(calls []llm.ToolCall) (*llm.ToolCall, []llm.ToolCall)
  doc=splitCompletion separates a task_complete call from any sibling tool calls in\nthe same assistant turn. Returns (nil, calls) when no completion was\nrequested. Only the FIRST task_complete is treated as the gate; further ones\n(models rarely emit them) fall into rest and are answered benignly.
EDGES
  ^defines=matrix/neo/internal/agent/completion.go

NODE id=matrix/neo/internal/agent.splitForCompaction kind=func
  digest=b3:8308288c4e54f64f92738128cdaf068e233cfe9cf1ff119c1741a8925e1a426c file=neo/internal/agent/payload.go range=145:172 lang=go exported=false byte_range=4859:5812
  sig=func splitForCompaction(msgs []llm.Message, keepUserTurns int) (older, recent []llm.Message)
  doc=splitForCompaction divides the working transcript into an older section to\nsummarize and a recent tail to keep verbatim, split at a user-message\nboundary so a tool-result is never orphaned from its assistant tool-call.\nReturns older=nil when there are too few user turns to carve a clean split\n(the caller then degrades rather than summarizing recent context away). The\nrecent tail is copied so later appends never alias the older backing array.
EDGES
  ^defines=matrix/neo/internal/agent/payload.go

NODE id=matrix/neo/internal/agent.stallStopwords kind=var
  digest=b3:c452c90cff4370a110e6d55e11448f57da3cc93b897815c08919e717411fbcad file=neo/internal/agent/semantic.go range=168:177 lang=go exported=false byte_range=5634:6244
  sig=map[string]bool
  doc=stallStopwords are common low-signal words dropped before the word-overlap\ncomparison so they neither inflate nor deflate the similarity score.
EDGES
  ^defines=matrix/neo/internal/agent/semantic.go

NODE id=matrix/neo/internal/agent.stallWindow kind=const
  digest=b3:1cd633be857a80fdcfe1b3374e937f9d18f23c3b499f902192cda91e43ac0e31 file=neo/internal/agent/agent.go range=1720:1722 lang=go exported=false byte_range=76428:76590
  sig=untyped int
  doc=stallWindow bounds the recent-signature ring the cycle-aware no-progress guard\nscans to catch a rotating (A → B → A → B) spiral.
EDGES
  ^defines=matrix/neo/internal/agent/agent.go

NODE id=matrix/neo/internal/agent.stateTouchDedupKey kind=func
  digest=b3:df242b4e0911531ab4b1f2257f63fa5fd98e2a71b1809deb73019df8aae8f1b0 file=neo/internal/agent/agent.go range=1663:1685 lang=go exported=false byte_range=74377:75417
  sig=func stateTouchDedupKey(call llm.ToolCall) (string, bool)
  doc=stateTouchDedupKey returns a dedup key for a non-idempotent, state-touching\ntool call (core_execute), keyed on its RESOLVED intent so two equivalent\ncalls in one assistant batch collapse to a single run (NE-3, req 5.1/5.3).\nThe daemon mints a deterministic intent id from the prose, so two\ncore_execute calls with identical intent text would otherwise either both\nsubmit the same work or deterministically 409 against each other. Returns\n("", false) for reversible / independent calls, which always keep their\nconcurrent dispatch (req 5.2 — no latency regression for the common case).
EDGES
  ^defines=matrix/neo/internal/agent/agent.go

