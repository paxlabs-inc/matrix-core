NODE id=matrix/neo/internal/agent.overflowStore.put kind=method
  digest=b3:032d2d5e3649931fb1894d06744f91ba42c2340f0e17aa6a2871b4d6290768b6 file=neo/internal/agent/overflow.go range=60:85 lang=go exported=false byte_range=2338:3159
  sig=func (s *overflowStore) put(content string) (token string, path string, ok bool)
  doc=put writes content to a fresh run-scoped file and returns its token. On any\nfilesystem error it returns ok=false so the caller falls back to plain\nhead+tail truncation (graceful degradation — a bounded transcript beats a\ncrash).
EDGES
  ^contains=matrix/neo/internal/agent.overflowStore
  ^defines=matrix/neo/internal/agent/overflow.go

NODE id=matrix/neo/internal/agent.overflowStore.read kind=method
  digest=b3:854d22c8eafd3a6e95e6df1162775dc7c2f9b99a327ec7cbf91bc7580bb9af6b file=neo/internal/agent/overflow.go range=87:123 lang=go exported=false byte_range=3161:4033
  sig=func (s *overflowStore) read(token string, offset, limit int) (chunk string, total, next int, ok bool)
  doc=read returns a bounded window [offset, offset+limit) of the stored payload\nand marks the entry read. ok=false when the token is unknown. next is the\noffset to pass for the following page, or -1 when the end was reached.
EDGES
  ^contains=matrix/neo/internal/agent.overflowStore
  ^defines=matrix/neo/internal/agent/overflow.go

