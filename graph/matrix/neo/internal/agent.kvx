NODE id=matrix/neo/internal/agent.Agent#lastFailureClass kind=field
  digest=b3:c8e131b008e9568628d6a29a90ee3703056188fba5c5702a8206a06ef6470fd0 file=neo/internal/agent/agent.go range=187:194 lang=go exported=false byte_range=8687:9208
  sig=delegate.FailureClass
  doc=lastFailureClass records the shared FailureClass of the most recent\nclassified tool FAILURE this turn (delegate.ClassNone when none). It lets\nthe task supervisor read the SAME classification the dispatch ladder used\n(via LastFailureClass) so a deterministic blocker is not respawned over.\nReset at the top of every Chat turn; written only from the single-\nthreaded result-assembly path (never from the concurrent dispatch\ngoroutines), so it is race-free.
EDGES
  ^contains=matrix/neo/internal/agent.Agent

