NODE id=matrix/neo/internal/agent.opProfile kind=func
  digest=b3:7ec33bfcfab4110ac3b8fc11df2e3744342ed8510bcc407d34c7fc1bc37f0417 file=neo/internal/agent/semantic.go range=47:88 lang=go exported=false byte_range=2021:3672
  sig=func opProfile(calls []llm.ToolCall) (string, map[string]struct{}, map[string]struct{})
  doc=opProfile reduces a tool-call batch to (shape, targetTokens, wordTokens):\n  - shape: a stable key of the sorted tool names plus each non-text argument\n    rendered as key=value (text args contribute only key=str, since their\n    value is normalized into the token sets below).\n  - targetTokens: the high-signal identifiers in the text args (all-caps\n    symbols like SPARK, hex/addresses like 0x…, numbers, long ids).\n  - wordTokens: the remaining significant lowercase words (stopwords and\n    short tokens dropped) — the fuzzy, reword-tolerant part.
EDGES
  ^defines=matrix/neo/internal/agent/semantic.go

NODE id=matrix/neo/internal/agent.overflowReadChunk kind=const
  digest=b3:21053e6a551c1174e8e2f54e2d9c211a566ac9cc4668078e970dafa1774467a1 file=neo/internal/agent/overflow.go range=35:38 lang=go exported=false byte_range=1435:1693
  sig=untyped int
  doc=overflowReadChunk is the default number of bytes read_overflow returns per\ncall when the model does not specify a limit — bounded so paging the file\nnever re-blows the transcript byte budget that caused the overflow.
EDGES
  ^defines=matrix/neo/internal/agent/overflow.go

NODE id=matrix/neo/internal/agent.overflowStore kind=type
  digest=b3:2ebdd641d9975fb3d35f90f315860d26872492a7e2343c6f67b26cc7ebcb8650 file=neo/internal/agent/overflow.go range=48:58 lang=go exported=false byte_range=1901:2336
  sig=type overflowStore struct {\n	mu	sync.Mutex\n	dir	string\n	seq	int\n	entries	map[string]*ovfEntry\n}
  doc=overflowStore persists oversized tool results to a run-scoped temp directory\nand serves bounded windows of them back. It is created lazily on the first\noverflow and removed wholesale at turn end (cleanup). All methods are\ngoroutine-safe: capping and read_overflow can both run from the concurrent\ndispatch path.
EDGES
