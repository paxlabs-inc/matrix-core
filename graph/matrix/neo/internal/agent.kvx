  ^contains=matrix/neo/internal/agent.overflowStore
  ^defines=matrix/neo/internal/agent/overflow.go

NODE id=matrix/neo/internal/agent.overlapPct kind=func
  digest=b3:043f78927c060665ef2a59d87ccee18db99223c2204fd0247984fcf58dfe55c2 file=neo/internal/agent/semantic.go range=132:153 lang=go exported=false byte_range=4898:5406
  sig=func overlapPct(a, b map[string]struct{}) int
  doc=overlapPct is the overlap coefficient (|a∩b| / min(|a|,|b|)) as a percentage.\nTwo empty word sets count as fully overlapping (identical word-free op); a\nnon-empty vs empty pair counts as no overlap.
EDGES
  ^defines=matrix/neo/internal/agent/semantic.go

