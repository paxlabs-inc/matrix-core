  ^defines=matrix/neo/internal/agent/agent.go

NODE id=matrix/neo/internal/agent.Agent.SetSkillIndex kind=method
  digest=b3:c7d1d409a428f31f721b410ff4a7d29528dfc6f12672a258ac24a0756540cc9f file=neo/internal/agent/agent.go range=332:339 lang=go exported=true byte_range=14841:15296
  sig=func (a *Agent) SetSkillIndex(names []string)
  doc=SetSkillIndex injects a names-only skill index into the STABLE system prefix\n(P2-2). The index lists available skills by NAME only — never full bodies\n(steps/gotchas/criteria), which are pulled on demand via memory_recall. This\nkeeps the cacheable prefix token-bounded and byte-stable across turns\n(consistent with P1-2). Call after the consolidator proposes skills.
EDGES
  ^contains=matrix/neo/internal/agent.Agent
  ^defines=matrix/neo/internal/agent/agent.go

NODE id=matrix/neo/internal/agent.Agent.SetUserProfile kind=method
  digest=b3:be4830c3c994733ebd631457d07f5a5cbb716d568547147d667bf3f51e501baa file=neo/internal/agent/agent.go range=341:354 lang=go exported=true byte_range=15298:16083
  sig=func (a *Agent) SetUserProfile(agentName, preferredName string, expertiseDomains []string)
  doc=SetUserProfile injects the onboarding profile (agent_name, preferred_name,\nexpertise_domains) into the STABLE system prefix. Called after agent\nconstruction (per session rebuild) so a later profile edit is reflected on\nsubsequent turns (req 8.2). The values are per-user-stable so they preserve\nthe prompt-cache byte-stability invariant (req 2.4): a non-empty agentName\noverrides cfg.AgentName, and empty preferredName + nil expertiseDomains\nproduce no identity section (clean fallback to default "Neo").
EDGES
  ^contains=matrix/neo/internal/agent.Agent
  ^defines=matrix/neo/internal/agent/agent.go

NODE id=matrix/neo/internal/agent.Agent.adjudicateCompletion kind=method
  digest=b3:7160d6ff6cb19511dbeb21b8d6f524cf061e7f65df74adb83a335b6a09fc87d5 file=neo/internal/agent/completion.go range=130:206 lang=go exported=false byte_range=6132:9956
  sig=func (a *Agent) adjudicateCompletion(ctx context.Context, goal, summary, coverage string, openGaps, assumptions []string, highStakes bool) completionVerdict
  doc=adjudicateCompletion runs the Cassandra adjudicator: it checks whether the\nOUTCOME Neo is about to return to the user actually satisfies the task's GOAL,\njudged against the real executed transcript (the ground truth — real tool\nresults), and maps the verdict to the agent's next action (cassandra.frozen.kvx\n[seams.neo], [coupling]). Neo cites no evidence and proves nothing by hand:\ncompletion is demonstrated by the transcript, not by matching the words it\ntyped. The deterministic priors run first as the cheap pre-pass\n([adjudicator].priors); the auditor renders the grounded verdict.\n\nMapping (advisor-not-effector — the agent enacts it):\n  - the outcome satisfies the goal (grounded AND (claimed partial OR\n    Cassandra-coverage full)) → finish (Say), surfacing any flagged unknowns\n    to the user ([ux]).\n  - otherwise → feedback naming what is missing / unverified / still open so\n    Neo can fix it → the loop continues.\n\nHonest partials are preserved (i_cass_1): a turn the agent itself declares\npartial finishes as a partial, provided its outcome matches the transcript —\nCassandra blocks false SUCCESS, not honest incompleteness. On any adjudicator\nerror the turn FAILS OPEN (i_cass_5): a Cassandra hiccup never wedges a turn.
EDGES
  ^contains=matrix/neo/internal/agent.Agent
  ^defines=matrix/neo/internal/agent/completion.go

NODE id=matrix/neo/internal/agent.Agent.agentName kind=method
  digest=b3:9a829612d1d63e4465c772919de394590c8f6810579503cbe8419d09b2ab335d file=neo/internal/agent/identity.go range=72:79 lang=go exported=false byte_range=3706:3979
  sig=func (a *Agent) agentName() string
  doc=agentName is the configured agent identity with the canonical "Neo"\nfallback — the single source the identity guardrails resolve the name from.
EDGES
  ^contains=matrix/neo/internal/agent.Agent
  ^defines=matrix/neo/internal/agent/identity.go

NODE id=matrix/neo/internal/agent.Agent.ambientMemory kind=method
  digest=b3:23ea916f8e00ba4395301541c1cbbeae5a99ce08ade64c1b1ef19f2a6d218b4e file=neo/internal/agent/agent.go range=1296:1313 lang=go exported=false byte_range=59228:60059
  sig=func (a *Agent) ambientMemory(ctx context.Context, q string) []memory.Snippet
  doc=ambientMemory returns the THIN ambient memory seed injected into the system\nblock this turn (v3 #1: reasoning-time retrieval). It is the bulk semantic\nretrieval demoted from a forced blob to a small seed, capped to\ncfg.AmbientRetrievalTopK. A cap of 0 means fully tool-driven retrieval: no\nambient seed at all — the model pulls exactly what it needs mid-thought with\nthe memory_recall tool. The pinned tier (identity, hard rules, learned\nguidance, active goal, user profile) is injected separately and is NEVER\ngated by this cap.
EDGES
  ^contains=matrix/neo/internal/agent.Agent
  ^defines=matrix/neo/internal/agent/agent.go

NODE id=matrix/neo/internal/agent.Agent.attestTurn kind=method
  digest=b3:525f4e85a32da9b4842378c6e32dcb30689f607d3e768a7017c308edd5d11bab file=neo/internal/agent/agent.go range=1232:1273 lang=go exported=false byte_range=57082:58720
  sig=func (a *Agent) attestTurn(ctx context.Context, surfaced map[string]struct{}, surfacedSnips map[string]memory.Snippet, turnInput, answer string)
  doc=attestTurn closes the usage-learning loop for a successful turn. It splits\nthe surfaced set into USED (reinforced) and IGNORED (penalized): a\nsurfaced-but-ignored memory is one the rejection gate flags as off-topic to\nthe produced turn AND of a non-pinned type. The two attests are disjoint so\nno memory is both bumped and decremented in the same turn. Best-effort: a\nnil pager or empty set is a no-op, and neither attest blocks the turn.
EDGES
  ^contains=matrix/neo/internal/agent.Agent
  ^defines=matrix/neo/internal/agent/agent.go

NODE id=matrix/neo/internal/agent.Agent.budgetPct kind=method
