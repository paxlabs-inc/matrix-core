NODE id=matrix/neo/internal/agent.gateNotAcceptedToolResult kind=const
  digest=b3:5fdc34c68c5642668af024300fe8f0aa22d5869a517b446ad21ea173434c8802 file=neo/internal/agent/agent.go range=48:55 lang=go exported=false byte_range=1857:2469
  sig=untyped string
  doc=gateNotAcceptedToolResult is the neutral, non-narratable token used to answer\na rejected (or prematurely-batched) task_complete call. Every tool_call must\nreceive a tool result or a strict provider 400s, but the ACTIONABLE rejection\nreason no longer rides this in-band result (where the model would narrate it\ninto the user-visible reasoning stream, req.1.2) — it travels the guidance\nchannel instead (llm.GuidanceMessage). The model still learns the turn is not\ndone; the steering detail stays off every user surface.
EDGES
  ^defines=matrix/neo/internal/agent/agent.go

NODE id=matrix/neo/internal/agent.glimpseReasoning kind=func
  digest=b3:879ca92a0e573a13a741deece7a21be094a0e655fa0a7f898f4a4a8638f594d4 file=neo/internal/agent/agent.go range=1149:1163 lang=go exported=false byte_range=53648:54189
  sig=func glimpseReasoning(reasoning string) string
  doc=glimpseReasoning condenses a turn's chain-of-thought into a short, readable\nglimpse for the "thinking" channel: collapse whitespace, keep the leading\nsubstance, and cap the length. Returns "" when there is nothing worth\nshowing so the surface stays quiet on non-reasoning models.
EDGES
  ^defines=matrix/neo/internal/agent/agent.go

NODE id=matrix/neo/internal/agent.groundTruth kind=var
  digest=b3:8743ee802c322fc062bd2f35c83f38fe3368f9d64a31772e1c8fa55f91e453a8 file=neo/internal/agent/prompt.go range=15:21 lang=go exported=false byte_range=286:642
  sig=string
  doc=groundTruth is Neo's always-injected factual grounding (who it is, that\nPaxeer is a real live chain, the canonical RPC/explorer/docs endpoints, and\nhow to answer chain questions with its read tools instead of blind web\nsearch). Embedded so it ships in the binary and can't drift from the build.
EDGES
  ^defines=matrix/neo/internal/agent/prompt.go

NODE id=matrix/neo/internal/agent.highEntropyRes kind=var
  digest=b3:66a7c7efd002355c3cc6dc8d576b29957ae6248318cbab18bcc35d558ea5db50 file=neo/internal/agent/validate.go range=22:31 lang=go exported=false byte_range=890:1888
  sig=[]*regexp.Regexp
  doc=highEntropyRes match the token classes the verbatim rule protects. Order is\nnot significant; results are de-duplicated by value.
EDGES
  ^defines=matrix/neo/internal/agent/validate.go

NODE id=matrix/neo/internal/agent.identityReanchorNudge kind=func
  digest=b3:f8541b859bfd8e7604c89ffea8104cceb989a24600df7cbb9c098bbe930187de file=neo/internal/agent/identity.go range=110:117 lang=go exported=false byte_range=5088:5672
  sig=func identityReanchorNudge(name string) string
  doc=identityReanchorNudge is the private guidance-channel steer used to re-anchor\na model that broke character. It corrects the CURRENT turn and reasserts the\ncharter's authority rather than only hiding the symptom.
EDGES
  ^defines=matrix/neo/internal/agent/identity.go

NODE id=matrix/neo/internal/agent.identityScrubs kind=var
  digest=b3:1a0c04c8aac9cf45e6e62a35fdf81e6da86cde806fc1352e6386ae1917986910 file=neo/internal/agent/identity.go range=46:70 lang=go exported=false byte_range=1978:3704
  sig=[]*regexp.Regexp
  doc=identityScrubs are the high-precision self-identification patterns. Each\ncaptures the leading cue in groups 1 and 2 (an optional article between the\ncue and the model name is consumed but dropped) so a replacement of\n"${1}${2}<name>" keeps the sentence intact while swapping only the identity\ntoken. They target FIRST-PERSON self-identification and self-role framing —\nnever a third-person mention — so legitimately discussing these models (e.g.\n"GPT is OpenAI's model", "I'm using Claude for this") is left untouched.
EDGES
  ^defines=matrix/neo/internal/agent/identity.go

NODE id=matrix/neo/internal/agent.imageAwareTokens kind=func
  digest=b3:d594855f9507bb2d3efd3df534a7aec3257d712000eba2e66b160e818b06396e file=neo/internal/agent/payload.go range=114:120 lang=go exported=false byte_range=3903:4216
  sig=func imageAwareTokens(s string) int
  doc=imageAwareTokens estimates the token cost of s, charging a flat per-image\nbudget for inline base64 image payloads instead of their (wildly larger)\nbase64 character length.
EDGES
  ^defines=matrix/neo/internal/agent/payload.go

