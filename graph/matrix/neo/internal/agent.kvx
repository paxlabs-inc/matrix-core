NODE id=matrix/neo/internal/agent.ErrIncomplete kind=var
  digest=b3:4e6eed0e72cdf4fd0e9a62f9fd08d93c7fad50b9a32ab9fffabd4d7a56e547db file=neo/internal/agent/agent.go range=37:45 lang=go exported=true byte_range=1193:1835
  sig=error
  doc=ErrIncomplete marks a turn that ended WITHOUT completing the task: the loop\nstalled (no progress) or exhausted its step budget. It is distinct from a\nmodel/transport error and from a genuine completion (nil). The task\nsupervisor (internal/server) treats it as "not done — keep going": it\nrespawns a fresh agent over durable state and continues, rather than\nsurfacing a fake "Done" to the user. The wrapped text carries a short,\nhonest where-I-got-stuck digest for the next attempt's catch-up.\nDetect with errors.Is(err, agent.ErrIncomplete).
EDGES
  ^references=matrix/neo/internal/agent.Agent.Chat,matrix/neo/internal/agent.Agent.escalateGuidance,matrix/neo/internal/server.deathDigest
  ^defines=matrix/neo/internal/agent/agent.go

