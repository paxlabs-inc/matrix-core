NODE id=matrix/neo/internal/agent.Agent.cassandraEdit kind=method
  digest=b3:e606f77f7b70bd2777475910f712eca00d771c0780f92640a7d80c99e3280553 file=neo/internal/agent/cassandra.go range=192:233 lang=go exported=false byte_range=8712:10754
  sig=func (a *Agent) cassandraEdit(target int, mod string, trig modTrigger, side modSide, step int) bool
  doc=cassandraEdit folds a first-person metacognitive line into the Content of the\nassistant-role message at index target, IN PLACE. Guardrail 1 (content-only) is\nenforced structurally: it asserts RoleAssistant and mutates ONLY .Content —\nnever ToolCalls / Role / Name, and never a tool / user / system message. The\nfold is additive (the original text is preserved and the mod is layered AFTER\nit as the agent's next thought), so guardrail 2 (metacognition-only, never a\nrewrite of facts) holds by construction. The dual-record + audit event\n(guardrail 3) are written BEFORE the mutation, and the durable cortex\ntranscript is NOT rewritten (cmRecordAssistant already stored the original), so\ncortex stays ground truth (req.7.1). Returns false (no-op) if the target is out\nof range or is not an assistant message.
EDGES
  calls=matrix/neo/internal/agent.Agent.emitAudit
  references=matrix/neo/internal/agent.Agent,matrix/neo/internal/agent.Agent.emitAudit,matrix/neo/internal/agent.a,matrix/neo/internal/agent.auditEventMod,matrix/neo/internal/agent.cassandraMod,matrix/neo/internal/agent.folded,matrix/neo/internal/agent.mod,matrix/neo/internal/agent.modSide,matrix/neo/internal/agent.modTrigger,matrix/neo/internal/agent.original,matrix/neo/internal/agent.side,matrix/neo/internal/agent.step,matrix/neo/internal/agent.target,matrix/neo/internal/agent.trig,matrix/neo/internal/llm.RoleAssistant
  ^contains=matrix/neo/internal/agent.Agent
  ^calls=matrix/neo/internal/agent.Agent.cassandraStep
  ^references=matrix/neo/internal/agent.Agent.cassandraStep
  ^defines=matrix/neo/internal/agent/cassandra.go

NODE id=matrix/neo/internal/agent.Agent.cassandraStep kind=method
  digest=b3:430e92d87b948ff9f5452f9067a1ed2280818e7d5a1fb3f0c688702765573525 file=neo/internal/agent/cassandra.go range=157:190 lang=go exported=false byte_range=7362:8710
  sig=func (a *Agent) cassandraStep(sig cassandraSignals) bool
  doc=cassandraStep is the per-step controller entry point. It is a no-op before\nmin_step, when the per-turn mod budget is spent, when the per-trigger cooldown\nis active, or when no drift trigger fires (the healthy case → the window is\nbyte-identical to the controller disabled). On a fire it edits the just-\nappended assistant message's Content in place, records the dual-record, and\nemits the cassandra.mod audit event. Returns whether it modified the window.
EDGES
  calls=matrix/neo/internal/agent.Agent.casCooldownSteps,matrix/neo/internal/agent.Agent.casMaxMods,matrix/neo/internal/agent.Agent.casMinStep,matrix/neo/internal/agent.Agent.cassandraClassify,matrix/neo/internal/agent.Agent.cassandraEdit,matrix/neo/internal/agent.cassandraTemplate
