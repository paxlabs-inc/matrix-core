NODE id=matrix/neo/internal/agent.Agent#inbox kind=field
  digest=b3:ffc619d0d3a1db241aa5764819350c5652f51bb0ed72b7197763c1ced0f41c34 file=neo/internal/agent/agent.go range=180:185 lang=go exported=false byte_range=8242:8628
  sig=func() []string
  doc=inbox, when set, returns user messages queued (by the session) WHILE\nthis turn is in flight — mid-task messages the user sent without\ninterrupting (F5). The loop drains it at each tool-call boundary and\nappends them to the transcript, so the agent picks them up on its next\nstep instead of the message cancelling the run. nil on the CLI path.
EDGES
  ^contains=matrix/neo/internal/agent.Agent

