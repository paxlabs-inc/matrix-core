  ^defines=matrix/neo/internal/agent/agent.go

NODE id=matrix/neo/internal/agent.llmDecoder kind=type
  digest=b3:484e00c4143a7a52a68ea155255fc21f694377545aa09949681409dc48692fb5 file=neo/internal/agent/cassandra.go range=59:64 lang=go exported=false byte_range=2395:2807
  sig=type llmDecoder struct{ client *llm.Client }
  doc=llmDecoder adapts Neo's function-calling llm.Client to cassandra.Decoder: a\nsingle auditor round-trip (system + user prompt in, raw model text out, no\ntools). The neo client already strips reasoning / inline <think> and folds\nthe streamed turn, so the returned content is the bare verdict text that\ncassandra.ParseVerdict extracts the JSON object from.
EDGES
  contains=matrix/neo/internal/agent.llmDecoder#client,matrix/neo/internal/agent.llmDecoder.Decode
  ^defines=matrix/neo/internal/agent/cassandra.go

