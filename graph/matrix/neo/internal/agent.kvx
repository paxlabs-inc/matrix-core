NODE id=matrix/neo/internal/agent.batchTouchesState kind=func
  digest=b3:8e1f33446cdb436e6f1b0a1833881e351cc8100967be8f6cb6ad2451e2b2b446 file=neo/internal/agent/completion.go range=57:70 lang=go exported=false byte_range=2093:2716
  sig=func batchTouchesState(calls []llm.ToolCall) bool
  doc=batchTouchesState reports whether a tool-call batch reaches the irreversible\nseam — core_execute (the MCL pipeline: spend / sign / deploy / settle). The\nreversible Natural toolset (shell, files, browser, web, git) is NOT treated\nas state-touching here: per the spec's placement-by-reversibility, those\nturns ride the light path so reversible work stays frictionless. Only the\nmoney/chain seam forces a full grounded completion object.
EDGES
  ^defines=matrix/neo/internal/agent/completion.go

NODE id=matrix/neo/internal/agent.buildAuditContract kind=func
  digest=b3:c7eea49cf84af0154e1f94a13acbb718d9fb61c667c39b5ce3b7573368ed8d83 file=neo/internal/agent/cassandra.go range=114:139 lang=go exported=false byte_range=4497:5902
  sig=func buildAuditContract(goal, summary, coverage string, openGaps, assumptions []string) string
  doc=buildAuditContract folds the task GOAL together with the OUTCOME Neo is about\nto return to the user, so the auditor can check whether that outcome actually\nsatisfies the goal over the executed transcript ([verdict.fields] — coverage +\nthe unverified-claims hallucination surface). Neo cites no evidence; the\ntranscript (AuditInput.Evidence) is the ground truth, so completion is proven\nby what actually ran, never by matching the words the agent typed.
EDGES
  ^defines=matrix/neo/internal/agent/cassandra.go

NODE id=matrix/neo/internal/agent.capToolResultPlain kind=func
  digest=b3:8845ac2fda46a79398b2d80ed7210a4025ec285781e7540a73c95513e60d14ee file=neo/internal/agent/overflow.go range=188:200 lang=go exported=false byte_range=6085:6643
  sig=func capToolResultPlain(s string) string
  doc=capToolResultPlain is the no-overflow-store fallback: a bounded head+tail with\nan explicit marker (the legacy behavior, used only when the overflow file\ncannot be written so the turn still proceeds with a bounded transcript).
EDGES
  ^defines=matrix/neo/internal/agent/overflow.go

