NODE id=matrix/neo/internal/agent.summaryHasSchema kind=func
  digest=b3:e5737b01378c4939ef168ceb00027877587ec2c7567f5cd4c1a6403b562d37f7 file=neo/internal/agent/validate.go range=55:66 lang=go exported=false byte_range=2550:2909
  sig=func summaryHasSchema(summary string) bool
  doc=summaryHasSchema reports whether the summary fills the load-bearing template\nheaders (a weak summary is still kept — never discarded — but the caller may\nnote it).
EDGES
  ^defines=matrix/neo/internal/agent/validate.go

NODE id=matrix/neo/internal/agent.theUserRe kind=var
  digest=b3:82eab6df105895d686f11e6787274e39e8645e9ea0670eb595818b51b7231a74 file=neo/internal/agent/agent.go range=1165:1168 lang=go exported=false byte_range=54191:54474
  sig=*regexp.Regexp
  doc=theUserRe matches the generic third-person reference "the user" (and its\npossessive "the user's"), case-insensitive on the leading "the", with word\nboundaries so "users" (plural) and mid-word matches are left alone.
EDGES
  ^defines=matrix/neo/internal/agent/agent.go

NODE id=matrix/neo/internal/agent.topicPivotCosine kind=const
  digest=b3:c3d6830679d5e84d3bd09c64d1f9b0d1bf48bbca761da548a39d0a547a01c114 file=neo/internal/agent/topicshift.go range=25:29 lang=go exported=false byte_range=1092:1430
  sig=float32
  doc=topicPivotCosine is the cosine-to-centroid floor below which a new turn is\ntreated as a topic pivot. 0.30 matches the off-topic floor used by the\nrejection-attest path (salience_realism.go) so "off-topic to the running\nthread" means the same thing on both the read and the learning sides.
EDGES
  ^defines=matrix/neo/internal/agent/topicshift.go

NODE id=matrix/neo/internal/agent.topicTracker kind=type
  digest=b3:5480fe58c4333203ae9a5e01dbfdaab38f896356e3eded1924956ee8c90fe6ed file=neo/internal/agent/topicshift.go range=36:43 lang=go exported=false byte_range=1684:1939
  sig=type topicTracker struct {\n	emb		embed.Embedder\n	centroid	[]float32\n	count		int\n}
  doc=topicTracker maintains the rolling topic centroid for one conversation.\nSingle-threaded by construction (a session serializes its turns), so it\nneeds no lock.
EDGES
  contains=matrix/neo/internal/agent.topicTracker#centroid,matrix/neo/internal/agent.topicTracker#count,matrix/neo/internal/agent.topicTracker#emb,matrix/neo/internal/agent.topicTracker.observe,matrix/neo/internal/agent.topicTracker.observeVec
  ^defines=matrix/neo/internal/agent/topicshift.go

NODE id=matrix/neo/internal/agent.topicTracker#centroid kind=field
  digest=b3:fb2e4046d070369e607b886b47f766a4b098ed7b8fefe9bfaea094e3175bd794 file=neo/internal/agent/topicshift.go range=41:41 lang=go exported=false byte_range=1905:1923
  sig=[]float32
EDGES
  ^contains=matrix/neo/internal/agent.topicTracker

NODE id=matrix/neo/internal/agent.topicTracker#count kind=field
  digest=b3:3fb143b0cf22d64f3142da0fbb12769a80b9c96b8a89076b004c8fd1f03d3643 file=neo/internal/agent/topicshift.go range=42:42 lang=go exported=false byte_range=1925:1937
  sig=int
EDGES
  ^contains=matrix/neo/internal/agent.topicTracker

NODE id=matrix/neo/internal/agent.topicTracker#emb kind=field
  digest=b3:3c87ff0f5f354dad0598babcb45d1b63a58fe9f1a7893e413c5681513209ac49 file=neo/internal/agent/topicshift.go range=40:40 lang=go exported=false byte_range=1880:1903
  sig=embed.Embedder
EDGES
  ^contains=matrix/neo/internal/agent.topicTracker

NODE id=matrix/neo/internal/agent.topicTracker.observe kind=method
  digest=b3:7028fc85926b9696d68264c14bf0f19e3ec0c883c4d153c7460e0f60ecb845f0 file=neo/internal/agent/topicshift.go range=49:66 lang=go exported=false byte_range=2033:2559
  sig=func (t *topicTracker) observe(text string) bool
  doc=observe embeds text, folds it into the rolling centroid, and reports whether\nthe turn is a topic pivot. A nil tracker/embedder, empty text, or an embed\nfailure reports no pivot (the conservative default: never drop context on a\nhiccup).
EDGES
  ^contains=matrix/neo/internal/agent.topicTracker
  ^defines=matrix/neo/internal/agent/topicshift.go

NODE id=matrix/neo/internal/agent.topicTracker.observeVec kind=method
  digest=b3:9e86639ff0762b936362cea1f06abfd9ba195486f66ba88d2330b469f0fee6ef file=neo/internal/agent/topicshift.go range=68:100 lang=go exported=false byte_range=2561:3730
  sig=func (t *topicTracker) observeVec(vec []float32) bool
  doc=observeVec is the embedding-free core (unit-tested directly with synthetic\nvectors, since the hash-stub embedder's geometry is not semantic). It seeds\nthe centroid on the first turn, detects a pivot against the established\ncentroid, and otherwise folds the turn into a window-capped rolling mean.
EDGES
  ^contains=matrix/neo/internal/agent.topicTracker
  ^defines=matrix/neo/internal/agent/topicshift.go

NODE id=matrix/neo/internal/agent.topicWindowN kind=const
  digest=b3:9097508683409f7494161bcae4b0aacad84f91e71f313b16e4b27e9b86f61d16 file=neo/internal/agent/topicshift.go range=31:34 lang=go exported=false byte_range=1432:1682
  sig=untyped int
  doc=topicWindowN bounds the rolling centroid so it tracks the LAST N turns\nrather than the whole thread — old turns decay out instead of anchoring the\ncentroid forever, keeping pivot detection responsive on long threads.
EDGES
  ^defines=matrix/neo/internal/agent/topicshift.go

NODE id=matrix/neo/internal/agent.truncate kind=func
  digest=b3:fa889a1906a97a6dfdd149bfff89105f3c005f9843a42f37d300e9afa306d009 file=neo/internal/agent/agent.go range=1847:1852 lang=go exported=false byte_range=81101:81196
  sig=func truncate(s string, n int) string
EDGES
  ^defines=matrix/neo/internal/agent/agent.go

NODE id=matrix/neo/internal/agent.underlyingModelNames kind=var
  digest=b3:30b42b19533b06ec0ffaa9928100af1bd4b9d61f48e63ebf7e4c99a55dd0487b file=neo/internal/agent/identity.go range=21:33 lang=go exported=false byte_range=841:1589
  sig=[]string
  doc=underlyingModelNames enumerates the foundation-model and lab identities Neo\nmust never present as its OWN identity. That a large model provides Neo's\nfluency is not a secret; the failure is the model speaking or reasoning AS\none of these instead of as the agent. Ordered longest-first WITHIN a family\n(gpt-4o before gpt) because Go's regexp alternation is leftmost-first, so the\nmost specific token must come earlier to win.
EDGES
  ^defines=matrix/neo/internal/agent/identity.go

NODE id=matrix/neo/internal/agent.validateSummary kind=func
  digest=b3:2c22ac0cdc025e9b54b63969282470e4c3f7dd3420fb531709d077186d0496da file=neo/internal/agent/validate.go range=68:97 lang=go exported=false byte_range=2911:3917
  sig=func validateSummary(transcript, summary string) (string, bool)
  doc=validateSummary enforces the verbatim contract on a freshly authored summary:\nany high-entropy token present in the source transcript but missing from the\nsummary is re-appended under a preserved-identifiers line, so compaction can\nnever silently drop an address, hash, id, or path. Returns the repaired\nsummary and whether it passed clean (schema present and nothing was missing).
EDGES
  ^defines=matrix/neo/internal/agent/validate.go

NODE id=matrix/neo/internal/agent.verdictAccepts kind=func
  digest=b3:22df13e1d5600f31b70a2fd55ce62e071530d631b7495f31d08658466c5f347d file=neo/internal/agent/cassandra.go range=141:162 lang=go exported=false byte_range=5904:6999
  sig=func verdictAccepts(coverage string, v *cassandra.Verdict) bool
  doc=verdictAccepts is the pure verdict→accept decision the strict gate applies\n([coupling].high_stakes, i_cass_1). A completion passes only when the OUTCOME\nis GROUNDED in the executed transcript — every load-bearing claim backed by a\nreal result (no unverified claims) — AND its coverage is honest: a claimed-\nfull turn needs Cassandra to agree coverage is complete, while a claimed\npartial is honest incompleteness that only needs grounding. This preserves\nhonest partials (Cassandra blocks false SUCCESS, not honest "I didn't\nfinish").
EDGES
  ^defines=matrix/neo/internal/agent/cassandra.go

