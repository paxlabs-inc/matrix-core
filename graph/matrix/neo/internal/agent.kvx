NODE id=matrix/neo/internal/agent.stripDataURIs kind=func
  digest=b3:5db2ad1256c91f7c2f2eb815967228d3c0154564990f0f6e5a08d2ea44658fcf file=neo/internal/agent/payload.go range=67:112 lang=go exported=false byte_range=2643:3901
