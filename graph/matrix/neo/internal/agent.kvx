NODE id=matrix/neo/internal/agent.AutomatrixIdle kind=const
  digest=b3:f4a5ceeb2061be3e6eef46b853323d2164d91ab09475bc883927f2400e6b0710 file=neo/internal/agent/automatrix.go range=21:25 lang=go exported=true byte_range=905:1222
  sig=untyped string
  doc=AutomatrixIdle is the sentinel the agent emits when an Automatrix wake found\nnothing worth doing right now. When the agent's final answer is exactly this\ntoken, the turn is suppressed — a.out.Say is never called, so AUTOMATRIX_IDLE\nis never surfaced to the user.
EDGES
  ^defines=matrix/neo/internal/agent/automatrix.go

NODE id=matrix/neo/internal/agent.AutomatrixWakeMarker kind=const
  digest=b3:4a3fc3124baae9d0d33d5065c25460763f418498c9eea442e993ed29f6570c00 file=neo/internal/agent/automatrix.go range=27:31 lang=go exported=true byte_range=1224:1540
  sig=untyped string
  doc=AutomatrixWakeMarker is the token a Chronos AUTOMATRIX alarm's wake_message\ncarries so Neo can detect it as an Automatrix (proactive surprise-task) turn\nrather than a normal user message. Distinct from AutomatrixIdle so a wake\nnever accidentally self-suppresses.
EDGES
  ^defines=matrix/neo/internal/agent/automatrix.go

NODE id=matrix/neo/internal/agent.AutomatrixWakeMessage kind=const
  digest=b3:2b6d820fc769e0396f3ff9f98b8697bdfce506f89ae9749dc04445b240c036e7 file=neo/internal/agent/automatrix.go range=33:41 lang=go exported=true byte_range=1542:2325
  sig=untyped string
  doc=AutomatrixWakeMessage is the canonical wake_message a Chronos AUTOMATRIX alarm\ndelivers. It instructs the agent to review its pending non-financial\nopportunities, complete one if worthwhile and notify the user, or reply with\nexactly AUTOMATRIX_IDLE when nothing is worth doing right now.\n\nThis MUST stay byte-identical to the Chronos-side WakeMessage\n(chronos/internal/automatrix) — they share the AUTOMATRIX marker that the\nagent uses to detect an Automatrix wake.
EDGES
  ^defines=matrix/neo/internal/agent/automatrix.go

NODE id=matrix/neo/internal/agent.Consolidator kind=interface
  digest=b3:72bd835a8805318e93f43cd8749900c917de56f702d34d1ecb4b0a0903e27232 file=neo/internal/agent/agent.go range=57:66 lang=go exported=true byte_range=2471:3032
  sig=type Consolidator interface {\n	Consolidate(transcript string)\n	// ConsolidateSync runs the same extraction synchronously on the caller's\n	// goroutine. Called from compact() before evicting older turns so durable\n	// facts/events/patterns reach cortex before the turns are lost.\n	ConsolidateSync(ctx context.Context, transcript string)\n}
  doc=Consolidator is the background write-back hook: it receives a completed\nturn's transcript and promotes durable learnings to cortex out-of-band.\nImplemented by internal/writeback; optional (nil disables write-back).
EDGES
  ^implements=matrix/neo/internal/writeback.Consolidator
  ^defines=matrix/neo/internal/agent/agent.go

NODE id=matrix/neo/internal/agent.ConvRecaller kind=interface
  digest=b3:aad3d2b6d902267f64c2b4566786eee9fc1af8f411e5be147d7049dfe0aeffb5 file=neo/internal/agent/agent.go range=68:75 lang=go exported=true byte_range=3034:3501
  sig=type ConvRecaller interface {\n	Relevant(ctx context.Context, query string) []recall.Hit\n}
  doc=ConvRecaller surfaces the most relevant PAST turns of this conversation\n(beyond the live transcript / resume seed) for a given query. Implemented by\ninternal/recall; optional (nil disables conversational recall). It is the\nadditive read-lane that lets an unbounded thread stay coherent — relevance\nover raw recency — without growing the in-window transcript.
EDGES
  ^implements=matrix/neo/internal/recall.Recaller
  ^defines=matrix/neo/internal/agent/agent.go

NODE id=matrix/neo/internal/agent.ErrIncomplete kind=var
  digest=b3:4e6eed0e72cdf4fd0e9a62f9fd08d93c7fad50b9a32ab9fffabd4d7a56e547db file=neo/internal/agent/agent.go range=38:46 lang=go exported=true byte_range=1213:1855
  sig=error
  doc=ErrIncomplete marks a turn that ended WITHOUT completing the task: the loop\nstalled (no progress) or exhausted its step budget. It is distinct from a\nmodel/transport error and from a genuine completion (nil). The task\nsupervisor (internal/server) treats it as "not done — keep going": it\nrespawns a fresh agent over durable state and continues, rather than\nsurfacing a fake "Done" to the user. The wrapped text carries a short,\nhonest where-I-got-stuck digest for the next attempt's catch-up.\nDetect with errors.Is(err, agent.ErrIncomplete).
EDGES
  ^defines=matrix/neo/internal/agent/agent.go

NODE id=matrix/neo/internal/agent.HeartbeatOK kind=const
  digest=b3:ad5d33c867838e0708efd636a5995323c8449e7be63af70870ee287b65230db7 file=neo/internal/agent/heartbeat.go range=20:24 lang=go exported=true byte_range=773:1110
  sig=untyped string
  doc=HeartbeatOK is the sentinel the agent emits when a heartbeat wake reviewed\nactive goals/constraints and found nothing needing attention. When the\nagent's final answer is exactly this token, the turn is suppressed —\na.out.Say is never called, so HEARTBEAT_OK is never surfaced to the user.
EDGES
  ^defines=matrix/neo/internal/agent/heartbeat.go

