NODE id=matrix/neo/internal/agent.Agent.nameReasoning kind=method
  digest=b3:26f69c67cd54990c9adf49b0d8c42bd75b0716331d4abbb4275fc07eb9b45aba file=neo/internal/agent/agent.go range=1170:1200 lang=go exported=false byte_range=54476:55991
  sig=func (a *Agent) nameReasoning(text string) string
  doc=nameReasoning personalises the model's VISIBLE reasoning (Q1): the user can\nread Neo's chain-of-thought, so a generic "the user asked …" reads coldly\nwhere "Andrew asked …" reads like Neo actually knows them. It rewrites the\n"the user" / "the user's" reference to the user's preferred name. This is a\nDISPLAY-only transform on the thinking channel — the model's underlying\nreasoning tokens are untouched and reasoning is never persisted, so there is\nno determinism/replay concern. It only fires when a preferred name is known;\notherwise the text is returned verbatim. The prompt already steers the model\nto name the user in its thinking (systemPrompt), so this is the deterministic\nbackstop for the complete-text (fold-time) reasoning path.
EDGES
  ^contains=matrix/neo/internal/agent.Agent
  ^defines=matrix/neo/internal/agent/agent.go

NODE id=matrix/neo/internal/agent.Agent.noteFailureClass kind=method
  digest=b3:7913ed874b57ea27e892644adea1026bc94416b8a626c915cd09101a8b41726d file=neo/internal/agent/agent.go range=1562:1572 lang=go exported=false byte_range=69878:70471
  sig=func (a *Agent) noteFailureClass(class delegate.FailureClass)
  doc=noteFailureClass records the most recent classified tool FAILURE this turn so\nthe task supervisor (LastFailureClass) reads the SAME taxonomy the dispatch\nladder used. A clean dispatch (ClassNone) does not clear a prior failure: a\ndeterministic blocker remains the reason the turn is stuck even if later\nreversible calls succeed. Called only from the single-threaded result-\nassembly paths, so it never races the concurrent dispatch goroutines.
EDGES
  ^contains=matrix/neo/internal/agent.Agent
  ^defines=matrix/neo/internal/agent/agent.go

