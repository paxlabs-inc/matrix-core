NODE id=matrix/neo/internal/agent.dedupStateTouching kind=func
  digest=b3:1bfebd52d5d97b12634f8ea2c1bcfa5c9757e406af24f5f022366cdcff51b967 file=neo/internal/agent/agent.go range=1687:1709 lang=go exported=false byte_range=75419:76178
  sig=func dedupStateTouching(calls []llm.ToolCall) []int
  doc=dedupStateTouching returns, for each call index, the index of an EARLIER call\nin the same batch it is an equivalent duplicate of (-1 when it is canonical\nor not a dedup candidate). Only non-idempotent state-touching calls are\ndeduped; independent reversible calls are always -1 so they keep dispatching\nconcurrently. The canonical (first) occurrence runs once and the duplicates\njoin its result.
EDGES
  ^defines=matrix/neo/internal/agent/agent.go

NODE id=matrix/neo/internal/agent.effectiveBudgetSignals kind=type
  digest=b3:b3ff115480d4da3e0af1f7a4a875f22d131cf175c5025876ce09301a3d704cd6 file=neo/internal/agent/agent.go range=356:373 lang=go exported=false byte_range=16085:17083
  sig=type effectiveBudgetSignals struct {\n	// step is the current loop iteration index (0-based).\n	step	int\n	// distinctTools is the number of distinct tool names dispatched so far\n	// this turn. 0 or 1 = simple turn; >1 signals multi-step breadth.\n	distinctTools	int\n	// stallRepeats is the current no-progress repeat count (how many\n	// consecutive identical batches have been seen). Not used to scale the\n	// budget UP — a stalling turn should terminate, not get more room —\n	// but tracked so the signal bundle is self-contained for observability.\n	stallRepeats	int\n}
  doc=effectiveBudgetSignals carries the observable turn-complexity signals the\nadaptive step-budget computation reads. It is populated by the Chat loop as\nthe turn progresses. The primary signal is distinctTools — the count of\nDIFFERENT tool names dispatched so far — which proxies turn breadth: a turn\nusing one tool repeatedly is simple; a turn that fans across many tools is\ncomplex and warrants more steps.
EDGES
  contains=matrix/neo/internal/agent.effectiveBudgetSignals#distinctTools,matrix/neo/internal/agent.effectiveBudgetSignals#stallRepeats,matrix/neo/internal/agent.effectiveBudgetSignals#step
  ^defines=matrix/neo/internal/agent/agent.go

NODE id=matrix/neo/internal/agent.effectiveBudgetSignals#distinctTools kind=field
  digest=b3:c72116299b52b56c13a2ac480473374e20e249d07e1ebd6bf8f1ce6171863125 file=neo/internal/agent/agent.go range=365:367 lang=go exported=false byte_range=16617:16775
  sig=int
  doc=distinctTools is the number of distinct tool names dispatched so far\nthis turn. 0 or 1 = simple turn; >1 signals multi-step breadth.
EDGES
  ^contains=matrix/neo/internal/agent.effectiveBudgetSignals

NODE id=matrix/neo/internal/agent.effectiveBudgetSignals#stallRepeats kind=field
  digest=b3:0fe9803d1b5adf4439fc8ac56eeb95a6191f388022e14985f8be79b4a7793564 file=neo/internal/agent/agent.go range=368:372 lang=go exported=false byte_range=16777:17081
  sig=int
  doc=stallRepeats is the current no-progress repeat count (how many\nconsecutive identical batches have been seen). Not used to scale the\nbudget UP — a stalling turn should terminate, not get more room —\nbut tracked so the signal bundle is self-contained for observability.
EDGES
  ^contains=matrix/neo/internal/agent.effectiveBudgetSignals

NODE id=matrix/neo/internal/agent.effectiveBudgetSignals#step kind=field
  digest=b3:7e30d5125376cc64f78855ea7b76768dc06836d253c8b82699a0aea02452f6b0 file=neo/internal/agent/agent.go range=363:364 lang=go exported=false byte_range=16551:16615
  sig=int
  doc=step is the current loop iteration index (0-based).
EDGES
  ^contains=matrix/neo/internal/agent.effectiveBudgetSignals

