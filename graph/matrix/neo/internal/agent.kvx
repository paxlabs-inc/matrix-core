  doc=AdvertisedTools returns a copy of the exact tool schema set this agent\nadvertises to the model (the slice passed as ChatRequest.Tools). It exists so\nthe Automatrix structural guarantee can be asserted against the REAL surface\nthe model would see, not a reconstruction of it.
EDGES
  ^contains=matrix/neo/internal/agent.Agent
  ^defines=matrix/neo/internal/agent/automatrix_surface.go

NODE id=matrix/neo/internal/agent.Agent.BestEffort kind=method
  digest=b3:d1f79a8c8be127995e4e9f99a8114cf8a0c49cca6450bfd9056a1585d1d3c59c file=neo/internal/agent/agent.go range=1089:1102 lang=go exported=true byte_range=51499:52131
  sig=func (a *Agent) BestEffort() string
  doc=BestEffort returns the most honest "where things stand" digest the agent can\nproduce WITHOUT having finished — the latest assistant narration, else the\nconsolidated summary, else the last tool summary. The task supervisor uses\nit to deliver a truthful partial when a task hits its hard ceiling; it is\nnever a fabricated success. Empty when there is genuinely nothing to report.
EDGES
  ^contains=matrix/neo/internal/agent.Agent
  ^defines=matrix/neo/internal/agent/agent.go

NODE id=matrix/neo/internal/agent.Agent.Chat kind=method
  digest=b3:6825fccbd5d410ee46bce8fc2c3f73eaba79807e213e52ada821fd541ab33f35 file=neo/internal/agent/agent.go range=442:1037 lang=go exported=true byte_range=19477:49306
