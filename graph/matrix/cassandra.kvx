  ^contains=matrix/cassandra.Verdict

NODE id=matrix/cassandra.Verdict#UnverifiedClaims kind=field
  digest=b3:e7f158e46458ecfa840c0065fe4a5fec02b3bf3b51e198a6c95c4d296c61f6d8 file=cassandra/verdict.go range=49:51 lang=go exported=true byte_range=2426:2599
  sig=[]string
  doc=UnverifiedClaims are assertions the agent made that NO executed evidence\nsupports — the hallucination surface.
EDGES
  ^contains=matrix/cassandra.Verdict

NODE id=matrix/cassandra.Verdict.CoverageComplete kind=method
  digest=b3:97b246778da953d2072a6dcb283e489340eec51a46385536347221ea7ffbaa7a file=cassandra/verdict.go range=110:117 lang=go exported=true byte_range=4817:5309
  sig=func (v *Verdict) CoverageComplete() bool
  doc=CoverageComplete reports the legacy completeness-critic decision: every\nrequested deliverable was produced ([seams.mcl]). This is the gate the MCL\nre-home consults, so its behaviour is byte-identical to the old\ncriticVerdict.Complete (Coverage==full AND no Missing items). Grounding does\nNOT enter this gate — that is reserved for Sound (Neo's gate, Phase 3).
EDGES
  ^contains=matrix/cassandra.Verdict
  ^defines=matrix/cassandra/verdict.go

NODE id=matrix/cassandra.Verdict.IsGrounded kind=method
  digest=b3:c9de88773724900723fc9c370e2a952f0d20e1c98eba3dd901d822163cde62df file=cassandra/verdict.go range=119:127 lang=go exported=true byte_range=5311:5847
  sig=func (v *Verdict) IsGrounded() bool
  doc=IsGrounded reports the evidence-grounding half of Sound: every load-bearing\nclaim in the answer is backed by real executed evidence — grounded AND no\nunverified claims (the hallucination surface is empty). This is the single\ndefinition of "grounded" every consumer (Neo, Cody, Cassandra) shares; the\nhonest-partial gate consults it directly, while Sound composes it with\ncoverage for the full-completion decision.
EDGES
  ^contains=matrix/cassandra.Verdict
  ^defines=matrix/cassandra/verdict.go

NODE id=matrix/cassandra.Verdict.Normalize kind=method
  digest=b3:3ec5eff5ba4b3ca94b5afdbd4bc04443d9a73580d2d17d43a4e85f03b1f7a563 file=cassandra/verdict.go range=66:108 lang=go exported=true byte_range=3282:4815
  sig=func (v *Verdict) Normalize()
  doc=Normalize trims blank list entries and applies the coherence guards\n([verdict.coherence_guards]) that bias every incoherent verdict toward MORE\nwork, never toward a false success ([principles].coherence_toward_more_work,\ninvariant i_cass_7):\n\n	g1 — Coverage=full with a non-empty Missing list -> force Coverage=partial.\n	g2 — Grounded=true with non-empty UnverifiedClaims -> force Grounded=false.\n\nThere is no citation-matching guard: completion is judged by whether the\nOUTCOME satisfies the GOAL over the executed transcript (grounded +\nunverified_claims), never by substring-matching refs the agent typed.
EDGES
  ^contains=matrix/cassandra.Verdict
  ^defines=matrix/cassandra/verdict.go

NODE id=matrix/cassandra.Verdict.Sound kind=method
  digest=b3:c14fdd50f0df8b99196ce61434b064283ab725ceb37a64e70e3c850333f9d745 file=cassandra/verdict.go range=129:137 lang=go exported=true byte_range=5849:6391
  sig=func (v *Verdict) Sound() bool
  doc=Sound reports the full grounded verdict Neo's completion gate consults\n(Phase 3): every deliverable produced AND every load-bearing claim grounded\nin real evidence ([coupling].high_stakes). Stricter than CoverageComplete.\nIt is the single source of truth for verdict acceptance — Neo's\nverdictAccepts and Cody's gate.Adjudicate both decide through it (or through\nIsGrounded for the honest-partial path) rather than re-implementing the rule.
EDGES
  ^contains=matrix/cassandra.Verdict
  ^defines=matrix/cassandra/verdict.go

NODE id=matrix/cassandra.balancedFrom kind=func
  digest=b3:fb52349fea38a1a954c68fc3a2150c5e6d71083b74b02ba60a8b100ec9d80f5b file=cassandra/parse.go range=151:184 lang=go exported=false byte_range=5385:6069
  sig=func balancedFrom(s string, start int) (string, int)
  doc=balancedFrom returns the balanced object starting at s[start]=='{' and the\nindex just past its closing brace. On an unbalanced tail it returns\n("", start). Brace counting is string- and escape-aware.
EDGES
  ^defines=matrix/cassandra/parse.go

NODE id=matrix/cassandra.candidateObjects kind=func
  digest=b3:1f40b83da7aae8501927fc5429fb0c4224812512612c0261ca6dee01957ab260 file=cassandra/parse.go range=129:149 lang=go exported=false byte_range=4737:5383
  sig=func candidateObjects(s string) []string
  doc=candidateObjects returns the balanced top-level {...} objects in s, in order.\nBrace counting ignores braces inside JSON string literals and respects\nbackslash escapes; a nested object is part of its enclosing object, not a\nseparate candidate. Scanning stops at the first unbalanced tail (no complete\nobject can follow an unclosed one).
EDGES
  ^defines=matrix/cassandra/parse.go

