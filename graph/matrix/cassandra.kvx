  digest=b3:cb0d0295c23d697c835aa11e23042e3a9c239783c85deac3c49e5ea22c3c9648 file=cassandra/verdict.go range=46:48 lang=go exported=true byte_range=2239:2424
  sig=[]string
  doc=Missing enumerates still-unsatisfied requested deliverables, phrased as\nconcrete actionable items a re-planner/continuation can turn into work.
EDGES
  ^contains=matrix/cassandra.Verdict

NODE id=matrix/cassandra.Verdict#OpenUnknowns kind=field
  digest=b3:797d84cf86496d30d844870da41f3fa8b8128bd890f525cbc69fb2d828908968 file=cassandra/verdict.go range=55:58 lang=go exported=true byte_range=2736:2999
  sig=[]string
  doc=OpenUnknowns is the absence-as-object field: things NOT confirmed that\nshould have been. An empty list is an explicit, attributable claim of\n"no unknowns", never silence ([principles].make_absence_present).
EDGES
  ^contains=matrix/cassandra.Verdict

NODE id=matrix/cassandra.Verdict#Rationale kind=field
  digest=b3:135c689c517f0fc9e45595bcb3577b14c58064bc19228fb4593bd6cfaaf7b959 file=cassandra/verdict.go range=62:63 lang=go exported=true byte_range=3178:3278
  sig=string
  doc=Rationale is a one-line explanation (audit/transcript only).
