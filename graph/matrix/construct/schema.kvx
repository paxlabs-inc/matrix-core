NODE id=matrix/construct/schema.StateResponse kind=type
  digest=b3:df0e2446887d1627828ff8f2a54a5cee501dc72d007f6670d899e2a1ea697de6 file=construct/schema/state.go range=33:48 lang=go exported=true byte_range=1545:2343
  sig=type StateResponse struct {\n	// ConversationID scopes the response to a single conversation (per-user\n	// isolation; never cross-conversation).\n	ConversationID	string	`json:"conversation_id"`\n	// Frames are the conversation's persisted surface frames, oldest-first,\n	// capped to the retained-frame bound.\n	Frames	[]Frame	`json:"frames"`\n	// LastSeq is the newest frame seq, used as the SSE "since" cursor for\n	// live catch-up after rehydration.\n	LastSeq	int	`json:"last_seq"`\n}
  doc=StateResponse is the body of the rehydration read path\n(GET /construct/state?conversation_id=&since_seq=). It carries a\nconversation's durable surface frames, oldest-first, so a cold-opening shell\nreplays them through the same reducer the live feed uses, plus the newest seq\nfor the SSE catch-up cursor.
EDGES
  contains=matrix/construct/schema.StateResponse#ConversationID,matrix/construct/schema.StateResponse#Frames,matrix/construct/schema.StateResponse#LastSeq
  references=matrix/construct/schema.Frame
  ^references=matrix/construct/internal/codegen.structs,matrix/executor/cmd/mcl-execute.serveConstructState
  ^defines=matrix/construct/schema/state.go

