  sig=func EmitSurface(sink EventSink, intentID, conversationID string, s *schema.Surface) error
  doc=EmitSurface validates and emits a full surface as a construct.surface event.\nintentID/conversationID thread the existing SSE filtering; intentID is also\nwhat the daemon transcript auto-stamps, but we set it explicitly so the\nhelper is correct against any sink. Returns an error only if the surface is\ninvalid (a caller never emits an unvalidated surface — invariant i2).
EDGES
  calls=matrix/construct/schema.Surface.Validate,matrix/construct/transport.surfaceFields
  references=matrix/construct/schema.Surface,matrix/construct/schema.Surface.Validate,matrix/construct/transport.EventSink,matrix/construct/transport.EventSink.Event,matrix/construct/transport.EventSurface,matrix/construct/transport.Phase,matrix/construct/transport.conversationID,matrix/construct/transport.err,matrix/construct/transport.intentID,matrix/construct/transport.s,matrix/construct/transport.sink,matrix/construct/transport.surfaceFields
  ^calls=matrix/executor/cmd/mcl-execute.daemonState.projectConstructEvent,matrix/neo/internal/server.Engine.emitConstructSurface,matrix/neo/internal/server.Engine.respondAsk
  ^references=matrix/executor/cmd/mcl-execute.daemonState.projectConstructEvent,matrix/neo/internal/server.Engine.emitConstructSurface,matrix/neo/internal/server.Engine.respondAsk
  ^defines=matrix/construct/transport/transport.go

