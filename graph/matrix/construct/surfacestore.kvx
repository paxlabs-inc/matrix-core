NODE id=matrix/construct/surfacestore.Store.Record kind=method
  digest=b3:834df03ea63c6d5de0024a00214c224ba2f6682ebc86e22c76c1f4e475d82ea8 file=construct/surfacestore/surfacestore.go range=186:203 lang=go exported=true byte_range=7609:8524
  sig=func (s *Store) Record(conversationID string, fr Frame)
  doc=Record enqueues one surface frame for asynchronous persistence. It NEVER\nblocks (the broker publish path calls it): if the writer queue is saturated,\nthe frame is dropped, exactly like the broker drops events to slow\nsubscribers. A disabled store, a blank conversation id, or a conversation id\ncontaining a path separator is ignored (never persisted) — the latter both\nas input validation and as a path-traversal guard.
EDGES
  ^contains=matrix/construct/surfacestore.Store
  ^defines=matrix/construct/surfacestore/surfacestore.go

