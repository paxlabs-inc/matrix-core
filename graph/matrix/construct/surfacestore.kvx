NODE id=matrix/construct/surfacestore.DefaultRetainedFrames kind=const
  digest=b3:edde81b457bb378338b8fb9df44508c8d5a490fed3ce8f4e61d633863b7292ed file=construct/surfacestore/surfacestore.go range=65:70 lang=go exported=true byte_range=2947:3358
  sig=untyped int
  doc=DefaultRetainedFrames caps how many surface frames are retained per\nconversation on disk. Larger than the broker's live replay buffer because\nthis is the durable record a reopen rebuilds from; still bounded so a runaway\nconversation can't grow the file without limit. It is also the bound the\nrehydration read path returns (R16.4), so cold-open cost is bounded.
EDGES
  ^defines=matrix/construct/surfacestore/surfacestore.go

NODE id=matrix/construct/surfacestore.Dir kind=func
  digest=b3:a0476f2feda573075fe317f51435d2b313aea87ca071983f73e3a9bca15767cb file=construct/surfacestore/surfacestore.go range=447:460 lang=go exported=true byte_range=16103:16674
  sig=func Dir(override, cortexRoot string) string
  doc=Dir resolves the surface-store directory. An explicit override wins; else it\nis derived from the cortex root's parent (matching the conversation, task,\nand trace stores, so the surface record shares the per-user /data volume with\nthem and survives suspend / redeploy). Returns "" when neither is available\n(persistence disabled).
EDGES
  ^defines=matrix/construct/surfacestore/surfacestore.go

NODE id=matrix/construct/surfacestore.Frame kind=type
  digest=b3:520052ec4156c64d156c06af44c7e60ddba248d958563fa74ea4e67041df1aab file=construct/surfacestore/surfacestore.go range=78:89 lang=go exported=true byte_range=3691:4389
  sig=type Frame schema.Frame
  doc=Frame is one persisted Construct surface event. It is an alias of the\ncanonical wire type schema.Frame, which is the single source of truth that\nthe codegen mirrors into the client's types.gen.ts — so the persisted shape\ncan never drift from the generated client type. Its shape mirrors the daemon\nSSE Event ({seq,ts,phase,type,fields}) — and neo/internal/trace.Event — so\nthe persisted stream replays through the client's existing reducer\nbyte-for-byte on a reopen.\n\nPhase is always transport.Phase ("construct"); Type is one of\ntransport.EventSurface ("construct.surface") or transport.EventSurfacePatch\n("construct.surface.patch").
EDGES
  ^defines=matrix/construct/surfacestore/surfacestore.go

NODE id=matrix/construct/surfacestore.Open kind=func
  digest=b3:28db05bca8b089e63a0f0774a0179da9f54d286bbd84ca9456680566a1750e43 file=construct/surfacestore/surfacestore.go range=140:148 lang=go exported=true byte_range=6218:6696
  sig=func Open(dir string) *Store
  doc=Open builds a store rooted at dir (shares the per-user /data volume with the\ncortex, conversation, task, and trace stores) and starts its background\nwriter. An empty dir yields a disabled store (every method is a safe no-op)\nso dev/CLI runs work unchanged. The retained-frame cap defaults to\nDefaultRetainedFrames and can be overridden via CONSTRUCT_SURFACE_RETAIN\n(read once at Open).
EDGES
  ^defines=matrix/construct/surfacestore/surfacestore.go

