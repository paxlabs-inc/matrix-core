NODE id=matrix/construct/backchannel.Answered kind=func
  digest=b3:1dd1bc10d65bff154d664e8ad11206e3bbdea8303e900b6e9831e1112d3bcd50 file=construct/backchannel/backchannel.go range=109:130 lang=go exported=true byte_range=4656:5470
  sig=func Answered(orig *schema.Surface, resp *primitives.AskResponse) (*schema.Surface, error)
  doc=Answered folds a validated response onto a COPY of the original Ask surface,\nreturning a surface suitable for a construct.surface.patch emit: the renderer\nreads Ask.Response and flips from the live control to its settled state. The\noriginal surface is never mutated (the patch is a clean clone).
EDGES
  ^defines=matrix/construct/backchannel/backchannel.go

NODE id=matrix/construct/backchannel.Summarize kind=func
  digest=b3:eecbf116bf3adb092cf878a7d3e05a46b88465e8fd0ab7e95d88024b2f621e7d file=construct/backchannel/backchannel.go range=74:107 lang=go exported=true byte_range=3286:4654
  sig=func Summarize(ask *primitives.Ask, resp *primitives.AskResponse) string
  doc=Summarize renders the human's answer as a short, agent-readable line — the\ntool result the parked agent reads to resume its reasoning. It mirrors the\nclient renderer's settled state so the agent and the screen agree on what\nwas answered. Caller has already validated the response.
EDGES
  ^defines=matrix/construct/backchannel/backchannel.go

NODE id=matrix/construct/backchannel.ValidateResponse kind=func
  digest=b3:b80dac95a958416a09ffd142d1b627589c03c6b93fdc871eab5b8021f8746818 file=construct/backchannel/backchannel.go range=28:72 lang=go exported=true byte_range=1259:3284
  sig=func ValidateResponse(ask *primitives.Ask, resp *primitives.AskResponse) error
  doc=ValidateResponse checks a posted AskResponse against the Ask it answers, per\nthe Ask kind's expected-response contract. It is the trust gate the receiver\nruns BEFORE delivering the answer to the parked agent: a malformed or\noff-contract response is rejected (the run stays parked) rather than feeding\nthe agent garbage. A nil/unknown ask or response is an error.
EDGES
  ^defines=matrix/construct/backchannel/backchannel.go

