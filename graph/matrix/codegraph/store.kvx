NODE id=matrix/codegraph/store.Load kind=func
  digest=b3:6c8b76f1f6a89385fbb043b8530e8c569d17454527ca6bd4c350b3c3769c7d10 file=codegraph/store/load.go range=12:60 lang=go exported=true byte_range=96:1347
  sig=func Load(dir string) (*model.Index, string, error)
  doc=Load reads a whole sharded graph store from dir — every *.kvx shard plus\nmanifest.kvx — and reconstructs the combined Index. merkle.kvx (the repo file\nMerkle tree, not a graph shard) is skipped. The returned merkle is the banner\nroot shared by the shards. Occurrence sites are not serialized, so a loaded\ngraph carries edges without sites — matching what a fresh Write emits.
EDGES
  ^defines=matrix/codegraph/store/load.go

NODE id=matrix/codegraph/store.Parse kind=func
  digest=b3:e81ed07d3f64064ea86e8fd1cf198f983a89832a75af96323b9226c02f70e372 file=codegraph/store/parse.go range=13:73 lang=go exported=true byte_range=98:1762
  sig=func Parse(r io.Reader) (*model.Index, string, error)
  doc=Parse reads a graph-store file and reconstructs the Index plus the Merkle root\ncarried by the banner. Forward and reverse edge lines are both replayed into\nthe index (reverse lines let a per-package shard record edges whose source\nlives in another shard); duplicates collapse.
EDGES
  ^defines=matrix/codegraph/store/parse.go

NODE id=matrix/codegraph/store.Write kind=func
  digest=b3:e00e6c2992a92e1612528dab59e5e6508306386b8d098e440615b1d87b2f80f2 file=codegraph/store/store.go range=23:27 lang=go exported=true byte_range=664:937
  sig=func Write(w io.Writer, ix *model.Index, merkle string) error
  doc=Write serializes every node owned by ix (those added via AddNode) and their\nforward + reverse edges to w, prefixed by the GENERATED banner carrying merkle.
EDGES
  ^defines=matrix/codegraph/store/store.go

NODE id=matrix/codegraph/store.WriteNodes kind=func
  digest=b3:6c74cf25cfe06f151d1c660a5c659fc035fc5630b9a7d7e15c230f42e6ca70f0 file=codegraph/store/store.go range=29:40 lang=go exported=true byte_range=939:1437
  sig=func WriteNodes(w io.Writer, ix *model.Index, nodes []*model.Node, merkle string) error
  doc=WriteNodes serializes a chosen subset of nodes (already sorted by id) using\nix as the global edge index, so a per-package shard still renders the reverse\nedges whose source lives in another shard. The subset must be sorted by id.
EDGES
  ^defines=matrix/codegraph/store/store.go

