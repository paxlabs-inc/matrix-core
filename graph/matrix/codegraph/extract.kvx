NODE id=matrix/codegraph/extract.IncrementalUpdate kind=func
  digest=b3:d6f6ab3ed3208e62c3176d49bddf7962f7b15debe1b5c1a5dba84ad96f217c97 file=codegraph/extract/incremental.go range=29:187 lang=go exported=true byte_range=1072:6264
  sig=func IncrementalUpdate(prior *Extractor, priorTree *merkle.Tree) (*IncrementalResult, error)
  doc=IncrementalUpdate applies a source change to a prior in-memory extraction\nwithout a full rebuild. priorTree is the file Merkle tree captured at the\nprior build (before the change). It:\n\n 1. recomputes the current file tree and diffs it (Requirement 10.1);\n 2. finds the nodes owned by changed/removed files, and via the reverse-edge\n    index the true dependents whose edges must be revalidated (10.3);\n 3. reloads and re-extracts ONLY the affected packages, recomputing their\n    nodes and outgoing edges, and carries every untouched package's nodes and\n    edges over unchanged (10.2);\n 4. recomputes container digests and reports which node digests moved (10.4).\n\nRe-extraction is package-granular because Go type resolution is: a file's\nedges are computed from its type-checked package. Untouched packages are never\nreloaded. This is modular, not whole-program — a change that alters\ninterface-dispatch resolution in an unrelated package is out of scope here and\nis what the full-rebuild equivalence test (task 5.6) guards.
EDGES
  ^defines=matrix/codegraph/extract/incremental.go

NODE id=matrix/codegraph/extract.New kind=func
  digest=b3:304b215aa4f715f385528d111b116d1003e64a9621c1218d2e15fb84a1cf18d4 file=codegraph/extract/extract.go range=44:53 lang=go exported=true byte_range=1336:1596
  sig=func New(cfg Config) *Extractor
  doc=New returns an Extractor writing into a fresh Index.
EDGES
  ^defines=matrix/codegraph/extract/extract.go

NODE id=matrix/codegraph/extract.RepoFiles kind=func
  digest=b3:389146f46aa9f0dc88c0db2a47afab2714a6fc933371eb67dc59f247b0610a76 file=codegraph/extract/files.go range=11:56 lang=go exported=true byte_range=89:1389
  sig=func RepoFiles(cfg Config) (map[string][]byte, error)
  doc=RepoFiles returns the canonical source-file set the graph is built over:\nevery non-test .go file under the configured module dirs, keyed by repo-\nrelative slash path -> raw bytes. It skips _test.go files and the vendor,\ntestdata, node_modules, and .git trees — the same set go/packages loads for a\nnon-test build — so the file Merkle tree computed from it stays in lockstep\nwith the extracted graph across full and incremental builds.
EDGES
  ^defines=matrix/codegraph/extract/files.go

