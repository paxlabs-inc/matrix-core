NODE id=matrix/codegraph/enrich.salienceEMARate kind=const
  digest=b3:d279b6f20fb0d77bb7d60fa68da4b76fab0eb65d8040830ed4c0bcee5aeccd8a file=codegraph/enrich/salience.go range=9:15 lang=go exported=false byte_range=63:504
  sig=untyped float
  doc=salienceEMARate mirrors cortex/salience.EMARate (§8.3): the exponential\nmoving-average alpha used to fold a fresh observation into the running\nsalience so the signal tracks structure without whipsawing. Kept as a local\nconstant so the codegraph module stays free of the cortex store/Pebble\ndependency that the salience package pulls in; the value is intentionally\nidentical to the substrate's.
EDGES
  ^defines=matrix/codegraph/enrich/salience.go

NODE id=matrix/codegraph/enrich.salienceEdges kind=var
  digest=b3:d773e1d64e81219795e627ed0f4f6673a5bb675bdefea7f9e4b1d0f254987d88 file=codegraph/enrich/salience.go range=17:21 lang=go exported=false byte_range=506:864
  sig=[]model.EdgeType
  doc=salienceEdges are the incoming edge types whose fan-in defines a node's graph\nsalience: how many symbols call it, reference it, or (for an interface)\nimplement it. High fan-in ⇒ central ⇒ salient. This mirrors the impact/blast-\nradius edge set.
EDGES
  ^defines=matrix/codegraph/enrich/salience.go

NODE id=matrix/codegraph/enrich.salienceGain kind=const
  digest=b3:e0676895f54a0afca76270d53f32d35520c5b4c7941630f850a5025bdabd4368 file=codegraph/enrich/cortexidx.go range=53:56 lang=go exported=false byte_range=1781:2029
  sig=untyped float
  doc=salienceGain scales how strongly graph salience boosts a semantic hit's\nscore. Small and monotonic: it re-ranks near-ties toward higher-salience\nnodes (Requirement 7.2) without overriding clear semantic proximity.
EDGES
  ^defines=matrix/codegraph/enrich/cortexidx.go

