  sig=func embedText(n *model.Node) string
  doc=embedText is what gets embedded for a node: its one-line summary plus its\nsignature. Both are compact, already-public graph fields — never raw source.
EDGES
  ^defines=matrix/codegraph/enrich/embed.go

