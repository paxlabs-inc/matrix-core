  ^defines=matrix/codegraph/enrich/enrich.go

NODE id=matrix/codegraph/enrich.summaryStale kind=func
  digest=b3:a5f3139f956acb1f28bf318066f74b0f969c3947b8974afc49683f4144f6a2c2 file=codegraph/enrich/summarize.go range=16:22 lang=go exported=false byte_range=337:750
  sig=func summaryStale(n *model.Node) bool
  doc=summaryStale reports whether a node needs a fresh summary: it has no summary\nyet, or its cached summary was derived from a different digest (its body\nmoved). A node whose summary_digest equals its current digest is reused\n(Requirement 8.2); a mismatch is treated as stale (Requirement 8.4).
EDGES
  ^defines=matrix/codegraph/enrich/summarize.go

