NODE id=matrix/codegraph/enrich.Enricher.Embed kind=method
  digest=b3:2c1175a0121784eb1b367de8239a3e809372e886bce5c48dd872325354357d59 file=codegraph/enrich/embed.go range=51:132 lang=go exported=true byte_range=1651:3820
  sig=func (e *Enricher) Embed(ctx context.Context, ix *model.Index) (EmbedStats, error)
  doc=Embed embeds (summary + signature) for every enrichable node whose embedding\nis stale, indexes each vector in the cortex HNSW under namespace codegraph\nweighted by graph salience, and reuses cached embeddings for unchanged\ndigests. It refreshes every enrichable node's graph salience (EMA-blended)\neach pass, since salience tracks graph structure independently of a node's\nown digest. It writes only Enrich.EmbedRef and Enrich.Salience — never a\nstructural field (Requirements 8.1, 9.1, 9.2, 10.4).\n\nNodes are processed in id-sorted, batched order so the pass is deterministic.
EDGES
  ^contains=matrix/codegraph/enrich.Enricher
  ^defines=matrix/codegraph/enrich/embed.go

NODE id=matrix/codegraph/enrich.Enricher.Summarize kind=method
  digest=b3:95ec3870597013426efec8c8837306214f4487954645ba0ebe832cad66bc4014 file=codegraph/enrich/summarize.go range=24:81 lang=go exported=true byte_range=752:2191
  sig=func (e *Enricher) Summarize(ctx context.Context, ix *model.Index) (SummaryStats, error)
  doc=Summarize generates one-line summaries for every enrichable node whose\nsummary is stale, batching them through the Summarizer keyed on node digest,\nand reusing cached summaries for unchanged digests. It writes only\nEnrich.Summary and Enrich.SummaryDigest — never a structural field\n(Requirements 8.1, 8.2, 8.3, 8.4). Nodes are processed in id-sorted order so\nthe pass is deterministic.
EDGES
  ^contains=matrix/codegraph/enrich.Enricher
  ^defines=matrix/codegraph/enrich/summarize.go

