NODE id=matrix/codegraph/enrich.embedRef kind=func
  digest=b3:126d54553e9aa5d9b89abc15a32d7bf6a51a031b5b3317cebe296e8ac8cc7a2f file=codegraph/enrich/embed.go range=45:49 lang=go exported=false byte_range=1272:1649
  sig=func embedRef(id, digest string) string
  doc=embedRef is the digest-stamped reference recorded on a node, pointing at its\nentry in the codegraph vector namespace. Stamping the digest makes the\nreference change exactly when the embedded content moves, so a stale\nembedding is detectable by comparison alone (see embedStale).
EDGES
  ^defines=matrix/codegraph/enrich/embed.go

NODE id=matrix/codegraph/enrich.embedStale kind=func
  digest=b3:b3f3807a6d8e2b23d43322a31ba977cd4aaa651ab1b278d42d3d0eab6f523fa4 file=codegraph/enrich/embed.go range=17:24 lang=go exported=false byte_range=355:834
  sig=func embedStale(n *model.Node) bool
  doc=embedStale reports whether a node needs a fresh embedding: its recorded\nembed reference does not match the reference its current digest would\nproduce. Because the reference is digest-stamped (see embedRef), this is true\nexactly when the node has never been embedded or its content moved — so the\npass re-embeds only nodes whose digest changed (Requirements 8.2, 10.4).
EDGES
  ^defines=matrix/codegraph/enrich/embed.go

NODE id=matrix/codegraph/enrich.embedText kind=func
