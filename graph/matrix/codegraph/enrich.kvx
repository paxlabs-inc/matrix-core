NODE id=matrix/codegraph/enrich.computeSalience kind=func
  digest=b3:59d2b1e1fee7532e4125e04aec007d4488d4667fe06c5f33a93f9d1f6f6ff5e5 file=codegraph/enrich/salience.go range=23:51 lang=go exported=false byte_range=866:1578
  sig=func computeSalience(ix *model.Index) map[string]float64
  doc=computeSalience returns a normalized [0,1] graph salience for every\nenrichable node, derived from log-scaled reverse-edge fan-in over\nsalienceEdges and normalized by the graph's maximum. Deterministic: a pure\nfunction of the index's edges.
EDGES
  ^defines=matrix/codegraph/enrich/salience.go

