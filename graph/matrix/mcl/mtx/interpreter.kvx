NODE id=matrix/mcl/mtx/interpreter.ExtractKindValue kind=func
  digest=b3:3841332782d09ec329e62d57680af4f5464a61753f94323a5f65689c3f2742ae file=MCL/mtx/interpreter/interpreter.go range=406:421 lang=go exported=true byte_range=13128:13744
  sig=func ExtractKindValue(v ast.Value) string
  doc=ExtractKindValue returns the wire-form text of a `kind = ...` value\nnode from an on-block KVPair. Accepts both quoted strings (the\ncanonical form) and bare identifiers (an ergonomic short-hand that\nmirrors how `verb=` is written in conditions). Returns "" for\nunsupported value types (number, bool, list, URI) so the validator's\nV11 rule can flag the call site instead of silently dropping a\nmalformed annotation.
EDGES
  references=matrix/mcl/mtx/ast.IdentValue,matrix/mcl/mtx/ast.StringValue,matrix/mcl/mtx/ast.Value,matrix/mcl/mtx/interpreter.v,matrix/mcl/mtx/interpreter.x
  ^calls=matrix/executor/cmd/mcl-execute.extractOnBlockHints,matrix/mcl/mtx/interpreter.Interpreter.execOnBlock
  ^references=matrix/executor/cmd/mcl-execute.extractOnBlockHints,matrix/mcl/mtx/interpreter.Interpreter.execOnBlock,matrix/mcl/mtx/validator.validator.rule11OnBlockStepKind
  ^defines=matrix/mcl/mtx/interpreter/interpreter.go

NODE id=matrix/mcl/mtx/interpreter.ExtractPositiveIntValue kind=func
  digest=b3:51ee11c9fd877e13e4d792ce878d9840c53ae6d480a8905710b17605616c1517 file=MCL/mtx/interpreter/interpreter.go range=423:439 lang=go exported=true byte_range=13746:14360
  sig=func ExtractPositiveIntValue(v ast.Value) (int, bool)
  doc=ExtractPositiveIntValue returns the integer value of an *ast.IntValue\nnode when it parses cleanly and is strictly positive. Returns\n(0, false) otherwise. Used by the on-block `output_cardinality = <N>`\nmetadata KV (Session 31c P3c). Strict positivity matches the\nvalidator's V12 contract and prevents zero/negative values from\nsilently disabling the planner hint.
EDGES
  references=matrix/mcl/mtx/ast.IntValue,matrix/mcl/mtx/ast.Value,matrix/mcl/mtx/interpreter.err,matrix/mcl/mtx/interpreter.iv,matrix/mcl/mtx/interpreter.n,matrix/mcl/mtx/interpreter.ok,matrix/mcl/mtx/interpreter.v
  ^calls=matrix/executor/cmd/mcl-execute.extractOnBlockHints,matrix/mcl/mtx/interpreter.Interpreter.execOnBlock
  ^references=matrix/executor/cmd/mcl-execute.extractOnBlockHints,matrix/mcl/mtx/interpreter.Interpreter.execOnBlock,matrix/mcl/mtx/validator.validator.rule12OnBlockOutputCardinality
  ^defines=matrix/mcl/mtx/interpreter/interpreter.go

