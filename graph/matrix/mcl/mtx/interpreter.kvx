  sig=type RunResult struct {\n	// FrameJSON is the raw JSON output from the LLM (if a prompt was executed).\n	FrameJSON	string\n\n	// PromptMessages are the interpolated messages sent to the LLM.\n	PromptMessages	[]Message\n\n	// Slots is the final state of all input slots.\n	Slots	map[string]*Slot\n\n	// Unknowns are declared gaps from unknown blocks.\n	Unknowns	[]*Unknown\n\n	// ClarifyQuestions are questions from clarify blocks.\n	ClarifyQuestions	[]*ClarifyQuestion\n\n	// MatchedCondition describes which on-block condition matched (for audit).\n	MatchedCondition	string\n\n	// Executed is true if an on-block matched and its entries were executed.\n	Executed	bool\n\n	// StepKindHint is the value of the `kind = "<value>"` KVPair from\n	// the matched on-block, if present. Empty when the skill does not\n	// declare a kind hint (the common case for the 159 bulk-converted\n	// fixtures). Routes to llm.KindReason at executor time.\n	//\n	// Session 31b model router (P2b). The hint surfaces here for audit\n	// and for the synthesizer's system prompt; the planner LLM consumes\n	// the SKILL.mtx body directly and emits the corresponding\n	// ir.StepPayload.Kind in plan_tree@1 output.\n	StepKindHint	string\n\n	// OutputCardinalityHint is the value of the `output_cardinality = <N>`\n	// KVPair from the matched on-block (positive integer). Tells the\n	// planner LLM that this verb's procedure produces N independent items\n	// per invocation and should be folded into a single multi-output\n	// step (or into a parallel{} fan-out with N children) rather than\n	// emitting N sequential step nodes. Zero / absent leaves the planner\n	// free to choose the shape (default = single step or LLM-driven\n	// expansion).\n	//\n	// Session 31c model router (P3c). The hint surfaces here for audit\n	// and is forwarded into the planner system prompt by the executor.\n	OutputCardinalityHint	int\n}
  doc=RunResult is what the interpreter produces after walking §PROCEDURE.
EDGES
  contains=matrix/mcl/mtx/interpreter.RunResult#ClarifyQuestions,matrix/mcl/mtx/interpreter.RunResult#Executed,matrix/mcl/mtx/interpreter.RunResult#FrameJSON,matrix/mcl/mtx/interpreter.RunResult#MatchedCondition,matrix/mcl/mtx/interpreter.RunResult#OutputCardinalityHint,matrix/mcl/mtx/interpreter.RunResult#PromptMessages,matrix/mcl/mtx/interpreter.RunResult#Slots,matrix/mcl/mtx/interpreter.RunResult#StepKindHint,matrix/mcl/mtx/interpreter.RunResult#Unknowns
  references=matrix/mcl/mtx/interpreter.ClarifyQuestion,matrix/mcl/mtx/interpreter.Message,matrix/mcl/mtx/interpreter.Slot,matrix/mcl/mtx/interpreter.Unknown
  ^references=matrix/executor/cmd/mcl-e2e.buildIntentFromRun,matrix/executor/cmd/mcl-execute.buildIntent,matrix/executor/cmd/mcl-execute.compile,matrix/mcl/mtx/interpreter.Interpreter.Run,matrix/mcl/mtx/interpreter.Interpreter.evalCondition,matrix/mcl/mtx/interpreter.Interpreter.execClarify,matrix/mcl/mtx/interpreter.Interpreter.execOnBlock,matrix/mcl/mtx/interpreter.Interpreter.execPrompt,matrix/mcl/mtx/interpreter.Interpreter.execResolve,matrix/mcl/mtx/interpreter.Interpreter.execUnknown,matrix/mcl/mtx/interpreter.Interpreter.formatSlots,matrix/mcl/mtx/interpreter.Interpreter.formatUnknowns,matrix/mcl/mtx/interpreter.Interpreter.initSlots,matrix/mcl/mtx/interpreter.Interpreter.interpolate,matrix/mcl/mtx/interpreter.Interpreter.interpolateValue,matrix/mcl/mtx/interpreter.Interpreter.resolveVar
