NODE id=matrix/mcl/llm.New kind=func
  digest=b3:66f4c0df1684f07fd14e0562e3cdfb00c38cd23a9d61c287d33a1fc8df0debb4 file=MCL/llm/llm.go range=306:394 lang=go exported=true byte_range=11059:13411
  sig=func New(cfg *Config) (interpreter.LLM, error)
  doc=New creates an LLM client for the configured endpoint shape.\n\nDispatch (Session 34 / Forge Phase 1):\n\n	cfg.Endpoint suffix → APIShape   → returned concrete type\n	/v1/chat/completions  Chat        *Client\n	/v1/messages          Messages    *messagesClient (Anthropic Messages API)\n	/v1/responses         Responses   *responsesClient (OpenAI Responses API)\n\nFalls back to ShapeChatCompletions when the suffix is unrecognized,\npreserving the legacy contract verbatim (Together + Fireworks paths\npre-sess#34 keep working with no caller changes).\n\nReturns an interpreter.LLM (the streaming capability is opt-in via\ntype assertion to interpreter.StreamingLLM, which all three concrete\ntypes implement).\n\nThe provided *Config is copied into the returned client and may be\nreused or discarded by the caller after the call returns.
EDGES
  calls=matrix/mcl/llm.DetectAPIShape,matrix/mcl/llm.DetectProvider,matrix/mcl/llm.defaultEndpoint,matrix/mcl/llm.envKey,matrix/mcl/llm.newMessagesClient,matrix/mcl/llm.newResponsesClient
  references=matrix/mcl/llm.Client,matrix/mcl/llm.Config,matrix/mcl/llm.DetectAPIShape,matrix/mcl/llm.DetectProvider,matrix/mcl/llm.Provider,matrix/mcl/llm.ShapeChatCompletions,matrix/mcl/llm.ShapeMessages,matrix/mcl/llm.ShapeResponses,matrix/mcl/llm.ShapeUnknown,matrix/mcl/llm.apiKey,matrix/mcl/llm.cfg,matrix/mcl/llm.defaultEndpoint,matrix/mcl/llm.endpoint,matrix/mcl/llm.envKey,matrix/mcl/llm.err,matrix/mcl/llm.httpClient,matrix/mcl/llm.key,matrix/mcl/llm.local,matrix/mcl/llm.newMessagesClient,matrix/mcl/llm.newResponsesClient,matrix/mcl/llm.p,matrix/mcl/llm.provider,matrix/mcl/llm.shape,matrix/mcl/mtx/interpreter.LLM
  ^calls=matrix/bridge/cmd/mclc-cortex.run,matrix/codegraph/enrich.NewCody,matrix/executor/cmd/mcl-e2e.RunCompile,matrix/executor/cmd/mcl-execute.compile,matrix/executor/cmd/mcl-execute.daemonState.callLiaison,matrix/executor/cmd/mcl-execute.daemonState.critiquePlan,matrix/executor/cmd/mcl-execute.llmStepHandler.clientFor,matrix/executor/cmd/mcl-execute.synthesize,matrix/mcl/cmd/mclc.cmdCompile,matrix/mcl/llm.NewChatClient
  ^references=matrix/bridge/cmd/mclc-cortex.run,matrix/codegraph/enrich.NewCody,matrix/executor/cmd/mcl-e2e.RunCompile,matrix/executor/cmd/mcl-execute.compile,matrix/executor/cmd/mcl-execute.daemonState.callLiaison,matrix/executor/cmd/mcl-execute.daemonState.critiquePlan,matrix/executor/cmd/mcl-execute.llmStepHandler.clientFor,matrix/executor/cmd/mcl-execute.synthesize,matrix/mcl/cmd/mclc.cmdCompile,matrix/mcl/llm.NewChatClient
