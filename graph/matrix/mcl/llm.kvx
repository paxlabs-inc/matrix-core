  sig=func DefaultRegistry() *ModelRegistry
  doc=DefaultRegistry returns the v1 router populated per the matrix.kvx\nSession 31a model router design. Models pinned to xAI for the primary path\n(grok-4.3 via api.x.ai; matches MCL/llm provider detection, which resolves\nthe bare "grok-*" shape to xAI). Together/Fireworks/Baseten remain reachable\nas explicit alt paths the gateway may select on 5xx or latency-budget breach.\n\nProvider-specific model ID conventions:\n\n	xAI:       "grok-*"           (e.g. "grok-4.3")\n	Baseten:   "<vendor>/<name>"  (e.g. "moonshotai/Kimi-K2")\n	Fireworks: "accounts/fireworks/models/<name>"
EDGES
  calls=matrix/mcl/llm.DefaultGrammars,matrix/mcl/llm.ModelRegistry.Register,matrix/mcl/llm.NewModelRegistry
  references=matrix/mcl/llm.Config,matrix/mcl/llm.DefaultGrammars,matrix/mcl/llm.GrammarJSONSchema,matrix/mcl/llm.GrammarNone,matrix/mcl/llm.KindClassify,matrix/mcl/llm.KindCode,matrix/mcl/llm.KindHardReason,matrix/mcl/llm.KindReason,matrix/mcl/llm.KindSummarize,matrix/mcl/llm.KindTransform,matrix/mcl/llm.KindWrite,matrix/mcl/llm.ModelRegistry,matrix/mcl/llm.ModelRegistry.Register,matrix/mcl/llm.NewModelRegistry,matrix/mcl/llm.RouteKey,matrix/mcl/llm.SlotCompiler,matrix/mcl/llm.SlotExecutor,matrix/mcl/llm.SlotLiaison,matrix/mcl/llm.SlotPlanner,matrix/mcl/llm.compiler,matrix/mcl/llm.compilerLongCtx,matrix/mcl/llm.executorClassify,matrix/mcl/llm.executorCode,matrix/mcl/llm.executorHardReason,matrix/mcl/llm.executorReason,matrix/mcl/llm.executorSummarize,matrix/mcl/llm.executorTransform,matrix/mcl/llm.executorWrite,matrix/mcl/llm.grammars,matrix/mcl/llm.liaison,matrix/mcl/llm.planner,matrix/mcl/llm.plannerLongCtx,matrix/mcl/llm.reg
  ^calls=matrix/executor/cmd/mcl-execute.daemonState.callLiaison,matrix/executor/cmd/mcl-execute.newLLMStepHandlerOpts,matrix/mcl/llm.DefaultCompilerModel,matrix/mcl/llm.DefaultExecutorModel,matrix/mcl/llm.DefaultPlannerModel
