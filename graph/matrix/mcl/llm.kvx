NODE id=matrix/mcl/llm.Config#InjectIdentity kind=field
  digest=b3:f79ae0e9525fc1621cddf292732d0efd0a05490be87a4bfd6692353a68b6b57e file=MCL/llm/llm.go range=235:243 lang=go exported=true byte_range=8492:8978
  sig=bool
  doc=InjectIdentity, when true, prepends llm.IdentityPreamble as the\nFIRST system message at every Decode + Stream call. The Forge\nself-maintenance posture (matrix.kvx sess#34) requires every\nfrontier-model invocation to be reminded that it IS Matrix and\nits sole purpose is to optimize the codebase at /root/matrix.\n\nDefaults to false (legacy paths preserved byte-identically).\nForgeRegistry() in model.go sets this to true on every route.
EDGES
  ^contains=matrix/mcl/llm.Config

