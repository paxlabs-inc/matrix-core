NODE id=matrix/mcl/llm.parseMessagesSSEStream kind=func
  digest=b3:52b8bfc626cd1a1ca6c276a78d006d17c5082ca0dcbb3c6dc9108896f75d0986 file=MCL/llm/messages_api.go range=302:372 lang=go exported=false byte_range=10834:13216
  sig=func parseMessagesSSEStream(ctx context.Context, r io.Reader, provider Provider,\n	onDelta func(delta string)) (string, error)
  doc=parseMessagesSSEStream consumes an Anthropic-shaped SSE stream and\ninvokes onDelta for each text_delta fragment. Returns the accumulated\ntext on message_stop or EOF.\n\nThe Anthropic SSE framing differs from OpenAI's in two important ways:\n  - Each event has both `event:` and `data:` lines (OpenAI uses data: only).\n  - Text fragments arrive as `content_block_delta` events whose JSON payload\n    looks like {"type":"content_block_delta","index":0,"delta":{"type":"text_delta","text":"..."}}.\n    Other event types (message_start, content_block_start, message_delta,\n    message_stop, ping) are accepted and ignored for text accumulation.
EDGES
  references=matrix/mcl/llm.Provider,matrix/mcl/llm.ctx,matrix/mcl/llm.err,matrix/mcl/llm.frame,matrix/mcl/llm.line,matrix/mcl/llm.messagesStreamFrame,matrix/mcl/llm.onDelta,matrix/mcl/llm.payload,matrix/mcl/llm.provider,matrix/mcl/llm.r,matrix/mcl/llm.sb,matrix/mcl/llm.scanner
  ^calls=matrix/mcl/llm.messagesClient.Stream
  ^references=matrix/mcl/llm.messagesClient.Stream
  ^defines=matrix/mcl/llm/messages_api.go

NODE id=matrix/mcl/llm.parseResponsesSSEStream kind=func
  digest=b3:4bdcec4080c905500956052c4909a0b1b29c867494f9d78c941e5a528e4198a7 file=MCL/llm/responses_api.go range=365:436 lang=go exported=false byte_range=12306:14561
  sig=func parseResponsesSSEStream(ctx context.Context, r io.Reader, provider Provider,\n	onDelta func(delta string)) (string, error)
  doc=parseResponsesSSEStream consumes an OpenAI-Responses-shaped SSE stream\nand invokes onDelta for each response.output_text.delta event. Returns\nthe accumulated text on response.completed or EOF.\n\nThe Responses SSE framing differs from chat-completions:\n  - Each event has both `event:` and `data:` lines (chat-completions uses\n    data: only). We rely on the data: line's `type` field exclusively.\n  - Text fragments arrive as `response.output_text.delta` events whose\n    JSON payload carries a top-level `delta` STRING field (not nested).\n  - response.completed signals end-of-stream; we also accept EOF and\n    [DONE] sentinels for proxy compatibility.
EDGES
  references=matrix/mcl/llm.Provider,matrix/mcl/llm.ctx,matrix/mcl/llm.err,matrix/mcl/llm.frame,matrix/mcl/llm.line,matrix/mcl/llm.onDelta,matrix/mcl/llm.payload,matrix/mcl/llm.provider,matrix/mcl/llm.r,matrix/mcl/llm.responsesStreamFrame,matrix/mcl/llm.sb,matrix/mcl/llm.scanner
  ^calls=matrix/mcl/llm.responsesClient.Stream
  ^references=matrix/mcl/llm.responsesClient.Stream
  ^defines=matrix/mcl/llm/responses_api.go

NODE id=matrix/mcl/llm.parseSSEStream kind=func
  digest=b3:53e3bc60eeabc9fc1fa6201e343394ebda22f3f6f4b874e97ad09b739613059d file=MCL/llm/llm.go range=684:759 lang=go exported=false byte_range=24562:27105
  sig=func parseSSEStream(ctx context.Context, r io.Reader, provider Provider,\n	onDelta func(delta string)) (string, error)
  doc=parseSSEStream consumes an OpenAI-compatible text/event-stream body\nemitting onDelta(content) for each chunk and returning the full\naccumulated text on `data: [DONE]` or EOF. Exported for testing\n(parseSSEStreamForTest).\n\nThe OpenAI streaming framing is one event per `data: <json>\\n\\n`\nblock; we tolerate both LF and CRLF line endings and drop any\nnon-data lines (event:, id:, retry:, comments) as the chat\ncompletions schema only carries data frames.
EDGES
  references=matrix/mcl/llm.Provider,matrix/mcl/llm.ctx,matrix/mcl/llm.delta,matrix/mcl/llm.err,matrix/mcl/llm.frame,matrix/mcl/llm.line,matrix/mcl/llm.onDelta,matrix/mcl/llm.payload,matrix/mcl/llm.provider,matrix/mcl/llm.r,matrix/mcl/llm.sb,matrix/mcl/llm.scanner,matrix/mcl/llm.streamFrame
  ^calls=matrix/mcl/llm.Client.Stream
  ^references=matrix/mcl/llm.Client.Stream
  ^defines=matrix/mcl/llm/llm.go

NODE id=matrix/mcl/llm.reasoningEffort kind=func
  digest=b3:623360aef830b99196820350311d537678aa81085f70c5723d9a73c3b89f1fdb file=MCL/llm/llm.go range=844:854 lang=go exported=false byte_range=30320:30758
  sig=func reasoningEffort(enabled bool) string
  doc=reasoningEffort maps the per-role EnableThinking flag onto xAI's\nreasoning_effort enum: reasoning ON → "medium" (balanced reasoning that keeps\ngrok-4.3 answering in the visible content channel rather than exhausting the\nturn on chain-of-thought), OFF → "none" (disables reasoning entirely for\ntoken-tight mechanical roles).
EDGES
  references=matrix/mcl/llm.enabled
  ^calls=matrix/mcl/llm.Client.buildRequest
  ^references=matrix/mcl/llm.Client.buildRequest
  ^defines=matrix/mcl/llm/llm.go

