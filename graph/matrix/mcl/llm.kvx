NODE id=matrix/mcl/llm.IdentityModelDigestSuffix kind=func
  digest=b3:38c91d886582950f82d8aba2c077ac7fe75caa77c9f0c2342976e1401a5c9da3 file=MCL/llm/identity.go range=78:92 lang=go exported=true byte_range=3853:4452
  sig=func IdentityModelDigestSuffix(cfg Config) string
  doc=IdentityModelDigestSuffix returns the suffix to append to a model's\ndigest string when computing compile-cache keys for Identity-injected\nroutes. Use:\n\n	digest := "claude-opus-4-7@opencode" + llm.IdentityModelDigestSuffix(cfg)\n\nReturns "" when cfg.InjectIdentity is false (legacy callers unaffected).\nReturns "+identity=<IdentityVersion>" when true. Caller composes this\ninto the digest string passed to compilecache.Key per sess#31d S31dQ2.
EDGES
  references=matrix/mcl/llm.Config,matrix/mcl/llm.IdentityVersion,matrix/mcl/llm.cfg
  ^defines=matrix/mcl/llm/identity.go

NODE id=matrix/mcl/llm.IdentityPreamble kind=const
  digest=b3:a3515e4fb44f30c04ff0e3cd7390ed26b2687547c4ec198dea45aa5de0dda854 file=MCL/llm/identity.go range=40:43 lang=go exported=true byte_range=1974:2453
  sig=untyped string
  doc=IdentityPreamble is the system-message text injected at every Decode +\nStream call when Config.InjectIdentity is true. Locked verbatim by Andrew\n2026-05-27 (matrix.kvx sess#34). Edits MUST also bump IdentityVersion.
EDGES
  ^references=matrix/mcl/llm.InjectIdentity
  ^defines=matrix/mcl/llm/identity.go

NODE id=matrix/mcl/llm.IdentityVersion kind=const
  digest=b3:746a1044e0bd235fe70443f35a9146c475c9b64b14afd76261c16d7e87a07f18 file=MCL/llm/identity.go range=33:38 lang=go exported=true byte_range=1564:1972
  sig=untyped string
  doc=IdentityVersion identifies the IdentityPreamble revision. Bumped whenever\nthe preamble text changes; mixed into model_digest by callers so the\ncompile-cache (sess#31d) invalidates cleanly across preamble migrations.\nReplay byte-identity (cortex §13.4) is preserved across the bump because\ncached entries with stale version simply miss + recompute.
EDGES
  ^references=matrix/mcl/llm.IdentityModelDigestSuffix
  ^defines=matrix/mcl/llm/identity.go

NODE id=matrix/mcl/llm.InjectIdentity kind=func
  digest=b3:d5c0a484a2e1f325c47c1e5d0bc34e9f3fcdb3c3c03f35706be277598f54fbe8 file=MCL/llm/identity.go range=45:65 lang=go exported=true byte_range=2455:3414
  sig=func InjectIdentity(messages []interpreter.Message) []interpreter.Message
  doc=InjectIdentity prepends IdentityPreamble as the FIRST system message of\nthe returned slice. If messages already begins with a system role, the\npreamble is prepended as a SECOND system message ahead of it — both\nproviders (Anthropic Messages, OpenAI Responses, OpenAI Chat Completions)\naccept multiple system messages and concatenate them in declaration order.\n\nPure: the input slice is not mutated; the returned slice is freshly\nallocated with len(messages)+1 elements.\n\nCallers MUST honor Config.InjectIdentity — passing this helper through\nunconditionally would break legacy paths (e.g. mcl-e2e harness assertions\non exact wire bytes pre-sess#34).
EDGES
  references=matrix/mcl/llm.IdentityPreamble,matrix/mcl/llm.messages,matrix/mcl/llm.out,matrix/mcl/mtx/interpreter.Message
  ^calls=matrix/mcl/llm.maybeInjectIdentity
  ^references=matrix/mcl/llm.maybeInjectIdentity
  ^defines=matrix/mcl/llm/identity.go

