NODE id=matrix/mcl/llm.messagesClient.Stream kind=method
  digest=b3:71ee111b56ac6f47959fdd541d87c1009ed7c91cc3fec275b341952149c34fef file=MCL/llm/messages_api.go range=157:201 lang=go exported=true byte_range=5374:6938
  sig=func (c *messagesClient) Stream(ctx context.Context, messages []interpreter.Message,\n	grammar string, onDelta func(delta string)) (string, error)
  doc=Stream sends a Messages request with stream:true, parses the SSE event\nstream, and invokes onDelta for each text_delta fragment. Returns the\nfully accumulated text on message_stop or EOF.\n\nonDelta MUST NOT be invoked after Stream returns. onDelta == nil is\npermitted; the stream still drains.
EDGES
  calls=matrix/mcl/llm.maybeInjectIdentity,matrix/mcl/llm.messagesClient.buildRequest,matrix/mcl/llm.messagesClient.dispatchHeaders,matrix/mcl/llm.messagesClient.newHTTPRequest,matrix/mcl/llm.parseMessagesSSEStream,matrix/mcl/llm.truncate
