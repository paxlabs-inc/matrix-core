NODE id=matrix/mcl/llm.SlotLiaison kind=const
  digest=b3:0144ea084446d4b7c6faf44bfc243587eca5b1e76c37de25f6aa6555e6a96b73 file=MCL/llm/model.go range=56:63 lang=go exported=true byte_range=2290:2784
  sig=llm.ModelSlot
  doc=SlotLiaison is the user-facing conversational agent ("the Liaison").\nIt narrates the compiler/planner/executor pipeline to the human in\nnatural language, fields chat replies + clarifications, and composes\nthe final answer. It is a pure observability SIDE-CHANNEL: it never\nwrites cortex, signs envelopes, or touches the plan/walk, so it\ncannot perturb the D11 replay byte-identity invariant. Free-form\nprose output (GrammarNone); warmth over determinism.
EDGES
  ^references=matrix/executor/cmd/mcl-execute.daemonState.callLiaison,matrix/mcl/llm.DefaultRegistry,matrix/mcl/llm.ForgeRegistry,matrix/mcl/llm.ModelSlot.String
