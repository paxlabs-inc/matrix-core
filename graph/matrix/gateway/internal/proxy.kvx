NODE id=matrix/gateway/internal/proxy.Server.maybeDebit kind=method
  digest=b3:5918f9e40f579010f06df6e0486f088593df726e2dad06d611fe01a1a7a74695 file=gateway/internal/proxy/proxy.go range=486:538 lang=go exported=false byte_range=15006:17090
  sig=func (s *Server) maybeDebit(dec *routing.Decision, usage *types.UpstreamUsage, lc ledgerCtx) (string, error)
  doc=maybeDebit prices the call + writes a ledger row, returning the\ncost-pax string for response-header stamping. BYO calls return ""\n(no debit; caller pays direct). Errors are logged but not returned\nto the client (the call already succeeded upstream — losing the\nledger row is preferable to a confusing client-side error).
EDGES
  calls=matrix/gateway/internal/ledger.Memory.Record,matrix/gateway/internal/ledger.Postgres.Record,matrix/gateway/internal/rates.Cost
  references=matrix/gateway/internal/ledger.Entry,matrix/gateway/internal/ledger.Ledger.Record,matrix/gateway/internal/proxy.Server,matrix/gateway/internal/proxy.cancel,matrix/gateway/internal/proxy.cost,matrix/gateway/internal/proxy.dec,matrix/gateway/internal/proxy.entry,matrix/gateway/internal/proxy.err,matrix/gateway/internal/proxy.lc,matrix/gateway/internal/proxy.ledgerCtx,matrix/gateway/internal/proxy.recCtx,matrix/gateway/internal/proxy.s,matrix/gateway/internal/proxy.usage,matrix/gateway/internal/rates.Cost,matrix/gateway/internal/rates.RateTableVersion,matrix/gateway/internal/routing.Decision,matrix/gateway/internal/types.UpstreamUsage
  ^contains=matrix/gateway/internal/proxy.Server
  ^calls=matrix/gateway/internal/proxy.Server.handleBuffered,matrix/gateway/internal/proxy.Server.handleStreaming
  ^references=matrix/gateway/internal/proxy.Server.handleBuffered,matrix/gateway/internal/proxy.Server.handleStreaming
  ^defines=matrix/gateway/internal/proxy/proxy.go

