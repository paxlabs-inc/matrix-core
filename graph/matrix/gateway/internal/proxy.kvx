  digest=b3:a4135a0979ba16d403e8920cc6c0a55fb42942beb3890e6b70549a1c68e7ac7b file=gateway/internal/proxy/proxy.go range=178:190 lang=go exported=false byte_range=5411:5796
  sig=func (s *Server) makeHandler(ep routing.Endpoint) http.HandlerFunc
EDGES
  ^contains=matrix/gateway/internal/proxy.Server
  ^defines=matrix/gateway/internal/proxy/proxy.go

NODE id=matrix/gateway/internal/proxy.Server.maybeDebit kind=method
  digest=b3:5918f9e40f579010f06df6e0486f088593df726e2dad06d611fe01a1a7a74695 file=gateway/internal/proxy/proxy.go range=485:537 lang=go exported=false byte_range=14985:17069
  sig=func (s *Server) maybeDebit(dec *routing.Decision, usage *types.UpstreamUsage, lc ledgerCtx) (string, error)
  doc=maybeDebit prices the call + writes a ledger row, returning the\ncost-pax string for response-header stamping. BYO calls return ""\n(no debit; caller pays direct). Errors are logged but not returned\nto the client (the call already succeeded upstream — losing the\nledger row is preferable to a confusing client-side error).
EDGES
  ^contains=matrix/gateway/internal/proxy.Server
  ^defines=matrix/gateway/internal/proxy/proxy.go

NODE id=matrix/gateway/internal/proxy.Server.stampCostHeaders kind=method
  digest=b3:2026403cf31c23c6ba623a9aad97295a5b47c307f2df474e74877ebf1b645c9e file=gateway/internal/proxy/proxy.go range=539:559 lang=go exported=false byte_range=17071:17770
  sig=func (s *Server) stampCostHeaders(h http.Header, cost string, lc ledgerCtx)
  doc=stampCostHeaders sets the X-Matrix-Cost-Pax / Daily-Spent /\nDaily-Remaining headers on the response. Best-effort: any\narithmetic failure logs but never blocks the response.
EDGES
  ^contains=matrix/gateway/internal/proxy.Server
  ^defines=matrix/gateway/internal/proxy/proxy.go

NODE id=matrix/gateway/internal/proxy.copyHeaders kind=func
  digest=b3:8092b4ab27c1dc1a01371a3d96a21c40d7930d7fb5e9a798b3c31c0f6ebe5de8 file=gateway/internal/proxy/proxy.go range=633:657 lang=go exported=false byte_range=20169:20958
  sig=func copyHeaders(dst, src http.Header)
  doc=copyHeaders copies non-hop-by-hop headers from src to dst. Skips\nhop headers that are illegal to forward per RFC 7230 §6.1, and\ndrops any Authorization header that the upstream may have echoed\n(we never want to leak provider-side credentials downstream).
EDGES
  ^defines=matrix/gateway/internal/proxy/proxy.go

NODE id=matrix/gateway/internal/proxy.ensureStreamUsage kind=func
  digest=b3:a32afdcda9a2f6e5ae1076fc9113ac0a81c5efdcec0e1054540e845ef7348b22 file=gateway/internal/proxy/proxy.go range=452:483 lang=go exported=false byte_range=13794:14983
  sig=func ensureStreamUsage(body []byte) []byte
  doc=ensureStreamUsage rewrites a streaming chat-completions request body to\nset stream_options.include_usage=true. Fireworks + Together emit the\ntoken `usage` block only in the trailing SSE chunk, and only when this\nflag is present; handleStreaming relies on it to debit the ledger.\n\nAll other request fields are preserved verbatim. An existing\nstream_options object is merged (not clobbered) so caller-set fields\nsurvive. Fail-open: a body that isn't a JSON object is returned\nuntouched — metering completeness must never break a live request.
EDGES
  ^defines=matrix/gateway/internal/proxy/proxy.go

NODE id=matrix/gateway/internal/proxy.extractUsage kind=func
  digest=b3:601e0f5b52f627c6504962e9988b5ac8fa27568eaf767ddfd6e48f33d46ee79e file=gateway/internal/proxy/proxy.go range=443:450 lang=go exported=false byte_range=13542:13792
  sig=func extractUsage(body []byte) *types.UpstreamUsage
  doc=extractUsage reads `usage` from a buffered (non-stream) response.
EDGES
  ^defines=matrix/gateway/internal/proxy/proxy.go

NODE id=matrix/gateway/internal/proxy.ledgerCtx kind=type
  digest=b3:c5b63f2f0b0f2ae3ed498a70d54cddc1c12a1c62ab720e18df12862331e0eeea file=gateway/internal/proxy/proxy.go range=343:352 lang=go exported=false byte_range=10538:10785
  sig=type ledgerCtx struct {\n	ctx		context.Context\n	actor		string\n	intentID	string\n	goalID		string\n	preSpent	string\n	preCap		string\n}
