NODE id=matrix/gateway/internal/proxy.Server.handleStreaming kind=method
  digest=b3:6de587069e1393395c8aeeb126586599264624e4fe79deb2adc4ee5f652c65a6 file=gateway/internal/proxy/proxy.go range=475:573 lang=go exported=false byte_range=15282:17931
  sig=func (s *Server) handleStreaming(w http.ResponseWriter, resp *http.Response, dec *routing.Decision, lc ledgerCtx)
  doc=handleStreaming pipes the SSE response through to the client while\nscanning for the trailing `data: {"usage":...}` chunk so cost can\nbe extracted + debited BEFORE the stream terminates from the\nclient's perspective. Cost headers can NOT be added after the\ninitial 200 OK is flushed, so streaming clients must read trailing\nSSE events `data: {"matrix": {"cost_pax": "..."}}` if they want the\ncost surface — kept off the wire for v1; the daemon receives cost\nvia the per-call ledger snapshot endpoint instead.
EDGES
  calls=matrix/gateway/internal/agentwire.NewStreamNormalizer,matrix/gateway/internal/agentwire.StreamNormalizer.Flush,matrix/gateway/internal/agentwire.StreamNormalizer.PushLine,matrix/gateway/internal/proxy.copyHeaders,matrix/gateway/internal/proxy.scanUsageFromChunk
  references=matrix/gateway/internal/agentwire.NewStreamNormalizer,matrix/gateway/internal/agentwire.StreamNormalizer,matrix/gateway/internal/agentwire.StreamNormalizer.Flush,matrix/gateway/internal/agentwire.StreamNormalizer.PushLine,matrix/gateway/internal/proxy.Server,matrix/gateway/internal/proxy.Server.maybeDebit,matrix/gateway/internal/proxy.chunk,matrix/gateway/internal/proxy.copyHeaders,matrix/gateway/internal/proxy.debit,matrix/gateway/internal/proxy.debited,matrix/gateway/internal/proxy.dec,matrix/gateway/internal/proxy.drainAndDebit,matrix/gateway/internal/proxy.drainStreamUsageBounded,matrix/gateway/internal/proxy.err,matrix/gateway/internal/proxy.flusher,matrix/gateway/internal/proxy.header,matrix/gateway/internal/proxy.lastUsage,matrix/gateway/internal/proxy.lc,matrix/gateway/internal/proxy.ledgerCtx,matrix/gateway/internal/proxy.normalizeErr,matrix/gateway/internal/proxy.normalizer,matrix/gateway/internal/proxy.ok,matrix/gateway/internal/proxy.output,matrix/gateway/internal/proxy.outputs,matrix/gateway/internal/proxy.resp,matrix/gateway/internal/proxy.s,matrix/gateway/internal/proxy.scanUsageFromChunk,matrix/gateway/internal/proxy.scanner,matrix/gateway/internal/proxy.u,matrix/gateway/internal/proxy.w,matrix/gateway/internal/proxy.werr,matrix/gateway/internal/routing.Decision,matrix/gateway/internal/routing.ProviderXiaomi,matrix/gateway/internal/types.UpstreamUsage
  ^contains=matrix/gateway/internal/proxy.Server
  ^calls=matrix/gateway/internal/proxy.Server.handleProxy
  ^references=matrix/gateway/internal/proxy.Server.handleProxy
  ^defines=matrix/gateway/internal/proxy/proxy.go

