NODE id=matrix/gateway/internal/proxy.Server.handleStreaming kind=method
  digest=b3:bd7115ad9c3877a9a95c85523764e4c4db7f2427d01689c6364d75b4f9ed4419 file=gateway/internal/proxy/proxy.go range=374:421 lang=go exported=false byte_range=11430:12913
  sig=func (s *Server) handleStreaming(w http.ResponseWriter, resp *http.Response, dec *routing.Decision, lc ledgerCtx)
  doc=handleStreaming pipes the SSE response through to the client while\nscanning for the trailing `data: {"usage":...}` chunk so cost can\nbe extracted + debited BEFORE the stream terminates from the\nclient's perspective. Cost headers can NOT be added after the\ninitial 200 OK is flushed, so streaming clients must read trailing\nSSE events `data: {"matrix": {"cost_pax": "..."}}` if they want the\ncost surface — kept off the wire for v1; the daemon receives cost\nvia the per-call ledger snapshot endpoint instead.
EDGES
  calls=matrix/gateway/internal/proxy.Server.maybeDebit,matrix/gateway/internal/proxy.copyHeaders,matrix/gateway/internal/proxy.scanUsageFromChunk
  references=matrix/gateway/internal/proxy.Server,matrix/gateway/internal/proxy.Server.maybeDebit,matrix/gateway/internal/proxy.chunk,matrix/gateway/internal/proxy.copyHeaders,matrix/gateway/internal/proxy.dec,matrix/gateway/internal/proxy.err,matrix/gateway/internal/proxy.flusher,matrix/gateway/internal/proxy.header,matrix/gateway/internal/proxy.lastUsage,matrix/gateway/internal/proxy.lc,matrix/gateway/internal/proxy.ledgerCtx,matrix/gateway/internal/proxy.ok,matrix/gateway/internal/proxy.resp,matrix/gateway/internal/proxy.s,matrix/gateway/internal/proxy.scanUsageFromChunk,matrix/gateway/internal/proxy.scanner,matrix/gateway/internal/proxy.u,matrix/gateway/internal/proxy.w,matrix/gateway/internal/proxy.werr,matrix/gateway/internal/routing.Decision,matrix/gateway/internal/types.UpstreamUsage
  ^contains=matrix/gateway/internal/proxy.Server
  ^calls=matrix/gateway/internal/proxy.Server.handleProxy
  ^references=matrix/gateway/internal/proxy.Server.handleProxy
  ^defines=matrix/gateway/internal/proxy/proxy.go

