NODE id=matrix/gateway/internal/proxy.copyHeaders kind=func
  digest=b3:8092b4ab27c1dc1a01371a3d96a21c40d7930d7fb5e9a798b3c31c0f6ebe5de8 file=gateway/internal/proxy/proxy.go range=636:660 lang=go exported=false byte_range=20254:21043
  sig=func copyHeaders(dst, src http.Header)
  doc=copyHeaders copies non-hop-by-hop headers from src to dst. Skips\nhop headers that are illegal to forward per RFC 7230 §6.1, and\ndrops any Authorization header that the upstream may have echoed\n(we never want to leak provider-side credentials downstream).
EDGES
  references=matrix/gateway/internal/proxy.drop,matrix/gateway/internal/proxy.dst,matrix/gateway/internal/proxy.hopByHop,matrix/gateway/internal/proxy.k,matrix/gateway/internal/proxy.src,matrix/gateway/internal/proxy.v,matrix/gateway/internal/proxy.vs
  ^calls=matrix/gateway/internal/proxy.Server.handleBuffered,matrix/gateway/internal/proxy.Server.handleProxy,matrix/gateway/internal/proxy.Server.handleStreaming
  ^references=matrix/gateway/internal/proxy.Server.handleBuffered,matrix/gateway/internal/proxy.Server.handleProxy,matrix/gateway/internal/proxy.Server.handleStreaming
  ^defines=matrix/gateway/internal/proxy/proxy.go

NODE id=matrix/gateway/internal/proxy.ensureStreamUsage kind=func
  digest=b3:a32afdcda9a2f6e5ae1076fc9113ac0a81c5efdcec0e1054540e845ef7348b22 file=gateway/internal/proxy/proxy.go range=453:484 lang=go exported=false byte_range=13815:15004
  sig=func ensureStreamUsage(body []byte) []byte
  doc=ensureStreamUsage rewrites a streaming chat-completions request body to\nset stream_options.include_usage=true. Fireworks + Together emit the\ntoken `usage` block only in the trailing SSE chunk, and only when this\nflag is present; handleStreaming relies on it to debit the ledger.\n\nAll other request fields are preserved verbatim. An existing\nstream_options object is merged (not clobbered) so caller-set fields\nsurvive. Fail-open: a body that isn't a JSON object is returned\nuntouched — metering completeness must never break a live request.
EDGES
  references=matrix/gateway/internal/proxy.body,matrix/gateway/internal/proxy.err,matrix/gateway/internal/proxy.m,matrix/gateway/internal/proxy.ok,matrix/gateway/internal/proxy.optBytes,matrix/gateway/internal/proxy.opts,matrix/gateway/internal/proxy.out,matrix/gateway/internal/proxy.raw
  ^calls=matrix/gateway/internal/proxy.Server.handleProxy
  ^references=matrix/gateway/internal/proxy.Server.handleProxy
  ^defines=matrix/gateway/internal/proxy/proxy.go

