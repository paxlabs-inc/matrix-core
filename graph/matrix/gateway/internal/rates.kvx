NODE id=matrix/gateway/internal/rates.Rate kind=type
  digest=b3:e2e6b5b79992425e274813cbc7796d836746d6d4e7715596798f40d2a0dd4e4f file=gateway/internal/rates/rates.go range=170:179 lang=go exported=true byte_range=8674:9143
  sig=type Rate struct {\n	Model			string\n	Group			string\n	InputPaxPerMTokens	float64	// PAX charged per million prompt tokens\n	OutputPaxPerMTokens	float64	// PAX charged per million completion tokens\n	Notes			string	// free-form provenance / sourcing\n}
  doc=Rate is the per-Mtoken price in PAX for a single model. Both prompt\n(input) and completion (output) sides are tracked because providers\ngenerally price the two asymmetrically.
