NODE id=matrix/gateway/internal/rates.Cost kind=func
  digest=b3:3398896bcb1f365f3b8a91dbce30b572ff72abda110fc7585a391fb6dc1cd42e file=gateway/internal/rates/rates.go range=377:412 lang=go exported=true byte_range=19807:21479
  sig=func Cost(model string, promptTokens, completionTokens int) (string, error)
  doc=Cost computes the PAX cost for a (model, prompt, completion) tuple.\nReturns a base-PAX decimal string ("0.000123") suitable for the\nX-Matrix-Cost-Pax response header AND the credit_ledger.cost_pax\nNUMERIC(20,12) column. Errors when the model is not on the rate card.\n\nThe math uses big.Float internally so the divide-by-1e6 step\npreserves precision at NUMERIC(20,12) granularity. Output is\ntruncated (NOT rounded) at 12 decimals to match the schema; we never\nround UP because that would over-bill.
EDGES
  calls=matrix/gateway/internal/rates.Lookup,matrix/gateway/internal/rates.formatPax
  references=matrix/gateway/internal/rates.Lookup,matrix/gateway/internal/rates.RateTableVersion,matrix/gateway/internal/rates.completionTokens,matrix/gateway/internal/rates.cost,matrix/gateway/internal/rates.formatPax,matrix/gateway/internal/rates.in,matrix/gateway/internal/rates.million,matrix/gateway/internal/rates.model,matrix/gateway/internal/rates.num,matrix/gateway/internal/rates.ok,matrix/gateway/internal/rates.out,matrix/gateway/internal/rates.prec,matrix/gateway/internal/rates.promptTokens,matrix/gateway/internal/rates.r,matrix/gateway/internal/rates.rin,matrix/gateway/internal/rates.rout
  ^calls=matrix/gateway/internal/proxy.Server.maybeDebit
  ^references=matrix/gateway/internal/proxy.Server.maybeDebit
  ^defines=matrix/gateway/internal/rates/rates.go

NODE id=matrix/gateway/internal/rates.DailyFreeTierLimitPax kind=const
  digest=b3:6818c10e7b52275a36215625db633cc57edb2fef47b7a06f99397d183a19c975 file=gateway/internal/rates/rates.go range=118:128 lang=go exported=true byte_range=5973:6567
  sig=untyped string
  doc=DailyFreeTierLimitPax is the per-account free-tier spend cap, in PAX,\nenforced by internal/routing against the running daily total. It is a\ndecimal string so it composes directly with AddPax/SubPax/CmpPax and\nthe ledger's PAX representation. Callers that reach it must flip\nX-Matrix-BYO-API-Key to continue.\n\n10 PAX/day = $114.30/day at the v3 reference (1 PAX = $11.43). Note\nthis is a large headroom relative to per-call costs (e.g. ~127M\ndeepseek-v4-flash output tokens/day); tighten here if the intent is a\nstricter free lane.
EDGES
  ^references=matrix/gateway/internal/rates.DailyRemainingPax,matrix/gateway/internal/rates.ExceedsDailyLimit
  ^defines=matrix/gateway/internal/rates/rates.go

NODE id=matrix/gateway/internal/rates.DailyRemainingPax kind=func
  digest=b3:9eda2f8b08083ab49f9d29e40ba747cd9624ad4f33b0b207bc5d568c16788ab3 file=gateway/internal/rates/rates.go range=483:489 lang=go exported=true byte_range=23514:23896
  sig=func DailyRemainingPax(spentPax string) (string, error)
  doc=DailyRemainingPax returns max(DailyFreeTierLimitPax - spentPax, 0) as\na PAX decimal string — the value internal/routing stamps into the\nX-Matrix-Daily-Remaining-Pax header. Thin wrapper over SubPax so the\ncap lives in exactly one place (DailyFreeTierLimitPax).
EDGES
  calls=matrix/gateway/internal/rates.SubPax
  references=matrix/gateway/internal/rates.DailyFreeTierLimitPax,matrix/gateway/internal/rates.SubPax,matrix/gateway/internal/rates.spentPax
  ^defines=matrix/gateway/internal/rates/rates.go

