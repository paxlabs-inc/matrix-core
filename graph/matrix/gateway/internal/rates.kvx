NODE id=matrix/gateway/internal/rates.AddPax kind=func
  digest=b3:e0d472d4fff6bb19412a5c121e031333ea8791c5254f64efd0f6c78340a4653a file=gateway/internal/rates/rates.go range=396:417 lang=go exported=true byte_range=20019:20744
  sig=func AddPax(a, b string) (string, error)
  doc=AddPax sums two PAX-denominated decimal strings. Returns "" + an\nerror when either input fails to parse. Used by the ledger to\nroll up the daily-spend trailer header without re-querying Postgres.
EDGES
  ^defines=matrix/gateway/internal/rates/rates.go

NODE id=matrix/gateway/internal/rates.All kind=func
  digest=b3:8b41290c1d5c284504ffc2348816141736577fca96a000edf0f21811b4fab3a8 file=gateway/internal/rates/rates.go range=291:297 lang=go exported=true byte_range=14606:14808
  sig=func All() []Rate
  doc=All returns a snapshot of the rate table. The returned slice is\nsafe to mutate; callers receive a copy.
EDGES
  ^defines=matrix/gateway/internal/rates/rates.go

NODE id=matrix/gateway/internal/rates.CmpPax kind=func
  digest=b3:1bc80b26dc6c7fef240b4b1a25ced159ba5be0ff833c40b0a9ce317a9ae4ca7c file=gateway/internal/rates/rates.go range=444:463 lang=go exported=true byte_range=21452:22050
  sig=func CmpPax(a, b string) (int, error)
  doc=CmpPax compares two PAX-denominated decimal strings. Returns -1, 0,\nor 1 (a < b, a == b, a > b). Errors propagate parse failures.
EDGES
  ^defines=matrix/gateway/internal/rates/rates.go

NODE id=matrix/gateway/internal/rates.Cost kind=func
  digest=b3:3398896bcb1f365f3b8a91dbce30b572ff72abda110fc7585a391fb6dc1cd42e file=gateway/internal/rates/rates.go range=359:394 lang=go exported=true byte_range=18345:20017
  sig=func Cost(model string, promptTokens, completionTokens int) (string, error)
  doc=Cost computes the PAX cost for a (model, prompt, completion) tuple.\nReturns a base-PAX decimal string ("0.000123") suitable for the\nX-Matrix-Cost-Pax response header AND the credit_ledger.cost_pax\nNUMERIC(20,12) column. Errors when the model is not on the rate card.\n\nThe math uses big.Float internally so the divide-by-1e6 step\npreserves precision at NUMERIC(20,12) granularity. Output is\ntruncated (NOT rounded) at 12 decimals to match the schema; we never\nround UP because that would over-bill.
EDGES
  ^defines=matrix/gateway/internal/rates/rates.go

NODE id=matrix/gateway/internal/rates.DailyFreeTierLimitPax kind=const
  digest=b3:6818c10e7b52275a36215625db633cc57edb2fef47b7a06f99397d183a19c975 file=gateway/internal/rates/rates.go range=110:120 lang=go exported=true byte_range=5472:6066
  sig=untyped string
  doc=DailyFreeTierLimitPax is the per-account free-tier spend cap, in PAX,\nenforced by internal/routing against the running daily total. It is a\ndecimal string so it composes directly with AddPax/SubPax/CmpPax and\nthe ledger's PAX representation. Callers that reach it must flip\nX-Matrix-BYO-API-Key to continue.\n\n10 PAX/day = $114.30/day at the v3 reference (1 PAX = $11.43). Note\nthis is a large headroom relative to per-call costs (e.g. ~127M\ndeepseek-v4-flash output tokens/day); tighten here if the intent is a\nstricter free lane.
EDGES
  ^defines=matrix/gateway/internal/rates/rates.go

NODE id=matrix/gateway/internal/rates.DailyRemainingPax kind=func
  digest=b3:9eda2f8b08083ab49f9d29e40ba747cd9624ad4f33b0b207bc5d568c16788ab3 file=gateway/internal/rates/rates.go range=465:471 lang=go exported=true byte_range=22052:22434
  sig=func DailyRemainingPax(spentPax string) (string, error)
  doc=DailyRemainingPax returns max(DailyFreeTierLimitPax - spentPax, 0) as\na PAX decimal string — the value internal/routing stamps into the\nX-Matrix-Daily-Remaining-Pax header. Thin wrapper over SubPax so the\ncap lives in exactly one place (DailyFreeTierLimitPax).
EDGES
  ^defines=matrix/gateway/internal/rates/rates.go

NODE id=matrix/gateway/internal/rates.ExceedsDailyLimit kind=func
  digest=b3:56bf683c75b7b9f0f24a45c9a092d7eb5fa392da1a588c77edb9df38e9c58638 file=gateway/internal/rates/rates.go range=473:483 lang=go exported=true byte_range=22436:22851
  sig=func ExceedsDailyLimit(spentPax string) (bool, error)
  doc=ExceedsDailyLimit reports whether spentPax has reached or passed the\nfree-tier cap (spentPax >= DailyFreeTierLimitPax). True means the\ncaller must flip X-Matrix-BYO-API-Key to continue. Errors propagate\nparse failures from CmpPax.
EDGES
  ^defines=matrix/gateway/internal/rates/rates.go

