  sig=untyped string
  doc=SlotCassandra is the epistemic-completeness faculty (matrix/cassandra):\nthe cross-rail auditor that adjudicates whether a claimed completion is\nactually grounded before an agent may terminate/attest. The MCL\ncompleteness critic routes here (was the planner slot); Cassandra\ndeclares her OWN slot so audit spend is metered under her identity.\nReuses already-priced models — no rateTable row, no version bump.
EDGES
  ^references=matrix/gateway/internal/routing.validSlot
  ^defines=matrix/gateway/internal/types/types.go

NODE id=matrix/gateway/internal/types.SlotCody kind=const
