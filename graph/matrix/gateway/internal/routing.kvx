NODE id=matrix/gateway/internal/routing.detectProvider kind=func
  digest=b3:bc16fb5aa7c95808a577944f2ea75b7b3718c1747fe31d5a79c8fa2b3765e7bb file=gateway/internal/routing/routing.go range=271:295 lang=go exported=false byte_range=8618:9944
  sig=func detectProvider(model string) (Provider, error)
  doc=detectProvider mirrors MCL/llm.DetectProvider. Fireworks gets the\n"accounts/fireworks/" prefix; Grok ("grok-*", e.g. "grok-4.3") routes to xAI\n— the primary chat provider — on its OpenAI-compatible /v1 surface, with the\nbare fleet id passed through unchanged (no native-id rewrite); the remaining\ngeneric "<vendor>/<model>" shape routes to Baseten. Bare non-grok model ids\n(no slash) are an error.
EDGES
  ^defines=matrix/gateway/internal/routing/routing.go

