NODE id=matrix/router/internal/jwt.jwksCache.refresh kind=method
  digest=b3:95a36a08b2d834b9a9ba8a7566a34c8d9f7e48e341dd45c02db37122a225b6cd file=router/internal/jwt/jwks.go range=130:179 lang=go exported=false byte_range=3658:5072
  sig=func (c *jwksCache) refresh(ctx context.Context) error
  doc=refresh fetches the JWKS unconditionally and replaces the cache.\n\nOn error: cache is left unchanged so prior keys keep working. The\nlastFetch timestamp IS still updated to enforce the throttle even\nwhen fetches fail (avoids hammering upstream during outages).
EDGES
  ^contains=matrix/router/internal/jwt.jwksCache
  ^defines=matrix/router/internal/jwt/jwks.go

