  sig=func decodeBigInt(s string) (*big.Int, error)
  doc=decodeBigInt unpacks a base64url-encoded big-endian integer per\nRFC 7518 §6. Empty / leading-zero values are rejected to match\nSupabase's well-formed JWK output.
