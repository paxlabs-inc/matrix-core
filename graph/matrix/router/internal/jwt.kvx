NODE id=matrix/router/internal/jwt.Verifier.PrimeJWKS kind=method
  digest=b3:a0aa52db70fb414ccef1a5b831d469d82421932163a9ac39956eece996370822 file=router/internal/jwt/verifier.go range=148:157 lang=go exported=true byte_range=5204:5597
  sig=func (v *Verifier) PrimeJWKS(ctx context.Context) error
  doc=PrimeJWKS does an eager fetch so first-request latency doesn't pay\nthe network round-trip. Errors are returned but should be logged\nand ignored by callers — the Verifier will lazy-fetch on first\nasymmetric token hit if priming failed (e.g. transient DNS).
EDGES
  ^contains=matrix/router/internal/jwt.Verifier
  ^defines=matrix/router/internal/jwt/verifier.go

NODE id=matrix/router/internal/jwt.Verifier.Verify kind=method
  digest=b3:95314aa8e74c2de63b27a8fcf437d39f9d70f971819781566a215a612c561176 file=router/internal/jwt/verifier.go range=159:242 lang=go exported=true byte_range=5599:8444
  sig=func (v *Verifier) Verify(ctx context.Context, raw string, now time.Time) (*Claims, error)
  doc=Verify parses raw, dispatches on the alg header, runs signature +\ntime checks, and returns the parsed Claims on success.\n\nIssuer enforcement: if the verifier was constructed with a non-empty\nSupabaseURL, the iss claim must match "<SupabaseURL>/auth/v1".\nTokens forwarded from a different Supabase project will be rejected\neven if the algorithm is supported.
EDGES
  ^contains=matrix/router/internal/jwt.Verifier
  ^defines=matrix/router/internal/jwt/verifier.go

