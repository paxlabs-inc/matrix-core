NODE id=matrix/router/internal/jwt.defaultRefreshThrottle kind=const
  digest=b3:7c74fd3d991326ea1ad886e407a0c6794ebe671e61d8ca7a7b8d848856146e29 file=router/internal/jwt/jwks.go range=40:44 lang=go exported=false byte_range=1169:1490
  sig=time.Duration
  doc=defaultRefreshThrottle is the floor between forced JWKS fetches in\nresponse to unknown-kid hits. Supabase caches the JWKS at the edge\nfor tens of seconds, so this is generous enough to avoid hammering\nupstream while still picking up a rotation within ~1 minute.
EDGES
  ^defines=matrix/router/internal/jwt/jwks.go

