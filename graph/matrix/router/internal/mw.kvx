NODE id=matrix/router/internal/mw.Admin kind=func
  digest=b3:5cd0cdaaa276a955963723a73b022394db7d218dab3eb88e0fb6506075e25d57 file=router/internal/mw/mw.go range=93:118 lang=go exported=true byte_range=3587:4614
  sig=func Admin(token string, log Logf) func(http.Handler) http.Handler
  doc=Admin returns middleware that requires Authorization: Bearer\n<admin-token> matching token via constant-time compare. When token\nis empty the middleware returns 503 — operationally a misconfigured\ndeploy SHOULD fail open-loud not silent-pass.
EDGES
  ^defines=matrix/router/internal/mw/mw.go

NODE id=matrix/router/internal/mw.CORS kind=func
  digest=b3:9814341f73f8ccb0552e5beec114f7031989d883aca927a60d79586dc3f6a93a file=router/internal/mw/mw.go range=120:173 lang=go exported=true byte_range=4616:7147
  sig=func CORS(allowed []string, log Logf) func(http.Handler) http.Handler
  doc=CORS returns middleware that answers browser cross-origin requests from the\nNext.js client (served from a different origin than this API). It reflects an\nallowed Origin, advertises the methods + headers the client sends\n(Authorization, Content-Type, X-Request-Id), and short-circuits the preflight\nOPTIONS with 204 BEFORE any auth middleware runs — a preflight carries no\ntoken, so it must never reach mw.JWT.\n\nallowed is the operator allow-list (ROUTER_CORS_ORIGINS). An entry of "*" (or\nan empty list) allows any origin; because the client authenticates with a\nBearer token and never sends cookies (credentials: 'omit'), reflecting the\norigin without Allow-Credentials is safe.
EDGES
  ^defines=matrix/router/internal/mw/mw.go

NODE id=matrix/router/internal/mw.JWT kind=func
  digest=b3:e64318fda95b70705b1010938b286f179d76b03cd0abfa27a44153ca1446dcd8 file=router/internal/mw/mw.go range=29:91 lang=go exported=true byte_range=946:3585
  sig=func JWT(v *jwt.Verifier, log Logf) func(http.Handler) http.Handler
  doc=JWT returns middleware that validates an Authorization: Bearer <jwt>\nheader against the provided Verifier. On success, the verified\nSubject is stashed in request context via proxy.WithSubject.\n\nThe Verifier internally dispatches on the JWT alg header:\nHS256 → legacy SUPABASE_JWT_SECRET; ES256/RS256/EdDSA → JWKS at\nSUPABASE_URL/auth/v1/.well-known/jwks.json. See router/internal/jwt.\n\nFailure mapping:\n\n	missing/empty header        -> 401 (unauthenticated)\n	malformed token             -> 401 (bad token)\n	expired                     -> 401 (refresh-needed)\n	bad signature               -> 401 (intentionally indistinguishable\n	                                    from "wrong key" to avoid\n	                                    leaking server config)\n\nDistinguishable error categories surface in the WWW-Authenticate\nheader so a smart client can decide whether to refresh.
EDGES
  ^defines=matrix/router/internal/mw/mw.go

NODE id=matrix/router/internal/mw.Logf kind=type
  digest=b3:03fd17732a0f691ec02b104b922a7b704fa0425c689d2b3a7b8ee017b5094c84 file=router/internal/mw/mw.go range=20:22 lang=go exported=true byte_range=494:680
  sig=type Logf func(format string, args ...interface{})
  doc=Logf is the log sink used by middleware. Cmd/main.go wires this to\nos.Stderr; callers can swap to a structured logger if desired.
EDGES
  ^defines=matrix/router/internal/mw/mw.go

NODE id=matrix/router/internal/mw.PreviewCookie kind=const
  digest=b3:0768120226f245e500f3f5e01c3115621ff75323a1827ac3e786cc6d3d39ac12 file=router/internal/mw/mw.go range=24:27 lang=go exported=true byte_range=682:944
  sig=untyped string
  doc=PreviewCookie is the path-scoped cookie the preview handler sets so an\niframed preview app's same-origin subresource requests authenticate without\na token on every URL. mw.JWT reads it as the lowest-precedence token source.
EDGES
