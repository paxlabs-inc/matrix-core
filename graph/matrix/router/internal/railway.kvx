  ^defines=matrix/router/internal/railway/provisioner.go

NODE id=matrix/router/internal/railway.safeName kind=func
  digest=b3:5010a43c887320f8413e25eb806af1f64135f4f73d096cf1e1d9ca97e94e8943 file=router/internal/railway/provisioner.go range=269:289 lang=go exported=false byte_range=9236:9809
  sig=func safeName(s string, n int) string
  doc=safeName returns a DNS-safe lowercase prefix of s, max length n —\nthe same sanitization the fly provisioner applies to machine names,\nso a user keeps the same environment name across providers.
EDGES
  ^defines=matrix/router/internal/railway/provisioner.go

