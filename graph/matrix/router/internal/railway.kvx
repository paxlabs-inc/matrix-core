  digest=b3:7c5c48a1ca47ba43bd12c536ff12242110165d3c9ad83d51b0dc44e833d8f748 file=router/internal/railway/provisioner.go range=252:267 lang=go exported=false byte_range=8658:9234
  sig=func mapErr(err error) error
  doc=mapErr translates the client's sentinel errors onto the neutral ones\nso interface consumers dispatch without importing railway.\nEverything else (including context.DeadlineExceeded) passes through\nunchanged.
