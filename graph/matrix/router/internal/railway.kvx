NODE id=matrix/router/internal/railway.Provisioner.Ensure kind=method
  digest=b3:db5d8c44bc8cbc4f87bdba3bd92d48778021e060d525dc80bc25265e808328c9 file=router/internal/railway/provisioner.go range=45:79 lang=go exported=true byte_range=1537:2837
  sig=func (p *Provisioner) Ensure(ctx context.Context, req provision.CreateRequest) (*provision.Env, error)
  doc=Ensure provisions the per-user service + volume and blocks until the\nfirst deployment is live (or ctx expires). The caller's provision\nbudget (admin.ProvisionTimeout) bounds the wait.
EDGES
  ^contains=matrix/router/internal/railway.Provisioner
  ^defines=matrix/router/internal/railway/provisioner.go

NODE id=matrix/router/internal/railway.Provisioner.Status kind=method
  digest=b3:cbe5320693d41aac90d3e349c8fd78131d42357f8f0ed101522d9f14b5c43f59 file=router/internal/railway/provisioner.go range=81:94 lang=go exported=true byte_range=2839:3331
  sig=func (p *Provisioner) Status(ctx context.Context, ref provision.Ref) (*provision.Env, error)
  doc=Status reports the latest deployment state; Live (SUCCESS or\nSLEEPING) counts as ready — a slept service revives on the first\ninbound packet.
EDGES
  ^contains=matrix/router/internal/railway.Provisioner
  ^defines=matrix/router/internal/railway/provisioner.go

NODE id=matrix/router/internal/railway.Provisioner.Wake kind=method
  digest=b3:a3add3ddb378e7f5e5b7dcd3ae6e952cedf893cbdda1f6a2c2a3596febd58fda file=router/internal/railway/provisioner.go range=96:105 lang=go exported=true byte_range=3333:3830
  sig=func (p *Provisioner) Wake(ctx context.Context, ref provision.Ref) (*provision.Env, error)
  doc=Wake is a NO-OP by design: Railway Serverless wakes the service on\nthe first inbound private-network packet, so the forwarded request\nitself is the wake signal. No API call — the request hot path stays\nfree of provider round-trips; waitDaemonReady absorbs the cold boot.
EDGES
  ^contains=matrix/router/internal/railway.Provisioner
  ^defines=matrix/router/internal/railway/provisioner.go

NODE id=matrix/router/internal/railway.Provisioner.WakeOnRequest kind=method
  digest=b3:44b1f432c229cc0d6ea6fe3dda34be635578b2ada47c2e3197154e4acdfbb948 file=router/internal/railway/provisioner.go range=121:125 lang=go exported=true byte_range=4331:4638
  sig=func (p *Provisioner) WakeOnRequest() bool
  doc=WakeOnRequest is true: waking is platform-managed by inbound\ntraffic, and the readiness probe must absorb the whole cold boot\n(including the documented possible first-request 502 from the\nprivate-network edge while the service revives).
EDGES
  ^contains=matrix/router/internal/railway.Provisioner
  ^defines=matrix/router/internal/railway/provisioner.go

NODE id=matrix/router/internal/railway.Provisioner.env kind=method
  digest=b3:1d40e41f60f20fdc99f7b6350191acda73d493de8b2ce14b9034f31349bcd255 file=router/internal/railway/provisioner.go range=157:168 lang=go exported=false byte_range=5530:5940
  sig=func (p *Provisioner) env(id, name, region string) *provision.Env
  doc=env builds the neutral view. The endpoint is the service's private\nhostname; the port is left empty so the router's configured daemon\nport applies (the daemon binds the same port on every provider).
EDGES
  ^contains=matrix/router/internal/railway.Provisioner
  ^defines=matrix/router/internal/railway/provisioner.go

NODE id=matrix/router/internal/railway.Provisioner.waitDeployed kind=method
  digest=b3:5596ca2a2b14564ab40466228ec05b036b884132e76995c85052b3f104bf522c file=router/internal/railway/provisioner.go range=127:155 lang=go exported=false byte_range=4640:5528
  sig=func (p *Provisioner) waitDeployed(ctx context.Context, serviceID string) error
  doc=waitDeployed polls the service's latest deployment until Live, a\nterminal failure, or ctx expiry. A service created moments ago may\nbriefly report no deployments — treated as not-ready, not an error.
EDGES
  ^contains=matrix/router/internal/railway.Provisioner
  ^defines=matrix/router/internal/railway/provisioner.go

