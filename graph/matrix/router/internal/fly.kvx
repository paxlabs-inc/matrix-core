  ^defines=matrix/router/internal/fly/provisioner.go

NODE id=matrix/router/internal/fly.safeName kind=func
  digest=b3:415b3a55e05277e94ee3c15fda3df58d408a8322b40236eb27de31d6721cad6e file=router/internal/fly/provisioner.go range=161:181 lang=go exported=false byte_range=5337:5887
  sig=func safeName(s string, n int) string
  doc=safeName returns a DNS-safe lowercase prefix of s, max length n.\nUsed so machine names don't blow up Fly's validation. Hyphens are\npreserved; Fly machine names accept them.
EDGES
  ^defines=matrix/router/internal/fly/provisioner.go

NODE id=matrix/router/internal/fly.truncate kind=func
  digest=b3:d038c6baadf2855160d8075de00c6bd33e0a384c6564931f9316678c40ddb4d1 file=router/internal/fly/fly.go range=286:293 lang=go exported=false byte_range=9219:9453
  sig=func truncate(b []byte, n int) string
  doc=truncate trims b for error-message inclusion so we don't dump the\nupstream payload into application logs.
EDGES
  ^defines=matrix/router/internal/fly/fly.go

NODE id=matrix/router/internal/fly.volumeSafeName kind=func
  digest=b3:b590c9a151fb7ba12ba2c7d8c0d872e22ed95a0c629e1d48498d376d91fc9e2b file=router/internal/fly/provisioner.go range=183:207 lang=go exported=false byte_range=5889:6653
  sig=func volumeSafeName(s string, n int) string
  doc=volumeSafeName returns a [a-z0-9_]-only prefix of s, max length n.\nStricter than safeName because Fly volume names reject hyphens\n("name only allows lowercase alphanumeric characters and underscores\nwith at most 30 characters" — observed 400 from POST /v1/apps/<app>/volumes).\nHyphens are mapped to underscores so UUIDs round-trip cleanly.
EDGES
  ^defines=matrix/router/internal/fly/provisioner.go

