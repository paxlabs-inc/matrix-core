NODE id=matrix/router/internal/fly.Client.EnsureStarted kind=method
  digest=b3:148d99d548947fb7b4214ff842a25a8aad5e06abb983093f5766b25018b0eb0c file=router/internal/fly/fly.go range=187:227 lang=go exported=true byte_range=6115:7331
  sig=func (c *Client) EnsureStarted(ctx context.Context, id string, probeInterval time.Duration) (*Machine, error)
  doc=EnsureStarted wakes the machine if not already started, then polls\nat probeInterval (jittered up to 1.5x) until the machine reports\nstate=started or ctx times out. Returns the final Machine state.\n\nThis is the hot-path the proxy calls per request: when the user's\nmachine is suspended it incurs a wake-then-poll latency (~250ms-2s\nin our experience). The proxy adds ~one extra DB round-trip + the\nwake; an already-started machine returns near-instantly because the\nfirst GetMachine sees Started=true.
EDGES
  ^contains=matrix/router/internal/fly.Client
  ^defines=matrix/router/internal/fly/fly.go

