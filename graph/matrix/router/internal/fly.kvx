  digest=b3:691ec99abcfc22df3de9654a47ed54ba5ff5818b214170893e6a3a294f00d8a5 file=router/internal/fly/provisioner.go range=147:159 lang=go exported=false byte_range=4822:5335
  sig=func mapErr(err error) error
  doc=mapErr translates the client's sentinel errors onto the neutral ones\nso interface consumers dispatch without importing fly. Everything\nelse (including context.DeadlineExceeded) passes through unchanged.
