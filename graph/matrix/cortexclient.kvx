NODE id=matrix/cortexclient.Client.sendAdmittedLocked kind=method
  digest=b3:c269b0f80b5279859cab733f8a828b1ad169c31d93dca3a3ccb21a6ddbc29a73 file=cortexclient/client.go range=616:662 lang=go exported=false byte_range=17687:19056
  sig=func (c *Client) sendAdmittedLocked(clientSeq uint64, send func(clientSeq uint64) error) error
  doc=sendAdmittedLocked delivers one admitted write at a fixed client sequence.\nAny post-send error is ambiguous until a new Welcome reports whether cortexd\nadvanced. An explicit engine rejection is released only when that handshake\nproves the sequence remains free; otherwise the exact sequence is replayed.
