NODE id=matrix/cortexclient.Client.writeAdmittedLocked kind=method
  digest=b3:57f44d29ae5f5702cb1a85f5eea79f63592a6a594c36fa510a78f33acf2862d9 file=cortexclient/client.go range=664:703 lang=go exported=false byte_range=19058:20398
  sig=func (c *Client) writeAdmittedLocked(send func(clientSeq uint64) error) error
  doc=writeAdmittedLocked runs the full self-healing sequence policy for one\nwrite that has been admitted at c.clientSeq:\n  - an engine rejection releases the sequence slot only after a reconnect\n    proves the server never recorded it, so the chain does not wedge;\n  - a sequence/idempotency conflict means the server durably holds a write\n    the client considered rejected (apply succeeded but the projection step\n    failed before acknowledgement); the slot is burned, so retry once at\n    the next sequence.
EDGES
  calls=matrix/cortexclient.Client.consumeRecoveryLocked,matrix/cortexclient.Client.reconnectTransportLocked,matrix/cortexclient.Client.sendAdmittedLocked,matrix/cortexclient.sequenceConflict
  references=matrix/cortexclient.Client,matrix/cortexclient.Client.consumeRecoveryLocked,matrix/cortexclient.Client.reconnectTransportLocked,matrix/cortexclient.Client.sendAdmittedLocked,matrix/cortexclient.ErrSequenceRecovery,matrix/cortexclient.c,matrix/cortexclient.delta,matrix/cortexclient.err,matrix/cortexclient.next,matrix/cortexclient.reconnectErr,matrix/cortexclient.recoveryErr,matrix/cortexclient.rejected,matrix/cortexclient.rejectedWriteError,matrix/cortexclient.send,matrix/cortexclient.sequenceConflict
  ^contains=matrix/cortexclient.Client
  ^calls=matrix/cortexclient.Client.Append,matrix/cortexclient.Client.Attest,matrix/cortexclient.Client.WriteCheckpoint,matrix/cortexclient.Client.queueAppend
