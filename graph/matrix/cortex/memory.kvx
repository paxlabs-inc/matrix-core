  sig=type Version struct {\n	ID		ID		`cbor:"1,keyasint"`\n	Version		uint64		`cbor:"2,keyasint"`\n	Type		Type		`cbor:"3,keyasint"`\n	Data		[]byte		`cbor:"4,keyasint"`	// canonical CBOR of typed Data\n	CreatedAt	time.Time	`cbor:"5,keyasint"`\n	CreatedBy	string		`cbor:"6,keyasint"`\n	ExpiresAt	*time.Time	`cbor:"7,keyasint,omitempty"`\n	Confidence	float32		`cbor:"8,keyasint"`\n	Provenance	Provenance	`cbor:"9,keyasint"`\n	Forms		Forms		`cbor:"10,keyasint"`\n	FormsOverride	bool		`cbor:"11,keyasint,omitempty"`	// true if Forms.Short/Medium were skill-supplied\n	Hash		[32]byte	`cbor:"12,keyasint"`		// SHA-256 over canonical body\n	// ValidFrom / ValidUntil are the bi-temporal valid-time interval (v3\n	// #2), distinct from the transaction-time CreatedAt. ValidFrom is when\n	// the assertion BECAME true (event time; defaults to CreatedAt when\n	// nil); ValidUntil is when it STOPPED being true (nil = still valid).\n	// The interval is treated half-open [ValidFrom, ValidUntil) by query.Run\n	// so a supersession that stamps ValidUntil = successor.ValidFrom leaves\n	// no overlap at the boundary instant. Both are omitempty: existing\n	// versions decode unchanged and a write that sets neither hashes\n	// byte-identically to the pre-v3 layout. Closing ValidUntil on\n	// supersession is a NEW journaled Version (cortex.CloseValidity), never\n	// an in-place Head mutation — replay-byte-safe (§6, v3 §8 lock).\n	ValidFrom	*time.Time	`cbor:"13,keyasint,omitempty"`\n	ValidUntil	*time.Time	`cbor:"14,keyasint,omitempty"`\n}
  doc=Version is the immutable per-version payload stored at mv/<id>/v/<n>.\n\nSpec: §4.1, §6.\n\nData is the canonical CBOR encoding of one of the type-specific Data\nstructs declared in data.go. Storing it pre-encoded keeps Hash stable\nacross decode/re-encode cycles and avoids reflection at read time.
EDGES
  contains=matrix/cortex/memory.Version#Confidence,matrix/cortex/memory.Version#CreatedAt,matrix/cortex/memory.Version#CreatedBy,matrix/cortex/memory.Version#Data,matrix/cortex/memory.Version#ExpiresAt,matrix/cortex/memory.Version#Forms,matrix/cortex/memory.Version#FormsOverride,matrix/cortex/memory.Version#Hash,matrix/cortex/memory.Version#ID,matrix/cortex/memory.Version#Provenance,matrix/cortex/memory.Version#Type,matrix/cortex/memory.Version#ValidFrom,matrix/cortex/memory.Version#ValidUntil,matrix/cortex/memory.Version#Version
  references=matrix/cortex/memory.Forms,matrix/cortex/memory.ID,matrix/cortex/memory.Provenance,matrix/cortex/memory.Type
  ^references=matrix/cortex.Cortex.Resolve,matrix/cortex.Cortex.ResolveLatest,matrix/cortex.Cortex.Update,matrix/cortex.Cortex.Versions,matrix/cortex.Cortex.Write,matrix/cortex.Cortex.prepareSupersedeReplacement,matrix/cortex.loadVersion,matrix/cortex.prepareValidityClose,matrix/cortex.versionValidAt,matrix/cortex/memory.CurrentTruthAt,matrix/cortex/memory.DecodeVersion,matrix/cortex/memory.EncodeVersion,matrix/cortex/memory.HashVersion,matrix/cortex/memory.Memory,matrix/cortex/memory.ValidateMemory,matrix/cortex/memory.VersionCurrentAt,matrix/cortex/query.Run,matrix/cortex/query.versionField,matrix/cortex/query.withinValidity,matrix/cortex/replay.readVersion,matrix/cortexclient/export.assertionValue,matrix/cortexclient/export.memoryVersion,matrix/cortexclient/export.run.exportMemories,matrix/neo/internal/memory.Pager.lexicalExcerptMatchesTruth,matrix/neo/internal/memory.mutationDescription
