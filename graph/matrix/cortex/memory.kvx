NODE id=matrix/cortex/memory.VectorHashDomain kind=const
  digest=b3:79f204b8428982ec6eb5efff568d1c752848f975cc6f5db65914f7c74f68e056 file=cortex/memory/codec.go range=137:141 lang=go exported=true byte_range=3816:4110
  sig=untyped string
  doc=VectorHashDomain is prepended to vector bytes before SHA-256 so vector\nhashes can't collide with memory.Hash, journal LeafHash, or any future\nMerkle domain. Bump the version suffix on any change to the canonical\nvector byte layout.
EDGES
  ^references=matrix/cortex/memory.HashVector
