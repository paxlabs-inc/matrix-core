NODE id=matrix/cortex/memory.ObjHash kind=func
  digest=b3:927766e40df2daeaa49f9ff9eda6fd3f74c94196b90fd76d74aec1e9ac297481 file=cortex/memory/verb.go range=214:228 lang=go exported=true byte_range=6691:7357
  sig=func ObjHash(ref string) [ObjHashSize]byte
  doc=ObjHash returns sha256(ref)[:16] — the canonical 16-byte obj_id used\nin idx/frame and idx/actor_obj keys. Deterministic; the same ref\nstring always hashes to the same obj_id across actors and processes,\nload-bearing for replay (drop indexes → walk j/ → re-derive identical\nidx/* keys from Head.Frames).\n\nCollision risk: 16 bytes = 128 bits. Birthday bound ≈ 2^64 distinct\nrefs before a collision is likely — orders of magnitude above any\nrealistic per-actor frame cardinality.
EDGES
  references=matrix/cortex/memory.ObjHashSize,matrix/cortex/memory.out,matrix/cortex/memory.ref,matrix/cortex/memory.sum
  ^calls=matrix/cortex.parseObjectTuples,matrix/cortex/memory.FrameRef.Hash
  ^references=matrix/cortex.parseObjectTuples,matrix/cortex/memory.FrameRef.Hash
  ^defines=matrix/cortex/memory/verb.go

