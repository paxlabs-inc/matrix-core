  ^defines=matrix/cortex/memory/verb.go

NODE id=matrix/cortex/memory.MaxMediumTokens kind=const
  digest=b3:8bdcb7a30806a5de60ddaa5ec12cf2f88e4d13597a828bf04c8e3452c1ad7de8 file=cortex/memory/types.go range=153:166 lang=go exported=true byte_range=3761:4449
  sig=untyped int
  doc=MaxShortTokens / MaxMediumTokens are the budgets enforced at write time\n(§9.3).\n\nToken counting is the bytes/4 heuristic: tokens ≈ ceil(len(utf8_bytes)/4).\nThis is deterministic (zero deps, snapshot-hash-stable), undercounts a real\nBPE tokenizer by ~10–20% for English (so we leave a small safety margin\ninside the cap), and overcounts for CJK (so CJK gets truncated tighter,\nacceptable for v1). Switching to a proper BPE tokenizer would require\npinning the merges-file digest in models/ to keep cortex_snapshot_hash\nstable; deferred until the executor model lands. See\nresearch/04-cortex.md §9.3.
EDGES
  ^references=matrix/cortex/forms.Render,matrix/cortex/memory.validateForms
  ^defines=matrix/cortex/memory/types.go

NODE id=matrix/cortex/memory.MaxObjRefLen kind=const
  digest=b3:6629841ce94dcf8691acbdb6642ee63eee6884a5116609f41fcdd00b85036618 file=cortex/memory/verb.go range=198:203 lang=go exported=true byte_range=5947:6329
  sig=untyped int
  doc=MaxObjRefLen caps the FrameRef.ObjRef string length so the canonical\nCBOR encoding of Head.Frames stays bounded and the (post-hash) idx\nkey generation is finite-time. 256 chars accommodates full URIs\n(matrix://cortex/Event/<26-char-ulid>#<ver> ≈ 50 chars) with comfort\nfor namespaced refs like "matrix://knowledge/models/llama-405b@digest".
EDGES
  ^references=matrix/cortex/memory.FrameRef.Validate
  ^defines=matrix/cortex/memory/verb.go

NODE id=matrix/cortex/memory.MaxShortTokens kind=const
  digest=b3:bc721504b2176c3d145432c2f069e8bad9b3a49715ea9bbbaa44d8dfba481250 file=cortex/memory/types.go range=153:165 lang=go exported=true byte_range=3761:4426
  sig=untyped int
  doc=MaxShortTokens / MaxMediumTokens are the budgets enforced at write time\n(§9.3).\n\nToken counting is the bytes/4 heuristic: tokens ≈ ceil(len(utf8_bytes)/4).\nThis is deterministic (zero deps, snapshot-hash-stable), undercounts a real\nBPE tokenizer by ~10–20% for English (so we leave a small safety margin\ninside the cap), and overcounts for CJK (so CJK gets truncated tighter,\nacceptable for v1). Switching to a proper BPE tokenizer would require\npinning the merges-file digest in models/ to keep cortex_snapshot_hash\nstable; deferred until the executor model lands. See\nresearch/04-cortex.md §9.3.
EDGES
  ^references=matrix/cortex/forms.Render,matrix/cortex/memory.validateForms
  ^defines=matrix/cortex/memory/types.go

