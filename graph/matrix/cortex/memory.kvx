  digest=b3:3dacf6fffe1b3adf12410765ae6eecdd15e0715016be67c1003c4184ec3f9e12 file=cortex/memory/verb.go range=205:208 lang=go exported=true byte_range=6331:6528
  sig=untyped int
  doc=MaxFramesPerMemory caps Head.Frames cardinality to keep per-write\nidx/frame and idx/actor_obj fan-out bounded. Mirrors the\nMaxTagsPerMemory rationale (§4.3).
