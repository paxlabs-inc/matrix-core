  digest=b3:c04b8c8965c11de3ce80452f15c2e34ede253709a2f38d90a04c5f487ce1f0a5 file=cortex/cmd/cortex-shell/main.go range=561:615 lang=go exported=false byte_range=16983:18831
  sig=func runDumpAttest(c *cortex.Cortex, seqStr string)
  doc=runDumpAttest reads j/<seq> and prints the decoded AttestPayload as\nindented JSON. Fails if the entry at seq is not KindAttest.
