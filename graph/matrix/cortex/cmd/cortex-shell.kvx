NODE id=matrix/cortex/cmd/cortex-shell.ensureEmbedder kind=func
  digest=b3:d5cda7c22358816e7986897a7bb4638c8adf787407c33946d045b6d511095cd7 file=cortex/cmd/cortex-shell/main.go range=1180:1198 lang=go exported=false byte_range=35861:36674
  sig=func ensureEmbedder(c *cortex.Cortex, root, actor string)
  doc=ensureEmbedder boots the deterministic HashEmbedder + persisted HNSW\nindex for this actor, then drains the journal backlog. Called only from\nthe find subcommand when -near / -near-uri is set. The index file lives\nalongside the actor's Pebble DB so subsequent CLI invocations reuse it.
