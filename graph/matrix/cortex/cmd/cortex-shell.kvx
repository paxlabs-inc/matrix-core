  ^defines=matrix/cortex/cmd/cortex-shell/main.go

NODE id=matrix/cortex/cmd/cortex-shell.runDumpScope kind=func
  digest=b3:1b7617d11c83af8918a1e55ebabe07f3698dfa8ffb4da217f2a05ab61bb2939d file=cortex/cmd/cortex-shell/main.go range=972:991 lang=go exported=false byte_range=29589:30254
  sig=func runDumpScope(path string)
  doc=runDumpScope reads canonical CBOR Scope bytes from path, decodes,\nand prints a JSON-pretty view. Pure offline tool — does NOT verify\nthe scope (no key resolver wired here). Useful for inspecting a\nscope envelope received from a parent agent before plumbing it into\na sub-agent's Cortex.
EDGES
  ^defines=matrix/cortex/cmd/cortex-shell/main.go

NODE id=matrix/cortex/cmd/cortex-shell.runDumpWeights kind=func
  digest=b3:2461cc80588c116bbdcac8cf0cdaf38341a29a213dc8d30e7518147c6306eb17 file=cortex/cmd/cortex-shell/main.go range=645:664 lang=go exported=false byte_range=19658:20392
  sig=func runDumpWeights(c *cortex.Cortex)
  doc=runDumpWeights prints the per-actor learned salience.Weights from\nmeta/salience_weights as JSON. Cold start (key absent) prints the\nDefaultWeights set with a `cold_start: true` annotation so the caller\ncan tell apart "no EMA updates yet" from "learned but happens to\nmatch cold weights".
EDGES
  ^defines=matrix/cortex/cmd/cortex-shell/main.go

NODE id=matrix/cortex/cmd/cortex-shell.runFind kind=func
  digest=b3:5e88dc5e65c7a551a8f11906a52f02835f0a4963d3c7f135579c673088be56e0 file=cortex/cmd/cortex-shell/main.go range=745:888 lang=go exported=false byte_range=23012:26962
  sig=func runFind(c *cortex.Cortex, root, actor string, args []string)
  doc=runFind drives the §12 typed Find surface from the CLI. Supports a tiny\nsubset of the predicate AST so smoke tests can exercise the engine end\nto end:\n\n	find <Type|*> [-tag T]... [-eq field=value]... [-limit N] [-late]\n	              [-near "text"|-near-uri <uri>]\n	              [-from <uri> [-follow <type>:<dir>:<min..max>]]\n\nMore expressive querying is intentionally NOT exposed here; complex\npredicates belong in a real authoring layer, not a smoke shell.
EDGES
  ^defines=matrix/cortex/cmd/cortex-shell/main.go

NODE id=matrix/cortex/cmd/cortex-shell.runRebuild kind=func
  digest=b3:64364824feae02cb23b18af04163d09813f5c4ab6b66fec48bd4fab4b66bd970 file=cortex/cmd/cortex-shell/main.go range=472:499 lang=go exported=false byte_range=13519:14758
  sig=func runRebuild(c *cortex.Cortex, args []string)
  doc=runRebuild parses CLI flags and invokes cortex.Rebuild. With\n-verify-only, the post-rebuild root MUST equal the pre-drop root or\nthe command exits non-zero — useful in CI / disaster-recovery scripts\nto assert the §13.4 invariant on a real actor's data.
EDGES
  ^defines=matrix/cortex/cmd/cortex-shell/main.go

NODE id=matrix/cortex/cmd/cortex-shell.runUpdateHead kind=func
  digest=b3:8d22cd1cca63af2a415f0582fa4cf4315f20c4db85580e04bf5508814b7bcbcf file=cortex/cmd/cortex-shell/main.go range=890:970 lang=go exported=false byte_range=26964:29587
  sig=func runUpdateHead(c *cortex.Cortex, actor string, args []string)
  doc=runUpdateHead drives Phase 10 cortex.UpdateHead from the CLI:\n\n	update-head <uri> [-tag T]... [-frame V:K:R]...\n	            [-importance N] [-visibility private|scoped|actor_public]\n\nEmpty -tag/-frame flag sets are NOT a "remove all" — to clear, pass\nthe explicit -clear-tags / -clear-frames flag. Pointer-vs-zero\nsemantics mirrors the HeadPatch struct.
EDGES
  ^defines=matrix/cortex/cmd/cortex-shell/main.go

