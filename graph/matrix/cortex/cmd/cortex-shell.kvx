NODE id=matrix/cortex/cmd/cortex-shell.runCompact kind=func
  digest=b3:c43aed02e25a62ab4d05b175e6459bc922d17caeae84cf1657b2a0d8f84339da file=cortex/cmd/cortex-shell/main.go range=678:732 lang=go exported=false byte_range=20697:22629
  sig=func runCompact(c *cortex.Cortex, args []string)
  doc=runCompact parses CLI flags and invokes cortex.Compact. The positional\n<uri>... args form the InContext list; -load URI (repeatable) becomes\nLoadBearing; -dir sets CheckpointDir (filesystem mirror). Mirrors the\nresearch/03 §5.3 primitive signature.
EDGES
  ^defines=matrix/cortex/cmd/cortex-shell/main.go

NODE id=matrix/cortex/cmd/cortex-shell.runContext kind=func
  digest=b3:3987347fa87d290360f55a361b6aac2dde2f0af491b82f08f6c5d46671c916ad file=cortex/cmd/cortex-shell/main.go range=1021:1129 lang=go exported=false byte_range=31260:34369
  sig=func runContext(c *cortex.Cortex, args []string)
  doc=runContext drives the §12.1 Context bundle composer from the CLI:\n\n	context [-verb V] [-obj kind:ref]... [-include-tier t]...\n	        [-budget N] [-outcome-limit N] [-form short|medium|full]\n\nPrints one line per memory across the three tiers, plus a header\nwith bundle compile_metadata for latency/budget audit.
EDGES
  ^defines=matrix/cortex/cmd/cortex-shell/main.go

