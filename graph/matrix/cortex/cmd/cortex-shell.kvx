  ^defines=matrix/cortex/cmd/cortex-shell/main.go

NODE id=matrix/cortex/cmd/cortex-shell.runDumpSalience kind=func
  digest=b3:12753a506e7b219bf1661b6c4506d3375d32333535a8b16f89878e5a0c151b62 file=cortex/cmd/cortex-shell/main.go range=617:643 lang=go exported=false byte_range=18833:19656
  sig=func runDumpSalience(c *cortex.Cortex, uri string)
  doc=runDumpSalience reads salience/<id> for the memory referenced by uri\nand prints it as JSON. ID is parsed from the URI; the cached Score is\nread raw (no live recompute).
