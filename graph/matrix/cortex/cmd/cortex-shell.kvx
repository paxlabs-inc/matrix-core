  digest=b3:a3d1f8f4abf6e1d270d9f2e565fabb963dcf65ae5d49aefebc92ef5004a7ed5f file=cortex/cmd/cortex-shell/main.go range=501:559 lang=go exported=false byte_range=14760:16981
  sig=func runAttest(c *cortex.Cortex, actor string, args []string)
  doc=runAttest parses CLI flags and invokes cortex.Attest. Positional\n<uri>... args are the cited memories. Mirrors research/04-cortex.md §8.3\n"intent.attest" but the cortex-side primitive only — the MCL envelope\n+ agent-runtime wiring is out of scope for this CLI.
