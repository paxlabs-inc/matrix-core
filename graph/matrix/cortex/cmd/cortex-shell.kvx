NODE id=matrix/cortex/cmd/cortex-shell.parseFollowExpr kind=func
  digest=b3:984b4dca85b01e82d55dc531c81c975c33ad04d127d8a7721d0eb732c64807b3 file=cortex/cmd/cortex-shell/main.go range=1131:1178 lang=go exported=false byte_range=34371:35859
  sig=func parseFollowExpr(s string) (*query.EdgeExpr, error)
  doc=parseFollowExpr accepts <type>[,<type>...]:<dir>:<min..max> e.g.\n\n	references:out:1..2\n	references,corroborates:both:1..3\n\nEmpty type list (":out:1..2") means any type. Direction defaults to "out";\nhop range defaults to "1..1".
EDGES
  ^defines=matrix/cortex/cmd/cortex-shell/main.go

NODE id=matrix/cortex/cmd/cortex-shell.parseFrameSpec kind=func
  digest=b3:a0e921852aae8e1abc0659befb4ce7a840a98098c469521ae1af223f19845ddc file=cortex/cmd/cortex-shell/main.go range=993:1019 lang=go exported=false byte_range=30256:31258
  sig=func parseFrameSpec(s string) (memory.FrameRef, error)
  doc=parseFrameSpec parses one `verb:kind:ref` spec into a FrameRef. Verb\nand kind use the lower-case enum names from memory.ParseVerb /\nmemory.ParseObjKind. Ref is anything up to MaxObjRefLen; colons in\nthe ref are permitted by splitting on the first two ':'.
EDGES
  ^defines=matrix/cortex/cmd/cortex-shell/main.go

