NODE id=matrix/cortex/cmd/two-model-smoke.defaultScenario kind=func
  digest=b3:1f1cceab555e6b40e54c49f06b4fa2be2351391c869fea2482351c2b7ed5dcd3 file=cortex/cmd/two-model-smoke/scenario.go range=37:110 lang=go exported=false byte_range=1136:4677
  sig=func defaultScenario() Scenario
  doc=defaultScenario sets up collaborative knowledge construction. Agent\nA is the "Researcher": writes typed memories about a topic. Agent B\nis the "Reviewer": queries A's memories and asks for refinement /\nchallenges contradictions / proposes edges.\n\nBoth agents share one cortex actor; their identities (and the\nCreatedBy on each write) are "alice" (A, Researcher) and "bob" (B,\nReviewer). They see each other's writes via cortex_find /\ncortex_list and can build a connected memory graph.
EDGES
  ^defines=matrix/cortex/cmd/two-model-smoke/scenario.go

NODE id=matrix/cortex/cmd/two-model-smoke.detectProvider kind=func
  digest=b3:f190a6262e08c439107f03485b7283da87178e484a850ff41be23e31e4d1ab21 file=cortex/cmd/two-model-smoke/client.go range=52:64 lang=go exported=false byte_range=1305:1912
  sig=func detectProvider(model string) (Provider, error)
  doc=detectProvider maps a model string to its provider. Together's\ncatalog uses "openai/<model>" or "<vendor>/<model>" form; Fireworks\nuses "accounts/fireworks/models/<model>". Anything else returns an\nerror so misconfiguration fails loudly.
EDGES
  ^defines=matrix/cortex/cmd/two-model-smoke/client.go

