  sig=func die(format string, args ...interface{})
  doc=die prints a fatal message and exits with status 1.
EDGES
  ^defines=matrix/cortex/cmd/two-model-smoke/main.go

NODE id=matrix/cortex/cmd/two-model-smoke.finalRun kind=func
  digest=b3:e5b7c4334b0b0862f5ca7ed7f00707899c2f04b606c80016dc439b8632995028 file=cortex/cmd/two-model-smoke/main.go range=219:270 lang=go exported=false byte_range=7194:9220
  sig=func finalRun(c *cortex.Cortex, tr *transcript, skip bool)
  doc=finalRun captures pre/post OverallRoot via Cortex.Rebuild and asserts\nthey match. This is the strongest single-call cortex correctness\ncheck (research/04-cortex.md §13.4 "indexes are pure projection of\ncanonical state").
EDGES
  ^defines=matrix/cortex/cmd/two-model-smoke/main.go

