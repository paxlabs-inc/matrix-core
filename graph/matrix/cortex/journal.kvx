NODE id=matrix/cortex/journal.KindToolEvent kind=const
  digest=b3:61af3a3bc9c2e617f7197eb645dcd6c1eae2265ca6a4c235df84935ce5a3c098 file=cortex/journal/journal.go range=196:201 lang=go exported=true byte_range=11423:11777
  sig=journal.Kind
  doc=KindToolEvent is appended by the runtime after one real tool\nexecution. It carries the call identity, a digest of the result,\nprediction verdict, and owning subgoal. The entry itself is the\nintegrity anchor: the journal hook commits its canonical plaintext\nleaf into the MMR in the same atomic batch.
