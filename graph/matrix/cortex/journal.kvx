NODE id=matrix/cortex/journal.KindUpdate kind=const
  digest=b3:2927a867a40d79663990e84b2bb0fcce52fbd5d189016fe80226bf195161f1ce file=cortex/journal/journal.go range=40:40 lang=go exported=true byte_range=1671:1701
