NODE id=matrix/cortex/keys.RollupKey kind=func
  digest=b3:e3055ae1f9fc991ede78adef97d40efb16ee450878163256dcd2b194b3eea73c file=cortex/keys/keys.go range=926:942 lang=go exported=true byte_range=35339:36176
  sig=func RollupKey(tier uint8, start uint64) []byte
  doc=RollupKey returns roll/<tier:1><start:8 BE>.\n\nContinuous-memory task 2.1: the derived temporal-ladder rollup record for\none time window. The 1-byte tier followed by an 8-byte big-endian window\nstart (Unix nanoseconds, cast from int64) guarantees byte-sort == (tier,\nstart) sort, so a tier prefix scan (RollupTierPrefix) yields records in\nascending window-start order. Same key-family posture as chk/ (compaction\ncheckpoints) and sess/ (session transcript): a derived record keyed by its\nown identity — here the (tier, window-start) time window — NOT a 10th\nmemory type and never an anchored SMT write.
EDGES
  ^defines=matrix/cortex/keys/keys.go

NODE id=matrix/cortex/keys.RollupTierPrefix kind=func
  digest=b3:58a88b23a11fb168c893903eb2f74e77980bcba7cbf714367beeaa1da97ea59c file=cortex/keys/keys.go range=944:951 lang=go exported=true byte_range=36178:36468
  sig=func RollupTierPrefix(tier uint8) []byte
  doc=RollupTierPrefix returns roll/<tier:1>, the prefix for scanning every\nrollup of one tier in ascending window-start order.
EDGES
  ^defines=matrix/cortex/keys/keys.go

NODE id=matrix/cortex/keys.SalienceKey kind=func
  digest=b3:c7f589f7902bb1e43ad742f7db3838e74fac09d456ab0bde5ea222f1f3ef9648 file=cortex/keys/keys.go range=433:439 lang=go exported=true byte_range=16908:17118
  sig=func SalienceKey(id ULID) []byte
  doc=SalienceKey returns salience/<id:16>.
EDGES
  ^defines=matrix/cortex/keys/keys.go

NODE id=matrix/cortex/keys.SessionBlobKey kind=func
  digest=b3:5a80c855eeb085d906bec6d6d0a1597adf6b1d762f04a31189eb2ddfd7b001bc file=cortex/keys/keys.go range=907:924 lang=go exported=true byte_range=34612:35337
  sig=func SessionBlobKey(conv string, seq uint64) ([]byte, error)
  doc=SessionBlobKey returns sessblob/<lpstr conv><seq:8 BE>. Holds a large\ntool_result payload that was spilled out of the session record proper\n(overflow discipline — keeps sess/ a page-in target rather than resident\nbloat). Same layout/constraints as SessionKey.
EDGES
  ^defines=matrix/cortex/keys/keys.go

NODE id=matrix/cortex/keys.SessionConvPrefix kind=func
  digest=b3:5c08408d9c5203831946c570ca513664caf36ae8fe7cfbc211d5738581cb1fab file=cortex/keys/keys.go range=868:883 lang=go exported=true byte_range=33392:33976
  sig=func SessionConvPrefix(conv string) ([]byte, error)
  doc=SessionConvPrefix returns sess/<lpstr conv>, the prefix for scanning\nevery message record of one conversation in ascending seq order. Same\nconstraints as SessionKey.
EDGES
  ^defines=matrix/cortex/keys/keys.go

NODE id=matrix/cortex/keys.SessionKey kind=func
  digest=b3:592b545dd9fecefc1befbf7a44af2eaed5b43af1f66f917fc7d71e25e9f988f2 file=cortex/keys/keys.go range=843:866 lang=go exported=true byte_range=32413:33390
  sig=func SessionKey(conv string, seq uint64) ([]byte, error)
  doc=SessionKey returns sess/<lpstr conv><seq:8 BE>.\n\nContinuous-memory task 1.1: the durable session/transcript record for\none message. The 1-byte length-prefixed conversation id followed by an\n8-byte big-endian seq guarantees byte-sort == (conv, seq) sort, so a\nprefix scan on one conversation (SessionConvPrefix) yields records in\nascending seq order. The length prefix disambiguates conversations whose\nids are prefixes of one another (e.g. "a" vs "ab").\n\nconv must not contain '/' and must be <=255 bytes (validated).
EDGES
  ^defines=matrix/cortex/keys/keys.go

NODE id=matrix/cortex/keys.SnapshotKey kind=func
  digest=b3:f82fe7620d11fe984960836a72a85a38c00e135f930d6248860a47f346fc8b68 file=cortex/keys/keys.go range=425:431 lang=go exported=true byte_range=16704:16906
  sig=func SnapshotKey(seq uint64) []byte
  doc=SnapshotKey returns snap/<seq:8>.
EDGES
  ^defines=matrix/cortex/keys/keys.go

NODE id=matrix/cortex/keys.StoryKey kind=func
  digest=b3:1ae37496a769b9a06f77dfeb1faa1934895631187cda824ec76925c37dfc1343 file=cortex/keys/keys.go range=1013:1036 lang=go exported=true byte_range=38641:39638
  sig=func StoryKey(conv string) ([]byte, error)
  doc=StoryKey returns story/<lpstr conv>.\n\nContinuous-memory task 4.2: the durable per-conversation "story so far"\nrecord — a single record per conversation (NOT keyed by seq/window like\nsess/ or roll/) that is overwritten as the conversation's transcript\ngrows. The 1-byte length-prefixed conversation id disambiguates\nconversations whose ids are prefixes of one another, matching the\nSessionKey/RollupKey discipline. Same derived-lane posture: rebuildable\nfrom the conversation's own sess/ transcript, no anchored SMT write.\n\nconv must not contain '/' and must be <=255 bytes (validated).
EDGES
  ^defines=matrix/cortex/keys/keys.go

NODE id=matrix/cortex/keys.TagHashSize kind=const
  digest=b3:fd21b18ba857c2b85e88373f90ab61fa89df06f3bac80f298015644cc292571d file=cortex/keys/keys.go range=470:474 lang=go exported=true byte_range=18098:18407
  sig=untyped int
  doc=TagHashSize is the prefix length of the tag hash kept in idx/tag keys.\nEight bytes is sufficient: collision probability ≈ 1/2^32 between any two\ntags in an actor's tag set, which is bounded at MaxTagsPerMemory*N memories\n(well under 2^16 tags per actor in realistic loads).
EDGES
  ^defines=matrix/cortex/keys/keys.go

