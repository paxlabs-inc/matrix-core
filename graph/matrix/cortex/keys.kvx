  digest=b3:f8e21050a4b63b43e55ee2b6ba53775ab6255ff5a66cbc514d92281ee7b893ad file=cortex/keys/keys.go range=555:563 lang=go exported=true byte_range=21659:22035
  sig=func IdxFramePrefixVerb(verb byte) []byte
  doc=IdxFramePrefixVerb returns idx/frame/<verb:1>/, the broadest scan\nprefix. Used by debug tools that want to enumerate every frame entry\nfor one verb; the cortex.context composer never scans this wide.
EDGES
  ^defines=matrix/cortex/keys/keys.go

