NODE id=matrix/cortex/keys.ReadUint64BE kind=func
  digest=b3:24dd77959a53983ce4c5392628ea22c78d15224b7feed89c591c307c432534c0 file=cortex/keys/keys.go range=210:217 lang=go exported=true byte_range=9881:10180
  sig=func ReadUint64BE(src []byte) (v uint64, rest []byte, err error)
  doc=ReadUint64BE reads an 8-byte big-endian uint64 from src; returns the value\nand the remainder of src after the 8 bytes.
