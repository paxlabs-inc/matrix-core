NODE id=matrix/cortex/keys.IdxSMTNodeKey kind=func
  digest=b3:b6b233d9e3ff478468fd162c0e33d70ae7a549e811a9410d0e7a1d26bb1e0821 file=cortex/keys/keys.go range=724:748 lang=go exported=true byte_range=28080:29114
  sig=func IdxSMTNodeKey(ns string, depth uint16, path [32]byte) ([]byte, error)
  doc=IdxSMTNodeKey returns idx/smt/<ns>/n/<depth:2>/<path:32> for one SMT\ninternal node. Depth 0 = root level (subtree below has remaining depth\n256); depth 256 = leaf level. Path is the bit string from the root with\nthe top `depth` bits significant; lower bits MUST be zero (caller\nresponsibility, normalized via SMTNormalizePath).\n\nNamespace is a short ASCII tag ("memories", "edges"). The validator\nrejects '/' so the key is unambiguous.
EDGES
  ^defines=matrix/cortex/keys/keys.go

NODE id=matrix/cortex/keys.IdxTagKey kind=func
  digest=b3:01164cec8626fddb89fdc8d1428b9e652886aa760ebcd10328d28e74a60dbea7 file=cortex/keys/keys.go range=476:490 lang=go exported=true byte_range=18409:19113
  sig=func IdxTagKey(tagHash [TagHashSize]byte, createdUnixNano uint64, id ULID) []byte
  doc=IdxTagKey returns idx/tag/<tag_hash:8>/<created:8>/<id:16>.\n\n`tagHash` is the first 8 bytes of sha256(tag) (caller computed); we hash\nbecause tags are arbitrary user strings up to 64 bytes and we want\nfixed-width keys. Uniqueness is enforced by appending the full ID at the\ntail, so collisions in the 8-byte prefix only inflate scan candidates,\nthey never silently merge memories.
EDGES
  ^defines=matrix/cortex/keys/keys.go

