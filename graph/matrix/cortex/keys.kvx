  digest=b3:5357d69f0a614b6cb739db36e589f42e27bfd1784a5bc219ab64984373484a6b file=cortex/keys/keys.go range=637:644 lang=go exported=true byte_range=25041:25317
  sig=func IdxActorObjPrefixVerb(verb byte) []byte
