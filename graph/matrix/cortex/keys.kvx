  sig=func EnrichTierPrefix(tier uint8) []byte
  doc=EnrichTierPrefix returns enr/<tier:1>, the prefix for scanning every\nenrichment of one tier in ascending window-start order.
EDGES
  ^defines=matrix/cortex/keys/keys.go

