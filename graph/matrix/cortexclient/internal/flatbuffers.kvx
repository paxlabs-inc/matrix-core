NODE id=matrix/cortexclient/internal/flatbuffers.Builder.StartVector kind=method
  digest=b3:9e8263b5c06046435a444a7ebe97bb460b76b0aaebb97d41c007ae564cca4131 file=cortexclient/internal/flatbuffers/builder.go range=299:311 lang=go exported=true byte_range=8688:9153
  sig=func (b *Builder) StartVector(elemSize, numElems, alignment int) UOffsetT
  doc=StartVector initializes bookkeeping for writing a new vector.\n\nA vector has the following format:\n\n	<UOffsetT: number of elements in this vector>\n	<T: data>+, where T is the type of elements of this vector.
EDGES
  ^contains=matrix/cortexclient/internal/flatbuffers.Builder
  ^defines=matrix/cortexclient/internal/flatbuffers/builder.go

NODE id=matrix/cortexclient/internal/flatbuffers.Builder.WriteVtable kind=method
  digest=b3:7084e6462afaa15142cc3bd7a4b63b416240de333f7b78fc801e1d4988a63a55 file=cortexclient/internal/flatbuffers/builder.go range=97:205 lang=go exported=true byte_range=2230:5916
  sig=func (b *Builder) WriteVtable() (n UOffsetT)
  doc=WriteVtable serializes the vtable for the current object, if applicable.\n\nBefore writing out the vtable, this checks pre-existing vtables for equality\nto this one. If an equal vtable is found, point the object to the existing\nvtable and return.\n\nBecause vtable values are sensitive to alignment of object data, not all\nlogically-equal vtables will be deduplicated.\n\nA vtable has the following format:\n\n	  <VOffsetT: size of the vtable in bytes, including this value>\n	  <VOffsetT: size of the object in bytes, including the vtable offset>\n	  <VOffsetT: offset for a field> * N, where N is the number of fields in\n		        the schema for this type. Includes deprecated fields.\n\nThus, a vtable is made of 2 + N elements, each SizeVOffsetT bytes wide.\n\nAn object has the following format:\n\n	<SOffsetT: offset to this object's vtable (may be negative)>\n	<byte: data>+
EDGES
  ^contains=matrix/cortexclient/internal/flatbuffers.Builder
  ^defines=matrix/cortexclient/internal/flatbuffers/builder.go

