NODE id=matrix/vault.Boot kind=func
  digest=b3:89519c17638a12c27a33c33c90869232161b52067ddcca22058f87056d2dac02 file=vault/boot.go range=118:154 lang=go exported=true byte_range=3910:5164
  sig=func Boot(ctx context.Context, cfg Config) (*Session, error)
  doc=Boot brings up the vault for a per-user daemon. Its contract is fail-closed:\n  - Provider available: load an existing wrapped keyfile (or provision one),\n    open the UserVault, return an encrypting Session.\n  - Provider unavailable and Required: refuse (ErrVaultRequired) — the daemon\n    must not boot into plaintext mode.\n  - Provider unavailable and not Required: return a plaintext dev Session.\n\nA keyfile that exists but cannot be unwrapped (wrong/rotated-away KEK) is a\nhard boot refusal when Required, never a silent re-provision.
EDGES
  calls=matrix/vault.New,matrix/vault.loadOrProvision,matrix/vault.resolveProvider
  references=matrix/vault.Config,matrix/vault.ErrVaultRequired,matrix/vault.New,matrix/vault.Session,matrix/vault.cfg,matrix/vault.ctx,matrix/vault.err,matrix/vault.kp,matrix/vault.loadOrProvision,matrix/vault.resolveProvider,matrix/vault.uv,matrix/vault.v
  ^calls=matrix/executor/cmd/mcl-execute.runDaemon,matrix/executor/internal/snapshot.Manager.openSealedTarball,matrix/neo/cmd/neo.runServe,matrix/workforce/cmd/workforced.runContext
  ^references=matrix/executor/cmd/mcl-execute.runDaemon,matrix/executor/internal/snapshot.Manager.openSealedTarball,matrix/neo/cmd/neo.runServe,matrix/workforce/cmd/workforced.runContext
  ^defines=matrix/vault/boot.go

NODE id=matrix/vault.Config kind=type
  digest=b3:8ce945816eef5155f49d9c8c317f271d0c22e0e1e6ad05d18b3e153a60336833 file=vault/boot.go range=11:32 lang=go exported=true byte_range=88:1108
  sig=type Config struct {\n	// Required is the fail-closed switch. When true (production default) the\n	// vault MUST come up with a usable key or Boot refuses; no plaintext\n	// fallback exists. When false, a missing provider yields a dev/CLI plaintext\n	// Session.\n	Required	bool\n	// DataDir is the daemon's data root; the wrapped keyfile lives beside it.\n	DataDir	string\n	// UserDID identifies the user this daemon serves; it names the minted key.\n	UserDID	string\n	// Provider, when non-nil, is used directly (production injects a KMS-backed\n	// provider here). When nil, Boot resolves a dev provider from KEKHex/KEKFile.\n	Provider	KeyProvider\n	// KEKHex is a hex-encoded 32-byte KEK for dev/CLI use.\n	KEKHex	string\n	// KEKFile is a path to a file holding the KEK (32 raw bytes or hex text).\n	KEKFile	string\n	// KEKID names the KEK; empty defaults to "kek1".\n	KEKID	string\n}
  doc=Config describes how a daemon should bring up its vault at boot. A per-user\ndaemon holds exactly one user key, so one Config yields one Session.
EDGES
  contains=matrix/vault.Config#DataDir,matrix/vault.Config#KEKFile,matrix/vault.Config#KEKHex,matrix/vault.Config#KEKID,matrix/vault.Config#Provider,matrix/vault.Config#Required,matrix/vault.Config#UserDID
