# spec.kvx — Cody (the next-generation coding agent).
# SINGLE SOURCE for this feature's requirements + design + tasks. Rendered to
# requirements.md / design.md / tasks.md by spec/specgen. Do not edit the
# generated markdown; edit this file and regenerate.
#
# Format: Matrix .kvx (see tachyon/internal/config/kvx.go). One key = value per
# line; string values double-quoted; lists are ["a","b"]; # starts a comment.
# Schema:
#   [req.<n>]   title, story, ac_1..ac_n          (acceptance criteria, EARS)
#   [design]    overview, include="design.body.md" (rich prose/diagrams inlined)
#   [task.<id>] title, status, wave, reqs, requires (dotted ids: 1, 1.1, 1.2)

[meta]
feature      = "cody"
title        = "Cody — the next-generation coding agent"
status       = "draft"
spec_version = "0.1.0"
intro        = "Cody is a specialized coding agent serving both engineers and vibe coders, productizing the discipline Matrix was built with — recall-first memory, spec-driven planning, dependency-waved tasks, no-fakes verification, honest partials, complete artifacts — as STRUCTURAL engine enforcement, not prompting. Architecture (user-locked 2026-07-02): a NEW top-level cody/ module (sibling of neo/) importing the battle-tested Neo internals (llm client, cortex continuous-memory, delegate failure taxonomy, supervisor durability) but owning a coding-native loop. The orchestrator NEVER writes code: it Plans, Specs, Delegates — spawning ONE worker subagent per TASK (sequential, one alive at a time), handing it a self-contained unambiguous task sheet, independently verifying the turn-in (re-running verification + goal-vs-outcome adjudication), then accepting (checkpoint to cortex, discard worker transcript) or re-dispatching bounded with failure classification. Implementation noise never enters the orchestrator's window — that is what sustains long-horizon workloads. Modes = Prototype / Engineer / Architect: a policy tuple (planning depth, verify cadence, creativity, autonomy, explanation register); the constitution (no fakes, verify-before-done, read-full, honest partials, complete artifacts, user drives git, respect the project) binds in EVERY mode. Foundation (P1 of this same spec): migrate the per-user environment from Fly Machines to Railway — a deployed service + volume running Ubuntu 24.04 that hosts the entire daemon stack PLUS a baked dev toolchain, with /workspace on the volume; wake-on-request preserves scale-to-zero. Cody skips MCL entirely (coding is not value-moving; no core_execute, no signing). Reuses the existing arsenal: agents/cody.json over the deployed MCP bridges (fs/exec/git/browser/fetch/web-search), rules/common + rules/<language> injected per detected stack, the 186-skill library, own gateway slot 'cody'. v1 surface = a coding workspace in apps/client (chat + mode dial, file tree, diff review, terminal, dev-server preview)."

[design]
overview = "See the full design below: the two load-bearing ideas (the environment is the machine; the orchestrator never writes code), the locked decisions, a code-grounded seam map (fly.go provisioner seam, agents/neo.json tool surface, rules/ + skills/, neo internals, continuous-memory, Cassandra adjudication, failure taxonomy), the Railway migration (Provisioner interface, wake-on-request inversion, the Ubuntu 24.04 dev-environment image), the Cody engine (orchestrator cycle, task-sheet and turn-in contracts, workspace model / edit engine / verification runner / checkpoints), the constitution, the mode policy tuples, system map, codyd server shape, config knobs, migration/retro-compat, non-goals, and the no-fakes verification strategy. Authored as a rich markdown fragment (design.body.md) and inlined verbatim."
include  = "design.body.md"

# ============================== REQUIREMENTS ==============================

[req.1]
title = "Provider-neutral provisioner abstraction in the router"
story = "As the operator, I want the router's machine provisioning behind a provider-neutral interface, so that the per-user environment can move to Railway without rewriting the admin/proxy/wake flows and with Fly intact as a fallback."
ac_1 = "THE router SHALL define a Provisioner interface covering ensure/create, status, wake, and destroy of a per-user environment plus its persistent volume."
ac_2 = "THE existing Fly Machines client (router/internal/fly) SHALL be one conforming implementation with behavior unchanged and its existing tests green."
ac_3 = "A new Railway implementation (router/internal/railway) SHALL conform to the same interface using Railway's public API, covering service + volume + deployment lifecycle."
ac_4 = "THE active provider SHALL be selected by configuration (fly | railway) per deployment; admin.StartProvision, proxy.EnsureStarted, and the chronos wake path SHALL consume only the interface."
ac_5 = "PROVISION status (provision_jobs, GET /provision/status) SHALL report Railway deployment readiness so the onboarding readiness gate keeps working unchanged."

[req.2]
title = "Ubuntu 24.04 per-user dev-environment image"
story = "As a user, I want my private environment to be a full development machine, so that Cody codes where my files live with real toolchains, and my code persists on my volume."
ac_1 = "THE environment image SHALL be Ubuntu 24.04 hosting the entire existing daemon stack (MCL daemon, Neo, MCP tool bridges) plus codyd."
ac_2 = "THE image SHALL bake a dev toolchain including at minimum git, build-essential, Node + pnpm, Go, Python + uv, and Rust."
ac_3 = "THE persistent volume SHALL mount /data (daemon state) and /workspace (user code); /workspace SHALL remain the root served by the fs/git/exec MCP servers so the existing tool surface transfers unchanged."
ac_4 = "DEV servers started via the exec bridge's supervised services SHALL be reachable for preview through the environment's networking."

[req.3]
title = "Wake-on-request (scale-to-zero preserved)"
story = "As the operator, I want slept environments to wake on inbound traffic, so that per-user economics stay scale-to-zero on Railway without an explicit start API."
ac_1 = "WHEN a request arrives for a slept environment, THE router proxy SHALL forward it as the wake signal and absorb cold-start latency via the existing daemon-readiness probing, within the configured wake budget."
ac_2 = "THE chronos /internal/wake path SHALL wake the environment and deliver the timer-triggered turn on Railway semantics."
ac_3 = "WHILE the environment is waking, THE router SHALL respond with the same retry semantics the client already handles (the provisioning/loading path), not a hard failure."

[req.4]
title = "Cody orchestrator — Plans, Specs, Delegates; never writes code"
story = "As a user, I want Cody's main loop to stay a lean planner/verifier, so that it sustains long-horizon projects without drowning its context in implementation noise."
ac_1 = "THE orchestrator SHALL NOT edit files or run implementation commands; its only executions SHALL be verification re-runs and read-only inspection."
ac_2 = "THE orchestrator cycle SHALL be: understand (workspace model + cortex recall) -> plan (waved task list, depth per mode) -> spec the next eligible task into a task sheet -> delegate to ONE worker -> independently verify the turn-in -> accept or re-dispatch -> loop."
ac_3 = "EXACTLY ONE worker SHALL be alive at a time; delegation SHALL be per task, never per wave."
ac_4 = "ON acceptance, THE worker transcript SHALL be discarded; only the turn-in report and the cortex checkpoint SHALL persist in the orchestrator's context."
ac_5 = "THE orchestrator window after N accepted tasks SHALL contain the plan, task sheets, and turn-in reports — no worker implementation transcripts."

[req.5]
title = "The task sheet — self-contained delegation contract"
story = "As a worker, I want a detailed unambiguous implementation sheet for exactly one task, so that I can execute with zero conversation history."
ac_1 = "EACH task sheet SHALL carry: the goal (what done means), testable acceptance criteria, grounding (exact files/seams/line refs and the read-before-write set), constraints (constitution + mode policy + applicable rules/<language> refs), the verification commands that must be green, and the deliverable shape including what NOT to touch."
ac_2 = "THE sheet SHALL be self-contained: a fresh-context worker SHALL be able to execute it without access to the orchestrator's conversation history."
ac_3 = "SHEETS SHALL be durable records (persisted with the plan) so a crashed worker is replaceable by a fresh one from the same sheet."

[req.6]
title = "The worker — fresh context, full tools, structured turn-in"
story = "As the orchestrator, I want workers that implement exactly one sheet and report evidence, so that acceptance is decidable from the report plus my own verification."
ac_1 = "EACH worker SHALL start with a fresh context containing only the task sheet and a minimal grounding bundle."
ac_2 = "WORKERS SHALL have the full coding tool surface (fs, exec incl. supervised services, git, browser, fetch, web-search) plus the edit engine and verification runner."
ac_3 = "EACH worker SHALL return a structured turn-in report: status (done|partial|blocked), changes (path/kind/why), verification evidence (real command output), and honest gaps/assumptions."
ac_4 = "IF a worker crashes or its run is lost, THE orchestrator SHALL dispatch a fresh worker from the same sheet (task durability at the task level)."

[req.7]
title = "Acceptance gate — independent verification + bounded re-dispatch"
story = "As the user, I want Cody to never take a worker's word for it, so that accepted work is genuinely done."
ac_1 = "ON turn-in, THE orchestrator SHALL independently re-run the sheet's verification commands; acceptance SHALL be impossible without a green verification record."
ac_2 = "THE orchestrator SHALL adjudicate the turn-in goal-vs-outcome (Cassandra-style: does the outcome satisfy the sheet's goal and acceptance criteria), not by string-matching the report."
ac_3 = "ON rejection, THE orchestrator SHALL re-dispatch with concrete feedback, bounded by a configured attempt ceiling (default 3)."
ac_4 = "WORKER failures SHALL be classified via the delegate failure taxonomy; deterministic failures SHALL stop-and-ask the user instead of burning re-dispatch attempts."
ac_5 = "ON acceptance, THE orchestrator SHALL write a durable progress checkpoint to cortex."

[req.8]
title = "The constitution — engine-enforced invariants, every mode"
story = "As the user, I want unchanging quality rules that no mode can relax, so that Cody's output holds a standard it never breaks."
ac_1 = "NO FAKES: workers SHALL NOT introduce stub/mock/fake doubles or placeholder implementations to make verification pass; violations SHALL cause rejection at the acceptance gate."
ac_2 = "VERIFY BEFORE DONE: no task SHALL be marked done without green verification + adjudication (structurally gated, not prompted)."
ac_3 = "READ FULL: WHEN tool output is truncated with the remainder retrievable, THE engine SHALL retrieve it in full before reasoning (overflow-file discipline), in both roles."
ac_4 = "NO FALSE SUCCESS: partials SHALL surface as partials in turn-in reports and user-facing completion reports."
ac_5 = "COMPLETE ARTIFACTS: deliverables SHALL be runnable with dependencies and run instructions, never fragments."
ac_6 = "USER DRIVES GIT: Cody SHALL stage, diff, and propose, but commit/push only on explicit user instruction."
ac_7 = "RESPECT THE PROJECT: workers SHALL follow existing repo style and SHALL NOT make drive-by comments/docs/refactors outside the sheet's scope; tests SHALL never be weakened or deleted to pass."

[req.9]
title = "Modes — Prototype / Engineer / Architect as policy tuples"
story = "As a user, I want to dial ceremony to my intent — spike fast or build for the long haul — without ever trading away the constitution."
ac_1 = "A MODE SHALL be a policy tuple over: planning depth, verification cadence, creativity temperature, autonomy level, and explanation register — one engine, no mode-specific loops."
ac_2 = "PROTOTYPE SHALL plan tersely inline, verify at milestones and at done, favor creative opinionated defaults, and speak in outcome language."
ac_3 = "ENGINEER (default) SHALL plan a waved task list and verify after every task."
ac_4 = "ARCHITECT SHALL author durable spec files (EARS requirements, design, waved tasks) persisted in the workspace, verify per task with property tests, and be resumable across sessions."
ac_5 = "THE constitution (req.8) SHALL bind identically in every mode."
ac_6 = "MODEL policy SHALL be per role and mode-aware (orchestrator may pin a stronger model; Prototype workers may run faster models), all through the cody gateway slot."

[req.10]
title = "Coding-native primitives — workspace model, edit engine, verification runner, checkpoints"
story = "As the engine, I want precise repo-aware primitives, so that edits are safe, verification is the project's own truth, and progress survives anything."
ac_1 = "THE workspace model SHALL maintain a persistent repo index over /workspace (tree, languages, frameworks, build targets, entry points) across sessions on the volume."
ac_2 = "THE edit engine SHALL apply anchored edits with staleness detection: an edit SHALL fail if the target file changed since it was read, never blind-overwrite."
ac_3 = "THE verification runner SHALL detect the project's own commands (package.json scripts, Makefile, go.mod, cargo, pytest, ...) and run build/test/lint/typecheck as first-class loop steps."
ac_4 = "CHECKPOINT/ROLLBACK SHALL snapshot the workspace before risky multi-file changes and restore on request; per-task progress checkpoints SHALL persist to cortex and survive process restarts."

[req.11]
title = "Standards + skills injection"
story = "As the user, I want Cody to hold our stack-specific standards and deep playbooks, so that its code quality is engineer-level by construction."
ac_1 = "CODY SHALL inject rules/common/* plus the applicable rules/<language>/* into its working policy per the detected stack, and task sheets SHALL reference the applicable rule files as constraints."
ac_2 = "CODY SHALL surface the skills/ library through the existing skill mechanism as on-demand deep-domain playbooks."

[req.12]
title = "Memory — cortex continuous-memory as Cody's long-horizon substrate"
story = "As a user, I want Cody to remember my project across sessions and machines restarts, so that long-horizon work resumes exactly where it left off."
ac_1 = "CODY SHALL persist per-project memory (decisions, checkpoints, story-so-far) via the cortex continuous-memory surfaces (AppendMessage / Activate / recursive recall)."
ac_2 = "WHEN codyd restarts or a session refreshes mid-plan, THE orchestrator SHALL resume from cortex checkpoints at the correct next task with its lean context reconstructed (plan + reports, no transcripts)."

[req.13]
title = "codyd server, manifest, and gateway slot"
story = "As the platform, I want Cody deployed like Neo — a first-class agent with its own manifest and metered slot — so that it inherits the proven serving shape."
ac_1 = "codyd SHALL run in the per-user environment beside Neo following the proven shape: engine + session supervisor + SSE broker + durable trace, mounted behind the router under the user's JWT."
ac_2 = "agents/cody.json SHALL define Cody's tool manifest reusing the deployed MCP bridges (fs, exec, git, browser, fetch, web-search) with NO value-moving surface."
ac_3 = "CODY SHALL register its own gateway LLM slot 'cody' (types slot + routing validSlot + rates whitelist entry), never borrowing another agent's slot; the rate card values remain operator-owned."
ac_4 = "CODY SHALL NOT hold a signing key, SHALL NOT route through the MCL walk, and SHALL NOT modify Neo, the Liaison boundary, or the wallet seam."

[req.14]
title = "Client coding workspace"
story = "As a user (engineer or vibe coder), I want a coding workspace in the Matrix client, so that I can direct Cody, review its work, and see my running app."
ac_1 = "apps/client SHALL gain a Cody coding workspace: chat with a mode selector, workspace file tree, diff review pane, live terminal attached to the environment, and dev-server preview."
ac_2 = "THE surface SHALL follow the durable-trace + live-SSE reducer pattern so the workspace rebuilds on reopen."
ac_3 = "THE surface SHALL show the RESULT, not the protocol (no orchestrator/worker/sheet jargon in consumer-facing copy), with the explanation register following the active mode."
ac_4 = "UI house rules SHALL hold: separation by background-color contrast only (never border strokes for depth); no emojis, purple gradients, or glow effects."

[req.15]
title = "Real verification — no fakes"
story = "As the owner, I want every pillar proven against real code paths, so that Cody ships genuinely working."
ac_1 = "PROVISIONER conformance SHALL be tested against recorded Railway API fixtures via httptest (mirroring fly_test.go), with the Fly implementation's existing tests still green."
ac_2 = "WAKE-ON-REQUEST SHALL be proven by a proxy integration test where the first forwarded request to a slept-service simulation succeeds within the wake budget."
ac_3 = "THE sheet/turn-in round-trip SHALL be proven end-to-end: a real orchestrator authors a sheet for a seeded real repo; a real worker executes it in a real workspace; the report carries real verification output."
ac_4 = "THE acceptance gate SHALL be proven structural: a turn-in claiming success with red verification is rejected; a green turn-in is accepted and checkpointed to real cortex."
ac_5 = "RE-DISPATCH policy SHALL be proven: deterministic failures stop-and-ask after classification; transient failures re-dispatch bounded by the ceiling."
ac_6 = "CONTEXT economy SHALL be proven on the real message window: after N accepted tasks the orchestrator context holds plan + sheets + reports only."
ac_7 = "DURABILITY SHALL be proven: killing codyd mid-plan and restarting resumes from cortex checkpoints at the correct next task."
ac_8 = "MODES SHALL be proven: the same seeded task under Prototype vs Architect exhibits the policy differences while both hold the constitution."
ac_9 = "NO test in this feature SHALL substitute a stub/mock/fake for a real code path or type to manufacture a pass."

# ================================ TASKS ==================================

[tasks]
heading = "Implementation Plan: Cody — the next-generation coding agent"

