validates = "Requirements 6.1, 6.2, 7.1, 7.2"
requires  = ["4.1", "4.2", "4.3"]

[task.6.4]
title  = "Memory dedup + per-turn pinned compute against real cortex"
status = "pending"
wave   = 7
do_1   = "Against the real cortex store + pager: assert no near-duplicate writes under a deliberately-flaky classify model, and assert a multi-step turn issues materially fewer pinned-block cortex scans than the per-step baseline"
property  = "Property 4: clean memory writes + reduced read cost, content unchanged"
validates = "Requirements 9.1, 9.2, 10.1, 10.4"
requires  = ["5.1", "5.4"]

[task.6.5]
title  = "Non-perturbation check (signed walk + gate UI untouched)"
status = "pending"
wave   = 7
do_1   = "Assert the signed MCL path journaled bytes + D11 replay roots are byte-identical before/after this feature, and that gate.invoked/gate.decided + wallet-approval.tsx are unchanged (only REACHED via attach)"
