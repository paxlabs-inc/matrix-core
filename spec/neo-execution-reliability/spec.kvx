# spec.kvx — Neo Execution Reliability. SINGLE SOURCE for this feature's
# requirements + design + tasks. Rendered to requirements.md / design.md /
# tasks.md by spec/specgen. Do not edit the generated markdown; edit this file
# and regenerate.
#
# Format: Matrix .kvx (see tachyon/internal/config/kvx.go). One key = value per
# line; string values double-quoted; lists are ["a","b"]; # starts a comment.
# Schema:
#   [req.<n>]   title, story, ac_1..ac_n          (acceptance criteria, EARS)
#   [design]    overview, include="design.body.md" (rich prose/diagrams inlined)
#   [task.<id>] title, status, wave, reqs, requires (dotted ids: 1, 1.1, 1.2)

[meta]
feature      = "neo-execution-reliability"
title        = "Neo Execution Reliability (the conversational seam)"
status       = "in_progress"
spec_version = "0.1.0"
intro        = "Harden the conversational-orchestration seam that wraps Neo's agent loop around the MCL execution daemon — the layer where a request becomes one or more core_execute delegations, where tool failures are retried, where the supervisor respawns agents, where narration is emitted to the chat stream, and where durable learnings are written back to cortex. A deep audit (findings NE-1..NE-15 in cortex under matrix://knowledge/audit/neo-execution and /neo-memory) established that the rigorous MCL walk is solid and every fracture lives at this seam. The motivating incident was a token launch ('SPARK') that looped: the first core_execute submission succeeded and parked at the spend-approval gate, but every re-submission hit a hard HTTP 409 'intent already exists in async registry'. Neo treated the 409 as transient, reworded the intent and re-submitted (defeating its own no-progress guard), spammed an identical narration bubble each attempt, and leaked raw protocol jargon into the user-visible Thinking panel — so the approval the user needed never appeared. This feature is scoped to four audit clusters: (A) error taxonomy and retry policy, (B) UX/transparency, (C) concurrency/idempotency, (D) memory consistency. It EXPLICITLY leaves the rigorous MCL walk and the existing inline spend-approval UI (wallet-approval.tsx) untouched, and preserves the key-isolation backstop and the D11 replay byte-identity invariant. These requirements trace to the approved design (rendered into design.md)."

[design]
overview = "See the full design below: the seam map (which finding lives where), the shared error taxonomy (transient | deterministic | conflict/idempotent-join | pending/clarify), the attach-to-existing flow that lets the existing approval gate appear, the narration coalescing + jargon-scrub model, the memory-consistency changes, the explicit non-goals (the signed MCL walk and the gate UI), and the preserved invariants."
include  = "design.body.md"

# ============================== REQUIREMENTS ==============================

[req.1]
title = "Shared failure classification (transient | deterministic | conflict | pending)"
story = "As the system owner, I want every failure crossing the Neo<->MCL seam classified by a single shared taxonomy, so that the retry/stop/attach/ask decision is principled instead of treating all errors as transient."
ac_1 = "THE seam SHALL classify each delegate/daemon outcome into exactly one of: transient (connection refused, timeout, 5xx, rate-limit), deterministic (a 4xx that will recur identically: validation reject, leash denial, wrong-strategy/not-owner, unparseable intent), conflict (a deterministic-id 409 'already exists'), or pending (a structured 422 needing slot values)."
ac_2 = "WHEN an outcome is transient, THE seam SHALL retry with bounded backoff (current behavior), and SHALL NOT exceed the configured attempt ceiling."
ac_3 = "WHEN an outcome is deterministic, THE seam SHALL NOT retry it and SHALL NOT respawn over it, and SHALL surface it as a terminal, plain-language result so the agent stops-and-asks or reports an honest partial."
ac_4 = "THE classification SHALL be applied at BOTH the tool-dispatch ladder (dispatchWithRetry / dispatchCoreExecute) and the supervisor (superviseDecision), from one shared classifier, so the two layers never disagree."
ac_5 = "WHERE the model-call ladder already short-circuits provider rejects (ErrProviderRejected), THE tool-dispatch ladder SHALL short-circuit deterministic tool failures analogously."

[req.2]
title = "Idempotent core_execute — attach-to-existing on conflict"
story = "As a user, I want a re-dispatched action to JOIN the work already in flight rather than fail, so that a launch parks at its approval gate once instead of looping on a conflict."
ac_1 = "WHEN a core_execute submission returns a deterministic-id conflict (409 'already exists in async registry'), THE seam SHALL treat it as conflict (work already in flight), NOT as a failure, and SHALL NOT retry it as a fresh submission."
ac_2 = "WHEN a conflict is detected, THE delegate SHALL resolve the existing intent's status (the async status and pending gates) and ATTACH to it — polling its progress and servicing its approval gate — exactly as if it had created the run."
ac_3 = "WHERE attach-to-existing is performed, THE existing run's gate SHALL surface to the user through the SAME gate.invoked path the original submission would have used, so the inline spend-approval UI appears."
ac_4 = "THE attach path SHALL be idempotent and safe under concurrency: two attaches to the same intent SHALL NOT double-answer a gate nor double-count a result."
ac_5 = "IF the conflicting intent is already terminal (completed/failed/cancelled) by the time of attach, THEN the seam SHALL return that terminal outcome in plain language rather than re-submitting."

[req.3]
title = "No blind retry/respawn of deterministic failures"
story = "As a user, I want Neo to stop and tell me when something genuinely cannot proceed, so that I never watch it loop 'still on it' over a wall it cannot pass."
ac_1 = "WHEN a tool call fails deterministically, THE dispatch ladder SHALL return a single terminal result for that call and SHALL NOT issue further attempts for it."
ac_2 = "WHEN an agent turn ends because of a deterministic failure (not a transient/model/stall error), THE supervisor SHALL NOT respawn a fresh agent over the identical durable state, and SHALL route to a stop-and-ask / honest-partial surface instead."
ac_3 = "WHEN the supervisor declines to respawn a deterministic failure, THE user-facing message SHALL state plainly what blocked the task and what the user can do, and SHALL NOT be the generic 'still on it, taking another run at it' copy."
ac_4 = "THE respawn budget SHALL be reserved for transient/recoverable failures, so a deterministic failure cannot exhaust it."

[req.4]
title = "Semantic loop detection (reworded retries are caught)"
story = "As a user, I want Neo to notice when it is retrying the same operation in different words, so that a cosmetic reword cannot defeat its own no-progress guard."
ac_1 = "THE no-progress guard SHALL detect repeated attempts at the SAME operation (same tool + same target/operation intent) even when the surface wording of the arguments differs, and SHALL NOT rely solely on a byte-identical argument signature."
ac_2 = "WHEN the same operation deterministically fails N consecutive times (N configurable), THE guard SHALL treat it as a stall and route to stop-and-ask, rather than allowing unbounded reworded re-attempts."
ac_3 = "THE semantic loop detection SHALL NOT false-trip on legitimately distinct operations that happen to share a tool (e.g. reading two different pools)."

[req.5]
title = "Batch idempotency — non-idempotent tool calls cannot self-collide"
story = "As the system owner, I want a single assistant turn to never collide with itself, so that two core_execute calls in one batch don't deterministically 409."
ac_1 = "WHEN an assistant turn emits a batch of tool calls, THE dispatcher SHALL dedup or serialize non-idempotent / state-touching calls (core_execute in particular) so that two equivalent calls in one batch do not both submit."
ac_2 = "THE dispatcher SHALL preserve concurrent dispatch for genuinely independent, reversible read/side-effect-free calls (no latency regression for the common case)."
ac_3 = "WHERE two calls in a batch resolve to the same deterministic intent id, THE dispatcher SHALL run one and join the other to its result, rather than submitting both."

[req.6]
title = "Jargon-free tool results and a guarded reasoning channel"
story = "As a user, I want to see plain-language outcomes and never raw protocol internals, even in Neo's 'thinking', so that the experience reads as a capable assistant, not a stack trace."
ac_1 = "WHEN the delegate returns a tool result for a daemon outcome (success, denial, conflict, clarify, or error), THE result text SHALL be plain language drawn from a fixed phrase set and SHALL NOT interpolate raw HTTP status codes, response bodies, intent ids, or any term in the jargon-deny set {MCL, cortex, Merkle, replay, SSE, D11, broker, envelope, async registry, calldata, ABI selector, nonce}."
ac_2 = "THE reasoning channel (chat.delta channel=reasoning, the Thinking panel) SHALL be guarded against the same jargon-deny set before it streams to the user, so protocol internals do not surface even when the model names them."
ac_3 = "WHEN a daemon denial or revert occurs, THE surfaced reason SHALL map to a user-meaningful cause (e.g. over your spend cap, mode does not allow this, needs your approval, work already in progress) and SHALL NOT display raw error codes or selectors."
ac_4 = "THE jargon scrub SHALL apply only to user-facing transcript/reasoning surfaces and SHALL NOT alter the model's actual tool-result INPUT semantics in a way that hides the failure class from the agent (the agent still learns it failed and why, in clean terms)."

[req.7]
title = "Narration coalescing (no repeated identical bubbles)"
story = "As a user, I want one clear status line per real step, so that I don't see a wall of identical 'routing this through the secure path' bubbles."
ac_1 = "WHEN Neo would emit narration identical to the immediately-preceding narration turn on the same run, THE emitter SHALL coalesce it into the existing bubble (optionally with a subtle repeat indicator) rather than appending a duplicate."
ac_2 = "THE client reducer SHALL also defend against duplicate narration that shares text but differs in seq, so the thread does not stack identical bubbles even if the server emits them."
ac_3 = "THE delegate's 'I'll ask before anything spends' promise narration SHALL be emitted only once a submission has actually been accepted/attached, and SHALL NOT be emitted on every attempt."
ac_4 = "Narration coalescing SHALL NOT hide genuinely distinct progress updates (different text) — only exact-duplicate consecutive turns are collapsed."

[req.8]
title = "Structured clarify pass-through (slot-fill, not reword)"
story = "As a user, I want Neo to ask me the specific missing detail and then continue the same task, so that a clarify doesn't turn into a reword-and-resubmit loop."
ac_1 = "WHEN the daemon returns a structured clarify (HTTP 422 with typed slot questions), THE delegate SHALL carry the slot schema (slot_name/type_name/prompt) back to Neo as an actionable clarify, and SHALL NOT flatten it to an opaque text error."
ac_2 = "WHEN Neo obtains the user's answers to a clarify, THE seam SHALL re-POST the SAME intent id with slot_values, and SHALL NOT submit freshly reworded prose that mints a new intent id."
ac_3 = "IF a clarify cannot be satisfied (the user declines or the answer is unusable), THEN Neo SHALL surface that plainly and SHALL NOT loop re-submitting."

[req.9]
title = "Memory write-path — dedup-first and supervised pinning"
story = "As a user, I want Neo's durable memory to stay clean and to never silently pin a wrong 'fact' about me to every conversation, so that it behaves consistently and never feels like it learned the wrong thing."
ac_1 = "BEFORE the LLM relation classify, THE consolidator SHALL run a deterministic near-duplicate check (embedding cosine over the same-type neighbors) and SHALL skip writing a memory that is highly similar to an existing one rather than writing a new record."
ac_2 = "WHEN the relation classify model errors or is unavailable AND the new memory is highly similar to an existing one, THE consolidator SHALL skip the write (or supersede), and SHALL NOT default to writing it as a brand-new record."
ac_3 = "WHEN the write-back extracts a user_fact or a correction (both pinned to every future turn), THE write SHALL require a confidence threshold and SHALL carry provenance, so a low-confidence one-off is not pinned."
ac_4 = "THE system SHALL expose a user-visible, user-editable view of what Neo has learned about the user (the pinned user facts + standing corrections) so a wrong pin can be seen and removed."
ac_5 = "THE system SHALL decay or retire standing corrections that go unused over time, so the pinned guidance reflects current behavior."

[req.10]
title = "Pinned-block cost and consistent learned-guidance"
story = "As a user, I want Neo to apply what it learned consistently and without latency drag, so that long tool turns stay responsive and a learned behavior doesn't flicker in and out."
ac_1 = "THE pinned block SHALL be computed at most once per turn (not once per agent-loop step), via hoisting or a cache invalidated on cortex writes, with no change to the pinned CONTENT the model sees."
ac_2 = "THE learned-guidance selection SHALL apply standing corrections consistently across turns (always-pinned, capacity-managed by consolidation) rather than as a lossy salience-ranked top-N that can drop a learned behavior from one turn to the next."
ac_3 = "WHERE multiple learned-guidance lines overlap, THE system SHALL consolidate them so near-duplicates do not crowd the pinned budget."
ac_4 = "THE change SHALL be measurable: a multi-step turn SHALL issue materially fewer cortex scans for the pinned block than the per-step baseline."

[req.11]
title = "Non-perturbation — the signed MCL walk and the gate UI are untouched"
story = "As a system integrator, I want this feature to change ONLY the conversational seam, so that the rigorous execution path and the working approval UI are preserved exactly."
ac_1 = "THE feature SHALL NOT modify the signed MCL execution path (compile/plan/walk/synthesize/critic/emitFinalTurn) nor any journaled bytes, and SHALL preserve the D11 replay byte-identity invariant."
ac_2 = "THE feature SHALL NOT rewrite the inline spend-approval UI (wallet-approval.tsx) nor the gate.invoked/gate.decided contract; it SHALL only ensure the existing gate is REACHED (via attach-to-existing) and rendered."
ac_3 = "THE feature SHALL preserve the key-isolation backstop: Neo holds no signing key and all value-moving work crosses into MCL through core_execute."
ac_4 = "WHERE behavior changes, THE change SHALL affect only non-signed transcript events, tool-result text, retry/respawn control flow, narration emission, and cortex write/read access patterns."

[req.12]
title = "Real verification — no fakes"
story = "As the system owner, I want the seam fixes proven against real code paths, so that a green result reflects genuine behavior under the actual failure modes."
ac_1 = "THE feature SHALL verify the error classifier against REAL daemon responses (a real 409 conflict, a real 403 leash denial, a real 422 clarify, a real 5xx), and SHALL NOT assert against hand-faked status strings only."
ac_2 = "THE feature SHALL verify attach-to-existing end-to-end: a second core_execute for an in-flight intent attaches and surfaces the SAME pending gate, against a real daemon async registry, with no second submission."
ac_3 = "THE feature SHALL verify the jargon scrub and narration coalescing with a reproduction of the SPARK transcript (the looping launch) and assert the user-visible stream contains no jargon-deny terms and no duplicate consecutive bubbles."
ac_4 = "THE feature SHALL verify the memory dedup and per-turn pinned compute against the real cortex store and the real pager, asserting no near-duplicate writes under a flaky classifier and a reduced scan count per multi-step turn."
ac_5 = "Tests SHALL exercise REAL types and REAL code paths (no stub/mock test doubles standing in for the daemon, delegate, or pager logic under test)."

# ================================ TASKS ==================================

[tasks]
heading = "Implementation Plan: Neo Execution Reliability"

[task.1]
section = "P1 — Shared error taxonomy (Cluster A foundation)"
title   = "A single shared failure classifier across the seam"
status  = "done"

[task.1.1]
title  = "Define the failure classification (transient | deterministic | conflict | pending) over delegate/daemon outcomes"
status = "done"
wave   = 1
do_1   = "Add a classifier in neo/internal/delegate that maps an HTTP status + structured body to a typed class; 409 already-exists -> conflict, 403 leash/mode/cap -> deterministic, 422 clarify -> pending, 5xx/timeout/conn-refused -> transient, validation/unparseable -> deterministic"
do_2   = "Carry the class on the error returned to neo/internal/agent so dispatchWithRetry and the supervisor read the SAME classification (no per-layer re-guessing)"
reqs   = ["1.1", "1.4"]

[task.1.2]
title  = "Short-circuit deterministic tool failures in the dispatch ladder"
status = "done"
wave   = 2
do_1   = "In dispatchWithRetry/dispatchCoreExecute, when the class is deterministic, return a single terminal result with NO further attempts (mirror chatWithRetry's ErrProviderRejected short-circuit)"
do_2   = "Keep bounded backoff for transient; leave conflict/pending to their dedicated handlers (tasks 2.x / 4.x)"
reqs   = ["1.2", "1.3", "1.5", "3.1"]
requires = ["1.1"]

[task.1.3]
title  = "Teach the supervisor to not respawn deterministic failures"
status = "done"
wave   = 2
do_1   = "In session.go superviseDecision, branch on the failure class: deterministic -> stop-and-ask / honest-partial surface (no respawn, do not consume the respawn budget); transient/model/stall -> existing respawn path"
do_2   = "Replace the generic 'still on it, taking another run at it' copy for the deterministic-stop case with a plain statement of what blocked the task + the user's next step"
reqs   = ["3.2", "3.3", "3.4"]
requires = ["1.1"]

[task.2]
section = "P2 — Idempotent core_execute (Cluster A core, the SPARK fix)"
title   = "Attach-to-existing on conflict"
status  = "done"

[task.2.1]
title  = "Delegate attach-to-existing on a 409 conflict"
status = "done"
wave   = 3
do_1   = "On conflict, GET the existing intent's async status + /intents/{id}/gates instead of failing; if in-flight, attach: poll progress and service its gate through the SAME approver/notify wiring the create path uses"
do_2   = "If the conflicting intent is already terminal, return its outcome in plain language; never re-submit fresh prose"
reqs   = ["2.1", "2.2", "2.3", "2.5"]
requires = ["1.1"]

[task.2.2]
title  = "Make attach idempotent + concurrency-safe"
status = "done"
wave   = 4
do_1   = "Guard gate answering and result counting so two attaches to the same intent cannot double-answer a gate or double-count an outcome (keyed on intent id + node id)"
do_2   = "Decide + document the daemon-side option (idempotent 200+existing-id create) vs delegate-side reconcile; implement the delegate-side reconcile first as it does not touch the signed path"
reqs   = ["2.4"]
requires = ["2.1"]

[task.3]
section = "P3 — Loop + batch safety (Clusters A + C)"
title   = "Stop the self-inflicted loops"
status  = "done"

[task.3.1]
title  = "Semantic no-progress detection"
status = "done"
wave   = 3
do_1   = "Augment the no-progress guard to key on (tool + normalized target/operation) so reworded args at the same operation count as a repeat; trip a stall after N deterministic repeats (configurable)"
do_2   = "Guard against false-trips on genuinely distinct operations sharing a tool (different targets do not count as repeats)"
reqs   = ["4.1", "4.2", "4.3"]
requires = ["1.1"]

[task.3.2]
title  = "Batch idempotency for non-idempotent tool calls"
status = "done"
wave   = 3
do_1   = "In runToolCalls, dedup/serialize state-touching calls (core_execute) within a batch: collapse equivalent calls (same resolved intent id) to one run + join the other to its result; keep concurrent dispatch for independent reversible calls"
reqs   = ["5.1", "5.2", "5.3"]
requires = ["1.1"]

[task.4]
section = "P4 — Transparency (Cluster B)"
title   = "Plain-language results, guarded thinking, coalesced narration"
status  = "pending"

[task.4.1]
title  = "Jargon-free tool-result translation at the delegate boundary"
status = "pending"
wave   = 4
do_1   = "Map every daemon outcome class to a plain-language tool result from a fixed phrase set (mirror the daemon's failureMessage taxonomy); never interpolate raw bodies/codes/intent-ids or any jargon-deny term"
do_2   = "Preserve the failure CLASS for the agent (it still learns it failed + why, in clean terms) while stripping internals from the user-facing surface"
reqs   = ["6.1", "6.3", "6.4"]
requires = ["1.1"]

[task.4.2]
title  = "Reasoning-channel jargon guard"
status = "pending"
wave   = 5
do_1   = "Scrub/guard chat.delta channel=reasoning against the jargon-deny set before it streams to the Thinking panel (server emit), so inferred internals never surface"
reqs   = ["6.2"]
requires = ["4.1"]

[task.4.3]
title  = "Narration coalescing (server + client)"
status = "pending"
wave   = 5
do_1   = "Coalesce identical consecutive narration on the same run in engine.notifyFor (collapse into the existing bubble, optional repeat indicator); emit the 'I'll ask before anything spends' promise only after a submission is accepted/attached"
do_2   = "Defend in the client reducer (useChat.ts): collapse duplicate consecutive assistant text even across differing seqs"
reqs   = ["7.1", "7.2", "7.3", "7.4"]
requires = ["2.1"]

[task.4.4]
title  = "Structured clarify pass-through with slot-fill"
status = "pending"
wave   = 5
do_1   = "Carry the daemon's 422 slot schema back to Neo as an actionable clarify (slot_name/type_name/prompt); on user answers, re-POST the SAME intent id with slot_values; surface plainly + stop if unsatisfiable"
reqs   = ["8.1", "8.2", "8.3"]
requires = ["1.1", "2.1"]

[task.5]
section = "P5 — Memory consistency (Cluster D)"
title   = "Clean write-path, supervised pinning, cheaper consistent reads"
status  = "pending"

[task.5.1]
title  = "Dedup-first write path + fail-closed-to-skip classify"
status = "pending"
wave   = 4
do_1   = "In the writeback consolidator / pager Remember*Related, run a deterministic embedding-cosine near-duplicate check over same-type neighbors BEFORE the LLM classify; skip writing a highly-similar memory"
do_2   = "When the classify model errors AND the candidate is highly similar, skip/supersede instead of defaulting to RelationNew (a new record)"
reqs   = ["9.1", "9.2"]
requires = ["1.1"]

[task.5.2]
title  = "Supervised pinning of user_facts + corrections"
status = "pending"
wave   = 5
do_1   = "Require a confidence threshold + provenance before a user_fact or correction (both pinned every turn) is written; decay/retire standing corrections that go unused"
reqs   = ["9.3", "9.5"]
requires = ["5.1"]

[task.5.3]
title  = "User-visible, editable 'what Neo learned about you' surface"
status = "pending"
wave   = 6
do_1   = "Expose the pinned user facts + standing corrections to the user and allow removal (uses the existing client surface conventions; no new signing path)"
reqs   = ["9.4"]
requires = ["5.2"]

[task.5.4]
title  = "Per-turn pinned compute + consistent learned-guidance"
status = "pending"
wave   = 4
do_1   = "Hoist pager.Pinned out of the per-step loop (compute once per turn, or cache + invalidate on cortex write); pinned CONTENT unchanged"
do_2   = "Make standing corrections always-pinned (capacity-managed by consolidation) vs salience-ranked soft preferences; consolidate overlapping guidance lines so near-duplicates don't crowd the budget"
reqs   = ["10.1", "10.2", "10.3", "10.4"]
requires = ["1.1"]

[task.6]
section = "P6 — Verification (no fakes)"
title   = "Prove it against real failure modes"
status  = "pending"

[task.6.1]
title  = "Error classifier against real daemon responses"
status = "pending"
wave   = 6
do_1   = "Drive a real MCL daemon to emit a 409 conflict, a 403 leash denial, a 422 clarify, and a 5xx; assert the classifier maps each to the correct class and the ladder/supervisor act correctly (no retry/respawn on deterministic)"
property  = "Property 1: real-response classification + correct retry/stop/attach decision"
validates = "Requirements 1.1, 1.2, 1.3, 3.1, 3.2"
requires  = ["1.2", "1.3", "3.1"]

[task.6.2]
title  = "Attach-to-existing end-to-end (the SPARK reproduction)"
status = "pending"
wave   = 7
do_1   = "Against a real daemon async registry: submit an intent that parks at a gate, then issue a SECOND equivalent core_execute; assert it ATTACHES (no second submission) and surfaces the SAME pending gate.invoked"
property  = "Property 2: a re-dispatched in-flight launch joins + shows the existing approval, never loops"
