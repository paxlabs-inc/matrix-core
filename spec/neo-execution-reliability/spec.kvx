requires  = ["2.1", "2.2", "3.2"]

[task.6.3]
title  = "Transparency assertions on the SPARK transcript"
status = "pending"
wave   = 7
do_1   = "Replay the looping-launch transcript through the seam; assert the user-visible stream (bubbles + Thinking) contains NO jargon-deny term and NO duplicate consecutive narration bubble"
