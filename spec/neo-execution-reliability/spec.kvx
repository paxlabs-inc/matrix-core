validates = "Requirements 11.1, 11.2, 11.3, 11.4"

[task.7]
title  = "Final checkpoint — Neo execution-seam reliability complete"
status = "pending"
note   = "All five properties green; SPARK-style launch parks at its approval once (no loop, no jargon, no spam); memory stays clean; the signed MCL walk and the gate UI are provably untouched. Deploy is user-driven (Andrew drives prod redeploys). Ask the user if questions arise."
