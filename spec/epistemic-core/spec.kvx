# spec.kvx — EPISTEMIC-CORE: never let the model assume.
# SINGLE SOURCE for this feature's requirements + design + tasks. Rendered to
# requirements.md / design.md / tasks.md by spec/specgen. Do not edit the
# generated markdown; edit this file and regenerate.
#
# Format: Matrix .kvx (see tachyon/internal/config/kvx.go). One key = value per
# line; string values double-quoted; lists are ["a","b"]; # starts a comment.
# Schema:
#   [req.<n>]   title, story, ac_1..ac_n          (acceptance criteria, EARS)
#   [design]    overview, include="design.body.md" (rich prose/diagrams inlined)
#   [task.<id>] title, status, wave, reqs, requires (dotted ids: 1, 1.1, 1.2)

[meta]
feature      = "epistemic-core"
title        = "EPISTEMIC-CORE — premises grounded at birth, predictions on every probe, convergence by measurement"
status       = "done"
spec_version = "0.1.0"
intro        = "Neo's rigor is back-loaded: Cassandra adjudicates the finished turn-in while nothing checks a premise at the moment it forms — the only moment checking is cheap. The regression corpus (temp/neo-task-review/neo.log arena incident; neo-self-introspection.md OHLC incident) shows the shape twice: the agent affirms a falsehood its own architecture could refute at arm's length, then pursues it, and every downstream failure — probing spirals, wasted budget, the user forced to intervene — is a symptom of that first ungrounded affirmation. This feature installs the epistemic core: (Layer 0) residency — re-base the window budget to the model's true 1M+ context (config.go:257 still says 256000) and render the FULL structural self-model (capability surface, API routes, tool inventory, failure patterns) byte-stable into the attention field, because a model assumes whenever generating is cheaper than retrieving and the only real implementation of 'never let the LLM assume' is the truth already in-field when the premise forms; (M1) a premise ledger with provenance — cited or assumption — and a structural check-before-act gate that refuses dispatching on cheaply-checkable unverified assumptions; (M2) self-claims resolve from the resident self-model, never from generation; (M3) prediction-carrying dispatch — probe-class actions state an expectation, mismatch is a first-class belief-update event, N consecutive mismatches on one strategy force a tools-stripped revision step, and an action with no stateable expectation is a guess the core refuses; (M4) a reified task graph making convergence computable — N actions without evidence growth is measured non-convergence, caught at action three, not token one million. Verified no-fakes by replaying both corpus transcripts as executable regressions."

[design]
overview = "See the full design below: the mission (front-load rigor from completion-time adjudication to premise-birth grounding); the two-incident regression corpus with the shared root cause (actions dispatched on premises nothing grounded); the four load-bearing ideas (assumption as a cost gradient solved by residency; prediction error as the self-correction primitive; the task as measurable structure; residency needs law — byte-stable, fixed-order, cache-riding); the code-grounded seam map (config window math, self_model.go pull seams, Agent.Chat loop anchors, assembleWindowUserTail/cmTrimWorking, cassandraStep, todo tool, dispatch seam); the architecture of Layer 0 + Mechanisms 1-4; config knobs; non-goals (no MCL/gate changes, no interrupt-semantics rework, guards stay as failsafes); and the no-fakes verification strategy built on the arena and OHLC replays. Authored as a rich markdown fragment (design.body.md) and inlined verbatim."
include  = "design.body.md"

# The per-session working protocol, machine-readable (mirrors design.body.md).
[protocol]
step_1_context   = "cortex recall once at session start; READ IN FULL any output flagged truncated before reasoning (hard rule). Then read spec/epistemic-core/spec.kvx and the previous session's handoff (the most recent epistemic-core cortex outcome/handoff)."
step_2_select    = "Pick the ONE next eligible task: lowest wave whose every 'requires' task is done and whose status is pending. Set it in_progress in spec.kvx. At most ONE task in_progress at a time."
step_3_build     = "Implement against the task's referenced acceptance criteria on REAL code (neo/internal/agent, neo/internal/memory, neo/internal/tools, neo/internal/config). Deliver complete, runnable artifacts — never diffs or fragments. Follow existing repo style; add no comments/docs unless asked."
step_4_test      = "Ship tests over REAL code paths — no stub/mock/fake doubles EVER. Real agent loop against httptest SSE endpoints (the established neo seam), real tools.Manager dispatch, real cortex, real self-model artifacts on disk. A red check is a stop condition."
step_5_close_out = "Only when genuinely green: mark the task done in spec.kvx; write a concise next-session handoff; note the outcome (success|partial|failure) + any durable memories; close out. Never attest a completion that did not happen — surface honest partials."
step_6_guard     = "Before any destructive/irreversible/prod/secret/network-write action, guard-check against the HARD rules; stop for explicit user YES if it risks a HARD rule. No git on the dev box; the user drives commits."
handoff_convention = "The handoff is a cortex outcome note prefixed 'HANDOFF epistemic-core' carrying: tasks done+green this session, current spec.kvx status, the exact next eligible task id, and any gotchas or partials."

# The non-negotiable quality bar (mirrors design.body.md).
[quality_bar]
grade            = "Core-loop grade. This is the agent's epistemics — a regression here is an agent that assumes, guesses, and spirals. Every mechanism must be provable on the two corpus transcripts."
never_assume     = "No action is ever dispatched on a cheaply-checkable unverified assumption. The checkable truth lives resident in the attention field, not one tool call away."
prediction_error = "Every probe-class action carries a stateable expectation; mismatch is a structural event that updates beliefs and, bounded, forces revision. An action with no stateable expectation does not dispatch."
measured_progress= "Convergence is computed over the reified task graph (evidence-set delta), never inferred from text similarity. Existing stall guards remain as outer failsafes only."
byte_stable      = "The resident substrate is byte-stable per turn and rides the prompt cache; pinned assembly runs once per turn (NE-7). Turn-varying state renders in the tail in fixed order."
one_vocabulary   = "The task graph subsumes the todo surface as a projection — no second plan vocabulary, no parallel state."
no_fakes         = "Real agent, real dispatch, real cortex, real self-model artifacts, real httptest endpoints. The arena and OHLC transcripts are executable regressions, not narratives."
non_goals        = "No MCL signed-walk or value-moving changes; no interrupt/stop/continuation rework; no new cortex memory types; no client UI beyond the todo projection fallout; failsafe guards are kept, not retired."

# ============================== REQUIREMENTS ==============================

[req.1]
title = "Window re-base: budget math derives from the model's true context window"
story = "As the agent core, I want my budget math to reflect the window I actually have, so that residency is affordable and trimming fires only near true pressure."
ac_1 = "THE default ContextWindowTokens SHALL be re-based from 256000 to the main model's true window (1000000), with the existing env (NEO_CONTEXT_WINDOW_TOKENS) and kvx (memory.context_window_tokens) overrides unchanged and authoritative."
ac_2 = "SOFT and HARD budgets SHALL derive from the configured window with headroom sane at the new scale, and the small-window override path (e.g. 32K local models via env) SHALL keep trimming/compaction correct — proven by tests at both scales."
ac_3 = "cmTrimWorking and compaction triggers SHALL fire only when the configured window is genuinely under pressure; within-turn tool evidence SHALL NOT be evicted while ample window remains."
ac_4 = "A test SHALL prove budget derivation at 1M and 32K configurations against the real trim/compaction code paths."

[req.2]
title = "Resident structural self-model: the full capability surface lives in the stable prefix"
story = "As the model, I want my own architecture's load-bearing facts ambient in my attention field, so that a false self-premise cannot form without colliding with the resident truth."
ac_1 = "A capability-surface section SHALL be GENERATED from the self-model artifact (SelfModelGraph) — external API surface (routes/ports/protocols), tool inventory with one-line semantics, architectural is/is-not facts, and accumulated failure patterns — and rendered into the byte-stable system prefix, replacing the compressed-summary-only posture."
ac_2 = "THE section SHALL be derived, never hand-written, so it cannot drift from the artifact; recallSelf SHALL remain for source-level depth."
ac_3 = "WHEN the self-model artifact lacks required surface facts, THE build SHALL surface the gap honestly (explicit 'unknown' rendering), never fabricate."
ac_4 = "A test SHALL prove the rendered section carries the true external surface (POST /chat + SSE /events; no OpenAI-compatible endpoint) from a real artifact, and that it renders byte-identical across a turn's steps."

[req.3]
title = "Byte-stable prefix discipline: frozen-per-turn residency that rides the prompt cache"
story = "As the system, I want the resident substrate read once and cached, so that residency at 1M scale costs the delta, not the field, on every step."
ac_1 = "THE stable prefix (identity, hard constraints, capability surface) SHALL be byte-identical across all steps of a session absent compaction; turn-varying material (activation bundle, premise ledger, task graph) SHALL render in the tail in fixed section order."
ac_2 = "THE pinned block SHALL be computed once per turn, not per loop step (NE-7), and mid-turn cortex writes SHALL NOT mutate the rendered snapshot until the next turn."
ac_3 = "A test SHALL prove prefix byte-stability across a real multi-step turn and that pinned assembly executes once per turn."

[req.4]
title = "Premise ledger: load-bearing premises carry provenance from the moment they form"
story = "As the agent core, I want every plan's factual premises extracted with provenance, so that assumption is visible state instead of invisible confidence."
ac_1 = "WHEN a run's plan forms (first committing assistant turn, and on plan change), THE core SHALL extract load-bearing factual premises into a ledger carried as run state, each marked cited (self-model|cortex|tool-evidence|user, with citation) or assumption."
ac_2 = "THE ledger SHALL render resident in the tail every step, and premise transitions (assumption→cited, refuted→revision) SHALL be reflected the step they occur."
ac_3 = "CASSANDRA's doubt-side signals SHALL gain premise provenance as a first-class input (judging claims at birth, not prose at death)."
ac_4 = "A test SHALL prove a real plan produces a ledger whose premises carry correct provenance, rendered resident, against the real agent loop."

[req.5]
title = "Check-before-act: no dispatch on a cheaply-checkable unverified assumption"
story = "As the agent core, I want dispatch structurally gated on premise grounding, so that the arena failure class — acting on an ungrounded self-premise — cannot recur."
ac_1 = "WHEN an action depends on an assumption that is cheaply checkable (resident self-model fact, cortex lookup, or one read-only tool call), THE core SHALL refuse the dispatch with a directive naming the premise and the check; the check discharges the premise to cited or refutes it."
ac_2 = "WHEN a premise is refuted, THE core SHALL force a plan-revision step before further dependent dispatches."
ac_3 = "SELF-referential capability claims SHALL validate against the resident self-model deterministically (identity-scrub posture: high-precision patterns, fail toward checking); a contradiction is a mismatch event, never silently retained."
ac_4 = "A test SHALL prove the gate refuses an ungrounded dispatch, the check path discharges the premise, and the refuted path forces revision — on the real loop and dispatch seams."

[req.6]
title = "Prediction-carrying dispatch: probes state expectations; mismatch is a first-class event"
story = "As the agent core, I want every probe to carry a falsifiable expectation, so that guessing is visible, mistakes self-announce, and repeated mismatch forces revision instead of another guess."
ac_1 = "PROBE-class tool calls (network/endpoint/search/exec probes, classified beside the dispatch seam) SHALL carry a one-line stated expectation of outcome shape; an action for which no expectation can be stated SHALL be refused with a directive to ground it or state the hypothesis."
ac_2 = "MISMATCH detection SHALL be deterministic where possible (HTTP status, exit code, empty/nonempty, parse success) and model-assisted (cheap model) otherwise; a mismatch SHALL update the premise ledger, render as structured guidance, and count on a per-strategy meter."
ac_3 = "AFTER N consecutive mismatches on one strategy (default 3, config NEO_EPISTEMIC_MISMATCH_LIMIT), THE core SHALL force a tools-stripped reasoning-only revision step before any further dispatch."
ac_4 = "A test SHALL prove expectations ride real dispatches, deterministic mismatches are detected, the meter accumulates across differently-argued probes of one strategy, and the revision step is forced at the bound."

[req.7]
title = "Reified task graph: convergence is computed, not inferred"
story = "As the agent core, I want the task as live structure — goal, subgoals, premises, evidence — so that non-convergence is caught by measurement at action three, not by a human at token one million."
ac_1 = "THE core SHALL carry a live task graph (goal → subgoals → premises referenced → evidence discharged) seeded from the plan and maintained across steps; every dispatched action SHALL link to a subgoal."
ac_2 = "CONVERGENCE SHALL be computed as evidence-set delta: N consecutive actions (default 4, config NEO_EPISTEMIC_CONVERGENCE_WINDOW) with an unchanged evidence set is measured non-convergence and forces the same revision step as req.6."
ac_3 = "THE existing todo surface SHALL become a projection of the task graph (one vocabulary, no parallel plan state); existing stall guards (NoProgressStall et al) SHALL remain as outer failsafes that the epistemic layer fires before."
ac_4 = "THE task graph SHALL render resident in the tail (what is proven, assumed, remaining), updated the step it changes."
ac_5 = "A test SHALL prove the graph tracks a real run, convergence measurement trips at the bound on a non-converging sequence, and the todo projection stays consistent."

[req.8]
title = "Epistemic config surface"
story = "As the operator, I want the epistemic layer tunable and honestly disableable, so that rollout is controlled and regressions are bisectable."
ac_1 = "CONFIG knobs SHALL exist with env + kvx [epistemic] forms: NEO_EPISTEMIC_PREMISES (default on), NEO_EPISTEMIC_PREDICTIONS (default on), NEO_EPISTEMIC_MISMATCH_LIMIT (default 3), NEO_EPISTEMIC_CONVERGENCE_WINDOW (default 4)."
ac_2 = "DISABLING a mechanism SHALL cleanly restore the prior behavior (guards-as-failsafes path), proven by tests both ways."

[req.9]
title = "No-fakes end-to-end proof: the corpus transcripts become executable regressions"
story = "As the owner, I want the two real failures replayed against the new core, so that the fix is demonstrated on the incidents that motivated it, not asserted."
ac_1 = "ARENA replay: the arena prompt from cold against a real agent with a real self-model artifact SHALL produce a plan whose self-referential premise is cited from the resident self-model BEFORE any scaffold action dispatches, and no dispatched action SHALL depend on an unchecked cheaply-checkable assumption."
ac_2 = "OHLC replay: against a real httptest API with an undocumented path, THE agent SHALL carry an expectation on every probe, and by the third failed probe the core SHALL have forced a tools-stripped revision step, with the mismatch meter and premise ledger reflecting the failures and total probes bounded."
ac_3 = "NO test in this feature SHALL substitute a fake for a real code path: real agent loop against httptest SSE, real tools.Manager, real cortex, real self-model artifacts on disk."

# ================================ TASKS ==================================

[tasks]
heading = "Implementation Plan: EPISTEMIC-CORE — residency substrate, then the four mechanisms, then the corpus proofs"

[task.1]
section = "P0 — Layer 0: the residency substrate"
title   = "Re-base the window, make the self-model resident, freeze the prefix"
status  = "done"

[task.1.1]
title  = "Window re-base + budget derivation at both scales"
status = "done"
wave   = 1
do_1   = "Re-base ContextWindowTokens default to the main model's true window (1000000) in neo/internal/config/config.go; keep env/kvx overrides authoritative; re-derive soft/hard budget headroom sane at the new scale with the small-window path intact"
do_2   = "Audit consumers (cmTrimWorking, compaction triggers, activation budgets) so trimming fires only near true pressure and within-turn tool evidence is retained while ample window remains"
do_3   = "Test: budget derivation + real trim/compaction behavior at 1M and 32K configurations"
reqs   = ["1.1", "1.2", "1.3", "1.4"]

[task.1.2]
title  = "Capability-surface builder: full self-model rendered into the stable prefix"
status = "done"
wave   = 1
do_1   = "Build the generator that derives the capability-surface section from the self-model artifact (SelfModelGraph): external API surface, tool inventory with one-line semantics, is/is-not architectural facts, failure patterns — honest 'unknown' for gaps, never fabricated"
do_2   = "Render it into the byte-stable system prefix (prompt.go seam), replacing the compressed-summary-only posture; keep recallSelf for source-level depth; ensure the artifact carries the true external surface facts"
do_3   = "Test: rendered section carries the true surface (POST /chat + SSE /events; no OpenAI-compatible endpoint) from a real artifact; byte-identical across a turn's steps"
reqs   = ["2.1", "2.2", "2.3", "2.4"]

[task.1.3]
title  = "Byte-stable prefix discipline: pinned once per turn, fixed tail order"
status = "done"
wave   = 2
do_1   = "Compute the pinned block once per turn (NE-7 fix) with mid-turn cortex writes deferred to the next turn's snapshot; establish the fixed tail section order (activation bundle, premise ledger, task graph)"
do_2   = "Test: prefix byte-stability across a real multi-step turn; pinned assembly executes once per turn"
reqs   = ["3.1", "3.2", "3.3"]
requires = ["1.1", "1.2"]

[task.2]
section = "P0 — Mechanism cores: ledger, predictions, graph"
title   = "The epistemic state structures and their loop wiring"
status  = "done"

[task.2.1]
title  = "Premise ledger: extraction, provenance, resident rendering"
status = "done"
wave   = 2
do_1   = "Implement the ledger as agent-core run state: premise extraction at plan formation and plan change (deterministic + cheap-model hybrid), provenance cited(source,citation)|assumption, transitions (discharge, refute)"
do_2   = "Render the ledger resident in the fixed tail slot, updated the step a transition occurs; feed premise provenance into buildCassandraSignals as a first-class doubt input"
do_3   = "Test: a real plan against the real loop produces a correctly-provenanced, resident-rendered ledger"
reqs   = ["4.1", "4.2", "4.3", "4.4"]
requires = ["1.3"]

[task.2.2]
title  = "Prediction-carrying dispatch: expectations, mismatch detection, per-strategy meter"
status = "done"
wave   = 2
do_1   = "Add the probe-class classifier beside the dispatch seam and the expectation channel on tool calls; deterministic mismatch detection (HTTP status, exit code, empty/nonempty, parse) with cheap-model comparison fallback"
do_2   = "Wire mismatch as a belief-update event: ledger update, structured guidance render, per-strategy meter accumulation across differently-argued probes"
do_3   = "Test: expectations ride real dispatches; deterministic mismatches detected; the meter aggregates one strategy across varied args"
reqs   = ["6.1", "6.2"]
