# spec.kvx — Cody Client (the /cody surface + engine polish).
# SINGLE SOURCE for this feature's requirements + design + tasks. Rendered to
# requirements.md / design.md / tasks.md by spec/specgen. Do not edit the
# generated markdown; edit this file and regenerate.
#
# Format: Matrix .kvx (see tachyon/internal/config/kvx.go). One key = value per
# line; string values double-quoted; lists are ["a","b"]; # starts a comment.
# Schema:
#   [req.<n>]   title, story, ac_1..ac_n          (acceptance criteria, EARS)
#   [design]    overview, include="design.body.md" (rich prose/diagrams inlined)
#   [task.<id>] title, status, wave, reqs, requires (dotted ids: 1, 1.1, 1.2)

[meta]
feature      = "cody-client"
title        = "Cody Client — the /cody surface + engine polish"
status       = "in_progress"
spec_version = "0.1.0"
intro        = "Ships Cody's product surface and the engine addons that make it sellable, superseding spec/cody task.7.1/8.6. Client: a full sibling app at /cody in apps/client (own sidebar, top bar, viewport, pages — the claude.ai vs claude.ai/code relationship to the Neo dashboard), web-first, with ONE engine truth disclosed in three mode tiers because modes are people groups: Prototype (vibe coder) = preview-first hero + outcome cards + one-button undo, no terminal/tree/diffs (single show-me-the-code escape hatch); Engineer (default) = adds the live waved task board, turn-in cards with real verification evidence, diff review, file tree, decision cards, named checkpoints; Architect = adds the terminal, live .cody/spec viewer, property-test results, full turn-in detail, git surface. Engine addons (user-locked 2026-07-03): anti-default enforcement by construction — greenfield Engineer/Architect runs are structurally blocked from wave 1 until a Stack Decision Record survives an anti-default adjudication lens citing rules/stack-selection doctrine, and UI work binds to a Design Language Record screened against a deterministic banned-AI-tells list (rules/web/design-quality.md); decision phases run hot with N divergent candidates judged, implementation runs cold. Plus: first-class spec ingestion (adopt a spec doc as the plan), mid-run steering + an answer channel for needs_input (SDR/DLR approval rides it — the human checkpoint lives at the two cheap-to-review expensive-to-get-wrong decisions, not on every task), HTTP-exposed snapshot/undo, worker ExtraTools wiring with screenshot-as-evidence for UI tasks, and preview-as-deliverable: on-demand Railway sandboxes (PRIVATE network) reverse-proxied by the router at /preview/{user} under the user's JWT — no public domains, VM stays outbound-quiet. Image gains codyd + local Postgres/Redis/SQLite + the baked quality toolchain (playwright browsers deliberately NOT baked — browser e2e runs in sandboxes); rules/ gains the stack-selection decision tables; skills/ gains the non-default framework playbooks."

[design]
overview = "See the full design below: the three load-bearing ideas (one engine truth / three disclosure tiers; anti-default by construction; preview is a deliverable), the locked decisions, the flagged defaulted decision (projects as /workspace subdirectories), a code-grounded seam map (codyd routes + event family, workspace surface, unexposed Snapshotter, needs_input ledger, layered gate, mode tuples, worker ExtraTools seam, client transport/reducer/route seams, rules/web/design-quality.md, router proxy, Railway GraphQL client, deploy/railway image), the /cody app shell and tier composition, the useCody reducer + new event types, the engine addons (SDR, DLR, creativity split, spec ingestion, steering/answer, screenshot evidence, undo routes, projects), the sandbox preview architecture with the router /preview proxy, image/rules/skills additions, non-goals, and the no-fakes verification strategy. Authored as a rich markdown fragment (design.body.md) and inlined verbatim."
include  = "design.body.md"

# ============================== REQUIREMENTS ==============================

[req.1]
title = "The /cody sibling app surface"
story = "As a user, I want Cody to be its own app inside the Matrix client, so that coding work gets a purpose-built surface without disturbing the Neo dashboard."
ac_1 = "apps/client SHALL gain a /[locale]/cody route mounting a CodyApp with its own shell: left sidebar (projects, new project, recent runs, settings, back to Matrix), top bar (project name, mode chip, run status, stop), and a tier-driven main viewport; the Neo dashboard route SHALL be untouched."
ac_2 = "THE surface SHALL comprise Workspace (hero), History (past runs + outcomes), and Settings (project mode, preview TTL) pages within the /cody shell."
ac_3 = "THE surface SHALL reuse the existing client transport (apiFetch auth, SSE hub, seq-gap resume, replay-then-tail) with no new transport plumbing."
ac_4 = "UI house rules SHALL hold: separation by background-color contrast only (never border strokes), no emojis/purple gradients/glow, single Paxeer Blue accent; vendored code rendering (Shiki code-block) SHALL be restyled to conform."
ac_5 = "CONSUMER copy SHALL show the result, not the protocol: no orchestrator/worker/sheet jargon; the explanation register SHALL follow the project's mode."

[req.2]
title = "Projects with project-level mode"
story = "As a beta tester, I want multiple projects each with its own mode, so that my prototype and my production build live side by side with the right ceremony each."
ac_1 = "codyd SHALL maintain a project registry mapping project id to name, workspace root (/workspace/<dir>), mode, and created_at; the bare /workspace SHALL remain the default project for retro-compat."
ac_2 = "/chat, /workspace/*, the run ledger, spec files, and snapshots SHALL scope to the addressed project's root."
ac_3 = "MODE SHALL be a project-level setting (set at creation, changeable between runs), not a per-message flag."
ac_4 = "THE client SHALL provide project creation/selection in the /cody sidebar and mode setting in project Settings."

[req.3]
title = "Live run surface — durable trace + live SSE"
story = "As a user, I want to watch Cody work and reopen the app to the same truth, so that progress is never lost to a closed tab."
ac_1 = "A useCody reducer SHALL fold the Cody event family (plan.created, task.started/accepted/rejected/failed, sheet.authored, task.turnin, plan.completed, chat.assistant, message.complete) plus this feature's new events into a CodyRun model."
ac_2 = "buildRunFromTrace SHALL rebuild the identical CodyRun from the durable trace on reopen (same fold as live), following the proven Neo pattern."
ac_3 = "THE Workspace page SHALL render the run live: chat/steering rail, plan progress in the mode's register, turn-in cards (changes, verification evidence, honest gaps), and terminal status."
ac_4 = "NEW event types (decision.stack, decision.design, decision.resolved, run.needs_input, preview.pending/ready/failed/expired, snapshot.created/restored, plan.adopted) SHALL be added to the SSE family and the durable-trace whitelist."

[req.4]
title = "Mode-tiered disclosure — one engine truth, three tiers"
story = "As a vibe coder or an engineer, I want the surface to match who I am, so that I am neither drowned in machinery nor starved of evidence."
ac_1 = "PROTOTYPE SHALL render preview as the hero with outcome-language cards, a plain-language design-direction card, one-button undo, and NO terminal, file tree, or raw diffs; a single show-me-the-code escape hatch SHALL open the read-only viewer."
ac_2 = "ENGINEER (default) SHALL add the waved task board as centerpiece, diff review pane, per-task verification evidence, file tree, SDR/DLR technical decision cards, and named checkpoint/restore."
ac_3 = "ARCHITECT SHALL add the terminal (Architect-only), the live spec viewer (.cody/spec/requirements.md + tasks.md with checkbox state), property-test results, full turn-in detail, and the git surface (staged diff + proposed commit; the user drives the commit)."
ac_4 = "EVERY mode SHALL have: chat/steering, live progress, the needs-input prompt, stop, preview, what-changed summaries, run history, undo, and settings."
ac_5 = "TIERS SHALL differ only in disclosure and register — never in the underlying run data or the constitution."

[req.5]
title = "Code panes — file tree, viewer, diff review"
story = "As an engineer, I want to inspect the tree, read files, and review diffs, so that I can audit accepted work without leaving the surface."
ac_1 = "THE file tree SHALL render GET /workspace/tree (project-scoped) with truncation surfaced honestly."
ac_2 = "THE read-only viewer SHALL render GET /workspace/file with Shiki highlighting restyled to the no-borders house rule."
ac_3 = "THE diff pane SHALL render GET /workspace/diff (staged + unstaged + untracked) hunk-by-hunk as a passive audit surface; task-level blocking review is a non-goal."

[req.6]
title = "Terminal — Architect only"
story = "As an architect, I want a terminal into my environment, so that I can poke the machine myself when I need to."
ac_1 = "THE terminal pane SHALL execute via POST /workspace/exec (bounded command-run, v1 is not a PTY) and render output with exit codes and duration."
ac_2 = "THE terminal SHALL be present only in Architect-mode projects."

[req.7]
title = "Preview — on-demand sandbox behind the router"
story = "As a user, I want to see my running app the moment Cody says it's ready, so that done means demonstrably working, not claimed."
ac_1 = "WHEN a plan completes (or the user requests preview), codyd SHALL provision a Railway sandbox (PRIVATE network mode, same project/environment), deploy the project's current state, start its detected start command, health-probe it, and emit preview.ready with the proxied URL."
ac_2 = "THE router SHALL add a /preview/{userID}/... path that authenticates the user's JWT (path user must match token user) and reverse-proxies to that user's registered preview target over the private network; previews SHALL never be world-readable and no sandbox public domain SHALL be required."
ac_3 = "A TTL reaper SHALL destroy idle preview sandboxes (config knob, default 30m) and emit preview.expired; re-preview SHALL be a single client action."
ac_4 = "THE sandbox client SHALL be Go-native (extending the router's Railway GraphQL transport) if the sandbox API permits, else a minimal Node sidecar in the image; the codyd-facing seam SHALL be identical either way."
ac_5 = "WORKERS SHALL be able to request an ephemeral sandbox for browser-driven e2e (playwright runs in the sandbox, never in the user VM)."
ac_6 = "THE client preview pane SHALL render the proxied URL in all modes; in Prototype it SHALL be the hero viewport."

[req.8]
title = "Stack Decision Record — gated anti-default stack selection"
story = "As the user, I want Engineer/Architect to pick the best-fitting stack like a senior engineer would, so that greenfield output never defaults to the path of least resistance."
ac_1 = "ON greenfield detection in Engineer/Architect, THE orchestrator SHALL author a durable Stack Decision Record before planning: requirements profile (app class, audience, deployment target, team context), 2-3 genuinely divergent candidate stacks, fit rationale per candidate citing rules/stack-selection, and a pick."
ac_2 = "THE SDR SHALL pass the layered gate with an anti-default adjudication lens: a choice that would be identical regardless of the requirements SHALL be rejected."
ac_3 = "WAVE 1 SHALL be structurally unreachable until the SDR is resolved (gate-accepted AND user-approved or user-overridden via the answer channel)."
ac_4 = "PROTOTYPE SHALL skip the SDR and default to the classic stack (Node/TS, Vite or Next, npm)."
ac_5 = "DEVIATIONS from the rules/stack-selection doctrine SHALL require explicit stated rationale in the SDR."

[req.9]
title = "Design Language Record — gated anti-AI-default UI"
story = "As the user, I want UIs that no one can tell an AI made, so that Cody's frontend output is the opposite of the generic template look."
ac_1 = "FOR UI-bearing projects, THE orchestrator SHALL author a durable Design Language Record before the first UI task: style direction, typography, palette, spacing/layout system, motion posture, component idiom."
ac_2 = "THE DLR SHALL pass a deterministic banned-defaults screen (rules/web/design-quality.md banned patterns plus the AI-tells list: untouched stock component themes, purple/indigo gradient heroes, glassmorphism blobs, emoji-in-UI, default framework blue) and an adjudication lens asking whether the output is distinguishable from AI-default."
ac_3 = "EVERY subsequent UI task sheet SHALL carry the DLR as a constraint; THE acceptance gate SHALL reject turn-ins that drift from it."
ac_4 = "IN Engineer/Architect the DLR SHALL be a blocking approve/override card; IN Prototype it SHALL surface as a plain-language design-direction card with a change-the-look affordance without blocking the run."

[req.10]
title = "Creativity split — decision phases hot, implementation cold"
story = "As the user, I want bold decisions and precise implementation, so that divergence happens by construction, not by asking one lukewarm sample to be creative."
ac_1 = "THE mode tuple SHALL split Creativity into DecisionCreativity (hot) and ImplementationCreativity (cold, current values), plus a DecisionCandidates count (2-3)."
ac_2 = "SDR, DLR, and plan-shape authoring SHALL run at decision temperature generating N divergent candidates that are judged; worker implementation SHALL run cold."

[req.11]
title = "Spec ingestion — adopt a spec document as the plan"
story = "As an engineer, I want to hand Cody an existing spec and have it execute it, so that my planning artifact is the plan, not a paraphrase of it."
ac_1 = "/chat SHALL accept a spec reference (workspace path or pasted document); THE planner SHALL adopt it: requirements map to acceptance grounding, tasks/waves derive from the document structure where present, and the ledger records the source via a plan.adopted event."
ac_2 = "A run against an adopted spec SHALL be resumable like any plan (kill/restart resumes at the correct next task against the same adopted spec)."
ac_3 = "THE client new-run flow SHALL offer spec adoption (pick a workspace file or paste)."

[req.12]
title = "Steering + the answer channel"
story = "As a user, I want to redirect a live run and answer its questions, so that autonomy never means locked-out."
ac_1 = "POST /intents/{id}/answer SHALL resolve a needs_input stall with free text or a decision verdict (approve / override with payload); stop-and-ask and SDR/DLR approval SHALL both ride this channel."
ac_2 = "POST /intents/{id}/steer SHALL fold a mid-run correction into the live run at the next orchestrator boundary — never interrupting a mid-flight worker; the orchestrator SHALL weigh the steer into subsequent sheets or re-plan remaining waves when invalidated."
ac_3 = "THE client SHALL render the needs-input prompt in every mode and a steering affordance in the chat rail; run.needs_input and its resolution SHALL be durable trace events."

[req.13]
title = "Worker ExtraTools + screenshot evidence"
story = "As the acceptance gate, I want workers to see what they built, so that design quality is verified, not asserted."
ac_1 = "codyd SHALL populate worker ExtraTools with the browser (shared browser service), fetch, and web-search bridges through the existing ExtraTools/ExtraDispatch seam."
ac_2 = "UI-task sheets SHALL require a screenshot artifact in turn-in evidence; THE gate SHALL reject UI turn-ins without one; screenshots SHALL surface in the client's turn-in cards."

[req.14]
title = "Undo — snapshots over HTTP"
story = "As a vibe coder, I want one button that puts things back, so that experimentation is never scary."
ac_1 = "codyd SHALL expose the existing Snapshotter: POST /workspace/snapshot (named), GET /workspace/snapshots, POST /workspace/restore; restore SHALL refuse while a worker is alive."
ac_2 = "THE client SHALL render one-button undo (latest snapshot) in Prototype and named checkpoint/restore in Engineer/Architect; snapshot.created/restored SHALL be trace events."

[req.15]
title = "Image completeness — codyd, local data stores, quality toolchain"
story = "As the operator, I want the per-user image to carry everything Cody's promise needs, so that a fresh environment codes at senior grade on first wake."
ac_1 = "deploy/railway SHALL build and supervise codyd beside the existing stack (entrypoint process + CODY_* env wiring + agents/cody.json present)."
ac_2 = "THE image SHALL bake PostgreSQL, Redis, and SQLite as exec-bridge-startable local services (no nested Docker on Railway)."
ac_3 = "THE image SHALL bake the quality toolchain: golangci-lint, ruff, eslint, prettier, tsc, vitest, cargo-clippy; playwright browsers SHALL NOT be baked (browser e2e runs in sandboxes)."
ac_4 = "THE sandbox client (Go binary or Node sidecar per req.7) SHALL ship in the image."

[req.16]
title = "Rules + skills — the selection layer and the non-default playbooks"
story = "As the user, I want Cody's taste to be curated data, so that doctrine evolves by editing files, not retraining prompts."
ac_1 = "rules/stack-selection/ SHALL be authored as decision tables (app class to stack: chat/realtime -> React Router framework mode; content/marketing -> Astro/Next; internal enterprise -> Angular; high-throughput backend -> Go; correctness-critical -> Rust; ML-adjacent -> Python/uv; deviation demands rationale) and injected via the existing rules seam; the SDR gate SHALL cite it as doctrine."
ac_2 = "skills/ SHALL gain framework playbooks for the non-default picks (Angular, React Router v7/Remix, Astro, SvelteKit), a Railway-deploy skill, a database-schema-design playbook if absent, and a toolchain-bootstrap skill (on-demand apt/mise install of long-tail stacks)."

[req.17]
title = "Real verification — no fakes"
story = "As the owner, I want every pillar proven against real code paths, so that the surface ships genuinely working."
ac_1 = "SDR/DLR structural tests: greenfield Engineer run cannot reach wave 1 without a resolved SDR; a default-stack SDR for an internal-enterprise profile is rejected by the anti-default lens; a banned-defaults DLR is rejected deterministically; a UI turn-in drifting from the accepted DLR is rejected; Prototype skips SDR."
ac_2 = "DECISION gate round-trip: run pauses needs_input on SDR; /answer with override resolves; the plan proceeds against the override; trace replay is byte-identical."
ac_3 = "STEERING: a mid-plan steer lands in the next authored sheet and never kills the live worker."
ac_4 = "SPEC ingestion: a seeded SPEC.md adopts into a mapped plan; kill codyd mid-plan; resume continues against the adopted spec."
ac_5 = "PREVIEW: sandbox lifecycle against recorded httptest fixtures; router /preview proxy integration test (JWT-authenticated request reaches a fake sandbox listener; cross-user path is 403; TTL reaper destroys + emits preview.expired)."
ac_6 = "UNDO: snapshot -> mutate -> restore round-trips bytes; restore refused while a worker is alive."
ac_7 = "CLIENT: vitest proves buildRunFromTrace equals the live fold for the full event family including decisions/preview/needs-input; tier rendering asserted (Prototype hides terminal/tree/diff; Architect shows spec viewer + terminal)."
ac_8 = "SCREENSHOT evidence: a UI-task turn-in without a screenshot is rejected; with one, accepted — real gate, seeded sheet."
ac_9 = "NO test SHALL substitute a stub/mock/fake for a real code path or type to manufacture a pass."

