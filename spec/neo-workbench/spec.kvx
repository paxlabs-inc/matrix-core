# spec.kvx — NEO-WORKBENCH: one bolt.diy-shaped coding workbench driven by Neo.
# SINGLE SOURCE for this feature's requirements + design + tasks. Rendered to
# requirements.md / design.md / tasks.md by spec/specgen. Do not edit the
# generated markdown; edit this file and regenerate.
#
# Format: Matrix .kvx (see tachyon/internal/config/kvx.go). One key = value per
# line; string values double-quoted; lists are ["a","b"]; # starts a comment.
# Schema:
#   [req.<n>]   title, story, ac_1..ac_n          (acceptance criteria, EARS)
#   [design]    overview, include="design.body.md" (rich prose/diagrams inlined)
#   [task.<id>] title, status, wave, reqs, requires (dotted ids: 1, 1.1, 1.2)

[meta]
feature      = "neo-workbench"
title        = "NEO-WORKBENCH — Neo takes over coding behind one bolt.diy-shaped workbench"
status       = "complete"
spec_version = "0.1.0"
intro        = "Neo is now the sole loop and identity, so the coding surface must be Neo's — but the /cody client is still wired to the retired codyd orchestrator (its own reducer, its own event vocabulary, a three-tier layout system beta users disliked, and a preview pane whose backend events never shipped). This feature replaces all of it with ONE workbench shaped like bolt.diy's celebrated UI (studied from the clone at /root/matrix/temp/bolt.diy): the chat rail is a real Neo conversation over the existing useChat reducer; a workbench slides in from the right with a Code / Diff / Preview slider; each turn's file writes and commands render as an inline artifact card in chat with live per-action status; the editor shows Neo typing live and is itself editable (CodeMirror, saved through a real workspace write API with an honest conflict posture); and previews plus unsafe execution run in on-demand Railway sandboxes, never on the main per-user VM. bolt.diy's structure is borrowed, not its code: we keep Next.js + Tailwind v4 tokens + the NeoTask reducer, reuse the already-good panes (react-arborist tree, @git-diff-view diff, xterm shell, the filmstrip idiom), and stay inside the house rules (background-contrast separation only, no borders for depth, no purple, no glow, no emojis). Locked with Andrew 2026-07-11: one workbench with no mode tiers; keep the /cody route rebranded to Neo; v1 flagship borrows = artifact cards + live preview + live-typing editor; editor is CodeMirror editable."

[design]
overview = "See the full design below: the mission (retire the codyd-era client, rebuild the coding route as a Neo-driven bolt.diy-shaped workbench); the bolt.diy study with file:line citations (what is borrowed — chat-primary slide-in workbench, Code/Diff/Preview slider, artifact/action cards, live-typing editor, preview chrome — and what is explicitly not: WebContainers, the XML action protocol, nanostores/Remix/UnoCSS, purple/borders/glow); the four locked decisions; the code-grounded seam map (what dies in apps/client, what is reused, the neo daemon backend seams: ToolEvent out-of-band fields, traceWorkspaceTypes durability, workspace API, projects registry, Railway sandbox preview controller); the event-flow architecture (one stream, no second reducer); the editable-editor conflict posture; non-goals; and the no-fakes verification strategy. Authored as a rich markdown fragment (design.body.md) and inlined verbatim."
include  = "design.body.md"

# The per-session working protocol, machine-readable (mirrors design.body.md).
[protocol]
step_1_context   = "cortex recall once at session start; READ IN FULL any output flagged truncated before reasoning (hard rule). Then read spec/neo-workbench/spec.kvx and the previous session's handoff (the most recent neo-workbench cortex outcome/handoff)."
step_2_select    = "Pick the ONE next eligible task: lowest wave whose every 'requires' task is done and whose status is pending. Set it in_progress in spec.kvx. At most ONE task in_progress at a time."
step_3_build     = "Implement against the task's referenced acceptance criteria on REAL code (neo, apps/client, deploy/railway). Deliver complete, runnable artifacts — never diffs or fragments. Follow existing repo style; add no comments/docs unless asked."
step_4_test      = "Ship tests over REAL code paths — no stub/mock/fake doubles EVER. Real tool dispatch, real workspace files on disk, real event stream + trace replay, the real client reducer. A red check is a stop condition."
step_5_close_out = "Only when genuinely green: mark the task done in spec.kvx; write a concise next-session handoff; note the outcome (success|partial|failure) + any durable memories; close out. Never attest a completion that did not happen — surface honest partials."
step_6_guard     = "Before any destructive/irreversible/prod/secret/network-write action (a daemon image rebuild + Railway redeploy, sandbox provisioning against the live Railway project), guard-check against the HARD rules; stop for explicit user YES if it risks a HARD rule. No git on the dev box; the user drives commits."
handoff_convention = "The handoff is a cortex outcome note prefixed 'HANDOFF neo-workbench' carrying: tasks done+green this session, current spec.kvx status, the exact next eligible task id, and any gotchas or partials."

# The non-negotiable quality bar (mirrors design.body.md).
[quality_bar]
grade           = "Production grade. This is the beta users' coding surface — the thing they complained about. It must feel like bolt.diy's polish, on our tokens, with honest state everywhere."
one_reducer     = "Coding runs ARE Neo conversations. The workbench is a projection of the same NeoTask the dashboard uses — no second reducer, no parallel event vocabulary."
honest_state    = "Every status icon reflects a real transition from the event stream; the preview pane never claims readiness it does not have; a user's unsaved editor buffer is never silently clobbered by a Neo write."
sandbox_only    = "Dev servers and unsafe execution run in on-demand Railway sandboxes, never on the main per-user VM."
house_rules     = "Separation via background-color contrast only (no border strokes for depth); no glow, no emojis, no purple gradients; single accent from the existing token ladder. Fix neo-workspace.tsx's existing border-stroke violations while in there."
no_fakes        = "Real daemon, real workspace files, real event stream, real trace replay, real client reducer. No stub/mock/fake doubles."
non_goals       = "No WebContainers or in-browser execution; no change to the MCL signed walk or any value-moving surface; no mode tiers, waved boards, or decision-card lifecycle; screenshot-to-chat, inspector, device frames, deploy buttons are v2."

# ============================== REQUIREMENTS ==============================

[req.1]
title = "The coding route is a Neo conversation — codyd's client layer dies"
story = "As a user, I want the coding surface to be Neo — same brain, same memory, same stream — so that coding is not a separate sibling agent with a separate history."
ac_1 = "THE /cody route SHALL keep its mount (app/[locale]/cody/page.tsx) but its chat rail SHALL be a real Neo conversation driven by the existing useChat reducer and Neo event families (tool.step, chat.delta, chat.assistant, tool.todo) over the Neo daemon base path — not useCody/codyd."
ac_2 = "THE codyd client layer SHALL be retired from the live surface: no live code path SHALL call lib/api/cody.ts run/intent routes (submitChat, getCodyTrace, stopRun, answerIntent, steerIntent) or the useCody reducer."
ac_3 = "HISTORY SHALL be server-backed via Neo's conversation list filtered to the active project — the localStorage recent-runs stopgap (lib/cody/recent-runs.ts) SHALL be deleted."
ac_4 = "THE surface SHALL carry Neo's identity in all copy and naming (no Cody-branded strings in the rendered UI)."
ac_5 = "A test SHALL prove the coding chat rail folds a real Neo event trace (live + reopen via buildTaskFromTrace) into the same state the dashboard would."

[req.2]
title = "One workbench shell: slide-in panel with a Code / Diff / Preview slider"
story = "As a user, I want the workbench to appear when Neo starts producing work and to switch views without losing state, so that the surface feels like one machine rather than three layouts."
ac_1 = "THE tier system SHALL be retired: tiering.ts and the three layout files (layout-prototype/engineer/architect) SHALL have no live consumers; ONE workbench layout SHALL serve all users."
ac_2 = "THE workbench SHALL slide in from the right when work steps arrive (and via a manual toggle), full-width on small viewports, with the chat rail remaining the primary column."
ac_3 = "A three-position Code / Diff / Preview slider SHALL switch panels that stay mounted (no unmount flash); a terminal panel SHALL be toggleable within the workbench."
ac_4 = "THE shell SHALL follow house rules on the existing token ladder (bg-surface-* separation, single accent, no border strokes for depth, no glow/emoji/purple); the pre-existing border-stroke violations in neo-workspace.tsx (border border-zinc-800/70 in BrowserView/EditorView) SHALL be fixed to surface tokens."
ac_5 = "A test SHALL prove slider switching preserves panel state (open file, scroll/diff selection) across view changes."

[req.3]
title = "Artifact/action cards: each turn's work renders inline in chat with live per-action status"
story = "As a user, I want a collapsible card in chat showing exactly what Neo is doing — each file write and command with a live status — so that I can follow the work without opening the workbench."
ac_1 = "WHEN a turn produces editor/terminal/preview steps, THE chat rail SHALL fold them into one collapsible artifact card per turn: header from Neo's narration, one row per action (file path or command) with a live status icon (pending/running/complete/failed)."
ac_2 = "THE per-action status SHALL reflect real transitions emitted by the daemon on the step events (running then done/failed), not synthesized client-side timing."
ac_3 = "CLICKING a file row SHALL open that file in the workbench Code view; clicking a command row SHALL reveal the terminal panel."
ac_4 = "CARDS SHALL be durable: trace replay on reopen SHALL rebuild them with final statuses."
ac_5 = "A test SHALL prove a real event sequence renders a card whose rows transition status live and rebuild identically from the trace."

[req.4]
title = "Workspace API on the Neo daemon: read, write, diff, exec"
story = "As the workbench, I want the daemon to expose the project workspace, so that the tree, editor, diff, and terminal are backed by the real VM filesystem."
ac_1 = "THE Neo daemon SHALL expose project-scoped workspace endpoints: file tree, file read, file WRITE (for the editable editor), diff, and bounded command exec — auth-gated the same way as /media."
ac_2 = "ALL paths SHALL normalize through a single seam that rejects workspace escapes (the edit.Rel posture: absolute or ../ paths never reach the filesystem outside the project root)."
ac_3 = "FILE writes SHALL be atomic (write-then-rename or equivalent) and SHALL return the resulting file version/hash so the client can detect staleness."
ac_4 = "A test SHALL prove read/write/diff/exec round-trips against a real workspace directory, and that escape attempts are rejected."

[req.5]
title = "File tree + editable CodeMirror editor + diff, with an honest conflict posture"
story = "As a user, I want to browse, read, and directly edit the project files with unsaved-change indicators, so that I can fix small things myself without a chat round-trip."
ac_1 = "THE Code view SHALL compose the existing react-arborist tree (cody-tree.tsx) with a CodeMirror 6 editor (language packs per extension); the Diff view SHALL reuse CodyDiffView (@git-diff-view + Shiki) fed by the daemon diff endpoint."
ac_2 = "USER edits SHALL save through the workspace write API; dirty buffers SHALL show unsaved dots on the tree and the tab."
ac_3 = "WHEN Neo writes a file the user has unsaved local edits to, THE editor SHALL NOT silently clobber the buffer — it SHALL surface the conflict with a diff and an explicit take-Neo's/keep-mine choice; WHILE Neo is actively writing a file, that file's editor SHALL be read-only."
ac_4 = "A test SHALL prove save round-trips to disk, unsaved indicators track buffer state, and the conflict path never loses user bytes without an explicit choice."

[req.6]
title = "Live-typing editor: file writes stream into the open editor"
story = "As a user, I want to watch Neo type into the editor as it writes a file, so that the workbench feels alive and I can react early."
ac_1 = "WHEN Neo writes a file, THE daemon SHALL stream bounded file-content deltas on the step event channel so the client renders progressive content in the editor; the final persisted step SHALL carry the complete state."
ac_2 = "WHEN a file write begins, THE workbench SHALL auto-open (if hidden), switch to Code view, and select that file — matching bolt.diy's force-follow behavior — unless the user has pinned a different view this run."
ac_3 = "STREAMING SHALL be bounded (delta size/rate caps) and best-effort: a dropped delta stream degrades to the final content, never a corrupted buffer."
ac_4 = "A test SHALL prove a real streamed write renders progressively and converges byte-identical to the file on disk."

[req.7]
title = "Preview via on-demand Railway sandboxes, surfaced as durable preview events"
story = "As a user, I want a real running preview of my app in the workbench, so that I can see what Neo built without trusting the main VM to run unsafe code."
ac_1 = "WHEN a preview is requested (by Neo or the user), THE daemon SHALL provision an on-demand Railway sandbox, sync the project workspace into it, start the dev command, and health-poll until serving — the main per-user VM SHALL NOT run the dev server."
ac_2 = "THE lifecycle SHALL surface as durable events (preview.pending / preview.ready with URL / preview.failed with reason / preview.expired) whitelisted in traceWorkspaceTypes so reopen rebuilds the last preview state honestly."
ac_3 = "THE Preview pane SHALL render the sandbox URL in an iframe with bolt.diy's chrome: editable address-bar path, reload, and open-in-new-tab; failure and expiry states SHALL be honest empty/error states, never a stale frame presented as live."
ac_4 = "SANDBOXES SHALL be bounded: idle expiry tears them down, and a per-user concurrent-sandbox cap holds."
ac_5 = "A test SHALL prove the controller lifecycle (pending → ready → expired) against a real HTTP dev-server target, event durability across reopen, and the cap/expiry bounds."

[req.8]
title = "Projects on the Neo daemon, rebrand, and dead-code removal"
story = "As a user, I want my projects list to keep working under Neo with a clean surface, so that the transition is invisible except for the improvement."
ac_1 = "PROJECTS SHALL remain workspace subdirectories with a minimal registry on the Neo daemon (list/create/rename/archive/delete) replacing codyd's project routes; conversations SHALL be tagged with a project id so Workspace and History scope per project."
ac_2 = "THE shell (cody-app/cody-sidebar/cody-topbar) SHALL be rebranded to Neo identity end-to-end (copy, i18n keys across all 5 locales)."
ac_3 = "DEAD code SHALL be deleted, not stranded: useCody.ts, the codyd routes in lib/api/cody.ts, tiering.ts, the three layouts, cody-run-parts.tsx, cody-activity.tsx, cody-code-panes.tsx, cody-architect-panes.tsx, recent-runs.ts — the build SHALL be green with zero imports of them."
ac_4 = "A test/check SHALL prove the client builds green (tsc, eslint, vitest) after removal and no rendered string carries the retired Cody branding."

[req.9]
title = "No-fakes end-to-end proof of the Neo workbench"
story = "As the owner, I want the whole instrument proven on the real system, so that the beta users' replacement surface is demonstrated, not asserted."
ac_1 = "AN end-to-end proof SHALL drive a REAL Neo run that writes files and runs commands in a real project workspace, asserting: artifact card rows transition through real statuses; the editor receives the live-typed content and converges with disk; the diff endpoint reflects the changes; and reopen rebuilds cards + workbench from the trace."
ac_2 = "THE preview path SHALL be proven against the real controller with a real serving target, including honest failure and expiry states."
ac_3 = "NO test in this feature SHALL substitute a fake for a real code path: real tool dispatch, real workspace files, real event stream and trace replay, and the real client reducer throughout."

# ================================ TASKS ==================================

[tasks]
heading = "Implementation Plan: NEO-WORKBENCH — Neo takes over coding behind one bolt.diy-shaped workbench"

[task.1]
section = "P0 — Daemon foundations: workspace API, event enrichment, projects"
title   = "Give the workbench a real backend on the Neo daemon"
status  = "done"

[task.1.1]
title  = "Workspace API: project-scoped tree/read/WRITE/diff/exec with one escape-rejecting path seam"
status = "done"
wave   = 1
do_1   = "Add project-scoped workspace endpoints to the Neo daemon (neo/internal/server): file tree, file read, atomic file write returning a version/hash, diff, and bounded exec — auth-gated like /media"
do_2   = "Normalize every path through a single seam that rejects workspace escapes (port the cody edit.Rel posture); root = the project subdirectory under the VM workspace root"
do_3   = "Test: read/write/diff/exec round-trip against a real workspace dir; escape attempts rejected; concurrent write returns detectable staleness via the version/hash"
reqs   = ["4.1", "4.2", "4.3", "4.4"]

[task.1.2]
title  = "Event enrichment: per-action status transitions + bounded live-typing deltas on editor/terminal steps"
status = "done"
wave   = 1
do_1   = "Emit real per-step status transitions (running → done/failed) on editor/terminal tool.steps from the dispatch seam (ToolEvent out-of-band pattern proven by browser-filmstrip: agent.go ToolEvent → engine.go surfaceTool → traceWorkspaceTypes durability)"
do_2   = "Stream bounded file-content deltas while a file write is in flight (size/rate capped, best-effort — a dropped stream degrades to the final step content); final persisted step carries complete state"
do_3   = "Test: a real file-write dispatch emits running→done with progressive deltas converging byte-identical to disk; trace replay carries final statuses only"
reqs   = ["3.2", "6.1", "6.3"]

[task.1.3]
title  = "Projects registry on the Neo daemon + project-tagged conversations"
status = "done"
wave   = 1
do_1   = "Implement the minimal project registry (list/create/rename/archive/delete over workspace subdirectories) on the Neo daemon, replacing codyd's project routes"
do_2   = "Tag conversations with a project id so the conversation list filters per project (server-backed history, replacing the localStorage recent-runs stopgap)"
do_3   = "Test: real registry round-trip; conversation list filtered by project against real stored conversations"
reqs   = ["8.1", "1.3"]

[task.2]
