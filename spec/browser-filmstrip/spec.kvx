status = "done"
wave   = 2
do_1   = "In surfaceTool (neo/internal/server/engine.go:753-810) populate the browser tool.step fields with action, url, page_title, and screenshot_url (from the ToolEvent), reusing the already-whitelisted tool.step type so no traceWorkspaceTypes change is needed"
do_2   = "Confirm the persisted event carries only the /media URL (never inline bytes) and that handleTrace replay (server.go:299-319) rebuilds the browser steps on reopen with their screenshot_urls"
do_3   = "Test: after reopen the browser steps replay with their screenshot_urls and the referenced /media assets still serve"
