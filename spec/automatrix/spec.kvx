# spec.kvx — Automatrix (Neo proactive surprise tasks). SINGLE SOURCE for this
# feature's requirements + design + tasks. Rendered to requirements.md /
# design.md / tasks.md by spec/specgen. Do not edit the generated markdown;
# edit this file and regenerate.
#
# Format: Matrix .kvx (see tachyon/internal/config/kvx.go). One key = value per
# line; string values double-quoted; lists are ["a","b"]; # starts a comment.
# Schema:
#   [req.<n>]   title, story, ac_1..ac_n          (acceptance criteria, EARS)
#   [design]    overview, include="design.body.md" (rich prose/diagrams inlined)
#   [task.<id>] title, status, wave, reqs, requires (dotted ids: 1, 1.1, 1.2)

[meta]
feature      = "automatrix"
title        = "Automatrix — Neo Proactive Surprise Tasks"
status       = "draft"
spec_version = "0.1.0"
intro        = "Let Neo work UNPROMPTED. During normal conversation Neo quietly captures things the user mentioned needing/wanting or that would clearly benefit them but did NOT explicitly ask Neo to do — durable 'opportunities'. Then, while the user is idle (the per-user daemon has scaled to zero between requests), Neo RANDOMLY wakes, picks one eligible opportunity, does the work autonomously, and pings the user with the finished result: a pleasant surprise, not a request fulfilled. The feature is mostly additive over substrate that already exists: capture rides the per-turn background consolidation pass (neo/internal/writeback/consolidator.go); idle wake rides Chronos (the centralized durable agent alarm-clock that already wakes a scaled-to-zero daemon by injecting a /chat turn via router POST /internal/wake) as a sibling of the existing heartbeat convention (chronos/internal/heartbeat <-> neo/internal/agent/heartbeat.go) carrying an AUTOMATRIX marker; execution rides the existing supervised, connection-decoupled, restart-durable task engine (neo/internal/server/session.go drive/superviseTask); only the outbound notify seam is genuinely new (a pluggable Notifier: default ntfy, optional Apprise fan-out, plus a durable in-app automatrix.complete record). LOCKED decisions: autonomy boundary = FULL NON-FINANCIAL (the only hard exclusion is financial/on-chain, enforced STRUCTURALLY via a restricted tool surface that omits the money/chain core_execute path — respecting frozen invariant i1 'Neo never signs' + Chronos i5 'off-chain only'); rollout = OPT-IN (Settings toggle, default OFF; capture runs silently regardless so the queue is warm, but Neo never wakes to work until enabled); honesty = an Automatrix turn passes the SAME Cassandra completion gate as any state-touching turn — Neo never pings a result it did not genuinely produce. These requirements trace to the approved design (rendered into design.md)."

[design]
overview = "See the full design below (system map, the capture extraction class, the cortex opportunity queue + lifecycle, the three-layer non-financial gating with the restricted-tool-surface structural guarantee, the AUTOMATRIX Chronos alarm with randomized jitter + busy-check + opt-in re-check, the supervised restricted-surface execution path, the pluggable ntfy/Apprise Notifier + durable in-app record, the opt-in control surface, config knobs, non-goals, and the no-fakes verification strategy). Authored as a rich markdown fragment (design.body.md) and inlined here verbatim, because diagrams and tables do not fit single-line kvx values."
include  = "design.body.md"

# ============================== REQUIREMENTS ==============================

[req.1]
title = "Capture implicit opportunities from conversation"
story = "As a user, I want Neo to notice the helpful things I mention in passing but don't formally ask for, so that they aren't forgotten and can be acted on later."
ac_1 = "THE per-turn background consolidation pass (neo/internal/writeback/consolidator.go) SHALL, in addition to its existing extractions, extract an `opportunities` class: specific, actionable things the user implied wanting or would clearly benefit from but did NOT explicitly ask Neo to do this turn."
ac_2 = "THE extraction SHALL require each opportunity to be grounded in something the user actually said or did (a `rationale` citing it), SHALL drop vague or low-confidence items below a configured confidence floor, and SHALL be selective by default (most turns yield none — the correct, common outcome)."
ac_3 = "A direct request the user made this turn (already being handled) SHALL NOT be captured as an opportunity, so the queue holds only unrequested, proactive work."
ac_4 = "EACH captured opportunity SHALL carry a first-pass `financial` classification (true for anything involving spending, sending value, trading, or on-chain writes) supplied by the extraction model."
ac_5 = "THE capture pass SHALL run whenever the feature is built in, INDEPENDENT of the per-user opt-in state, so the opportunity queue is already warm if and when the user enables proactive execution."

[req.2]
title = "Durable, deduplicated opportunity queue in cortex"
story = "As the system, I want captured opportunities stored durably with a clear lifecycle, so that they survive restarts, don't pile up duplicates, and can be ranked for autonomous work."
ac_1 = "EACH accepted opportunity SHALL be written to cortex as a durable record carrying at least: summary (actionable, self-sufficient), rationale, status, eligible_autonomous (bool), confidence, origin_conversation_id, created_at/updated_at, and attempts."
ac_2 = "THE opportunity status SHALL follow the lifecycle pending -> scheduled -> in_progress -> done | dismissed, and status transitions SHALL be persisted atomically so a restart never loses or double-runs an item."
ac_3 = "A newly captured opportunity SHALL be deduplicated against existing pending opportunities (normalize + semantic similarity, the same discipline as RememberFact) so a repeatedly-mentioned need does not accumulate duplicates."
ac_4 = "THE pager SHALL expose a reader that returns ONLY eligible-autonomous, pending opportunities, ranked (confidence x salience x recency), for the autonomous picker; and a writer to set an opportunity's status."
ac_5 = "THE opportunity records SHALL be scoped to the owning user/agent and SHALL NOT store secrets, tokens, or private keys."

[req.3]
title = "Non-financial autonomy boundary (structural guarantee)"
story = "As a user, I want absolute certainty that Neo's unprompted work can never spend my money or move value, so that I can trust it to act while I'm away."
ac_1 = "NO financial or on-chain action SHALL ever be performed by an autonomous Automatrix run; the ONLY hard exclusion on otherwise-permitted autonomous work is financial/on-chain."
ac_2 = "THE autonomous run SHALL execute on a RESTRICTED tool surface (built via the existing sub-agent RestrictTools mechanism) that OMITS the money/chain core_execute delegate entirely, so a run physically cannot reach the signing path regardless of model intent or a mis-classified item."
ac_3 = "THE autonomous opportunity picker SHALL only ever select opportunities flagged eligible_autonomous (non-financial); a financial opportunity SHALL NEVER be auto-run."
ac_4 = "WHERE the extraction model's financial flag is uncertain or missing, THE system SHALL apply a deterministic re-check on the opportunity summary and SHALL fail closed (treat as financial / not eligible) when in doubt."
ac_5 = "A financial opportunity SHALL still be CAPTURED and SHALL be SURFACED to the user for explicit approval (where it runs as a normal, gated, user-initiated task), but SHALL never be executed without that explicit approval."

[req.4]
title = "Random idle wake via Chronos (the AUTOMATRIX alarm)"
story = "As a user, I want Neo to pick up proactive work during my downtime without me prompting it, at unpredictable-feeling times, so that it never competes with my active use."
ac_1 = "WHEN a user enables Automatrix, THE per-user daemon SHALL create exactly ONE recurring AUTOMATRIX alarm via the Chronos MCP tool (alarm_set); WHEN the user disables it, THE daemon SHALL cancel that alarm."
ac_2 = "THE AUTOMATRIX wake SHALL be delivered by the existing Chronos -> router POST /internal/wake -> daemon /chat path (origin=chronos, alarm_id), and Neo SHALL detect it via an AUTOMATRIX wake marker (a sibling of the existing HEARTBEAT marker) distinct from a normal user message."
ac_3 = "THE wake cadence SHALL feel random rather than clockwork: the engine SHALL reschedule the next wake with randomized jitter within a configured window (and MAY probabilistically skip a fire), while Chronos remains the durable timing backbone (state in Postgres, not memory)."
ac_4 = "ON each wake, THE engine SHALL re-read the per-user opt-in setting and SHALL do nothing (and cancel the alarm) if the user has opted out since the alarm was created."
ac_5 = "ON each wake, IF a run is already in flight for the user (the session is busy), THE engine SHALL NOT start proactive work and SHALL defer (reschedule) — Automatrix never interrupts or competes with real user work."
ac_6 = "IF there is no eligible pending opportunity, THE wake turn SHALL resolve to an idle sentinel (AUTOMATRIX_IDLE) that is SUPPRESSED (no output/surface), exactly like the heartbeat HEARTBEAT_OK suppression, and the next wake SHALL be rescheduled."
ac_7 = "THE number of proactive tasks started SHALL be bounded per day by a configured cap (anti-spam)."

[req.5]
title = "Autonomous execution of one opportunity"
story = "As a user, I want Neo to actually complete a helpful task end-to-end while I'm idle, picking up the full context of where the need arose, so that what I get back is a finished, genuinely-useful result."
ac_1 = "ON a wake with work to do, THE engine SHALL select the single highest-ranked eligible opportunity, mark it scheduled->in_progress, and dispatch a supervised run (session.drive/superviseTask) that is decoupled from any user connection and durable across restart (the Task Durability Rule)."
ac_2 = "THE run SHALL resume into the opportunity's origin_conversation_id so Neo regains the relevant thread transcript + cortex memory (context fidelity), and SHALL build its working objective from the opportunity summary + rationale."
ac_3 = "THE run SHALL execute on the restricted (non-financial) tool surface from req.3 and SHALL be bounded by the normal task wall-clock and step budget."
ac_4 = "THE autonomous turn SHALL be held to the SAME completion gate (Cassandra adjudicator / deterministic grounding) as any state-touching turn; it SHALL be considered done ONLY when it genuinely passes the gate."
ac_5 = "ON genuine completion, THE engine SHALL mark the opportunity done; ON a partial or failed attempt, THE engine SHALL leave it pending (incrementing attempts, bounded), surface NOTHING to the user (no failed-surprise spam), and allow a later wake to retry or eventually dismiss it."

[req.6]
title = "Completion ping — ntfy/Apprise + durable in-app record"
story = "As a user, I want to be pleasantly surprised with a notification when Neo finishes something for me, even if the app is closed, and to always find the result waiting in the app."
ac_1 = "ON genuine completion of an autonomous task, THE system SHALL write a DURABLE in-app record (an automatrix.complete event + sidecar) capturing the opportunity summary, a result summary, the conversation id, a created_at, and an unread flag — the canonical, replayable surface regardless of external delivery."
ac_2 = "THE system SHALL deliver an out-of-app ping through a pluggable Notifier whose DEFAULT backend is ntfy (POST to ${NTFY_SERVER}/${topic}, with a per-user topic derived from the agent DID or set by config), and whose OPTIONAL backend is Apprise (APPRISE_URL or the apprise CLI) for fan-out to other services."
ac_3 = "WHERE no notifier is configured, THE system SHALL fall back to a no-op external send while STILL writing the durable in-app record, so a result is never lost."
ac_4 = "EXTERNAL delivery SHALL be best-effort and SHALL NEVER block the agent loop; a failed external send SHALL be logged and SHALL NOT be reported to the user as delivered (honest failure), while the in-app record remains."
ac_5 = "THE notification and in-app surfaces SHALL show the RESULT, not the protocol — no Chronos/alarm/marker/cortex jargon — consistent with the consumer-product rule."

[req.7]
title = "Opt-in control + opportunity management UI"
story = "As a user, I want to turn proactive Neo on or off and see/curate what it's considering, so that I'm always in control of unprompted behavior."
ac_1 = "THE proactive behavior SHALL be OPT-IN: a per-user setting (default OFF) stored in the per-user daemon settings governs whether Neo wakes to work; the engine SHALL treat this setting as authoritative on every wake."
ac_2 = "THE client SHALL provide a Settings -> Automatrix section with the master toggle and a plain-language explanation (Neo occasionally works on helpful things you mentioned and tells you when done; never anything that spends money), following UI house rules (separation by background-color contrast, never border strokes; no emojis, gradients, or glow)."
ac_3 = "THE client SHALL present a queue view of pending opportunities where the user can DISMISS an item (status->dismissed) or APPROVE a financial item for a normal, gated, user-initiated run."
ac_4 = "THE client SHALL present the completion inbox / unread badge from req.6 so the surprise results are discoverable on next open."
ac_5 = "TOGGLING the setting ON SHALL cause the AUTOMATRIX alarm to be created and OFF SHALL cause it to be cancelled (req.4.1), with the change taking effect without a process restart."

[req.8]
title = "Safety, ownership, and honesty boundaries"
story = "As the system owner, I want Automatrix to be scoped, off-chain, honest, and non-spammy, so that an autonomous feature cannot be abused or erode trust."
ac_1 = "THE AUTOMATRIX alarm SHALL be DID-scoped per Chronos (an agent only creates/lists/cancels its own alarms; the wake target derives from the verified DID), and Automatrix SHALL perform NO on-chain action and hold NO signing key (Chronos i5/i7; frozen invariant i1)."
ac_2 = "AUTOMATRIX SHALL NOT modify the signed MCL walk (compile/plan/walk/synthesize/critic/emitFinalTurn, D11 byte-identity) and SHALL NOT grant Chronos any new signing/cortex/plan-walk capability — Chronos only delivers a /chat turn; Neo does the work."
ac_3 = "NEO SHALL NEVER fabricate that a proactive task was completed; a ping SHALL be sent only after the completion gate genuinely accepts (req.5.4), and partial/failed work is never announced as done."
ac_4 = "AUTOMATRIX SHALL respect the per-day task cap and SHALL defer on a busy session (req.4.5/4.7), so proactive work cannot spam the user or starve real work."
ac_5 = "NO secrets, tokens, private keys, or .env values SHALL be stored in opportunity records, notifications, or the durable completion sidecar."

[req.9]
title = "Real verification — no fakes"
story = "As the system owner, I want Automatrix proven against real code paths, so that capture, gating, idle wake, execution, and notify genuinely work before it ships."
ac_1 = "THE feature SHALL verify capture against the REAL consolidator extraction: a transcript with an implied need yields a real cortex Opportunity record; a transcript without one yields none; a direct request is not captured."
ac_2 = "THE feature SHALL verify the non-financial guarantee against real code: a financial opportunity is never returned by the eligible-pending reader, and the restricted tool surface really lacks the money core_execute tool (assert the actual schema set), failing closed on uncertain classification."
ac_3 = "THE feature SHALL verify the wake path against real code: the AUTOMATRIX marker is detected, AUTOMATRIX_IDLE suppresses the turn, a busy session defers, and an opted-out user is refused."
ac_4 = "THE feature SHALL verify notify against a real ntfy backend (httptest round-trip) and that the durable in-app record is written and marked unread; a failed external send still leaves the record."
ac_5 = "THE feature SHALL verify the opt-in lifecycle: enabling creates the alarm and disabling cancels it, and the engine refuses proactive work when the setting is off."
ac_6 = "NO test in this feature SHALL substitute a stub/mock/fake for a real code path or type to manufacture a pass."

# ================================ TASKS ==================================

[tasks]
heading = "Implementation Plan: Automatrix — Neo Proactive Surprise Tasks"

[task.1]
section = "P1 — Capture + cortex opportunity queue"
title   = "Opportunity memory model, pager surface, and per-turn extraction"
status  = "done"

[task.1.1]
title  = "Opportunity cortex record + pager surface (Remember/Pending/SetStatus)"
status = "done"
wave   = 1
do_1   = "Add an Opportunity record shape to neo/internal/memory (reusing the typed-record/Goal machinery): summary, rationale, status(pending|scheduled|in_progress|done|dismissed), eligible_autonomous, confidence, origin_conversation_id, attempts, created_at/updated_at; scoped to the owning user/agent; no secrets"
do_2   = "Add pager methods in neo/internal/memory/writeback.go (+ a reader): RememberOpportunity (dedup-or-write against pending opportunities via normalize + semantic similarity), PendingOpportunities(limit) returning ONLY eligible_autonomous+pending ranked by confidence x salience x recency, and SetOpportunityStatus(uri,status) persisted atomically"
reqs   = ["2.1", "2.2", "2.3", "2.4", "2.5"]

[task.1.2]
title  = "Extend the consolidator with the `opportunities` extraction class"
status = "done"
wave   = 2
do_1   = "Add an `opportunities` array (summary, rationale, financial, confidence) to consolidatePrompt + the extract struct in neo/internal/writeback/consolidator.go, with selective 'usually []' rules: grounded in something the user said (rationale required), specific+actionable, NOT a direct request, financial flag set, drop below the confidence floor"
do_2   = "Fan accepted opportunities (capped per turn like the other classes) into pager.RememberOpportunity; capture runs regardless of opt-in so the queue stays warm"
reqs   = ["1.1", "1.2", "1.3", "1.4", "1.5"]
requires = ["1.1"]

[task.2]
section = "P2 — Non-financial gating (structural)"
title   = "Financial classification + the restricted (no-money) tool surface"
status  = "done"

[task.2.1]
title  = "Financial classification + deterministic fail-closed re-check"
status = "done"
wave   = 2
do_1   = "Map the extraction `financial` flag to eligible_autonomous=false; add a deterministic re-check on the opportunity summary (keyword + flag) that fails CLOSED (treat as financial / not eligible) when uncertain; financial opportunities are still captured (surfaced for approval, never auto-run)"
reqs   = ["3.1", "3.3", "3.4", "3.5"]
requires = ["1.1"]

[task.2.2]
title  = "Restricted autonomous tool surface excluding the money core_execute path"
status = "done"
wave   = 2
do_1   = "Build the Automatrix run's tool surface via the existing sub-agent RestrictTools mechanism so it OMITS the money/chain core_execute delegate entirely; add a guard/test asserting the actual advertised tool schema set contains no value-moving/signing tool"
reqs   = ["3.1", "3.2"]

[task.3]
section = "P3 — Chronos AUTOMATRIX wake"
title   = "The AUTOMATRIX alarm convention, marker detection, and scheduling"
status  = "done"

[task.3.1]
title  = "Chronos automatrix convention package (sibling of internal/heartbeat)"
status = "done"
wave   = 2
do_1   = "Add chronos/internal/automatrix mirroring chronos/internal/heartbeat: the canonical AUTOMATRIX WakeMessage/marker + a BuildAlarm helper (recurring cron alarm carrying the AUTOMATRIX wake_message), kept in sync with the Neo-side constants"
reqs   = ["4.2"]

[task.3.2]
title  = "Neo-side AUTOMATRIX marker + idle sentinel (sibling of agent/heartbeat.go)"
status = "done"
wave   = 3
do_1   = "Add neo/internal/agent/automatrix.go: AutomatrixWakeMarker, AutomatrixWakeMessage, AutomatrixIdle sentinel, isAutomatrixWake(input), and shouldSuppressAutomatrix(answer) — mirroring the heartbeat HEARTBEAT/HEARTBEAT_OK convention so AUTOMATRIX_IDLE suppresses the turn"
do_2   = "Wire suppression into the agent finish path alongside the existing heartbeat suppression"
reqs   = ["4.2", "4.6"]
requires = ["3.1"]

[task.3.3]
title  = "Engine wake handler: opt-in re-check, busy-defer, pick-one, jittered reschedule, daily cap"
status = "done"
wave   = 4
do_1   = "In the Neo engine/server, recognize an AUTOMATRIX wake and: re-read the opt-in setting (cancel alarm + return if off); defer+reschedule if the session is busy (a run in flight); enforce the per-day cap; select the top eligible opportunity (none -> AUTOMATRIX_IDLE) and reschedule the next wake with randomized jitter (and probabilistic skip)"
do_2   = "Persist the per-day counter + next-jittered-fire reschedule via the Chronos alarm (DB is source of truth); jitter/skip logic lives in Neo"
reqs   = ["4.3", "4.4", "4.5", "4.6", "4.7"]
requires = ["1.2", "2.1", "2.2", "3.2", "4.1"]

[task.4]
section = "P4 — Autonomous execution"
title   = "Run one opportunity end-to-end on the restricted surface, gated"
status  = "done"

[task.4.1]
title  = "Dispatch a supervised restricted-surface run resuming into the origin conversation"
status = "done"
wave   = 5
do_1   = "From the wake handler, mark the picked opportunity scheduled->in_progress and dispatch session.drive/superviseTask resuming into origin_conversation_id, building the objective from summary+rationale, on the restricted (no-money) tool surface, bounded by the normal wall-clock/step budget"
do_2   = "Hold the turn to the SAME completion gate as any state-touching turn; on genuine pass mark done, on partial/fail leave pending (attempts++ bounded) and surface nothing"
reqs   = ["5.1", "5.2", "5.3", "5.4", "5.5"]
requires = ["3.3", "2.2"]

[task.5]
section = "P5 — Notify (ntfy/Apprise + durable record)"
title   = "Pluggable Notifier and the durable in-app completion record"
status  = "done"

[task.5.1]
title  = "neo/internal/notify: Notifier interface + ntfy + Apprise + noop backends"
status = "done"
wave   = 2
do_1   = "Create neo/internal/notify with Notification{Title,Body,URL} + Notifier interface; ntfy backend (POST ${NTFY_SERVER}/${topic}, DID-derived topic, Title/Click headers); Apprise backend (APPRISE_URL or apprise CLI); noop fallback; best-effort + non-blocking + honest-failure logging"
do_2   = "Add config knobs ([automatrix] + NEO_* env): enabled, base_interval_minutes, jitter_minutes, max_tasks_per_day, min_confidence, NTFY_SERVER/NTFY_TOPIC, APPRISE_URL"
reqs   = ["6.2", "6.3", "6.4", "8.5"]

[task.5.2]
title  = "Durable automatrix.complete record + broker event"
status = "done"
wave   = 3
do_1   = "Add an automatrix.complete broker event + a durable sidecar (mirroring neo/internal/trace) recording {opportunity_summary, result_summary, conversation_id, created_at, read}; expose a reader for the in-app inbox/badge; no secrets stored"
reqs   = ["6.1", "6.5", "8.5"]

[task.5.3]
title  = "Wire completion -> durable record + notify"
status = "done"
wave   = 6
do_1   = "On genuine autonomous completion, write the durable record and fire the Notifier (best-effort); show result-not-protocol copy; never announce a non-completed task"
reqs   = ["6.1", "6.4", "6.5", "8.3"]
requires = ["4.1", "5.1", "5.2"]

[task.6]
section = "P6 — Control surface (opt-in + management)"
title   = "Daemon opt-in setting, alarm lifecycle, and client UI"
status  = "done"

[task.6.1]
title  = "Daemon opt-in setting + alarm create/cancel lifecycle + queue/manage endpoints"
status = "done"
wave   = 5
do_1   = "Add automatrix_enabled (default false) to the per-user daemon settings; on enable create the AUTOMATRIX alarm (chronos alarm_set), on disable cancel it; expose authenticated endpoints to read the opportunity queue, dismiss an item, approve a financial item for a normal gated run, and read the completion inbox"
reqs   = ["7.1", "7.5", "8.1"]
requires = ["3.1"]

[task.6.2]
title  = "Client Settings -> Automatrix: toggle, explanation, queue view, completion inbox"
status = "done"
wave   = 7
do_1   = "Add a Settings -> Automatrix section (apps/client, mirror apps/mobile): master toggle + plain-language explanation; queue view with dismiss + approve-financial; completion inbox / unread badge; UI house rules (background-contrast separation, no borders for depth, no emojis/gradients/glow); show result-not-protocol"
reqs   = ["7.2", "7.3", "7.4", "6.5"]
requires = ["6.1", "5.2"]

[task.7]
section = "P7 — Verification (no fakes)"
title   = "Prove capture, gating, wake, execution, notify, opt-in"
status  = "done"

[task.7.1]
title  = "Capture extraction test (real consolidator)"
status = "done"
wave   = 3
do_1   = "Against the real consolidator extraction: an implied-need transcript yields a real cortex Opportunity record; a no-opportunity transcript yields none; a direct request is not captured; dedup suppresses a repeat"
property  = "Property 1: capture is grounded, selective, deduped, opt-in-independent"
validates = "Requirements 1.1, 1.2, 1.3, 1.5, 2.3"
requires = ["1.2"]

[task.7.2]
title  = "Non-financial gating test (real reader + real tool surface)"
status = "done"
wave   = 3
do_1   = "Real tests: a financial opportunity is never returned by PendingOpportunities; uncertain classification fails closed; the restricted tool surface's actual advertised schema set contains no money/signing core_execute tool"
property  = "Property 2: money can never be reached by an autonomous run (structural)"
validates = "Requirements 3.1, 3.2, 3.3, 3.4"
requires = ["2.1", "2.2"]

[task.7.3]
title  = "Wake-path test (marker, idle suppression, busy-defer, opt-out)"
status = "done"
wave   = 5
do_1   = "Real tests: isAutomatrixWake detects the marker; AUTOMATRIX_IDLE suppresses the turn; a busy session defers (reschedules, no run); an opted-out user is refused and the alarm cancelled; per-day cap enforced"
property  = "Property 3: wakes are idle-only, non-competing, opt-in-gated, bounded"
validates = "Requirements 4.4, 4.5, 4.6, 4.7"
requires = ["3.3"]

[task.7.4]
title  = "Notify + durable record test (real ntfy httptest)"
status = "done"
wave   = 6
do_1   = "Real ntfy backend round-trip against an httptest server; the durable automatrix.complete record is written + marked unread; a failed external send still leaves the record (honest failure); no protocol jargon in the payload"
property  = "Property 4: the result is always durably recorded; pings are honest"
validates = "Requirements 6.1, 6.2, 6.4, 8.3"
requires = ["5.3"]

[task.7.5]
title  = "Opt-in lifecycle test (alarm create/cancel + engine refusal)"
status = "done"
wave   = 6
do_1   = "Real tests: enabling creates exactly one AUTOMATRIX alarm and disabling cancels it; the engine refuses proactive work when the setting is off; toggle takes effect without a restart"
property  = "Property 5: opt-in is authoritative and reversible"
validates = "Requirements 4.1, 7.1, 7.5"
requires = ["6.1"]

[task.8]
title  = "Final checkpoint — Automatrix complete"
status = "done"
note   = "All five properties green. With Automatrix enabled, Neo silently captures unrequested, grounded opportunities into a deduped cortex queue during normal chat; while the user is idle a jittered Chronos AUTOMATRIX wake (deferring on a busy session, bounded per day, refused when opted out) picks the top non-financial opportunity and completes it end-to-end on a restricted tool surface that structurally cannot reach money; on a genuinely gate-passed completion the user is pinged via ntfy/Apprise and the result is durably recorded in an in-app inbox — a real surprise, never a fabricated one, never anything that spends. Financial opportunities are only ever surfaced for explicit approval. Default OFF; user-controlled in Settings. No change to the signed MCL walk or Chronos's no-sign/no-cortex boundary. Deploy is user-driven."
