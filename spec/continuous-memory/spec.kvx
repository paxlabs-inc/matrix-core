# spec.kvx — Continuous Memory (cortex as the self-managing memory brain).
# SINGLE SOURCE for this feature's requirements + design + tasks. Rendered to
# requirements.md / design.md / tasks.md by spec/specgen. Do not edit the
# generated markdown; edit this file and regenerate.
#
# Format: Matrix .kvx (see tachyon/internal/config/kvx.go). One key = value per
# line; string values double-quoted; lists are ["a","b"]; # starts a comment.
# Schema:
#   [req.<n>]   title, story, ac_1..ac_n          (acceptance criteria, EARS)
#   [design]    overview, include="design.body.md" (rich prose/diagrams inlined)
#   [task.<id>] title, status, wave, reqs, requires (dotted ids: 1, 1.1, 1.2)

[meta]
feature      = "continuous-memory"
title        = "Continuous Memory — cortex as the self-managing memory brain"
status       = "draft"
spec_version = "0.1.0"
intro        = "Make cortex the self-managing memory BRAIN. Today the brain is split: cortex is a durable tamper-evident store, but the agent (Neo) runs a parallel controller on top of it — neo/internal/memory/pager.go does selection/ranking/recency re-rank, a.summary + a.compact keep an ephemeral 'story so far' per process, and the transcript lives only in the agent's in-memory working slice; cortex.Context and cortex.Compact have NO Neo consumer. This feature closes that split. cortex takes ownership of the ENTIRE memory lifecycle — durable storage, the live conversation transcript, working-set/activation selection, ranking, multi-resolution temporal compaction, and recursive recall — and the agent is reduced to four verbs: Append(conv,message) -> Activate(conv,query,budget)->bundle -> render -> transport. The model is given a PERCEIVED continuous linear memory via selective orchestration across four tiers (T0 coarse timeline, T1 recent episodes, T2 active window + transcript slice, T3 exact specifics paged in on demand), realised as a multi-resolution temporal index over the cortex journal exposed as a RECURSIVE retrieval environment (RLM applied to time; arXiv 2512.24601) so exact events are paged in, never resident. HARD lane discipline: everything new and mutable (session/transcript records, temporal-ladder rollups, activation caches, story-so-far checkpoints) lives in the derived, journaled-but-NOT-anchored lane (same posture as cortex.Compact, compact.go:429-431 — journal MMR append + derived chk/-family records, NO memories/edges SMT write) so cortex can actively manage itself WITHOUT perturbing OverallRoot / the cortex_snapshot_hash root / D11 replay byte-identity. cortex.Context stays a pure read composer for the anchored world-state; the new Activate is additive. Scope = FULL VERTICAL: cortex-core brain + collapse of Neo's memory controller into it + client-visible tie-ins. Resolved open questions (user-locked): Q1 rollups = derived chk/-style records (NOT a 10th memory type); Q2 fixed wall-clock windows hour->day->week/epoch with an event-count floor; Q3 two-lane summarizer (deterministic extractive floor + optional rebuildable LLM enrichment); Q4 cascade eager on window-close (Chronos sweep) + lazy read-repair; Q5 recursive recall depth cap 4 + per-descent token budget, hard ceiling reuses MaxHopsCap=6; Q7 provider-agnostic Message schema; Q8 Activate holds Context p50<80ms by serving tiers from materialized derived records + per-turn pinned cache (also fixes audit NE-7). These requirements trace to the approved design (rendered into design.md)."

[design]
overview = "See the full design below: the split-brain problem and the self-managing-brain fix, the four-tier model (T0/T1/T2/T3), the locked decisions + resolved open questions, a code-grounded seam map, what-exists-vs-gap, the new cortex surfaces (session/transcript store with a provider-agnostic Message record, the temporal ladder with a deterministic extractive floor + optional LLM enrichment, the Activate composer extending Context, and recursive recall), the system map, the Neo collapse (retire the pager/a.summary/a.compact/dynamicTail), migration + retro-compat, config knobs, non-goals, and the no-fakes verification strategy anchored on a D11 replay byte-identity proof. Authored as a rich markdown fragment (design.body.md) and inlined here verbatim, because diagrams and tables do not fit single-line kvx values."
include  = "design.body.md"

# ============================== REQUIREMENTS ==============================

[req.1]
title = "Durable session / transcript store in cortex"
story = "As the system, I want the live conversation transcript owned and stored durably by cortex, so that the raw turn-by-turn record survives restarts and becomes the raw-fidelity floor of the temporal ladder instead of living only in the agent's memory."
ac_1 = "CORTEX SHALL expose an AppendMessage surface that records a single conversation message (user | assistant | tool_call | tool_result | system) durably, scoped to the owning actor + conversation, with a per-conversation monotonic gap-free sequence number and a timestamp."
ac_2 = "EACH appended message SHALL be written in the derived, journaled-but-NOT-anchored lane (a journal entry + a derived sess/-family record, NO memories/edges SMT write), identical in posture to cortex.Compact (compact.go:429-431)."
ac_3 = "CORTEX SHALL expose a Transcript reader returning an ordered slice of messages for a conversation from a given sequence, bounded by a limit."
ac_4 = "A large tool_result payload SHALL be spilled to a resolvable reference (the overflow discipline) so the transcript store stays a page-in target (T3), never resident bloat."
ac_5 = "SESSION records SHALL NOT store secrets, tokens, private keys, or .env values."

[req.2]
title = "Provider-agnostic message schema"
story = "As the system, I want a neutral representation of conversation messages, so that cortex can store and compact the transcript without coupling to any LLM provider's wire shape."
ac_1 = "THE Message record SHALL be provider-agnostic: {role: user|assistant|tool_call|tool_result|system, content, tool_name?, tool_args?, tool_result_ref?, media_refs[], ts, seq}, with NO dependency on Fireworks / OpenAI / Baseten request shapes."
ac_2 = "THE agent SHALL be responsible for translating the neutral Message into the provider wire shape at transport time; cortex SHALL never emit provider-specific request bytes."
ac_3 = "TOOL calls and tool results SHALL be representable losslessly (name + canonical-JSON args for calls; content or a result reference for results)."

[req.3]
title = "Temporal rollup records (derived, multi-resolution)"
story = "As the system, I want multi-resolution summaries of the past stored durably, so that the coarse timeline (T0) and recent episodes (T1) are materialized rather than recomputed on every turn."
ac_1 = "CORTEX SHALL persist temporal rollup records at multiple resolutions (at least hour, day, and week/epoch), each carrying its time window, resolvable member references, a deterministic short-form summary, and a salience score."
ac_2 = "ROLLUP records SHALL be derived chk/-style records keyed by TIME WINDOW (a roll/-family key), NOT a new 10th memory type, and SHALL perform NO memories/edges SMT write."
ac_3 = "EACH rollup's member references SHALL resolve to its constituent journal entries or finer-resolution rollups, so exact specifics are paged in on demand rather than resident (T3-as-invocation at the record level)."
ac_4 = "THE rollup shape SHALL support an optional enrichment reference to a richer summary record that MAY be absent, without which the deterministic short-form stands alone."

[req.4]
title = "Deterministic rollup builder + cascade + two-lane summarizer"
story = "As the system, I want rollups built deterministically and cascaded coarser, so that the ladder is idempotent, rebuildable from the journal, and replay-safe."
ac_1 = "THE rollup builder SHALL window the journal by wall-clock buckets over CreatedAt/Seq, be idempotent (re-running over the same window yields the same record), and skip windows below a configured event-count floor."
ac_2 = "THE builder's deterministic lane SHALL produce the short-form summary purely from journal facts in the window (top-salience references, verb/outcome tallies, counts) so the same inputs yield byte-identical output."
ac_3 = "AN optional LLM enrichment lane MAY write a richer prose summary ONLY as a separate derived record that is rebuildable from the deterministic short-form, and SHALL NEVER be load-bearing for determinism or replay."
ac_4 = "THE cascade SHALL roll finer windows into coarser ones (hour -> day -> week/epoch), each level built with the same deterministic discipline."

[req.5]
title = "Scheduler + lazy read-repair for the cascade"
story = "As the system, I want rollups produced automatically when windows close and repaired on read if missing, so that the ladder stays current with bounded work and self-heals."
ac_1 = "THE cascade SHALL run EAGERLY on window-close via a Chronos-scheduled sweep (the existing durable alarm machinery), doing bounded work per sweep."
ac_2 = "A read that encounters a missing or stale coarser-tier rollup SHALL trigger an idempotent rebuild (lazy read-repair) that yields a record identical to the eager path."
ac_3 = "THE scheduler SHALL grant Chronos NO new signing / cortex-write / plan-walk capability beyond delivering the sweep trigger; the rollup write happens inside cortex on the derived lane."

[req.6]
title = "T1 recent-episodes reader"
story = "As the agent, I want a general 'last N episodes across types' reader, so that mid-range recent context is available at higher fidelity than the coarse timeline."
ac_1 = "CORTEX SHALL expose a T1 reader returning the last N episodes across memory types (not verb/object-keyed like the existing tierOutcomes), ranked by the existing salience recency substrate (R=exp(-dt/90d), salience.go:209-216)."
ac_2 = "THE T1 reader SHALL be served from materialized rollup / recent records so it does not recompute a scan on every call."

[req.7]
title = "Activation composer (Activate extends Context)"
story = "As the agent, I want one call that returns the whole hot working set for a turn, so that cortex — not an agent-side pager — decides what to surface now, at what resolution, under a budget."
ac_1 = "CORTEX SHALL expose Activate(conv, query, budget) returning a structured bundle {Pinned, Timeline(T0), Recent(T1), Transcript(T2 slice), StorySoFar, ReachableURIs(T3 handles)}, budget-trimmed by a single global salience-ascending trim like Context."
ac_2 = "ACTIVATE SHALL serve the Timeline and Recent tiers from MATERIALIZED derived rollups (no live recompute) and the Transcript slice from the session store, and SHALL compute the Pinned tier ONCE per turn via a cache (fixing the per-step pinned recompute, audit NE-7)."
ac_3 = "ACTIVATE SHALL hold the Context latency discipline (p50 < 80 ms, hard ceiling < 250 ms) for the whole call INCLUDING the transcript slice."
ac_4 = "ACTIVATE SHALL be additive: cortex.Context SHALL remain a pure, no-mutation read composer for the anchored world-state and SHALL keep its existing consumers working unchanged."
ac_5 = "WHERE a conversation has no session transcript yet (pre-migration / CLI), ACTIVATE SHALL degrade gracefully to the Context tiers so those paths keep working."
ac_6 = "ACTIVATE SHALL emit NOTHING that mutates the anchored world-state (no memories/edges SMT write, no snapshot_hash change); any caching it does SHALL live in the derived lane."

[req.8]
title = "Recursive recall (RLM applied to time)"
story = "As the model, I want to decompose the timeline and descend into it, so that I can page in exact specifics on demand instead of relying on a single flat lookup."
ac_1 = "THE recall surface SHALL be upgraded from a flat lookup into a decomposable recursive descent: list T0 windows -> pick a window -> resolve its member references -> sub-query within, over the session store + rollups + journal."
ac_2 = "THE descent SHALL be bounded by a depth cap of 4 (mirroring T0->T3) and a per-descent token budget, with a hard ceiling reusing the existing MaxHopsCap = 6 discipline."
ac_3 = "BI-TEMPORAL as_of ('what was true then') SHALL be preserved at every descent level so timeline time-travel still works."
ac_4 = "RECURSIVE recall SHALL stay OFF the per-turn hot path (tool-invoked, on demand), so it never threatens the Activate latency budget."

[req.9]
title = "Neo collapse — agent reduced to append + activate + render + transport"
story = "As the maintainer, I want Neo's parallel memory controller absorbed into cortex, so that there is one brain, not two, and the agent only appends and renders."
ac_1 = "NEO's turn loop SHALL append each user / assistant / tool message to cortex via AppendMessage, and SHALL request its working context once per turn via cortex.Activate."
ac_2 = "NEO's agent-side selection / ranking / recency re-ranking (neo/internal/memory/pager.go) SHALL be collapsed into a thin client of cortex.Activate, leaving NO independent brain logic agent-side."
ac_3 = "THE ephemeral 'story so far' (a.summary) and the agent-side transcript compaction (a.compact, agent.go:562) SHALL be RETIRED; story-so-far SHALL be durable in cortex, produced by the ladder over the conversation's own transcript."
ac_4 = "THE dynamicTail memory sections (prompt.go:70) SHALL be replaced by the rendered Activate bundle, delivered as a USER-role trailing message (preserving the Qwen-template prompt-window portability fix), keeping the byte-stable system prefix at index 0."
ac_5 = "THE recursive memory_recall tool SHALL be wired to the cortex recursive-recall surface (req.8), preserving the AmbientRetrievalTopK pull-over-push philosophy."

[req.10]
title = "Client-visible continuous-memory surface"
story = "As a user, I want to see the memory that Neo carries — the story so far and a memory timeline — so that continuous memory is legible, following the consumer-product rule of showing the result not the protocol."
ac_1 = "THE client SHALL surface the conversation's story-so-far and/or a memory timeline (T0/T1) in a way that shows the RESULT, not the protocol (no journal / MMR / rollup / snapshot jargon)."
ac_2 = "THE surface SHALL follow UI house rules: separation by background-color contrast only (NEVER border strokes for depth), and NO emojis, purple gradients, or glow effects."

[req.11]
title = "Replay-safety — the brain never perturbs the anchored world"
story = "As the system owner, I want cortex to actively manage memory without ever changing the anchored world-state root, so that the tamper-evident ground truth and D11 replay determinism are preserved."
ac_1 = "ALL new writes (session/transcript records, rollups, enrichment, activation caches, story-so-far checkpoints) SHALL ride the derived, journaled-but-NOT-anchored lane and SHALL perform NO memories/edges SMT write."
ac_2 = "RUNNING the system with the continuous-memory lane active vs inactive SHALL yield a BYTE-IDENTICAL anchored world-state root (OverallRoot / cortex_snapshot_hash), proven by a replay harness against real code."
ac_3 = "THE feature SHALL NOT modify the signed MCL walk (compile / plan / walk / synthesize / critic / emitFinalTurn, D11 byte-identity) and SHALL NOT grant the Liaison any cortex-write / signing / plan-walk capability."

[req.12]
title = "Real verification — no fakes"
story = "As the system owner, I want continuous memory proven against real code paths, so that storage, the ladder, activation, recursive recall, and the Neo collapse genuinely work before it ships."
ac_1 = "THE feature SHALL verify session storage against real cortex: a real AppendMessage round-trips through a real Transcript read, in order, with correct sequencing."
ac_2 = "THE feature SHALL verify the ladder against a real journal: a real window builds a deterministic rollup whose short-form is byte-identical on rebuild; the cascade is idempotent; an empty window under the floor produces no rollup; lazy read-repair rebuilds a deleted record identically."
ac_3 = "THE feature SHALL verify recursive recall against real code: a decomposable descent reaches an exact event NOT resident in the activation bundle; depth cap and per-descent budget are enforced; as_of returns the then-true view."
ac_4 = "THE feature SHALL verify Activate against real code: it returns the tiers + transcript slice + story-so-far under budget, holds the latency discipline, and computes Pinned once per turn."
ac_5 = "THE feature SHALL verify the Neo collapse against the real turn loop: Neo consumes Activate (not the pager), appends messages to cortex, renders the bundle, and story-so-far survives a simulated process restart."
ac_6 = "THE feature SHALL verify replay-safety: the active-vs-inactive anchored-root byte-identity proof (req.11.2) passes against real code."
ac_7 = "NO test in this feature SHALL substitute a stub/mock/fake for a real code path or type to manufacture a pass."

# ================================ TASKS ==================================

[tasks]
heading = "Implementation Plan: Continuous Memory — cortex as the self-managing memory brain"

[task.1]
section = "P1 — Foundations: session store + replay-safety harness"
title   = "The provider-agnostic transcript store and the D11 safety baseline"
status  = "pending"

[task.1.1]
title  = "Provider-agnostic Message record + session/transcript store (AppendMessage / Transcript)"
status = "done"
wave   = 1
do_1   = "Add a cortex/session package: the neutral Message record {role: user|assistant|tool_call|tool_result|system, content, tool_name?, tool_args?(canonical JSON), tool_result_ref?, media_refs[], ts, seq} with NO provider coupling"
do_2   = "Implement AppendMessage (derived lane: journal entry of a new derived Kind + a sess/<conv>/<seq> record, per-conversation monotonic gap-free seq, actor+conversation scoped, NO SMT write, mirroring compact.go:429-431) and Transcript(conv, sinceSeq, limit); spill large tool_result payloads to a resolvable ref (overflow discipline); store no secrets"
reqs   = ["1.1", "1.2", "1.3", "1.4", "1.5", "2.1", "2.2", "2.3"]

[task.1.2]
title  = "Replay-safety harness (baseline: derived lane does not touch the anchored root)"
status = "done"
wave   = 1
do_1   = "Build a replay harness against real cortex that drives a real journal and asserts a byte-identical OverallRoot / cortex_snapshot_hash with the continuous-memory derived lane active vs inactive; establish it on the session-store writes from 1.1 as the baseline the ladder + activation must also satisfy"
reqs   = ["11.1", "11.2", "11.3"]
requires = ["1.1"]

[task.2]
section = "P2 — Temporal ladder"
title   = "Multi-resolution rollup records + deterministic builder + cascade"
status  = "pending"

[task.2.1]
title  = "Rollup record shape (roll/-family, derived) + deterministic extractive builder"
status = "done"
wave   = 2
do_1   = "Add the Rollup record (window{tier,start,end}, member Refs, deterministic ShortForm, salience, optional EnrichRef) as a derived roll/-family chk-style record keyed by time window, NOT a 10th memory type, NO SMT write"
do_2   = "Implement BuildRollup(window): deterministic extractive summary purely from journal facts in the window (top-salience Refs via salience.go recency, verb/outcome tallies, counts); idempotent (same window -> byte-identical record); skip windows below the event-count floor"
reqs   = ["3.1", "3.2", "3.3", "3.4", "4.1", "4.2"]
requires = ["1.2"]

[task.2.2]
title  = "Cascade hour -> day -> week/epoch (idempotent)"
status = "done"
wave   = 3
do_1   = "Implement Cascade(upTo, now): roll finer windows into coarser ones (hour->day->week/epoch), each level built with the same deterministic discipline, idempotent and rebuildable from the journal"
reqs   = ["4.4"]
requires = ["2.1"]

[task.2.3]
title  = "Optional LLM enrichment lane (separate derived record, rebuildable)"
status = "done"
wave   = 3
do_1   = "Add an optional enrichment record referenced by Rollup.EnrichRef, produced by an LLM, written as a SEPARATE derived record rebuildable from the deterministic ShortForm; absent/stale enrichment leaves the deterministic short-form standing; enrichment never feeds determinism or replay; gated by a config knob"
reqs   = ["3.4", "4.3"]
requires = ["2.1"]

[task.3]
section = "P3 — Scheduler + tiers"
title   = "Chronos window-close sweep, lazy read-repair, and the T1 reader"
status  = "pending"

[task.3.1]
title  = "Chronos window-close cascade sweep + lazy read-repair"
status = "pending"
wave   = 4
do_1   = "Schedule the cascade eagerly on window-close via a Chronos alarm (bounded work per sweep; Chronos gains NO signing/cortex-write/plan-walk capability — the rollup write happens inside cortex on the derived lane)"
do_2   = "Add lazy read-repair: a read that finds a missing/stale coarser-tier rollup triggers an idempotent rebuild yielding a record identical to the eager path"
