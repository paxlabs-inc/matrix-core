# spec.kvx — Cody Launch (commercial-grade hardening; the Claude Code bar).
# SINGLE SOURCE for this feature's requirements + design + tasks. Rendered to
# requirements.md / design.md / tasks.md by spec/specgen. Do not edit the
# generated markdown; edit this file and regenerate.
#
# Format: Matrix .kvx (see tachyon/internal/config/kvx.go). One key = value per
# line; string values double-quoted; lists are ["a","b"]; # starts a comment.
# Schema:
#   [req.<n>]   title, story, ac_1..ac_n          (acceptance criteria, EARS)
#   [design]    overview, include="design.body.md" (rich prose/diagrams inlined)
#   [task.<id>] title, status, wave, reqs, requires (dotted ids: 1, 1.1, 1.2)

[meta]
feature      = "cody-launch"
title        = "Cody Launch — commercial-grade hardening (the Claude Code bar)"
status       = "draft"
spec_version = "0.1.0"
intro        = "The 25-session (one-month) launch pass that folds the 2026-07-05 Neo/Cody/Cassandra audit into a sequenced, dependency-waved plan and fixes it to a commercial bar. Cody, spec/cody-client, and spec/cody-smoothness are specced and largely built, yet a real creative-build run was 'absolutely dog shit': the worker burned ~90 model calls flailing for a screenshot it could never take (Y3 — the screenshot gate is unsatisfiable without an external browser service), turned in with absolute paths a blind adjudicator could not read (Y1 — gate.renderSource skips absolute paths, so Cassandra sees no file source), was rejected three times with no possible action (Y6 — no unsatisfiable-gate detection), and the plan died producing nothing viewable. Neo separately still spiralled on a completion loop (N2 — the task_complete branch bypasses the stall detector and genuine work resets the nudge counter, so an interleaved work->premature-complete->reject pattern is bounded only by the step budget). The two most safety-critical test suites do not even compile (N1/C1 — a citation-removal refactor left neo/internal/agent and cassandra tests calling deleted symbols), so there is zero regression protection on the completion gate and the completeness auditor. This feature removes the shared failure class (one path-normalization seam; capability-aware satisfiable gates; unified unproductive-attempt accounting; one shared acceptance predicate that fails toward refusal), restores regression safety, brings Cody's depth up (cached-recon economy, ceremony fast-path, the intended spec.kvx/design.body.md/specgen pipeline with research + clarifying-questions phases), polishes the built /cody coding surface to the Claude Code bar (design-quality conformance + house rules, progress/narration, diff/tree fidelity, live terminal + dev-server preview, plan board + real evidence cards), and PROVES it with no-fakes end-to-end tests including a creative build that produces a real running preview and a real screenshot. The bar is non-negotiable: as good as Claude Code, for users, no exceptions; every session is production/commercial grade (Google/AWS/Microsoft), no shortcuts, no fakes. Each task is ONE session worked under the baked-in protocol (recall + previous-session handoff -> straight to the one eligible task -> build on real code -> write and run tests, fixing ALL broken tests even pre-existing ones -> green -> mark done, write the next-session handoff, record a cortex outcome, close out)."

[design]
overview = "See the full design below: the mission and the Claude Code bar; the three load-bearing ideas (the runtime is judged by the run not the spec; one failure class with three faces; every fix proven against the shape that broke); the audit folded in with severities and file+line citations (BLOCKERS Y1 abs-path adjudication blindness, N1/C1 non-compiling safety-critical test suites; HIGH Y2 worker abs-path double-join, Y3 unsatisfiable screenshot gate, N2 Neo residual completion loop, Y8 missing spec pipeline; MEDIUM Y4/Y5/Y6/Y7/C2/C3/C5; contradictions X1/Y9/X2); the fix architecture (one path seam, capability-aware gates, unified unproductive-attempt accounting, one acceptance predicate, Cody depth+economy); the coding-UI hardening to the Claude Code bar over the already-specced cody-client/cody-smoothness surface; the baked-in 25-session working protocol and the non-negotiable quality bar; the wave sequencing rationale; non-goals; and the no-fakes verification strategy. Authored as a rich markdown fragment (design.body.md) and inlined verbatim."
include  = "design.body.md"

# The 25-session working protocol, machine-readable (mirrors design.body.md).
# specgen renders design/req/task sections; this block is the durable, queryable
# contract source. Follow it EVERY session.
[protocol]
task_per_session = "Each of the 25 tasks is exactly ONE session."
step_1_context   = "cortex_recall (MCP) once at session start; READ IN FULL any output flagged truncated before reasoning (hard rule). Then read spec/cody-launch/spec.kvx and the previous session's handoff (the most recent cody-launch cortex outcome/handoff)."
step_2_select    = "Pick the ONE next eligible task: lowest wave whose every 'requires' task is done and whose status is pending. Set it in_progress in spec.kvx. At most ONE task in_progress at a time."
step_3_build     = "Implement against the task's referenced acceptance criteria on REAL code. Deliver complete, runnable artifacts — never diffs or fragments. Follow existing repo style; add no comments/docs unless asked."
step_4_test      = "Ship table-driven tests (happy + error + boundary) over REAL code paths and REAL types — no stub/mock/fake doubles EVER. Run the affected module's go build ./... && go vet ./... && go test ./... (with -race where concurrency is touched). Fix ALL broken tests, even pre-existing ones; a non-compiling or red test package is a stop condition."
step_5_close_out = "Only when genuinely green: mark the task done in spec.kvx; write a concise next-session handoff (what shipped, what is green, the exact next task + gotchas); cortex_note_outcome (success|partial|failure) + any durable cortex_remember_*; close out. Never attest a completion that did not happen — surface honest partials."
step_6_guard     = "Before any destructive/irreversible/prod/secret/network-write action, run cortex_guard and self-check the HARD rules; stop for explicit user YES if it risks a HARD rule. No git on the dev box; the user drives commits."
handoff_convention = "The handoff is a cortex outcome note prefixed 'HANDOFF cody-launch' carrying: tasks done+green this session, current spec.kvx status, the exact next eligible task id, and any gotchas or partials."

# The non-negotiable quality bar (mirrors design.body.md).
[quality_bar]
grade        = "Commercial/production grade only. Imagine Google/AWS/Microsoft shipping it. No shortcuts, no sloppy work, no 'good enough for now'."
no_fakes     = "Real code paths, real types, real evidence. A green test driven by a fake is false completeness — the exact failure this feature exists to eliminate."
bounds       = "Loops are bounded; gates are satisfiable or they stop-and-ask; partials are surfaced as partials; truncated output is read in full before reasoning."
constitution = "Binds in every mode: no fakes, verify-before-done, read-full, no false success, complete artifacts, user drives git, respect the project. Modes dial ceremony, never the standard."
ui_house     = "Separation by background-color contrast only (never border strokes for depth); no emojis, no purple/indigo gradients, no glow."
claude_bar   = "The product must be as good as Claude Code for users. No exceptions, no buts."

# ============================== REQUIREMENTS ==============================

[req.1]
title = "Regression safety restored — the safety-critical test suites compile and cover the failure shapes"
story = "As the owner, I want the completion gate and the completeness auditor under real, compiling, passing tests, so that no future refactor can silently break the subsystems that spiralled."
ac_1 = "THE neo/internal/agent test package SHALL compile and pass: stale calls to removed symbols (3-arg verdictAccepts, 6-arg buildAuditContract, salientTokens) SHALL be updated to the current API against REAL cassandra.Verdict values, never fakes."
ac_2 = "THE cassandra test package SHALL compile and pass: tests referencing the removed CheckCitations SHALL be re-expressed against the current transcript-judged behavior."
ac_3 = "go build ./... , go vet ./... , and go test ./... SHALL be green in both the neo and cassandra modules."
ac_4 = "A CI-style check SHALL forbid a non-compiling or red module test package (the process gap that let the refactor land untested)."

[req.2]
title = "Unified workspace-path normalization seam in Cody"
story = "As the engine, I want one place that turns any model-supplied path into a clean workspace-relative path, so that navigation, mutation records, and adjudication all agree on path shape."
ac_1 = "CODY SHALL define ONE normalization function that resolves a model-supplied path against the workspace root, rejects escapes, and yields a clean workspace-relative path."
ac_2 = "worker.toolList / toolRead / toolWrite / toolDelete SHALL normalize the incoming path through the seam — an absolute in-root path SHALL behave identically to its relative form (the filepath.Join double-join SHALL be eliminated)."
ac_3 = "worker.recordChange SHALL store the normalized workspace-relative path so report.Changes never carries an absolute path."
ac_4 = "A test SHALL prove an absolute in-root path and its relative form produce identical fs_list/fs_write/record behavior."

[req.3]
title = "Adjudication evidence completeness — the gate always sees the real changed source"
story = "As the user, I want the adjudicator to judge the code that was actually written, so that a correct UI/structural change is never rejected as 'unconfirmed'."
ac_1 = "gate.renderSource SHALL relativize a report.Changes path against the workspace root before reading it, so an absolute in-root path is included in the adjudication evidence (never skipped)."
ac_2 = "THE do-not-touch and test-weakening screens SHALL compare normalized paths so an absolute-path change is screened identically to its relative form."
ac_3 = "THE planner SHALL emit workspace-relative paths in a sheet's goal, verification commands, and grounding, so the worker is primed with the relative shape."
ac_4 = "A test SHALL reproduce the logged shape: a worker writes an absolute-path file; the gate's evidence contains that file's source; the real adjudicator grounds on it."

[req.4]
title = "UI verification degrades gracefully — the screenshot gate is never unsatisfiable"
story = "As a user, I want UI tasks to succeed even where a browser service is not wired, so that a correct deliverable is never rejected for infrastructure it cannot control."
ac_1 = "THE worker SHALL probe screenshot capability (browser service reachable) and expose it as a typed signal, not a message-in-the-path-slot."
ac_2 = "WHEN screenshot capability is present, THE screenshot gate SHALL bind as today (a UI turn-in that changed a rendered surface must carry a real screenshot artifact)."
ac_3 = "WHEN screenshot capability is ABSENT, THE gate SHALL degrade to a non-blocking advisory plus a deterministic render check — never an unsatisfiable hard rejection."
ac_4 = "browserScreenshot SHALL signal 'not configured' via a typed result, and no caller SHALL record that message as a screenshot path."

[req.5]
title = "Structurally-unsatisfiable-gate detection — stop-and-ask or replan, never burn attempts"
story = "As the user, I want Cody to recognize when a gate cannot be satisfied by any worker action, so that it asks me or replans instead of failing the plan on three identical rejections."
ac_1 = "THE orchestrator SHALL detect when the same gate rejection reason repeats across attempts with no worker action able to resolve it (an unsatisfiable gate)."
ac_2 = "ON an unsatisfiable gate, THE orchestrator SHALL stop-and-ask the user or replan the task, rather than re-authoring the same sheet until the attempt ceiling."
ac_3 = "A test SHALL prove an unsatisfiable gate stops-and-asks (or replans) rather than consuming all MaxAttempts with identical rejections."

[req.6]
title = "One shared acceptance predicate across Neo, Cody, and Cassandra"
story = "As the owner, I want a single definition of 'the verdict accepts completion', so that the three consumers can never drift apart."
ac_1 = "cassandra.Sound() SHALL be the single source of truth for verdict acceptance (grounded AND no unverified claims AND coverage complete)."
ac_2 = "neo.verdictAccepts and Cody's gate.Adjudicate SHALL call cassandra.Sound() (or a shared exported predicate) rather than re-implementing the rule inline."
ac_3 = "A test SHALL prove the same Verdict yields the same accept/reject decision in Neo, Cody, and Cassandra."

[req.7]
title = "Cassandra fails toward refusal on degenerate/low-confidence verdicts"
story = "As the owner, I want the auditor to default to caution, so that a malformed or unsure verdict is never read as success."
ac_1 = "A parsed verdict missing coverage/groundedness signals SHALL normalize toward refusal (NOT default to coverage=full / grounded=true)."
ac_2 = "TIERED escalation SHALL keep the STRICTER (or more certain) verdict, never unconditionally replace a stricter primary verdict with a less-certain escalated one."
ac_3 = "THE goal-type classification (question / status / truthful-no) SHALL be covered by a test with a grounding guard, so an UNCHECKED negative cannot pass as complete."

[req.8]
title = "Neo completion loop bounded by unified unproductive-attempt accounting"
story = "As a user, I want Neo to stop and hand off honestly when it cannot close, so that it never spends the whole step budget on a work->premature-complete->reject loop."
ac_1 = "NEO SHALL track unproductive attempts on ONE counter that completion-gate rejections, no-progress stalls, and guidance nudges all feed."
ac_2 = "ONLY genuine accepted progress SHALL reset that counter — a genuine tool call interleaved between completion rejections SHALL NOT silently reset the completion-reject bound."
ac_3 = "THE completion branch SHALL advance the no-progress/stall read before it continues (it SHALL NOT bypass stall detection)."
ac_4 = "A test SHALL drive an interleaved work->premature-complete->reject pattern and prove it terminates with an honest partial within the unified bound, well before the step budget."

[req.9]
title = "Worker context economy — the cached workspace map rides the sheet"
story = "As the engine, I want the worker to start already oriented, so that it does not spend several steps re-scanning a workspace the orchestrator already modeled."
ac_1 = "THE sheet grounding SHALL carry a cached workspace map (tree/languages/entry points) from the orchestrator's workspace model."
ac_2 = "THE worker SHALL use the cached map for initial orientation and SHALL NOT re-scan the whole workspace before starting the task."
ac_3 = "A test SHALL prove a worker on a seeded repo performs no redundant full-workspace scan when the cached map is present."

[req.10]
title = "Ceremony scales to intent — a fast path for low-stakes asks"
story = "As a vibe coder, I want a quick prototype to start coding almost immediately, so that Cody is as responsive as Claude Code without abandoning the constitution."
ac_1 = "A low-stakes / Prototype intent SHALL take a fast path that collapses the SDR + multi-candidate DLR + multi-candidate planner ceremony into a lean start."
ac_2 = "THE constitution SHALL bind identically on the fast path (no fakes, verify-before-done, honest partials, complete artifacts)."
ac_3 = "A test SHALL prove the fast path issues materially fewer pre-code LLM calls than the full ceremony while both hold the constitution."

[req.11]
title = "The intended spec pipeline — spec.kvx + design.body.md via specgen, with research and clarifying questions"
story = "As an Architect-mode user, I want Cody to author real durable spec artifacts and to understand the ask first, so that long-horizon work is planned to the same bar this repo uses."
ac_1 = "ARCHITECT mode SHALL author a real spec.kvx plus design.body.md for the project and invoke specgen to render requirements.md / design.md / tasks.md — replacing the hand-rolled .cody/spec markdown."
ac_2 = "PLANNING SHALL be preceded by a research phase that gathers grounding (workspace + relevant sources) before the plan is authored."
ac_3 = "WHEN the ask is underspecified, CODY SHALL ask clarifying questions through the answer channel BEFORE planning, not guess."
ac_4 = "A test SHALL prove the authored spec.kvx round-trips through the real specgen parser and that the research / clarifying-questions phases gate planning."

[req.12]
title = "Coding workspace UI at the Claude Code bar"
story = "As a user, I want the coding surface to feel as good as Claude Code, so that directing Cody and seeing my running app is smooth, legible, and never a dead-silent blank."
ac_1 = "THE built /cody surface (spec/cody-client, spec/cody-smoothness) SHALL be audited and brought into conformance with rules/web/design-quality.md and the house rules: separation by background-color contrast only (never border strokes for depth), no emojis, no purple/indigo gradients, no glow."
ac_2 = "THE progress spine SHALL never be blank while running or awaiting (including the approve->next-phase gap), and Cody SHALL narrate as it works."
ac_3 = "THE diff review, file tree, live terminal, and dev-server preview SHALL show real, navigable, faithful state — the user SEES the running result of a build."
ac_4 = "THE plan board and turn-in cards SHALL carry real verification evidence in RESULT language, with zero orchestrator/worker/sheet jargon in consumer copy; the explanation register SHALL follow the active mode."

[req.13]
title = "No-fakes proof — the creative build runs green end to end, and every module is green under coverage"
story = "As the owner, I want the exact failure shapes reproduced as passing tests and the whole stack green, so that launch-readiness is proven, not asserted."
ac_1 = "A creative-build E2E SHALL run a seeded 'make me a small web app' task to a real running dev-server preview and a real screenshot artifact, gate-accepted, with NO stub/mock/fake anywhere in the path."
ac_2 = "THE Y1/Y2/Y9 absolute-path shape, the Y3 unsatisfiable-screenshot shape, the N2 Neo loop shape, and the C2/C3 degenerate-verdict shape SHALL each be covered by a real regression test."
ac_3 = "go build/vet/test ./... (with -race where concurrency is touched) SHALL be green across cody, neo, and cassandra; the client coding-workspace reducer tests SHALL be green."
ac_4 = "A coverage gate SHALL hold on the changed packages; NO test in this feature SHALL substitute a stub/mock/fake for a real code path or type to manufacture a pass."

[req.14]
title = "The 25-session working protocol and quality bar as a durable operating contract"
story = "As the owner, I want the per-session protocol and the commercial quality bar written into this feature's source of truth, so that every session is worked the same disciplined way."
ac_1 = "THE spec SHALL carry the per-session protocol (recall + read-full + previous-session handoff -> one eligible task in_progress -> build on real code -> write and run tests fixing ALL broken tests even pre-existing -> green -> mark done + write handoff + cortex outcome + close out; guard before risk) as a durable, queryable contract."
ac_2 = "THE spec SHALL carry the non-negotiable quality bar (commercial/production grade; no fakes; bounded loops and satisfiable gates; constitution in every mode; UI house rules; the Claude Code bar)."
ac_3 = "EVERY task in this feature SHALL be worked under that protocol, and the final checkpoint SHALL attest that it was."

