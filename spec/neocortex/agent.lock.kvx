# agent.lock.kvx — NEOCORTEX build-conduct lock.
#
# THIS FILE IS A CONTRACT, NOT GUIDANCE. Every agent implementing any neocortex
# task reads this file IN FULL, FIRST, EVERY SESSION, before spec.kvx and
# schematics.md. Every rule here is binding for the entire feature lifetime.
#
# DRIFT = FAIL: an implementation that deviates from this lock, from spec.kvx
# acceptance criteria, or from the schematics.md structure is a FAILED task —
# regardless of whether it compiles, passes tests, or seems better. The only
# legal response to a needed deviation is defined in [drift].
#
# Format: Matrix .kvx. String values double-quoted; one key = value per line.

[meta]
feature     = "neocortex"
kind        = "build-conduct-lock"
version     = "1.0.0"
enforcement = "drift = fail"
amendable   = "Only the owner amends this file. An agent NEVER edits this file, not even to fix a typo. Proposed changes are surfaced as text in the session and applied by the owner."

[read_order]
order_1 = "spec/neocortex/agent.lock.kvx — this file, in full, first, every session."
order_2 = "spec/neocortex/spec.kvx — meta status, requirements, task list."
order_3 = "spec/neocortex/schematics.md — the section(s) covering the selected task's component."
order_4 = "spec/neocortex/design.body.md — rationale for the component being built."
order_5 = "The latest HANDOFF neocortex outcome and any files it names."

[drift]
definition = "Drift is ANY of: a module/file layout differing from schematics.md section 2; a data structure, flow, or boundary differing from its schematic; an event kind added, removed, renamed, or repurposed; a dependency outside [lock.dependencies]; a toolchain/flag change; core code touching clock, entropy, filesystem, or network outside injected interfaces; a belief write path bypassing the gate; a trim of the never-trim tiers; a test double standing in for a real component; marking a task done with any acceptance criterion unmet."
response_1 = "STOP work on the task immediately. Do not commit the deviation and do not silently adapt around it."
response_2 = "Set the task status back to pending with a progress note stating exactly what deviation seemed necessary and why."
response_3 = "Surface the deviation to the owner as a decision with options; record the owner's ruling in the spec (owner applies lock amendments personally)."
response_4 = "A deviation discovered in ALREADY-LANDED work is treated the same: surface it; do not quietly rework it into a different shape."

[lock.toolchain]
language    = "C++23. No C++26 features, no compiler extensions beyond what the pinned flags enable."
compiler    = "Clang, exact version pinned in neocortex/toolchain/ at task 1.1; that pin is thereafter part of this lock. GCC builds are not maintained."
stdlib      = "libc++ with hardening enabled (_LIBCPP_HARDENING_MODE_EXTENSIVE in debug/CI, FAST in release)."
core_flags  = "The engine core compiles with exceptions disabled and RTTI disabled. -Werror everywhere. Sanitizer and fuzzer presets are build-system first-class, never ad-hoc."
build       = "CMake with the committed toolchain file. Reproducible static builds for linux amd64 and arm64. No FetchContent downloads at build time — dependencies are vendored in-tree."

[lock.code]
errors      = "All fallible paths return std::expected with the typed error taxonomy from src/core/error.h. No exceptions in the core. No error strings as control flow. No silent fallbacks."
ownership   = "No naked new/delete. No raw owning pointers. No shared_ptr ownership webs — single ownership or immutable snapshot sharing only. Non-owning views (span, string_view) never outlive their arena."
memory      = "Large allocations at startup only. Per-request std::pmr arenas reset per operation. Every queue is bounded. Peak resident memory per actor is budgeted and asserted in tests."
concurrency = "Exactly one writer thread per actor store. Readers use epoch-pinned snapshots and never block the writer. No locks on hot paths. No detached threads. No sleeping loops as synchronization."
tidiness    = "clang-tidy with the committed ruleset at zero warnings is a completion gate for every task."

[lock.architecture]
ground_truth   = "The event log is the ONLY non-rebuildable state. Writing durable non-derived state anywhere else is drift. Writing derived state that cannot be reproduced by replay is drift."
single_writer  = "All state mutation flows through the single-writer apply loop. No projection is ever written from a reader path, a client handler, or a background thread."
gate_only      = "Beliefs are written ONLY by the apply-time gate from assertion/consolidation/retract events. Any other belief write path is drift."
write_ahead    = "tool_call frames are durable before tool execution. intent_set frames are durable before dependent dispatch. delivered_msg is the only representation of user-visible output."
mechanism_only = "cortexd makes no outbound network connections and no model calls. No HTTP client, no DNS resolution, no LLM SDK is linked into the engine. Semantic extraction lives in Go clients."
absorption     = "The sessionjournal event design is absorbed into the log taxonomy. Building or extending a second event-sourcing lane anywhere in Matrix under this feature is drift."

[lock.determinism]
env_only    = "Core code obtains time, entropy, and I/O exclusively through the injected interfaces in src/core/env.h. A direct call to any clock, random source, or filesystem API from src/core, src/gate, src/proj, or src/compose is drift."
replay      = "Identical logs produce byte-identical projections. Any change that breaks replay convergence in the simulation harness fails the task that introduced it."
sim_green   = "The deterministic simulation harness runs in CI from wave 2 onward and must be green at the completion of every task in every subsequent wave."
pure_reads  = "Activate and every query path are pure reads: no journal append, no projection write, no salience mutation on the read path. Attestation returns as events, never as read-side writes."

[lock.schema]
taxonomy    = "The event kind taxonomy is EXACTLY schematics.md section 4. Adding, removing, renaming, or repurposing a kind requires a spec amendment plus explicit owner YES before any code."
forbidden   = "No event kind may exist that can carry guidance, doubt lines, steering, rejected answers, or narrative respawn summaries. Attempting to smuggle these through an existing kind's payload is drift."
evolution   = "FlatBuffers schema changes are additive-only. Every payload is verified before trust at every boundary (socket, import, disk)."
provenance  = "The belief schema keeps provenance structurally mandatory. A schema change making provenance optional is drift."

[lock.invariant]
inv1        = "INV-1 is the prime invariant: after any crash, respawn, overflow, or compaction, the next activation contains the faithful conversation projection, the reconciled work ledger, and the complete intent frame."
never_trim  = "Tiers T0 (resident), T1 (intent frame), and T2 (work ledger tail) are never trimmed. Code that trims them under any pressure is drift; the correct behavior for an oversized T0-T2 is a typed invariant-violation error."
closure     = "Open loops close ONLY by explicit loop_closed events with a typed reason. No expiry, no aging out, no summarization removes an open loop."
briefing    = "Successor briefing consumes projections only. Building any narrative-summary respawn seed is drift."
inv1_ci     = "From task 5.3 onward the kill-at-every-lsn INV-1 property is a hard CI gate; a red INV-1 blocks every subsequent task completion."

[lock.dependencies]
allowed     = ["liburing", "lmdb", "blake3", "libsodium", "flatbuffers", "croaring", "highway", "xxhash", "crc32c"]
vendored    = "All dependencies are vendored under neocortex/third_party/ and digest-pinned. No package managers at build time, no system-library linkage beyond libc/libc++/pthread."
additions   = "Adding, upgrading, replacing, or removing ANY dependency requires explicit owner YES recorded in spec.kvx before the change lands. Test-only dependencies included."
banned      = "No ANN/vector-index libraries (the exact-scan decision is architectural), no general embedded databases beyond LMDB, no networking libraries, no LLM SDKs, no Boost."

[lock.testing]
no_fakes    = "Never write stub/mock/fake test doubles or placeholder implementations. Tests drive the real engine: the real state machine under the simulation env, real files, real LMDB, real sockets, the real cortexd binary for client tests. This mirrors the repo-wide hard rule and is doubly binding here."
adversarial = "Every decoder (frame parser, schema verifier, protocol framing, query input, unseal path) has a libFuzzer target with its corpus committed in-tree, added in the same task that adds the decoder."
sanitizers  = "ASan+UBSan and TSan suites are completion gates for every task from wave 1 onward."
properties  = "Replay convergence, rebuild equivalence, upsert idempotency, MMR consistency, AEAD round-trip, and composer determinism are property tests, not example tests, and run in CI."
crash       = "Recovery claims are proven by real kill -9 (simulated at arbitrary lsn, and on the real process for cortexd/client tasks), never by graceful-shutdown-only tests."

[lock.seam]
go_client   = "The Go client implements the EXISTING resurrection loop interfaces verbatim (ActivationSource, TurnRecorder, EvidenceJournal, Consolidator sink, CheckpointStore). Changing those interface signatures under this feature is drift — the loop must not need edits to swap substrates."
old_cortex  = "The old matrix/cortex module and every consumer path on it stay intact and working until the wave-7 owner cutover gate. Any task that breaks, edits behavior of, or deletes old-cortex code before that gate is drift (the wave-7 exporter READS it; that is the only sanctioned contact)."
flag        = "The substrate flag defaults to the old cortex until the owner flips it. No task flips the default."
isolation   = "A cortexd crash must never take down a client process; a client crash must never corrupt engine state. Both directions are tested, not assumed."

[lock.process]
one_task    = "At most ONE task in_progress, selected by wave order and satisfied requires, per the spec workflow."
honest      = "Never mark a task done with any acceptance criterion unverified. Implementation evidence and live qualification are distinct postures (spec.kvx [delivery]); do not launder one as the other."
no_git      = "No git commands on the dev box. The owner drives commits. Uncommitted state is normal."
guards      = "cortex_guard (or the available guard) before any destructive, irreversible, credential-touching, or external-effect action. Owner YES gates in spec.kvx are never self-approved."
handoff     = "Every session ends with a HANDOFF neocortex durable outcome: exact green checks, honest partials, next eligible task."

[lock.style]
repo        = "Follow existing repo style. Comments only where the code cannot carry the constraint; no narration comments, no changelog comments."
naming      = "Names come from schematics.md. Inventing parallel vocabulary for schematic concepts (e.g. renaming the intent frame) is drift."
output      = "No emojis anywhere: code, logs, errors, docs, test names."
