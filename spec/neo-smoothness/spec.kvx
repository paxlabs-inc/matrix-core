# spec.kvx — Neo Smoothness (Cascade-derived UX patterns). SINGLE SOURCE for
# this feature's requirements + design + tasks. Rendered to requirements.md /
# design.md / tasks.md by spec/specgen. Do not edit the generated markdown;
# edit this file and regenerate.
#
# Format: Matrix .kvx (see tachyon/internal/config/kvx.go). One key = value per
# line; string values double-quoted; lists are ["a","b"]; # starts a comment.
# Schema:
#   [req.<n>]   title, story, ac_1..ac_n          (acceptance criteria, EARS)
#   [design]    overview, include="design.body.md" (rich prose/diagrams inlined)
#   [task.<id>] title, status, wave, reqs, requires (dotted ids: 1, 1.1, 1.2)

[meta]
feature      = "neo-smoothness"
title        = "Neo Smoothness (Cascade-derived conversational UX)"
status       = "in_progress"
spec_version = "0.1.0"
intro        = "Make Neo's conversational experience feel smoother by adopting the proven turn-mechanics of the Cascade/Devin coding agent, studied from 54 real session dumps at /root/dataset/sessions/ (decision recorded in cortex). The study established that Neo already EQUALS or EXCEEDS Cascade on context compaction (neo/internal/agent/compaction.go has a fixed-schema summary plus a verbatim high-entropy-token validator Cascade lacks), the subagent swarm (spawn_subagents + restricted SubagentSchemas), failure classification / attach-on-409 / semantic-stall (neo-execution-reliability P1), the durable trace sidecar, and the prompt-cache-stable system prefix. This feature is therefore scoped ONLY to the net-new Cascade patterns Neo lacks: (1) a system_guidance-style INVISIBLE, non-acknowledged steering channel — today Neo delivers completion-gate feedback as an in-band llm.ToolResult the model reasons over (agent.go ~line 687), which both feels rigid (NE-6) and lets internal steering surface in the user-visible reasoning stream (NE-12); (2) a terse, action-specific narrate-before-act discipline; (3) a first-class live task-list (todo) surface that gives the user step-by-step progress visibility; (4) an overflow-file for truncated tool / core_execute output so a flagged-incomplete result is never silently cut (the read-full discipline, in code); (5) an optional Plan-vs-Act mode to reduce surprise on large/ambiguous requests. It EXPLICITLY does NOT re-implement structured clarify, narration coalescing, or the jargon scrub — those already live as pending tasks in spec/neo-execution-reliability (req.8/task.4.4, req.7/task.4.3, req.6/task.4.1-4.2) and this feature only complements them. It preserves the key-isolation backstop (Neo holds no signing key; value-moving work crosses into MCL via core_execute) and the D11 replay byte-identity invariant. These requirements trace to the approved design (rendered into design.md)."

[design]
overview = "See the full design below: the Cascade session-architecture study (the three cooperating agent roles — primary, summarizer, subagents — the layered system block, and the narrate->act / system_guidance / overflow-file turn mechanics), the gap analysis vs Neo's current internals (what Neo already has and must NOT reinvent), the invisible guidance-channel design that replaces in-band completion-gate feedback and is scrubbed from user surfaces, the narrate-before-act discipline, the live task-list surface and its durable-trace integration, the truncation overflow-file at the tool/delegate boundary, the optional Plan-vs-Act mode, the explicit cross-feature non-duplication boundary with neo-execution-reliability, and the preserved invariants (key-isolation, D11)."
include  = "design.body.md"

# ============================== REQUIREMENTS ==============================

[req.1]
title = "Invisible guidance channel (non-acknowledged system steering)"
story = "As a user, I want Neo's internal self-correction to steer it without me ever seeing protocol nudges in its thinking, so that it reads as a capable assistant rather than a system arguing with itself."
ac_1 = "THE agent loop SHALL provide a guidance channel that injects system steering (completion-gate feedback, retry/stall nudges, contextual hints) as input the model acts on but is instructed NOT to acknowledge, echo, or respond to directly (the Cascade system_guidance contract)."
ac_2 = "WHEN the completion gate rejects a task_complete call, THE rejection feedback SHALL be delivered through the guidance channel, and SHALL NOT be appended as an in-band tool result whose text the model then narrates into the user-visible reasoning stream (the current agent.go behavior)."
ac_3 = "THE guidance-channel content SHALL be excluded from every user-facing surface (chat.delta channel=reasoning / chat.thinking and the assistant transcript), so internal steering never reaches the user."
ac_4 = "THE guidance channel SHALL carry ONLY system steering and SHALL NOT alter the semantics of genuine tool-result inputs nor touch the signed MCL execution path; the agent still learns it must continue/finish, in clean terms."
ac_5 = "WHERE a guidance nudge would otherwise repeat unbounded (e.g. the gate rejects again and again), THE loop SHALL escalate to a stop-and-ask or honest-partial after a bounded number of nudges rather than re-nudging indefinitely."

[req.2]
title = "Narrate-before-act (terse, action-specific running commentary)"
story = "As a user, I want one short, specific line about what Neo is doing right before it does it, so that I can always follow along without reading a wall of boilerplate."
ac_1 = "WHEN Neo is about to perform a tool call or a core_execute delegation, THE agent SHALL emit at most one concise intent sentence describing what it is doing and why, drawn from the actual operation."
ac_2 = "THE narration SHALL be action-specific (reflecting the real target/operation) and SHALL NOT be a fixed boilerplate string reused verbatim across unrelated steps."
ac_3 = "THE narration tone SHALL be direct and unsentimental: no preamble or validation phrases (no 'Great idea', 'You're absolutely right'), no emojis, and no protocol jargon (the user-facing surface shows the result, not the tech)."
ac_4 = "WHERE neo-execution-reliability adds exact-duplicate narration coalescing (its req.7), THIS feature SHALL ensure narration carries distinct per-action content so coalescing collapses only genuine repeats and never hides distinct progress."

[req.3]
title = "First-class live task-list (todo) surface"
story = "As a user, I want to see Neo's plan as a checklist that ticks off in real time, so that on a multi-step task I always know what is done, in progress, and pending."
ac_1 = "THE agent SHALL expose a todo capability that records a short ordered task plan with per-item status (pending | in_progress | done) and updates it as work proceeds, surfaced to the user as a live checklist."
ac_2 = "THE agent SHALL keep at most ONE item in_progress at a time and SHALL mark an item done immediately upon its completion, not batched at the end."
ac_3 = "THE task-list surface SHALL render through the existing client surface conventions and SHALL honor the UI house rules (separation by background-tone contrast, never border strokes; no emojis/glow), and SHALL NOT introduce any new signing path."
ac_4 = "WHERE a request is a single trivial step, THE agent SHALL NOT force a task list, so the feature adds visibility on real multi-step work without ceremony on simple turns."
ac_5 = "THE task-list state SHALL integrate with the durable trace so it survives conversation reopen and agent respawn, consistent with the task-durability rule."

[req.4]
title = "Overflow-file for truncated tool / core_execute output"
story = "As the system owner, I want a tool result that is too large to be saved in full and pointed to, not silently cut, so that Neo never reasons over a half-result and confidently states a wrong value."
ac_1 = "WHEN a tool or core_execute / plan result exceeds the inline budget, THE seam SHALL persist the FULL output to a file and return an inline truncation notice carrying the file path and how to read the remainder, rather than silently truncating."
ac_2 = "WHEN a result is flagged as truncated-with-overflow, THE agent SHALL retrieve the full content from the overflow file before reasoning over or answering from that result (the read-full discipline, enforced in code)."
ac_3 = "THE overflow files SHALL be scoped to the run and cleaned up, and the truncation notice SHALL NOT expose secrets or raw protocol internals on the user-facing surface."

[req.5]
title = "Plan-vs-Act mode (optional, reduce surprise)"
story = "As a user, I want the option to have Neo explore and propose a plan before it changes anything, so that on a big or ambiguous request it does not surprise me by acting first."
ac_1 = "THE agent SHALL support a mode signal (act = default | plan) where, in plan mode, Neo explores, asks focused clarifying questions, and proposes a plan, and SHALL NOT perform value-moving or irreversible actions until the user approves and the mode returns to act."
ac_2 = "WHERE a request is large, ambiguous, or irreversible, THE agent MAY propose a plan first even in act mode, balancing proactivity against not surprising the user."
ac_3 = "THE mode SHALL NOT weaken the key-isolation backstop or the embedded-wallet spend-approval / leash governance — value-moving KindleLaunch actions remain governed by the existing approval model regardless of mode."

[req.6]
title = "Non-duplication boundary + preserved invariants"
story = "As a system integrator, I want this feature to complement neo-execution-reliability rather than duplicate it and to change only the conversational surface, so that the rigorous execution path stays intact."
ac_1 = "THIS feature SHALL NOT re-implement structured clarify pass-through (neo-execution-reliability req.8), narration coalescing (its req.7), or the jargon scrub (its req.6); it SHALL depend on and complement those pending tasks."
ac_2 = "THE feature SHALL NOT modify the signed MCL execution path (compile/plan/walk/synthesize/critic/emitFinalTurn) nor any journaled bytes, and SHALL preserve the D11 replay byte-identity invariant."
ac_3 = "THE feature SHALL preserve the key-isolation backstop: Neo holds no signing key and all value-moving work crosses into MCL through core_execute."
ac_4 = "WHERE behavior changes, THE change SHALL affect only non-signed transcript events, loop control flow (guidance, narration, todo, mode), tool-result framing (overflow), and the client surface."

[req.7]
title = "Real verification — no fakes"
story = "As the system owner, I want these UX changes proven against real code paths, so that a green result reflects genuine smoother behavior and no invariant regressed."
ac_1 = "THE feature SHALL verify that completion-gate rejection feedback travels the guidance channel and is ABSENT from the user-facing reasoning/transcript surfaces, and that nudges escalate to stop-and-ask after the bounded count — against the real agent loop, not a faked emitter."
ac_2 = "THE feature SHALL verify the todo lifecycle (one in_progress, immediate done, durable across a simulated respawn) against the real task-list + trace code paths."
ac_3 = "THE feature SHALL verify the overflow-file path: a deliberately oversized tool result is persisted in full, the inline notice carries the path, and the agent reads the remainder before answering."
ac_4 = "THE feature SHALL verify non-perturbation: the signed MCL journaled bytes + D11 replay roots are byte-identical before/after, and no new signing path is introduced."
ac_5 = "Tests SHALL exercise REAL types and REAL code paths (no stub/mock doubles standing in for the agent loop, emitter, task-list, or delegate logic under test)."

# ================================ TASKS ==================================

[tasks]
heading = "Implementation Plan: Neo Smoothness"

[task.1]
section = "P1 — Invisible guidance channel (highest smoothness impact)"
title   = "Route system steering off the user-visible reasoning stream"
status  = "pending"

[task.1.1]
title  = "Add a guidance message kind + deliver completion-gate feedback through it"
status = "done"
wave   = 1
do_1   = "Add a guidance-channel message kind in neo/internal/llm + the agent loop that injects system steering as input the model acts on but is told not to acknowledge (mirror Cascade's <system_guidance>); add the do-not-acknowledge instruction to neo/internal/agent/prompt.go"
do_2   = "Replace the in-band completion feedback append (agent.go ~line 687: a.working = append(..., llm.ToolResult(cc.ID, TaskCompleteTool, verdict.feedback))) so the rejection feedback rides the guidance channel instead of a tool result the model narrates"
reqs   = ["1.1", "1.2", "1.4"]

[task.1.2]
title  = "Scrub guidance from user surfaces + bounded escalate-to-stop-and-ask"
status = "done"
wave   = 2
do_1   = "Exclude guidance-channel content from chat.delta channel=reasoning / chat.thinking and the assistant transcript on the server emit path, so internal steering never streams to the user"
do_2   = "Cap consecutive guidance nudges (configurable); on exceeding it, escalate to a stop-and-ask / honest-partial rather than re-nudging unbounded"
reqs   = ["1.3", "1.5"]
requires = ["1.1"]

[task.2]
section = "P2 — Narrate-before-act discipline"
title   = "Terse, action-specific running commentary"
status  = "pending"

[task.2.1]
title  = "Emit one action-specific intent line before each tool/core_execute call"
status = "done"
wave   = 1
do_1   = "In the agent loop, before dispatching a tool call, emit at most one concise intent sentence derived from the actual operation (what + why); update prompt.go tone guidance: direct, no preamble/validation phrases, no emojis, no jargon"
do_2   = "Ensure narration is generated per-action (distinct content) so neo-execution-reliability's coalescing collapses only genuine consecutive duplicates"
reqs   = ["2.1", "2.2", "2.3", "2.4"]

[task.3]
section = "P3 — Live task-list (todo) surface"
title   = "Step-by-step progress visibility"
status  = "pending"

[task.3.1]
title  = "Synthetic todo tool + manager wiring"
status = "done"
wave   = 1
do_1   = "Add a synthetic todo tool in neo/internal/tools (alongside core_execute/spawn_subagents) that records an ordered plan with per-item status; enforce one in_progress at a time and immediate done; no-op gracefully on trivial single-step turns"
reqs   = ["3.1", "3.2", "3.4"]

[task.3.2]
title  = "Client live-checklist surface + durable-trace integration"
status = "done"
wave   = 2
do_1   = "Render the task list as a live checklist in the client honoring UI house rules (tone-contrast separation, no borders/emojis/glow); persist task-list state through the durable trace so it survives reopen + respawn"
reqs   = ["3.3", "3.5"]
requires = ["3.1"]

[task.4]
section = "P4 — Overflow-file for truncated output"
title   = "Never reason over a half-result"
status  = "pending"

[task.4.1]
title  = "Persist oversized tool/core_execute output to a file + inline truncation notice"
status = "done"
wave   = 1
do_1   = "At the tool/delegate result boundary, when output exceeds the inline budget, write the FULL output to a run-scoped file and return an inline notice with the path + how to read the remainder (mirror Cascade's <truncation_notice>); never silently cut"
do_2   = "Enforce in code that the agent retrieves the overflow file before reasoning over a flagged-incomplete result; clean up run-scoped files; keep secrets/internals off the user surface"
reqs   = ["4.1", "4.2", "4.3"]

[task.5]
section = "P5 — Plan-vs-Act mode (optional)"
title   = "Reduce surprise on large/ambiguous requests"
status  = "pending"

[task.5.1]
title  = "Mode signal + plan-vs-act gating"
status = "done"
wave   = 2
do_1   = "Add an act|plan mode signal; in plan mode explore + ask + propose a plan and withhold value-moving/irreversible actions until approval; in act mode allow proposing a plan first for large/ambiguous requests"
do_2   = "Keep key-isolation + the embedded-wallet leash/approval governance authoritative for value-moving KindleLaunch actions regardless of mode"
reqs   = ["5.1", "5.2", "5.3"]

[task.6]
section = "P6 — Verification (no fakes)"
title   = "Prove the smoothness changes + preserved invariants"
status  = "pending"

[task.6.1]
title  = "Guidance channel: feedback off user stream + bounded stop-and-ask"
status = "pending"
wave   = 3
do_1   = "Against the real agent loop: assert completion-gate rejection feedback rides the guidance channel and is ABSENT from chat.thinking/reasoning + the transcript, and that nudges escalate to stop-and-ask after the bounded count"
property  = "Property 1: internal steering never surfaces + nudges are bounded"
validates = "Requirements 1.2, 1.3, 1.5"
requires  = ["1.1", "1.2"]

[task.6.2]
title  = "Todo lifecycle + durability"
status = "pending"
wave   = 3
do_1   = "Assert the real task-list enforces one in_progress + immediate done, no list on a trivial turn, and reconstructs from the durable trace after a simulated respawn"
property  = "Property 2: correct task-list lifecycle, durable across respawn"
validates = "Requirements 3.2, 3.4, 3.5"
requires  = ["3.1", "3.2"]

[task.6.3]
title  = "Overflow read-full"
status = "pending"
wave   = 3
do_1   = "Drive a deliberately oversized tool result; assert the full output is persisted, the inline notice carries the path, and the agent reads the remainder before answering"
property  = "Property 3: truncated output is preserved + fully read"
validates = "Requirements 4.1, 4.2"
requires  = ["4.1"]

[task.6.4]
title  = "Non-perturbation (signed walk + key isolation)"
status = "pending"
wave   = 3
do_1   = "Assert the signed MCL journaled bytes + D11 replay roots are byte-identical before/after this feature and that no new signing path is introduced; value-moving work still crosses into MCL via core_execute"
property  = "Property 4: D11 byte-identity + key-isolation preserved"
validates = "Requirements 6.2, 6.3, 7.4"

[task.7]
title  = "Final checkpoint — Neo smoothness complete"
status = "pending"
note   = "All four properties green; completion-gate steering is invisible to the user; narration is terse + action-specific; multi-step work shows a live ticking checklist that survives respawn; truncated output is never silently cut; an optional plan mode reduces surprise. Structured clarify / narration coalescing / jargon scrub remain owned by neo-execution-reliability. The signed MCL walk and key-isolation are provably untouched. Deploy is user-driven."
