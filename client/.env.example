# Matrix Cloud client — public configuration. Copy to `.env.local`.
#
# Public Matrix Router URL. The router verifies the Supabase JWT and
NEXT_PUBLIC_MATRIX_ROUTER_URL=

# Supabase project credentials (browser auth only — anon key is safe).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional: Sentry / observability.
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_RELEASE=1.0.0

# Verbose console logs in dev.
NEXT_PUBLIC_DEBUG=false