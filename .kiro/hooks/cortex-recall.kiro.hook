{
  "version": "1.0.0",
  "enabled": false,
  "name": "Cortex Recall",
  "description": "Get full context before starting a session",
  "when": {
    "type": "promptSubmit"
  },
  "then": {
    "type": "runCommand",
    "command": "You an call the the recall function on the cortex mcp or execute this command\nbash ~/.cursor/cortex-mem.sh recall > /tmp/mem-recal-\"$(date -u +%Y%m%dT%H%M%S)\".txt | echo \"/tmp/mem-recal-\"$(date -u +%Y%m%dT%H%M%S)\".txt\"",
    "timeout": 60
  },
  "workspaceFolderName": "matrix",
  "shortName": "cortex-recall"
}